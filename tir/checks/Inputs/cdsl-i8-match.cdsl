
pub mod dialects { pub mod builtin {
    pub let constant<w: Nat> = op { signature: () -> std::El<std::Bits<w>> };
} }
pub let Operation: { id: Int, kind: String, placement: String, container: Int, position: Int, display: Int, location: Int } -> Prop;
pub let Value: (Int, Int, String, Int, Int, Int) -> Prop;
pub let Attribute: (String, Int, String, Int) -> Prop;
pub mod tables { pub let Attribute: std::Table<(String, Int, String), Int, std::Merge::Unique>; }
pub mod rules {
  pub let recognize<node, result: std::ir::ValueRef<std::El<std::Bits<8>>>>:
      dialects::builtin::constant.matches(node, (), (result,)) -> (Attribute("operation", node, "probe", 1), Attribute("operation", node, "probe", 2));
}
pub mod wide_rules {
  pub let recognize<node, result: std::ir::ValueRef<std::El<std::Bits<32>>>>:
      dialects::builtin::constant.matches(node, (), (result,)) -> (Attribute("operation", node, "probe", 1), Attribute("operation", node, "probe", 2));
}
pub let execute = std::schedule::saturate(rules);
pub let wide = std::schedule::saturate(wide_rules);
