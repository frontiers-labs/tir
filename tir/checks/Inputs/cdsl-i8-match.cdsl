
pub mod dialects { pub mod builtin {
    pub let constant<w: Nat> = op { signature: () -> std::El<std::Bits<w>> };
} }
pub let Operation: { id: std::ir::OperationId, kind: std::ir::OperationKind, placement: String, container: Int, position: Int, display: Int, location: Int } -> Prop;
pub let Value: (std::ir::ValueId, Int, String, Int, Int, Int) -> Prop;
pub let Attribute: std::Table<(String, Int, String), Int, std::Merge::Unique>;
pub mod rules {
  pub let recognize<node, result: std::ir::ValueRef<std::El<std::Bits<8>>>>:
      dialects::builtin::constant.matches(node, (), (result,)) -> (Attribute("operation", std::ir::raw_operation_id(node), "probe", 1), Attribute("operation", std::ir::raw_operation_id(node), "probe", 2));
}
pub mod wide_rules {
  pub let recognize<node, result: std::ir::ValueRef<std::El<std::Bits<32>>>>:
      dialects::builtin::constant.matches(node, (), (result,)) -> (Attribute("operation", std::ir::raw_operation_id(node), "probe", 1), Attribute("operation", std::ir::raw_operation_id(node), "probe", 2));
}
pub let execute = || { std::schedule::saturate(rules::recognize) };
pub let wide = || { std::schedule::saturate(wide_rules::recognize) };
