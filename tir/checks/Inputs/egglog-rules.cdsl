pub let Operation: (std::ir::OperationId, std::ir::OperationKind, String, Int, Int, Int, Int) -> Prop;
pub let Attribute: std::Table<(String, Int, String), Int, std::Merge::Unique>;
pub let Marker: Int -> Prop;


pub mod success {
    pub let seed: Marker(1);
}

pub mod conflict {
    pub let write<id, kind, parent, position, order, location>:
        Operation(id, kind, "root", parent, position, order, location) ->
        (Attribute("operation", std::ir::raw_operation_id(id), "probe", 1), Attribute("operation", std::ir::raw_operation_id(id), "probe", 2));
}

pub let execute = || { std::schedule::saturate(success::seed) };
pub let reject = || { std::schedule::saturate(conflict::write) };
