use std::core::*;
use std::ir::{OperationId, OperationKind};

pub let Operation: Relation<(OperationId, OperationKind, String, Int, Int, Int, Int)>;
pub let Attribute: Table<(String, OperationId, String), Int, Merge::Unique>;
pub let Marker: Relation<Int>;

let seed: Rule(
    () -> (Marker(1))
);

let write<id, kind, parent, position, order, location>: Rule(
    (Operation(id, kind, "root", parent, position, order, location)) ->
    (
        Attribute("operation", id, "probe", 1),
        Attribute("operation", id, "probe", 2),
    )
);

pub let execute: Schedule = Schedule::Once(List(seed));
pub let reject: Schedule = Schedule::Once(List(write));
