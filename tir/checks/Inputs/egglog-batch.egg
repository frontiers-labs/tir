(relation Imported (String))
(rule ((= kind (OpKind op))) ((Imported kind)))
(rule ((= (OpKind op) "builtin.module")) ((Scope op) (SelectedScope op)))
(run 1)
(check (Imported "builtin.module"))
(run-schedule (saturate ir-index) (saturate ir-query))
(relation Answer (i64))
(rule ((SelectedOp root op) (= (OpKind op) "builtin.module")) ((Answer 42)))
(run 1)
(check (Answer 42))
(print-function Answer)
