(relation Imported (String))
(relation Selected (i64))
(rule ((Operation op kind place parent pos order loc)) ((Imported kind)))
(rule ((Operation op "builtin.module" place parent pos order loc)) ((Selected op)))
(run 1)
(check (Imported "builtin.module"))
(run-schedule (saturate ir-index))
(relation Answer (i64))
(rule ((Selected op)) ((Answer 42)))
(run 1)
(check (Answer 42))
(print-function Answer)
