// RUN: tir mc --march=riscv32 --stage=regalloc %s | filecheck %s --implicit-check-not=son.
// RUN: tir mc --march=riscv64 --stage=regalloc %s | filecheck %s --implicit-check-not=son.
// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s --implicit-check-not=son.
// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s --implicit-check-not=son.

// CHECK-LABEL: func.func @flat(
// CHECK-DAG: cfg.cond_br
// CHECK-DAG: func.return

module {
  %f = func.func @flat(%p: !i1, %x: !i32) -> !i32 {
    %entry = son.merge : !son.control
    %taken, %other = son.branch %entry, %p
    %first = son.edge %taken : !son.control
    %second = son.edge %other : !son.control
    %joined = son.merge %first, %second : !son.control
    -> %joined, %x
  }
  module_end
}
