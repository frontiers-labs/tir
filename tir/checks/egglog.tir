// RUN: tir egglog %s %S/Inputs/egglog-rules.cdsl 2>&1 | filecheck %s --check-prefix=TIMED
// RUN: cat %S/Inputs/egglog-rules.cdsl | tir egglog %s 2>&1 | filecheck %s --check-prefix=TIMED
// RUN: not tir egglog %s %S/Inputs/egglog-rules.cdsl --schedule reject 2>&1 | filecheck %s --check-prefix=IMPORTED
// RUN: cat %S/Inputs/egglog-rules.cdsl | not tir egglog %s --schedule reject 2>&1 | filecheck %s --check-prefix=IMPORTED
// RUN: not tir egglog %S/Inputs/egglog-invalid.tir %S/Inputs/egglog-rules.cdsl 2>&1 | filecheck %s --check-prefix=BADIR
// RUN: not tir egglog %s %S/Inputs/egglog-rules.cdsl --schedule missing 2>&1 | filecheck %s --check-prefix=BADRULES
// RUN: not tir egglog %s %S/Inputs/egglog-missing.cdsl 2>&1 | filecheck %s --check-prefix=ABSENTRULES
// RUN: not tir egglog %S/Inputs/egglog-missing.tir 2>&1 | filecheck %s --check-prefix=ABSENTIR

// TIMED: egglog: compile={{[0-9.]+}}s exec={{[0-9.]+}}s
// IMPORTED: merge of `Attribute` rejects
// BADIR: egglog-invalid.tir:
// BADRULES: CDSL schedule missing does not exist
// ABSENTRULES: egglog-missing.cdsl
// ABSENTIR: egglog-missing.tir:

module {
  module_end
}
