{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|apply_patch|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "env -u __MISE_SHIM -u LD_LIBRARY_PATH node \"$(git rev-parse --show-toplevel)/.agents/hooks/no-scripts.js\"",
            "statusMessage": "Checking script policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u __MISE_SHIM -u LD_LIBRARY_PATH node \"$(git rev-parse --show-toplevel)/.agents/hooks/no-scripts.js\"",
            "statusMessage": "Checking script policy"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "cd \"$(git rev-parse --show-toplevel)\" && cargo xtask lint >&2; status=$?; printf '{}'; exit \"$status\"",
            "timeout": 1800,
            "statusMessage": "Running cargo xtask lint"
          }
        ]
      }
    ]
  }
}
