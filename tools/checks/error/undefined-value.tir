// A reference to an unknown value is a verifier diagnostic, not a panic.
// RUN: not tir mc --march=rv64i --stage=isel %s 2>&1 | filecheck %s

module {
  func.func @f() -> !i64 {
    func.return %99
  }
  module_end
}

// CHECK-NOT: panicked at
// CHECK: verification failed
// CHECK: references unknown value %99
// CHECK-NOT: panicked at
