// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s

// CHECK: .section .data
// CHECK: counter:
// CHECK: .section .bss
// CHECK: scratch:

module {
  %counter = global @counter align 4 bytes [42, 0, 0, 0]
  %scratch = global private @scratch size 8 align 8 section ".bss"
  %fn_read = func.func @read() -> !i32 {
    %0 = ptr.load %counter : !i32
    func.return %0
  }
  module_end
}
