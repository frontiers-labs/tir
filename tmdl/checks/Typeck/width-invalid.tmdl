// `width(x)` is spec-time information: it comes from a declared type, never
// from a computed value.

// RUN: not tmdlc --action=emit-rust --dialect=test --text-only --output=- %s | filecheck %s

isa Test { param XLEN: Integer = 32; }

register_class GPR for [Test] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.XLEN;
    registers { r0..r31 => {}, }
}

instruction WidthOfSum for [Test] {
    param MNEMONIC: String = "widthofsum";
    operands { rd: GPR, rs1: GPR, rs2: GPR, }
    asm { "{self.MNEMONIC} {rd}, {rs1}, {rs2}" }
    behavior { rd = sext(rs1 as bits<8>, width(rs1 + rs2)); }
}

// CHECK: width of this value is not declared anywhere; give it one with `as bits<N>`
