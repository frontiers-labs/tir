// RUN: not tmdlc --action=emit-ast-json --text-only --output=- %s | filecheck %s
instruction I {
    param MNEMONIC: String = "i";
    operands { imm: bits<8> }
    asm { "i {imm}" }
    behavior { todo(); }
}
machine Core {
    override I { latency = 4; when imm { latency = 2; } }
}
// CHECK: latency condition must be bits<1>
