// Positive coverage for `fn` definitions: calls inline and type-check both in
// statement position and inside a lambda.

// RUN: tmdlc --action=emit-rust --dialect=test --text-only --output=- %s | filecheck %s

isa Test { param XLEN: Integer = 32; }

register_class GPR for [Test] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.XLEN;
    registers { r0..r31 => {}, }
}

register_class VR for [Test] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;
    registers { v0..v31 => {}, }
}

fn double(x) { x + x }
fn lane_add(a, b) { a + b }

instruction Double for [Test] {
    param MNEMONIC: String = "double";
    operands { rd: GPR, rs1: GPR, rs2: GPR, }
    asm { "{self.MNEMONIC} {rd}, {rs1}, {rs2}" }
    behavior { rd = double(rs1) + rs2; }
}

instruction VAdd for [Test] {
    param MNEMONIC: String = "vadd.vv";
    operands { vd: VR, vs2: VR, vs1: VR, }
    asm { "{self.MNEMONIC} {vd}, {vs2}, {vs1}" }
    behavior {
        vd = concat(map(zip(split(vs2, 4), split(vs1, 4)), |x, y| lane_add(x, y)));
    }
}

// CHECK-DAG: DoubleOp
// CHECK-DAG: VAddOp
