// RUN: tmdlc --action=emit-expanded-tokens --output=- %s | filecheck %s

macro list {
    ( $( $x:ident ),* ) => { $( $x ; )* };
}

macro nosep {
    ( $( $x:tt )* ) => { $( $x )* };
}

macro nested {
    ( $( ( $( $x:ident )* ) ),* ) => { $( g $( $x )* )* };
}

macro empty {
    ( $( $( $x:tt )* )* ) => { ok };
}

list!(a, b, c)

// Repetition without a separator.
nosep!(a b c)

// Nested repetitions expand inner groups per outer element.
nested!((a b), (c d e))

// A repetition whose sub-matcher can match zero tokens must not loop forever
// at the same position.
empty!()

