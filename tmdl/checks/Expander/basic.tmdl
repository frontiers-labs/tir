macro greet {
    ($who:ident) => { hello $who };
}

macro sub {
    ($a:ident, $b:literal, $c:tt) => { $a $b $c };
}

macro pick {
    () => { zero };
    ($x:ident) => { one };
}

macro inner {
    ($x:ident) => { got $x };
}

macro outer {
    ($x:ident) => { inner!($x) };
}

macro stmt {
    () => { x = 1 ; };
}

