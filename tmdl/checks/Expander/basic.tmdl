macro greet {
    ($who:ident) => { hello $who };
}

macro sub {
    ($a:ident, $b:literal, $c:tt) => { $a $b $c };
}

macro pick {
    () => { zero };
    ($x:ident) => { one };
}

macro inner {
    ($x:ident) => { got $x };
}

macro outer {
    ($x:ident) => { inner!($x) };
}

macro stmt {
    () => { x = 1 ; };
}

greet!(world)

// ident, literal and tt fragments substitute into the transcription.
sub!(foo, 42, (x))

// Arms are tried in order; the first match wins.
pick!()
pick!(a)

// A macro may emit another macro invocation; expansion re-runs.
outer!(hi)

// Invocation in statement position inside a block.
behavior { stmt!() }

// `a` is not a macro; `a != b` must pass through untouched.
a != b

