// RUN: tmdlc --action=emit-ast --output=- %s | filecheck %s

isa TestIsa32 {
    param WIDTH: Integer = 32;
}

register_class GPR for [TestIsa32] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.WIDTH;
    registers {
        x0..x31("r{}") => {                         },
    }
}

template Base for [TestIsa32] {
    param MNEMONIC: String;
    param OPCODE: bits<7>;

    operands {
        rs1: GPR,
        rs2: GPR,
        rd: GPR,
    }

    encoding {
        0x0000,
        rd,
        rs2,
        rs1,
        0b1,
    }

    asm {
        "{self.MNEMONIC} {rd}, {rs1}, {rs2}"
    }
}

macro alu {
    ($name:ident, $mn:literal, $opc:literal) => {
        instruction ${concat($name, 32)} for [TestIsa32] : Base {
            param MNEMONIC: String = $mn;
            param OPCODE: bits<7> = $opc;
            behavior { rd = rs1 + rs2; }
        }
    };
}

// `${concat}` follows its first argument's kind: an ident first argument
// yields an identifier (the instruction name), a string first argument a
// string literal (the mnemonic), a number first argument a number token
// (the opcode: 1 ++ 6 -> 16).
macro alu2 {
    ($name:ident, $mn:literal, $hi:literal, $lo:literal) => {
        instruction ${concat($name, 64)} for [TestIsa32] : Base {
            param MNEMONIC: String = ${concat($mn, 64)};
            param OPCODE: bits<7> = ${concat($hi, $lo)};
            behavior { rd = rs1 + rs2; }
        }
    };
}

alu!(Add, "add", 0b0000001)
alu!(Sub, "sub", 0b0000010)
alu2!(Mul, "mul", 1, 6)

