// RUN: not tmdlc --action=emit-ast-json --output=- %s | filecheck %s

isa TestIsa {}

register_class GPR for [TestIsa] {
    registers {
        x0..x2 => {  },
    }
}

abi TestAbi("test") for [TestIsa] {
    stack { align = 16; grows = down; red_zone = 0; slot_size = 8; }
    sp = GPR::x2;
    ra = GPR::x2;
    args int -> [GPR::x0], then stack;
    rets int -> [GPR::x0];
     callee_saved = [];
     reserved = [];
    classifier = riscv;
}

// CHECK: ABI 'TestAbi' assigns register 'GPR::x2' to both 'sp' and 'ra'
