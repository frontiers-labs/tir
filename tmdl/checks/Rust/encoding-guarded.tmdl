// Every emitter lowers one fixed bit map per instruction. A guarded encoding
// has several, and emitting the first would be wrong bytes for every operand
// value the other shapes cover, so code generation refuses it.

// RUN: not tmdlc --action=emit-rust --dialect=test --output=- %s 2>&1 | filecheck %s
// RUN: tmdlc --action=emit-ast-json --output=- %s | filecheck %s --check-prefix=JSON

isa ByteIsa {
    param XLEN: Integer = 64;
    param ENCODING_UNIT: Integer = 8;
}

register_class GPR for [ByteIsa] {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;
    registers { x0..x15 => { } }
}

instruction MovRR for [ByteIsa] {
    param MNEMONIC: String = "mov";
    param OPCODE: bits<8> = 0x8b;
    operands { dst: GPR, src: GPR }
    asm { "{self.MNEMONIC} {dst}, {src}" }
    behavior { dst = src; }
    encoding {
        if dst[3] | src[3] { (0b0100, 0b0, dst[3], 0b0, src[3]) } else { () },
        OPCODE,
        (0b11, dst[2..0], src[2..0])
    }
}

// CHECK: encoding of MovRR has more than one shape, which no emitter lowers yet

// The front end still expands and exports the shapes.
// JSON:      "width": 16,
// JSON:      "width": 24,
