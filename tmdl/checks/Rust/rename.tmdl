// RUN: tmdlc --action=emit-rust --dialect=test --text-only --output=- %s | filecheck %s

// CHECK: const [[MOVE:SCHED_C[0-9]+]]: tir::backend::sched::InstrSchedClass = tir::backend::sched::InstrSchedClass {
// CHECK: eliminated: true,
// CHECK: zero_idiom: false,
// CHECK: const [[XOR:SCHED_C[0-9]+]]: tir::backend::sched::InstrSchedClass = tir::backend::sched::InstrSchedClass {
// CHECK: eliminated: false,
// CHECK: zero_idiom: true,
// CHECK: sched: &[
// CHECK-SAME: [[MOVE]]
// CHECK: sched: &[
// CHECK-SAME: [[XOR]]

isa TestIsa {}

sched_class WriteIMove;
sched_class WriteIXor;

instruction MoveOp for [TestIsa] {
    param OPNAME: String = "a-move";
    param MNEMONIC: String = "mov";
    asm { "mov" }
    behavior { todo(); }
    schedule { units = [WriteIMove]; }
}

instruction XorOp for [TestIsa] {
    param OPNAME: String = "b-xor";
    param MNEMONIC: String = "xor";
    asm { "xor" }
    behavior { todo(); }
    schedule { units = [WriteIXor]; }
}

machine TestCore for [TestIsa] {
    unit P0 { count = 1; }
    bind WriteIMove {
        latency = 0;
        eliminated = true;
    }
    bind WriteIXor {
        latency = 1;
        uop(P0);
        zero_idiom = true;
    }
}
