// An isel rule's cost is encoding-size-aware: the mnemonic's latency scaled by
// `LATENCY_COST_SCALE` plus the instruction's encoding size in bytes, so a
// shorter encoding wins a latency tie.

// RUN: tmdlc --action=emit-rust --dialect=test --output=- %S/../Inputs/simple.tmdl | filecheck %s

// `add` is a 32-bit encoding, so its rule pays 4 bytes on top of the latency.
// CHECK: instruction_cost("add") * tir::backend::isel::LATENCY_COST_SCALE
// CHECK-NEXT: + 4u32
