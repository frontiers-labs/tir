// Atomics codegen: LR/SC/AMO/fence lower to the new `SymKind`s and behaviors
// execute against the shared `MachineMemory` adapter, which forwards to the
// `MachineContext` reservation methods, so the executor reaches the hart's
// reservation logic. Atomic behaviors are excluded from instruction selection
// and op-sem pattern generation; a plain ordered load/store is still
// selection-eligible.

// RUN: tmdlc --action=emit-rust --dialect=test --output=- %S/../Inputs/atomics.tmdl | filecheck %s

// The four atomic constructs each lower to their dedicated kind, and a plain
// store with an explicit ordering packs the ordering code into its inert
// metadata operand; both live in the sem blob (tmdl/tests/sem_blob.rs).

// A discarded atomic RMW remains an executed stateful memory operation.
// CHECK: impl tir::backend::MachineInstruction for AmoXorWDiscardOp

// An ordered plain store keeps its selection rule.
// CHECK: impl tir::sem::AsSemExpr for StRelOp

// Behaviors execute against the shared adapter inside the exec engine (its
// forwarding to the MachineContext reservation methods is covered in core), so
// the executor's reservation state is consulted.
// CHECK: tir::backend::exec::Program::Effects

// The memory the behavior touches is a field of the opcode's record.
// CHECK: effects: tir::backend::MemoryEffects

// Atomic instructions get neither an op-sem pattern nor a selection rule.
// CHECK-NOT: AsSemExpr for LrWOp
// CHECK-NOT: AsSemExpr for ScWOp
// CHECK-NOT: AsSemExpr for AmoAddWOp
// CHECK-NOT: isel_pattern_lrw
// CHECK-NOT: isel_pattern_scw
// CHECK-NOT: isel_pattern_amoaddw
// CHECK-NOT: isel_pattern_fenceinst
