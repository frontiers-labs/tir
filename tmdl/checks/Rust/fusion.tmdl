// RUN: tmdlc --action=emit-rust --dialect=test --text-only --output=- %s | filecheck %s

// The mnemonic selector expands to both cmp operations; the recipe carries
// the explicit front-end costs and fused execution operation.

// CHECK: FusionPattern {
// CHECK: name: "CmpBranch",
// CHECK: ops: &["cmp_a", "cmp_b"],
// CHECK: ops: &["jne_a"],
// CHECK: decode_uops: 1,
// CHECK: inherit_routes: Some(1),

isa TestIsa {}

sched_class WriteALU;
sched_class WriteBranch;

instruction CmpA for [TestIsa] {
    param OPNAME: String = "cmp_a";
    param MNEMONIC: String = "cmp";
    asm { "cmp" }
    behavior { todo(); }
    schedule { units = [WriteALU]; }
}

instruction CmpB for [TestIsa] {
    param OPNAME: String = "cmp_b";
    param MNEMONIC: String = "cmp";
    asm { "cmp" }
    behavior { todo(); }
    schedule { units = [WriteALU]; }
}

instruction JneA for [TestIsa] {
    param OPNAME: String = "jne_a";
    param MNEMONIC: String = "jne";
    asm { "jne" }
    behavior { todo(); }
    schedule { units = [WriteBranch]; }
}

machine Fused ("fused") for [TestIsa] {
    unit P0 { count = 1; }

    bind WriteALU { latency = 1; uop(P0); }
    bind WriteBranch { latency = 1; uop(P0); }

    fusion CmpBranch {
        match = [a: mnemonic[cmp], b: instruction[JneA]];
        schedule {
            decode_uops = 1;
            rename_slots = 1;
            rob_entries = 1;
            retire_slots = 1;
            uop fused(inherit = b) {
                inputs = [all_inputs(a), all_inputs(b)];
                outputs = [all_outputs(a), all_outputs(b)];
                memory = [a, b];
                control = [a, b];
            }
        }
    }
}
