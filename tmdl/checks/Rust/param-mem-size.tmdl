// IR migration: selector rule generation was removed.
// XFAIL: *
// A memory-access size written as a const expression over ISA parameters
// (`self.XLEN / 8`) resolves to the concrete per-ISA byte count. Such an access
// is not dynamically sized, so the instruction still roots a selection rule.
// The folded size itself lives in the sem blob and is checked by
// tmdl/tests/sem_blob.rs.

// RUN: tmdlc --action=emit-rust --dialect=test --output=- %S/../Inputs/param-mem-size.tmdl | filecheck %s

// The division is folded away, so no program in this dialect divides.
// CHECK-NOT: SymKind::Div

// CHECK: impl tir::backend::MachineInstruction for LoadWordOp
// CHECK: impl tir::backend::MachineInstruction for LoadDynOp
// CHECK: impl tir::backend::MachineInstruction for StoreWordOp

// CHECK: impl tir::sem::AsSemExpr for LoadWordOp

// CHECK: static RULE_LOADWORD

// The dynamically sized load is still kept out of instruction selection.
// CHECK-NOT: static RULE_LOADDYN
