// RUN: not tmdlc --action=emit-ast-json --text-only --output=- %s | filecheck %s
instruction I {
    param MNEMONIC: String = "i";
    operands { imm: bits<32> }
    asm { "i {imm}" }
    behavior { todo(); }
}
machine Core {
    override I { latency = 4; when asfloat(imm) == asfloat(imm) { latency = 2; } }
}
// CHECK: unsupported builtin in latency predicate
