// A slice or single bit in an encoding must lie inside the operand's declared
// width. The field's own width is never in question — it comes from the slice —
// so the only way to get the range wrong is to reach past the operand.

// RUN: not tmdlc --action=emit-rust --dialect=test --output=- %s | filecheck %s

instruction SliceOutOfRange {
    param MNEMONIC: String = "sliceoor";
    param OPCODE: bits<7> = 0b0010011;
    operands { imm: bits<13> }
    behavior { imm = imm; }
    encoding { imm[13..10], 0b0, OPCODE }
}

instruction BitOutOfRange {
    param MNEMONIC: String = "bitoor";
    param OPCODE: bits<7> = 0b0010011;
    operands { imm: bits<13> }
    behavior { imm = imm; }
    encoding { imm[13], OPCODE }
}

// CHECK-DAG: slice 'imm[13..10]' exceeds bits<13>
// CHECK-DAG: bit 'imm[13]' exceeds bits<13>
