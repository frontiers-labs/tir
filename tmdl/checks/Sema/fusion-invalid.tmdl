// Fusion declarations must name mnemonics of known instructions.

// RUN: not tmdlc --action=emit-rust --dialect=test --output=- %s | filecheck %s

sched_class W;

instruction Cmp {
    param MNEMONIC: String = "cmp";
    behavior { rd = rs1; }
    schedule { units = [W]; }
}

machine M for [RV64I] {
    unit P0 { count = 1; }
    bind W { latency = 1; uop(P0); }
    fusion Bad {
        match = [a: mnemonic[cmp], b: mnemonic[jne]];
        schedule {
            decode_uops = 1;
            rename_slots = 1;
            rob_entries = 1;
            retire_slots = 1;
            uop fused(P0) {
                inputs = [all_inputs(a), all_inputs(b)];
                outputs = [all_outputs(a), all_outputs(b)];
                memory = [a, b];
                control = [a, b];
            }
        }
    }
}

// CHECK: fusion mnemonic 'jne' matches no instruction
