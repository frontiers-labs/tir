// RUN: not tmdlc --action=emit-ast-json --text-only --output=- %s | filecheck %s
instruction I {
    param MNEMONIC: String = "i";
    asm { "i" }
    behavior { todo(); }
}
machine Core {
    override I { when 0b1 == 0b1 { latency = 4; } }
}
