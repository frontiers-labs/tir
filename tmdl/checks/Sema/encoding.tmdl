// Well-formed encodings pass semantic analysis: immediate bit splices
// (single bits and ranges) and register-operand splices over an indexed
// register file.

// RUN: tmdlc --action=emit-rust --dialect=test --output=- %s | filecheck %s

isa Arch { param XLEN: Integer = 64; }

register_class GPR for [Arch] {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;
    registers {
        rax => { index = 0 },
        r8 => { index = 8 },
    }
}

instruction ImmSplice for [Arch] {
    param MNEMONIC: String = "immsplice";
    param OPCODE: bits<7> = 0b0010011;
    operands { #[align(2)] imm: bits<13> }
    encoding { imm[12..5], imm[4..1], imm[12], OPCODE }
    asm { "{self.MNEMONIC} {imm}" }
    behavior { imm = imm; }
}

instruction RegSplice for [Arch] {
    param MNEMONIC: String = "regsplice";
    operands { dst: GPR }
    encoding { dst[2..0], 0b0100100, dst[3] }
    asm { "{self.MNEMONIC} {dst}" }
    behavior { dst = dst; }
}

// CHECK-DAG: ImmSpliceOp
// CHECK-DAG: RegSpliceOp
