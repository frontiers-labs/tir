// This file was generated with ./utils/scripts/update_checks.py. Do not modify CHECKs manually.

// RUN: tmdlc --action=emit-ast --text-only --output=- %s | filecheck %s

// Operator parsing inside behaviors: `<=`, `!=`, unary `~` and the unsigned
// comparison `~<=` each map to their AST operator.

isa Test { param XLEN: Integer = 32; }

register_class GPR for [Test] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.XLEN;
    registers { r0..r31 => {}, }
}

instruction LessEqual for [Test] {
    param MNEMONIC: String = "le";
    operands { rd: GPR, rs1: GPR, rs2: GPR, }
    asm { "{self.MNEMONIC} {rd}, {rs1}, {rs2}" }
    behavior { rd = if rs1 <= rs2 { rs1 } else { rs2 }; }
}

instruction NotEqual for [Test] {
    param MNEMONIC: String = "ne";
    operands { rd: GPR, rs1: GPR, rs2: GPR, }
    asm { "{self.MNEMONIC} {rd}, {rs1}, {rs2}" }
    behavior { rd = if rs1 != rs2 { rs1 } else { rs2 }; }
}

instruction BitwiseNot for [Test] {
    param MNEMONIC: String = "bnot";
    operands { rd: GPR, rs1: GPR, }
    asm { "{self.MNEMONIC} {rd}, {rs1}" }
    behavior { rd = rs1 & ~1; }
}

instruction UnsignedLessEqual for [Test] {
    param MNEMONIC: String = "uleu";
    operands { rd: GPR, rs1: GPR, rs2: GPR, }
    asm { "{self.MNEMONIC} {rd}, {rs1}, {rs2}" }
    behavior { rd = if rs1 ~<= rs2 { rs1 } else { rs2 }; }
}

