// This file was generated with ./utils/scripts/update_checks.py. Do not modify CHECKs manually.

// RUN: tmdlc --action=emit-ast --text-only --output=- %s | filecheck %s

// Expression parsing: `map` with a unary lambda, `reduce` with a binary
// lambda, and an operand width given by an expression (BitsExpr).

isa Test { param XLEN: Integer = 32; }

register_class VR for [Test] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;
    registers { v0..v31 => {}, }
}

instruction MapLambda for [Test] {
    param MNEMONIC: String = "maplambda";
    operands { vd: VR, vs2: VR, }
    asm { "{self.MNEMONIC} {vd}, {vs2}" }
    behavior { vd = concat(map(split(vs2, 4), |x| x + x)); }
}

instruction ReduceLambda for [Test] {
    param MNEMONIC: String = "reducelambda";
    operands { vd: VR, vs2: VR, }
    asm { "{self.MNEMONIC} {vd}, {vs2}" }
    behavior { vd = reduce(split(vs2, 4), |acc, x| acc + x); }
}

instruction WidthExpr for [Test] {
    param MNEMONIC: String = "widthexpr";
    operands { a: bits<6>, b: bits<log2Ceil(self.XLEN)>, }
    asm { "{self.MNEMONIC} {a}, {b}" }
    behavior { tmp = b; }
}

