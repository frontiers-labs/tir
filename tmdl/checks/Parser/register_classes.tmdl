// This file was generated with ./utils/scripts/update_checks.py. Do not modify CHECKs manually.

// RUN: tmdlc --action=emit-ast --text-only --output=- %s | filecheck %s

// Register-class forms: a polymorphic storage trait, inheritance (the dump
// shows GPRsp with the base's parameters and full register file merged in,
// slot x31 overridden to `sp` while the base keeps `xzr`), and a `file`
// override that shares a register file without importing its registers.

isa Isa { param XLEN: Integer = 64; }

register_class GPR for [Isa] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.XLEN;
    registers {
        x0..x30 => {},
        x31("xzr") => { traits = [hardwired_zero] },
    }
}

register_class GPRsp for [Isa] : GPR {
    registers {
        x31("sp") => {},
    }
}

register_class Poly for [Isa] {
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = self.XLEN;
    registers {
        p0 => { traits = [polymorphic] },
    }
}

register_class GPR8H for [Isa] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 8;
    registers {
        ah => { index = 0 },
    }
}

