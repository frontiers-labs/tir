// RUN: tmdlc --action=emit-ast-json --text-only --output=- %s | filecheck %s

isa TestIsa {}
sched_class Divide { latency = 20; }
register_class GPR for [TestIsa] {
    param WIDTH: Integer = 64;
    param ENCODING_LEN: Integer = 5;
    registers { r0..r7 => {} }
}
instruction Div for [TestIsa] {
    param MNEMONIC: String = "div";
    operands { dst: GPR, lhs: GPR, rhs: GPR }
    asm { "div {dst}, {lhs}, {rhs}" }
    behavior { dst = lhs / rhs; }
    schedule { units = [Divide]; }
}
machine TestCore ("test-core") for [TestIsa] {
    unit FP0 { count = 1; }
    unit FloatDivide { count = 1; }
    override Div {
        latency = 20;
        when rhs == 0b1 {
            latency = 4;
            uop(FP0 & FloatDivide<5>);
        }
    }
}

// CHECK: "latency_cases": [
// CHECK: "condition": {
// CHECK: "latency": 4
// CHECK: "uops": [
