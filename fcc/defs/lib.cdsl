use std::core::*;
use std::ir::{Bits, Cfg, VaList};

pub let va_start = op {
    dialect: "cir",
    signature: () -> (result: VaList),
    macro_def: true,
};

pub let va_arg = op {
    dialect: "cir",
    signature: (list: VaList) -> (result: Any),
    macro_def: true,
};

pub let va_end = op {
    dialect: "cir",
    signature: (list: VaList) -> (),
    macro_def: true,
};

pub let r#for = op {
    dialect: "cir",
    signature: () -> (),
    regions: (condition_region: Cfg, step_region: Cfg, body_region: Cfg),
    interfaces: (ExitScope,),
    custom_format: true,
    macro_def: true,
};

pub let r#while = op {
    dialect: "cir",
    signature: () -> (),
    regions: (condition_region: Cfg, body_region: Cfg),
    interfaces: (ExitScope,),
    custom_format: true,
    macro_def: true,
};

pub let r#do = op {
    dialect: "cir",
    signature: () -> (),
    regions: (body_region: Cfg, condition_region: Cfg),
    interfaces: (ExitScope,),
    custom_format: true,
    macro_def: true,
};

pub let condition = op {
    dialect: "cir",
    signature: (condition: Bits<1>) -> (),
    interfaces: (Terminator,),
    macro_def: true,
};

pub let r#yield = op {
    dialect: "cir",
    signature: () -> (),
    interfaces: (Terminator,),
    macro_def: true,
};

pub let r#break = op {
    dialect: "cir",
    signature: () -> (),
    interfaces: (Terminator, NonLocalExit),
    macro_def: true,
};

pub let r#continue = op {
    dialect: "cir",
    signature: () -> (),
    interfaces: (Terminator, NonLocalExit),
    macro_def: true,
};
