use std::ir::interfaces::*;

pub let va_start = {
    rust_name: "VaStartOp",
    name: "va_start",
    dialect: "cir",
    results: { result: "cir.va_list" },
    state: "none",
};

pub let va_arg = {
    rust_name: "VaArgOp",
    name: "va_arg",
    dialect: "cir",
    operands: { list: "cir.va_list" },
    results: { result: "_" },
    state: "none",
};

pub let va_end = {
    rust_name: "VaEndOp",
    name: "va_end",
    dialect: "cir",
    operands: { list: "cir.va_list" },
    state: "none",
};

pub let r#for = {
    rust_name: "ForOp",
    name: "for",
    dialect: "cir",
    regions: {
        condition_region: { kind: "Blocks", variadic: false },
        step_region: { kind: "Blocks", variadic: false },
        body_region: { kind: "Blocks", variadic: false },
    },
    interfaces: ExitScope,
    custom_format: true,
    state: "none",
};

pub let r#while = {
    rust_name: "WhileOp",
    name: "while",
    dialect: "cir",
    regions: {
        condition_region: { kind: "Blocks", variadic: false },
        body_region: { kind: "Blocks", variadic: false },
    },
    interfaces: ExitScope,
    custom_format: true,
    state: "none",
};

pub let r#do = {
    rust_name: "DoOp",
    name: "do",
    dialect: "cir",
    regions: {
        body_region: { kind: "Blocks", variadic: false },
        condition_region: { kind: "Blocks", variadic: false },
    },
    interfaces: ExitScope,
    custom_format: true,
    state: "none",
};

pub let condition = {
    rust_name: "ConditionOp",
    name: "condition",
    dialect: "cir",
    operands: { condition: "int<1>" },
    interfaces: Terminator,
    state: "none",
};

pub let r#yield = {
    rust_name: "YieldOp",
    name: "yield",
    dialect: "cir",
    interfaces: Terminator,
    state: "none",
};

pub let r#break = {
    rust_name: "BreakOp",
    name: "break",
    dialect: "cir",
    interfaces: (Terminator, NonLocalExit),
    state: "none",
};

pub let r#continue = {
    rust_name: "ContinueOp",
    name: "continue",
    dialect: "cir",
    interfaces: (Terminator, NonLocalExit),
    state: "none",
};
