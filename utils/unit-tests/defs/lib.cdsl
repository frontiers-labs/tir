use std::ir::interfaces::*;

pub let def_reg = {
    rust_name: "DefOp",
    name: "def",
    dialect: "dep",
    results: { regs: "*backend.reg<_, _>" },
    state: "none",
};

pub let update_param = {
    rust_name: "UpdateParamOp",
    name: "update_param",
    dialect: "dep",
    operands: { rs: "?backend.reg<_, _>" },
    results: { regs: "*backend.reg<_, _>" },
    state: "none",
};

