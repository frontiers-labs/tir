// RUN: cdslc --input %S/Inputs/local.cdsl --emit ast --output - | filecheck %s --check-prefix=LOCAL
// RUN: not cdslc --input %S/Inputs/unknown.cdsl --emit ast --output - 2>&1 | filecheck %s --check-prefix=UNKNOWN
// RUN: not cdslc --input %S/Inputs/external.cdsl --emit ast --output - 2>&1 | filecheck %s --check-prefix=EXTERNAL
// LOCAL: module :: file local.cdsl
// LOCAL: name: "Choice"
// LOCAL: "selected"
// LOCAL: "Choice"
// LOCAL-NEXT: "Left"
// UNKNOWN: cdslc: unknown.cdsl:{{[0-9]+}}: unresolved name missing
// EXTERNAL: cdslc: missing module outside declared in {{.*}}external.cdsl
