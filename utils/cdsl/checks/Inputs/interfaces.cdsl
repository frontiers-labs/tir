use std::Bits;
use std::El;

pub mod contracts {
    use std::Bits;
    use std::El;

    pub interface ConstantLike<w: Nat> {
        constant_value: () -> El<Bits<w>>,
    }
    pub interface Tag {}
}

use contracts::ConstantLike as Constant;
use contracts::Tag;

let marker: Tag = {};

pub let constant<w: Nat> = op {
    signature: () -> Bits<w>,
    attributes: { value: Int },
    interfaces: {
        Tag: {},
        Constant: {
            constant_value: fn () -> El<Bits<w>> {
                std::bits::from_int<w>(self.value)
            },
        },
    },
};

pub interface LocalTag { root: () -> Bool }

pub mod nested {
    pub interface LocalTag {}
    pub let operation = op {
        signature: () -> Bool,
        interfaces: { LocalTag: {} },
    };
}
