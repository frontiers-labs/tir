use tir::attributes::{AttributeValue, NamedAttribute};
use tir::parse::{Span, common::Cursor, text::Parser};
use tir::{
    AttrSchema, Context, Error, FieldSchema, IRFormatter, NewOp, NewOpParts, OpHandle,
    OpId, OpSchema, Operation, ValueId,
};

#[tir::linkme::distributed_slice(tir::OP_SCHEMAS)]
#[linkme(crate = tir::linkme)]
pub static SCHEMA: OpSchema = OpSchema {
    dialect: "@dialect@",
    name: "@name@",
    operands: &[@operands@],
    results: &[@result@],
    attributes: &[@attributes@],
    interfaces: &[@interfaces@],
    regions: &[@region_schema@],
    binding_inputs: None,
    counted_groups: None,
    scheme: @scheme@,
    signature: @signature@,
    assembly: None,
};

pub struct @RustName@(pub(crate) OpHandle);

impl @RustName@ {
    @result_getter@
    @region_getter@

    @getters@
}

impl Operation for @RustName@ {
    fn name() -> &'static str {
        SCHEMA.name
    }

    fn dialect() -> &'static str {
        SCHEMA.dialect
    }

    fn handle(&self) -> &OpHandle {
        &self.0
    }

    fn from_op_instance(handle: OpHandle) -> Self {
        assert_eq!(handle.name(), tir::OperationName::of::<Self>());
        Self(handle)
    }

    fn from_op_instance_dyn(handle: OpHandle) -> Box<dyn Operation> {
        Box::new(Self::from_op_instance(handle))
    }

    fn into_any(self: Box<Self>) -> Box<dyn std::any::Any> {
        self
    }

    fn print<'a, 'b: 'a>(&'a self, formatter: &'a mut IRFormatter<'b>) -> std::fmt::Result {
        @print_body@
    }

    fn parse(parser: &mut Parser<'_>, context: &Context) -> Result<Box<dyn Operation>, (Span, Error)> {
        @parse_body@
    }

    @registrations@
}

fn parse_optional_attributes(
    parser: &mut Parser<'_>,
    context: &Context,
) -> Result<Vec<NamedAttribute>, (Span, Error)> {
    let start = parser.pos();
    let mut attributes = Vec::new();
    if parser.parse_token("{") {
        if parser.parse_token("}") {
            return Ok(attributes);
        }
        while let Some(name) = parser.parse_attribute_name() {
            if !parser.parse_token("=") {
                break;
            }
            let Some(value) = parser.parse_attribute_value(context)? else { break };
            attributes.push(context.named_attribute(&name, value));
            if parser.parse_token("}") {
                return Ok(attributes);
            }
            if !parser.parse_token(",") {
                break;
            }
        }
        parser.set_pos(start);
    }
    Ok(Vec::new())
}


@implementations@

impl From<&@RustName@> for OpId {
    fn from(operation: &@RustName@) -> Self {
        operation.id()
    }
}
impl From<@RustName@> for OpId {
    fn from(operation: @RustName@) -> Self {
        operation.id()
    }
}

pub struct @RustName@Builder {
    context: Context,
    parts: NewOpParts,
    @fields@
    @result_field@
    @region_field@
}

impl @RustName@Builder {
    pub fn new(context: &Context) -> Self {
        Self {
            context: context.clone(),
            parts: NewOpParts::default(),
            @defaults@
            @result_default@
            @region_default@
        }
    }

    @setters@

    @result_setter@
    @region_setter@

    pub fn attr(self, name: &str, value: AttributeValue) -> Self {
        let name = self.context.intern(name);
        self.attr_sym(name, value)
    }

    pub fn attr_sym(mut self, name: tir::Sym, value: AttributeValue) -> Self {
        self.parts.attributes.push(NamedAttribute::new(name, value));
        self
    }

    pub fn build(self) -> @RustName@ {
        @required_attributes@
        let operands: [Option<ValueId>; @operand_count@] = [@operands_to_build@];
        let operands = operands.into_iter().flatten().collect();
        @build_results@
        @region_builder@
        let op = NewOp::new::<@RustName@>(self.context.clone(), operands, results, regions, self.parts);
        @RustName@(self.context.add_operation(op))
    }
}

pub fn @name@(context: &Context, @params@ @result_parameter@ @region_parameter@) -> @RustName@Builder {
    @builder_binding@@RustName@Builder::new(context)@params_to_build@@result_argument@
    @region_arguments@
}
