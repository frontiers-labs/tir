pub extern type Expr<T> = Type;
pub extern type Relation<S> = Type;
pub extern type Declaration = Type;
pub extern type Table<K,V> = Type;
pub extern type Constructor<F> = Type;
pub extern type Predicate<S> = Type;
pub extern type Container = Type;
pub extern type Set<T> = Type;
pub extern type Vec<T> = Type;
pub extern type Map<K,V> = Type;
pub extern type Goal = Type;
pub extern type Clause = Type;
pub extern type Stage = Type;
pub extern type Program = Type;
pub extern type Policy = Type;
pub extern type ResultContract = Type;
pub extern type Completion = Type;
pub extern type Publication = Type;
pub extern let truth: Goal;
pub extern let unique: Policy;
pub extern let fixed_point: Completion;
pub extern let analysis_only: Publication;
pub extern let relation<S>: (key:String)->Relation<S>;
pub extern let table<K,V>: (key:String, policy:Policy)->Table<K,V>;
pub extern let constructor<F>: (value:F)->Constructor<F>;
pub extern let primitive<F>: (name:String)->Constructor<F>;
pub extern let predicate<S>: (name:String)->Predicate<S>;
pub extern let merge<F>: (body:F)->Policy;
pub extern let erase: (row:Goal)->Goal;
pub extern let container<S,C>: ()->Container;
pub extern let forall<F>: (body:F)->Clause;
pub extern let saturate: (clauses:List<Clause>)->Stage;
pub extern let query_result<S>: (relation:Relation<S>)->ResultContract;
pub extern let program: (description:Record<{tables:List<Declaration>,stages:List<Stage>,result:ResultContract,completion:Completion,publication:Publication}>)->Program;
