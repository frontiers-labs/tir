use std::ir::Bits;
use std::ir::El;
use std::equality::Holds;

pub let add_wrapping<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let sub_wrapping<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let mul_wrapping<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let and<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let or<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let xor<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let not<w: Nat>: El<Bits<w>> -> El<Bits<w>>;
pub let neg<w: Nat>: El<Bits<w>> -> El<Bits<w>>;
pub let shl<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let lshr<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let ashr<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let sdiv<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let udiv<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let srem<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let urem<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>;
pub let eq<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let ne<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let ult<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let ule<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let ugt<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let uge<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let slt<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let sle<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let sgt<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let sge<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let signed_add_overflows<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let unsigned_add_overflows<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let signed_sub_overflows<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let unsigned_sub_overflows<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let signed_div_defined<w: Nat>: (El<Bits<w>>, El<Bits<w>>) -> Bool;
pub let zero<w: Nat>: () -> El<Bits<w>>;
pub let ones<w: Nat>: () -> El<Bits<w>>;
pub let width_value<w: Nat>: () -> El<Bits<w>>;
pub let signed_min<w: Nat>: Holds<gt(w, 0)> -> El<Bits<w>>;
pub let literal<w: Nat>: Nat -> El<Bits<w>>;
pub let from_int<w: Nat>: Int -> El<Bits<w>>;
pub let width<w: Nat>: () -> Nat;
pub let sext<w: Nat, to: Nat>: El<Bits<w>> -> El<Bits<to>>;
pub let zext<w: Nat, to: Nat>: El<Bits<w>> -> El<Bits<to>>;
pub let trunc<w: Nat, to: Nat>: El<Bits<w>> -> El<Bits<to>>;
pub let bitcast<w: Nat, to: Nat>: El<Bits<w>> -> El<Bits<to>>;
pub let from_bool: Bool -> El<Bits<1>>;
