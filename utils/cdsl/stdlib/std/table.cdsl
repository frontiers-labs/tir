pub let IntSet: Type as "IntSet";
pub let singleton: Int -> IntSet as "set-of";
pub let cardinality: IntSet -> Int as "set-length";

pub enum Merge<V: Type> {
    Union,
    Unique,
    Min: Merge<Int>,
    Max: Merge<Int>,
    SetUnion: Merge<IntSet>,
    With((V, V) -> V),
}

pub let Table<K: Type, V: Type, m: Merge<V>>: Type;
