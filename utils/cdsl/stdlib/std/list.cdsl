pub enum List<A: Type> { Nil, Cons(A, List<A>), }
let identity<A: Type> = |x: A| -> A { x };
pub let singleton<A: Type> = |x: A| -> List<A> {
    List::Cons(identity(x), List::Nil)
};
pub let map<A: Type, B: Type> =
    |xs: List<A>, f: A -> B| -> List<B> decreases xs {
        match xs {
            List::Nil => List::Nil,
            List::Cons(x, rest) => List::Cons(f(x), map(rest, f)),
        }
    };
use std::option::Option;

pub let item<A: Type> = |xs: List<A>, index: Nat| -> Option<A> decreases xs {
    match xs {
        List::Nil => Option::None<A>,
        List::Cons(value, rest) => if index == 0 {
            Option::Some<A>(value)
        } else {
            item(rest, index - 1)
        },
    }
};

let all_from<A: Type> = |xs: List<A>, index: Nat, test: (Nat, A) -> Bool| -> Bool decreases xs {
    match xs {
        List::Nil => true,
        List::Cons(value, rest) => test(index, value) && all_from(rest, index + 1, test),
    }
};

pub let all_indexed<A: Type> = |xs: List<A>, test: (Nat, A) -> Bool| -> Bool {
    all_from(xs, 0, test)
};

let first_from<A: Type> = |xs: List<A>, index: Nat, test: A -> Bool| -> Nat decreases xs {
    match xs {
        List::Nil => index,
        List::Cons(value, rest) => if test(value) { index } else { first_from(rest, index + 1, test) },
    }
};

pub let first_index_or_length<A: Type> = |xs: List<A>, test: A -> Bool| -> Nat {
    first_from(xs, 0, test)
};
