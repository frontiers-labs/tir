pub enum Schedule<A: Type> {
    Rules(A),
    Saturate(A),
    Sequence<A: Type, B: Type>(Schedule<A>, Schedule<B>) : Schedule<(A, B)>,
}
pub let Database: Type;
pub let RunLimit = { rounds: Nat };
pub let RunResult: Type;
pub let saturate<A: Type> = fn (rules: A) -> Schedule<A> { Schedule::Saturate(rules) };
pub let seq<A: Type, B: Type> = fn (first: Schedule<A>, second: Schedule<B>) -> Schedule<(A, B)> { Schedule::Sequence(first, second) };
pub let run<S: Type>: (Schedule<S>, Database, RunLimit) -> RunResult;
