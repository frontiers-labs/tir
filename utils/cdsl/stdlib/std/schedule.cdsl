pub enum Schedule<A: Type> {
    Rules(A),
    Saturate(A),
    Repeat(Nat, A),
    Sequence<A: Type, B: Type>(Schedule<A>, Schedule<B>) : Schedule<(A, B)>,
}
pub let Database: Type;
pub let RunLimit = { rounds: Nat };
pub let RunResult: Type;
pub let saturate<A: Type> = fn (rules: A) -> Schedule<A> { Schedule::Saturate(rules) };
pub let seq<A: Type, B: Type> = fn (first: Schedule<A>, second: Schedule<B>) -> Schedule<(A, B)> { Schedule::Sequence(first, second) };
pub let run<S: Type>: (Schedule<S>, Database, RunLimit) -> RunResult;
pub let sequence<A: Type>: A -> Schedule<A>;

pub let repeat_colored<A: Type>: (Nat, A) -> Schedule<A>;
pub let integer_rules<A: Type>: (A, Type, {
    binary: std::ir::BinaryIntegerOperation -> Prop,
    flag_field: (String, Bool) -> Prop,
    result: (std::ir::OperationId, std::ir::OperationKind, std::ir::ValueId, Int) -> Prop,
    operand: (std::ir::OperationId, Int, std::ir::ValueId, Int) -> Prop,
    folded: (std::ir::ValueId, std::bigint::BigInt) -> Prop,
    constant_kind: String -> Prop,
    flag_value: (std::ir::OperationId, String, Bool, Bool) -> Prop,
    constant: (std::ir::OperationId, std::ir::ValueId, std::bigint::BigInt) -> Prop,
    attribute: (String, Int, String, Int) -> Prop,
    attr_int: Int -> std::bigint::BigInt,
    attr_case: Int -> String,
    pick_case: (String, String, Bool, Bool) -> Bool,
    bool_bit: Bool -> std::bigint::BigInt,
    shift_amount: std::bigint::BigInt -> Int,
}) -> { flags: (), fold: () };
