// ── OpDef Introspection Helpers (Pure CDSL, Evaluated via NbE) ───────────────

pub let op_dialect = |op: OpDef| -> String {
    match op { OpDef::Define(d, _, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => d }
};

pub let op_name = |op: OpDef| -> String {
    match op { OpDef::Define(_, n, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => n }
};

pub let op_tag = |op: OpDef| -> String {
    match op { OpDef::Define(d, n, _, _, _, _, _, _, _, _, _, _, _, _, _, _) => d ++ "." ++ n }
};

pub let op_operands = |op: OpDef| -> List<Port> {
    match op { OpDef::Define(_, _, _, ops, _, _, _, _, _, _, _, _, _, _, _, _) => ops }
};

pub let op_results = |op: OpDef| -> List<Port> {
    match op { OpDef::Define(_, _, _, _, res, _, _, _, _, _, _, _, _, _, _, _) => res }
};

pub let op_attrs = |op: OpDef| -> List<Port> {
    match op { OpDef::Define(_, _, _, _, _, attrs, _, _, _, _, _, _, _, _, _, _) => attrs }
};

pub let op_interfaces = |op: OpDef| -> List<Interface> {
    match op { OpDef::Define(_, _, _, _, _, _, _, _, ifaces, _, _, _, _, _, _, _) => ifaces }
};

pub let op_decl_sym = |op: OpDef| -> String {
    "@cdsl:decl:" ++ op_tag(op)
};

pub let op_decl = |op: OpDef| -> Atom {
    Atom::Call(op_decl_sym(op), List())
};

pub let port_list_has = rec |name: String, ps: List<Port>| -> Bool {
    match ps {
        List::Nil => false,
        List::Cons(h, t) => match h {
            Port::Port(n, _) => if n == name { true } else { port_list_has(name, t) },
        },
    }
};

pub let op_has_attr = |op: OpDef, name: String| -> Bool {
    port_list_has(name, op_attrs(op))
};

let has_commutative = rec |xs: List<Interface>| -> Bool {
    match xs {
        List::Nil => false,
        List::Cons(h, t) => match h { Interface::Commutative => true, _ => has_commutative(t) },
    }
};

let has_constant_like = rec |xs: List<Interface>| -> Bool {
    match xs {
        List::Nil => false,
        List::Cons(h, t) => match h { Interface::ConstantLike => true, _ => has_constant_like(t) },
    }
};

let has_speculatable = rec |xs: List<Interface>| -> Bool {
    match xs {
        List::Nil => false,
        List::Cons(h, t) => match h { Interface::Speculatable => true, _ => has_speculatable(t) },
    }
};

let has_integer_arith = rec |xs: List<Interface>| -> Bool {
    match xs {
        List::Nil => false,
        List::Cons(h, t) => match h { Interface::IntegerArithmetic => true, _ => has_integer_arith(t) },
    }
};

let has_additive = rec |xs: List<Interface>| -> Bool {
    match xs {
        List::Nil => false,
        List::Cons(h, t) => match h { Interface::Additive => true, _ => has_additive(t) },
    }
};

let has_subtractive = rec |xs: List<Interface>| -> Bool {
    match xs {
        List::Nil => false,
        List::Cons(h, t) => match h { Interface::Subtractive => true, _ => has_subtractive(t) },
    }
};

pub let op_is_commutative = |op: OpDef| -> Bool { has_commutative(op_interfaces(op)) };
pub let op_is_constant_like = |op: OpDef| -> Bool { has_constant_like(op_interfaces(op)) };
pub let op_is_speculatable = |op: OpDef| -> Bool { has_speculatable(op_interfaces(op)) };
pub let op_is_integer_arith = |op: OpDef| -> Bool { has_integer_arith(op_interfaces(op)) };
pub let op_is_additive = |op: OpDef| -> Bool { has_additive(op_interfaces(op)) };
pub let op_is_subtractive = |op: OpDef| -> Bool { has_subtractive(op_interfaces(op)) };

pub let op_is_binary_int = |op: OpDef| -> Bool {
    op_is_integer_arith(op) && length(op_operands(op)) == 2 && length(op_results(op)) == 1
};

pub let op_is_pure_binary_int = |op: OpDef| -> Bool {
    op_is_binary_int(op)
        && op_is_speculatable(op)
        && !op_has_attr(op, "nsw")
        && !op_has_attr(op, "nuw")
};

// ── Schema-Driven OpDef -> EqSat Expr Lift & Commutativity Rules ─────────────

pub let dialect_commute_rules = |ops: List<OpDef>| -> List<Rule> {
    let e = Atom::Var("e");
    let ty = Atom::Var("ty");
    let x = Atom::Var("x");
    let y = Atom::Var("y");
    flat_map(|op: OpDef| -> List<Rule> {
        if op_is_commutative(op) && op_is_binary_int(op) {
            List(Rule::Clause(
                "commute::" ++ op_name(op),
                List(Fact::Eq(e, Atom::Call("Expr::Bin", List(op_decl(op), ty, x, y)))),
                List(Action::Union(e, Atom::Call("Expr::Bin", List(op_decl(op), ty, y, x)))),
            ))
        } else {
            List()
        }
    }, ops)
};

pub let dialect_lift_bin_int_rules = |ops: List<OpDef>| -> List<Rule> {
    let op_v = Atom::Var("op");
    let res = Atom::Var("res");
    let ty = Atom::Var("ty");
    let x = Atom::Var("x");
    let y = Atom::Var("y");
    let ex = Atom::Var("ex");
    let ey = Atom::Var("ey");
    flat_map(|op: OpDef| -> List<Rule> {
        if op_is_binary_int(op) {
            let wrap_guards = if op_has_attr(op, "nsw") {
                List(
                    Fact::NotRow("EqSatNoSignedWrap", List(op_v)),
                    Fact::NotRow("EqSatNoUnsignedWrap", List(op_v)),
                )
            } else {
                List()
            };
            let facts = append(
                List(
                    Fact::Row("EqSatLive", List(op_v)),
                    Fact::NotRow("EqSatPinnedOp", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::Row("Operand", List(op_v, int_lit(0), x)),
                    Fact::Row("Operand", List(op_v, int_lit(1), y)),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
                    Fact::Row("EqSatInteger", List(ty)),
                    Fact::Row("Value", List(x, ty, Atom::Var("xk"), Atom::Var("xo"), Atom::Var("xs"), Atom::Var("xd"))),
                    Fact::Row("Value", List(y, ty, Atom::Var("yk"), Atom::Var("yo"), Atom::Var("ys"), Atom::Var("yd"))),
                ),
                wrap_guards,
            );
            List(Rule::Clause(
                "lift_bin::" ++ op_name(op),
                append(facts, List(Fact::Row("OpExpr", List(op_v, int_lit(0), ex)), Fact::Row("OpExpr", List(op_v, int_lit(1), ey)))),
                List(Action::Insert("ValExpr", List(res, Atom::Call("Expr::Bin", List(op_decl(op), ty, ex, ey))))),
            ))
        } else {
            List()
        }
    }, ops)
};

pub let dialect_mark_bin_int_rules = |ops: List<OpDef>| -> List<Rule> {
    let op_v = Atom::Var("op");
    let res = Atom::Var("res");
    let ty = Atom::Var("ty");
    let x = Atom::Var("x");
    let y = Atom::Var("y");
    flat_map(|op: OpDef| -> List<Rule> {
        if op_is_binary_int(op) {
            let wrap_guards = if op_has_attr(op, "nsw") {
                List(
                    Fact::NotRow("EqSatNoSignedWrap", List(op_v)),
                    Fact::NotRow("EqSatNoUnsignedWrap", List(op_v)),
                )
            } else {
                List()
            };
            let facts = append(
                List(
                    Fact::Row("EqSatLive", List(op_v)),
                    Fact::NotRow("EqSatPinnedOp", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::Row("Operand", List(op_v, int_lit(0), x)),
                    Fact::Row("Operand", List(op_v, int_lit(1), y)),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
                    Fact::Row("EqSatInteger", List(ty)),
                    Fact::Row("Value", List(x, ty, Atom::Var("xk"), Atom::Var("xo"), Atom::Var("xs"), Atom::Var("xd"))),
                    Fact::Row("Value", List(y, ty, Atom::Var("yk"), Atom::Var("yo"), Atom::Var("ys"), Atom::Var("yd"))),
                ),
                wrap_guards,
            );
            List(Rule::Clause(
                "mark_bin::" ++ op_name(op),
                facts,
                List(
                    Action::Insert("ExprLifted", List(res)),
                    Action::Insert("EqSatLiftedOp", List(op_v)),
                ),
            ))
        } else {
            List()
        }
    }, ops)
};

pub let dialect_drop_rules = |table: String, ops: List<OpDef>| -> List<Rule> {
    flat_map(|op: OpDef| -> List<Rule> {
        if op_is_speculatable(op) && length(op_results(op)) == 1 && op_name(op) != "freeze" && op_name(op) != "bitcast" {
            List(Rule::Clause(
                "op_drop::" ++ op_name(op),
                List(),
                List(Action::Insert(table, List(op_decl(op)))),
            ))
        } else {
            List()
        }
    }, ops)
};

pub let fp_dce_rules = |ops: List<OpDef>| -> List<Rule> {
    let op_v = Atom::Var("node");
    let res = Atom::Var("res");
    let ty = Atom::Var("ty");
    flat_map(|op: OpDef| -> List<Rule> {
        if length(op_results(op)) == 1 {
            List(Rule::Clause(
                "dce_fp::" ++ op_name(op),
                List(
                    Fact::Row("ValLive", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("pos"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::NotRow("ValHasAttr", List(op_v, str_lit("semantics"))),
                    Fact::NotRow("ValExtraResult", List(op_v)),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("decl"))),
                    Fact::NotRow("ValPinnedOp", List(op_v)),
                    Fact::NotRow("ValPinned", List(res)),
                ),
                List(
                    Action::Insert("DceRemovable", List(op_v, res)),
                    Action::Insert("DceRemovableNode", List(op_v)),
                ),
            ))
        } else {
            List()
        }
    }, ops)
};

pub let fp_mark_rules = |ops: List<OpDef>| -> List<Rule> {
    let op_v = Atom::Var("op");
    let res = Atom::Var("res");
    let ty = Atom::Var("ty");
    flat_map(|op: OpDef| -> List<Rule> {
        let n_in = length(op_operands(op));
        let n_out = length(op_results(op));
        if n_in == 1 && n_out == 1 {
            List(Rule::Clause(
                "mark_fp1::" ++ op_name(op),
                List(
                    Fact::Row("EqSatLive", List(op_v)),
                    Fact::NotRow("EqSatPinnedOp", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::Row("Operand", List(op_v, int_lit(0), Atom::Var("x"))),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
                    Fact::NotRow("EqSatHasAttr", List(op_v, str_lit("semantics"))),
                    Fact::NotRow("EqSatOperandSlot", List(op_v, int_lit(1))),
                    Fact::NotRow("EqSatExtraResult", List(op_v)),
                ),
                List(
                    Action::Insert("ExprLifted", List(res)),
                    Action::Insert("EqSatLiftedOp", List(op_v)),
                ),
            ))
        } else if n_in == 2 && n_out == 1 {
            List(Rule::Clause(
                "mark_fp2::" ++ op_name(op),
                List(
                    Fact::Row("EqSatLive", List(op_v)),
                    Fact::NotRow("EqSatPinnedOp", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::Row("Operand", List(op_v, int_lit(0), Atom::Var("x"))),
                    Fact::Row("Operand", List(op_v, int_lit(1), Atom::Var("y"))),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
                    Fact::NotRow("EqSatHasAttr", List(op_v, str_lit("semantics"))),
                    Fact::NotRow("EqSatOperandSlot", List(op_v, int_lit(2))),
                    Fact::NotRow("EqSatExtraResult", List(op_v)),
                ),
                List(
                    Action::Insert("ExprLifted", List(res)),
                    Action::Insert("EqSatLiftedOp", List(op_v)),
                ),
            ))
        } else {
            List()
        }
    }, ops)
};

pub let fp_lift_rules = |ops: List<OpDef>| -> List<Rule> {
    let op_v = Atom::Var("op");
    let res = Atom::Var("res");
    let ty = Atom::Var("ty");
    let x = Atom::Var("x");
    let y = Atom::Var("y");
    let ex = Atom::Var("ex");
    let ey = Atom::Var("ey");
    flat_map(|op: OpDef| -> List<Rule> {
        let n_in = length(op_operands(op));
        let n_out = length(op_results(op));
        if n_in == 1 && n_out == 1 {
            List(Rule::Clause(
                "lift_fp1::" ++ op_name(op),
                List(
                    Fact::Row("EqSatLive", List(op_v)),
                    Fact::NotRow("EqSatPinnedOp", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::Row("Operand", List(op_v, int_lit(0), x)),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
                    Fact::Row("ExprLifted", List(res)),
                    Fact::Row("OpExpr", List(op_v, int_lit(0), ex)),
                ),
                List(Action::Insert("ValExpr", List(res, Atom::Call("Expr::Unary", List(op_decl(op), ty, ex))))),
            ))
        } else if n_in == 2 && n_out == 1 {
            List(Rule::Clause(
                "lift_fp2::" ++ op_name(op),
                List(
                    Fact::Row("EqSatLive", List(op_v)),
                    Fact::NotRow("EqSatPinnedOp", List(op_v)),
                    Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
                    Fact::Row("Operand", List(op_v, int_lit(0), x)),
                    Fact::Row("Operand", List(op_v, int_lit(1), y)),
                    Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
                    Fact::Row("ExprLifted", List(res)),
                    Fact::Row("OpExpr", List(op_v, int_lit(0), ex)),
                    Fact::Row("OpExpr", List(op_v, int_lit(1), ey)),
                ),
                List(Action::Insert("ValExpr", List(res, Atom::Call("Expr::Bin", List(op_decl(op), ty, ex, ey))))),
            ))
        } else {
            List()
        }
    }, ops)
};

// Typed IR host primitives (automatically emit `bind_std_ir_*` in Rust!)
pub let integer_width: Int -> Int;
pub let fp_format: Int -> Int;
pub let type_argument: (Int, Int) -> Int;

// Egglog IR helper calls for rules
pub let operand = |op: Atom, slot: Atom| -> Atom { Atom::Call("Operand", List(op, slot)) };
pub let attribute = |kind: Atom, owner: Atom, name: Atom| -> Atom { Atom::Call("Attribute", List(kind, owner, name)) };

