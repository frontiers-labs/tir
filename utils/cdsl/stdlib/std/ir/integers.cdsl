// Pure-CDSL v3 Integer Constant-Folding Rules over `Expr` e-classes.
//
// Operates directly on `Expr::Bin`, `Expr::Unary`, and `Expr::Compare` so any
// rewritten subexpression folds immediately inside the e-graph!

use std::core::*;
use std::bigint::{bigint, bigint_of, bit_and, bit_or, bit_xor, shl, shr};
use std::bigint::add as big_add;
use std::bigint::sub as big_sub;
use std::bigint::mul as big_mul;
use std::bigint::div as big_div;
use std::bigint::rem as big_rem;
use std::int::{bool_lt, equal, ge, log_and, log_not, log_or};
use std::ir::{op_decl, op_name};

let eqsat_shift_amount = |x: Atom| -> Atom { Atom::Call("eqsat_shift_amount", List(x)) };
let eqsat_bool_bit = |b: Atom| -> Atom { Atom::Call("eqsat_bool_bit", List(b)) };
let eqsat_pick_case = |p: Atom, n: Atom, c: Atom, f: Atom| -> Atom {
    Atom::Call("eqsat_pick_case", List(p, n, c, f))
};

let width_pow2 = |w: Atom| -> Atom { shl(bigint(1), w) };
let width_mask = |w: Atom| -> Atom { big_sub(width_pow2(w), bigint(1)) };
let sign_bit = |w: Atom| -> Atom { shr(width_pow2(w), int_lit(1)) };
let wrap_bits = |x: Atom, w: Atom| -> Atom { bit_and(x, width_mask(w)) };
let to_signed = |x: Atom, w: Atom| -> Atom {
    let sb = sign_bit(w);
    big_sub(bit_xor(x, sb), sb)
};

let signed_add_overflow = |a: Atom, b: Atom, w: Atom| -> Atom {
    let sum = big_add(to_signed(a, w), to_signed(b, w));
    log_not(equal(sum, to_signed(wrap_bits(sum, w), w)))
};
let unsigned_add_overflow = |a: Atom, b: Atom, w: Atom| -> Atom {
    ge(big_add(a, b), width_pow2(w))
};
let signed_sub_overflow = |a: Atom, b: Atom, w: Atom| -> Atom {
    let diff = big_sub(to_signed(a, w), to_signed(b, w));
    log_not(equal(diff, to_signed(wrap_bits(diff, w), w)))
};
let unsigned_sub_overflow = |a: Atom, b: Atom| -> Atom { bool_lt(a, b) };

let signed_div_defined = |a: Atom, b: Atom, w: Atom| -> Atom {
    let neg1 = wrap_bits(bigint(-1), w);
    log_and(
        log_not(equal(b, bigint(0))),
        log_not(log_and(equal(a, sign_bit(w)), equal(b, neg1))),
    )
};
let unsigned_div_defined = |b: Atom| -> Atom { log_not(equal(b, bigint(0))) };

let fold_bin = |rname: String, op: OpDef, extra_facts: List<Fact>, result_expr: Atom| -> Rule {
    let e = Atom::Var("e");
    let ty = Atom::Var("ty");
    let w = Atom::Var("w");
    let b0 = Atom::Var("b0");
    let b1 = Atom::Var("b1");
    let base: List<Fact> = List(
        Fact::Eq(
            e,
            Atom::Call(
                "Expr::Bin",
                List(
                    op_decl(op),
                    ty,
                    Atom::Call("Expr::Const", List(ty, b0)),
                    Atom::Call("Expr::Const", List(ty, b1)),
                ),
            ),
        ),
        Fact::Row("TypeWidth", List(ty, w)),
    );
    Rule::Clause(
        rname,
        append(base, extra_facts),
        List(Action::Union(e, Atom::Call("Expr::Const", List(ty, result_expr)))),
    )
};

// Fold flagged `addi`/`subi` (not lifted as wrapping `Expr::Bin`) when constants don't overflow.
let fold_flagged_bin = |rname: String, op: OpDef, s_ovf: Atom, u_ovf: Atom, result_expr: Atom| -> List<Rule> {
    let op_v = Atom::Var("op");
    let res = Atom::Var("res");
    let er = Atom::Var("er");
    let ty = Atom::Var("ty");
    let w = Atom::Var("w");
    let o0 = Atom::Var("o0");
    let o1 = Atom::Var("o1");
    let b0 = Atom::Var("b0");
    let b1 = Atom::Var("b1");
    let base: List<Fact> = List(
        Fact::Row("EqSatLive", List(op_v)),
        Fact::NotRow("EqSatPinnedOp", List(op_v)),
        Fact::Row("Operation", List(op_v, op_decl(op), Atom::Var("pl"), Atom::Var("hm"), Atom::Var("ps"), Atom::Var("dp"), Atom::Var("lc"))),
        Fact::Row("Operand", List(op_v, int_lit(0), o0)),
        Fact::Row("Operand", List(op_v, int_lit(1), o1)),
        Fact::Row("Value", List(res, ty, str_lit("result"), op_v, int_lit(0), Atom::Var("rd"))),
        Fact::Row("TypeWidth", List(ty, w)),
        Fact::Row("ValExpr", List(res, er)),
        Fact::Row("ValExpr", List(o0, Atom::Call("Expr::Const", List(ty, b0)))),
        Fact::Row("ValExpr", List(o1, Atom::Call("Expr::Const", List(ty, b1)))),
    );
    let act = List(Action::Union(er, Atom::Call("Expr::Const", List(ty, result_expr))));
    List(
        Rule::Clause(
            rname ++ "::nsw_only",
            append(base, List(
                Fact::Row("EqSatNoSignedWrap", List(op_v)),
                Fact::NotRow("EqSatNoUnsignedWrap", List(op_v)),
                Fact::Eq(s_ovf, bool_lit(false)),
            )),
            act,
        ),
        Rule::Clause(
            rname ++ "::nuw_only",
            append(base, List(
                Fact::NotRow("EqSatNoSignedWrap", List(op_v)),
                Fact::Row("EqSatNoUnsignedWrap", List(op_v)),
                Fact::Eq(u_ovf, bool_lit(false)),
            )),
            act,
        ),
        Rule::Clause(
            rname ++ "::nsw_nuw",
            append(base, List(
                Fact::Row("EqSatNoSignedWrap", List(op_v)),
                Fact::Row("EqSatNoUnsignedWrap", List(op_v)),
                Fact::Eq(log_or(s_ovf, u_ovf), bool_lit(false)),
            )),
            act,
        ),
    )
};

let fold_unary = |rname: String, op: OpDef, same_width: Bool, result_expr: Atom| -> Rule {
    let e = Atom::Var("e");
    let ty_out = Atom::Var("ty_out");
    let ty_in = if same_width { ty_out } else { Atom::Var("ty_in") };
    let w_out = Atom::Var("w_out");
    let w_in = if same_width { w_out } else { Atom::Var("w_in") };
    let b0 = Atom::Var("b0");
    let width_facts = if same_width {
        List(Fact::Row("TypeWidth", List(ty_out, w_out)))
    } else {
        List(
            Fact::Row("TypeWidth", List(ty_in, w_in)),
            Fact::Row("TypeWidth", List(ty_out, w_out)),
        )
    };
    Rule::Clause(
        rname,
        append(
            List(Fact::Eq(
                e,
                Atom::Call("Expr::Unary", List(op_decl(op), ty_out, Atom::Call("Expr::Const", List(ty_in, b0)))),
            )),
            width_facts,
        ),
        List(Action::Union(e, Atom::Call("Expr::Const", List(ty_out, result_expr)))),
    )
};

let op_fold_rule = |op: OpDef| -> List<Rule> {
    let nm = op_name(op);
    let w = Atom::Var("w");
    let b0 = Atom::Var("b0");
    let b1 = Atom::Var("b1");
    let w_in = Atom::Var("w_in");
    let w_out = Atom::Var("w_out");
    let shift_ok = List(Fact::Eq(ge(b1, bigint_of(w)), bool_lit(false)));

    if nm == "addi" {
        append(
            List(fold_bin("fold::addi", op, List(), wrap_bits(big_add(b0, b1), w))),
            fold_flagged_bin(
                "fold::addi_flagged", op,
                signed_add_overflow(b0, b1, w),
                unsigned_add_overflow(b0, b1, w),
                wrap_bits(big_add(b0, b1), w),
            ),
        )
    } else if nm == "subi" {
        append(
            List(fold_bin("fold::subi", op, List(), wrap_bits(big_sub(b0, b1), w))),
            fold_flagged_bin(
                "fold::subi_flagged", op,
                signed_sub_overflow(b0, b1, w),
                unsigned_sub_overflow(b0, b1),
                wrap_bits(big_sub(b0, b1), w),
            ),
        )
    } else if nm == "muli" {
        List(fold_bin("fold::muli", op, List(), wrap_bits(big_mul(b0, b1), w)))
    } else if nm == "divsi" {
        List(fold_bin("fold::divsi", op, List(Fact::Eq(signed_div_defined(b0, b1, w), bool_lit(true))), wrap_bits(big_div(to_signed(b0, w), to_signed(b1, w)), w)))
    } else if nm == "divui" {
        List(fold_bin("fold::divui", op, List(Fact::Eq(unsigned_div_defined(b1), bool_lit(true))), big_div(b0, b1)))
    } else if nm == "remsi" {
        List(fold_bin("fold::remsi", op, List(Fact::Eq(signed_div_defined(b0, b1, w), bool_lit(true))), wrap_bits(big_rem(to_signed(b0, w), to_signed(b1, w)), w)))
    } else if nm == "remui" {
        List(fold_bin("fold::remui", op, List(Fact::Eq(unsigned_div_defined(b1), bool_lit(true))), big_rem(b0, b1)))
    } else if nm == "andi" {
        List(fold_bin("fold::andi", op, List(), bit_and(b0, b1)))
    } else if nm == "ori" {
        List(fold_bin("fold::ori", op, List(), bit_or(b0, b1)))
    } else if nm == "xori" {
        List(fold_bin("fold::xori", op, List(), bit_xor(b0, b1)))
    } else if nm == "shli" {
        List(fold_bin("fold::shli", op, shift_ok, wrap_bits(shl(b0, eqsat_shift_amount(b1)), w)))
    } else if nm == "shrui" {
        List(fold_bin("fold::shrui", op, shift_ok, wrap_bits(shr(b0, eqsat_shift_amount(b1)), w)))
    } else if nm == "shrsi" {
        List(fold_bin("fold::shrsi", op, shift_ok, wrap_bits(shr(to_signed(b0, w), eqsat_shift_amount(b1)), w)))
    } else if nm == "extsi" {
        List(fold_unary("fold::extsi", op, false, wrap_bits(to_signed(b0, w_in), w_out)))
    } else if nm == "extui" {
        List(fold_unary("fold::extui", op, false, wrap_bits(b0, w_out)))
    } else if nm == "trunci" {
        List(fold_unary("fold::trunci", op, false, wrap_bits(b0, w_out)))
    } else if nm == "bitcast" {
        List(fold_unary("fold::bitcast", op, true, wrap_bits(b0, w_out)))
    } else if nm == "cmpi" {
        let e = Atom::Var("e");
        let pred_v = Atom::Var("pred");
        let ty_out = Atom::Var("ty_out");
        let ty_in = Atom::Var("ty_in");
        let s0 = to_signed(b0, w);
        let s1 = to_signed(b1, w);
        let cmp_chain = eqsat_pick_case(
            pred_v, str_lit("eq"), equal(b0, b1),
            eqsat_pick_case(pred_v, str_lit("ne"), log_not(equal(b0, b1)),
            eqsat_pick_case(pred_v, str_lit("slt"), bool_lt(s0, s1),
            eqsat_pick_case(pred_v, str_lit("sgt"), bool_lt(s1, s0),
            eqsat_pick_case(pred_v, str_lit("sle"), log_not(bool_lt(s1, s0)),
            eqsat_pick_case(pred_v, str_lit("sge"), log_not(bool_lt(s0, s1)),
            eqsat_pick_case(pred_v, str_lit("ult"), bool_lt(b0, b1),
            eqsat_pick_case(pred_v, str_lit("ugt"), bool_lt(b1, b0),
            eqsat_pick_case(pred_v, str_lit("ule"), log_not(bool_lt(b1, b0)),
            log_not(bool_lt(b0, b1)))))))))),
        );
        let cmp_bit = eqsat_bool_bit(cmp_chain);
        List(Rule::Clause(
            "fold::cmpi",
            List(
                Fact::Eq(
                    e,
                    Atom::Call(
                        "Expr::Compare",
                        List(
                            pred_v,
                            ty_out,
                            Atom::Call("Expr::Const", List(ty_in, b0)),
                            Atom::Call("Expr::Const", List(ty_in, b1)),
                        ),
                    ),
                ),
                Fact::Row("TypeWidth", List(ty_in, w)),
            ),
            List(Action::Union(e, Atom::Call("Expr::Const", List(ty_out, cmp_bit)))),
        ))
    } else {
        List()
    }
};

pub let integer_fold_rules = |ops: List<OpDef>| -> List<Rule> {
    flat_map(op_fold_rule, ops)
};

extract rust eqsat_shift_amount    => "@ct";
extract rust eqsat_bool_bit        => "@ct";
extract rust eqsat_pick_case       => "@ct";
extract rust width_pow2            => "@ct";
extract rust width_mask            => "@ct";
extract rust sign_bit              => "@ct";
extract rust wrap_bits             => "@ct";
extract rust to_signed             => "@ct";
extract rust signed_add_overflow   => "@ct";
extract rust unsigned_add_overflow => "@ct";
extract rust signed_sub_overflow   => "@ct";
extract rust unsigned_sub_overflow => "@ct";
extract rust signed_div_defined    => "@ct";
extract rust unsigned_div_defined  => "@ct";
extract rust fold_bin              => "@ct";
extract rust fold_flagged_bin      => "@ct";
extract rust fold_unary            => "@ct";
extract rust op_fold_rule          => "@ct";
extract rust integer_fold_rules    => "@ct";
