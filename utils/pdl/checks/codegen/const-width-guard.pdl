// A `const<8>` binder generates a width check on the matched constant: the
// constant column names the value, and a guard reads the width off it.
// RUN: tir-pdl %s --emit rust | filecheck %s

rule width: builtin.muli(x: int<W>, c: const<8>) => x;

// CHECK: Atom::Fact { column : ColumnId::Const
// CHECK: field::INT_WIDTH
// CHECK: Expr::Lit(8i64)
