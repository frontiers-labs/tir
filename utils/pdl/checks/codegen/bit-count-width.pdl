// Bit counts run on the constant's own width, so the host function rebuilds the
// APInt from the value and width the atoms bound.
// RUN: tir-pdl %s --emit rust | filecheck %s

rule count: builtin.muli(x: int<W>, c: const) => x where clz(c) == 7;

// CHECK: APInt::new(args[1usize] as u32, args[0usize]).count_leading_zeros()
