// IR migration: the Rust rewrite emitter was removed.
// XFAIL: *
// A `#` term patterns on its semantic operator, with no special case per name.
// RUN: tir-pdl %s --emit rust | filecheck %s

rule if-same: #if(c, x, x) => x;
rule theta-same: #theta(x, x) => x;

// CHECK: Node::sym_pattern(SymKind::If
// CHECK: Node::sym_pattern(SymKind::Theta
