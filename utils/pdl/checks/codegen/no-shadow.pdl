// A binder named like a generated local cannot shadow one: a rule names class
// variables by number, so there is nothing to shadow.
// RUN: tir-pdl %s --emit rust | filecheck %s

rule shadow-context: builtin.subi(context: int<W>, context) => const<W>(0);

