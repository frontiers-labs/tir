// A refinement is directional and carries typed contract requirements.
// RUN: tir-pdl %s --emit ast | filecheck %s

refinement contract-mul-add: fp.add(fp.mul(a: float<64>, b: float<64>), c: float<64>) ~> fp.fma(a, b, c)
    requires same_round_region, permits(contract_mul_add), compatible_formats_and_rounding
    proof contract;

// CHECK: kind: Refinement
// CHECK: requirements: [
// CHECK-NEXT: SameRoundRegion,
// CHECK: Permits(
// CHECK-NEXT: ContractMulAdd
// CHECK: CompatibleFormatsAndRounding
// CHECK: proof: Some(
// CHECK-NEXT: Contract
