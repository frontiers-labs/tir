// RUN: tir opt --pass dse --verify %s | filecheck %s

// A fresh allocation is nothing else, so the write to the second slot is no
// barrier: the scan walks past it and finds the write that overwrites the first.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i32, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %3
    ptr.store %1, %4
    ptr.store %2, %3
    %5 = ptr.load %3 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.store %0,
// CHECK: ptr.store %1, %4
// CHECK-NEXT: ptr.store %2, %3
