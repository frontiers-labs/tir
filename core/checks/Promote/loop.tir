// RUN: tir opt --pass promote --verify %s | filecheck %s

// A slot the body reads and writes becomes a carried port: the loop is entered
// on the value before it, the body reads the argument and latches what it
// computed, and the read after the loop is the loop's result.

module {
  %fn_count = func.func @count(%0: !index, %1: !index, %2: !index, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    scf.for %0, %1, %2 {
      %5 = ptr.load %4 : !i32
      %6 = addi %5, %5 : !i32
      ptr.store %6, %4
      scf.yield
    }
    %7 = ptr.load %4 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @count
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.for %0, %1, %2 iter_args(%[[CARRIED:[0-9]+]] = %3) -> !i32 {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[CARRIED]], %[[CARRIED]] : !i32
// CHECK-NEXT: scf.yield %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
