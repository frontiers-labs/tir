// RUN: tir opt --pass promote --verify %s | filecheck %s

// A slot handed to a call is memory something outside the function can read, so
// its value is not the walk's to carry: the allocation and both accesses stay.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call %fn_sink(%1 : !ptr.p<!i32>)
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[ARG:[0-9]+]]: !i32)
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: ptr.store %[[ARG]], %[[SLOT]]
// CHECK-NEXT: func.call
// CHECK-NEXT: %[[READ:[0-9]+]] = ptr.load %[[SLOT]] : !i32
// CHECK-NEXT: func.return %[[READ]]
