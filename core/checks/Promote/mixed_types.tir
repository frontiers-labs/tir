// RUN: tir opt --pass func.func(promote-nodes) --verify %s | filecheck %s

// The accesses disagree on the type the slot holds, so the value carried out of
// the gate would have no spelling. The slot stays memory.

module {
  %fn_mixed = func.func @mixed(%0: !i1, %1: !i32, %2: !f32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p
    state(%4) = state.entry_state
    state(%5) = scf.switch %0 args(state(%4)) (state(%6)) {
      state(%7) = ptr.store %2, %3 state(%6)
      -> state(%7)
    }
    (state(%8)) {
      state(%9) = ptr.store %1, %3 state(%8)
      -> state(%9)
    }
    %10, state(%11) = ptr.load %3 state(%5) : !i32
    -> %10, state(%11)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @mixed
// CHECK: ptr.alloca
// CHECK: ptr.store %2
// CHECK: ptr.store %1
// CHECK: ptr.load
