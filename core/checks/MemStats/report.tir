// IR migration: optimizer and storage memory statistics are unavailable.
// XFAIL: *
// RUN: env TIR_MEM_STATS=1 tir opt --pass instcombine-nodes %s 2>&1 | filecheck %s
// RUN: tir opt --pass instcombine-nodes %s 2>&1 | filecheck --check-prefix=QUIET %s

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = constant {value = 0} : !i32
    %2 = addi %0, %1 : !i32
    -> %2
  }
  module_end
}

// CHECK: tir-mem: egraph label=instcombine-nodes nodes=
// CHECK: tir-mem: pass name=instcombine-nodes vmhwm_kb=
// CHECK-SAME: hwm_delta_kb=
// CHECK-SAME: rss_delta_kb=
// CHECK: tir-mem: context after=instcombine-nodes ops_live=
// CHECK-SAME: values_live=
// CHECK-SAME: blocks_live=
// CHECK-SAME: regions_live=
// CHECK-SAME: ops_chunks=
// CHECK-SAME: storage_bytes=
// CHECK: tir-mem: summary peak_vmhwm_kb=
// CHECK: tir-mem: top-pass name=instcombine-nodes hwm_delta_kb=

// QUIET-NOT: tir-mem:
