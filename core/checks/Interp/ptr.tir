// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = ptr.alloca {size = 8, align = 4} : !ptr.p<!i32>
    %1 = ptr.alloca {size = 8, align = 4} : !ptr.p<!i32>
    %2 = constant {value = 21} : !i32
    ptr.store %2, %0
    %3 = ptr.load %0 : !i32
    %4 = muli %3, %3 : !i32
    ptr.store %4, %1
    %5 = ptr.load %1 : !i32
    func.return %5
  }
  module_end
}

// CHECK: i32 441
