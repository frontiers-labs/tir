// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !i32 {
    %lb = constant {value = 0} : !index
    %ub = constant {value = 10} : !index
    %step = constant {value = 1} : !index
    %init = constant {value = 0} : !i32
    %sum = scf.for %lb, %ub, %step iter_args(%acc = %init) -> !i32 {
      %one = constant {value = 1} : !i32
      %next = addi %acc, %one : !i32
      scf.yield %next
    }
    func.return %sum
  }
  module_end
}

// CHECK: i32 10
