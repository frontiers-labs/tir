// RUN: tir interp %s -f select --args=1,10,20 | filecheck %s
// RUN: tir interp %s -f select --args=0,10,20 | filecheck %s --check-prefix=ZERO

module {
  func.func @select(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
  ^entry:
    cfg.cond_br %0, ^left(%1 : !i32), ^right(%2 : !i32)
  ^left(%3: !i32):
    cfg.br ^exit(%3 : !i32)
  ^right(%4: !i32):
    cfg.br ^exit(%4 : !i32)
  ^exit(%5: !i32):
    func.return %5
  }
  module_end
}

// CHECK: i32 10
// ZERO: i32 20
