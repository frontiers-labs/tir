// RUN: tir interp %s | filecheck %s

// Ranges that share a byte are not disjoint, whichever order they are named in.

module {
  %fn_main = func.func @main() -> !i1 {
    %0 = ptr.alloca {size = 16, align = 4} : !ptr.p<!i32>
    %1 = constant {value = 8} : !i64
    %2 = constant {value = 4} : !i64
    %3 = ptr.ptradd %0, %2 : !ptr.p<!i32>
    %4 = ptr.disjoint %0, %1, %3, %1 : !i1
    %5 = ptr.disjoint %3, %1, %0, %1 : !i1
    %6 = ori %4, %5 : !i1
    func.return %6
  }
  module_end
}

// CHECK: i1 0
