// RUN: tir interp %s --args=6 | filecheck %s

// The interpreter reads a split as one memory named once per chain and a join as
// the memory its inputs name: reads leave memory as they found it, so the state
// after a fork of them is the state before it.

module {
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %1 | %13 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %14, %2 = state.split | %13
    | %3 = ptr.store %0, %1 | %2
    %4 | %5 = ptr.load %1 | %3 : !i32
    %6 | %7 = ptr.load %1 | %3 : !i32
    | %8 = state.join | %14, %5, %7
    %9 = addi %4, %6 : !i32
    | %10 = ptr.store %9, %1 | %8
    %11 | %12 = ptr.load %1 | %10 : !i32
    func.return %11
  }
  module_end
}

// CHECK: i32 12
