// RUN: tir interp %s --args=0,5 | filecheck --check-prefix=ARM0 %s
// RUN: tir interp %s --args=1,5 | filecheck --check-prefix=ARM1 %s
// RUN: tir interp %s --args=9,5 | filecheck --check-prefix=LAST %s

// The predicate indexes the arms; a predicate past the last arm takes it.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32) -> !i32 {
    %2 = scf.switch %0 args(%1) (%3) {
      -> %3
    }
    (%4) {
      %5 = addi %4, %4 : !i32
      -> %5
    }
    (%6) {
      %7 = muli %6, %6 : !i32
      -> %7
    }
    func.return %2
  }
  module_end
}

// ARM0: i32 5
// ARM1: i32 10
// LAST: i32 25
