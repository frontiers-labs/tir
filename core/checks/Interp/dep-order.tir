// RUN: tir interp %s | filecheck %s

// `*p = 1; x = *p; *p = 2`: the dependencies alone order the read between the two
// writes, so x is 1 and the memory ends at 2.

module {
  %fn_main = func.func @main() -> !i32 {
    %p, state(%s0) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %one = constant {value = 1} : !i32
    %two = constant {value = 2} : !i32
    %ten = constant {value = 10} : !i32
    state(%s1) = ptr.store %one, %p state(%s0)
    %x, state(%s2) = ptr.load %p state(%s1) : !i32
    state(%s3) = ptr.store %two, %p state(%s2)
    %final, state(%s4) = ptr.load %p state(%s3) : !i32
    %scaled = muli %x, %ten : !i32
    %sum = addi %scaled, %final : !i32
    func.return %sum state(%s4)
  }
  module_end
}

// CHECK: i32 12
