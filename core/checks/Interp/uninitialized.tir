// RUN: tir interp %s | filecheck %s

// A load of memory nothing wrote is poison: only a use of it is undefined.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = ptr.alloca {size = 8, align = 4} : !ptr.p<!i32>
    %1 = ptr.load %0 : !i32
    func.return %1
  }
  module_end
}

// CHECK: i32 poison
