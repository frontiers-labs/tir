// RUN: tir interp %s | filecheck %s

// Adjacent ranges share no byte, whichever order they are named in.

module {
  %fn_main = func.func @main() -> !i1 {
    %0 = ptr.alloca {size = 16, align = 4} : !ptr.p<!i32>
    %1 = constant {value = 8} : !i64
    %2 = ptr.ptradd %0, %1 : !ptr.p<!i32>
    %3 = ptr.disjoint %0, %1, %2, %1 : !i1
    %4 = ptr.disjoint %2, %1, %0, %1 : !i1
    %5 = andi %3, %4 : !i1
    func.return %5
  }
  module_end
}

// CHECK: i1 1
