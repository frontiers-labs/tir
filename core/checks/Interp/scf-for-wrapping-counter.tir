// RUN: tir interp %s | filecheck %s

// A counted loop counts through the type its bounds name, wrapping where that
// type wraps. Stepping an `!i8` counter past its minimum lands on a large
// positive value, which fails the signed latch and ends the loop after two
// iterations; counting the same bounds at a wider type would never end.

module {
  %fn_main = func.func @main() -> !i32 {
    %lb = constant {value = -126} : !i8
    %ub = constant {value = 0} : !i8
    %step = constant {value = -2} : !i8
    %init = constant {value = 0} : !i32
    %count = scf.for_legacy %lb, %ub, %step iter_args(%acc = %init) -> !i32 {
      %one = constant {value = 1} : !i32
      %next = addi %acc, %one : !i32
      scf.yield %next
    }
    func.return %count
  }
  module_end
}

// CHECK: i32 2
