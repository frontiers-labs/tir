// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !i64 {
    %0 = constant {value = 10} : !i64
    %1 = func.call %fn_fact(%0 : !i64) -> !i64
    func.return %1
  }
  %fn_fact = func.func @fact(%n: !i64) -> !i64 {
    %one = constant {value = 1} : !i64
    %base = cmpi %n, %one {predicate = "sle"} : !i1
    cfg.cond_br %base, ^base, ^step
  ^base:
    func.return %one
  ^step:
    %nm1 = subi %n, %one : !i64
    %sub = func.call %fn_fact(%nm1 : !i64) -> !i64
    %prod = muli %n, %sub : !i64
    func.return %prod
  }
  module_end
}

// CHECK: i64 3628800
