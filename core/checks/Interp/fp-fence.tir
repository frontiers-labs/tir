// RUN: tir opt --verify %s | filecheck --check-prefix=IR %s
// RUN: tir interp %s | filecheck --check-prefix=EVAL %s

module {
  %main = func.func @main() -> !i32 {
    %value = fp.constant {bits = 2147483648} : !f32
    %fenced = fp.fence %value : !f32
    %bits = bitcast %fenced : !i32
    -> %bits
  }
  module_end
}

// IR: fp.fence %{{[0-9]+}} : !f32
// EVAL: !i32 2147483648
