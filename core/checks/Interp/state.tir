// RUN: tir interp %s | filecheck %s

module {
  %fn_main = func.func @main() -> !i32 {
    state(%state0) = state.entry_state
    %slot, state(%state1) = ptr.alloca {size = 8, align = 4} : !ptr.p<!i32>
    %forty = constant {value = 40} : !i32
    state(%state2) = ptr.store %forty, %slot state(%state1)
    %two = constant {value = 2} : !i32
    %loaded, state(%state3) = ptr.load %slot state(%state2) : !i32
    %doubled = muli %loaded, %two : !i32
    func.return %doubled
  }
  module_end
}

// CHECK: i32 80
