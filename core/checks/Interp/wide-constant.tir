// RUN: tir opt --verify %s | filecheck %s
// RUN: tir interp %s --args=5 | filecheck --check-prefix=VALUE %s
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | tir interp --args=5 | filecheck --check-prefix=VALUE %s
// RUN: tir interp %s -f shift | filecheck --check-prefix=SHIFT %s

// An integer is as wide as its type. A constant an `i64` cannot spell keeps
// its limbs and prints as its unsigned value.

module {
  %fn_main = func.func @main(%0: !i200) -> !i200 {
    %1 = constant {value = 1606938044258990275541962092341162602522202993782792835301374} : !i200
    %2 = addi %0, %1 : !i200
    %3 = constant {value = 18446744073709551616} : !i200
    %4 = muli %2, %3 : !i200
    func.return %4
  }
  %fn_shift = func.func @shift() -> !i128 {
    %0 = constant {value = 1} : !i128
    %1 = constant {value = 18446744073709551616} : !i128
    %2 = shli %0, %1 : !i128
    func.return %2
  }
  module_end
}

// CHECK: constant {value = 1606938044258990275541962092341162602522202993782792835301374} : !i200
// CHECK: constant {value = 18446744073709551616} : !i200

// (5 + 2^200 - 2) * 2^64 at 200 bits.
// VALUE: !i200 55340232221128654848

// A shift amount of 2^64 is past the width, whatever its low limb says.
// SHIFT: !i128 0
