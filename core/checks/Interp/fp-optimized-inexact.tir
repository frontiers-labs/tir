// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes),dce --verify %s | tir interp - | filecheck %s

module {
  %main = func.func @main() -> !i5 {
    %env0 = state.entry_state : !state<fp.env>
    %all_flags = constant {value = 31} : !i5
    %env1 = fp.clear_flags %all_flags state(%env0)
    %one = fp.constant {bits = 1065353216} : !f32
    %three = fp.constant {bits = 1077936128} : !f32
    %unused, %env2 = fp.div %one, %three state(%env1) {semantics = {exceptions = "flags"}} : !f32
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    func.return %flags state(%env3)
  }
  module_end
}

// CHECK: i5 1
