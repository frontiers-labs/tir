// RUN: tir opt --verify %s | filecheck %s

// A data declaration is the symbol a reference to an object defined elsewhere
// resolves to.

module {
  func.declare @counter
  func.func @counter_address() -> !ptr.p {
    %0 = func.addr_of {sym_name = "counter"} : !ptr.p
    func.return %0
  }
  module_end
}

// CHECK: func.declare @counter
// CHECK: func.addr_of {sym_name = "counter"}
