// RUN: tir opt --pass=check-unique-symbols %s | filecheck %s

// Once each overload carries a distinct name, the module is ready for lowering.

module {
  func.func @f_i32(%0: !i32) -> !i32 {
    func.return %0
  }
  func.func @f_f64(%1: !f64) -> !f64 {
    func.return %1
  }
  module_end
}

// CHECK: func.func @f_i32(
// CHECK: func.func @f_f64(
