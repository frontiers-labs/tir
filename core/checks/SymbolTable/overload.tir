// RUN: tir opt --verify %s | filecheck %s

// Two functions may share a name as long as their argument types differ; each
// call resolves to the overload matching its operand types.

module {
  %fn_i = func.func @f(%0: !i32) -> !i32 {
    func.return %0
  }
  %fn_d = func.func @f(%1: !f64) -> !f64 {
    func.return %1
  }
  %fn_caller = func.func @caller(%2: !i32, %3: !f64) -> !f64 {
    %4 = func.call %fn_i(%2 : !i32) -> !i32
    %5 = func.call %fn_d(%3 : !f64) -> !f64
    func.return %5
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @f(%{{[0-9]+}}: !i32) -> !i32 {
// CHECK: %{{[0-9]+}} = func.func @f(%{{[0-9]+}}: !f64) -> !f64 {
