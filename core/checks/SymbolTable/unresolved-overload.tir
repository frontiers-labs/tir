// RUN: not tir opt --pass=check-unique-symbols %s

// Backends emit one object symbol per name, so every overload must have been
// mangled away before lowering.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    func.return %0
  }
  %fn_f = func.func @f(%1: !f64) -> !f64 {
    func.return %1
  }
  module_end
}
