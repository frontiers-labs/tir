// RUN: tir opt --pass func.func(restructure-nodes),inline<1000,0>,func.func(instcombine-nodes) --verify %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) --verify %s | filecheck %s --check-prefix=CALL

// The seam a call leaves behind. A call may touch every object the outside can
// reach, so it takes the merge of the chains it may alias and its result is
// split back into them; the load of @h after it observes what the split hands
// back. Inlining splices the callee's body between that merge and that split,
// so the callee's accesses of @g are on a chain of the callee's own rather than
// on the caller's chain for @g: the state they name is the merge, and nothing
// relates it back to the caller's own chain for one object. So the two stores
// stand and the reads are not answered — the seam is where the per-object
// chains stop being per-object, and closing it is inlining's job, not the
// simplifier's.

module {
  %g = global @g align 4 bytes [0, 0, 0, 0]
  %h = global @h align 4 bytes [0, 0, 0, 0]
  %fn_bump = func.func private @bump(%a: !i32) -> !i32 {
    %v = ptr.load %g : !i32
    %s = addi %v, %a : !i32
    ptr.store %s, %g
    func.return %s
  }
  %fn_main = func.func @main(%x: !i32) -> !i32 {
    ptr.store %x, %g
    ptr.store %x, %h
    %r = func.call %fn_bump(%x : !i32) -> !i32
    %w = ptr.load %h : !i32
    %t = addi %r, %w : !i32
    func.return %t
  }
  module_end
}

// The call is gone and the callee's body runs in the caller, on the chains the
// merge before it and the split after it hand round.
// CHECK-LABEL: func.func @main(%[[X:[0-9]+]]: !i32)
// CHECK-NOT: func.call
// CHECK: state(%[[SG:[0-9]+]]) = ptr.store %[[X]], %[[G:[0-9]+]] state(%{{[0-9]+}})
// CHECK: state(%[[SH:[0-9]+]]) = ptr.store %[[X]], %{{[0-9]+}} state(%{{[0-9]+}})
// CHECK: %[[V:[0-9]+]], state(%[[RG:[0-9]+]]) = ptr.load %[[G]] state(%{{[0-9]+}}) : !i32
// CHECK: %[[S:[0-9]+]] = addi %[[V]], %[[X]] : !i32
// CHECK: state(%[[BUMP:[0-9]+]]) = ptr.store %[[S]], %[[G]] state(%[[RG]])
// CHECK: %[[W:[0-9]+]], state(%{{[0-9]+}}) = ptr.load %{{[0-9]+}} state(%{{[0-9]+}}) : !i32
// CHECK: %[[T:[0-9]+]] = addi %[[S]], %[[W]] : !i32
// CHECK: -> %[[T]], state(%{{[0-9]+}})

// With the call standing, the load of @h observes the state the call's split
// hands its chain back on.
// CALL-LABEL: func.func @main
// CALL: %{{[0-9]+}}, state(%[[C:[0-9]+]]) = func.call
// CALL-NEXT: state(%{{[0-9]+}}, %{{[0-9]+}}, %[[HC:[0-9]+]]) = state.split state(%[[C]])
// CALL-NEXT: ptr.load %{{[0-9]+}} state(%[[HC]])
