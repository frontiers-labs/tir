// RUN: tir opt --pass func.func(restructure-nodes),inline<1000,0>,func.func(instcombine-nodes) --verify %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) --verify %s | filecheck %s --check-prefix=CALL

// The call is a wall for the memory chain: a call touches every object the
// outside can reach, so the load of @h after it observes the call's state.
// Inlining splices the body into the caller and the round's simplifier reads
// the flattened body, where both loads are ordinary reads on the chain that
// the stores above them answer. The CALL prefix is the same fixture with the
// call left standing, for the contrast.

module {
  %g = global @g align 4 bytes [0, 0, 0, 0]
  %h = global @h align 4 bytes [0, 0, 0, 0]
  %fn_bump = func.func private @bump(%a: !i32) -> !i32 {
    %v = ptr.load %g : !i32
    %s = addi %v, %a : !i32
    ptr.store %s, %g
    func.return %s
  }
  %fn_main = func.func @main(%x: !i32) -> !i32 {
    ptr.store %x, %g
    ptr.store %x, %h
    %r = func.call %fn_bump(%x : !i32) -> !i32
    %w = ptr.load %h : !i32
    %t = addi %r, %w : !i32
    func.return %t
  }
  module_end
}

// No call and no seam: the callee's accesses sit on the caller's chain, both
// loads are answered by the stores above them, and the first store to @g is
// overwritten before anything reads it.
// CHECK-LABEL: func.func @main(%[[X:[0-9]+]]: !i32)
// CHECK-NOT: func.call
// CHECK-NOT: ptr.load
// CHECK: | %[[SH:[0-9]+]] = ptr.store %[[X]], %{{[0-9]+}} | %{{[0-9]+}}
// CHECK: %[[S:[0-9]+]] = addi %[[X]], %[[X]] : !i32
// CHECK: %[[T:[0-9]+]] = addi %[[S]], %[[X]] : !i32
// CHECK: | %[[SG:[0-9]+]] = ptr.store %[[S]], %{{[0-9]+}} | %[[SH]]
// CHECK-NOT: ptr.
// CHECK: -> %[[T]] | %[[SG]]

// With the call standing, the load of @h observes the state the call left.
// CALL-LABEL: func.func @main
// CALL: %{{[0-9]+}} | %[[C:[0-9]+]] = func.call
// CALL-NEXT: ptr.load %{{[0-9]+}} | %[[C]]
