// RUN: tir opt --pass func.func(restructure-nodes),inline<1000,0> --verify %s | filecheck %s

// C gives a callee's locals function lifetime and `promote-nodes` takes only a
// slot of the function's own body, so the callee's allocations land in the
// caller's body however deep in it the call stood.

module {
  %fn_box = func.func @box(%a: !i32) -> !i32 {
    %slot = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %a, %slot
    %v = ptr.load %slot : !i32
    func.return %v
  }
  %fn_main = func.func @main(%x: !i32) -> !i32 {
    %c = constant {value = 7} : !i32
    %d = addi %x, %c : !i32
    %r = func.call %fn_box(%d : !i32) -> !i32
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @main(%[[X:[0-9]+]]: !i32)
// CHECK: %[[D:[0-9]+]] = addi %[[X]], %{{[0-9]+}} : !i32
// CHECK-NEXT: | %[[S:[0-9]+]] = state.entry_state
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: | %[[ST:[0-9]+]] = ptr.store %[[D]], %[[SLOT]] | %[[S]]
// CHECK-NEXT: %[[V:[0-9]+]] | %[[LD:[0-9]+]] = ptr.load %[[SLOT]] | %[[ST]] : !i32
// CHECK-NEXT: -> %[[V]] | %[[LD]]
