// RUN: tir prove --width 1 %s | filecheck %s
// RUN: tir prove --width 64 %s | filecheck %s
rule add-constants:
  #add(a: const<W>, b: const<W>) : int<W> => #add(a, b);
rule sub-constants:
  #sub(a: const<W>, b: const<W>) : int<W> => #sub(a, b);
rule mul-constants:
  #mul(a: const<W>, b: const<W>) : int<W> => #mul(a, b);
rule add-zero: #add(x: int<W>, 0) : int<W> => x;
rule sub-zero: #sub(x: int<W>, 0) : int<W> => x;
rule mul-one: #mul(x: int<W>, 1) : int<W> => x;
rule mul-zero: #mul(x: int<W>, 0) : int<W> => const<W>(0);
rule add-const-reassociate:
  #add(#add(x: int<W>, a: const<W>), b: const<W>) : int<W>
  => #add(x, #add(a, b));
rule sub-const-reassociate:
  #sub(#sub(x: int<W>, a: const<W>), b: const<W>) : int<W>
  => #sub(x, #add(a, b));
rule add-sub-const-reassociate:
  #add(#sub(x: int<W>, a: const<W>), b: const<W>) : int<W>
  => #add(x, #sub(b, a));
rule sub-add-const-reassociate:
  #sub(#add(x: int<W>, a: const<W>), b: const<W>) : int<W>
  => #add(x, #sub(a, b));

// CHECK: add-constants: proven
// CHECK-NEXT: sub-constants: proven
// CHECK-NEXT: mul-constants: proven
// CHECK-NEXT: add-zero: proven
// CHECK-NEXT: sub-zero: proven
// CHECK-NEXT: mul-one: proven
// CHECK-NEXT: mul-zero: proven
// CHECK-NEXT: add-const-reassociate: proven
// CHECK-NEXT: sub-const-reassociate: proven
// CHECK-NEXT: add-sub-const-reassociate: proven
// CHECK-NEXT: sub-add-const-reassociate: proven
