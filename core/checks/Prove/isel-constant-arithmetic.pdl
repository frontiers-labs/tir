// RUN: tir prove --width 1 %s | filecheck %s
// RUN: tir prove --width 64 %s | filecheck %s
rule mul-constants:
  #mul(a: const<W>, b: const<W>) : int<W> => #mul(a, b);
rule mul-one: #mul(x: int<W>, 1) : int<W> => x;
rule mul-zero: #mul(x: int<W>, 0) : int<W> => const<W>(0);

// CHECK: mul-constants: proven
// CHECK-NEXT: mul-one: proven
// CHECK-NEXT: mul-zero: proven
