// RUN: not tir prove --width 8 %s | filecheck %s

rule identity: #add(x: int<W>, const<W>(0)) : int<W> => x proof smt;
rule modeled-elsewhere: #add(x: int<W>, const<W>(0)) : int<W> => x proof definitional;

// CHECK: identity: proven
// CHECK-NEXT: modeled-elsewhere: unsupported: definitional rules have no solver model
