// RUN: not tir prove %s | filecheck %s
// RUN: tir prove --allow-admitted %s | filecheck %s

refinement contract-mul-add:
  fp.add(fp.mul(a: float<64>, b: float<64>), c: float<64>)
  ~> fp.fma(a, b, c)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof contract;

refinement contract-add-mul-commuted:
  fp.add(c: float<64>, fp.mul(a: float<64>, b: float<64>))
  ~> fp.fma(a, b, c)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof contract;

refinement contract-mul-sub:
  fp.sub(fp.mul(a: float<64>, b: float<64>), c: float<64>)
  ~> fp.fma(a, b, fp.neg(c))
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof contract;

refinement contract-stateful-mul-add:
  fp.add(fp.mul(a: float<64>, b: float<64> | env: state<fp.env>), c: float<64> | env)
  ~> fp.fma(a, b, c | env)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof contract;

// CHECK: contract-mul-add: admitted
// CHECK-NEXT: contract-add-mul-commuted: admitted
// CHECK-NEXT: contract-mul-sub: admitted
// CHECK-NEXT: contract-stateful-mul-add: admitted
