// RUN: tir prove %s | filecheck %s

refinement contract-mul-add:
  fp.add(fp.mul(a: float<64>, b: float<64>), c: float<64>)
  ~> fp.fma(a, b, c)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof smt;

refinement contract-add-mul-commuted:
  fp.add(c: float<64>, fp.mul(a: float<64>, b: float<64>))
  ~> fp.fma(a, b, c)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof smt;

refinement contract-shaped-mul-add:
  fp.add(fp.mul(a: shaped_float<64, 4>, b: shaped_float<64, 4>), c: shaped_float<64, 4>)
  ~> fp.fma(a, b, c)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof smt;

refinement contract-stateful-mul-add:
  fp.add(fp.mul(a: float<64>, b: float<64> | env: state<fp.env>), c: float<64> | env)
  ~> fp.fma(a, b, c | env)
  requires same_round_region,
    permits(contract_mul_add),
    compatible_formats_and_rounding,
    permitted_effect_change,
    satisfies_domain_and_effect_contract
  proof smt;

// CHECK: contract-mul-add: proven
// CHECK-NEXT: contract-add-mul-commuted: proven
// CHECK-NEXT: contract-shaped-mul-add: proven
// CHECK-NEXT: contract-stateful-mul-add: proven
