// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir prove --width 8 %s | filecheck %s
// RUN: tir prove --width 32 %s | filecheck %s
// RUN: tir prove --width 64 %s | filecheck %s

rule constant-mask-blend:
  #or(#and(t: const<W>, m: int<W>),
      #and(f: const<W>, #xor(m, ones(W)))) : int<W>
  => #xor(#and(m, #xor(t, f)), f);
rule sext-bool-low-bit:
  #and(#sext(c: int<1>, W), 1) : int<W>
  => #zext(#extract(c, 0, 0), W)
  where 1 < W;

// CHECK: constant-mask-blend: proven
// CHECK-NEXT: sext-bool-low-bit: proven
