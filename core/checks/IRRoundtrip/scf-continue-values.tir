// RUN: tir opt %s | filecheck %s

// `scf.continue` starts the next iteration carrying one value per carried port:
// the latch values that iteration observes.

module {
  %fn_loop = func.func @loop(%0: !i1, %1: !i32, %2: !i64) -> !i32 {
    %3, %4 = scf.while iter_args(%5 = %1, %6 = %2) -> !i32, !i64 {
      scf.condition %0, %5, %6
    } do scope(%7)(%8, %9) {
      scf.if %0 {
        scf.continue %7, %8, %9
      } else {
        scf.yield
      }
      scf.yield %8, %9
    }
    func.return %3
  }
  module_end
}

// CHECK: do scope(%[[SCOPE:[0-9]+]])(%[[A:[0-9]+]], %[[B:[0-9]+]])
// CHECK: scf.continue %[[SCOPE]], %[[A]], %[[B]]
