// RUN: tir opt --verify %s | filecheck %s
// RUN: tir interp %s --args=1,6 | filecheck --check-prefix=EVAL %s

// What an operation's nested regions read is what the operation reads: the
// conditional depends on the product its arm yields, so it prints and runs
// after it.

module {
  %fn_main = func.func @main(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.if %0 -> !i32 {
      scf.yield %3
    } else {
      scf.yield %1
    }
    %3 = muli %1, %1 : !i32
    -> %2
  }
  module_end
}

// CHECK: %[[P:[0-9]+]] = muli
// CHECK: %{{[0-9]+}} = scf.if
// EVAL: i32 36
