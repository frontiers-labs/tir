// RUN: tir opt %s | filecheck %s

module {
  %fn_add = func.func @add(%0: !i32, %1: !i32) -> !i32 {
    func.return %0
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: %{{[0-9]+}} = func.func @add(%{{[0-9]+}}: !i32, %{{[0-9]+}}: !i32) -> !i32 {
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: module_end
// CHECK-NEXT: }
