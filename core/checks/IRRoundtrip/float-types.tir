// RUN: tir opt --verify %s | filecheck %s

// Storage types remain distinct. The arithmetic cases use binary32 and binary64.

module {
  %fn_f8e4m3 = func.func @f8e4m3(%0: !f8e4m3) -> !f8e4m3 {
    func.return %0
  }
  %fn_f8e5m2 = func.func @f8e5m2(%0: !f8e5m2) -> !f8e5m2 {
    func.return %0
  }
  %fn_f16 = func.func @f16(%0: !f16) -> !f16 {
    func.return %0
  }
  %fn_bf16 = func.func @bf16(%0: !bf16) -> !bf16 {
    func.return %0
  }
  %fn_f32 = func.func @f32() -> !f32 {
    %bits = constant {value = 1069547520} : !i32
    %literal = bitcast %bits : !f32
    %x = fp.capture %literal : !fp.computation<!f32, nearest_even, separate>
    %sum = fp.add %x, %x : !fp.computation<!f32, nearest_even, separate>
    %result = fp.materialize %sum : !f32
    func.return %result
  }
  %fn_f64 = func.func @f64() -> !f64 {
    %bits = constant {value = 4609434218613702656} : !i64
    %literal = bitcast %bits : !f64
    %x = fp.capture %literal : !fp.computation<!f64, nearest_even, separate>
    %sum = fp.add %x, %x : !fp.computation<!f64, nearest_even, separate>
    %result = fp.materialize %sum : !f64
    func.return %result
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f8e4m3(%{{[0-9]+}}: !f8e4m3) -> !f8e4m3
// CHECK-LABEL: %{{[0-9]+}} = func.func @f8e5m2(%{{[0-9]+}}: !f8e5m2) -> !f8e5m2
// CHECK-LABEL: %{{[0-9]+}} = func.func @f16(%{{[0-9]+}}: !f16) -> !f16
// CHECK-LABEL: %{{[0-9]+}} = func.func @bf16(%{{[0-9]+}}: !bf16) -> !bf16
// CHECK-LABEL: %{{[0-9]+}} = func.func @f32() -> !f32
// CHECK: %[[X32:[0-9]+]] = fp.capture %{{[0-9]+}} : !fp.computation<!f32, nearest_even, separate>
// CHECK-NEXT: %[[S32:[0-9]+]] = fp.add %[[X32]], %[[X32]] : !fp.computation<!f32, nearest_even, separate>
// CHECK-NEXT: %[[R32:[0-9]+]] = fp.materialize %[[S32]] : !f32
// CHECK-NEXT: func.return %[[R32]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @f64() -> !f64
// CHECK: %[[X64:[0-9]+]] = fp.capture %{{[0-9]+}} : !fp.computation<!f64, nearest_even, separate>
// CHECK-NEXT: %[[S64:[0-9]+]] = fp.add %[[X64]], %[[X64]] : !fp.computation<!f64, nearest_even, separate>
// CHECK-NEXT: %[[R64:[0-9]+]] = fp.materialize %[[S64]] : !f64
// CHECK-NEXT: func.return %[[R64]]
