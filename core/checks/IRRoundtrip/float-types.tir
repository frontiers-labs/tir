// RUN: tir opt --verify %s | filecheck %s

// Every float type spells distinctly and addf verifies at each of them.

module {
  %fn_f8e4m3 = func.func @f8e4m3() -> !f8e4m3 {
    %0 = constantf {value = 1.5} : !f8e4m3
    %1 = addf %0, %0 : !f8e4m3
    func.return %1
  }
  %fn_f8e5m2 = func.func @f8e5m2() -> !f8e5m2 {
    %0 = constantf {value = 1.5} : !f8e5m2
    %1 = addf %0, %0 : !f8e5m2
    func.return %1
  }
  %fn_f16 = func.func @f16() -> !f16 {
    %0 = constantf {value = 1.5} : !f16
    %1 = addf %0, %0 : !f16
    func.return %1
  }
  %fn_bf16 = func.func @bf16() -> !bf16 {
    %0 = constantf {value = 1.5} : !bf16
    %1 = addf %0, %0 : !bf16
    func.return %1
  }
  %fn_f32 = func.func @f32() -> !f32 {
    %0 = constantf {value = 1.5} : !f32
    %1 = addf %0, %0 : !f32
    func.return %1
  }
  %fn_f64 = func.func @f64() -> !f64 {
    %0 = constantf {value = 1.5} : !f64
    %1 = addf %0, %0 : !f64
    func.return %1
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f8e4m3() -> !f8e4m3
// CHECK: %{{[0-9]+}} = constantf {value = 1.5} : !f8e4m3
// CHECK: %{{[0-9]+}} = addf %{{[0-9]+}}, %{{[0-9]+}} : !f8e4m3
// CHECK-LABEL: %{{[0-9]+}} = func.func @f8e5m2() -> !f8e5m2
// CHECK: %{{[0-9]+}} = addf %{{[0-9]+}}, %{{[0-9]+}} : !f8e5m2
// CHECK-LABEL: %{{[0-9]+}} = func.func @f16() -> !f16
// CHECK: %{{[0-9]+}} = addf %{{[0-9]+}}, %{{[0-9]+}} : !f16
// CHECK-LABEL: %{{[0-9]+}} = func.func @bf16() -> !bf16
// CHECK: %{{[0-9]+}} = addf %{{[0-9]+}}, %{{[0-9]+}} : !bf16
// CHECK-LABEL: %{{[0-9]+}} = func.func @f32() -> !f32
// CHECK: %{{[0-9]+}} = addf %{{[0-9]+}}, %{{[0-9]+}} : !f32
// CHECK-LABEL: %{{[0-9]+}} = func.func @f64() -> !f64
// CHECK: %{{[0-9]+}} = addf %{{[0-9]+}}, %{{[0-9]+}} : !f64
