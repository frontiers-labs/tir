// RUN: tir opt %s | filecheck %s

module {
  func.func @loop(%0: !i1) -> !i32 {
    %1 = constant {value = 0} : !i32
    %2 = constant {value = 1} : !i64
    %3, %4 = scf.while iter_args(%5 = %1, %6 = %2) -> !i32, !i64 {
      scf.condition %0, %5, %6
    } do(%7, %8) {
      %9 = addi %7, %1 : !i32
      %10 = addi %8, %2 : !i64
      scf.yield %9, %10
    }
    func.return %3
  }
  module_end
}

// CHECK: %{{[0-9]+}}, %{{[0-9]+}} = scf.while iter_args(%{{[0-9]+}} = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}}) -> !i32, !i64 {
// CHECK-NEXT: scf.condition %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: do(%{{[0-9]+}}, %{{[0-9]+}}) {
// CHECK: scf.yield %{{[0-9]+}}, %{{[0-9]+}}
