// RUN: tir opt %s | filecheck %s

module {
  func.func @caller(%0: !ptr.p, %1: !i32) -> !i32 {
    %2 = func.call @foo(%1 : !i32) -> !i32
    func.call @log()
    %3 = func.indirect_call %0(%2 : !i32) -> !i32
    %4 = func.indirect_call %0(%0, %2 : !ptr.p, !i32) -> !i32 result_address argument_alignments [1, 2]
    func.return %3
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: func.func @caller(%{{[0-9]+}}: !ptr.p, %{{[0-9]+}}: !i32) -> !i32 {
// CHECK-NEXT: %{{[0-9]+}} = func.call @foo(%{{[0-9]+}} : !i32) -> !i32
// CHECK-NEXT: func.call @log()
// CHECK-NEXT: %{{[0-9]+}} = func.indirect_call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32
// CHECK-NEXT: %{{[0-9]+}} = func.indirect_call %{{[0-9]+}}(%{{[0-9]+}}, %{{[0-9]+}} : !ptr.p, !i32) -> !i32 result_address argument_alignments [1, 2]
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: module_end
// CHECK-NEXT: }
