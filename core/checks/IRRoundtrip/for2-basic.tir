// RUN: tir opt --verify %s | filecheck %s

// A counted loop is a theta whose counter is port 0: the text spells the
// bounds and the carried ports, and its parser puts back the comparison, the
// increment and the exit values the shape pins, which --verify then checks.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32, %2: !i32) -> !i32 {
    %3 = constant {value = 0} : !i32
    %4, %5 = scf.for %6 = %0 to %1 step %2 (%7 = %3) {
      %8 = constant {value = 1} : !i32
      %9 = addi %7, %8 : !i32
      -> %9
    }
    func.return %5
  }
  module_end
}

// CHECK: %[[I:[0-9]+]], %[[R:[0-9]+]] = scf.for %[[C:[0-9]+]] = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%[[A:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: %[[ONE:[0-9]+]] = constant {value = 1} : !i32
// CHECK-NEXT: %[[N:[0-9]+]] = addi %[[A]], %[[ONE]] : !i32
// CHECK-NEXT: -> %[[N]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[R]]
