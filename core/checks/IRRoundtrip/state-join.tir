// RUN: tir opt --verify %s | filecheck %s

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1, state(%2) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%3, %4) = state.split state(%2)
    state(%5) = ptr.store %0, %1 state(%3)
    %6, state(%7) = ptr.load %1 state(%5) : !i32
    %8, state(%9) = ptr.load %1 state(%5) : !i32
    state(%10) = state.join state(%4, %7, %9)
    %11 = addi %6, %8 : !i32
    state(%12) = ptr.store %11, %1 state(%10)
    func.return %11
  }
  module_end
}

// CHECK: state(%[[A:[0-9]+]], %[[B:[0-9]+]]) = state.split state(%{{[0-9]+}})
// CHECK: state(%{{[0-9]+}}) = ptr.store %0, %{{[0-9]+}} state(%[[A]])
// CHECK: state(%[[J:[0-9]+]]) = state.join state(%[[B]], %{{[0-9]+}}, %{{[0-9]+}})
// CHECK: state(%{{[0-9]+}}) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[J]])
