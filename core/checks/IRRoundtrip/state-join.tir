// RUN: tir opt --verify %s | filecheck %s

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 | %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %3, %4 = state.split | %2
    | %5 = ptr.store %0, %1 | %3
    %6 | %7 = ptr.load %1 | %5 : !i32
    %8 | %9 = ptr.load %1 | %5 : !i32
    | %10 = state.join | %4, %7, %9
    %11 = addi %6, %8 : !i32
    | %12 = ptr.store %11, %1 | %10
    func.return %11
  }
  module_end
}

// CHECK: | %[[A:[0-9]+]], %[[B:[0-9]+]] = state.split | %{{[0-9]+}}
// CHECK: | %{{[0-9]+}} = ptr.store %0, %{{[0-9]+}} | %[[A]]
// CHECK: | %[[J:[0-9]+]] = state.join | %[[B]], %{{[0-9]+}}, %{{[0-9]+}}
// CHECK: | %{{[0-9]+}} = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[J]]
