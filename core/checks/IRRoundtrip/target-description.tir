// RUN: tir opt %s | filecheck %s
// Printing hoists the specs back into aliases, so re-parsing our own output
// yields the same file.
// RUN: tir opt %s | tir opt | filecheck %s

#dl = #layout.spec<endianness = "little", stack_align = 128, !i32 = {size = 32, abi = 32}, !ptr.p = {size = 64, abi = 64}>
#env = {arch = "riscv64", cpu = "generic", features = ["m", "c"]}

module {layout.spec = #dl, target_env = #env} {
  %fn_f = func.func @f() -> !i32 {
    %0 = constant {value = 1} : !i32
    func.return %0
  }
  module_end
}

// The target the environment names fills in what the declared layout leaves out.
// CHECK: #layout_spec = #layout.spec<endianness = "little", stack_align = 128, cache_line = 64, !i1 = {size = 8, abi = 8}, !i8 = {size = 8, abi = 8}, !i16 = {size = 16, abi = 16}, !i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !f32 = {size = 32, abi = 32}, !f64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>
// CHECK: #target_env = {arch = "riscv64", cpu = "generic", features = ["m", "c"]}
// CHECK: module {layout.spec = #layout_spec, target_env = #target_env} {
// CHECK-NEXT: %{{[0-9]+}} = func.func @f() -> !i32 {
