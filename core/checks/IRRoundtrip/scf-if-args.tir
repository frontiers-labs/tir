// RUN: tir opt %s | filecheck %s

// A γ forwards its inputs to every arm as entry arguments: input j is argument j
// of each arm, so an arm reads what enters the gate under a name of its own.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.if %0 args(%1) -> !i32 (%3) {
      scf.yield %3
    } else (%4) {
      scf.yield %4
    }
    func.return %2
  }
  module_end
}

// CHECK: %{{[0-9]+}} = scf.if %0 args(%1) -> !i32 (%[[A:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[A]]
// CHECK-NEXT: }
// CHECK-NEXT: else (%[[B:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[B]]
