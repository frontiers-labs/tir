// RUN: tir opt %s | filecheck %s

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !ptr.p, %2: !i8, %3: !i64) {
    | %4 = state.entry_state
    | %5 = ptr.memset %0, %2, %3 | %4
    | %6 = ptr.memcpy %1, %0, %3 | %5
    func.return
  }
  module_end
}

// CHECK: | %[[S0:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[S1:[0-9]+]] = ptr.memset %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} | %[[S0]]
// CHECK-NEXT: | %{{[0-9]+}} = ptr.memcpy %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} | %[[S1]]
