// RUN: tir opt %s | filecheck %s

module {
  func.func @dispatch(%0: !i32) {
    scf.switch %0 case 1 {
      scf.yield
    }
    case 2 {
      scf.yield
    }
    default {
      scf.yield
    }
    func.return
  }
  module_end
}

// CHECK: scf.switch %{{[0-9]+}} case 1 {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: case 2 {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: default {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: func.return
