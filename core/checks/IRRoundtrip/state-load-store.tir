// RUN: tir opt %s | filecheck %s

module {
  %fn_id = func.func @id(%0: !i32) -> !i32 {
    %1 | %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %3 = ptr.store %0, %1 | %2
    %4 = ptr.load %1 | %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK: %{{[0-9]+}} | %[[S0:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: | %[[S1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[S0]]
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[S1]] : !i32
// CHECK-NEXT: func.return
