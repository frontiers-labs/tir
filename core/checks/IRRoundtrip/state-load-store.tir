// RUN: tir opt %s | filecheck %s

module {
  func.func @id(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %2)
    ptr.store %0, %1 state(%2 -> %3)
    %4 = ptr.load %1 : !i32 state(%3)
    func.return %4
  }
  module_end
}

// CHECK: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %[[S0:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[S0]] -> %[[S1:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[S1]])
// CHECK-NEXT: func.return
