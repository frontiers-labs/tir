// RUN: tir opt %s | filecheck %s

module {
  %fn_foo = func.declare @foo(!i32) -> !i32
  %fn_log = func.declare @log() -> !unit
  %fn_caller = func.func @caller(%0: !ptr.p, %1: !i32) -> !i32 {
    | %2 = state.entry_state
    %3 | %4 = func.call %fn_foo(%1 : !i32) -> !i32 | %2
    | %5 = func.call %fn_log() | %4
    %8 = ptr_to_fn %0 : !fn<(!i32) -> !i32>
    %6 | %7 = func.call %8(%3 : !i32) -> !i32 | %5
    func.return %6 | %7
  }
  module_end
}

// CHECK: | %[[S0:[0-9]+]] = state.entry_state
// CHECK-NEXT: %{{[0-9]+}} | %[[S1:[0-9]+]] = func.call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32 | %[[S0]]
// CHECK-NEXT: | %[[S2:[0-9]+]] = func.call %{{[0-9]+}}() | %[[S1]]
// CHECK-NEXT: %{{[0-9]+}} = ptr_to_fn %{{[0-9]+}} : !fn<(!i32) -> !i32>
// CHECK-NEXT: %{{[0-9]+}} | %[[S3:[0-9]+]] = func.call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32 | %[[S2]]
// CHECK-NEXT: func.return %{{[0-9]+}} | %[[S3]]
