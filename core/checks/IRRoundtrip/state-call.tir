// RUN: tir opt %s | filecheck %s

module {
  %fn_foo = func.declare @foo(!i32) -> !i32
  %fn_log = func.declare @log() -> !unit
  %fn_caller = func.func @caller(%0: !ptr.p, %1: !i32) -> !i32 {
    state(%2) = state.entry_state
    %3, state(%4) = func.call %fn_foo(%1 : !i32) -> !i32 state(%2)
    state(%5) = func.call %fn_log() state(%4)
    %8 = ptr_to_fn %0 : !fn<(!i32) -> !i32>
    %6, state(%7) = func.call %8(%3 : !i32) -> !i32 state(%5)
    func.return %6 state(%7)
  }
  module_end
}

// CHECK: state(%[[S0:[0-9]+]]) = state.entry_state
// CHECK-NEXT: %{{[0-9]+}}, state(%[[S1:[0-9]+]]) = func.call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32 state(%[[S0]])
// CHECK-NEXT: state(%[[S2:[0-9]+]]) = func.call %{{[0-9]+}}() state(%[[S1]])
// CHECK-NEXT: %{{[0-9]+}} = ptr_to_fn %{{[0-9]+}} : !fn<(!i32) -> !i32>
// CHECK-NEXT: %{{[0-9]+}}, state(%[[S3:[0-9]+]]) = func.call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32 state(%[[S2]])
// CHECK-NEXT: func.return %{{[0-9]+}} state(%[[S3]])
