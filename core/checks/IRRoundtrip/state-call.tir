// RUN: tir opt %s | filecheck %s

module {
  func @caller(%0: !ptr.p, %1: !i32) -> !i32 {
    %2 = state.entry_state : !state
    %3 = call @foo(%1 : !i32) -> !i32 state(%2 -> %4)
    call @log() state(%4 -> %5)
    %6 = indirect_call %0(%3 : !i32) -> !i32 state(%5 -> %7)
    return %6 state(%7)
  }
  module_end
}

// CHECK: %[[S0:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %{{[0-9]+}} = call @foo(%{{[0-9]+}} : !i32) -> !i32 state(%[[S0]] -> %[[S1:[0-9]+]])
// CHECK-NEXT: call @log() state(%[[S1]] -> %[[S2:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = indirect_call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32 state(%[[S2]] -> %[[S3:[0-9]+]])
// CHECK-NEXT: return %{{[0-9]+}} state(%[[S3]])
