// RUN: tir opt %s | filecheck %s

module {
  func.func @caller(%0: !ptr.p, %1: !i32) -> !i32 {
    %2 = state.entry_state : !state
    %3 = func.call @foo(%1 : !i32) -> !i32 state(%2 -> %4)
    func.call @log() state(%4 -> %5)
    %6 = func.indirect_call %0(%3 : !i32) -> !i32 state(%5 -> %7)
    func.return %6 state(%7)
  }
  module_end
}

// CHECK: %[[S0:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %{{[0-9]+}} = func.call @foo(%{{[0-9]+}} : !i32) -> !i32 state(%[[S0]] -> %[[S1:[0-9]+]])
// CHECK-NEXT: func.call @log() state(%[[S1]] -> %[[S2:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = func.indirect_call %{{[0-9]+}}(%{{[0-9]+}} : !i32) -> !i32 state(%[[S2]] -> %[[S3:[0-9]+]])
// CHECK-NEXT: func.return %{{[0-9]+}} state(%[[S3]])
