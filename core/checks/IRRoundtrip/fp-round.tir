// RUN: tir opt --verify %s | tir opt --verify - | filecheck %s

module {
  %f = func.func @two_results(%a: !f64, %b: !f64) -> !f64 {
    %x = fp.capture %a : !fp.computation<!f64, nearest_even, permitted>
    %y = fp.capture %b : !fp.computation<!f64, nearest_even, permitted>
    %sum_expr = fp.add %x, %y : !fp.computation<!f64, nearest_even, permitted>
    %product_expr = fp.mul %x, %y : !fp.computation<!f64, nearest_even, permitted>
    %sum = fp.materialize %sum_expr : !f64
    %product = fp.materialize %product_expr : !f64
    -> %product
  }
  module_end
}

// CHECK-LABEL: func.func @two_results(%[[A:[0-9]+]]: !f64, %[[B:[0-9]+]]: !f64) -> !f64 {
// CHECK-NEXT: %[[X:[0-9]+]] = fp.capture %[[A]] : !fp.computation<!f64, nearest_even, permitted>
// CHECK-NEXT: %[[Y:[0-9]+]] = fp.capture %[[B]] : !fp.computation<!f64, nearest_even, permitted>
// CHECK-NEXT: %[[S:[0-9]+]] = fp.add %[[X]], %[[Y]] : !fp.computation<!f64, nearest_even, permitted>
// CHECK-NEXT: %[[P:[0-9]+]] = fp.mul %[[X]], %[[Y]] : !fp.computation<!f64, nearest_even, permitted>
// CHECK-NEXT: %{{[0-9]+}} = fp.materialize %[[S]] : !f64
// CHECK-NEXT: %[[PRODUCT:[0-9]+]] = fp.materialize %[[P]] : !f64
// CHECK-NEXT: -> %[[PRODUCT]]
