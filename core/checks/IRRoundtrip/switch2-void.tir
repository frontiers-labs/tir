// RUN: tir opt --verify %s | filecheck %s

// A gamma forwarding nothing and producing nothing still selects an arm.

module {
  %fn_main = func.func @main(%0: !i32) {
    scf.switch %0 {
      ->
    }
    {
      ->
    }
    func.return
  }
  module_end
}

// CHECK: scf.switch %{{[0-9]+}} {
// CHECK-NEXT: ->
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: ->
// CHECK-NEXT: }
