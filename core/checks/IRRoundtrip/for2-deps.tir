// RUN: tir opt --verify %s | filecheck %s

// A counted loop carries a chain like any theta; the chain leaves the loop
// as it entered, since the exit cone runs nothing.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32, %2: !i32, %3: !i32) -> !i32 {
    %4, state(%5) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %6, state(%7) = scf.for %8 = %0 to %1 step %2 (state(%9 = %5)) {
      state(%10) = ptr.store %3, %4 state(%9)
      -> state(%10)
    }
    %11 = ptr.load %4 state(%7) : !i32
    func.return %11
  }
  module_end
}

// CHECK: %[[I:[0-9]+]], state(%[[D:[0-9]+]]) = scf.for %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (state(%[[P:[0-9]+]] = %{{[0-9]+}})) {
// CHECK-NEXT: state(%[[S:[0-9]+]]) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[P]])
// CHECK-NEXT: -> state(%[[S]])
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} state(%[[D]]) : !i32
