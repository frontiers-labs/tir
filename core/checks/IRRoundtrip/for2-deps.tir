// RUN: tir opt --verify %s | filecheck %s

// A counted loop carries a chain like any theta; the chain leaves the loop
// as it entered, since the exit cone runs nothing.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32, %2: !i32, %3: !i32) -> !i32 {
    %4 | %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %6 | %7 = scf.for %8 = %0 to %1 step %2 (| %9 = %5) {
      | %10 = ptr.store %3, %4 | %9
      -> | %10
    }
    %11 = ptr.load %4 | %7 : !i32
    func.return %11
  }
  module_end
}

// CHECK: %[[I:[0-9]+]] | %[[D:[0-9]+]] = scf.for %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (| %[[P:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: | %[[S:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[P]]
// CHECK-NEXT: -> | %[[S]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[D]] : !i32
