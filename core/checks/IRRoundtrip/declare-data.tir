// RUN: tir opt %s | filecheck %s

// An object another module defines carries no signature: the declaration
// names the symbol and nothing else.

module {
  func.declare @counter
  func.func @main() -> !ptr.p {
    %0 = func.addr_of {sym_name = "counter"} : !ptr.p
    func.return %0
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: func.declare @counter
// CHECK-NEXT: func.func @main() -> !ptr.p {
