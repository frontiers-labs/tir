// RUN: tir opt %s | filecheck %s

// The n-ary γ forwards its inputs to every arm, the default one included: each
// arm takes the same entry signature under names of its own.

module {
  func.func @select(%0: !i32, %1: !i32) -> !i32 {
    %2 = scf.switch %0 args(%1) -> !i32 case 1 (%3) {
      scf.yield %3
    }
    default (%4) {
      scf.yield %4
    }
    func.return %2
  }
  module_end
}

// CHECK: %{{[0-9]+}} = scf.switch %0 args(%1) -> !i32 case 1 (%[[A:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[A]]
// CHECK-NEXT: }
// CHECK-NEXT: default (%[[B:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[B]]
