// RUN: tir opt %s | filecheck %s

// A structured loop carries n values: n init operands, n body arguments, n
// yielded values and n results.

module {
  %fn_loop = func.func @loop(%0: !index, %1: !index, %2: !index) -> !i32 {
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 1} : !i64
    %5, %6 = scf.for_legacy %0, %1, %2 iter_args(%7 = %3, %8 = %4) -> !i32, !i64 {
      %9 = addi %7, %3 : !i32
      %10 = addi %8, %4 : !i64
      scf.yield %9, %10
    }
    func.return %5
  }
  module_end
}

// CHECK: %{{[0-9]+}}, %{{[0-9]+}} = scf.for_legacy %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} iter_args(%{{[0-9]+}} = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}}) -> !i32, !i64 {
// CHECK-NEXT: %{{[0-9]+}} = addi %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: %{{[0-9]+}} = addi %{{[0-9]+}}, %{{[0-9]+}} : !i64
// CHECK-NEXT: scf.yield %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: }
