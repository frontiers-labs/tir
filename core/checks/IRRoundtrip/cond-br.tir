// RUN: tir opt %s | filecheck %s

module {
  func.func @select(%0: !i1) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %1 = constant {value = 1} : !i32
    func.return %1
  ^bb2:
    %2 = constant {value = 0} : !i32
    func.return %2
  }
  func.func @asymmetric(%3: !i1, %4: !i32, %5: !i32, %6: !i32) -> !i32 {
    cfg.cond_br %3, ^bb1(%4, %5 : !i32, !i32), ^bb2(%6 : !i32)
  ^bb1(%7: !i32, %8: !i32):
    func.return %7
  ^bb2(%9: !i32):
    func.return %9
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: func.func @select(%{{[0-9]+}}: !i1) -> !i32 {
// CHECK-NEXT: cfg.cond_br %{{[0-9]+}}, ^bb1, ^bb2
// CHECK-NEXT: ^bb1:
// CHECK-NEXT: %{{[0-9]+}} = constant {value = 1} : !i32
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: ^bb2:
// CHECK-NEXT: %{{[0-9]+}} = constant {value = 0} : !i32
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: func.func @asymmetric(%{{[0-9]+}}: !i1, %{{[0-9]+}}: !i32, %{{[0-9]+}}: !i32, %{{[0-9]+}}: !i32) -> !i32 {
// CHECK-NEXT: cfg.cond_br %{{[0-9]+}}, ^bb1(%{{[0-9]+}}, %{{[0-9]+}} : !i32, !i32), ^bb2(%{{[0-9]+}} : !i32)
// CHECK-NEXT: ^bb1(%{{[0-9]+}}: !i32, %{{[0-9]+}}: !i32):
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: ^bb2(%{{[0-9]+}}: !i32):
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: module_end
// CHECK-NEXT: }
