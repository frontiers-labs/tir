// RUN: tir opt --verify %s | filecheck %s

// The module is one region: a λ or δ is usable before its definition appears,
// so a call needs no forward declaration of the function it names.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = ptr.load %counter : !i32
    %1 = func.call %fn_later(%0 : !i32) -> !i32
    func.return %1
  }
  %fn_later = func.func @later(%2: !i32) -> !i32 {
    func.return %2
  }
  %counter = global @counter align 4 bytes [0, 0, 0, 0]
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @main() -> !i32 {
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %[[COUNTER:[0-9]+]] : !i32
// CHECK-NEXT: %{{[0-9]+}} = func.call %[[LATER:[0-9]+]](%{{[0-9]+}} : !i32) -> !i32
// CHECK: %[[LATER]] = func.func @later(%{{[0-9]+}}: !i32) -> !i32 {
// CHECK: %[[COUNTER]] = global @counter align 4 bytes [0, 0, 0, 0]
