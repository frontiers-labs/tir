// RUN: tir opt %s | filecheck %s

module {
  func.func @select(%0: !i32) -> !i32 {
    %1 = scf.switch %0 -> !i32 case 1 {
      %2 = constant {value = 10} : !i32
      scf.yield %2
    }
    case 2 {
      %3 = constant {value = 20} : !i32
      scf.yield %3
    }
    default {
      %4 = constant {value = 30} : !i32
      scf.yield %4
    }
    func.return %1
  }
  module_end
}

// CHECK: %[[RESULT:[0-9]+]] = scf.switch %{{[0-9]+}} -> !i32 case 1 {
// CHECK-NEXT: %[[A:[0-9]+]] = constant {value = 10} : !i32
// CHECK-NEXT: scf.yield %[[A]]
// CHECK-NEXT: }
// CHECK-NEXT: case 2 {
// CHECK-NEXT: %[[B:[0-9]+]] = constant {value = 20} : !i32
// CHECK-NEXT: scf.yield %[[B]]
// CHECK-NEXT: }
// CHECK-NEXT: default {
// CHECK-NEXT: %[[C:[0-9]+]] = constant {value = 30} : !i32
// CHECK-NEXT: scf.yield %[[C]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
