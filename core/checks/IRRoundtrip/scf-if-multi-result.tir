// RUN: tir opt %s | filecheck %s

module {
  %fn_cond = func.func @cond(%0: !i1) -> !i32 {
    %1, %2 = scf.if %0 -> !i32, !i64 {
      %3 = constant {value = 7} : !i32
      %4 = constant {value = 8} : !i64
      scf.yield %3, %4
    } else {
      %5 = constant {value = 9} : !i32
      %6 = constant {value = 10} : !i64
      scf.yield %5, %6
    }
    func.return %1
  }
  module_end
}

// CHECK: %{{[0-9]+}}, %{{[0-9]+}} = scf.if %{{[0-9]+}} -> !i32, !i64 {
// CHECK: scf.yield %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK: scf.yield %{{[0-9]+}}, %{{[0-9]+}}
