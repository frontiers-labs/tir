// RUN: tir opt --verify %s | filecheck %s

module {
  func.func @make_large(%0: !ptr.p, %1: !i64) -> !ptr.p result_address {
    ptr.store %1, %0
    func.return %0
  }
  func.func @caller(%0: !ptr.p, %1: !i64) -> !ptr.p {
    %2 = func.call @make_large(%0, %1 : !ptr.p, !i64) -> !ptr.p result_address
    func.return %2
  }
  module_end
}

// CHECK: func.func @make_large(%[[DEST:[0-9]+]]: !ptr.p, %{{[0-9]+}}: !i64) -> !ptr.p result_address {
// CHECK: func.return %[[DEST]]
// CHECK: %[[RESULT:[0-9]+]] = func.call @make_large(%{{[0-9]+}}, %{{[0-9]+}} : !ptr.p, !i64) -> !ptr.p result_address
// CHECK: func.return %[[RESULT]]
