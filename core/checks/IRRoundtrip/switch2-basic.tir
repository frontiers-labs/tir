// RUN: tir opt --verify %s | filecheck %s

// A gamma over unordered arms: the predicate indexes the arms, each arm names
// its own ports for the forwarded inputs, and every arm produces the op's
// results.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32) -> !i32 {
    %2 = scf.switch %0 args(%1) (%3) {
      -> %3
    }
    (%4) {
      %5 = addi %4, %4 : !i32
      -> %5
    }
    func.return %2
  }
  module_end
}

// CHECK: %[[R:[0-9]+]] = scf.switch %{{[0-9]+}} args(%{{[0-9]+}}) (%[[A:[0-9]+]]) {
// CHECK-NEXT: -> %[[A]]
// CHECK-NEXT: }
// CHECK-NEXT: (%[[B:[0-9]+]]) {
// CHECK-NEXT: %[[T:[0-9]+]] = addi %[[B]], %[[B]] : !i32
// CHECK-NEXT: -> %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[R]]
