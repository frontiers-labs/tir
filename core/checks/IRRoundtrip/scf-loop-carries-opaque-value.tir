// RUN: tir opt --verify %s | filecheck %s

// A carried port of an opaque, data-less type is an ordinary port: the `*Any`
// operand and result constraints admit it and the scf verifiers only compare
// types pairwise. This is the shape memory state takes once it flows through
// loops as a value.

module {
  %fn_carry = func.func @carry(%0: !index, %1: !index, %2: !index, %3: !unit, %4: !i1) -> !unit {
    %5 = scf.for_legacy %0, %1, %2 iter_args(%6 = %3) -> !unit {
      scf.yield %6
    }
    %7 = scf.while iter_args(%8 = %5) -> !unit {
      scf.condition %4, %8
    } do(%9) {
      scf.yield %9
    }
    func.return %7
  }
  module_end
}

// CHECK: %{{[0-9]+}} = scf.for_legacy %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} iter_args(%{{[0-9]+}} = %{{[0-9]+}}) -> !unit {
// CHECK-NEXT: scf.yield %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = scf.while iter_args(%{{[0-9]+}} = %{{[0-9]+}}) -> !unit {
// CHECK-NEXT: scf.condition %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: do(%{{[0-9]+}}) {
// CHECK-NEXT: scf.yield %{{[0-9]+}}
