// RUN: tir opt --verify %s | filecheck %s

// A carried port of an opaque, data-less type is an ordinary port: the `*Any`
// operand and result constraints admit it and the scf verifiers only compare
// types pairwise. This is the shape memory state takes once it flows through
// loops as a value.

module {
  %fn_carry = func.func @carry(%0: !index, %1: !index, %2: !index, %3: !unit) -> !unit {
    %4, %5 = scf.ordered_for %6 = %0 to %1 step %2 (%7 = %3) {
      scf.yield %7
    }
    func.return %5
  }
  module_end
}

// CHECK: %{{[0-9]+}}, %{{[0-9]+}} = scf.ordered_for %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK-NEXT: scf.yield %{{[0-9]+}}
// CHECK-NEXT: }
