// RUN: tir opt --verify %s | filecheck %s

#layout_spec = #layout.spec<!ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_null = func.func @null() -> !ptr.p {
    %0 = ptr.null : !ptr.p
    func.return %0
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @null() -> !ptr.p {
// CHECK-NEXT: %{{[0-9]+}} = ptr.null : !ptr.p
// CHECK-NEXT: func.return %{{[0-9]+}}
