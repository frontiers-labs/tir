// RUN: tir opt --verify %s | filecheck %s

// An unordered region carries no order, so it prints in the topological order
// its dependencies impose, whatever order the file wrote it in.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %2 = addi %1, %0 : !i32
    %1 = muli %0, %0 : !i32
    -> %2
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @f(%[[A:[0-9]+]]: !i32) -> !i32 {
// CHECK-NEXT: %[[M:[0-9]+]] = muli %[[A]], %[[A]] : !i32
// CHECK-NEXT: %[[S:[0-9]+]] = addi %[[M]], %[[A]] : !i32
// CHECK-NEXT: -> %[[S]]
