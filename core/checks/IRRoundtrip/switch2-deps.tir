// RUN: tir opt --verify %s | filecheck %s

// Dependencies forwarded into a gamma enter every arm as dep ports and leave
// through the chosen arm's dep results.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32) -> !i32 {
    %2 | %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 | %5 = scf.switch %0 args(%1 | %3) (%6 | %7) {
      | %8 = ptr.store %6, %2 | %7
      -> %6 | %8
    }
    (%9 | %10) {
      -> %9 | %10
    }
    func.return %4 | %5
  }
  module_end
}

// CHECK: %[[R:[0-9]+]] | %[[RD:[0-9]+]] = scf.switch %{{[0-9]+}} args(%{{[0-9]+}} | %{{[0-9]+}}) (%[[A:[0-9]+]] | %[[AD:[0-9]+]]) {
// CHECK-NEXT: | %[[S:[0-9]+]] = ptr.store %[[A]], %{{[0-9]+}} | %[[AD]]
// CHECK-NEXT: -> %[[A]] | %[[S]]
// CHECK-NEXT: }
// CHECK-NEXT: (%[[B:[0-9]+]] | %[[BD:[0-9]+]]) {
// CHECK-NEXT: -> %[[B]] | %[[BD]]
// CHECK-NEXT: }
