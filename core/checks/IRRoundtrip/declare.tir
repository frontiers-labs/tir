// RUN: tir opt %s | filecheck %s

module {
  %fn_puts = func.declare @puts(!ptr.p<!i8>) -> !i32
  %fn_main = func.func @main() -> !i32 {
    %0 = constant {value = 0} : !i32
    func.return %0
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: %{{[0-9]+}} = func.declare @puts(!ptr.p<!i8>) -> !i32
// CHECK-NEXT: %{{[0-9]+}} = func.func @main() -> !i32 {
// CHECK-NEXT: %{{[0-9]+}} = constant {value = 0} : !i32
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: module_end
// CHECK-NEXT: }
