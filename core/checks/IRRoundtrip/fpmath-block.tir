// RUN: tir opt %s | filecheck %s

// Discardable metadata rides on block labels; the entry block's label is
// printed only when it carries attributes.

module {
  %fn_scoped = func.func @scoped(%0: !i32, %1: !i1) -> !i32 {
  ^bb0 {tag = "outer"}:
    %2 = muli %0, %0 : !i32
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1 {tag = "inner"}:
    %3 = addi %2, %0 : !i32
    func.return %3
  ^bb2:
    func.return %2
  }
  module_end
}

// CHECK: module {
// CHECK-NEXT: %{{[0-9]+}} = func.func @scoped(%{{[0-9]+}}: !i32, %{{[0-9]+}}: !i1) -> !i32 {
// CHECK-NEXT: ^bb0(%{{[0-9]+}}: !i32, %{{[0-9]+}}: !i1) {tag = "outer"}:
// CHECK-NEXT: %{{[0-9]+}} = muli %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: cfg.cond_br %{{[0-9]+}}, ^bb1, ^bb2
// CHECK-NEXT: ^bb1 {tag = "inner"}:
// CHECK-NEXT: %{{[0-9]+}} = addi %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: ^bb2:
// CHECK-NEXT: func.return %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: module_end
// CHECK-NEXT: }
