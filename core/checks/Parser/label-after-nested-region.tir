// RUN: tir opt %s | filecheck %s

// A block label may follow an op with a nested region: the region parse scope
// is saved and restored across nested regions instead of being clobbered.

module {
  %fn_f = func.func @f(%1: !i32) -> !i32 {
  ^start:
    %lb = constant {value = 0} : !index
    %ub = constant {value = 4} : !index
    %st = constant {value = 1} : !index
    %c, %2 = scf.for %i = %lb to %ub step %st (%a = %1) {
      scf.yield %a
    }
    cfg.br ^tail(%2 : !i32)
  ^tail(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK: scf.for
// CHECK: cfg.br ^bb1(%{{[0-9]+}} : !i32)
// CHECK: ^bb1(%{{[0-9]+}}: !i32):
// CHECK-NEXT: func.return
