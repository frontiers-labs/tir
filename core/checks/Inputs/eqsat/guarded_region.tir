// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass func.func(instcombine-nodes) %s | filecheck %s

// Inside the arm the gate enters on %0 the engine assumes %0 is 1, so
// muli(%0, %1) folds to %1 there. The identical multiply outside the gate stays
// (%0 is unknown).

module {
  %fn_f = func.func @f(%0: !i1, %1: !i1) -> !i1 {
    %2 = muli %0, %1 : !i1
    %4 = scf.switch %0 {
      -> %0
    }
    {
      %3 = muli %0, %1 : !i1
      -> %3
    }
    %5 = xori %2, %4 : !i1
    -> %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[C:[0-9]+]]: !i1, %[[Y:[0-9]+]]: !i1)
// CHECK: %[[OUTER:[0-9]+]] = muli %[[C]], %[[Y]]
// CHECK: scf.switch
// CHECK: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %[[Y]]
// CHECK-NOT: muli
// CHECK: xori %[[OUTER]]
