// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// One loop leaving through both a `continue` and a `break`. The states the two
// exits carry are not the one the body latches, so no single term names the
// value leaving the loop: each edge carries what the slot holds where it is
// taken, and the port merges them.

module {
  %fn_spin = func.func @spin(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = state.entry_state : !state<memory>
    %4 = ptr.store %1, %2 state(%3)
    %5 = scf.loop (%6 = %4) {
      %7, %8 = scf.switch %0 args(%6) (%9) {
        %10 = constant {value = 0} : !i1
        -> %10, %9
      }
      (%11) {
        %12, %13 = ptr.load %2 state(%11) : !i32
        %14 = addi %12, %12 : !i32
        %15 = ptr.store %14, %2 state(%13)
        %16, %17 = scf.switch %0 args(%15) (%18) {
          %19 = ptr.store %12, %2 state(%18)
          %20, %21 = scf.switch %0 args(%19) (%22) {
            %23 = constant {value = 1} : !i1
            -> %23, %22
          }
          (%24) {
            %25 = constant {value = 0} : !i1
            -> %25, %24
          }
          -> %20, %21
        }
        (%26) {
          %27 = constant {value = 1} : !i1
          -> %27, %26
        }
        -> %16, %17
      }
      -> %7, %8, %8
    }
    %28, %29 = ptr.load %2 state(%5) : !i32
    -> %28, %29
  }
  module_end
}

// CHECK-LABEL: module {
// CHECK-NEXT:   %[[V0:[0-9]+]] = func.func @spin(%[[V1:[0-9]+]]: !i1, %[[V2:[0-9]+]]: !i32) -> !i32 {
// CHECK-NEXT:     %[[V3:[0-9]+]] = state.entry_state : !state<memory>
// CHECK-NEXT:     %[[V4:[0-9]+]] = scf.loop (%[[V5:[0-9]+]] = %[[V2]]) {
// CHECK-NEXT:       %[[V6:[0-9]+]], %[[V7:[0-9]+]] = scf.switch %[[V1]] args(%[[V5]]) (%[[V8:[0-9]+]]) {
// CHECK-NEXT:         %[[V9:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT:         -> %[[V9]], %[[V8]]
// CHECK-NEXT:       }
// CHECK-NEXT:       (%[[V10:[0-9]+]]) {
// CHECK-NEXT:         %[[V11:[0-9]+]] = addi %[[V10]], %[[V10]] : !i32
// CHECK-NEXT:         %[[V12:[0-9]+]], %[[V13:[0-9]+]] = scf.switch %[[V1]] args(%[[V11]]) (%[[V14:[0-9]+]]) {
// CHECK-NEXT:           %[[V15:[0-9]+]], %[[V16:[0-9]+]] = scf.switch %[[V1]] args(%[[V10]]) (%[[V17:[0-9]+]]) {
// CHECK-NEXT:             %[[V18:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT:             -> %[[V18]], %[[V17]]
// CHECK-NEXT:           }
// CHECK-NEXT:           (%[[V19:[0-9]+]]) {
// CHECK-NEXT:             %[[V20:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT:             -> %[[V20]], %[[V19]]
// CHECK-NEXT:           }
// CHECK-NEXT:           -> %[[V15]], %[[V16]]
// CHECK-NEXT:         }
// CHECK-NEXT:         (%[[V21:[0-9]+]]) {
// CHECK-NEXT:           %[[V22:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT:           -> %[[V22]], %[[V21]]
// CHECK-NEXT:         }
// CHECK-NEXT:         -> %[[V12]], %[[V13]]
// CHECK-NEXT:       }
// CHECK-NEXT:       -> %[[V6]], %[[V7]], %[[V7]]
// CHECK-NEXT:     }
// CHECK-NEXT:     -> %[[V4]], %[[V3]]
// CHECK-NEXT:   }
// CHECK-NEXT:   module_end
// CHECK-NEXT: }
