// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A slot holding a pointer promotes like any other, since the data layout gives
// the pointer the width the access terms need. The gate grows the port carrying
// what each arm stored, and the port is spelled at the pointer type the accesses
// agree on.

#layout_spec = #layout.spec<!ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_uniform = func.func @uniform(%0: !i1, %1: !ptr.p, %2: !ptr.p, %3: !ptr.p) -> !ptr.p {
    %p = ptr.alloca {size = 8, align = 8} : !ptr.p
    %s0 = state.entry_state : !state<memory>
    %s1 = ptr.store %3, %p state(%s0)
    %s2 = scf.switch %0 args(%s1) (%e) {
      %e1 = ptr.store %2, %p state(%e)
      -> %e1
    }
    (%t) {
      %t1 = ptr.store %1, %p state(%t)
      -> %t1
    }
    %4, %s3 = ptr.load %p state(%s2) : !ptr.p
    -> %4, %s3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @uniform(%[[C:[0-9]+]]: !i1, %[[X:[0-9]+]]: !ptr.p, %[[Y:[0-9]+]]: !ptr.p, %{{[0-9]+}}: !ptr.p) -> !ptr.p {
// CHECK-NOT: ptr.alloca
// CHECK-NOT: ptr.store
// CHECK-NOT: ptr.load
// CHECK: %[[RESULT:[0-9]+]] = scf.switch %[[C]] {
// CHECK-NEXT: -> %[[Y]]
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %[[X]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]]
