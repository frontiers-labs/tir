// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = subi %[[SUM]], %[[Y]] : !i32
// CHECK-NEXT: ptr.store %[[SUM]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @add_sub_cancel_reversed(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[DIFF:[0-9]+]] = subi %[[X]], %[[Y]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = addi %[[Y]], %[[DIFF]] : !i32
// CHECK-NEXT: ptr.store %[[DIFF]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @sub_sub_cancel_live_operand(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[DIFF:[0-9]+]] = subi %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = subi %[[Y]], %[[DIFF]] : !i32
// CHECK-NEXT: ptr.store %[[DIFF]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @add_add_sub_cancel_reversed(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[Z:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[FIRST:[0-9]+]] = addi %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[SECOND:[0-9]+]] = subi %[[Z]], %[[Y]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = addi %[[SECOND]], %[[FIRST]] : !i32
// CHECK-NEXT: ptr.store %[[FIRST]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @and_absorption_reversed(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[OR:[0-9]+]] = ori %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = andi %[[X]], %[[OR]] : !i32
// CHECK-NEXT: ptr.store %[[OR]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @or_absorption_reversed(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[AND:[0-9]+]] = andi %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = ori %[[X]], %[[AND]] : !i32
// CHECK-NEXT: ptr.store %[[AND]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @xor_xor_and_reversed(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[XOR:[0-9]+]] = xori %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = ori %[[Y]], %[[X]] : !i32
// CHECK-NEXT: ptr.store %[[XOR]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
// CHECK-LABEL: func.func @xor_cancel_reversed(%[[X:[0-9]+]]: !i32, %[[Y:[0-9]+]]: !i32, %[[P:[0-9]+]]: !ptr.p<!i32>)
// CHECK-NEXT: %[[XOR:[0-9]+]] = xori %[[Y]], %[[X]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = xori %[[Y]], %[[XOR]] : !i32
// CHECK-NEXT: ptr.store %[[XOR]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
