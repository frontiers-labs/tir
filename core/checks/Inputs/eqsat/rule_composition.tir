// Unknown operands retain poison dependencies; the shared bitwise composition keeps both inputs.

module {
  %sub_add = func.func @sub_add_cancel_reversed(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %sum = addi %y, %x : !i32
    %result = subi %sum, %y : !i32
    ptr.store %sum, %p
    func.return %result
  }
  %add_sub = func.func @add_sub_cancel_reversed(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %difference = subi %x, %y : !i32
    %result = addi %y, %difference : !i32
    ptr.store %difference, %p
    func.return %result
  }
  %sub_sub = func.func @sub_sub_cancel_live_operand(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %difference = subi %y, %x : !i32
    %result = subi %y, %difference : !i32
    ptr.store %difference, %p
    func.return %result
  }
  %add_add_sub = func.func @add_add_sub_cancel_reversed(%x: !i32, %y: !i32, %z: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %first = addi %y, %x : !i32
    %second = subi %z, %y : !i32
    %result = addi %second, %first : !i32
    ptr.store %first, %p
    func.return %result
  }
  %and_absorption = func.func @and_absorption_reversed(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %or = ori %y, %x : !i32
    %result = andi %x, %or : !i32
    ptr.store %or, %p
    func.return %result
  }
  %or_absorption = func.func @or_absorption_reversed(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %and = andi %y, %x : !i32
    %result = ori %x, %and : !i32
    ptr.store %and, %p
    func.return %result
  }
  %xor_xor_and = func.func @xor_xor_and_reversed(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %xor = xori %y, %x : !i32
    %and = andi %y, %x : !i32
    %result = xori %and, %xor : !i32
    ptr.store %xor, %p
    func.return %result
  }
  %xor_cancel = func.func @xor_cancel_reversed(%x: !i32, %y: !i32, %p: !ptr.p<!i32>) -> !i32 {
    %xor = xori %y, %x : !i32
    %result = xori %y, %xor : !i32
    ptr.store %xor, %p
    func.return %result
  }
  module_end
}

