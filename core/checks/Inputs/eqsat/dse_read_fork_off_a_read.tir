// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes) --verify --shuffle-seed 7 %s | tir opt --pass func.func(instcombine-nodes) --verify - -o /dev/null

// Disjoint reads retain their values and ordering when the overwritten write
// they fork from is removed.

#layout_spec = #layout.spec<!i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_f = func.func @f(%0: !i64, %1: !i32, %2: !i32) -> !i64 {
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %0, %3
    %4 = ptr.load %3 : !i64
    ptr.store %1, %3
    %5 = constant {value = 4} : !i64
    %6 = ptr.ptradd %3, %5 : !ptr.p<!i64>
    %7 = ptr.load %6 : !i32
    %8 = ptr.load %6 : !i32
    ptr.store %2, %3
    %9 = addi %7, %8 : !i32
    %10 = extsi %9 : !i64
    %11 = addi %4, %10 : !i64
    func.return %11
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[A:[0-9]+]]: !i64, %{{[0-9]+}}: !i32, %[[C:[0-9]+]]: !i32)
// CHECK-NEXT: %[[P:[0-9]+]] = ptr.alloca {size = 8, align = 8}
// CHECK-NEXT: ptr.store %[[A]], %[[P]]
// CHECK-NEXT: %[[FOUR:[0-9]+]] = constant {value = 4} : !i64
// CHECK-NEXT: %[[Q:[0-9]+]] = ptr.ptradd %[[P]], %[[FOUR]]
// CHECK-NEXT: %[[R:[0-9]+]] = ptr.load %[[Q]] : !i32
// CHECK-NEXT: ptr.store %[[C]], %[[P]]
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[R]], %[[R]] : !i32
// CHECK-NEXT: %[[EXT:[0-9]+]] = extsi %[[SUM]] : !i64
// CHECK-NEXT: %[[RESULT:[0-9]+]] = addi %[[A]], %[[EXT]] : !i64
// CHECK-NEXT: func.return %[[RESULT]]
