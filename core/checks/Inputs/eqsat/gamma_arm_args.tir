// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass func.func(instcombine-nodes) %s | filecheck %s

// An arm's entry arguments are the inputs the gamma forwards into it, so
// `addi %3, 0` is the forwarded `%1`. The gate keeps evaluating its selector
// so a Poison selector still fails.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.switch %0 args(%1) (%6) {
      -> %6
    }
    (%3) {
      %4 = constant {value = 0} : !i32
      %5 = addi %3, %4 : !i32
      -> %5
    }
    -> %2
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[C:[0-9]+]]: !i1, %[[X:[0-9]+]]: !i32)
// CHECK: %[[RESULT:[0-9]+]] = scf.switch %[[C]] args(%[[X]]) (%[[FIRST:[0-9]+]]) {
// CHECK-NEXT: -> %[[FIRST]]
// CHECK: (%[[LAST:[0-9]+]]) {
// CHECK-NOT: addi
// CHECK: -> %[[LAST]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]]
// CHECK-NOT: addi
