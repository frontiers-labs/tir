// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s

// A value computed in the entry block feeds an op in a successor. The cross-block
// value is opaque to the successor's e-graph, so addi(_, 0) still folds without
// modeling the branch, and muli(x, 2) becomes shli(x, 1).

module {
  %fn_fwd = func.func @fwd(%0: !i32) -> !i32 {
    %1 = constant {value = 2} : !i32
    %2 = muli %0, %1 : !i32
    cfg.br ^bb1
  ^bb1:
    %3 = constant {value = 0} : !i32
    %4 = addi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: func.func @fwd(%[[X:[0-9]+]]: !i32)
// CHECK: %[[ONE:[0-9]+]] = constant {value = 1} : !i32
// CHECK-NEXT: %[[SHIFT:[0-9]+]] = shli %[[X]], %[[ONE]] : !i32
// CHECK-NOT: muli
// CHECK-NOT: addi
// CHECK: func.return %[[SHIFT]]
// CHECK-NOT: muli
// CHECK-NOT: addi
