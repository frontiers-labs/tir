// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s

module {
  %fn_accumulate = func.func @accumulate(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = state.entry_state : !state<memory>
    %5 = ptr.store %1, %3 state(%4)
    %6, %7 = scf.loop (%8 = %2, %9 = %5) {
      %10, %11, %12 = scf.switch %0 args(%9) (%13) {
        %14 = constant {value = 0} : !i1
        -> %14, %8, %13
      }
      (%15) {
        %16, %17 = ptr.load %3 state(%15) : !i32
        %18 = addi %8, %16 : !i32
        %19 = constant {value = 1} : !i1
        -> %19, %18, %17
      }
      -> %10, %11, %8, %12, %12
    }
    -> %6, %7
  }
  module_end
}

// CHECK-LABEL: func.func @accumulate(%[[SELECTOR:[0-9]+]]: !i1, %[[SEED:[0-9]+]]: !i32, %[[INITIAL:[0-9]+]]: !i32)
// CHECK-NOT: ptr.
// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK: %[[RESULT:[0-9]+]], %{{[0-9]+}} = scf.loop (%[[ACC:[0-9]+]] = %[[INITIAL]], %[[CELL:[0-9]+]] = %[[SEED]]) {
// CHECK: scf.switch %[[SELECTOR]] args(%[[CELL]]) (%[[ELSE:[0-9]+]]) {
// CHECK: -> %{{[0-9]+}}, %[[ACC]], %[[ELSE]]
// CHECK: (%[[BODY:[0-9]+]]) {
// CHECK: %[[SUM:[0-9]+]] = addi %[[ACC]], %[[BODY]] : !i32
// CHECK: -> %{{[0-9]+}}, %[[SUM]], %[[BODY]]
// CHECK: -> %[[RESULT]], %[[ENTRY]]
