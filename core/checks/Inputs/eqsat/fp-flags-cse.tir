// RUN: tir opt --pass restructure-nodes,instcombine-nodes,dce,verify-deps --verify %s | filecheck %s

module {
  %f = func.func @sequential(%a: !f64, %b: !f64) -> !i5 {
    %env0 = state.entry_state : !state<fp.env>
    %x, %env1 = fp.div %a, %b state(%env0) {semantics = {exceptions = "flags"}} : !f64
    %y, %env2 = fp.div %a, %b state(%env1) {semantics = {exceptions = "flags"}} : !f64
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    func.return %flags state(%env3)
  }
  module_end
}

// CHECK: %{{[0-9]+}}, %[[FIRST:[0-9]+]] = fp.div
// CHECK-NEXT: %{{[0-9]+}}, %[[SECOND:[0-9]+]] = fp.div %{{[0-9]+}}, %{{[0-9]+}} state(%[[FIRST]])
// CHECK-NEXT: %{{[0-9]+}}, %{{[0-9]+}} = fp.get_flags state(%[[SECOND]])
