module {layout.spec = #layout.spec<endianness = "little", !ptr.p = {size = 64, abi = 64}>} {
 %f = func.func @f(%x: !i32, %p: !ptr.p<!i32>) -> !i32 {
 %e = state.entry_state : !state<memory>
 %s = ptr.store %x, %p state(%e)
 %left, %right = state.split state(%s)
 %a, %r = ptr.load %p state(%left) : !i32
 %b, %t = ptr.load %p state(%left) : !i32
 %c, %u = ptr.load %p state(%right) : !i32
 %j = state.join state(%r, %t, %u)
 %ab = addi %a, %b : !i32
 %sum = addi %ab, %c : !i32
 -> %sum, %j
 }
 module_end
}
