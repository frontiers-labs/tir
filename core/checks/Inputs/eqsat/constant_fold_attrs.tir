// Only the exact signed-less-than comparison folds over known constants.

module {
  %fn_f = func.func @f() -> !i1 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 3} : !i32
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  %fn_reversed = func.func @reversed() -> !i1 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 3} : !i32
    %2 = cmpi %1, %0 {predicate = "slt"} : !i1
    func.return %2
  }
  %fn_signed = func.func @signed() -> !i1 {
    %0 = constant {value = -1} : !i8
    %1 = constant {value = 2} : !i8
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  %fn_predicate = func.func @predicate() -> !i1 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 3} : !i32
    %2 = cmpi %0, %1 {predicate = "sge"} : !i1
    func.return %2
  }
  %fn_unknown = func.func @unknown(%x: !i32) -> !i1 {
    %0 = constant {value = 3} : !i32
    %1 = cmpi %x, %0 {predicate = "slt"} : !i1
    func.return %1
  }
  %fn_poison = func.func @poison() -> !i1 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 32} : !i32
    %2 = shli %0, %1 : !i32
    %3 = cmpi %2, %0 {predicate = "slt"} : !i1
    func.return %3
  }
  %fn_extra_attr = func.func @extra_attr() -> !i1 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 3} : !i32
    %2 = cmpi %0, %1 {predicate = "slt", extra = 1} : !i1
    func.return %2
  }
  module_end
}
