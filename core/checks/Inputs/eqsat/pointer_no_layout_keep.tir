// Pointer-valued forwarding requires a known pointer layout.

module {
  %fn_f = func.func @f(%0: !ptr.p<!ptr.p<!i32>>, %1: !ptr.p<!i32>) -> !ptr.p<!i32> {
    %2 = state.entry_state : !state<memory>
    %3 = ptr.store %1, %0 state(%2)
    %4 = ptr.load %0 state(%3) : !ptr.p<!i32>
    func.return %4
  }
  module_end
}
