// RUN: tir opt --pass instcombine-nodes --verify %s | filecheck %s
// RUN: tir opt --pass instcombine-nodes %s | tir interp -f f --args=1,2 | filecheck --check-prefix=VALUE %s

module {
  %24 = func.func @f(%25: !i64, %26: !i64) -> !i64 {
    %2 = addi %25, %26 : !i64
    %3 = constant {value = 16} : !i64
    %4 = constant {value = 1} : !i64
    %5 = constant {value = 0} : !i64
    %32 = constant {value = 0} : !i64
    %33, %34, %35 = scf.loop (%27 = %2, %28 = %3, %29 = %32) {
      %8 = addi %27, %2 : !i64
      %9 = subi %28, %4 : !i64
      %10 = cmpi %8, %2 {predicate = "sgt"} : !i1
      %30, %31 = scf.switch %10 {
        -> %27, %9
      }
      {
        -> %8, %9
      }
      %13 = addi %30, %2 : !i64
      %14 = subi %31, %4 : !i64
      %15 = cmpi %14, %5 {predicate = "sgt"} : !i1
      -> %15, %13, %14, %29, %27, %28, %30
    }
    %23 = addi %35, %2 : !i64
    -> %23
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK: %[[BASE:[0-9]+]] = addi
// CHECK: %{{[0-9]+}}, %{{[0-9]+}}, %[[EXIT:[0-9]+]] = scf.loop
// CHECK: %[[SUM:[0-9]+]] = addi %[[EXIT]], %[[BASE]]
// CHECK-NEXT: -> %[[SUM]]
// VALUE: i64 51
