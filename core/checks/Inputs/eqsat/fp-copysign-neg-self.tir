module {
  %f32 = func.func @f32(%x: !f32, %y: !f32) -> !f32 {
    %inner = fp.neg %x : !f32
    %result = fp.copysign %x, %inner : !f32
    func.return %result
  }
  %b32 = func.func @bits32() -> !i32 {
    %x = fp.constant {bits = 2141266757} : !f32
    %y = fp.constant {bits = 2147483648} : !f32
    %inner = fp.neg %x : !f32
    %result = fp.copysign %x, %inner : !f32
    %bits = bitcast %result : !i32
    func.return %bits
  }
  %f64 = func.func @f64(%x: !f64, %y: !f64) -> !f64 {
    %inner = fp.neg %x : !f64
    %result = fp.copysign %x, %inner : !f64
    func.return %result
  }
  %b64 = func.func @bits64() -> !i64 {
    %positive_zero = fp.constant {bits = 0} : !f64
    %x = fp.neg %positive_zero : !f64
    %y = fp.constant {bits = 0} : !f64
    %inner = fp.neg %x : !f64
    %result = fp.copysign %x, %inner : !f64
    %bits = bitcast %result : !i64
    func.return %bits
  }
  module_end
}
