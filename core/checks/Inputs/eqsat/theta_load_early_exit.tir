// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A body leaving through an early exit never reaches its latch, so the exit edge
// is where the slot's value leaves the loop. The carried port is fed on that
// edge, the read after the loop becomes the loop's result, and the slot leaves
// memory.

module {
  %fn_early = func.func @early(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = state.entry_state : !state<memory>
    %4 = ptr.store %1, %2 state(%3)
    %5 = scf.loop (%6 = %4) {
      %7, %8 = scf.switch %0 args(%6) (%9) {
        %10 = constant {value = 0} : !i1
        -> %10, %9
      }
      (%11) {
        %12 = ptr.store %1, %2 state(%11)
        %13 = constant {value = 0} : !i1
        -> %13, %12
      }
      -> %7, %8, %8
    }
    %14, %15 = ptr.load %2 state(%5) : !i32
    -> %14, %15
  }
  module_end
}

// CHECK-LABEL: module {
// CHECK-NEXT:   %[[V0:[0-9]+]] = func.func @early(%[[V1:[0-9]+]]: !i1, %[[V2:[0-9]+]]: !i32) -> !i32 {
// CHECK-NEXT:     %[[V3:[0-9]+]] = state.entry_state : !state<memory>
// CHECK-NEXT:     %[[V4:[0-9]+]] = scf.loop (%[[V5:[0-9]+]] = %[[V2]]) {
// CHECK-NEXT:       %[[V6:[0-9]+]], %[[V7:[0-9]+]] = scf.switch %[[V1]] args(%[[V5]]) (%[[V8:[0-9]+]]) {
// CHECK-NEXT:         %[[V9:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT:         -> %[[V9]], %[[V8]]
// CHECK-NEXT:       }
// CHECK-NEXT:       (%[[V10:[0-9]+]]) {
// CHECK-NEXT:         %[[V11:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT:         -> %[[V11]], %[[V2]]
// CHECK-NEXT:       }
// CHECK-NEXT:       -> %[[V6]], %[[V7]], %[[V7]]
// CHECK-NEXT:     }
// CHECK-NEXT:     -> %[[V4]], %[[V3]]
// CHECK-NEXT:   }
// CHECK-NEXT:   module_end
// CHECK-NEXT: }
