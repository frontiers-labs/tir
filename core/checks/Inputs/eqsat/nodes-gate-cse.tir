module {
  %fn_f = func.func @f(%c: !i1, %x: !i32) -> !i32 {
    %two = constant {value = 2} : !i32
    %three = constant {value = 3} : !i32
    cfg.cond_br %c, ^then, ^else
  ^then:
    %a = addi %x, %x : !i32
    %d = divsi %x, %two : !i32
    cfg.br ^join(%a, %d : !i32, !i32)
  ^else:
    %b = addi %x, %x : !i32
    %e = divsi %x, %three : !i32
    cfg.br ^join(%b, %e : !i32, !i32)
  ^join(%s: !i32, %q: !i32):
    %r = addi %s, %q : !i32
    func.return %r
  }
  module_end
}

// CHECK: func.func @f(%[[C:[0-9]+]]: !i1, %[[X:[0-9]+]]: !i32)
// CHECK: %[[SUM:[0-9]+]] = addi %[[X]], %[[X]] : !i32
// CHECK-NEXT: cfg.cond_br %[[C]], ^[[THEN:bb[0-9]+]], ^[[ELSE:bb[0-9]+]]
// CHECK-NEXT: ^[[THEN]]:
// CHECK-NEXT: %[[THENQ:[0-9]+]] = divsi %[[X]], %{{[0-9]+}} : !i32
// CHECK-NEXT: cfg.br ^[[JOIN:bb[0-9]+]](%[[SUM]], %[[THENQ]] : !i32, !i32)
// CHECK-NEXT: ^[[ELSE]]:
// CHECK-NEXT: %[[ELSEQ:[0-9]+]] = divsi %[[X]], %{{[0-9]+}} : !i32
// CHECK-NEXT: cfg.br ^[[JOIN]](%[[SUM]], %[[ELSEQ]] : !i32, !i32)
// CHECK-NEXT: ^[[JOIN]](%[[S:[0-9]+]]: !i32, %[[Q:[0-9]+]]: !i32):
// CHECK-NEXT: %[[R:[0-9]+]] = addi %[[S]], %[[Q]] : !i32
// CHECK-NEXT: func.return %[[R]]
// CHECK-NOT: addi
