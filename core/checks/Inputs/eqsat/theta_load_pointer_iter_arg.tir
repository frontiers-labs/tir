// Carry the stored pointer through the ordered loop and remove its private cell.

#layout_spec = #layout.spec<!ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_advance = func.func @advance(%0: !i64, %1: !i64, %2: !i64, %3: !ptr.p, %4: !i64) -> !ptr.p {
    %5 = ptr.alloca {size = 8, align = 8} : !ptr.p
    ptr.store %3, %5
    %i1_end = scf.ordered_for %i1 = %0 to %1 step %2 {
      %6 = ptr.load %5 : !ptr.p
      %7 = ptr.ptradd %6, %4 : !ptr.p
      ptr.store %7, %5
      scf.yield
    }
    %8 = ptr.load %5 : !ptr.p
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @advance(%[[LB:[0-9]+]]: !i64, %[[UB:[0-9]+]]: !i64, %[[STEP:[0-9]+]]: !i64, %[[INIT:[0-9]+]]: !ptr.p, %[[D:[0-9]+]]: !i64)
// CHECK-NOT: ptr.alloca
// CHECK-NOT: ptr.store
// CHECK-NOT: ptr.load
// CHECK: %{{[0-9]+}}, %[[RESULT:[0-9]+]] = scf.ordered_for %{{[0-9]+}} = %[[LB]] to %[[UB]] step %[[STEP]] (%[[CARRIED:[0-9]+]] = %[[INIT]]) {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = ptr.ptradd %[[CARRIED]], %[[D]] : !ptr.p
// CHECK-NEXT: scf.yield %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
