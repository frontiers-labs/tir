// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s

// Fold the zero offset while preserving the store and load around an opaque
// call that may change the memory resource.

#layout_spec = #layout.spec<!ptr.p = {size = 64, abi = 64}, !i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_g = func.declare @g() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %2 = constant {value = 0} : !i64
    %3 = ptr.ptradd %1, %2 : !ptr.p<!i32>
    ptr.store %0, %3
    func.call %fn_g()
    %4 = ptr.load %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK: %[[G:[0-9]+]] = func.declare @g() -> !unit
// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[X:[0-9]+]]: !i32) -> !i32 {
// CHECK-NEXT: %[[P:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %[[X]], %[[P]]
// CHECK-NEXT: func.call %[[G]]()
// CHECK-NEXT: %[[V:[0-9]+]] = ptr.load %[[P]] : !i32
// CHECK-NEXT: func.return %[[V]]
// CHECK-NEXT: }
