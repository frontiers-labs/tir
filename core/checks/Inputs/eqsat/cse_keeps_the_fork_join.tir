// Adjacent ordinary CFG reads share their data value. The retained read,
// addition and write keep their original order.

module {
  %fn_f = func.func @f(%p: !ptr.p<!i32>, %q: !ptr.p<!i32>) -> !i32 {
    %0 = ptr.load %p : !i32
    %1 = ptr.load %p : !i32
    %2 = addi %0, %1 : !i32
    ptr.store %2, %p
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[P:[0-9]+]]: !ptr.p<!i32>, %{{[0-9]+}}: !ptr.p<!i32>) -> !i32
// CHECK-NEXT: %[[V:[0-9]+]] = ptr.load %[[P]] : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = addi %[[V]], %[[V]] : !i32
// CHECK-NEXT: ptr.store %[[R]], %[[P]]
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
