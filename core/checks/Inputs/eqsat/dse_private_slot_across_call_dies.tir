// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s

// A zero-argument opaque call may observe the first store. Keep both stores
// and the allocation, while forwarding the load directly after the last store.

#layout_spec = #layout.spec<!i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_g = func.declare @g() -> !unit
  %fn_f = func.func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    func.call %fn_g()
    ptr.store %1, %2
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK: %[[G:[0-9]+]] = func.declare @g() -> !unit
// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[A:[0-9]+]]: !i32, %[[B:[0-9]+]]: !i32) -> !i32 {
// CHECK-NEXT: %[[P:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %[[A]], %[[P]]
// CHECK-NEXT: func.call %[[G]]()
// CHECK-NEXT: ptr.store %[[B]], %[[P]]
// CHECK-NEXT: func.return %[[B]]
// CHECK-NEXT: }
