// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes,instcombine-nodes,verify-deps --verify %s | filecheck %s

module {
  %f = func.func @shared_compare(%condition: !i1, %a: !f64, %b: !f64) -> !i1 {
    cfg.cond_br %condition, ^then, ^else
  ^then:
    %x = fp.cmp %a, %b {predicate = "olt"} : !i1
    cfg.br ^join(%x : !i1)
  ^else:
    %y = fp.cmp %a, %b {predicate = "olt"} : !i1
    cfg.br ^join(%y : !i1)
  ^join(%result: !i1):
    func.return %result
  }
  module_end
}

// CHECK: func.func @shared_compare
// CHECK-NOT: scf.switch
// CHECK: %[[SUM:[0-9]+]] = fp.cmp
// CHECK-NOT: fp.cmp
// CHECK: cfg.cond_br
// CHECK-NOT: fp.cmp
// CHECK-NOT: scf.switch
// CHECK: func.return %[[SUM]]
// CHECK-NOT: fp.cmp
