// The second read reuses the first data value. The strict subtraction remains
// because an uninitialized read can produce Poison.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>) -> !i32 {
    %1 = state.entry_state : !state<memory>
    %2, %3 = ptr.load %0 state(%1) : !i32
    %4 = ptr.load %0 state(%3) : !i32
    %5 = subi %2, %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[P:[0-9]+]]: !ptr.p<!i32>) -> !i32
// CHECK-NEXT: %[[ENTRY:[0-9]+]] = state.entry_state : !state<memory>
// CHECK-NEXT: %[[V:[0-9]+]], %{{[0-9]+}} = ptr.load %[[P]] state(%[[ENTRY]]) : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = subi %[[V]], %[[V]] : !i32
// CHECK-NEXT: func.return %[[R]]
// CHECK-NEXT: }
