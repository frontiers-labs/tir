// An equality gate's then-arm knows its two operands name one value, so the
// subtraction inside it is zero. The else-arm knows nothing and keeps its
// subtraction. `ne` states the same fact the other way round: the else-arm folds.
// Each arm shifts the difference by its own operand, so the arms share no term
// that could be spelled once outside the gate.

module {
  %fn_eq = func.func @eq(%a: !i64, %b: !i64, %k: !i64, %m: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "eq"} : !i1
    %r = scf.switch %c {
      %t = subi %a, %b : !i64
      %u = addi %t, %m : !i64
      -> %u
    }
    {
      %s = subi %a, %b : !i64
      %v = addi %s, %k : !i64
      -> %v
    }
    -> %r
  }
  %fn_ne = func.func @ne(%a: !i64, %b: !i64, %k: !i64, %m: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "ne"} : !i1
    %r = scf.switch %c {
      %t = subi %a, %b : !i64
      %u = addi %t, %m : !i64
      -> %u
    }
    {
      %s = subi %a, %b : !i64
      %v = addi %s, %k : !i64
      -> %v
    }
    -> %r
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @eq(%[[A:[0-9]+]]: !i64, %[[B:[0-9]+]]: !i64, %[[K:[0-9]+]]: !i64, %[[M:[0-9]+]]: !i64)
// CHECK: %[[C:[0-9]+]] = cmpi %[[A]], %[[B]] {predicate = "eq"} : !i1
// CHECK-NEXT: %[[R:[0-9]+]] = scf.switch %[[C]] {
// CHECK-NEXT: %[[D:[0-9]+]] = subi %[[A]], %[[B]] : !i64
// CHECK-NEXT: %[[V:[0-9]+]] = addi %[[D]], %[[M]] : !i64
// CHECK-NEXT: -> %[[V]]
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %[[K]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[R]]
// CHECK-NEXT: }

// CHECK-LABEL: %{{[0-9]+}} = func.func @ne(%[[A:[0-9]+]]: !i64, %[[B:[0-9]+]]: !i64, %[[K:[0-9]+]]: !i64, %[[M:[0-9]+]]: !i64)
// CHECK: %[[C:[0-9]+]] = cmpi %[[A]], %[[B]] {predicate = "ne"} : !i1
// CHECK-NEXT: %[[R:[0-9]+]] = scf.switch %[[C]] {
// CHECK-NEXT: -> %[[M]]
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: %[[D:[0-9]+]] = subi %[[A]], %[[B]] : !i64
// CHECK-NEXT: %[[V:[0-9]+]] = addi %[[D]], %[[K]] : !i64
// CHECK-NEXT: -> %[[V]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[R]]
// CHECK-NEXT: }
