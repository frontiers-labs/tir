// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes),fixpoint<3>(func.func(instcombine-nodes)) %s | filecheck %s

// A counted loop with an early exit carrying a flag it never changes. One run
// of the simplifier proves the carried flag is the constant it was entered on
// and spells it wherever the loop yields it, so the fixpoint wrapper, which
// reruns the same pass until nothing moves, reaches the same graph.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %zero = constant {value = 0} : !i32
    %false = constant {value = 0} : !i1
    %one = constant {value = 1} : !i32
    %six = constant {value = 6} : !i32
    cfg.br ^head(%zero, %false, %zero, %zero : !i32, !i1, !i32, !i32)
  ^head(%a: !i32, %flag: !i1, %c: !i32, %i: !i32):
    %more = cmpi %i, %0 {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body, ^exit(%a, %flag, %zero, %i : !i32, !i1, !i32, !i32)
  ^body:
    %hit = cmpi %i, %six {predicate = "eq"} : !i1
    %next = addi %i, %one : !i32
    cfg.cond_br %hit, ^exit(%one, %false, %one, %i : !i32, !i1, !i32, !i32), ^head(%a, %flag, %c, %next : !i32, !i1, !i32, !i32)
  ^exit(%ra: !i32, %rf: !i1, %rc: !i32, %ri: !i32):
    func.return %ra
  }
  module_end
}

// CHECK: %[[FALSE:[0-9]+]] = constant {value = 0} : !i1
// CHECK: scf.loop (%{{[0-9]+}} = %{{[0-9]+}}, %[[PORT:[0-9]+]] = %[[FALSE]],
// CHECK-NOT: %[[PORT]]
// CHECK: -> %{{[0-9]+}}, %{{[0-9]+}}, %[[FALSE]], %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}, %[[FALSE]],
// CHECK-NEXT: }
