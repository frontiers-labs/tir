// RUN: not tir opt --pass promote-nodes %s 2>&1 | filecheck %s
// RUN: tir opt --pass restructure-nodes %s | filecheck %s --check-prefix=ANY

// A pass declares the body kind it walks. Asking it to run on the other kind
// is an error, not a silent skip: `promote-nodes` reads an unordered graph,
// and this body is blocks. `restructure-nodes` takes either kind, so the same
// body passes it.

module {
  %f = func.func @f(%p: !i32) -> !i32 {
    %y = addi %p, %p : !i32
    func.return %y
  }
  module_end
}

// CHECK: pass 'promote-nodes' runs on an unordered body, but func.func @f holds an ordered one
// ANY: func.func @f
