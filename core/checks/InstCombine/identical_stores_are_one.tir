// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Two writes of one value to one address. Law S2 equates the memory the second
// leaves with the memory writing it over the state the first was handed, and
// that rebuilt term is the first write itself — so the two are one write, and
// the one that remains takes the state the pair was entered on.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @twice(%1: !ptr.p, %2: !i32) {
    ptr.store %2, %1
    ptr.store %2, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @twice
// CHECK: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: | %[[ONLY:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[ENTRY]]
// CHECK-NEXT: -> | %[[ONLY]]
