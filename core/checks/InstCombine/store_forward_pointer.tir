// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s

// A pointer is a value of the width the data layout gives it, so a store of one
// covers the extent the load reads and the load is the value the store wrote.

#layout_spec = #layout.spec<!ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_f = func.func @f(%0: !ptr.p<!ptr.p<!i32>>, %1: !ptr.p<!i32>) -> !ptr.p<!i32> {
    %2 = state.entry_state : !state<memory>
    %3 = ptr.store %1, %0 state(%2)
    %4 = ptr.load %0 state(%3) : !ptr.p<!i32>
    func.return %4 state(%3)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.store %[[V:[0-9]+]],
// CHECK-NOT: ptr.load
// CHECK: -> %[[V]]
