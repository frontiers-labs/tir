// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s
// RUN: tir interp %s -f f --args=4 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | tir interp -f f --args=4 | filecheck %s --check-prefix=VALUE

// A counter's next value is the counter at offset one, which is not the
// counter: the hypothesis that the port holds the zero it was entered on is
// refuted by the edge back into it, so the loop stays and its result is not 0.

module {
  %fn_f = func.func @f(%n: !i32) -> !i32 {
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    cfg.br ^body(%zero : !i32)
  ^body(%i: !i32):
    %next = addi %i, %one : !i32
    %more = cmpi %next, %n {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body(%next : !i32), ^exit
  ^exit:
    func.return %next
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK: %{{[0-9]+}}, %[[RESULT:[0-9]+]] = scf.loop (%[[I:[0-9]+]] = %{{[0-9]+}}
// CHECK-NEXT: addi %[[I]], %{{[0-9]+}} : !i32
// CHECK: -> %[[RESULT]]

// VALUE: i32 4
