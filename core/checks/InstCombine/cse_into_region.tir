// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

// A value defined after the `scf.if` does not reach into its arms: the arm
// spells the literal its class carries where it stands rather than taking over
// the later, identical one.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i8) -> !i8 {
    %2 = scf.if %0 -> !i8 {
      %3 = constant {value = 1} : !i32
      %4 = trunci %3 : !i8
      scf.yield %4
    } else {
      %5 = constant {value = 0} : !i8
      scf.yield %5
    }
    %6 = constant {value = 1} : !i8
    %7 = addi %1, %6 : !i8
    %8 = addi %2, %7 : !i8
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: scf.if
// CHECK-NEXT: %[[OWN:[0-9]+]] = constant {value = 1} : !i8
// CHECK-NEXT: scf.yield %[[OWN]]
