// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s

// A shift by the width is poison. Retain its value dependency.

module {
  %f8 = func.func @shrui_wide_8(%x: !i8) -> !i8 {
    %a = constant {value = 8} : !i8
    %r = shrui %x, %a : !i8
    func.return %r
  }
  %f32 = func.func @shrui_wide_32(%x: !i32) -> !i32 {
    %a = constant {value = 32} : !i32
    %r = shrui %x, %a : !i32
    func.return %r
  }
  %f64 = func.func @shrui_wide_64(%x: !i64) -> !i64 {
    %a = constant {value = 64} : !i64
    %r = shrui %x, %a : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @shrui_wide_8(%[[X:[0-9]+]]: !i8)
// CHECK: %[[AMOUNT:[0-9]+]] = constant {value = 8} : !i8
// CHECK-NEXT: %[[RESULT:[0-9]+]] = shrui %[[X]], %[[AMOUNT]]
// CHECK-NEXT: func.return %[[RESULT]]
// CHECK-LABEL: func.func @shrui_wide_32(%[[X:[0-9]+]]: !i32)
// CHECK: %[[AMOUNT:[0-9]+]] = constant {value = 32} : !i32
// CHECK-NEXT: %[[RESULT:[0-9]+]] = shrui %[[X]], %[[AMOUNT]]
// CHECK-NEXT: func.return %[[RESULT]]
// CHECK-LABEL: func.func @shrui_wide_64(%[[X:[0-9]+]]: !i64)
// CHECK: %[[AMOUNT:[0-9]+]] = constant {value = 64} : !i64
// CHECK-NEXT: %[[RESULT:[0-9]+]] = shrui %[[X]], %[[AMOUNT]]
// CHECK-NEXT: func.return %[[RESULT]]
