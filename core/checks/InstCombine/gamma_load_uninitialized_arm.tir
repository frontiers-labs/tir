// RUN: tir opt --pass promote --pass thread-state --pass instcombine --verify %s | filecheck %s

// Nothing stores before the gate, so the read distributed into the arm that
// stores nothing forwards from no store. With no operation naming an
// indeterminate value, that read is the value: it is emitted where the state it
// reads was published — the allocation, which nothing has written yet — and the
// arm yields what it reads. The allocation therefore survives, but nothing reads
// what the other arm writes, so that store does not.

module {
  %fn_guarded = func.func @guarded(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      ptr.store %1, %2
      scf.yield
    } else {
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @guarded
// CHECK: %[[SLOT:[0-9]+]] | %{{[0-9]+}} = ptr.alloca
// CHECK-NEXT: %[[UNINIT:[0-9]+]] | %{{[0-9]+}} = ptr.load %[[SLOT]]
// CHECK-NEXT: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: scf.yield %[[UNINIT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
// CHECK-NOT: ptr.store
