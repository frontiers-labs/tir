// RUN: tir opt --pass restructure-nodes,promote-nodes,instcombine-nodes --verify %s | filecheck %s

// The slot's own address is stored into a second slot and the write comes back
// through what that slot holds. The graph names that pointer — the read of the
// holder forwards to the address the store put there — so the write through it
// is a write of the slot itself, and the read after it takes the value written.
// A name the graph can prove equal is not an escape.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_stored_pointer = func.func @stored_pointer(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!ptr.p<!i32>>
    ptr.store %2, %3
    %4 = ptr.load %3 : !ptr.p<!i32>
    ptr.store %1, %4
    %5 = ptr.load %2 : !i32
    func.return %5
  }
  module_end
}

// CHECK: func.func @stored_pointer(%{{[0-9]+}}: !i32, %[[B:[0-9]+]]: !i32)
// CHECK-NOT: ptr.load
// CHECK: -> %[[B]]
