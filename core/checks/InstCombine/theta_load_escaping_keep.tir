// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The slot's pointer is handed to a call, so the term graph does not see every
// access of it: a value the θ reconstructed would answer for memory the graph
// never read. No port grows and the loop keeps reading memory.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !i32
  %fn_escapes = func.func @escapes(%0: !i64, %1: !i64, %2: !i64, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    scf.for_legacy %0, %1, %2 {
      %5 = ptr.load %4 : !i32
      %7 = func.call %fn_sink(%4 : !ptr.p<!i32>) -> !i32
      ptr.store %5, %4
      scf.yield
    }
    %6 = ptr.load %4 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @escapes
// CHECK: ptr.alloca
// CHECK: ptr.store
// CHECK: scf.for
// CHECK: ptr.load
// CHECK: ptr.load
