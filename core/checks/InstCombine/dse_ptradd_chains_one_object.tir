// RUN: tir opt --pass func.func(promote,thread-state,instcombine) --verify %s | filecheck %s

// Two spellings of one address: `+4` and `+2+2` land on the same byte of the
// same object. The extent a law reads is the object an address is derived from
// and the offset into it, so the two spellings are the one extent: the second
// write overwrites the first, and the read after them takes its value. Nothing
// then reads the slot at all, and the writes go with it.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i32>
    %3 = constant {value = 4} : !i64
    %4 = ptr.ptradd %2, %3 : !ptr.p<!i32>
    ptr.store %0, %4
    %5 = constant {value = 2} : !i64
    %6 = ptr.ptradd %2, %5 : !ptr.p<!i32>
    %7 = ptr.ptradd %6, %5 : !ptr.p<!i32>
    ptr.store %1, %7
    %8 = ptr.load %4 : !i32
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.store
// CHECK-NOT: ptr.load
// CHECK: func.return %1
