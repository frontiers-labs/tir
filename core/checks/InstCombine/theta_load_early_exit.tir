// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A body leaving through an early exit never reaches its latch, so the exit edge
// is where the slot's value leaves the loop. The carried port is fed on that
// edge, the read after the loop becomes the loop's result, and the slot leaves
// memory.

module {
  %fn_early = func.func @early(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%3) = state.entry_state
    state(%4) = ptr.store %1, %2 state(%3)
    state(%5) = scf.loop (state(%6 = %4)) {
      %7, state(%8) = scf.switch %0 args(state(%6)) (state(%9)) {
        %10 = constant {value = 0} : !i1
        -> %10, state(%9)
      }
      (state(%11)) {
        state(%12) = ptr.store %1, %2 state(%11)
        %13 = constant {value = 0} : !i1
        -> %13, state(%12)
      }
      -> %7, state(%8, %8)
    }
    %14, state(%15) = ptr.load %2 state(%5) : !i32
    -> %14, state(%15)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @early
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.loop (%[[PORT:[0-9]+]] = %1) {
// CHECK: -> %{{[0-9]+}}, %[[PORT]]
// CHECK: %[[BREAK:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[BREAK]], %1
// CHECK: -> %[[RESULT]], state(%{{[0-9]+}})
