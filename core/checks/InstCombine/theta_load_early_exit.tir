// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A body leaving through `scf.break` never reaches its yield, so the break edge
// is where the slot's value leaves the loop. The carried port is fed on that
// edge, the read after the loop becomes the loop's result, and the slot leaves
// memory.

module {
  %fn_early = func.func @early(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %3 = state.entry_state
    | %4 = ptr.store %1, %2 | %3
    | %5 = scf.loop (| %6 = %4) {
      %7 | %8 = scf.switch %0 args(| %6) (| %9) {
        %10 = constant {value = 0} : !i1
        -> %10 | %9
      }
      (| %11) {
        | %12 = ptr.store %1, %2 | %11
        %13 = constant {value = 0} : !i1
        -> %13 | %12
      }
      -> %7 | %8, %8
    }
    %14 | %15 = ptr.load %2 | %5 : !i32
    -> %14 | %15
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @early
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = scf.loop (%[[PORT:[0-9]+]] = %1 | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK: -> %{{[0-9]+}}, %[[PORT]] | %{{[0-9]+}}
// CHECK: %[[BREAK:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[BREAK]], %1 | %{{[0-9]+}}
// CHECK: -> %[[RESULT]] | %{{[0-9]+}}
