// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// A body leaving through `scf.break` never reaches its yield, so the break edge
// is where the slot's value leaves the loop. The carried port is fed on that
// edge, the read after the loop becomes the loop's result, and the slot leaves
// memory.

module {
  func.func @early(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      ptr.store %1, %2
      scf.break %3
    }
    %4 = ptr.load %2 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: func.func @early
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%{{[0-9]+}} = %1) -> !i32 {
// CHECK: do scope(%[[SCOPE:[0-9]+]])(%{{[0-9]+}}) {
// CHECK-NEXT: scf.break %[[SCOPE]], %1
// CHECK: func.return %[[RESULT]]
