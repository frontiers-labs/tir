// RUN: tir opt --pass func.func(instcombine-nodes) %s | filecheck %s

// Inside `x == 7` the two classes are one, and extraction prefers the literal:
// every term over %x in that arm is a term over 7 and folds.

module {
  %fn_f = func.func @f(%x: !i32) -> !i32 {
    %seven = constant {value = 7} : !i32
    %hundred = constant {value = 100} : !i32
    %c = cmpi %x, %seven {predicate = "eq"} : !i1
    %r = scf.switch %c {
      -> %hundred
    }
    {
      %s = addi %x, %hundred : !i32
      -> %s
    }
    -> %r
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: scf.switch
// CHECK: }
// CHECK-NEXT: {
// CHECK-NEXT: constant {value = 107}
// CHECK-NOT: addi
