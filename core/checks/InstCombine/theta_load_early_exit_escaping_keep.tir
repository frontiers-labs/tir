// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The same reading holds of a loop left through a `break`: the slot's pointer is
// handed to a call, so the term graph does not see every access of it. No port
// grows, the exit carries no value, and the loop keeps reading memory.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !i32
  %fn_escapes = func.func @escapes(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      %4 = func.call %fn_sink(%2 : !ptr.p<!i32>) -> !i32
      ptr.store %4, %2
      scf.if %0 {
        scf.break %3
      } else {
        scf.yield
      }
      scf.yield
    }
    %5 = ptr.load %2 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @escapes
// CHECK: ptr.alloca
// CHECK: ptr.store
// CHECK: scf.while {
// CHECK: ptr.store
// CHECK: scf.break
// CHECK: ptr.load
