// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The same reading holds of a loop left through a `break`: the slot's pointer is
// handed to a call, so the term graph does not see every access of it. No port
// grows, the exit carries no value, and the loop keeps reading memory.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !i32
  %fn_escapes = func.func @escapes(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %3 = state.entry_state
    | %4 = ptr.store %1, %2 | %3
    | %5 = scf.loop (| %6 = %4) {
      %7 | %8 = scf.switch %0 args(| %6) (| %9) {
        %10 = constant {value = 0} : !i1
        -> %10 | %9
      }
      (| %11) {
        %12 | %13 = func.call %fn_sink(%2 : !ptr.p<!i32>) -> !i32 | %11
        | %14 = ptr.store %12, %2 | %13
        %15 = scf.switch %0 {
          %16 = constant {value = 1} : !i1
          -> %16
        }
        {
          %17 = constant {value = 0} : !i1
          -> %17
        }
        -> %15 | %14
      }
      -> %7 | %8, %8
    }
    %18 | %19 = ptr.load %2 | %5 : !i32
    -> %18 | %19
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @escapes
// CHECK: ptr.alloca
// CHECK: ptr.store
// CHECK: scf.loop
// CHECK: ptr.store
// CHECK: scf.switch
// CHECK: ptr.load
