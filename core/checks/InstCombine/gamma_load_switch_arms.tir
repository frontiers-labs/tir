// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The gate an n-ary switch publishes chooses between what each arm left, the
// default one included, so distributing the load reads each arm's own store and
// the port the commit grows carries the choice out. Nothing reads the slot
// afterwards, so the sweep takes the allocation and the stores with it.

module {
  %fn_pick = func.func @pick(%0: !i32, %1: !i32, %2: !i32, %3: !i32, %4: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %s0 = state.entry_state
    %s1 = ptr.store %4, %p state(%s0)
    %s2 = scf.switch %0 args(%s1) (%a) {
      %a1 = ptr.store %1, %p state(%a)
      -> %a1
    }
    (%b) {
      %b1 = ptr.store %2, %p state(%b)
      -> %b1
    }
    (%c) {
      %c1 = ptr.store %3, %p state(%c)
      -> %c1
    }
    %5, %s3 = ptr.load %p state(%s2) : !i32
    -> %5, %s3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @pick
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.switch %0 {
// CHECK-NEXT: -> %1
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %2
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %3
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]]
