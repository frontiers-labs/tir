// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The gate an n-ary switch publishes chooses between what each arm left, the
// default one included, so distributing the load reads each arm's own store and
// the port the commit grows carries the choice out. Nothing reads the slot
// afterwards, so the sweep takes the allocation and the stores with it.

module {
  %fn_pick = func.func @pick(%0: !i32, %1: !i32, %2: !i32, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.switch %0 case 1 {
      ptr.store %1, %4
      scf.yield
    }
    case 2 {
      ptr.store %2, %4
      scf.yield
    }
    default {
      ptr.store %3, %4
      scf.yield
    }
    %5 = ptr.load %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @pick
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.switch %0 -> !i32 case 1 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: case 2 {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK-NEXT: default {
// CHECK-NEXT: scf.yield %3
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
