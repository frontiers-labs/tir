// RUN: tir opt --pass func.func(promote,thread-state,instcombine) --verify %s | filecheck %s

// The slot's address never leaves the function, so it is a memory of its own and
// no call is on its chain: the first write is overwritten with nothing able to
// read it back, however much memory the call between them touches. The slot is
// then a value, and the call keeps the chain it does reach.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_g = func.declare @g() -> !unit
  %fn_f = func.func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    func.call %fn_g()
    ptr.store %1, %2
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.
// CHECK: func.call
// CHECK-NEXT: func.return %2
