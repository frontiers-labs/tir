// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

// A pointer's width is a data layout fact and nothing else. Where no layout is
// in scope, an access of one covers an extent no term can spell, so it stays
// unseeded and the chain around it is left alone.

module {
  %fn_f = func.func @f(%0: !ptr.p<!ptr.p<!i32>>, %1: !ptr.p<!i32>) -> !ptr.p<!i32> {
    | %2 = state.entry_state
    | %3 = ptr.store %1, %0 | %2
    %4 = ptr.load %0 | %3 : !ptr.p<!i32>
    func.return %4
  }
  module_end
}

// CHECK: func.func @f(%[[P:[0-9]+]]: !ptr.p<!ptr.p<!i32>>, %[[Q:[0-9]+]]: !ptr.p<!i32>)
// CHECK: | %[[S1:[0-9]+]] = ptr.store %[[Q]], %[[P]] | %[[S0:[0-9]+]]
// CHECK-NEXT: %[[V:[0-9]+]] = ptr.load %[[P]] | %[[S1]] : !ptr.p<!i32>
// CHECK-NEXT: -> %[[V]]
