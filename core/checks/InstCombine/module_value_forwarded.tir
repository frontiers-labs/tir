// RUN: tir opt --pass restructure-nodes,promote-nodes,instcombine-nodes %s | filecheck %s

// The module is one region, so a δ value is in scope at every use inside it:
// a store of one forwards to the load that reads it back, and the slot dies.

#data_layout = {endianness = "little", stack_alignment = 128, types = {i8 = {abi = 8, size = 8}, i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %message = global private @.L.str0 align 1 section ".rodata" bytes [104, 105, 0]
  %fn_f = func.func @f() -> !ptr.p {
    %0 = ptr.alloca {size = 8, align = 8} : !ptr.p
    ptr.store %message, %0
    %1 = ptr.load %0 : !ptr.p
    func.return %1
  }
  module_end
}

// CHECK: %[[MESSAGE:[0-9]+]] = global private @.L.str0
// CHECK-NOT: ptr.alloca
// CHECK: -> %[[MESSAGE]]
