// RUN: tir opt --pass instcombine %s | filecheck %s

// The stored value is a literal, which carries the type of the operation that
// holds it, so the load reads it like any other stored value.

module {
  func @f(%0: !ptr.p<!i32>) -> !i32 {
    %1 = state.entry_state : !state
    %2 = constant {value = 7} : !i32
    ptr.store %2, %0 state(%1 -> %3)
    %4 = ptr.load %0 : !i32 state(%3)
    return %4
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK: %[[V:[0-9]+]] = constant {value = 7}
// CHECK-NOT: ptr.load
// CHECK: return %[[V]]
