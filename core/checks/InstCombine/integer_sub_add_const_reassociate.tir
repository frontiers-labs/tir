// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @sub_add_const_reassociate_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = constant {value = 7} : !i8
    %b = constant {value = 3} : !i8
    %t = addi %x, %a : !i8
    %r = subi %t, %b : !i8
    func.return %r
  }
  %f32 = func.func @sub_add_const_reassociate_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = constant {value = 7} : !i32
    %b = constant {value = 3} : !i32
    %t = addi %x, %a : !i32
    %r = subi %t, %b : !i32
    func.return %r
  }
  %f64 = func.func @sub_add_const_reassociate_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = constant {value = 7} : !i64
    %b = constant {value = 3} : !i64
    %t = addi %x, %a : !i64
    %r = subi %t, %b : !i64
    func.return %r
  }
  module_end
}

