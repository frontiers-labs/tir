// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Only one arm of the switch writes the slot, so the read distributed into the
// others forwards from no store and stands for what the allocation holds. The
// copy is emitted once where that state is published — right after the
// allocation — and every arm that stores nothing yields it.

module {
  %fn_one = func.func @one(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.switch %0 case 1 {
      ptr.store %1, %2
      scf.yield
    }
    case 2 {
      scf.yield
    }
    default {
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @one
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: %[[UNINIT:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK-NEXT: %[[RESULT:[0-9]+]] = scf.switch %0 -> !i32 case 1 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: case 2 {
// CHECK-NEXT: scf.yield %[[UNINIT]]
// CHECK-NEXT: }
// CHECK-NEXT: default {
// CHECK-NEXT: scf.yield %[[UNINIT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
// CHECK-NOT: ptr.store
