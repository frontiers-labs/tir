// RUN: tir opt --pass fixpoint<4>(func.func(eqsat,control-simplify,dce)) --verify %s | filecheck %s

// Only the taken edge of the retested condition can supply the merge value.

module {
  %fn_f = func.func @f(%a: !i32, %b: !i32) -> !i32 {
    %0 = cmpi %a, %b {predicate = "eq"} : !i1
    %1 = constant {value = 1} : !i32
    %2 = constant {value = 2} : !i32
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    cfg.cond_br %0, ^bb3(%1 : !i32), ^bb3(%2 : !i32)
  ^bb2:
    func.return %a
  ^bb3(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[A:[0-9]+]]: !i32, %{{[0-9]+}}: !i32)
// CHECK: ^bb2:
// CHECK-NEXT: func.return %[[A]]
// CHECK: ^bb3(%{{[0-9]+}}: !i32):
// CHECK-NEXT: %[[C:[0-9]+]] = constant {value = 1} : !i32
// CHECK-NEXT: func.return %[[C]]
