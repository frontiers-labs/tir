// RUN: tir opt --pass func.func(restructure,instcombine) --verify %s | filecheck %s

// The arm is entered only when the condition holds, so the same condition
// re-tested inside it decides its own gate: the inner gate takes the arm the
// fact selects and its class is the literal that arm yields.

module {
  %fn_f = func.func @f(%a: !i32, %b: !i32) -> !i32 {
    %0 = cmpi %a, %b {predicate = "eq"} : !i1
    %1 = constant {value = 1} : !i32
    %2 = constant {value = 2} : !i32
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    cfg.cond_br %0, ^bb3(%1 : !i32), ^bb3(%2 : !i32)
  ^bb2:
    func.return %a
  ^bb3(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: scf.if
// CHECK-NEXT: %[[C:[0-9]+]] = constant {value = 1} : !i32
// CHECK: scf.yield %[[C]]
