// RUN: tir opt --pass func.func(promote,thread-state,instcombine) --verify %s | filecheck %s

// Three writes to one address, alternating values. Law S2 rebuilds each write
// over the state the one before it took, so the chain shortens a link at a time
// until only the last write is left, on the state the function was entered with.
// What it stores is what the function must be left holding.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @thrice(%1: !ptr.p) {
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 1} : !i32
    ptr.store %2, %1
    ptr.store %3, %1
    ptr.store %2, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @thrice
// CHECK: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0}
// CHECK-NEXT: | %[[LAST:[0-9]+]] = ptr.store %[[ZERO]], %{{[0-9]+}} | %[[ENTRY]]
// CHECK-NEXT: func.return | %[[LAST]]
