// RUN: tir opt --pass func.func(memopt,dce) --verify %s | filecheck %s

// The last of three writes to one address determines the externally visible value.

#layout_spec = #layout.spec<!i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %0 = func.func @thrice(%1: !ptr.p) {
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 1} : !i32
    ptr.store %2, %1
    ptr.store %3, %1
    ptr.store %2, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @thrice
// CHECK-NOT: ptr.store
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0}
// CHECK-NEXT: ptr.store %[[ZERO]], %{{[0-9]+}}
// CHECK-NEXT: func.return
