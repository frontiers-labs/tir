// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Two slots a gate writes one apiece: each arm holds the other's value, and both
// updates fold to the same literal, so the two gates the loads distribute into
// share a class. A class is one term but the values holding it are spread over
// the tree, and the form a bottom-up extraction picks may sit in the arm that
// cannot see it — the arm answers with a form of the class it can spell, and
// both slots leave memory.

module {
  func.func @cross(%0: !i1) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    ptr.store %3, %1
    ptr.store %3, %2
    scf.if %0 {
      %4 = ptr.load %1 : !i32
      %5 = constant {value = 1} : !i32
      %6 = addi %4, %5 : !i32
      ptr.store %6, %1
      scf.yield
    } else {
      %7 = ptr.load %2 : !i32
      %8 = constant {value = 1} : !i32
      %9 = addi %7, %8 : !i32
      ptr.store %9, %2
      scf.yield
    }
    %10 = ptr.load %1 : !i32
    %11 = ptr.load %2 : !i32
    %12 = addi %10, %11 : !i32
    func.return %12
  }
  module_end
}

// CHECK-LABEL: func.func @cross
// CHECK-NOT: ptr.
// CHECK: %[[LEFT:[0-9]+]], %[[RIGHT:[0-9]+]] = scf.if %0 -> !i32, !i32 {
// CHECK: %[[THEN_ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK: scf.yield %{{[0-9]+}}, %[[THEN_ZERO]]
// CHECK: %[[ELSE_ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK: scf.yield %[[ELSE_ZERO]], %{{[0-9]+}}
// CHECK: addi %[[LEFT]], %[[RIGHT]]
