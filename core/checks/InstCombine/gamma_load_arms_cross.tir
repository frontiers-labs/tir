// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Two slots a gate writes one apiece. Each becomes a port of the gate: the arm
// that writes yields what it wrote, and the arm that leaves the slot alone
// yields the value it held before the gate. Both slots leave memory.

module {
  %fn_cross = func.func @cross(%0: !i1) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    | %s0 = state.entry_state
    | %s1 = ptr.store %3, %1 | %s0
    | %s2 = ptr.store %3, %2 | %s1
    | %s3 = scf.switch %0 args(| %s2) (| %e) {
      %7 | %e1 = ptr.load %2 | %e : !i32
      %8 = constant {value = 1} : !i32
      %9 = addi %7, %8 : !i32
      | %e2 = ptr.store %9, %2 | %e1
      -> | %e2
    }
    (| %t) {
      %4 | %t1 = ptr.load %1 | %t : !i32
      %5 = constant {value = 1} : !i32
      %6 = addi %4, %5 : !i32
      | %t2 = ptr.store %6, %1 | %t1
      -> | %t2
    }
    %10 | %s4 = ptr.load %1 | %s3 : !i32
    %11 | %s5 = ptr.load %2 | %s4 : !i32
    %12 = addi %10, %11 : !i32
    -> %12 | %s5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @cross
// CHECK-NOT: ptr.
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK: %[[LEFT:[0-9]+]], %[[RIGHT:[0-9]+]] | %{{[0-9]+}} = scf.switch %0 args(| %{{[0-9]+}}) (| %[[EA:[0-9]+]]) {
// CHECK: -> %[[ZERO]], %{{[0-9]+}} | %[[EA]]
// CHECK: (| %[[TA:[0-9]+]]) {
// CHECK: -> %{{[0-9]+}}, %[[ZERO]] | %[[TA]]
// CHECK: addi %[[LEFT]], %[[RIGHT]]
