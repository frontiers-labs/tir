// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Two slots a gate writes one apiece. Each becomes a port of the gate: the arm
// that writes yields what it wrote, and the arm that leaves the slot alone
// yields the value it held before the gate. Both slots leave memory.

module {
  %fn_cross = func.func @cross(%0: !i1) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    ptr.store %3, %1
    ptr.store %3, %2
    scf.if %0 {
      %4 = ptr.load %1 : !i32
      %5 = constant {value = 1} : !i32
      %6 = addi %4, %5 : !i32
      ptr.store %6, %1
      scf.yield
    } else {
      %7 = ptr.load %2 : !i32
      %8 = constant {value = 1} : !i32
      %9 = addi %7, %8 : !i32
      ptr.store %9, %2
      scf.yield
    }
    %10 = ptr.load %1 : !i32
    %11 = ptr.load %2 : !i32
    %12 = addi %10, %11 : !i32
    func.return %12
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @cross
// CHECK-NOT: ptr.
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK: %[[LEFT:[0-9]+]], %[[RIGHT:[0-9]+]] = scf.if %0 -> !i32, !i32 {
// CHECK: scf.yield %{{[0-9]+}}, %[[ZERO]]
// CHECK: else {
// CHECK: scf.yield %[[ZERO]], %{{[0-9]+}}
// CHECK: addi %[[LEFT]], %[[RIGHT]]
