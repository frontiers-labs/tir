// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// The gate's decision is a literal, so the gate publishes what the arm that
// literal selects yields, however overdefined the other arm is.

module {
  %fn_f = func.func @f(%a: !i32) -> !i32 {
    %0 = constant {value = 1} : !i1
    %1 = constant {value = 9} : !i32
    %2 = scf.switch %0 args(%1) (%6) {
      -> %a
    }
    (%3) {
      %4 = constant {value = 4} : !i32
      %5 = addi %3, %4 : !i32
      -> %5
    }
    -> %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[C:[0-9]+]] = constant {value = 13} : !i32
// CHECK: -> %[[C]]
