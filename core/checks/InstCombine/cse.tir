// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

// Two structurally identical ops hash-cons into one e-class, so the redundant second
// computation is eliminated.

module {
  %fn_cse = func.func @cse(%x: !i32) -> !i16 {
    %0 = trunci %x : !i16
    %1 = trunci %x : !i16
    func.return %0
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @cse
// CHECK: trunci
// CHECK-NOT: trunci
