// RUN: tir opt --pass func.func(instcombine-nodes) %s | filecheck %s

// Both arms of the gate yield the same value, so its result (a gamma gate) folds to
// that value regardless of the condition, and the gate carrying nothing is swept.

module {
  %fn_f = func.func @f(%c: !i1, %k: !i32) -> !i32 {
    %r = scf.switch %c {
      -> %k
    }
    {
      -> %k
    }
    -> %r
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%{{[0-9]+}}: !i1, %[[K:[0-9]+]]: !i32)
// CHECK-NOT: scf.switch
// CHECK: -> %[[K]]
