// RUN: tir opt --pass promote --pass thread-state --pass instcombine --verify %s | filecheck %s

// An arm writes the slot from inside a region that is neither a conditional nor
// a loop. Nothing says what leaves such a region, so no chain is threaded
// through the function at all — the reads name no state, are no memory terms,
// and the law has nothing to distribute. The slot stays in memory.

module {
  %fn_opaque = func.func @opaque(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    scf.if %0 {
      module {
        ptr.store %2, %3
        module_end
      }
      scf.yield
    } else {
      scf.yield
    }
    %4 = ptr.load %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @opaque
// CHECK: ptr.store %1, %[[SLOT:[0-9]+]]
// CHECK: scf.if %0 {
// CHECK: ptr.store %2, %[[SLOT]]
// CHECK: %[[RESULT:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK: func.return %[[RESULT]]
