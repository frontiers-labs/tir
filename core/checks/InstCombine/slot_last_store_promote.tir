// RUN: tir opt --pass restructure-nodes,promote-nodes,instcombine-nodes --verify %s | filecheck %s

// A slot written twice: the second store covers the extent the first one wrote
// and nothing reads the state between them, so the first store is not there to
// be read and the load takes the value the second wrote.

module {
  %fn_twostores = func.func @twostores(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    ptr.store %1, %2
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK: func.func @twostores(%{{[0-9]+}}: !i32, %[[B:[0-9]+]]: !i32)
// CHECK-NOT: ptr.
// CHECK: -> %[[B]]
