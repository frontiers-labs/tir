// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The shape a structured early func.return out of a loop leaves behind: the
// func.return value written under a guard, the flag tested right after, and an
// `scf.break` leaving the loop when it is raised. Both slots become ports of the
// loop, the gate carries them out of the arm that writes, and the break carries
// both out of the loop.
//
// The value slot is never written before the loop, so what it carries in is a
// read of what it holds there, and that slot stays in memory around the promoted
// value.

module {
  %fn_find = func.func @find(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 1, align = 1} : !ptr.p<!i1>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = constant {value = 0} : !i1
    ptr.store %4, %2
    scf.while {
      scf.condition %0
    } do scope(%5) {
      scf.if %0 {
        ptr.store %1, %3
        %6 = constant {value = 1} : !i1
        ptr.store %6, %2
        scf.yield
      } else {
        scf.yield
      }
      %7 = ptr.load %2 : !i1
      scf.if %7 {
        scf.break %5
      } else {
        scf.yield
      }
      scf.yield
    }
    %8 = ptr.load %3 : !i32
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @find
// CHECK-NOT: ptr.alloca {size = 1
// CHECK: %[[INIT:[0-9]+]] = ptr.load %3 : !i32
// CHECK: %{{[0-9]+}}, %[[RESULT:[0-9]+]] = scf.while iter_args(%{{[0-9]+}} = %4, %{{[0-9]+}} = %[[INIT]]) -> !i1, !i32 {
// CHECK: do scope(%[[SCOPE:[0-9]+]])(%[[FLAG:[0-9]+]], %[[VALUE:[0-9]+]]) {
// CHECK: %[[SET:[0-9]+]], %[[TAKEN:[0-9]+]] = scf.if %0 -> !i1, !i32 {
// CHECK: scf.yield %[[FLAG]], %[[VALUE]]
// CHECK: scf.break %[[SCOPE]], %[[SET]], %[[TAKEN]]
// CHECK: scf.yield %[[SET]], %[[TAKEN]]
// CHECK: func.return %[[RESULT]]
