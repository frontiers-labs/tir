// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @shl_wide_8(%x: !i8) -> !i8 {
    %a = constant {value = 8} : !i8
    %r = shli %x, %a : !i8
    func.return %r
  }
  %f32 = func.func @shl_wide_32(%x: !i32) -> !i32 {
    %a = constant {value = 32} : !i32
    %r = shli %x, %a : !i32
    func.return %r
  }
  %f64 = func.func @shl_wide_64(%x: !i64) -> !i64 {
    %a = constant {value = 64} : !i64
    %r = shli %x, %a : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @shl_wide_8(%[[X8:[0-9]+]]: !i8)
// CHECK-NOT: shli
// CHECK: %[[R8:[0-9]+]] = constant {value = 0} : !i8
// CHECK-NOT: shli
// CHECK: -> %[[R8]]
// CHECK-LABEL: func.func @shl_wide_32(%[[X32:[0-9]+]]: !i32)
// CHECK-NOT: shli
// CHECK: %[[R32:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NOT: shli
// CHECK: -> %[[R32]]
// CHECK-LABEL: func.func @shl_wide_64(%[[X64:[0-9]+]]: !i64)
// CHECK-NOT: shli
// CHECK: %[[R64:[0-9]+]] = constant {value = 0} : !i64
// CHECK-NOT: shli
// CHECK: -> %[[R64]]
