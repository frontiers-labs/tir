// RUN: tir opt --pass func.func(promote,thread-state,instcombine) --verify %s | filecheck %s

// A fresh allocation is nothing else, so the two slots are two memories: the
// write to the second is not on the first's chain at all, and the write that
// overwrites the first leaves the state it was handed. Every access of both
// slots is whole and local, so promotion carries their values and no memory is
// left for the writes to name.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i32, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %3
    ptr.store %1, %4
    ptr.store %2, %3
    %5 = ptr.load %3 : !i32
    %6 = ptr.load %4 : !i32
    %7 = addi %5, %6 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.
// CHECK: %[[SUM:[0-9]+]] = addi %2, %1 : !i32
// CHECK-NEXT: func.return %[[SUM]]
