// RUN: tir opt --pass fixpoint<3>(func.func(memopt,dce)) --verify %s | filecheck %s

// Each private slot is bounded and its stored values are defined.

#layout_spec = #layout.spec<!i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_f = func.func @f(%0: !i32, %1: !i32, %2: !i32) -> !i32 {
    %defined_0 = freeze %0 : !i32
    %defined_1 = freeze %1 : !i32
    %defined_2 = freeze %2 : !i32
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %defined_0, %3
    ptr.store %defined_1, %4
    ptr.store %defined_2, %3
    %5 = ptr.load %3 : !i32
    %6 = ptr.load %4 : !i32
    %7 = addi %5, %6 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: func.func @f(
// CHECK-NOT: ptr.
// CHECK: %[[B:[0-9]+]] = freeze
// CHECK-NEXT: %[[C:[0-9]+]] = freeze
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[C]], %[[B]]
// CHECK-NEXT: func.return %[[SUM]]
