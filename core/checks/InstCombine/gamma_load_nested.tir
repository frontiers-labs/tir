// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Distributing a read into an arm leaves a read of that arm's state, which is a
// gate of its own where the arm holds one: the law names the operation rebuilding
// the read it introduced just as a seeded read names the one it was read from, so
// it fires again and the inner gate grows a port too.

module {
  %fn_nested = func.func @nested(%0: !i1, %1: !i1, %2: !i32, %3: !i32, %4: !i32, %5: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %s0 = state.entry_state
    | %s1 = ptr.store %5, %p | %s0
    | %s2 = scf.switch %0 args(| %s1) (| %e) {
      | %e1 = ptr.store %4, %p | %e
      -> | %e1
    }
    (| %t) {
      | %t1 = scf.switch %1 args(| %t) (| %ie) {
        | %ie1 = ptr.store %3, %p | %ie
        -> | %ie1
      }
      (| %it) {
        | %it1 = ptr.store %2, %p | %it
        -> | %it1
      }
      -> | %t1
    }
    %6 | %s3 = ptr.load %p | %s2 : !i32
    -> %6 | %s3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @nested
// CHECK-NOT: ptr.
// CHECK: %[[OUTER:[0-9]+]] | %{{[0-9]+}} = scf.switch %0 args(| %{{[0-9]+}}) (| %[[EA:[0-9]+]]) {
// CHECK-NEXT: -> %4 | %[[EA]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[TA:[0-9]+]]) {
// CHECK-NEXT: %[[INNER:[0-9]+]] | %[[TD:[0-9]+]] = scf.switch %1 args(| %[[TA]]) (| %[[IEA:[0-9]+]]) {
// CHECK-NEXT: -> %3 | %[[IEA]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[ITA:[0-9]+]]) {
// CHECK-NEXT: -> %2 | %[[ITA]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[INNER]] | %[[TD]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[OUTER]]
