// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Distributing a read into an arm leaves a read of that arm's state, which is a
// gate of its own where the arm holds one: the law names the operation rebuilding
// the read it introduced just as a seeded read names the one it was read from, so
// it fires again and the inner gate grows a port too.

module {
  func.func @nested(%0: !i1, %1: !i1, %2: !i32, %3: !i32, %4: !i32) -> !i32 {
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      scf.if %1 {
        ptr.store %2, %5
        scf.yield
      } else {
        ptr.store %3, %5
        scf.yield
      }
      scf.yield
    } else {
      ptr.store %4, %5
      scf.yield
    }
    %6 = ptr.load %5 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: func.func @nested
// CHECK-NOT: ptr.
// CHECK: %[[OUTER:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: %[[INNER:[0-9]+]] = scf.if %1 -> !i32 {
// CHECK-NEXT: scf.yield %2
// CHECK: else {
// CHECK-NEXT: scf.yield %3
// CHECK: scf.yield %[[INNER]]
// CHECK: else {
// CHECK-NEXT: scf.yield %4
// CHECK: func.return %[[OUTER]]
