// RUN: tir opt --pass instcombine %s | filecheck %s

// The call observes the state the first store published, so the second store
// does not overwrite it unobserved.

module {
  %fn_g = func.declare @g() -> !unit
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) {
    | %3 = state.entry_state
    | %4 = ptr.store %1, %0 | %3
    | %5 = func.call %fn_g() | %4
    | %6 = ptr.store %2, %0 | %5
    func.return | %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.store %2,
// CHECK: ptr.store %3,
