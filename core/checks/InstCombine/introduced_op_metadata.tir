// RUN: env TIR_SAT_TRACE=1 tir opt --pass restructure-nodes,instcombine-nodes --verify %s 2>&1 | filecheck %s

module {
  %add = func.func @reversed_add(%z: !i32, %y: !i32, %x: !i32) -> !i32 {
    %xy = addi %x, %y : !i32
    %zy = subi %z, %y : !i32
    %result = addi %xy, %zy : !i32
    func.return %result
  }
  %mul = func.func @reassociated_mul(%x: !i32) -> !i32 {
    %two = constant {value = 2} : !i32
    %three = constant {value = 3} : !i32
    %first = muli %x, %two : !i32
    %result = muli %first, %three : !i32
    func.return %result
  }
  module_end
}

// An op a rule introduces has the laws its declarations give a seeded one, and
// the carrier its type is.
// CHECK: kind: Ir(IrOp { dialect: "builtin", name: "addi", attrs: [], commutative: true, cost: 1, law: Some(Add){{.*}}prov: Introduced{{.*}}carrier: Some(Carrier { width: 32, key: 32 }) } [0, 2]
// CHECK: kind: Ir(IrOp { dialect: "builtin", name: "muli", attrs: [], commutative: true, cost: 4, law: None{{.*}}prov: Introduced
