// RUN: tir opt --pass fixpoint<3>(func.func(eqsat)) --verify %s | filecheck %s

module {
  %fu = func.func @udiv_one(%x: !i32) -> !i32 {
    %one = constant {value = 1} : !i32
    %r = divui %x, %one : !i32
    func.return %r
  }
  %fs = func.func @sdiv_one(%x: !i32) -> !i32 {
    %one = constant {value = 1} : !i32
    %r = divsi %x, %one : !i32
    func.return %r
  }
  %fur = func.func @urem_one(%x: !i32) -> !i32 {
    %one = constant {value = 1} : !i32
    %defined = freeze %x : !i32
    %r = remui %defined, %one : !i32
    func.return %r
  }
  %fsr = func.func @srem_one(%x: !i32) -> !i32 {
    %one = constant {value = 1} : !i32
    %defined = freeze %x : !i32
    %r = remsi %defined, %one : !i32
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @udiv_one(%[[UX:[0-9]+]]: !i32)
// CHECK-NOT: divui
// CHECK: func.return %[[UX]]

// CHECK-LABEL: func.func @sdiv_one(%[[SX:[0-9]+]]: !i32)
// CHECK-NOT: divsi
// CHECK: func.return %[[SX]]

// CHECK-LABEL: func.func @urem_one
// CHECK-NOT: remui
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NEXT: func.return %[[ZERO]]

// CHECK-LABEL: func.func @srem_one
// CHECK-NOT: remsi
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NEXT: func.return %[[ZERO]]
