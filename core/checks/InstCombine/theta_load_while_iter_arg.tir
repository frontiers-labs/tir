// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// A `scf.while` reads what it carries in its condition region and forwards it to
// the body, so the port the commit grows enters both: the condition passes its
// argument on, and the body yields the update the θ's latch names.

module {
  func.func @spin(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do {
      %3 = ptr.load %2 : !i32
      %4 = addi %3, %3 : !i32
      ptr.store %4, %2
      scf.yield
    }
    %5 = ptr.load %2 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: func.func @spin
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%[[COND:[0-9]+]] = %1) -> !i32 {
// CHECK-NEXT: scf.condition %0, %[[COND]]
// CHECK-NEXT: }
// CHECK-NEXT: do(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[BODY]], %[[BODY]] : !i32
// CHECK-NEXT: scf.yield %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
