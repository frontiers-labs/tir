// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The break leaves on a state the loop's latch does not name: the slot holds 1
// where the body breaks and 0 where it comes round again, so the value the loop
// leaves is neither the one it carries at the head nor a constant. Each exit
// carries the value reaching it and the port merges them — spelled with the
// constants before the loop, which are loop-invariant, rather than rebuilt on
// every iteration.

module {
  %fn_escape = func.func @escape(%0: !i1, %1: !i1) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 1} : !i32
    | %5 = state.entry_state
    | %6 = ptr.store %3, %2 | %5
    | %7 = scf.loop (| %8 = %6) {
      %9 | %10 = scf.switch %0 args(| %8) (| %11) {
        %12 = constant {value = 0} : !i1
        -> %12 | %11
      }
      (| %13) {
        | %14 = ptr.store %4, %2 | %13
        %15 | %16 = scf.switch %1 args(| %14) (| %17) {
          | %18 = ptr.store %3, %2 | %17
          %19 = constant {value = 1} : !i1
          -> %19 | %18
        }
        (| %20) {
          %21 = constant {value = 0} : !i1
          -> %21 | %20
        }
        -> %15 | %16
      }
      -> %9 | %10, %10
    }
    %22 | %23 = ptr.load %2 | %7 : !i32
    -> %22 | %23
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @escape
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = scf.loop (%{{[0-9]+}} = %3 | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK: scf.switch %1
// CHECK: %[[GO:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT: -> %[[GO]], %3 | %{{[0-9]+}}
// CHECK: %[[STOP:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[STOP]], %4 | %{{[0-9]+}}
// CHECK: -> %[[RESULT]] | %{{[0-9]+}}
