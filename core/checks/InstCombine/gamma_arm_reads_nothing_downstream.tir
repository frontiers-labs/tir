// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// Under the first arm's fact `%2` is `%1`, so the enclosing `%9 = %2 + 1` is
// the reference `%1 + 1` that arm computes. `%9` reads the gamma, and an arm
// reading it would close a dependency cycle, so the arm spells `%1 + 1`
// itself.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2, %3 = scf.switch %0 {
      %4 = constant {value = -1} : !i32
      %5 = subi %1, %4 : !i32
      -> %1, %5
    }
    {
      %6 = constant {value = 2} : !i32
      %7 = addi %1, %6 : !i32
      -> %7, %1
    }
    %8 = constant {value = 1} : !i32
    %9 = addi %2, %8 : !i32
    %10 = muli %9, %3 : !i32
    -> %10
  }
  module_end
}

// CHECK-LABEL: func.func @f(%{{[0-9]+}}: !i1, %[[X:[0-9]+]]: !i32)
// CHECK: %[[R:[0-9]+]], %{{[0-9]+}} = scf.switch
// CHECK-NEXT: %[[ONE:[0-9]+]] = constant {value = 1} : !i32
// CHECK-NEXT: %[[INC:[0-9]+]] = addi %[[X]], %[[ONE]] : !i32
// CHECK-NEXT: -> %[[X]], %[[INC]]
// CHECK: addi %[[R]], %{{[0-9]+}} : !i32
