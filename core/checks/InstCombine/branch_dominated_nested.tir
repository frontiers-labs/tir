// RUN: tir opt --pass fixpoint<3>(eqsat) --verify %s | filecheck %s
// RUN: tir opt --pass fixpoint<3>(func.func(eqsat)) --verify %s | filecheck %s

module {
  %fn_nested = func.func @nested(%a: !i32, %b: !i32) -> !i1 {
    %c = cmpi %a, %b {predicate = "eq"} : !i1
    cfg.cond_br %c, ^bb1, ^bb2
  ^bb1:
    cfg.br ^bb3
  ^bb2:
    func.return %c
  ^bb3:
    %d = cmpi %a, %b {predicate = "eq"} : !i1
    func.return %d
  }
  module_end
}

// CHECK-LABEL: func.func @nested
// CHECK: %[[GUARD:[0-9]+]] = cmpi
// CHECK-NEXT: cfg.cond_br %[[GUARD]], ^bb1, ^bb2
// CHECK-NOT: cmpi
// CHECK: ^bb1:
// CHECK-NEXT: cfg.br ^bb3
// CHECK: ^bb2:
// CHECK-NEXT: %[[FALSE:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: func.return %[[FALSE]]
// CHECK: ^bb3:
// CHECK-NEXT: %[[TRUE:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT: func.return %[[TRUE]]
