// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The read a law distributes into an arm that stores nothing is emitted where
// the state it reads is published — here the allocation itself, since nothing
// has written when that arm is entered. Placing it at the consumer instead
// would put it after the store the second gate makes, which would then be a
// write something reads; published where it belongs, the slot is written by
// nobody's reckoning and both stores go.

module {
  %fn_stand_in = func.func @stand_in(%0: !i1, %1: !i1, %2: !i32, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      ptr.store %2, %4
      scf.yield
    } else {
      scf.yield
    }
    scf.if %1 {
      ptr.store %3, %4
      scf.yield
    } else {
      scf.yield
    }
    %5 = ptr.load %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @stand_in
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: %[[UNINIT:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK-NEXT: %[[FIRST:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: scf.yield %[[UNINIT]]
// CHECK-NEXT: }
// CHECK-NEXT: %[[SECOND:[0-9]+]] = scf.if %1 -> !i32 {
// CHECK-NEXT: scf.yield %3
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: scf.yield %[[FIRST]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[SECOND]]
// CHECK-NOT: ptr.store
