// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The shape a `do` loop leaves behind: the body, then a guard that repeats or
// leaves the loop. The arm that breaks never reaches the gate's continuation, so
// the gate leaves the state the other arm yields, the θ over it reads the body's
// write, and the break carries the value reaching it out of the loop.

module {
  %fn_countdown = func.func @countdown(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      %4 = ptr.load %2 : !i32
      %5 = addi %4, %4 : !i32
      ptr.store %5, %2
      scf.if %0 {
        scf.yield
      } else {
        scf.break %3
      }
      scf.yield
    }
    %6 = ptr.load %2 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @countdown
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%{{[0-9]+}} = %1) -> !i32 {
// CHECK: do scope(%[[SCOPE:[0-9]+]])(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[BODY]], %[[BODY]] : !i32
// CHECK: scf.break %[[SCOPE]], %[[NEXT]]
// CHECK: scf.yield %[[NEXT]]
// CHECK: func.return %[[RESULT]]
