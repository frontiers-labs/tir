// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s

// The second pointer store overwrites the extent the first one wrote and
// nothing reads the state between them, so the first store is dead.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !ptr.p<!ptr.p<!i32>>, %1: !ptr.p<!i32>, %2: !ptr.p<!i32>) {
    | %3 = state.entry_state
    | %4 = ptr.store %1, %0 | %3
    | %5 = ptr.store %2, %0 | %4
    func.return | %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[P:[0-9]+]]: {{.*}}, %[[A:[0-9]+]]: {{.*}}, %[[B:[0-9]+]]: {{.*}})
// CHECK-NOT: ptr.store %[[A]],
// CHECK: ptr.store %[[B]], %[[P]]
