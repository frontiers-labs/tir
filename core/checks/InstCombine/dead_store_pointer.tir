// RUN: tir opt --pass instcombine %s | filecheck %s

// The second pointer store overwrites the extent the first one wrote and
// nothing reads the state between them, so the first store is dead.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  func.func @f(%0: !ptr.p<!ptr.p<!i32>>, %1: !ptr.p<!i32>, %2: !ptr.p<!i32>) {
    %3 = state.entry_state : !state
    ptr.store %1, %0 state(%3 -> %4)
    ptr.store %2, %0 state(%4 -> %5)
    func.return state(%5)
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NOT: ptr.store %1,
// CHECK: ptr.store %2,
