// RUN: tir opt --pass func.func(instcombine-nodes) %s | filecheck %s

// Both arms enter the gate on one state and write one value to one address, so
// their stores are one term. The then arm overwrites it. That the else arm
// yields its state out of the gate does not save the overwritten write: law S2
// equates two memories and says nothing about what may observe either, so the
// arm keeps the write it ends on and the other arm keeps its own.

module {
  %fn_f = func.func @f(%0: !i1, %1: !ptr.p<!i32>, %2: !i32, %3: !i32) {
    | %4 = state.entry_state
    | %5 = scf.switch %0 args(| %4) (| %9) {
      | %10 = ptr.store %2, %1 | %9
      -> | %10
    }
    (| %6) {
      | %7 = ptr.store %2, %1 | %6
      | %8 = ptr.store %3, %1 | %7
      -> | %8
    }
    -> | %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: scf.switch
// CHECK-NEXT: ptr.store %2,
// CHECK-NEXT: ->
// CHECK: {
// CHECK: ptr.store %3,
// CHECK-NEXT: ->
