// RUN: tir opt --pass instcombine --verify %s | filecheck %s

// Nested loops, outermost first: the outer port is proved before the inner one
// is read, so the constant it carries is a constant of the base graph by the
// time the inner loop's own hypothesis asks what it is entered on. Both ports
// are proved, and the sum after the nest is the two literals.

module {
  %fn_f = func.func @f(%0: !index, %1: !index, %2: !index) -> !i32 {
    %3 = constant {value = 7} : !i32
    %4 = constant {value = 0} : !i32
    %5 = scf.for_legacy %0, %1, %2 iter_args(%6 = %3) -> !i32 {
      %7 = scf.for_legacy %0, %1, %2 iter_args(%8 = %6) -> !i32 {
        %9 = addi %8, %4 : !i32
        scf.yield %9
      }
      scf.yield %7
    }
    %10 = addi %5, %3 : !i32
    func.return %10
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[SEVEN:[0-9]+]] = constant {value = 7} : !i32
// CHECK-NOT: addi
// CHECK: %[[SUM:[0-9]+]] = constant {value = 14} : !i32
// CHECK: func.return %[[SUM]]
