// RUN: tir opt --pass func.func(promote,thread-state,instcombine) --verify %s | filecheck %s

// The read between the two writes names an address the graph cannot yet read
// back to the slot: its offset is a term that only folds to zero once
// store-to-load forwarding has answered the read that feeds it. Saturation is
// monotone and a law that fired cannot be taken back, so an extent the terms
// cannot place on the object being overwritten is one the law must assume names
// it. The first write therefore stays, and the read still answers with 42.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i64, %1: !i64) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %0, %3
    %4 = ptr.load %3 : !i64
    %5 = subi %4, %0 : !i64
    %6 = ptr.ptradd %2, %5 : !ptr.p<!i32>
    %7 = ptr.ptradd %2, %1 : !ptr.p<!i32>
    %8 = constant {value = 42} : !i32
    ptr.store %8, %7
    %9 = ptr.load %6 : !i32
    %10 = constant {value = 1} : !i32
    ptr.store %10, %2
    %11 = constant {value = 2} : !i32
    ptr.store %11, %2
    %12 = ptr.load %2 : !i32
    %13 = constant {value = 100} : !i32
    %14 = muli %9, %13 : !i32
    %15 = addi %14, %12 : !i32
    func.return %15
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.store %8, %7
// CHECK: %[[READ:[0-9]+]] | %{{[0-9]+}} = ptr.load %6 | %{{[0-9]+}} : !i32
// CHECK: muli %[[READ]]
