// RUN: tir opt --pass fixpoint<4>(func.func(eqsat)) --verify %s | filecheck %s

// The read after the first write names an address the graph cannot yet read
// back to the slot: its offset is a term that only folds to zero once
// store-to-load forwarding has answered the read that feeds it. Once it does,
// the address is the slot itself and the read reads the slot. The write before
// it lands at an offset nothing places, so it stays, and the read is left to
// the memory rather than answered with 42.

#layout_spec = #layout.spec<!i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %fn_f = func.func @f(%0: !i64, %1: !i64) -> !i32 {
    %defined = freeze %0 : !i64
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %defined, %3
    %4 = ptr.load %3 : !i64
    %5 = subi %4, %defined : !i64
    %6 = ptr.ptradd %2, %5 : !ptr.p<!i32>
    %7 = ptr.ptradd %2, %1 : !ptr.p<!i32>
    %8 = constant {value = 42} : !i32
    ptr.store %8, %7
    %9 = ptr.load %6 : !i32
    %10 = constant {value = 1} : !i32
    ptr.store %10, %2
    %11 = constant {value = 2} : !i32
    ptr.store %11, %2
    %12 = ptr.load %2 : !i32
    %13 = constant {value = 100} : !i32
    %14 = muli %9, %13 : !i32
    %15 = addi %14, %12 : !i32
    func.return %15
  }
  module_end
}

// CHECK-LABEL: func.func @f(%{{[0-9]+}}: !i64, %[[OFFSET:[0-9]+]]: !i64)
// CHECK-NEXT: %[[BASE:[0-9]+]] = ptr.alloca
// CHECK-NEXT: %[[SHIFTED:[0-9]+]] = ptr.ptradd %[[BASE]], %[[OFFSET]]
// CHECK-NEXT: %[[UNKNOWN:[0-9]+]] = constant {value = 42} : !i32
// CHECK-NEXT: ptr.store %[[UNKNOWN]], %[[SHIFTED]]
// CHECK-NEXT: %[[READ:[0-9]+]] = ptr.load %[[BASE]] : !i32
// CHECK: %[[SCALED:[0-9]+]] = muli %[[READ]],
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[SCALED]],
// CHECK-NEXT: func.return %[[SUM]]
