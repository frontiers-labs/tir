// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Only one arm stores. The other leaves the state it was handed, so the read
// distributed into it forwards from the store before the gate: each arm answers
// with a value, and the port carries the choice out.

module {
  %fn_one = func.func @one(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %s0 = state.entry_state
    | %s1 = ptr.store %1, %3 | %s0
    | %s2 = scf.switch %0 args(| %s1) (| %e) {
      -> | %e
    }
    (| %t) {
      | %t1 = ptr.store %2, %3 | %t
      -> | %t1
    }
    %4 | %s3 = ptr.load %3 | %s2 : !i32
    -> %4 | %s3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @one
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = scf.switch %0 args(| %{{[0-9]+}}) (| %[[EA:[0-9]+]]) {
// CHECK-NEXT: -> %1 | %[[EA]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[TA:[0-9]+]]) {
// CHECK-NEXT: -> %2 | %[[TA]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]]
