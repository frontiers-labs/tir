// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Only one arm stores. The other leaves the state it was handed, so the read
// distributed into it forwards from the store before the gate: each arm answers
// with a value, and the port carries the choice out.

module {
  %fn_one = func.func @one(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    scf.if %0 {
      ptr.store %2, %3
      scf.yield
    } else {
      scf.yield
    }
    %4 = ptr.load %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @one
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
