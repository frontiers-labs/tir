// RUN: tir opt --pass restructure-nodes,instcombine-nodes,verify-deps --verify %s | filecheck %s
// RUN: tir interp %s -f f --args=3 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | tir interp -f f --args=3 | filecheck %s --check-prefix=VALUE

// A loop whose values nothing reads but whose body writes memory: the read
// after it observes the state it leaves, so the loop is demanded and stays
// with its store, however unread its counter is. The slot is not promoted
// here, so the store is the effect that keeps the loop.

module {
  %fn_f = func.func @f(%n: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    cfg.br ^body(%zero : !i32)
  ^body(%i: !i32):
    ptr.store %i, %p
    %next = addi %i, %one : !i32
    %more = cmpi %next, %n {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body(%next : !i32), ^exit
  ^exit:
    %last = ptr.load %p : !i32
    func.return %last
  }
  module_end
}

// CHECK: func.func @f(%{{[0-9]+}}: !i32)
// CHECK: scf.loop
// CHECK: ptr.store
// CHECK: %[[V:[0-9]+]] | %[[S:[0-9]+]] = ptr.load
// CHECK: -> %[[V]] | %[[S]]

// VALUE: i32 2
