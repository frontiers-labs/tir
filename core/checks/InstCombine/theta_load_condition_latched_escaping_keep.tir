// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The same geometry over a slot whose pointer is handed to a call: the term
// graph does not see every access, so no port grows however the loop latches,
// and the loop keeps reading memory.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !i32
  %fn_escapes = func.func @escapes(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    %3 = scf.while {
      %4 = scf.if %0 -> !i1 {
        %5 = ptr.load %2 : !i32
        %6 = func.call %fn_sink(%2 : !ptr.p<!i32>) -> !i32
        %7 = addi %5, %6 : !i32
        ptr.store %7, %2
        %8 = constant {value = 1} : !i1
        scf.yield %8
      } else {
        %9 = constant {value = 0} : !i1
        scf.yield %9
      }
      scf.condition %4
    } do {
      scf.yield
    }
    %10 = ptr.load %2 : !i32
    func.return %10
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @escapes
// CHECK: ptr.alloca
// CHECK: ptr.store
// CHECK: scf.while
// CHECK: ptr.load
// CHECK: ptr.store
// CHECK: ptr.load
