// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @add_add_sub_cancel_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = addi %x, %y : !i8
    %b = subi %z, %y : !i8
    %r = addi %a, %b : !i8
    func.return %r
  }
  %f32 = func.func @add_add_sub_cancel_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = addi %x, %y : !i32
    %b = subi %z, %y : !i32
    %r = addi %a, %b : !i32
    func.return %r
  }
  %f64 = func.func @add_add_sub_cancel_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = addi %x, %y : !i64
    %b = subi %z, %y : !i64
    %r = addi %a, %b : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @add_add_sub_cancel_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NEXT: %[[R8:[0-9]+]] = addi %[[X8]], %[[Z8]] : !i8
// CHECK-NEXT: -> %[[R8]]
// CHECK-LABEL: func.func @add_add_sub_cancel_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32, %[[Z32:[0-9]+]]: !i32)
// CHECK-NEXT: %[[R32:[0-9]+]] = addi %[[X32]], %[[Z32]] : !i32
// CHECK-NEXT: -> %[[R32]]
// CHECK-LABEL: func.func @add_add_sub_cancel_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64, %[[Z64:[0-9]+]]: !i64)
// CHECK-NEXT: %[[R64:[0-9]+]] = addi %[[X64]], %[[Z64]] : !i64
// CHECK-NEXT: -> %[[R64]]
