// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s

// Restructuring turns the guarded edge into a gate, and the driver assumes the
// gate's condition inside the arm it guards. The redundant compare in that arm
// hash-conses with %c, whose class now carries the boolean constant, so it folds
// to `true`. The defining compare outside the gate (where %c is unknown) stays.

module {
  %fn_f = func.func @f(%a: !i32, %b: !i32) -> !i1 {
    %c = cmpi %a, %b {predicate = "eq"} : !i1
    cfg.cond_br %c, ^bb1, ^bb2
  ^bb1:
    %d = cmpi %a, %b {predicate = "eq"} : !i1
    func.return %d
  ^bb2:
    func.return %c
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[C:[0-9]+]] = cmpi
// CHECK-NOT: cmpi
// CHECK-NOT: scf.switch
// CHECK: -> %[[C]]
