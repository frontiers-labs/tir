// RUN: tir opt --pass restructure-nodes,promote-nodes,instcombine-nodes,verify-deps --verify %s | filecheck %s
// RUN: tir interp %s -f f --args=5 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,promote-nodes,instcombine-nodes %s | tir interp -f f --args=5 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes --shuffle-seed 3 %s | tir opt --pass promote-nodes,instcombine-nodes | tir interp -f f --args=5 | filecheck %s --check-prefix=VALUE

// Arithmetic identities over an unordered body: `x + 0` is `x`, `2 * 3` is 6,
// and the operations nothing reads afterwards are swept with the values they
// computed. The chain stays: the store and the load it feeds are demanded.

module {
  %fn_f = func.func @f(%x: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %zero = constant {value = 0} : !i32
    %two = constant {value = 2} : !i32
    %three = constant {value = 3} : !i32
    %a = addi %x, %zero : !i32
    %b = muli %two, %three : !i32
    %c = addi %a, %b : !i32
    ptr.store %c, %p
    %r = ptr.load %p : !i32
    func.return %r
  }
  module_end
}

// CHECK: func.func @f(%[[X:[0-9]+]]: !i32)
// CHECK-NOT: muli
// CHECK: %[[SIX:[0-9]+]] = constant {value = 6} : !i32
// CHECK: %[[C:[0-9]+]] = addi %[[X]], %[[SIX]] : !i32
// CHECK-NOT: addi
// CHECK: -> %[[C]] | %{{[0-9]+}}

// VALUE: i32 11
