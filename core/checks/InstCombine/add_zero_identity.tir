// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

module {
  func.func @f(%0: !i32) -> !i32 {
    %1 = constant {value = 0} : !i32
    %2 = addi %0, %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NOT: addi
// CHECK: func.return %0
