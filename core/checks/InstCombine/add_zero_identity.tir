// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = constant {value = 0} : !i32
    %2 = addi %0, %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[X:[0-9]+]]: !i32)
// CHECK-NOT: addi
// CHECK: -> %[[X]]
