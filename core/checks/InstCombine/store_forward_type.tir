// RUN: tir opt --pass instcombine %s | filecheck %s

// The extents agree but the types do not: forwarding would read the bits of a
// float as an integer.

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !f32) -> !i32 {
    | %2 = state.entry_state
    | %3 = ptr.store %1, %0 | %2
    %4 = ptr.load %0 | %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.load
