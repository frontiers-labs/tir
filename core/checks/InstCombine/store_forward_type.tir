// RUN: tir opt --pass instcombine %s | filecheck %s

// The extents agree but the types do not: forwarding would read the bits of a
// float as an integer.

module {
  func @f(%0: !ptr.p, %1: !f32) -> !i32 {
    %2 = state.entry_state : !state
    ptr.store %1, %0 state(%2 -> %3)
    %4 = ptr.load %0 : !i32 state(%3)
    return %4
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK: ptr.load
