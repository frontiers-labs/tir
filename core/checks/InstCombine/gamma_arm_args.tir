// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

// An arm's entry arguments are the inputs the gamma forwards into it, so
// `addi %3, 0` is the forwarded `%1`. Both arms then yield `%1` and the gamma
// folds to it.

module {
  func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = scf.if %0 args(%1) -> !i32 (%3) {
      %4 = constant {value = 0} : !i32
      %5 = addi %3, %4 : !i32
      scf.yield %5
    } else (%6) {
      scf.yield %6
    }
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @f(%{{[0-9]+}}: !i1, %[[X:[0-9]+]]: !i32)
// CHECK: func.return %[[X]]
