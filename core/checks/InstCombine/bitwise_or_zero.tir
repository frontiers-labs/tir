// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @or_zero_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = constant {value = 0} : !i8
    %r = ori %x, %a : !i8
    func.return %r
  }
  %f32 = func.func @or_zero_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = constant {value = 0} : !i32
    %r = ori %x, %a : !i32
    func.return %r
  }
  %f64 = func.func @or_zero_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = constant {value = 0} : !i64
    %r = ori %x, %a : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @or_zero_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NOT: addi
// CHECK-NOT: subi
// CHECK-NOT: muli
// CHECK-NOT: divui
// CHECK-NOT: divsi
// CHECK-NOT: remui
// CHECK-NOT: remsi
// CHECK-NOT: andi
// CHECK-NOT: ori
// CHECK-NOT: xori
// CHECK-NOT: shli
// CHECK-NOT: shrui
// CHECK-NOT: shrsi
