// RUN: tir opt --pass promote --pass thread-state --pass instcombine --verify %s | filecheck %s

// A slot holding a pointer promotes like any other, since the data layout gives
// the pointer the width the access terms need. The gate grows the port carrying
// what each arm stored, and the port is spelled at the pointer type the accesses
// agree on.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_uniform = func.func @uniform(%0: !i1, %1: !ptr.p, %2: !ptr.p) -> !ptr.p {
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p
    scf.if %0 {
      ptr.store %1, %3
      scf.yield
    } else {
      ptr.store %2, %3
      scf.yield
    }
    %4 = ptr.load %3 : !ptr.p
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @uniform
// CHECK-NOT: ptr.alloca
// CHECK-NOT: ptr.store
// CHECK-NOT: ptr.load
// CHECK: %[[RESULT:[0-9]+]] = scf.if %0 -> !ptr.p {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
