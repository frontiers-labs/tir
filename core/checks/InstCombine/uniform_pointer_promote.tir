// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A slot holding a pointer promotes like any other, since the data layout gives
// the pointer the width the access terms need. The gate grows the port carrying
// what each arm stored, and the port is spelled at the pointer type the accesses
// agree on.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_uniform = func.func @uniform(%0: !i1, %1: !ptr.p, %2: !ptr.p, %3: !ptr.p) -> !ptr.p {
    %p = ptr.alloca {size = 8, align = 8} : !ptr.p
    state(%s0) = state.entry_state
    state(%s1) = ptr.store %3, %p state(%s0)
    state(%s2) = scf.switch %0 args(state(%s1)) (state(%e)) {
      state(%e1) = ptr.store %2, %p state(%e)
      -> state(%e1)
    }
    (state(%t)) {
      state(%t1) = ptr.store %1, %p state(%t)
      -> state(%t1)
    }
    %4, state(%s3) = ptr.load %p state(%s2) : !ptr.p
    -> %4, state(%s3)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @uniform
// CHECK-NOT: ptr.alloca
// CHECK-NOT: ptr.store
// CHECK-NOT: ptr.load
// CHECK: %[[RESULT:[0-9]+]] = scf.switch %0 {
// CHECK-NEXT: -> %2
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %1
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]]
