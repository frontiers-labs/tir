// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Pointer arithmetic does not let an address out of the function, so a slot only
// reached through it is still a memory of its own: its accesses get a chain the
// call cannot reach, and the read takes what the write left.

#data_layout = {types = {p = {abi = 64, size = 64}, i32 = {abi = 32}, i64 = {abi = 64}}}

module {data_layout = #data_layout} {
  %fn_g = func.declare @g() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %2 = constant {value = 0} : !i64
    %3 = ptr.ptradd %1, %2 : !ptr.p<!i32>
    ptr.store %0, %3
    func.call %fn_g()
    %4 = ptr.load %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.load
