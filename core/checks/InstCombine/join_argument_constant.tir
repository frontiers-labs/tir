// RUN: tir opt --pass func.func(restructure,instcombine) --verify %s | filecheck %s

// Every edge into the merge carries the same literal, so the value it merges is
// that literal however the branch goes. Restructuring makes the merge a gate
// whose arms both yield it, and the gate's own class is the literal's.

module {
  %fn_f = func.func @f(%c: !i1) -> !i32 {
    %0 = constant {value = 5} : !i32
    cfg.cond_br %c, ^bb1(%0 : !i32), ^bb2(%0 : !i32)
  ^bb1(%1: !i32):
    cfg.br ^bb3(%1 : !i32)
  ^bb2(%2: !i32):
    cfg.br ^bb3(%2 : !i32)
  ^bb3(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[C:[0-9]+]] = constant {value = 5} : !i32
// CHECK: func.return %[[C]]
