// RUN: tir opt --pass fixpoint<3>(func.func(eqsat)) --verify %s | filecheck %s

// Every edge into the merge carries the same literal, so the value it merges is
// that literal however the branch goes.

module {
  %fn_f = func.func @f(%c: !i1) -> !i32 {
    %0 = constant {value = 5} : !i32
    cfg.cond_br %c, ^bb1(%0 : !i32), ^bb2(%0 : !i32)
  ^bb1(%1: !i32):
    cfg.br ^bb3(%1 : !i32)
  ^bb2(%2: !i32):
    cfg.br ^bb3(%2 : !i32)
  ^bb3(%3: !i32):
    func.return %3
  }
  %fn_g = func.func @different(%c: !i1) -> !i32 {
    %0 = constant {value = 5} : !i32
    %other = constant {value = 7} : !i32
    cfg.cond_br %c, ^bb1(%0 : !i32), ^bb2(%other : !i32)
  ^bb1(%1: !i32):
    cfg.br ^bb3(%1 : !i32)
  ^bb2(%2: !i32):
    cfg.br ^bb3(%2 : !i32)
  ^bb3(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK: ^bb3(%{{[0-9]+}}: !i32):
// CHECK-NEXT: %[[FIVE:[0-9]+]] = constant {value = 5} : !i32
// CHECK-NEXT: func.return %[[FIVE]]
// CHECK-LABEL: func.func @different
// CHECK: ^bb3(%[[MERGE:[0-9]+]]: !i32):
// CHECK-NEXT: func.return %[[MERGE]]
