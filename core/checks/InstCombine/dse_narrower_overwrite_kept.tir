// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The two writes start at the same address, but the second covers four bytes of
// the eight the first wrote: the other four are still readable, so the wider
// write is not dead.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i64, %1: !i32) -> !i64 {
    %2 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %0, %2
    ptr.store %1, %2
    %3 = ptr.load %2 : !i64
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[W:[0-9]+]]: !i64, %[[N:[0-9]+]]: !i32)
// CHECK: %[[P:[0-9]+]] = ptr.alloca
// CHECK: | %[[S:[0-9]+]] = ptr.store %[[W]], %[[P]] | %{{[0-9]+}}
// CHECK-NEXT: | %{{[0-9]+}} = ptr.store %[[N]], %[[P]] | %[[S]]
