// RUN: tir opt --pass promote --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// A slot the body only reads: nothing inside the loop writes it, so every edge
// back into its state port carries the port's own argument and the θ over them
// is the state the loop was entered with. The read in the body is then the read
// of that state — the store before the loop forwards into it, and the slot
// leaves memory without the loop growing a port for it.

module {
  %fn_accumulate = func.func @accumulate(%0: !index, %1: !index, %2: !index, %3: !i32, %4: !i32) -> !i32 {
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %5
    %6 = scf.for %0, %1, %2 iter_args(%7 = %4) -> !i32 {
      %8 = ptr.load %5 : !i32
      %9 = addi %7, %8 : !i32
      scf.yield %9
    }
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @accumulate
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.for %0, %1, %2 iter_args(%[[CARRIED:[0-9]+]] = %4) -> !i32 {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[CARRIED]], %3 : !i32
// CHECK-NEXT: scf.yield %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
