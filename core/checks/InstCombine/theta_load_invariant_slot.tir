// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A slot the body only reads: nothing inside the loop writes it, so every edge
// back into its state port carries the port's own argument and the θ over them
// is the state the loop was entered with. The read in the body is then the read
// of that state — the store before the loop forwards into it, and the slot
// leaves memory without the loop growing a port for it.

module {
  %fn_accumulate = func.func @accumulate(%0: !i64, %1: !i64, %2: !i64, %3: !i32, %4: !i32) -> !i32 {
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %5
    %6 = scf.for_legacy %0, %1, %2 iter_args(%7 = %4) -> !i32 {
      %8 = ptr.load %5 : !i32
      %9 = addi %7, %8 : !i32
      scf.yield %9
    }
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @accumulate(%[[LB:[0-9]+]]: !i64, %[[UB:[0-9]+]]: !i64, %[[STEP:[0-9]+]]: !i64, %[[A:[0-9]+]]: !i32, %[[INIT:[0-9]+]]: !i32)
// CHECK-NOT: ptr.
// CHECK: %{{[0-9]+}}, %[[RESULT:[0-9]+]] | %[[OUT:[0-9]+]] = scf.for %{{[0-9]+}} = %[[LB]] to %[[UB]] step %[[STEP]] (%[[CARRIED:[0-9]+]] = %[[INIT]] | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[CARRIED]], %[[A]] : !i32
// CHECK-NEXT: -> %[[NEXT]] | %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]] | %[[OUT]]
