// RUN: tir opt --pass eqsat --verify %s | filecheck %s

// Freeze the discarded operand to state the defined-input contract.

module {
  %f8 = func.func @and_complement_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %defined = freeze %x : !i8
    %a = constant {value = -1} : !i8
    %b = xori %defined, %a : !i8
    %r = andi %defined, %b : !i8
    func.return %r
  }
  %f32 = func.func @and_complement_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %defined = freeze %x : !i32
    %a = constant {value = -1} : !i32
    %b = xori %defined, %a : !i32
    %r = andi %defined, %b : !i32
    func.return %r
  }
  %f64 = func.func @and_complement_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %defined = freeze %x : !i64
    %a = constant {value = -1} : !i64
    %b = xori %defined, %a : !i64
    %r = andi %defined, %b : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @and_complement_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NEXT: %[[R8:[0-9]+]] = constant {value = 0} : !i8
// CHECK-NEXT: func.return %[[R8]]
// CHECK-LABEL: func.func @and_complement_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32, %[[Z32:[0-9]+]]: !i32)
// CHECK-NEXT: %[[R32:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NEXT: func.return %[[R32]]
// CHECK-LABEL: func.func @and_complement_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64, %[[Z64:[0-9]+]]: !i64)
// CHECK-NEXT: %[[R64:[0-9]+]] = constant {value = 0} : !i64
// CHECK-NEXT: func.return %[[R64]]
