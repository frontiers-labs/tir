// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

// The store publishes a new state, so the second load reads a different one and
// is a different term. The difference must stay.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32) -> !i32 {
    | %2 = state.entry_state
    %3 | %4 = ptr.load %0 | %2 : !i32
    | %5 = ptr.store %1, %0 | %4
    %6 = ptr.load %0 | %5 : !i32
    %7 = subi %3, %6 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: subi
