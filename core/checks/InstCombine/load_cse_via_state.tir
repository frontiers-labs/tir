// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

// A read leaves memory as it found it, so the state it publishes is the one it
// read: both loads read one state at one address and are one term. Their
// difference is therefore zero, and the second load is dead.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>) -> !i32 {
    %1 = state.entry_state : !state
    %2 = ptr.load %0 : !i32 state(%1 -> %3)
    %4 = ptr.load %0 : !i32 state(%3)
    %5 = subi %2, %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: subi
// CHECK: func.return
