// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s

// A read leaves memory as it found it, so the state it publishes is the one it
// read: both loads read one state at one address and are one term. Their
// difference is therefore zero, and the second load is dead.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>) -> !i32 {
    | %1 = state.entry_state
    %2 | %3 = ptr.load %0 | %1 : !i32
    %4 = ptr.load %0 | %3 : !i32
    %5 = subi %2, %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: subi
// CHECK: ->
