// RUN: tir opt --pass promote --pass thread-state --pass instcombine --verify %s | filecheck %s

// Two slots written under one gate inside a loop. Each becomes a port of the
// loop: the arm that writes yields what it wrote, the arm that does not yields
// the port argument, and the condition's read of the flag is the argument it
// tests.
//
// The value slot is never written before the loop, so the value it carries in is
// a read of what the slot holds there, and the slot stays in memory around it.

module {
  %fn_find = func.func @find(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 1, align = 1} : !ptr.p<!i1>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = constant {value = 0} : !i1
    ptr.store %4, %2
    scf.while {
      %5 = ptr.load %2 : !i1
      scf.condition %5
    } do {
      scf.if %0 {
        ptr.store %1, %3
        %6 = constant {value = 1} : !i1
        ptr.store %6, %2
        scf.yield
      } else {
        scf.yield
      }
      scf.yield
    }
    %7 = ptr.load %3 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @find
// CHECK-NOT: ptr.alloca {size = 1
// CHECK: %[[INIT:[0-9]+]] = ptr.load %3 : !i32
// CHECK: %{{[0-9]+}}, %[[RESULT:[0-9]+]] = scf.while iter_args(%[[FLAG:[0-9]+]] = %4, %[[VALUE:[0-9]+]] = %[[INIT]]) -> !i1, !i32 {
// CHECK-NEXT: scf.condition %[[FLAG]], %[[FLAG]], %[[VALUE]]
// CHECK-NEXT: }
// CHECK-NEXT: do(%[[BODYFLAG:[0-9]+]], %[[BODY:[0-9]+]]) {
// CHECK-NEXT: %[[SET:[0-9]+]], %[[TAKEN:[0-9]+]] = scf.if %0 -> !i1, !i32 {
// CHECK: scf.yield %[[ONE:[0-9]+]], %1
// CHECK: else {
// CHECK-NEXT: scf.yield %[[BODYFLAG]], %[[BODY]]
// CHECK: scf.yield %[[SET]], %[[TAKEN]]
// CHECK: func.return %[[RESULT]]
