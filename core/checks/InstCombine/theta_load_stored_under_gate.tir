// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The laws compose. The state a loop carries is a θ whose latch is the gate the
// body ends on, so a read of the flag distributes over the θ, then over that
// gate, and store-to-load forwarding answers the arm that wrote — the arm that
// did not yields the carry itself, which inside the body is the port argument.
// The condition's read of the flag becomes the argument it tests.
//
// The value slot is never written before the loop, so the value it carries in is
// a read of what the slot holds there, and the slot stays in memory around it.

module {
  func.func @find(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 1, align = 1} : !ptr.p<!i1>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = constant {value = 0} : !i1
    ptr.store %4, %2
    scf.while {
      %5 = ptr.load %2 : !i1
      scf.condition %5
    } do {
      scf.if %0 {
        ptr.store %1, %3
        %6 = constant {value = 1} : !i1
        ptr.store %6, %2
        scf.yield
      } else {
        scf.yield
      }
      scf.yield
    }
    %7 = ptr.load %3 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: func.func @find
// CHECK-NOT: ptr.alloca {size = 1
// CHECK: %[[INIT:[0-9]+]] = ptr.load %3 : !i32
// CHECK: %[[RESULT:[0-9]+]], %{{[0-9]+}} = scf.while iter_args(%[[VALUE:[0-9]+]] = %[[INIT]], %[[FLAG:[0-9]+]] = %4) -> !i32, !i1 {
// CHECK-NEXT: scf.condition %[[FLAG]], %[[VALUE]], %[[FLAG]]
// CHECK-NEXT: }
// CHECK-NEXT: do(%[[BODY:[0-9]+]], %[[BODYFLAG:[0-9]+]]) {
// CHECK-NEXT: %[[TAKEN:[0-9]+]], %[[SET:[0-9]+]] = scf.if %0 -> !i32, !i1 {
// CHECK: scf.yield %1, %[[ONE:[0-9]+]]
// CHECK: else {
// CHECK-NEXT: scf.yield %[[BODY]], %[[BODYFLAG]]
// CHECK: scf.yield %[[TAKEN]], %[[SET]]
// CHECK: func.return %[[RESULT]]
