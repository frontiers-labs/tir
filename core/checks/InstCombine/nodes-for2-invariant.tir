// RUN: tir opt --pass restructure-nodes,instcombine-nodes,verify-deps --verify %s | filecheck %s
// RUN: tir interp %s -f f --args=3 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | tir interp -f f --args=3 | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes --shuffle-seed 3 %s | tir opt --pass instcombine-nodes | tir interp -f f --args=3 | filecheck %s --check-prefix=VALUE

// A counted loop carrying `7 + 0` round each iteration. The hypothesis proves
// the port constant, so every read of it folds; the loop's exit entry for the
// port stays the port, as a counted loop pins it, and the loop keeps counting.

module {
  %fn_f = func.func @f(%n: !i32) -> !i32 {
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    %seven = constant {value = 7} : !i32
    %r, %k = scf.for %zero, %n, %one iter_args(%iv = %zero, %c = %seven) -> !i32, !i32 {
      %w = addi %c, %zero : !i32
      %next = addi %iv, %one : !i32
      scf.yield %next, %w
    }
    %s = addi %k, %r : !i32
    func.return %s
  }
  module_end
}

// CHECK: func.func @f
// CHECK: %[[SEVEN:[0-9]+]] = constant {value = 7} : !i32
// CHECK: scf.for2 %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%{{[0-9]+}} = %{{[0-9]+}}, %{{[0-9]+}} = %[[SEVEN]] | {{.*}}) {
// CHECK: -> %{{[0-9]+}}, %[[SEVEN]] | %{{[0-9]+}}
// CHECK: }
// CHECK: addi %[[SEVEN]], %{{[0-9]+}}

// VALUE: i32 10
