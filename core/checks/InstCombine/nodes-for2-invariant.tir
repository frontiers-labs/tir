// RUN: tir opt --pass fixpoint<3>(func.func(eqsat)) --verify %s | filecheck %s

// A counted loop forwards 7 each iteration. Its body uses the square of that
// invariant while the other carry still changes on every iteration.

module {
  %fn_f = func.func @f(%n: !i32) -> !i32 {
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    %seven = constant {value = 7} : !i32
    %i1_end, %r, %k = scf.ordered_for %i1 = %zero to %n step %one (%iv = %zero, %c = %seven) {
      %square = muli %c, %c : !i32
      %next = addi %iv, %square : !i32
      %reset = constant {value = 7} : !i32
      scf.yield %next, %reset
    }
    %s = addi %k, %r : !i32
    func.return %s
  }
  module_end
}

// CHECK: func.func @f
// CHECK: %[[SEVEN:[0-9]+]] = constant {value = 7} : !i32
// CHECK: %{{[0-9]+}}, %[[SUM:[0-9]+]], %{{[0-9]+}} = scf.ordered_for {{.*}} (%[[ACC:[0-9]+]] = %{{[0-9]+}}, %[[PORT:[0-9]+]] = %[[SEVEN]]) {
// CHECK-NOT: muli
// CHECK: %[[SQUARE:[0-9]+]] = constant {value = 49} : !i32
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[ACC]], %[[SQUARE]] : !i32
// CHECK-NEXT: %[[RESET:[0-9]+]] = constant {value = 7} : !i32
// CHECK-NEXT: scf.yield %[[NEXT]], %[[RESET]]
// CHECK-NEXT: }
// CHECK-NEXT: %[[RESULT:[0-9]+]] = addi %[[SEVEN]], %[[SUM]] : !i32
// CHECK-NEXT: func.return %[[RESULT]]
