// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s

// State the defined-input condition for the operand the rewrite removes.

module {
  %f8 = func.func @sub_sub_left_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %defined = freeze %x : !i8
    %a = subi %defined, %y : !i8
    %r = subi %a, %defined : !i8
    func.return %r
  }
  %f32 = func.func @sub_sub_left_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %defined = freeze %x : !i32
    %a = subi %defined, %y : !i32
    %r = subi %a, %defined : !i32
    func.return %r
  }
  %f64 = func.func @sub_sub_left_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %defined = freeze %x : !i64
    %a = subi %defined, %y : !i64
    %r = subi %a, %defined : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @sub_sub_left_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NEXT: %[[C8_0:[0-9]+]] = constant {value = 0} : !i8
// CHECK-NEXT: %[[R8:[0-9]+]] = subi %[[C8_0]], %[[Y8]] : !i8
// CHECK-NEXT: func.return %[[R8]]
// CHECK-LABEL: func.func @sub_sub_left_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32, %[[Z32:[0-9]+]]: !i32)
// CHECK-NEXT: %[[C32_0:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NEXT: %[[R32:[0-9]+]] = subi %[[C32_0]], %[[Y32]] : !i32
// CHECK-NEXT: func.return %[[R32]]
// CHECK-LABEL: func.func @sub_sub_left_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64, %[[Z64:[0-9]+]]: !i64)
// CHECK-NEXT: %[[C64_0:[0-9]+]] = constant {value = 0} : !i64
// CHECK-NEXT: %[[R64:[0-9]+]] = subi %[[C64_0]], %[[Y64]] : !i64
// CHECK-NEXT: func.return %[[R64]]
