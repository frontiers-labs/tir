// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @sub_sub_left_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = subi %x, %y : !i8
    %r = subi %a, %x : !i8
    func.return %r
  }
  %f32 = func.func @sub_sub_left_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = subi %x, %y : !i32
    %r = subi %a, %x : !i32
    func.return %r
  }
  %f64 = func.func @sub_sub_left_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = subi %x, %y : !i64
    %r = subi %a, %x : !i64
    func.return %r
  }
  module_end
}

