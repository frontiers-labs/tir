// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// Two slots a loop swaps: each one's latch is the value the other holds, so
// growing the port for one asks for the other's while the first is still being
// fed. What each edge carries belongs to the port that asked for it, not to the
// port whose value happened to be spelled first — so the yield names them in the
// order the loop carries them, and the swap survives.

module {
  func.func @swap(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    ptr.store %2, %4
    scf.while {
      scf.condition %0
    } do {
      %5 = ptr.load %3 : !i32
      %6 = ptr.load %4 : !i32
      ptr.store %6, %3
      ptr.store %5, %4
      scf.yield
    }
    %7 = ptr.load %3 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: func.func @swap
// CHECK-NOT: ptr.
// CHECK: %[[LEFT:[0-9]+]], %{{[0-9]+}} = scf.while iter_args(%[[CI:[0-9]+]] = %1, %[[CJ:[0-9]+]] = %2) -> !i32, !i32 {
// CHECK-NEXT: scf.condition %0, %[[CI]], %[[CJ]]
// CHECK-NEXT: }
// CHECK-NEXT: do(%[[BI:[0-9]+]], %[[BJ:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[BJ]], %[[BI]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[LEFT]]
