// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Two slots a loop swaps: each one's latch is the value the other holds, so
// growing the port for one asks for the other's while the first is still being
// fed. What each edge carries belongs to the port that asked for it, not to the
// port whose value happened to be spelled first — so the yield names them in the
// order the loop carries them, and the swap survives.

module {
  %fn_swap = func.func @swap(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %5 = state.entry_state
    %6 = ptr.store %1, %3 state(%5)
    %7 = ptr.store %2, %4 state(%6)
    %8 = scf.loop (%9 = %7) {
      %10, %11 = scf.switch %0 args(%9) (%12) {
        %13 = constant {value = 0} : !i1
        -> %13, %12
      }
      (%14) {
        %15, %16 = ptr.load %3 state(%14) : !i32
        %17, %18 = ptr.load %4 state(%16) : !i32
        %19 = ptr.store %17, %3 state(%18)
        %20 = ptr.store %15, %4 state(%19)
        %21 = constant {value = 1} : !i1
        -> %21, %20
      }
      -> %10, %11, %11
    }
    %22, %23 = ptr.load %3 state(%8) : !i32
    -> %22, %23
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @swap
// CHECK-NOT: ptr.
// CHECK: %[[LEFT:[0-9]+]], %{{[0-9]+}} = scf.loop (%[[CI:[0-9]+]] = %1, %[[CJ:[0-9]+]] = %2) {
// CHECK: -> %{{[0-9]+}}, %[[CI]], %[[CJ]]
// CHECK: -> %{{[0-9]+}}, %[[CJ]], %[[CI]]
// CHECK: -> %[[LEFT]], %{{[0-9]+}}
