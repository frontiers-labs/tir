// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s

// No write reached this address before the load, so nothing stands in for its
// value and the read stays — with the state edge the store after it observes.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32) -> !i32 {
    state(%2) = state.entry_state
    %3, state(%4) = ptr.load %0 state(%2) : !i32
    state(%5) = ptr.store %1, %0 state(%4)
    func.return %3 state(%5)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[V:[0-9]+]], state(%[[S:[0-9]+]]) = ptr.load %[[P:[0-9]+]] state(%{{[0-9]+}}) : !i32
// CHECK: state(%{{[0-9]+}}) = ptr.store %{{[0-9]+}}, %[[P]] state(%[[S]])
// CHECK: -> %[[V]]
