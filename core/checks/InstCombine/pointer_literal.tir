// RUN: tir opt --pass func.func(instcombine-nodes) %s | filecheck %s

// Both arms agree on a pointer constant no value outside the gate holds: the
// commit writes null as a copy of the literal the function has, and a constant
// past null as null moved on.

#layout_spec = #layout.spec<!ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %f = func.func @same(%c: !i1) -> !ptr.p {
    %r = scf.switch %c {
      %a = ptr.null : !ptr.p
      -> %a
    }
    {
      %b = ptr.null : !ptr.p
      -> %b
    }
    -> %r
  }

  %g = func.func @past(%c: !i1) -> !ptr.p {
    %r = scf.switch %c {
      %a = ptr.null : !ptr.p
      %k = constant {value = 8} : !i64
      %p = ptr.ptradd %a, %k : !ptr.p
      -> %p
    }
    {
      %b = ptr.null : !ptr.p
      %k2 = constant {value = 8} : !i64
      %q = ptr.ptradd %b, %k2 : !ptr.p
      -> %q
    }
    -> %r
  }
  module_end
}

// CHECK-LABEL: func.func @same(
// CHECK-NOT: scf.switch
// CHECK: %[[N:[0-9]+]] = ptr.null : !ptr.p
// CHECK-NEXT: -> %[[N]]
// CHECK-LABEL: func.func @past(
// CHECK-NOT: scf.switch
// CHECK: %[[N:[0-9]+]] = ptr.null : !ptr.p
// CHECK-NEXT: %[[K:[0-9]+]] = constant {value = 8} : !i64
// CHECK-NEXT: %[[P:[0-9]+]] = ptr.ptradd %[[N]], %[[K]] : !ptr.p
// CHECK-NEXT: -> %[[P]]
