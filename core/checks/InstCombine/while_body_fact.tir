// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// A tested loop's body runs under the condition its test yields. The condition
// is spelled over the ports' per-iteration heads, so it holds on every
// iteration: this body knows its two carried values are equal.

module {
  %fn_equal_body = func.func @equal_body(%n: !i64, %acc: !i64) -> !i64 {
    %r, %s = scf.loop (%a = %acc, %i = %n) {
      %c = cmpi %i, %a {predicate = "eq"} : !i1
      %na, %ni = scf.switch %c {
        -> %a, %i
      }
      {
        %d = subi %i, %a : !i64
        -> %d, %i
      }
      -> %c, %na, %ni, %a, %i
    }
    -> %r
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @equal_body
// CHECK: scf.switch
// CHECK: }
// CHECK-NEXT: {
// CHECK-NEXT: %[[ZERO:[0-9]+]] = constant {value = 0} : !i64
// CHECK-NEXT: -> %[[ZERO]], %{{[0-9]+}}
// CHECK-NOT: subi
