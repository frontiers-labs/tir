// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) --verify %s | filecheck %s

// The constant a loop is entered on need not be spelled as one: here the init is
// a term the base fixpoint proves equal to a literal. A port is only
// hypothesised about when its init class holds one, so the base graph has to
// have saturated before the loops are read -- and then this port carries 7 like
// any other, and the loop, holding no memory, dies with the reads it fed.

module {
  %fn_f = func.func @f(%0: !i64, %1: !i64, %2: !i64) -> !i32 {
    %3 = constant {value = 7} : !i32
    %4 = constant {value = 0} : !i32
    %5 = addi %3, %4 : !i32
    %i1_end, %6 = scf.ordered_for %i1 = %0 to %1 step %2 (%7 = %5) {
      %8 = addi %7, %4 : !i32
      scf.yield %8
    }
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[SEVEN:[0-9]+]] = constant {value = 7} : !i32
// CHECK-NOT: addi
// CHECK-NOT: scf.for
// CHECK: -> %[[SEVEN]]
