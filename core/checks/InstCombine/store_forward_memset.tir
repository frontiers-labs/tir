// RUN: tir opt --pass instcombine %s | filecheck %s

// A memset of an unknown size may write nothing at all, so a load of its first
// byte cannot take the byte it was handed.

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !i8, %2: !i64) -> !i8 {
    %3 = state.entry_state : !state
    ptr.memset %0, %1, %2 state(%3 -> %4)
    %5 = ptr.load %0 : !i8 state(%4)
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.load
