// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s

// The store wrote the extent the load reads, and both spell it at the same
// type, so the load is the value the store wrote.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32) -> !i32 {
    | %2 = state.entry_state
    | %3 = ptr.store %1, %0 | %2
    %4 = ptr.load %0 | %3 : !i32
    func.return %4 | %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.store %[[V:[0-9]+]],
// CHECK-NOT: ptr.load
// CHECK: -> %[[V]]
