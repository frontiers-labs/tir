// RUN: tir opt --pass func.func(thread-state,instcombine) --verify %s | filecheck %s

// Law S2 says the overwritten store leaves the state it was handed. Where the
// two stores agree on everything but that state they are one node apart from it,
// so unioning the inner one's result with the state before it makes the
// overwriting store congruent to the store it replaced — and the chain collapses
// into the state it started from, both writes gone rather than one. The law is
// refused there; `dse` removes the earlier write on the chain instead.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @twice(%1: !ptr.p, %2: !i32) {
    ptr.store %2, %1
    ptr.store %2, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @twice
// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[ENTRY]] -> %[[FIRST:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[FIRST]] -> %[[SECOND:[0-9]+]])
// CHECK-NEXT: func.return state(%[[SECOND]])

// A third write to the address collapses the same way one round later: the law
// leaves the second store naming the state the first was handed, and the first
// then names the state before it, so the two become congruent and the chain
// folds back to where it started. One elimination per address is what it carries.
