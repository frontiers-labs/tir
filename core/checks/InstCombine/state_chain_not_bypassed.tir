// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// Both guards fold to false, so the e-graph proves the state leaving the second
// gate equal to the entry state. The gates stay (instcombine never collapses a
// region op), so rerouting the func.return to the entry state would leave that state
// consumed twice: a state operand is only ever rewired by a rewrite that erases
// the consumers it bypasses.

module {
  %fn_p = func.func @p() {
    ->
  }
  %fn_f = func.func @f() {
    %0 = constant {value = 0} : !i32
    %1 = constant {value = 0} : !i32
    %2 = cmpi %0, %1 {predicate = "ne"} : !i1
    | %3 = state.entry_state
    | %4 = scf.switch %2 args(| %3) (| %5) {
      -> | %5
    }
    (| %6) {
      | %7 = func.call %fn_p() | %6
      -> | %7
    }
    | %8 = scf.switch %2 args(| %4) (| %9) {
      -> | %9
    }
    (| %10) {
      | %11 = func.call %fn_p() | %10
      -> | %11
    }
    -> | %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: | %[[FIRST:[0-9]+]] = scf.switch
// CHECK: | %[[SECOND:[0-9]+]] = scf.switch %{{[0-9]+}} args(| %[[FIRST]])
// CHECK: -> | %[[SECOND]]
