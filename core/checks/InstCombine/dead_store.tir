// RUN: tir opt --pass instcombine %s | filecheck %s

// The second store overwrites the extent the first one wrote and nothing reads
// the state between them, so the first store leaves memory as it found it.

module {
  func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) {
    %3 = state.entry_state : !state
    ptr.store %1, %0 state(%3 -> %4)
    ptr.store %2, %0 state(%4 -> %5)
    func.return state(%5)
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NOT: ptr.store %1,
// CHECK: ptr.store %2,
