// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) %s | filecheck %s

// The second store overwrites the extent the first one wrote and nothing reads
// the state between them, so the first store leaves memory as it found it.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) {
    | %3 = state.entry_state
    | %4 = ptr.store %1, %0 | %3
    | %5 = ptr.store %2, %0 | %4
    func.return | %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[P:[0-9]+]]: {{.*}}, %[[A:[0-9]+]]: {{.*}}, %[[B:[0-9]+]]: {{.*}})
// CHECK-NOT: ptr.store %[[A]],
// CHECK: ptr.store %[[B]], %[[P]]
