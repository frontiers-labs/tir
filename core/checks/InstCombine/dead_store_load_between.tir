// RUN: tir opt --pass instcombine %s | filecheck %s

// A load reads the state the first store published, so that store is observed
// and must stay.

module {
  func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) -> !i32 {
    %3 = state.entry_state : !state
    ptr.store %1, %0 state(%3 -> %4)
    %5 = ptr.load %0 : !i32 state(%4 -> %6)
    ptr.store %2, %0 state(%6 -> %7)
    func.return %5 state(%7)
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK: ptr.store %1,
// CHECK: ptr.store %2,
