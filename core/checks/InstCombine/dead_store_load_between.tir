// RUN: tir opt --pass fixpoint<3>(func.func(eqsat)) --verify %s | filecheck %s

// An ordinary write of a defined value can be bypassed when the next write
// overwrites the exact cell and no other use observes the intermediate state.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32, %2: !i32) -> !i32 {
    %defined = freeze %1 : !i32
    %3 = state.entry_state : !state<memory>
    %4 = ptr.store %defined, %0 state(%3)
    %5, %6 = ptr.load %0 state(%4) : !i32
    %7 = ptr.store %2, %0 state(%6)
    func.return %5 state(%7)
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[P:[0-9]+]]: !ptr.p<!i32>, %[[A:[0-9]+]]: !i32, %[[B:[0-9]+]]: !i32)
// CHECK: %[[FROZEN:[0-9]+]] = freeze %[[A]]
// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %[[FINAL:[0-9]+]] = ptr.store %[[B]], %[[P]] state(%[[ENTRY]])
// CHECK-NEXT: func.return %[[FROZEN]] state(%[[FINAL]])
