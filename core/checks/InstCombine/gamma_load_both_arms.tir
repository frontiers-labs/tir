// RUN: tir opt --pass promote --pass thread-state --pass instcombine --verify %s | filecheck %s

// The state the load reads is the gate's: distributing the load into the arms
// puts each arm's read on the state that arm's store left, so store-to-load
// forwarding answers both. The load's value is then the gate's, and the commit
// grows the port that carries it out. Nothing reads the slot afterwards, so the
// sweep takes the allocation and the stores with it.

module {
  %fn_both = func.func @both(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    scf.if %0 {
      ptr.store %1, %3
      scf.yield
    } else {
      ptr.store %2, %3
      scf.yield
    }
    %4 = ptr.load %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @both
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: scf.yield %2
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
