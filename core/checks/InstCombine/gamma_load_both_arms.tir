// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The state the load reads is the gate's: distributing the load into the arms
// puts each arm's read on the state that arm's store left, so store-to-load
// forwarding answers both. The load's value is then the gate's, and the commit
// grows the port that carries it out. Both arms overwrite the value written
// before the gate, and nothing reads the slot afterwards, so the sweep takes
// the allocation and every store with it.

module {
  %fn_both = func.func @both(%0: !i1, %1: !i32, %2: !i32, %3: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %s0 = state.entry_state
    | %s1 = ptr.store %3, %p | %s0
    | %s2 = scf.switch %0 args(| %s1) (| %e) {
      | %e1 = ptr.store %2, %p | %e
      -> | %e1
    }
    (| %t) {
      | %t1 = ptr.store %1, %p | %t
      -> | %t1
    }
    %4 | %s3 = ptr.load %p | %s2 : !i32
    -> %4 | %s3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @both
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = scf.switch %0 args(| %{{[0-9]+}}) (| %[[EA:[0-9]+]]) {
// CHECK-NEXT: -> %2 | %[[EA]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[TA:[0-9]+]]) {
// CHECK-NEXT: -> %1 | %[[TA]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[RESULT]]
