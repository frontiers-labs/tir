// RUN: tir opt --pass instcombine %s | filecheck %s

// The store wrote four bytes and the load reads two of them, so the load is not
// the stored value.

module {
  func @f(%0: !ptr.p, %1: !i32) -> !i16 {
    %2 = state.entry_state : !state
    ptr.store %1, %0 state(%2 -> %3)
    %4 = ptr.load %0 : !i16 state(%3)
    return %4
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK: ptr.load
