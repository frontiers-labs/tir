// RUN: tir opt --pass eqsat --verify %s | filecheck %s

// The store wrote four bytes and the load reads two of them, so the load is not
// the stored value.

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !i32) -> !i16 {
    %2 = state.entry_state : !state<memory>
    %3 = ptr.store %1, %0 state(%2)
    %4 = ptr.load %0 state(%3) : !i16
    func.return %4
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK: %[[STATE:[0-9]+]] = ptr.store
// CHECK-NEXT: %[[READ:[0-9]+]] = ptr.load {{.*}} state(%[[STATE]])
// CHECK-NEXT: func.return %[[READ]]
