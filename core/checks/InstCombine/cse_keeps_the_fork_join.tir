// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Two reads of one state are one term, so the second is common-subexpression
// eliminated. The join closing their fork stays: it is what orders the write
// after the read that is left, and handing the write the state before the fork
// instead would order it against nothing.

module {
  %fn_f = func.func @f(%p: !ptr.p<!i32>, %q: !ptr.p<!i32>) -> !i32 {
    %0 = ptr.load %p : !i32
    %1 = ptr.load %p : !i32
    %2 = addi %0, %1 : !i32
    ptr.store %2, %p
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[P:[0-9]+]]: !ptr.p<!i32>, %{{[0-9]+}}: !ptr.p<!i32>)
// CHECK-NEXT: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %[[V:[0-9]+]] | %[[R:[0-9]+]] = ptr.load %[[P]] | %[[ENTRY]] : !i32
// CHECK-NEXT: %{{[0-9]+}} = addi %[[V]], %[[V]] : !i32
// CHECK-NEXT: | %[[J:[0-9]+]] = state.join | %[[R]], %[[ENTRY]]
// CHECK-NEXT: | %{{[0-9]+}} = ptr.store %{{[0-9]+}}, %[[P]] | %[[J]]
