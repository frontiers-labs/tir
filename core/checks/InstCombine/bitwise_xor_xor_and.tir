// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @xor_xor_and_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = xori %x, %y : !i8
    %b = andi %x, %y : !i8
    %r = xori %a, %b : !i8
    func.return %r
  }
  %f32 = func.func @xor_xor_and_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = xori %x, %y : !i32
    %b = andi %x, %y : !i32
    %r = xori %a, %b : !i32
    func.return %r
  }
  %f64 = func.func @xor_xor_and_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = xori %x, %y : !i64
    %b = andi %x, %y : !i64
    %r = xori %a, %b : !i64
    func.return %r
  }
  module_end
}

