// RUN: tir opt --pass instcombine %s | filecheck %s

// An op whose identity carries attributes (cmpi's predicate) folds over constant
// operands like any other: the search index must key on the attributes too.

module {
  %fn_f = func.func @f() -> !i1 {
    %0 = constant {value = 2} : !i32
    %1 = constant {value = 3} : !i32
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: cmpi
// CHECK: constant {value = 1}
