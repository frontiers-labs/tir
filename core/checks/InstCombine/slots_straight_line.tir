// RUN: tir opt --pass fixpoint<3>(func.func(memopt)) --verify %s | filecheck %s
// RUN: tir opt --pass fixpoint<3>(memopt) --verify %s | filecheck %s
// RUN: not tir opt --pass func.func(nope) %s

// Each private slot is bounded and its stored values are defined.

module {
  %fn_f = func.func @f(%0: !i32, %1: !i32) -> !i32 {
    %defined_0 = freeze %0 : !i32
    %defined_1 = freeze %1 : !i32
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %defined_0, %2
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %defined_1, %3
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %5 = ptr.load %2 : !i32
    %6 = ptr.load %3 : !i32
    %7 = muli %5, %6 : !i32
    ptr.store %7, %4
    %8 = ptr.load %4 : !i32
    %9 = constant {value = 1} : !i32
    %10 = addi %8, %9 : !i32
    func.return %10
  }
  module_end
}

// CHECK-LABEL: func.func @f(
// CHECK-NOT: ptr.
// CHECK: %[[A:[0-9]+]] = freeze
// CHECK-NEXT: %[[B:[0-9]+]] = freeze
// CHECK-NEXT: %[[PRODUCT:[0-9]+]] = muli %[[A]], %[[B]]
// CHECK-NEXT: %[[ONE:[0-9]+]] = constant {value = 1}
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[PRODUCT]], %[[ONE]]
// CHECK-NEXT: func.return %[[SUM]]
