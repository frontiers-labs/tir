// RUN: tir opt --pass restructure-nodes,promote-nodes,instcombine-nodes --verify %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s
// RUN: not tir opt --pass func.func(nope) %s

// The shape a front end leaves for a straight-line function: one slot per name,
// written once and read where the name is used. Each read is on the state its
// own store left, so forwarding answers all of them, and nothing reads the slots
// afterwards — the sweep takes the allocations and the stores with them.

module {
  %fn_f = func.func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %5 = ptr.load %2 : !i32
    %6 = ptr.load %3 : !i32
    %7 = muli %5, %6 : !i32
    ptr.store %7, %4
    %8 = ptr.load %4 : !i32
    %9 = constant {value = 1} : !i32
    %10 = addi %8, %9 : !i32
    func.return %10
  }
  module_end
}

// CHECK: func.func @f(%[[A:[0-9]+]]: !i32, %[[B:[0-9]+]]: !i32)
// CHECK-NOT: ptr.
// CHECK: %[[PRODUCT:[0-9]+]] = muli %[[A]], %[[B]] : !i32
// CHECK-NEXT: %[[ONE:[0-9]+]] = constant {value = 1} : !i32
// CHECK-NEXT: %[[SUM:[0-9]+]] = addi %[[PRODUCT]], %[[ONE]] : !i32
// CHECK-NOT: ptr.
// CHECK: -> %[[SUM]]
