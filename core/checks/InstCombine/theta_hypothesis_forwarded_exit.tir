// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// A loop is left with what its test forwards, which is the carried value itself
// only where the test forwards it unchanged. The hypothesis proves what the port
// holds at the head of every iteration; what the loop's result is worth is then
// the test read over that constant — the square of it here, not the constant.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = constant {value = 7} : !i32
    %1 = constant {value = 0} : !i32
    %2, %3 = scf.loop (%4 = %0, %5 = %1) {
      %6 = muli %4, %4 : !i32
      %7 = constant {value = 2} : !i32
      %8 = cmpi %5, %7 {predicate = "slt"} : !i1
      %9 = constant {value = 1} : !i32
      %10 = addi %5, %9 : !i32
      %11 = constant {value = 7} : !i32
      -> %8, %11, %10, %6, %5
    }
    -> %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @main
// CHECK: %[[FORTY_NINE:[0-9]+]] = constant {value = 49} : !i32
// CHECK: -> %[[FORTY_NINE]]
