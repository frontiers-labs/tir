// RUN: tir opt --pass instcombine --verify %s | filecheck %s

// Both writes store 0, which is what they fold to and not what they are spelled
// as. Dead-store elimination used to be an e-graph law asserting that the
// overwritten write left the state it was handed, refused where the two writes
// agreed on everything but that state — and it read that disagreement when the
// match was found, a round before folding made the two values one class. The
// law fired anyway, the surviving write became congruent to the one it retired,
// and the chain folded back to the entry state with both writes gone.
//
// What the caller must be left holding is one write of 0. Which of the two it
// is cannot be seen, and is not the point: before the fix there was none.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>) {
    | %1 = state.entry_state
    %2 = constant {value = 12} : !i32
    %3 = constant {value = 1} : !i32
    %4 = shrsi %3, %2 : !i32
    | %5 = ptr.store %4, %0 | %1
    %6 = constant {value = 2} : !i32
    %7 = shrsi %6, %2 : !i32
    | %8 = ptr.store %7, %0 | %5
    func.return | %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0}
// CHECK-NEXT: | %[[S:[0-9]+]] = ptr.store %[[ZERO]], %0 | %[[ENTRY]]
// CHECK-NEXT: func.return | %[[S]]
