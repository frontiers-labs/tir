// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The slot's own pointer is stored into another slot, so its contents may be
// reached by a name the term graph never sees. The chain the arms leave says
// nothing about what such a write did, so the read of it is not one the law may
// distribute: the slot stays in memory.

module {
  %fn_stored_pointer = func.func @stored_pointer(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 8, align = 8} : !ptr.p<!ptr.p<!i32>>
    | %s0 = state.entry_state
    | %s1 = ptr.store %3, %4 | %s0
    | %s2 = scf.switch %0 args(| %s1) (| %e) {
      | %e1 = ptr.store %2, %3 | %e
      -> | %e1
    }
    (| %t) {
      | %t1 = ptr.store %1, %3 | %t
      -> | %t1
    }
    %5 | %s3 = ptr.load %3 | %s2 : !i32
    -> %5 | %s3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @stored_pointer
// CHECK: scf.switch %0 
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = ptr.load
// CHECK: -> %[[RESULT]]
