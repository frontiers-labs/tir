// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The laws compose over an n-ary gate too: the state the loop carries is a θ
// whose latch is the switch the body ends on, so the read distributes over the θ
// and then over every arm — the two that write forward their store, the default
// one yields the carry, which inside the body is the port argument.

module {
  %fn_dispatch = func.func @dispatch(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %4 = state.entry_state
    | %5 = ptr.store %2, %3 | %4
    | %6 = scf.loop (| %7 = %5) {
      %8 | %9 = scf.switch %0 args(| %7) (| %10) {
        %11 = constant {value = 0} : !i1
        -> %11 | %10
      }
      (| %12) {
        %13 | %14 = ptr.load %3 | %12 : !i32
        | %15 = scf.switch %1 args(| %14) (| %16) {
          -> | %16
        }
        (| %17) {
          %18 = addi %13, %13 : !i32
          | %19 = ptr.store %18, %3 | %17
          -> | %19
        }
        (| %20) {
          | %21 = ptr.store %2, %3 | %20
          -> | %21
        }
        %22 = constant {value = 1} : !i1
        -> %22 | %15
      }
      -> %8 | %9, %9
    }
    %23 | %24 = ptr.load %3 | %6 : !i32
    -> %23 | %24
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @dispatch
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = scf.loop (%[[PORT:[0-9]+]] = %2 | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK: %[[GATE:[0-9]+]] | %{{[0-9]+}} = scf.switch %1 args(| %{{[0-9]+}}) (| %{{[0-9]+}}) {
// CHECK-NEXT: -> %[[PORT]] | %{{[0-9]+}}
// CHECK: %[[NEXT:[0-9]+]] = addi %[[PORT]], %[[PORT]] : !i32
// CHECK-NEXT: -> %[[NEXT]] | %{{[0-9]+}}
// CHECK: -> %2 | %{{[0-9]+}}
// CHECK: -> %{{[0-9]+}}, %[[GATE]] | %{{[0-9]+}}
// CHECK: -> %[[RESULT]] | %{{[0-9]+}}
