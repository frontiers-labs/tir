// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The laws compose over an n-ary gate too: the state the loop carries is a θ
// whose latch is the switch the body ends on, so the read distributes over the θ
// and then over every arm — the two that write forward their store, the default
// one yields the carry, which inside the body is the port argument.

module {
  %fn_dispatch = func.func @dispatch(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%4) = state.entry_state
    state(%5) = ptr.store %2, %3 state(%4)
    state(%6) = scf.loop (state(%7 = %5)) {
      %8, state(%9) = scf.switch %0 args(state(%7)) (state(%10)) {
        %11 = constant {value = 0} : !i1
        -> %11, state(%10)
      }
      (state(%12)) {
        %13, state(%14) = ptr.load %3 state(%12) : !i32
        state(%15) = scf.switch %1 args(state(%14)) (state(%16)) {
          -> state(%16)
        }
        (state(%17)) {
          %18 = addi %13, %13 : !i32
          state(%19) = ptr.store %18, %3 state(%17)
          -> state(%19)
        }
        (state(%20)) {
          state(%21) = ptr.store %2, %3 state(%20)
          -> state(%21)
        }
        %22 = constant {value = 1} : !i1
        -> %22, state(%15)
      }
      -> %8, state(%9, %9)
    }
    %23, state(%24) = ptr.load %3 state(%6) : !i32
    -> %23, state(%24)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @dispatch
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.loop (%[[PORT:[0-9]+]] = %2) {
// CHECK: %[[GATE:[0-9]+]] = scf.switch %1 {
// CHECK-NEXT: -> %[[PORT]]
// CHECK: %[[NEXT:[0-9]+]] = addi %[[PORT]], %[[PORT]] : !i32
// CHECK-NEXT: -> %[[NEXT]]
// CHECK: -> %2
// CHECK: -> %{{[0-9]+}}, %[[GATE]]
// CHECK: -> %[[RESULT]], state(%{{[0-9]+}})
