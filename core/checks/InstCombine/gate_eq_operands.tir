// RUN: tir opt --pass fixpoint<4>(func.func(eqsat,dce)) --verify %s | filecheck %s

// The equality path makes subtraction zero. Keep the other path dependent on both operands.

module {
  %fn_eq = func.func @eq(%a: !i64, %b: !i64, %k: !i64, %m: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "eq"} : !i1
    %r = scf.switch %c {
      %t = subi %a, %b : !i64
      %u = addi %t, %m : !i64
      -> %u
    }
    {
      %s = subi %a, %b : !i64
      %v = addi %s, %k : !i64
      -> %v
    }
    -> %r
  }
  %fn_ne = func.func @ne(%a: !i64, %b: !i64, %k: !i64, %m: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "ne"} : !i1
    %r = scf.switch %c {
      %t = subi %a, %b : !i64
      %u = addi %t, %m : !i64
      -> %u
    }
    {
      %s = subi %a, %b : !i64
      %v = addi %s, %k : !i64
      -> %v
    }
    -> %r
  }
  module_end
}

// CHECK-LABEL: func.func @eq(%{{[0-9]+}}: !i64, %{{[0-9]+}}: !i64, %[[K:[0-9]+]]: !i64
// CHECK: scf.switch
// CHECK-NEXT: %[[D:[0-9]+]] = subi
// CHECK-NEXT: addi %[[D]]
// CHECK: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %[[K]]
// CHECK-NOT: subi

// CHECK-LABEL: func.func @ne(%{{[0-9]+}}: !i64, %{{[0-9]+}}: !i64, %[[K:[0-9]+]]: !i64, %[[M:[0-9]+]]: !i64
// CHECK: scf.switch
// CHECK-NEXT: -> %[[M]]
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: %[[D:[0-9]+]] = subi
// CHECK-NEXT: addi %[[D]], %[[K]]
