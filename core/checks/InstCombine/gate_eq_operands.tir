// RUN: tir opt --pass instcombine %s | filecheck %s
// RUN: tir opt --pass func.func(instcombine) %s | filecheck %s

// An equality gate's then-arm knows its two operands name one value, so the
// subtraction inside it is zero. The else-arm knows nothing and keeps its
// subtraction. `ne` states the same fact the other way round: the else-arm folds.

module {
  %fn_eq = func.func @eq(%a: !i64, %b: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "eq"} : !i1
    %r = scf.if %c -> !i64 {
      %s = subi %a, %b : !i64
      scf.yield %s
    } else {
      %t = subi %a, %b : !i64
      scf.yield %t
    }
    func.return %r
  }
  %fn_ne = func.func @ne(%a: !i64, %b: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "ne"} : !i1
    %r = scf.if %c -> !i64 {
      %s = subi %a, %b : !i64
      scf.yield %s
    } else {
      %t = subi %a, %b : !i64
      scf.yield %t
    }
    func.return %r
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @eq
// CHECK: scf.if
// CHECK-NEXT: constant {value = 0}
// CHECK: else
// CHECK-NEXT: subi

// CHECK-LABEL: %{{[0-9]+}} = func.func @ne
// CHECK: scf.if
// CHECK-NEXT: subi
// CHECK: else
// CHECK-NEXT: constant {value = 0}
