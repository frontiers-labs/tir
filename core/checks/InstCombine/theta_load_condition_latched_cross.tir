// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// Two slots the test region updates, one reading the other. The second port is
// asked for from inside the arm, where the arm's own assumption makes the whole
// gate equal to what it yields there — a form that answers nowhere else — so the
// port takes the gate's own value instead, and both slots leave memory.

module {
  %fn_sum_to = func.func @sum_to(%0: !i1) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = constant {value = 0} : !i32
    | %4 = state.entry_state
    | %5 = ptr.store %3, %1 | %4
    | %6 = ptr.store %3, %2 | %5
    | %7 = scf.loop (| %8 = %6) {
      %9 | %10 = scf.switch %0 args(| %8) (| %11) {
        %12 = constant {value = 0} : !i1
        -> %12 | %11
      }
      (| %13) {
        %14 | %15 = ptr.load %1 | %13 : !i32
        %16 | %17 = ptr.load %2 | %15 : !i32
        %18 = addi %14, %16 : !i32
        | %19 = ptr.store %18, %1 | %17
        %20 = constant {value = 1} : !i32
        %21 = addi %16, %20 : !i32
        | %22 = ptr.store %21, %2 | %19
        %23 = constant {value = 1} : !i1
        -> %23 | %22
      }
      -> %9 | %10, %10
    }
    %24 | %25 = ptr.load %1 | %7 : !i32
    -> %24 | %25
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @sum_to
// CHECK-NOT: ptr.
// CHECK: %[[SUM:[0-9]+]], %{{[0-9]+}} | %{{[0-9]+}} = scf.loop (%[[HS:[0-9]+]] = %3, %[[HC:[0-9]+]] = %3 | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK-NEXT: %{{[0-9]+}}, %[[LS:[0-9]+]], %[[LC:[0-9]+]] | %{{[0-9]+}} = scf.switch %0
// CHECK: -> %{{[0-9]+}}, %[[HS]], %[[HC]] | %{{[0-9]+}}
// CHECK: %[[NEXT:[0-9]+]] = addi %[[HS]], %[[HC]] : !i32
// CHECK: %[[STEP:[0-9]+]] = addi %[[HC]], %{{[0-9]+}} : !i32
// CHECK: -> %{{[0-9]+}}, %[[NEXT]], %[[STEP]] | %{{[0-9]+}}
// CHECK: -> %{{[0-9]+}}, %[[LS]], %[[LC]], %[[LS]], %[[LC]] | %{{[0-9]+}}, %{{[0-9]+}}
// CHECK: -> %[[SUM]] | %{{[0-9]+}}
