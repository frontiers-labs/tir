// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s --implicit-check-not "constant {value = 3}"

// Both edges can reach the same block with different literals.

module {
  %fn_f = func.func @f(%c: !i1) -> !i32 {
    %0 = constant {value = 1} : !i32
    %1 = constant {value = 2} : !i32
    cfg.cond_br %c, ^bb1(%0 : !i32), ^bb1(%1 : !i32)
  ^bb1(%2: !i32):
    %3 = constant {value = 1} : !i32
    %4 = addi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[ONE:[0-9]+]] = constant {value = 1} : !i32
// CHECK: %[[TWO:[0-9]+]] = constant {value = 2} : !i32
// CHECK: cfg.cond_br %{{[0-9]+}}, ^[[JOIN:bb[0-9]+]](%[[ONE]] : !i32)
// CHECK-SAME: , ^[[JOIN]](%[[TWO]] : !i32)
// CHECK-NEXT: ^[[JOIN]](%[[M:[0-9]+]]: !i32):
// CHECK: %[[SUM:[0-9]+]] = addi %[[M]], %{{[0-9]+}} : !i32
// CHECK-NEXT: func.return %[[SUM]]
