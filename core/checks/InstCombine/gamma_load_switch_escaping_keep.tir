// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The slot's own pointer is stored into another slot, so its contents may be
// reached by a name the term graph never sees. Distributing over the arms of a
// switch says no more about such a write than distributing over two, so the
// read is not one the law may distribute: the slot stays in memory.

module {
  %fn_stored_pointer = func.func @stored_pointer(%0: !i32, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = ptr.alloca {size = 8, align = 8} : !ptr.p<!ptr.p<!i32>>
    state(%s0) = state.entry_state
    state(%s1) = ptr.store %3, %4 state(%s0)
    state(%s2) = scf.switch %0 args(state(%s1)) (state(%a)) {
      state(%a1) = ptr.store %1, %3 state(%a)
      -> state(%a1)
    }
    (state(%b)) {
      state(%b1) = ptr.store %2, %3 state(%b)
      -> state(%b1)
    }
    (state(%c)) {
      -> state(%c)
    }
    %5, state(%s3) = ptr.load %3 state(%s2) : !i32
    -> %5, state(%s3)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @stored_pointer
// CHECK: scf.switch %0
// CHECK: %[[RESULT:[0-9]+]], state(%{{[0-9]+}}) = ptr.load
// CHECK: -> %[[RESULT]]
