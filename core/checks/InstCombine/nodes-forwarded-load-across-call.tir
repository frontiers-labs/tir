// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// A private slot written before a call and read after it: no call is on the
// slot's chain, because the call reaches no address the slot's own accesses
// ever let out, so the read is the value stored. The read is bound to that
// value one way only. Were it a read term of its own in the value's class, the
// store's operand could be spelled as the read that comes after the store,
// closing the chain on itself.

#data_layout = {types = {i8 = {abi = 8, size = 8}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.declare @f(!i8) -> !unit
  %fn_g = func.declare @g() -> !unit
  %fn_scale = func.func @scale(%p: !ptr.p) {
    %slot = ptr.alloca {size = 1, align = 1} : !ptr.p
    state(%s_slot) = state.entry_state
    state(%s_param) = state.entry_state
    state(%s_world) = state.entry_state
    %ptr, state(%r_param) = ptr.load %p state(%s_param) : !ptr.p
    %byte, state(%r_world) = ptr.load %ptr state(%s_world) : !i8
    state(%w_slot) = ptr.store %byte, %slot state(%s_slot)
    state(%in_g) = state.join state(%r_world, %r_param)
    state(%after_g) = func.call %fn_g() state(%in_g)
    state(%g_world, %g_param) = state.split state(%after_g)
    %back, state(%r_slot) = ptr.load %slot state(%w_slot) : !i8
    state(%in_f) = state.join state(%g_world, %g_param)
    state(%after_f) = func.call %fn_f(%back : !i8) state(%in_f)
    state(%f_world, %f_param) = state.split state(%after_f)
    state(%out) = state.join state(%r_slot, %f_world, %f_param)
    -> state(%out)
  }
  module_end
}

// CHECK-LABEL: func.func @scale
// CHECK: %[[V:[0-9]+]], state(%{{[0-9]+}}) = ptr.load %{{[0-9]+}} state(%{{[0-9]+}}) : !i8
// CHECK-NOT: ptr.
// CHECK: state(%[[G:[0-9]+]]) = func.call %{{[0-9]+}}() state(%{{[0-9]+}})
// CHECK-NOT: ptr.
// CHECK: state(%[[F:[0-9]+]]) = func.call %{{[0-9]+}}(%[[V]] : !i8) state(%{{[0-9]+}})
