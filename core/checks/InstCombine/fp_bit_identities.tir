// RUN: tir opt --pass func.func(restructure-nodes,instcombine-nodes) --verify %s | filecheck %s

module {
  %double_neg_f32 = func.func @double_neg_f32(%x: !f32) -> !f32 {
    %neg = fp.neg %x : !f32
    %result = fp.neg %neg : !f32
    func.return %result
  }
  %double_neg_f64 = func.func @double_neg_f64(%x: !f64) -> !f64 {
    %neg = fp.neg %x : !f64
    %result = fp.neg %neg : !f64
    func.return %result
  }
  %copysign_self = func.func @copysign_self(%x: !f32) -> !f32 {
    %result = fp.copysign %x, %x : !f32
    func.return %result
  }
  %copysign_magnitude = func.func @copysign_magnitude(%x: !f64, %y: !f64, %z: !f64) -> !f64 {
    %inner = fp.copysign %x, %y : !f64
    %result = fp.copysign %inner, %z : !f64
    func.return %result
  }
  %copysign_sign = func.func @copysign_sign(%x: !f32, %y: !f32, %z: !f32) -> !f32 {
    %inner = fp.copysign %y, %z : !f32
    %result = fp.copysign %x, %inner : !f32
    func.return %result
  }
  %abs_abs = func.func @abs_abs(%x: !f64) -> !f64 {
    %inner = fp.abs %x : !f64
    %result = fp.abs %inner : !f64
    func.return %result
  }
  %abs_neg = func.func @abs_neg(%x: !f32) -> !f32 {
    %neg = fp.neg %x : !f32
    %result = fp.abs %neg : !f32
    func.return %result
  }
  %negative_zero = func.func @negative_zero() -> !f32 {
    %value = fp.constant {bits = 2147483648} : !f32
    %neg = fp.neg %value : !f32
    %result = fp.neg %neg : !f32
    func.return %result
  }
  %signaling_nan = func.func @signaling_nan() -> !f64 {
    %value = fp.constant {bits = 9218868437227405313} : !f64
    %neg = fp.neg %value : !f64
    %result = fp.neg %neg : !f64
    func.return %result
  }
  %strict_add_zero = func.func @strict_add_zero(%x: !f32) -> !f32 {
    %zero = fp.constant {bits = 0} : !f32
    %result = fp.add %x, %zero {semantics = {nan = "preserve_payload"}} : !f32
    func.return %result
  }
  module_end
}

// CHECK-LABEL: func.func @double_neg_f32(%[[X:[0-9]+]]: !f32)
// CHECK-NOT: fp.neg
// CHECK: -> %[[X]]
// CHECK-LABEL: func.func @double_neg_f64(%[[X:[0-9]+]]: !f64)
// CHECK-NOT: fp.neg
// CHECK: -> %[[X]]
// CHECK-LABEL: func.func @copysign_self(%[[X:[0-9]+]]: !f32)
// CHECK-NOT: fp.copysign
// CHECK: -> %[[X]]
// CHECK-LABEL: func.func @copysign_magnitude(%[[X:[0-9]+]]: !f64, %{{[0-9]+}}: !f64, %[[Z:[0-9]+]]: !f64)
// CHECK-NOT: fp.copysign
// CHECK: %[[RESULT:[0-9]+]] = fp.copysign %[[X]], %[[Z]] : !f64
// CHECK-NOT: fp.copysign
// CHECK: -> %[[RESULT]]
// CHECK-LABEL: func.func @copysign_sign(%[[X:[0-9]+]]: !f32, %{{[0-9]+}}: !f32, %[[Z:[0-9]+]]: !f32)
// CHECK-NOT: fp.copysign
// CHECK: %[[RESULT:[0-9]+]] = fp.copysign %[[X]], %[[Z]] : !f32
// CHECK-NOT: fp.copysign
// CHECK: -> %[[RESULT]]
// CHECK-LABEL: func.func @abs_abs(%[[X:[0-9]+]]: !f64)
// CHECK-NOT: fp.abs
// CHECK: %[[RESULT:[0-9]+]] = fp.abs %[[X]] : !f64
// CHECK-NOT: fp.abs
// CHECK: -> %[[RESULT]]
// CHECK-LABEL: func.func @abs_neg(%[[X:[0-9]+]]: !f32)
// CHECK-NOT: fp.neg
// CHECK-NOT: fp.abs
// CHECK: %[[RESULT:[0-9]+]] = fp.abs %[[X]] : !f32
// CHECK: -> %[[RESULT]]
// CHECK-LABEL: func.func @negative_zero()
// CHECK: %[[ZERO:[0-9]+]] = fp.constant {bits = 2147483648} : !f32
// CHECK-NOT: fp.neg
// CHECK: -> %[[ZERO]]
// CHECK-LABEL: func.func @signaling_nan()
// CHECK: %[[SNAN:[0-9]+]] = fp.constant {bits = 9218868437227405313} : !f64
// CHECK-NOT: fp.neg
// CHECK: -> %[[SNAN]]
// CHECK-LABEL: func.func @strict_add_zero(%[[X:[0-9]+]]: !f32)
// CHECK: %[[ZERO:[0-9]+]] = fp.constant {bits = 0} : !f32
// CHECK: %[[RESULT:[0-9]+]] = fp.add %[[X]], %[[ZERO]] {semantics = {nan = "preserve_payload"}} : !f32
// CHECK: -> %[[RESULT]]
