// RUN: tir opt --pass func.func(instcombine) --verify %s | filecheck %s

// A gate whose decision is a known constant publishes what the arm that constant
// selects yields. The arm is the one whose *case value* the decision equals, which
// for an n-ary switch is not the boolean reading: `case 0` is the first arm, not
// the default.

module {
  %fn_picks_the_case_arm = func.func @picks_the_case_arm(%0: !i64, %1: !i64) -> !i64 {
    %2 = constant {value = 0} : !i32
    %3 = scf.switch_legacy %2 -> !i64 case 0 {
      scf.yield %0
    }
     default {
      scf.yield %1
    }
    func.return %3
  }
  %fn_picks_the_default_arm = func.func @picks_the_default_arm(%4: !i64, %5: !i64) -> !i64 {
    %6 = constant {value = 7} : !i32
    %7 = scf.switch_legacy %6 -> !i64 case 0 {
      scf.yield %4
    }
     default {
      scf.yield %5
    }
    func.return %7
  }
  %fn_picks_the_then_arm = func.func @picks_the_then_arm(%8: !i64, %9: !i64) -> !i64 {
    %10 = constant {value = 1} : !i1
    %11 = scf.if %10 -> !i64 {
      scf.yield %8
    }
     else {
      scf.yield %9
    }
    func.return %11
  }
  %fn_picks_the_else_arm = func.func @picks_the_else_arm(%12: !i64, %13: !i64) -> !i64 {
    %14 = constant {value = 0} : !i1
    %15 = scf.if %14 -> !i64 {
      scf.yield %12
    }
     else {
      scf.yield %13
    }
    func.return %15
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_case_arm(%[[L:[0-9]+]]: !i64, %{{[0-9]+}}: !i64)
// CHECK: func.return %[[L]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_default_arm(%{{[0-9]+}}: !i64, %[[R:[0-9]+]]: !i64)
// CHECK: func.return %[[R]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_then_arm(%[[T:[0-9]+]]: !i64, %{{[0-9]+}}: !i64)
// CHECK: func.return %[[T]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_else_arm(%{{[0-9]+}}: !i64, %[[E:[0-9]+]]: !i64)
// CHECK: func.return %[[E]]
