// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// A gate whose decision is a known constant publishes what the arm that constant
// selects yields. The arm is the one the decision indexes, and a decision past
// the last arm selects the last one: `0` is the first arm, `7` the last.

module {
  %fn_picks_the_first_arm = func.func @picks_the_first_arm(%0: !i64, %1: !i64) -> !i64 {
    %2 = constant {value = 0} : !i32
    %3 = scf.switch %2 {
      -> %0
    }
    {
      -> %1
    }
    -> %3
  }
  %fn_picks_the_last_arm = func.func @picks_the_last_arm(%4: !i64, %5: !i64) -> !i64 {
    %6 = constant {value = 7} : !i32
    %7 = scf.switch %6 {
      -> %4
    }
    {
      -> %5
    }
    -> %7
  }
  %fn_picks_the_then_arm = func.func @picks_the_then_arm(%8: !i64, %9: !i64) -> !i64 {
    %10 = constant {value = 1} : !i1
    %11 = scf.switch %10 {
      -> %9
    }
    {
      -> %8
    }
    -> %11
  }
  %fn_picks_the_else_arm = func.func @picks_the_else_arm(%12: !i64, %13: !i64) -> !i64 {
    %14 = constant {value = 0} : !i1
    %15 = scf.switch %14 {
      -> %13
    }
    {
      -> %12
    }
    -> %15
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_first_arm(%[[L:[0-9]+]]: !i64, %{{[0-9]+}}: !i64)
// CHECK-NOT: scf.switch
// CHECK: -> %[[L]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_last_arm(%{{[0-9]+}}: !i64, %[[R:[0-9]+]]: !i64)
// CHECK-NOT: scf.switch
// CHECK: -> %[[R]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_then_arm(%[[T:[0-9]+]]: !i64, %{{[0-9]+}}: !i64)
// CHECK-NOT: scf.switch
// CHECK: -> %[[T]]
// CHECK-LABEL: %{{[0-9]+}} = func.func @picks_the_else_arm(%{{[0-9]+}}: !i64, %[[E:[0-9]+]]: !i64)
// CHECK-NOT: scf.switch
// CHECK: -> %[[E]]
