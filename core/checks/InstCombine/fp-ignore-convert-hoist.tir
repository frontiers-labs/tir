// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes,instcombine-nodes,verify-deps --verify %s | filecheck %s

module {
  %f = func.func @shared_convert(%condition: !i1, %a: !f64) -> !f32 {
    cfg.cond_br %condition, ^then, ^else
  ^then:
    %x = fp.convert %a : !f32
    cfg.br ^join(%x : !f32)
  ^else:
    %y = fp.convert %a : !f32
    cfg.br ^join(%y : !f32)
  ^join(%result: !f32):
    func.return %result
  }
  module_end
}

// CHECK: func.func @shared_convert
// CHECK-NOT: scf.switch
// CHECK: %[[VALUE:[0-9]+]] = fp.convert
// CHECK-NOT: fp.convert
// CHECK-NOT: scf.switch
// CHECK: -> %[[VALUE]]
