// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f1 = func.func @sub_sub_cancel_1(%x: !i1, %y: !i1) -> !i1 {
    %difference = subi %y, %x : !i1
    %result = subi %y, %difference : !i1
    func.return %result
  }
  %f8 = func.func @sub_sub_cancel_8(%x: !i8, %y: !i8) -> !i8 {
    %difference = subi %y, %x : !i8
    %result = subi %y, %difference : !i8
    func.return %result
  }
  %f32 = func.func @sub_sub_cancel_32(%x: !i32, %y: !i32) -> !i32 {
    %difference = subi %y, %x : !i32
    %result = subi %y, %difference : !i32
    func.return %result
  }
  %f64 = func.func @sub_sub_cancel_64(%x: !i64, %y: !i64) -> !i64 {
    %difference = subi %y, %x : !i64
    %result = subi %y, %difference : !i64
    func.return %result
  }
  module_end
}

// CHECK-LABEL: func.func @sub_sub_cancel_1(%[[X1:[0-9]+]]: !i1, %[[Y1:[0-9]+]]: !i1)
// CHECK-NOT: addi
// CHECK-NOT: subi
// CHECK: -> %[[X1]]

// CHECK-LABEL: func.func @sub_sub_cancel_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8)
// CHECK-NOT: addi
// CHECK-NOT: subi
// CHECK: -> %[[X8]]

// CHECK-LABEL: func.func @sub_sub_cancel_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32)
// CHECK-NOT: addi
// CHECK-NOT: subi
// CHECK: -> %[[X32]]

// CHECK-LABEL: func.func @sub_sub_cancel_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64)
// CHECK-NOT: addi
// CHECK-NOT: subi
// CHECK: -> %[[X64]]
