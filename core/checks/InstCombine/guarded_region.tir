// RUN: tir opt --pass fixpoint<4>(func.func(eqsat)) --verify %s | filecheck %s

// The multiply folds inside the true arm and remains dependent on the predicate outside it.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i1) -> !i1 {
    %2 = muli %0, %1 : !i1
    %4 = scf.switch %0 {
      -> %0
    }
    {
      %3 = muli %0, %1 : !i1
      -> %3
    }
    %5 = xori %2, %4 : !i1
    -> %5
  }
  module_end
}

// CHECK-LABEL: func.func @f(%[[COND:[0-9]+]]: !i1, %[[VALUE:[0-9]+]]: !i1)
// CHECK: %[[OUTER:[0-9]+]] = muli %[[COND]], %[[VALUE]]
// CHECK: scf.switch %[[COND]]
// CHECK-NEXT: %[[ZERO:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[ZERO]]
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %[[VALUE]]
// CHECK-NOT: muli
// CHECK: xori %[[OUTER]]
