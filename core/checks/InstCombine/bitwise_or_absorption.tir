// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @or_absorption_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = andi %x, %y : !i8
    %r = ori %a, %x : !i8
    func.return %r
  }
  %f32 = func.func @or_absorption_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = andi %x, %y : !i32
    %r = ori %a, %x : !i32
    func.return %r
  }
  %f64 = func.func @or_absorption_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = andi %x, %y : !i64
    %r = ori %a, %x : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @or_absorption_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NEXT: -> %[[X8]]
// CHECK-LABEL: func.func @or_absorption_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32, %[[Z32:[0-9]+]]: !i32)
// CHECK-NEXT: -> %[[X32]]
// CHECK-LABEL: func.func @or_absorption_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64, %[[Z64:[0-9]+]]: !i64)
// CHECK-NEXT: -> %[[X64]]
