// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// One loop leaving through both a `continue` and a `break`. The states the two
// exits carry are not the one the body latches, so no single term names the
// value leaving the loop: each edge carries what the slot holds where it is
// taken, and the port merges them.

module {
  %fn_spin = func.func @spin(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%3) = state.entry_state
    state(%4) = ptr.store %1, %2 state(%3)
    state(%5) = scf.loop (state(%6 = %4)) {
      %7, state(%8) = scf.switch %0 args(state(%6)) (state(%9)) {
        %10 = constant {value = 0} : !i1
        -> %10, state(%9)
      }
      (state(%11)) {
        %12, state(%13) = ptr.load %2 state(%11) : !i32
        %14 = addi %12, %12 : !i32
        state(%15) = ptr.store %14, %2 state(%13)
        %16, state(%17) = scf.switch %0 args(state(%15)) (state(%18)) {
          state(%19) = ptr.store %12, %2 state(%18)
          %20, state(%21) = scf.switch %0 args(state(%19)) (state(%22)) {
            %23 = constant {value = 1} : !i1
            -> %23, state(%22)
          }
          (state(%24)) {
            %25 = constant {value = 0} : !i1
            -> %25, state(%24)
          }
          -> %20, state(%21)
        }
        (state(%26)) {
          %27 = constant {value = 1} : !i1
          -> %27, state(%26)
        }
        -> %16, state(%17)
      }
      -> %7, state(%8, %8)
    }
    %28, state(%29) = ptr.load %2 state(%5) : !i32
    -> %28, state(%29)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @spin
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.loop (%[[PORT:[0-9]+]] = %1) {
// CHECK: %[[BREAK:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[BREAK]], %[[PORT]]
// CHECK: %[[NEXT:[0-9]+]] = addi %[[PORT]], %[[PORT]] : !i32
// CHECK: -> %{{[0-9]+}}, %[[PORT]]
// CHECK: %[[CONTINUE:[0-9]+]] = constant {value = 1} : !i1
// CHECK-NEXT: -> %[[CONTINUE]], %[[NEXT]]
// CHECK: -> %[[RESULT]], state(%{{[0-9]+}})
