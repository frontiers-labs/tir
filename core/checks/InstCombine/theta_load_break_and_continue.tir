// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// One loop leaving through both a `continue` and a `break`. The states the two
// exits carry are not the one the body latches, so no single term names the
// value leaving the loop: each edge carries what the slot holds where it is
// taken, and the port merges them.

module {
  func.func @spin(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      %4 = ptr.load %2 : !i32
      %5 = addi %4, %4 : !i32
      ptr.store %5, %2
      scf.if %0 {
        scf.continue %3
      } else {
        scf.yield
      }
      ptr.store %4, %2
      scf.if %0 {
        scf.break %3
      } else {
        scf.yield
      }
      scf.yield
    }
    %6 = ptr.load %2 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: func.func @spin
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%{{[0-9]+}} = %1) -> !i32 {
// CHECK: do scope(%[[SCOPE:[0-9]+]])(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[BODY]], %[[BODY]] : !i32
// CHECK: scf.continue %[[SCOPE]], %[[NEXT]]
// CHECK: scf.break %[[SCOPE]], %[[BODY]]
// CHECK: scf.yield %[[BODY]]
// CHECK: func.return %[[RESULT]]
