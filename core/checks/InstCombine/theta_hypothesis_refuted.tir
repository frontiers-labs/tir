// RUN: tir opt --pass instcombine --verify %s | filecheck %s

// The same shape with a latch that advances the port. Under the hypothesis the
// latch folds to 8, which is not the 7 the loop was entered on, so the edge
// refutes it and the port stays what the loop carries: the read after the loop
// is the loop's result.

module {
  %fn_f = func.func @f(%0: !index, %1: !index, %2: !index) -> !i32 {
    %3 = constant {value = 7} : !i32
    %4 = constant {value = 1} : !i32
    %5 = scf.for_legacy %0, %1, %2 iter_args(%6 = %3) -> !i32 {
      %7 = addi %6, %4 : !i32
      scf.yield %7
    }
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[RESULT:[0-9]+]] = scf.for_legacy %0, %1, %2 iter_args(%[[K:[0-9]+]] = %3) -> !i32 {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[K]], %4 : !i32
// CHECK-NEXT: scf.yield %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
