// RUN: tir opt --pass instcombine %s | filecheck %s

// The call publishes a state of its own, so the load no longer reads the one the
// store left and cannot take its value.

module {
  %fn_g = func.declare @g() -> !unit
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !i32) -> !i32 {
    | %2 = state.entry_state
    | %3 = ptr.store %1, %0 | %2
    | %4 = func.call %fn_g() | %3
    %5 = ptr.load %0 | %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.load
