// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The same reading through a while-shaped loop, where the port is read by the
// test before the body sees it: no edge changes the state of a slot
// the body only reads, so what it holds inside the loop is what the store before
// the loop left.

module {
  %fn_accumulate = func.func @accumulate(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%4) = state.entry_state
    state(%5) = ptr.store %1, %3 state(%4)
    %6, state(%7) = scf.loop (%8 = %2, state(%9 = %5)) {
      %10, %11, state(%12) = scf.switch %0 args(state(%9)) (state(%13)) {
        %14 = constant {value = 0} : !i1
        -> %14, %8, state(%13)
      }
      (state(%15)) {
        %16, state(%17) = ptr.load %3 state(%15) : !i32
        %18 = addi %8, %16 : !i32
        %19 = constant {value = 1} : !i1
        -> %19, %18, state(%17)
      }
      -> %10, %11, %8, state(%12, %12)
    }
    -> %6, state(%7)
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @accumulate
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.loop (%[[ACC:[0-9]+]] = %2) {
// CHECK: -> %{{[0-9]+}}, %[[ACC]]
// CHECK: %[[NEXT:[0-9]+]] = addi %[[ACC]], %1 : !i32
// CHECK: -> %{{[0-9]+}}, %[[NEXT]]
// CHECK: -> %[[RESULT]], state(%{{[0-9]+}})
