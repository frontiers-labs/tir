// RUN: tir opt --pass promote --pass thread-state --pass instcombine --verify %s | filecheck %s

// The same reading through a `scf.while`, where the port is read in the
// condition region before the body sees it: no edge changes the state of a slot
// the body only reads, so what it holds inside the loop is what the store before
// the loop left.

module {
  %fn_accumulate = func.func @accumulate(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    %4 = scf.while iter_args(%5 = %2) -> !i32 {
      scf.condition %0, %5
    } do(%6) {
      %7 = ptr.load %3 : !i32
      %8 = addi %6, %7 : !i32
      scf.yield %8
    }
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @accumulate
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%[[COND:[0-9]+]] = %2) -> !i32 {
// CHECK-NEXT: scf.condition %0, %[[COND]]
// CHECK-NEXT: }
// CHECK-NEXT: do(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[BODY]], %1 : !i32
// CHECK-NEXT: scf.yield %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
