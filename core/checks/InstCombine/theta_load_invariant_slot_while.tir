// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// The same reading through a `scf.while`, where the port is read in the
// condition region before the body sees it: no edge changes the state of a slot
// the body only reads, so what it holds inside the loop is what the store before
// the loop left.

module {
  %fn_accumulate = func.func @accumulate(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %4 = state.entry_state
    | %5 = ptr.store %1, %3 | %4
    %6 | %7 = scf.loop (%8 = %2 | %9 = %5) {
      %10, %11 | %12 = scf.switch %0 args(| %9) (| %13) {
        %14 = constant {value = 0} : !i1
        -> %14, %8 | %13
      }
      (| %15) {
        %16 | %17 = ptr.load %3 | %15 : !i32
        %18 = addi %8, %16 : !i32
        %19 = constant {value = 1} : !i1
        -> %19, %18 | %17
      }
      -> %10, %11, %8 | %12, %12
    }
    -> %6 | %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @accumulate
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] | %{{[0-9]+}} = scf.loop (%[[ACC:[0-9]+]] = %2 | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK: -> %{{[0-9]+}}, %[[ACC]] | %{{[0-9]+}}
// CHECK: %[[NEXT:[0-9]+]] = addi %[[ACC]], %1 : !i32
// CHECK: -> %{{[0-9]+}}, %[[NEXT]] | %{{[0-9]+}}
// CHECK: -> %[[RESULT]] | %{{[0-9]+}}
