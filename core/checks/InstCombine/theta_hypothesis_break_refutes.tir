// RUN: tir opt --pass func.func(instcombine-nodes) --verify %s | filecheck %s

// Every edge back into a port is a hypothesis to check, the latch and each
// `break` leaving the loop alike. The break carries its value on the result
// edge, not into the port; the latch carries the constant the loop was entered
// on, so the port is proved and every read of it is the literal, while the
// result on the break edge stays the argument.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i1, %2: !i32) -> !i32 {
    %3 = constant {value = 7} : !i32
    %4 = scf.loop (%5 = %3) {
      %6, %7, %8 = scf.switch %0 {
        %9 = constant {value = 0} : !i1
        -> %9, %5, %5
      }
      {
        %10, %11, %12 = scf.switch %1 {
          %13 = constant {value = 1} : !i1
          %14 = constant {value = 7} : !i32
          -> %13, %14, %5
        }
        {
          %15 = constant {value = 0} : !i1
          -> %15, %5, %2
        }
        -> %10, %11, %12
      }
      -> %6, %7, %8
    }
    -> %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%{{[0-9]+}}: !i1, %{{[0-9]+}}: !i1, %[[X:[0-9]+]]: !i32)
// CHECK-NEXT: %[[SEVEN:[0-9]+]] = constant {value = 7} : !i32
// CHECK-NEXT: %[[R:[0-9]+]] = scf.loop (%[[PORT:[0-9]+]] = %[[SEVEN]]) {
// CHECK-NOT: %[[PORT]]
// CHECK: -> %{{[0-9]+}}, %[[SEVEN]], %[[X]]
// CHECK-NOT: %[[PORT]]
// CHECK: -> %{{[0-9]+}}, %[[SEVEN]], %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: -> %{{[0-9]+}}, %[[SEVEN]], %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[R]]
