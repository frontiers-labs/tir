// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes,instcombine-nodes,verify-deps --verify %s | filecheck %s

module {
  %f = func.func @shared_integer(%condition: !i1, %a: !f64) -> !i32 {
    cfg.cond_br %condition, ^then, ^else
  ^then:
    %x = fp.to_si %a : !i32
    cfg.br ^join(%x : !i32)
  ^else:
    %y = fp.to_si %a : !i32
    cfg.br ^join(%y : !i32)
  ^join(%result: !i32):
    func.return %result
  }
  module_end
}

// CHECK: func.func @shared_integer
// CHECK-NOT: scf.switch
// CHECK: %[[VALUE:[0-9]+]] = fp.to_si
// CHECK-NOT: fp.to_si
// CHECK-NOT: scf.switch
// CHECK: -> %[[VALUE]]
