// RUN: tir opt --pass instcombine --verify %s | filecheck %s

// A port every edge carries round unchanged is the value the loop was entered
// with, at every read of it inside the loop and after it. A port the body
// increments is refuted: it is not the same value twice.

module {
  %fn_f = func.func @f(%lb: !index, %ub: !index, %step: !index) -> !i32 {
    %0 = constant {value = 7} : !i32
    %1 = constant {value = 0} : !i32
    %2 = constant {value = 1} : !i32
    %3, %4 = scf.for_legacy %lb, %ub, %step iter_args(%5 = %0, %6 = %1) -> !i32, !i32 {
      %7 = addi %6, %2 : !i32
      scf.yield %5, %7
    }
    %8 = addi %3, %4 : !i32
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[C:[0-9]+]] = constant {value = 7} : !i32
// CHECK: %{{[0-9]+}}, %[[N:[0-9]+]] = scf.for_legacy {{.*}} iter_args(%[[P:[0-9]+]] = %[[C]]
// CHECK: %[[NEXT:[0-9]+]] = addi %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: scf.yield %[[P]], %[[NEXT]]
// CHECK: %[[SUM:[0-9]+]] = addi %[[C]], %[[N]] : !i32
// CHECK-NEXT: func.return %[[SUM]]
