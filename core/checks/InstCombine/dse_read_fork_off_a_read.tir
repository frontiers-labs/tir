// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes,instcombine-nodes) --verify %s | filecheck %s
// RUN: tir opt --pass func.func(restructure-nodes,promote-nodes) --verify --shuffle-seed 7 %s | tir opt --pass func.func(instcombine-nodes) --verify - -o /dev/null

// Disjoint reads retain their values and ordering when the overwritten write
// they fork from is removed.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i64, %1: !i32, %2: !i32) -> !i64 {
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %0, %3
    %4 = ptr.load %3 : !i64
    ptr.store %1, %3
    %5 = constant {value = 4} : !i64
    %6 = ptr.ptradd %3, %5 : !ptr.p<!i64>
    %7 = ptr.load %6 : !i32
    %8 = ptr.load %6 : !i32
    ptr.store %2, %3
    %9 = addi %7, %8 : !i32
    %10 = extsi %9 : !i64
    %11 = addi %4, %10 : !i64
    func.return %11
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[A:[0-9]+]]: !i64, %[[B:[0-9]+]]: !i32, %{{[0-9]+}}: !i32)
// CHECK: %[[P:[0-9]+]] = ptr.alloca
// CHECK: %[[Q:[0-9]+]] = ptr.ptradd %[[P]]
// CHECK: %[[S0:[0-9]+]] = ptr.store %[[A]], %[[P]] state(%{{[0-9]+}})
// CHECK-NOT: ptr.store %[[B]], %[[P]]
// CHECK: %[[R:[0-9]+]], %{{[0-9]+}} = ptr.load %[[Q]] state(%[[S0]]) : !i32
// CHECK: addi %[[R]], %[[R]]
// CHECK: addi %[[A]],
