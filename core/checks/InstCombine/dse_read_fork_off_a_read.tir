// RUN: tir opt --pass func.func(promote,thread-state,instcombine) --verify %s | filecheck %s

// The reads that forked off what the first write published name bytes it never
// wrote, so nothing they answer would change if they read the memory before it.
// The commit does not know that: it may move a write back only over writes
// nothing else reads, and the reads are other readers. The write they fork off
// stays.
//
// Saying it properly takes the companion law — `Load(b,m,Store(s,a,n,v))` is
// `Load(b,m,s)` for disjoint extents — which moves the reads back with the
// write. Until it lands (#384) this case is a write more than it needs.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_f = func.func @f(%0: !i64, %1: !i32, %2: !i32) -> !i64 {
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %0, %3
    %4 = ptr.load %3 : !i64
    ptr.store %1, %3
    %5 = constant {value = 4} : !i64
    %6 = ptr.ptradd %3, %5 : !ptr.p<!i64>
    %7 = ptr.load %6 : !i32
    %8 = ptr.load %6 : !i32
    ptr.store %2, %3
    %9 = addi %7, %8 : !i32
    %10 = extsi %9 : !i64
    %11 = addi %4, %10 : !i64
    func.return %11
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: | %[[S0:[0-9]+]] = ptr.store %0, %3 | %{{[0-9]+}}
// CHECK-NEXT: | %[[S1:[0-9]+]] = ptr.store %1, %3 | %[[S0]]
// CHECK: %[[R:[0-9]+]] | %{{[0-9]+}} = ptr.load %6 | %[[S1]] : !i32
// CHECK: addi %[[R]], %[[R]]
// CHECK: addi %0,
