// RUN: tir opt --pass func.func(eqsat) --verify %s | filecheck %s

// The amount is unsigned, including when its printed integer is negative.

module {
  %left = func.func @left(%x: !i64) -> !i64 {
    %amount = constant {value = -9223372036854775808} : !i64
    %r = shli %x, %amount : !i64
    func.return %r
  }
  %right = func.func @right(%x: !i64) -> !i64 {
    %amount = constant {value = -1} : !i64
    %r = shrui %x, %amount : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @left(%[[ARG:[0-9]+]]: !i64)
// CHECK: %[[AMOUNT:[0-9]+]] = constant {value = -9223372036854775808} : !i64
// CHECK-NEXT: %[[VALUE:[0-9]+]] = shli %[[ARG]], %[[AMOUNT]]
// CHECK-NEXT: func.return %[[VALUE]]
// CHECK-LABEL: func.func @right(%[[ARG:[0-9]+]]: !i64)
// CHECK: %[[AMOUNT:[0-9]+]] = constant {value = -1} : !i64
// CHECK-NEXT: %[[VALUE:[0-9]+]] = shrui %[[ARG]], %[[AMOUNT]]
// CHECK-NEXT: func.return %[[VALUE]]
