// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// The shape restructuring leaves a `goto`/`while` loop in: the whole body sits
// in the condition region, so the update happens before `scf.condition` and the
// body region only yields what it was handed. The port then carries the latch
// through the test — what the loop is left with is what the test computed — and
// the read inside the loop takes the head the test was entered on.

module {
  func.func @sum(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    %3 = scf.while {
      %4 = scf.if %0 -> !i1 {
        %5 = ptr.load %2 : !i32
        %6 = addi %5, %5 : !i32
        ptr.store %6, %2
        %7 = constant {value = 1} : !i1
        scf.yield %7
      } else {
        %8 = constant {value = 0} : !i1
        scf.yield %8
      }
      scf.condition %4
    } do {
      scf.yield
    }
    %9 = ptr.load %2 : !i32
    func.return %9
  }
  module_end
}

// CHECK-LABEL: func.func @sum
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.while iter_args(%[[HEAD:[0-9]+]] = %1) -> !i32 {
// CHECK: %[[COND:[0-9]+]], %[[LATCH:[0-9]+]] = scf.if %0 -> !i1, !i32 {
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[HEAD]], %[[HEAD]] : !i32
// CHECK: scf.yield %{{[0-9]+}}, %[[NEXT]]
// CHECK: scf.yield %{{[0-9]+}}, %[[HEAD]]
// CHECK: scf.condition %[[COND]], %[[LATCH]]
// CHECK: do(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[BODY]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[RESULT]]
