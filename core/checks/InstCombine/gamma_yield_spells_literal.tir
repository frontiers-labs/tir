// RUN: tir opt --pass thread-state --pass instcombine --pass erase-state --verify %s | filecheck %s

// A class is spelled where it is read, and what a spelling costs there is the
// number of regions it has to cross: an arm that yields a definition from
// outside the gate keeps that value live across the whole gate, while a literal
// is built where it is read and crosses nothing. The arm that leaves the slot
// alone yields the initial value, and that value is a constant — so the arm
// spells its own, rather than the one before the gate.

module {
  func.func @spell(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = constant {value = 0} : !i32
    ptr.store %3, %2
    scf.if %0 {
      ptr.store %1, %2
      scf.yield
    } else {
      scf.yield
    }
    %4 = ptr.load %2 : !i32
    %5 = addi %4, %3 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: func.func @spell
// CHECK-NOT: ptr.
// CHECK: %[[RESULT:[0-9]+]] = scf.if %0 -> !i32 {
// CHECK-NEXT: scf.yield %1
// CHECK-NEXT: }
// CHECK: else {
// CHECK-NEXT: %[[ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NEXT: scf.yield %[[ZERO]]
// CHECK-NEXT: }
