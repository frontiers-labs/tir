// RUN: tir opt --pass instcombine %s | filecheck %s

// The store and the load name different addresses, so the load keeps reading
// memory.

module {
  %fn_f = func.func @f(%0: !ptr.p<!i32>, %1: !ptr.p<!i32>, %2: !i32) -> !i32 {
    | %3 = state.entry_state
    | %4 = ptr.store %2, %0 | %3
    %5 = ptr.load %1 | %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.load
