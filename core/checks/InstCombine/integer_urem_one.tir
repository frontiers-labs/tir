// RUN: tir opt --pass restructure-nodes,instcombine-nodes --verify %s | filecheck %s

module {
  %f8 = func.func @urem_one_8(%x: !i8, %y: !i8, %z: !i8) -> !i8 {
    %a = constant {value = 1} : !i8
    %r = remui %x, %a : !i8
    func.return %r
  }
  %f32 = func.func @urem_one_32(%x: !i32, %y: !i32, %z: !i32) -> !i32 {
    %a = constant {value = 1} : !i32
    %r = remui %x, %a : !i32
    func.return %r
  }
  %f64 = func.func @urem_one_64(%x: !i64, %y: !i64, %z: !i64) -> !i64 {
    %a = constant {value = 1} : !i64
    %r = remui %x, %a : !i64
    func.return %r
  }
  module_end
}

// CHECK-LABEL: func.func @urem_one_8(%[[X8:[0-9]+]]: !i8, %[[Y8:[0-9]+]]: !i8, %[[Z8:[0-9]+]]: !i8)
// CHECK-NEXT: %[[R8:[0-9]+]] = constant {value = 0} : !i8
// CHECK-NEXT: -> %[[R8]]
// CHECK-LABEL: func.func @urem_one_32(%[[X32:[0-9]+]]: !i32, %[[Y32:[0-9]+]]: !i32, %[[Z32:[0-9]+]]: !i32)
// CHECK-NEXT: %[[R32:[0-9]+]] = constant {value = 0} : !i32
// CHECK-NEXT: -> %[[R32]]
// CHECK-LABEL: func.func @urem_one_64(%[[X64:[0-9]+]]: !i64, %[[Y64:[0-9]+]]: !i64, %[[Z64:[0-9]+]]: !i64)
// CHECK-NEXT: %[[R64:[0-9]+]] = constant {value = 0} : !i64
// CHECK-NEXT: -> %[[R64]]
