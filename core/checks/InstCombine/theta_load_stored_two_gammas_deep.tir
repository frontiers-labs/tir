// RUN: tir opt --pass func.func(promote-nodes,instcombine-nodes) --verify %s | filecheck %s

// A slot written inside a loop nested under two gates is one class read at every
// level, and the class names a gate form per gate it is written under. The loop's
// latch is taken outside them all, so the form it takes there is the outermost
// gate's — a port on the inner gate alone names a value the condition cannot see,
// and the loop would carry what it was entered with.

module {
  %fn_sink = func.declare @sink(!i32) -> !i32
  %fn_f = func.func @f(%0: !i1) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = constant {value = 0} : !i32
    | %4 = state.entry_state
    | %5 = ptr.store %3, %1 | %4
    | %51 = ptr.store %3, %2 | %5
    | %6 = scf.loop (| %7 = %51) {
      %8 | %9 = scf.switch %0 args(| %7) (| %10) {
        %11 = constant {value = 0} : !i1
        -> %11 | %10
      }
      (| %12) {
        %13 = constant {value = 3} : !i32
        %14 | %15 = ptr.load %1 | %12 : !i32
        %16 = cmpi %14, %13 {predicate = "slt"} : !i1
        | %17 = scf.switch %16 args(| %15) (| %18) {
          -> | %18
        }
        (| %19) {
          %20 = constant {value = 0} : !i32
          | %21 = ptr.store %20, %2 | %19
          | %22 = scf.loop (| %23 = %21) {
            %24 = constant {value = 2} : !i32
            %25 | %26 = ptr.load %2 | %23 : !i32
            %27 = cmpi %25, %24 {predicate = "slt"} : !i1
            %28 | %29 = scf.switch %27 args(| %26) (| %30) {
              %31 = constant {value = 0} : !i1
              -> %31 | %30
            }
            (| %32) {
              %33 | %34 = ptr.load %1 | %32 : !i32
              %35 = constant {value = 1} : !i32
              %36 = addi %33, %35 : !i32
              | %37 = ptr.store %36, %1 | %34
              %38 | %39 = ptr.load %2 | %37 : !i32
              %40 = constant {value = 1} : !i32
              %41 = addi %38, %40 : !i32
              | %42 = ptr.store %41, %2 | %39
              %43 = constant {value = 1} : !i1
              -> %43 | %42
            }
            -> %28 | %29, %29
          }
          -> | %22
        }
        %44 | %45 = ptr.load %1 | %17 : !i32
        %46 | %47 = func.call %fn_sink(%44 : !i32) -> !i32 | %45
        %48 = constant {value = 1} : !i1
        -> %48 | %47
      }
      -> %8 | %9, %9
    }
    %49 | %50 = ptr.load %1 | %6 : !i32
    -> %49 | %50
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.alloca
// CHECK: %[[ZERO:[0-9]+]] = constant {value = 0} : !i32
// CHECK: scf.loop (%[[ACC:[0-9]+]] = %[[ZERO]] | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK-NEXT: %{{[0-9]+}}, %[[POST:[0-9]+]] | %{{[0-9]+}} = scf.switch %1 args(| %{{[0-9]+}}) (| %{{[0-9]+}}) {
// CHECK: -> %{{[0-9]+}}, %[[ACC]] | %{{[0-9]+}}
// CHECK: %[[GUARDED:[0-9]+]] | %{{[0-9]+}} = scf.switch %{{[0-9]+}} args(| %{{[0-9]+}}) (| %{{[0-9]+}}) {
// CHECK-NEXT: -> %[[ACC]] | %{{[0-9]+}}
// CHECK: scf.loop (%{{[0-9]+}} = %[[ACC]], %{{[0-9]+}} = %{{[0-9]+}} | %{{[0-9]+}} = %{{[0-9]+}}) {
// CHECK: -> %{{[0-9]+}}, %[[GUARDED]] | %{{[0-9]+}}
// CHECK: -> %{{[0-9]+}}, %[[POST]], %[[POST]] | %{{[0-9]+}}, %{{[0-9]+}}
