// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | filecheck %s

// A memset writes an extent its operands name and the store term cannot spell,
// so it is no store term and a one-byte store to its address does not overwrite
// it.

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !i8, %2: !i64) {
    | %3 = state.entry_state
    | %4 = ptr.memset %0, %1, %2 | %3
    | %5 = ptr.store %1, %0 | %4
    func.return | %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: ptr.memset
// CHECK: ptr.store
