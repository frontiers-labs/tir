// RUN: tir opt --pass instcombine %s | filecheck %s

// A memset writes an extent its operands name and the store term cannot spell,
// so it is no store term and a one-byte store to its address does not overwrite
// it.

module {
  func.func @f(%0: !ptr.p, %1: !i8, %2: !i64) {
    %3 = state.entry_state : !state
    ptr.memset %0, %1, %2 state(%3 -> %4)
    ptr.store %1, %0 state(%4 -> %5)
    func.return state(%5)
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK: ptr.memset
// CHECK: ptr.store
