// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck %s

// A read that reaches the allocation through reads alone observes nothing that
// was written, so every store to the slot is a write nobody looks at. The slot
// itself stays — the value its read stands for is taken — but its stores go the
// way of the stores of a slot with no read at all.

module {
  func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %2 = ptr.load %1 : !i32
    ptr.store %0, %1
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: %[[VALUE:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK-NEXT: func.return %[[VALUE]]
// CHECK-NOT: ptr.store
