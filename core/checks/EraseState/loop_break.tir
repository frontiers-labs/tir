// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// The states an exit carries out of a loop go with the port they fed: erasing
// leaves the `scf.break` naming its scope alone.

module {
  func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      ptr.store %1, %2
      scf.if %0 {
        scf.break %3
      } else {
        scf.yield
      }
      scf.yield
    }
    %4 = ptr.load %2 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: func.func @f(%0: !i1, %1: !i32) -> !i32 {
// CHECK-NEXT: %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %1, %2
// CHECK-NEXT: scf.while {
// CHECK-NEXT: scf.condition %0
// CHECK-NEXT: }
// CHECK-NEXT: do scope(%3) {
// CHECK-NEXT: ptr.store %1, %2
// CHECK-NEXT: scf.if %0 {
// CHECK-NEXT: scf.break %3
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: %4 = ptr.load %2 : !i32
// CHECK-NEXT: func.return %4
// CHECK-NEXT: }
