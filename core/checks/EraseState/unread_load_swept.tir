// RUN: tir opt --pass erase-state --verify %s | filecheck %s

// A load nothing reads is not a read: forwarding answers a slot's loads by their
// values and leaves the operations behind, so a slot whose every load has become
// unread is one nothing observes. It goes the way of a slot with no load at all,
// and takes those loads with it.

module {
  func.func @f(%0: !i32) {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p
    ptr.store %0, %1
    %2 = ptr.load %1 : !i32
    ptr.store %0, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NOT: ptr.
// CHECK: func.return
