// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// Erasing state undoes threading it: the entry state is gone, every port a chain
// grew is gone, and what is left is the function threading started from.

module {
  func.func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    ptr.store %1, %3
    %4 = ptr.load %2 : !i32
    %5 = ptr.load %3 : !i32
    %6 = addi %4, %5 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: func.func @f(%0: !i32, %1: !i32) -> !i32 {
// CHECK-NEXT: %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %0, %2
// CHECK-NEXT: ptr.store %1, %3
// CHECK-NEXT: %4 = ptr.load %2 : !i32
// CHECK-NEXT: %5 = ptr.load %3 : !i32
// CHECK-NEXT: %6 = addi %4, %5 : !i32
// CHECK-NEXT: func.return %6
// CHECK-NEXT: }
