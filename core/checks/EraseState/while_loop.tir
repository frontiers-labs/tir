// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// Both of a `while`'s regions gave the chain an argument, so both lose one.

module {
  func.func @g(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do {
      %3 = ptr.load %2 : !i32
      ptr.store %3, %2
      scf.yield
    }
    %4 = ptr.load %2 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: func.func @g(%0: !i1, %1: !i32) -> !i32 {
// CHECK-NEXT: %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %1, %2
// CHECK-NEXT: scf.while {
// CHECK-NEXT: scf.condition %0
// CHECK-NEXT: }
// CHECK-NEXT: do {
// CHECK-NEXT: %3 = ptr.load %2 : !i32
// CHECK-NEXT: ptr.store %3, %2
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: %4 = ptr.load %2 : !i32
// CHECK-NEXT: func.return %4
// CHECK-NEXT: }
