// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// A call's ports go with the rest: what it may touch stays implicit again.

module {
  func.declare @tick() -> !unit
  func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call @tick()
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @f(%0: !i32) -> !i32 {
// CHECK-NEXT: %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %0, %1
// CHECK-NEXT: func.call @tick()
// CHECK-NEXT: %3 = ptr.load %1 : !i32
// CHECK-NEXT: func.return %3
// CHECK-NEXT: }
