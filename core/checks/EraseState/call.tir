// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// A call's ports go with the rest: what it may touch stays implicit again.

module {
  %fn_tick = func.declare @tick() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call %fn_tick()
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%1: !i32) -> !i32 {
// CHECK-NEXT: %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %1, %2
// CHECK-NEXT: func.call %{{[0-9]+}}()
// CHECK-NEXT: %4 = ptr.load %2 : !i32
// CHECK-NEXT: func.return %4
// CHECK-NEXT: }
