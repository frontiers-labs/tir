// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck %s

// The read takes the state the store published, so it reads back what was
// written: the store is observed and stays. Only a slot whose every read reaches
// the allocation without passing a write loses its stores.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca
// CHECK-NEXT: ptr.store %0, %[[SLOT]]
// CHECK-NEXT: %[[VALUE:[0-9]+]] = ptr.load %[[SLOT]]
// CHECK-NEXT: func.return %[[VALUE]]
