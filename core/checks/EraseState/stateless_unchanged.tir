// RUN: tir opt --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// IR that was never threaded carries no state, so there is nothing to erase.

module {
  %fn_pure = func.func @pure(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @pure(%0: !i32) -> !i32 {
// CHECK-NEXT: %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %0, %1
// CHECK-NEXT: %2 = ptr.load %1 : !i32
// CHECK-NEXT: func.return %2
// CHECK-NEXT: }
