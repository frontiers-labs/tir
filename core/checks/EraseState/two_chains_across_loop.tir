// RUN: tir opt --pass thread-state --pass erase-state --verify %s | filecheck --implicit-check-not state %s

// A loop carrying two chains loses both ports, not just the last one.

module {
  %fn_f = func.func @f(%0: !index, %1: !index, %2: !index, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    ptr.store %3, %5
    scf.for %0, %1, %2 {
      %6 = ptr.load %4 : !i32
      ptr.store %6, %5
      scf.yield
    }
    %7 = ptr.load %5 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%0: !index, %1: !index, %2: !index, %3: !i32) -> !i32 {
// CHECK-NEXT: %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %3, %4
// CHECK-NEXT: ptr.store %3, %5
// CHECK-NEXT: scf.for %0, %1, %2 {
// CHECK-NEXT: %6 = ptr.load %4 : !i32
// CHECK-NEXT: ptr.store %6, %5
// CHECK-NEXT: scf.yield
// CHECK-NEXT: }
// CHECK-NEXT: %7 = ptr.load %5 : !i32
// CHECK-NEXT: func.return %7
// CHECK-NEXT: }
