// RUN: tir opt --pass func.func(thread-state,erase-state) --verify %s | filecheck %s

// Nothing outside the function can observe a slot whose address never leaves it,
// so one that is never read is dead: its stores go with its allocation.

module {
  %fn_f = func.func @f(%0: !i32) {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NOT: ptr.
// CHECK: func.return
