// RUN: tir opt --pass erase-state --verify %s | filecheck %s

// A slot that is read still has a value someone depends on, so it stays.

module {
  func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NEXT: %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: ptr.store %0, %1
// CHECK-NEXT: %2 = ptr.load %1 : !i32
