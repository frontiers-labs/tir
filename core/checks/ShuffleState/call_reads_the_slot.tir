// RUN: tir opt --pass func.func(thread-state,instcombine,shuffle-state) --verify %s | tir interp - --args=6 | filecheck %s
// RUN: env TIR_SHUFFLE_SEED=2 tir opt --pass func.func(thread-state,instcombine,shuffle-state) --verify %s | tir interp - --args=6 | filecheck %s
// RUN: env TIR_SHUFFLE_SEED=11 tir opt --pass func.func(thread-state,instcombine,shuffle-state) --verify %s | tir interp - --args=6 | filecheck %s

// The address-taken local shape: the call reads both slots, so every write to
// them is ordered before it however the block is re-linearized. An allocation is
// order-free and moves too, which is what lets the shuffle reach this block at
// all.

module {
  %fn_sink = func.func @sink(%p: !ptr.p<!i32>, %q: !ptr.p<!i32>) -> !i32 {
    %0 = ptr.load %p : !i32
    %1 = ptr.load %q : !i32
    %2 = addi %0, %1 : !i32
    func.return %2
  }
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %a = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %b = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %a
    %1 = ptr.load %a : !i32
    ptr.store %1, %b
    %2 = func.call %fn_sink(%a, %b : !ptr.p<!i32>, !ptr.p<!i32>) -> !i32
    %3 = addi %1, %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK: i32 18
