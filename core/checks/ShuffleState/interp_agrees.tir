// RUN: tir opt --pass func.func(thread-state,shuffle-state) --verify %s | tir interp - --args=7,5 | filecheck %s
// RUN: env TIR_SHUFFLE_SEED=7 tir opt --pass func.func(thread-state,shuffle-state) --verify %s | tir interp - --args=7,5 | filecheck %s
// RUN: env TIR_SHUFFLE_SEED=41 tir opt --pass func.func(thread-state,shuffle-state) --verify %s | tir interp - --args=7,5 | filecheck %s

// Re-linearizing a block under the state edges leaves behavior alone: the two
// slots are independent memories whose accesses may interleave any way, while
// the second store into the first slot and the load reading it back are one
// chain and stay ordered.

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    ptr.store %1, %3
    %4 = ptr.load %2 : !i32
    %5 = ptr.load %3 : !i32
    %6 = subi %4, %5 : !i32
    ptr.store %6, %2
    %7 = ptr.load %2 : !i32
    func.return %7
  }
  module_end
}

// CHECK: i32 2
