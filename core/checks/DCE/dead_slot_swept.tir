// RUN: tir opt --pass func.func(thread-state) --pass func.func(dce) --verify %s | filecheck %s --implicit-check-not ptr.

// A slot no read observes is a memory nothing in the function can tell exists.
// The chain says so and def-use answers it: the store's published state is read
// by nothing, so the store goes; the load's value is taken by nothing and a read
// publishes what it observed, so it goes and hands its reader the state it took;
// with neither its address nor its own state read, the allocation goes too.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    %2 = ptr.load %1 : !i32
    func.return %0
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: func.return %0
