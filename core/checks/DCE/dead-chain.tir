// RUN: tir opt --pass dce %s | filecheck %s --implicit-check-not addi

// A pure SSA chain feeding nothing is erased; an effectful call with an unread
// result survives.

module {
  func.func @g(%0: !i32) -> !i32 {
    func.return %0
  }
  func.func @f(%1: !i32) -> !i32 {
    %2 = constant {value = 3} : !i32
    %3 = addi %1, %2 : !i32
    %4 = func.call @g(%1 : !i32) -> !i32
    func.return %1
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NOT: constant
// CHECK: %{{[0-9]+}} = func.call @g(%{{[0-9]+}} : !i32) -> !i32
// CHECK: func.return
