// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// Two slots that never escape are independent memories, so each one gets a state
// chain of its own rooted at its allocation. Nothing joins them.

module {
  func @f(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    ptr.store %1, %3
    %4 = ptr.load %2 : !i32
    %5 = ptr.load %3 : !i32
    %6 = addi %4, %5 : !i32
    return %6
  }
  module_end
}

// CHECK-LABEL: func @f
// CHECK-NEXT: %[[ENTRY:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %[[A:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %[[B:[0-9]+]])
// CHECK-NEXT: ptr.store %0, %{{[0-9]+}} state(%[[A]] -> %[[A1:[0-9]+]])
// CHECK-NEXT: ptr.store %1, %{{[0-9]+}} state(%[[B]] -> %[[B1:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[A1]] -> %{{[0-9]+}})
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[B1]] -> %{{[0-9]+}})
// CHECK-NEXT: %{{[0-9]+}} = addi %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: return %{{[0-9]+}} state(%[[ENTRY]])
