// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// An `scf.continue` feeds the same carried port a `scf.yield` does, so the state
// reaching it starts the next iteration.

module {
  %fn_f = func.func @f(%0: !index, %1: !index, %2: !index, %3: !i1, %4: !i32) -> !i32 {
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %4, %5
    scf.for %0, %1, %2 scope(%6) {
      ptr.store %4, %5
      scf.if %3 {
        scf.continue %6
      } else {
        scf.yield
      }
      %7 = ptr.load %5 : !i32
      scf.yield
    }
    %8 = ptr.load %5 : !i32
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: | %[[FINAL:[0-9]+]] = scf.for %0, %1, %2 scope(%[[SCOPE:[0-9]+]]) iter_args(| %[[BODY:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: | %[[S:[0-9]+]] = ptr.store %4, %{{[0-9]+}} | %[[BODY]]
// CHECK-NEXT: | %[[GATE:[0-9]+]] = scf.if %3 args(| %[[S]]) (| %[[T:[0-9]+]]) {
// CHECK-NEXT: scf.continue %[[SCOPE]] | %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: else (| %[[E:[0-9]+]]) {
// CHECK-NEXT: scf.yield | %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} | %[[L:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[GATE]] : !i32
// CHECK-NEXT: scf.yield | %[[L]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[FINAL]] : !i32
