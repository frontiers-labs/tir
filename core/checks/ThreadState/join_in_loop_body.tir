// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A fork inside a loop body is joined before the port carries the chain out of
// the iteration: what the body yields names the memory after every read it made.

module {
  %fn_f = func.func @f(%0: !index, %1: !index, %2: !index, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    scf.for %0, %1, %2 {
      %5 = ptr.load %4 : !i32
      %6 = ptr.load %4 : !i32
      %7 = addi %5, %6 : !i32
      scf.yield
    }
    %8 = ptr.load %4 : !i32
    func.return %8
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[FINAL:[0-9]+]] = scf.for %0, %1, %2 iter_args(%[[CARRIED:[0-9]+]] = %{{[0-9]+}}) -> !state {
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[CARRIED]] -> %[[R1:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[CARRIED]] -> %[[R2:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = addi %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: %[[J:[0-9]+]] = state.join %[[R1]], %[[R2]] : !state
// CHECK-NEXT: scf.yield %[[J]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[FINAL]] -> %{{[0-9]+}})
