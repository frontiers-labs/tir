// RUN: not tir opt --pass verify-deps %s 2>&1 | filecheck %s

// The arm demands its store, but nothing demands the gate: under demand
// evaluation the arm never runs, so the store is in no cone of the function.

module {
  %f = func.func @f(%c: !i1, %p: !ptr.p<!i32>, %v: !i32) -> !i32 {
    state(%s) = state.entry_state
    state(%g) = scf.switch %c args(state(%s)) (state(%a)) {
      -> state(%a)
    }
    (state(%b)) {
      state(%s1) = ptr.store %v, %p state(%b)
      -> state(%s1)
    }
    %x, state(%r) = ptr.load %p state(%s) : !i32
    -> %x, state(%r)
  }
  module_end
}

// CHECK: ptr.store in @f is demanded by nothing
