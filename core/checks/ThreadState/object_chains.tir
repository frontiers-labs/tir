// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// Two globals are two objects the facts tell apart, so each is a memory of its
// own with a chain rooted at the state the function was entered with, and neither
// orders against the other or against the slot. The `return` hands the caller
// every object it can reach — both globals and the conservative chain — and not
// the slot, whose address never left.

module {
  %g = global @g align 4 bytes [0, 0, 0, 0]
  %h = global @h align 4 bytes [0, 0, 0, 0]
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %g
    ptr.store %0, %h
    ptr.store %0, %1
    %2 = ptr.load %g : !i32
    %3 = ptr.load %1 : !i32
    %4 = addi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: %[[UNKNOWN:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %[[G:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %[[H:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %[[SLOT:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[G]] -> %[[G1:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[H]] -> %[[H1:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[SLOT]] -> %[[SLOT1:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[G1]] -> %[[G2:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[SLOT1]] -> %{{[0-9]+}})
// CHECK-NEXT: %{{[0-9]+}} = addi %{{[0-9]+}}, %{{[0-9]+}} : !i32
// CHECK-NEXT: %[[EXPORT:[0-9]+]] = state.join %[[UNKNOWN]], %[[G2]], %[[H1]] : !state
// CHECK-NEXT: func.return %{{[0-9]+}} state(%[[EXPORT]])
