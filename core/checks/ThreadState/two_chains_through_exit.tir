// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// Two chains cross the loop as two ports, so an exit carries one state per port,
// in the order the loop carries them.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    ptr.store %1, %3
    scf.while {
      scf.condition %0
    } do scope(%4) {
      %5 = ptr.load %2 : !i32
      ptr.store %5, %3
      scf.if %0 {
        scf.break %4
      } else {
        scf.yield
      }
      scf.yield
    }
    %6 = ptr.load %3 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: do scope(%[[SCOPE:[0-9]+]])(| %[[X:[0-9]+]], %[[Y:[0-9]+]]) {
// CHECK-NEXT: %{{[0-9]+}} | %[[X1:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[X]] : !i32
// CHECK-NEXT: | %[[Y1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[Y]]
// CHECK-NEXT: | %[[G0:[0-9]+]], %[[G1:[0-9]+]] = scf.if %0 args(| %[[X1]], %[[Y1]]) (| %[[T0:[0-9]+]], %[[T1:[0-9]+]]) {
// CHECK-NEXT: scf.break %[[SCOPE]] | %[[T0]], %[[T1]]
// CHECK: scf.yield | %[[G0]], %[[G1]]
