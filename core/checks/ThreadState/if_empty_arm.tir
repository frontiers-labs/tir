// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// An arm that touches nothing still names the state entering the gate: it takes
// the chain as an argument and yields it untouched, so the memory the gate leaves
// behind is the memory it was given whenever that arm runs.

module {
  %fn_h = func.func @h(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    cfg.cond_br %0, ^then, ^join
  ^then:
    ptr.store %1, %2
    cfg.br ^join
  ^join:
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: state(%[[GATE:[0-9]+]]) = scf.switch %{{[0-9]+}} args(state(%[[IN:[0-9]+]])) (state(%[[E:[0-9]+]])) {
// CHECK-NEXT: -> state(%[[E]])
// CHECK-NEXT: }
// CHECK-NEXT: (state(%[[T:[0-9]+]])) {
// CHECK-NEXT: state(%[[T1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[T]])
// CHECK-NEXT: -> state(%[[T1]])
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}}, state(%{{[0-9]+}}) = ptr.load %{{[0-9]+}} state(%[[GATE]]) : !i32
