// RUN: tir opt --pass func.func(thread-state,unthread) --verify %s | filecheck %s

// The inverse of threading. Every `!state` value and every `state` op goes, and
// what is left is the program the order was drawn over. State ports are the
// trailing ones on operands, results and block arguments, so removing them is
// popping suffixes rather than per-chain surgery.

module {
  %g = global @g align 4 bytes [0, 0, 0, 0]
  %h = global @h align 4 bytes [0, 0, 0, 0]
  %fn_sink = func.declare @sink() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %g
    ptr.store %0, %h
    ptr.store %0, %1
    func.call %fn_sink()
    %2 = ptr.load %g : !i32
    %3 = ptr.load %1 : !i32
    %4 = addi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NOT: state
// CHECK: func.return
