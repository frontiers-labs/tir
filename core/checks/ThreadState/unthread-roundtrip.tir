// RUN: tir opt --pass func.func(thread-state) --verify %s | filecheck %s
// RUN: tir opt --pass func.func(thread-state,unthread,thread-state) --verify %s | filecheck %s

// Threading a function the inverse just emptied derives the same order it did
// the first time. Both RUN lines are checked against one set of patterns: the
// round trip is the claim, so the second run must satisfy what the first does.

module {
  %g = global @g align 4 bytes [0, 0, 0, 0]
  %h = global @h align 4 bytes [0, 0, 0, 0]
  %fn_sink = func.declare @sink() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %g
    ptr.store %0, %h
    ptr.store %0, %1
    func.call %fn_sink()
    %2 = ptr.load %g : !i32
    %3 = ptr.load %1 : !i32
    %4 = addi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: %[[UNKNOWN:[0-9]+]] = state.entry_state : !state
// CHECK: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%{{[0-9]+}} -> %[[G1:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%{{[0-9]+}} -> %[[H1:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%{{[0-9]+}} -> %[[SLOT1:[0-9]+]])
// CHECK-NEXT: %[[BEFORE:[0-9]+]] = state.join %[[UNKNOWN]], %[[G1]], %[[H1]] : !state
// CHECK-NEXT: func.call %{{[0-9]+}}() state(%[[BEFORE]] -> %[[AFTER:[0-9]+]])
// CHECK-NEXT: %{{[0-9]+}}, %[[G2:[0-9]+]], %{{[0-9]+}} = state.split %[[AFTER]] : !state, !state, !state
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[G2]] -> %{{[0-9]+}})
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[SLOT1]] -> %{{[0-9]+}})
