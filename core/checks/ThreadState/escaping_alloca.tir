// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// The slot's address reaches a call, so its contents may be observed from
// anywhere: its chain is the world chain, so the store, the call and the load
// run in that order on it.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call %fn_sink(%1 : !ptr.p<!i32>)
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}
// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: %[[SLOT:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: state(%[[ENTRY:[0-9]+]]) = state.entry_state
// CHECK-NEXT: state(%[[S1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[SLOT]] state(%[[ENTRY]])
// CHECK-NEXT: state(%[[S2:[0-9]+]]) = func.call %{{[0-9]+}}(%[[SLOT]] : !ptr.p<!i32>) state(%[[S1]])
// CHECK-NEXT: %[[VAL:[0-9]+]], state(%[[S3:[0-9]+]]) = ptr.load %[[SLOT]] state(%[[S2]]) : !i32
// CHECK-NEXT: -> %[[VAL]], state(%[[S3]])
