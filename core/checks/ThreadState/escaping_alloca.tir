// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// The slot's address reaches a call, so its contents may be observed from
// anywhere: it opens no chain of its own and its accesses join the conservative
// chain rooted at the entry state.

module {
  %fn_sink = func.declare @sink(!ptr.p<!i32>) -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call %fn_sink(%1 : !ptr.p<!i32>)
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: | %[[S1:[0-9]+]] = ptr.store %1, %{{[0-9]+}} | %[[ENTRY]]
// CHECK-NEXT: | %[[S2:[0-9]+]] = func.call %{{[0-9]+}}(%{{[0-9]+}} : !ptr.p<!i32>) | %[[S1]]
// CHECK-NEXT: %{{[0-9]+}} | %[[S3:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[S2]] : !i32
// CHECK-NEXT: func.return %{{[0-9]+}} | %[[S3]]
