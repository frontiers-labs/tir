// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// The loop body touches the slot's chain, so the chain crosses the loop as a
// carried port: the state entering the loop is the init, the body threads the
// carried argument through its accesses and yields the state it leaves, and the
// loop result is the state the accesses after the loop observe.

module {
  %fn_f = func.func @f(%0: !i64, %1: !i64, %2: !i64, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    %i1_end = scf.for %i1 = %0 to %1 step %2 {
      %5 = ptr.load %4 : !i32
      ptr.store %5, %4
      scf.yield
    }
    %6 = ptr.load %4 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: state(%[[ENTRY:[0-9]+]]) = state.entry_state
// CHECK-NEXT: state(%[[A1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[ENTRY]])
// CHECK-NEXT: %{{[0-9]+}}, state(%[[FINAL:[0-9]+]]) = scf.for %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (state(%[[CARRIED:[0-9]+]] = %[[A1]])) {
// CHECK-NEXT: %{{[0-9]+}}, state(%[[B:[0-9]+]]) = ptr.load %{{[0-9]+}} state(%[[CARRIED]]) : !i32
// CHECK-NEXT: state(%[[C:[0-9]+]]) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[B]])
// CHECK-NEXT: -> state(%[[C]])
// CHECK-NEXT: }
// CHECK-NEXT: %[[V:[0-9]+]], state(%[[R:[0-9]+]]) = ptr.load %{{[0-9]+}} state(%[[FINAL]]) : !i32
// CHECK-NEXT: -> %[[V]], state(%[[R]])
