// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// The loop body touches the slot's chain, so the chain crosses the loop as a
// carried port: the state entering the loop is the init, the body threads the
// carried argument through its accesses and yields the state it leaves, and the
// loop result is the state the accesses after the loop observe.

module {
  func.func @f(%0: !index, %1: !index, %2: !index, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    scf.for %0, %1, %2 {
      %5 = ptr.load %4 : !i32
      ptr.store %5, %4
      scf.yield
    }
    %6 = ptr.load %4 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: func.func @f
// CHECK-NEXT: %[[ENTRY:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %{{[0-9]+}} = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %[[A:[0-9]+]])
// CHECK-NEXT: ptr.store %3, %{{[0-9]+}} state(%[[A]] -> %[[A1:[0-9]+]])
// CHECK-NEXT: %[[FINAL:[0-9]+]] = scf.for %0, %1, %2 iter_args(%[[CARRIED:[0-9]+]] = %[[A1]]) -> !state {
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[CARRIED]] -> %[[B:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[B]] -> %[[C:[0-9]+]])
// CHECK-NEXT: scf.yield %[[C]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[FINAL]] -> %{{[0-9]+}})
// CHECK-NEXT: func.return %{{[0-9]+}} state(%[[ENTRY]])
