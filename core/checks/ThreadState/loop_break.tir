// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A loop leaving through `scf.break` carries the chain out along that edge: the
// gate around the exit carries the chain across its arms, and the arm that breaks
// hands the state it reached to the loop's port instead of yielding it.

module {
  %fn_f = func.func @f(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.while {
      scf.condition %0
    } do scope(%3) {
      ptr.store %1, %2
      scf.if %0 {
        scf.break %3
      } else {
        scf.yield
      }
      scf.yield
    }
    %4 = ptr.load %2 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: %[[FINAL:[0-9]+]] = scf.while iter_args(%[[COND:[0-9]+]] = %{{[0-9]+}}) -> !state {
// CHECK-NEXT: scf.condition %0, %[[COND]]
// CHECK-NEXT: }
// CHECK-NEXT: do scope(%[[SCOPE:[0-9]+]])(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: ptr.store %1, %{{[0-9]+}} state(%[[BODY]] -> %[[S:[0-9]+]])
// CHECK-NEXT: %[[GATE:[0-9]+]] = scf.if %0 args(%[[S]]) -> !state (%[[T:[0-9]+]]) {
// CHECK-NEXT: scf.break %[[SCOPE]], %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: else (%[[E:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield %[[GATE]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[FINAL]] -> %{{[0-9]+}})
