// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// Ports nest: the loop carries the chain across its iterations, and the gate
// inside it carries the carried argument across its arms, so the state the loop
// yields is the one the gate left behind.

module {
  %fn_h = func.func @h(%0: !index, %1: !index, %2: !index, %3: !i1, %4: !i32) -> !i32 {
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %4, %5
    scf.for %0, %1, %2 {
      scf.if %3 {
        ptr.store %4, %5
        scf.yield
      } else {
        scf.yield
      }
      scf.yield
    }
    %6 = ptr.load %5 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: | %[[FINAL:[0-9]+]] = scf.for %0, %1, %2 iter_args(| %[[CARRIED:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: | %[[GATE:[0-9]+]] = scf.if %3 args(| %[[CARRIED]]) (| %[[T:[0-9]+]]) {
// CHECK-NEXT: | %[[T1:[0-9]+]] = ptr.store %4, %{{[0-9]+}} | %[[T]]
// CHECK-NEXT: scf.yield | %[[T1]]
// CHECK-NEXT: }
// CHECK-NEXT: else (| %[[E:[0-9]+]]) {
// CHECK-NEXT: scf.yield | %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield | %[[GATE]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[FINAL]] : !i32
