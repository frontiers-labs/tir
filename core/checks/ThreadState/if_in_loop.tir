// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// Ports nest: the loop carries the chain across its iterations, and the gate
// inside it carries the carried argument across its arms, so the state the loop
// yields is the one the gate left behind.

module {
  %fn_h = func.func @h(%0: !i32, %1: !i1, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 = constant {value = 0} : !i32
    %5 = constant {value = 1} : !i32
    ptr.store %2, %3
    cfg.br ^head(%4 : !i32)
  ^head(%i: !i32):
    %more = cmpi %i, %0 {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body, ^exit
  ^body:
    cfg.cond_br %1, ^then, ^latch
  ^then:
    ptr.store %2, %3
    cfg.br ^latch
  ^latch:
    %i1 = addi %i, %5 : !i32
    cfg.br ^head(%i1 : !i32)
  ^exit:
    %6 = ptr.load %3 : !i32
    func.return %6
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: %{{[0-9]+}} | %[[FINAL:[0-9]+]] = scf.loop (%{{[0-9]+}} = %{{[0-9]+}} | %[[CARRIED:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: %{{[0-9]+}} = cmpi
// CHECK-NEXT: %{{[0-9]+}}, %{{[0-9]+}} | %[[EXIT:[0-9]+]] = scf.switch %{{[0-9]+}} args(| %[[CARRIED]]) (| %[[E:[0-9]+]]) {
// CHECK-NEXT: %{{[0-9]+}} = constant {value = 0} : !i1
// CHECK-NEXT: -> %{{[0-9]+}}, %{{[0-9]+}} | %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[B:[0-9]+]]) {
// CHECK-NEXT: %{{[0-9]+}} = addi
// CHECK-NEXT: | %[[GATE:[0-9]+]] = scf.switch %{{[0-9]+}} args(| %[[B]]) (| %[[S:[0-9]+]]) {
// CHECK-NEXT: -> | %[[S]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[T:[0-9]+]]) {
// CHECK-NEXT: | %[[T1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[T]]
// CHECK-NEXT: -> | %[[T1]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = constant {value = 1} : !i1
// CHECK-NEXT: -> %{{[0-9]+}}, %{{[0-9]+}} | %[[GATE]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} | %[[EXIT]], %[[EXIT]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[FINAL]] : !i32
