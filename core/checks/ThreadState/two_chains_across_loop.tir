// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// Two slots the loop touches are two memories, so two chains cross it as two
// carried ports. A gate or a loop carries state rather than accessing it: what it
// takes is one port per chain that crosses it, not the single port an access has.

module {
  %fn_f = func.func @f(%0: !index, %1: !index, %2: !index, %3: !i32) -> !i32 {
    %4 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %5 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %3, %4
    ptr.store %3, %5
    scf.for_legacy %0, %1, %2 {
      %6 = ptr.load %4 : !i32
      ptr.store %6, %5
      scf.yield
    }
    %7 = ptr.load %5 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK: | %[[X:[0-9]+]], %[[Y:[0-9]+]] = scf.for_legacy %0, %1, %2 iter_args(| %[[A:[0-9]+]] = %{{[0-9]+}}, %[[B:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: %{{[0-9]+}} | %[[A1:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[A]] : !i32
// CHECK-NEXT: | %[[B1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %[[B]]
// CHECK-NEXT: scf.yield | %[[A1]], %[[B1]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[Y]] : !i32
