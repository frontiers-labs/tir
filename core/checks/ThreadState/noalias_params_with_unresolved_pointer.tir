// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// `noalias` is not `alloca`. A slot keeps its chain past a pointer the facts
// cannot read back because escape analysis proves no such pointer reaches it;
// nothing proves that of a parameter — the caller may have handed the function
// a pointer based on it — so one unresolved access puts both qualified
// parameters back on the conservative chain.

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !ptr.p) noalias [0, 1] {
    %2 = ptr.load %0 : !ptr.p
    %3 = ptr.load %2 : !i32
    ptr.store %3, %1
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %{{[0-9]+}} | %[[A:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[ENTRY]] : !ptr.p
// CHECK-NEXT: %{{[0-9]+}} | %[[B:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[ENTRY]] : !i32
// CHECK-NEXT: | %{{[0-9]+}} = state.join | %[[A]], %[[B]]
// CHECK-NEXT: | %[[S:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %{{[0-9]+}}
// CHECK-NEXT: func.return | %[[S]]
