// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// A `noalias` parameter whose address never leaves its own accesses is as
// private as a slot: the caller guarantees nothing else the function reaches
// names that memory, so a pointer the facts cannot read back names neither
// parameter. The entry state splits three ways: a chain for each qualified
// parameter and the world chain the unresolved load reads.

module {
  %fn_f = func.func @f(%0: !ptr.p, %1: !ptr.p) noalias [0, 1] {
    %2 = ptr.load %0 : !ptr.p
    %3 = ptr.load %2 : !i32
    ptr.store %3, %1
    func.return
  }
  module_end
}
// CHECK-LABEL: %{{[0-9]+}} = func.func @f(%[[P0:[0-9]+]]: !ptr.p, %[[P1:[0-9]+]]: !ptr.p)
// CHECK-NEXT: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %[[E0:[0-9]+]], %[[E1:[0-9]+]], %[[WORLD:[0-9]+]] = state.split state(%[[ENTRY]])
// CHECK-NEXT: %[[PTR:[0-9]+]], %[[A:[0-9]+]] = ptr.load %[[P0]] state(%[[E0]]) : !ptr.p
// CHECK-NEXT: %[[VAL:[0-9]+]], %[[B:[0-9]+]] = ptr.load %[[PTR]] state(%[[WORLD]]) : !i32
// CHECK-NEXT: %[[S:[0-9]+]] = ptr.store %[[VAL]], %[[P1]] state(%[[E1]])
// CHECK-NEXT: %[[EXIT:[0-9]+]] = state.join state(%[[A]], %[[S]], %[[B]])
// CHECK-NEXT: -> %[[EXIT]]
