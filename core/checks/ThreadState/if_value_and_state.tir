// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// A gate that already merges a value keeps it: the chain becomes one more port
// beside it, so the arms yield their value first and the state they leave second.

module {
  %fn_h = func.func @h(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    cfg.cond_br %0, ^then, ^else
  ^then:
    %3 = ptr.load %2 : !i32
    cfg.br ^join(%3 : !i32)
  ^else:
    cfg.br ^join(%1 : !i32)
  ^join(%4: !i32):
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: %[[VALUE:[0-9]+]] | %[[STATE:[0-9]+]] = scf.switch %{{[0-9]+}} args(| %{{[0-9]+}}) (| %[[E:[0-9]+]]) {
// CHECK-NEXT: -> %{{[0-9]+}} | %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: (| %[[T:[0-9]+]]) {
// CHECK-NEXT: %[[READ:[0-9]+]] | %[[T1:[0-9]+]] = ptr.load %{{[0-9]+}} | %[[T]] : !i32
// CHECK-NEXT: -> %[[READ]] | %[[T1]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[VALUE]] | %[[STATE]]
