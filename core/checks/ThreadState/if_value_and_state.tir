// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A gate that already merges a value keeps it: the chain becomes one more port
// beside it, so the arms yield their value first and the state they leave second.

module {
  %fn_h = func.func @h(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    %3 = scf.if %0 -> !i32 {
      %4 = ptr.load %2 : !i32
      scf.yield %4
    } else {
      scf.yield %1
    }
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: %[[VALUE:[0-9]+]], %{{[0-9]+}} = scf.if %0 args(%{{[0-9]+}}) -> !i32, !state (%[[T:[0-9]+]]) {
// CHECK-NEXT: %[[READ:[0-9]+]] = ptr.load %{{[0-9]+}} : !i32 state(%[[T]] -> %[[T1:[0-9]+]])
// CHECK-NEXT: scf.yield %[[READ]], %[[T1]]
// CHECK-NEXT: }
// CHECK-NEXT: else (%[[E:[0-9]+]]) {
// CHECK-NEXT: scf.yield %1, %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[VALUE]]
