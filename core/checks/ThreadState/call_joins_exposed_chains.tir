// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A call touches every object the outside can reach, so the globals' chains and
// the conservative one cross it through its single port: joined into the state it
// observes, named again out of the state it leaves. The slot's address never left
// the function, so nothing the call does can be about it and its chain runs past
// the call untouched.

module {
  %g = global @g align 4 bytes [0, 0, 0, 0]
  %h = global @h align 4 bytes [0, 0, 0, 0]
  %fn_sink = func.declare @sink() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %g
    ptr.store %0, %h
    ptr.store %0, %1
    func.call %fn_sink()
    %2 = ptr.load %g : !i32
    %3 = ptr.load %1 : !i32
    %4 = addi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: | %[[UNKNOWN:[0-9]+]] = state.entry_state
// CHECK: | %[[G1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %{{[0-9]+}}
// CHECK-NEXT: | %[[H1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %{{[0-9]+}}
// CHECK-NEXT: | %[[SLOT1:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} | %{{[0-9]+}}
// CHECK-NEXT: | %[[BEFORE:[0-9]+]] = state.join | %[[UNKNOWN]], %[[G1]], %[[H1]]
// CHECK-NEXT: | %[[AFTER:[0-9]+]] = func.call %{{[0-9]+}}() | %[[BEFORE]]
// CHECK-NEXT: | %{{[0-9]+}}, %[[G2:[0-9]+]], %{{[0-9]+}} = state.split | %[[AFTER]]
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[G2]] : !i32
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[SLOT1]] : !i32
