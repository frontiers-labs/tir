// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// `restrict` on both pointer parameters says each names memory nothing else the
// function reaches names, so the facts tell the two apart and each is a memory
// of its own: the load of one and the store to the other order against nothing.

module {
  %fn_axpy = func.func @axpy(%0: !ptr.p, %1: !ptr.p) noalias [0, 1] {
    %2 = ptr.load %1 : !i32
    ptr.store %2, %0
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @axpy
// CHECK-NEXT: %[[UNKNOWN:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %[[Y:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %[[X:[0-9]+]] = state.entry_state : !state
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[X]] -> %[[X1:[0-9]+]])
// CHECK-NEXT: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[Y]] -> %[[Y1:[0-9]+]])
// CHECK-NEXT: %[[EXPORT:[0-9]+]] = state.join %[[UNKNOWN]], %[[Y1]], %[[X1]] : !state
// CHECK-NEXT: func.return state(%[[EXPORT]])
