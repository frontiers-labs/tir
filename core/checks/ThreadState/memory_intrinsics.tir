// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// The intrinsics name whole ranges of unknown memory, so they are one object:
// both writes sit on one chain and stay ordered as they are written.

module {
  %fn_c = func.func @c(%0: !ptr.p, %1: !ptr.p, %2: !i8, %3: !i64) {
    ptr.memset %0, %2, %3
    ptr.memcpy %1, %0, %3
    func.return
  }
  module_end
}
// CHECK-LABEL: %{{[0-9]+}} = func.func @c(%[[DST:[0-9]+]]: !ptr.p, %[[SRC:[0-9]+]]: !ptr.p, %[[BYTE:[0-9]+]]: !i8, %[[LEN:[0-9]+]]: !i64)
// CHECK-NEXT: state(%[[ENTRY:[0-9]+]]) = state.entry_state
// CHECK-NEXT: state(%[[S1:[0-9]+]]) = ptr.memset %[[DST]], %[[BYTE]], %[[LEN]] state(%[[ENTRY]])
// CHECK-NEXT: state(%[[S2:[0-9]+]]) = ptr.memcpy %[[SRC]], %[[DST]], %[[LEN]] state(%[[S1]])
// CHECK-NEXT: -> state(%[[S2]])
