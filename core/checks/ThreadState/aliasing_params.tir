// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// Without the qualifier two parameters may name the same memory, so they are one
// object on one chain, and the store lands after the load that observes it with
// no join to say so.

module {
  %fn_axpy = func.func @axpy(%0: !ptr.p, %1: !ptr.p) {
    %2 = ptr.load %1 : !i32
    ptr.store %2, %0
    func.return
  }
  module_end
}
// CHECK-LABEL: %{{[0-9]+}} = func.func @axpy(%[[DST:[0-9]+]]: !ptr.p, %[[SRC:[0-9]+]]: !ptr.p)
// CHECK-NEXT: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %[[VAL:[0-9]+]], %[[READ:[0-9]+]] = ptr.load %[[SRC]] state(%[[ENTRY]]) : !i32
// CHECK-NEXT: %[[WRITE:[0-9]+]] = ptr.store %[[VAL]], %[[DST]] state(%[[READ]])
// CHECK-NEXT: -> %[[WRITE]]
