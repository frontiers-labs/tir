// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// A chain crossing a gate enters each arm as an entry argument, so each arm names
// its own copy of the state entering the gate rather than sharing one value, and
// the gate's result is the state the code after it observes.

module {
  %fn_h = func.func @h(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    cfg.cond_br %0, ^then, ^else
  ^then:
    ptr.store %1, %2
    cfg.br ^join
  ^else:
    ptr.store %1, %2
    cfg.br ^join
  ^join:
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK-NEXT: %[[P:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: state(%[[ENTRY:[0-9]+]]) = state.entry_state
// CHECK-NEXT: state(%[[A1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[P]] state(%[[ENTRY]])
// CHECK-NEXT: state(%[[GATE:[0-9]+]]) = scf.switch %{{[0-9]+}} args(state(%[[A1]])) (state(%[[E:[0-9]+]])) {
// CHECK-NEXT: state(%[[E1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[P]] state(%[[E]])
// CHECK-NEXT: -> state(%[[E1]])
// CHECK-NEXT: }
// CHECK-NEXT: (state(%[[T:[0-9]+]])) {
// CHECK-NEXT: state(%[[T1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[P]] state(%[[T]])
// CHECK-NEXT: -> state(%[[T1]])
// CHECK-NEXT: }
// CHECK-NEXT: %[[V:[0-9]+]], state(%[[R:[0-9]+]]) = ptr.load %[[P]] state(%[[GATE]]) : !i32
// CHECK-NEXT: -> %[[V]], state(%[[R]])
