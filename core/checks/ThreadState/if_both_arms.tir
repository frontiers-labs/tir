// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A chain crossing a gate enters each arm as an entry argument, so each arm names
// its own copy of the state entering the gate rather than sharing one value, and
// the gate's result is the state the code after it observes.

module {
  %fn_h = func.func @h(%0: !i1, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.if %0 {
      ptr.store %1, %2
      scf.yield
    } else {
      ptr.store %1, %2
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK-NEXT: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %{{[0-9]+}} | %[[A:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: | %[[A1:[0-9]+]] = ptr.store %1, %{{[0-9]+}} | %[[A]]
// CHECK-NEXT: | %[[GATE:[0-9]+]] = scf.if %0 args(| %[[A1]]) (| %[[T:[0-9]+]]) {
// CHECK-NEXT: | %[[T1:[0-9]+]] = ptr.store %1, %{{[0-9]+}} | %[[T]]
// CHECK-NEXT: scf.yield | %[[T1]]
// CHECK-NEXT: }
// CHECK-NEXT: else (| %[[E:[0-9]+]]) {
// CHECK-NEXT: | %[[E1:[0-9]+]] = ptr.store %1, %{{[0-9]+}} | %[[E]]
// CHECK-NEXT: scf.yield | %[[E1]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[GATE]] : !i32
// CHECK-NEXT: func.return %{{[0-9]+}} | %[[ENTRY]]
