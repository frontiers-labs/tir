// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// The n-ary gate carries the chain the same way: every arm takes the state
// entering the switch, the default one included, and the arm that runs decides
// which state the code after it observes.

module {
  %fn_h = func.func @h(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 = constant {value = 1} : !i32
    %4 = constant {value = 2} : !i32
    ptr.store %1, %2
    %5 = cmpi %0, %3 {predicate = "eq"} : !i1
    cfg.cond_br %5, ^case1, ^test2
  ^test2:
    %6 = cmpi %0, %4 {predicate = "eq"} : !i1
    cfg.cond_br %6, ^case2, ^join
  ^case1:
    ptr.store %1, %2
    cfg.br ^join
  ^case2:
    ptr.store %3, %2
    cfg.br ^join
  ^join:
    %7 = ptr.load %2 : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: state(%[[OUTER:[0-9]+]]) = scf.switch %{{[0-9]+}} args(state(%{{[0-9]+}})) (state(%[[N1:[0-9]+]])) {
// CHECK-NEXT: %{{[0-9]+}} = cmpi
// CHECK-NEXT: state(%[[INNER:[0-9]+]]) = scf.switch %{{[0-9]+}} args(state(%[[N1]])) (state(%[[D:[0-9]+]])) {
// CHECK-NEXT: -> state(%[[D]])
// CHECK-NEXT: }
// CHECK-NEXT: (state(%[[C2:[0-9]+]])) {
// CHECK-NEXT: state(%[[S2:[0-9]+]]) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[C2]])
// CHECK-NEXT: -> state(%[[S2]])
// CHECK-NEXT: }
// CHECK-NEXT: -> state(%[[INNER]])
// CHECK-NEXT: }
// CHECK-NEXT: (state(%[[C1:[0-9]+]])) {
// CHECK-NEXT: state(%[[S1:[0-9]+]]) = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[C1]])
// CHECK-NEXT: -> state(%[[S1]])
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}}, state(%{{[0-9]+}}) = ptr.load %{{[0-9]+}} state(%[[OUTER]]) : !i32
