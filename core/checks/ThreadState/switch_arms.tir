// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// The n-ary gate carries the chain the same way: every arm takes the state
// entering the switch, the default one included, and the arm that runs decides
// which state the code after it observes.

module {
  %fn_h = func.func @h(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %2
    scf.switch %0 case 1 {
      ptr.store %1, %2
      scf.yield
    }
    default {
      scf.yield
    }
    %3 = ptr.load %2 : !i32
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @h
// CHECK: %[[GATE:[0-9]+]] = scf.switch %0 args(%{{[0-9]+}}) -> !state case 1 (%[[C:[0-9]+]]) {
// CHECK-NEXT: ptr.store %1, %{{[0-9]+}} state(%[[C]] -> %[[C1:[0-9]+]])
// CHECK-NEXT: scf.yield %[[C1]]
// CHECK-NEXT: }
// CHECK-NEXT: default (%[[D:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[D]]
// CHECK-NEXT: }
// CHECK-NEXT: %{{[0-9]+}} = ptr.load %{{[0-9]+}} : !i32 state(%[[GATE]] -> %{{[0-9]+}})
