// RUN: tir opt --pass thread-state --verify %s | filecheck %s

// A call may touch anything that escaped, so it consumes and produces the
// conservative chain. The private slot's chain runs past it untouched: the store
// after the call still observes the state the store before it left.

module {
  %fn_tick = func.declare @tick() -> !unit
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %1
    func.call %fn_tick()
    %2 = ptr.load %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @f
// CHECK-NEXT: | %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %{{[0-9]+}} | %[[A:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: | %[[A1:[0-9]+]] = ptr.store %1, %{{[0-9]+}} | %[[A]]
// CHECK-NEXT: | %[[S1:[0-9]+]] = func.call %{{[0-9]+}}() | %[[ENTRY]]
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %{{[0-9]+}} | %[[A1]] : !i32
// CHECK-NEXT: func.return %{{[0-9]+}} | %[[S1]]
