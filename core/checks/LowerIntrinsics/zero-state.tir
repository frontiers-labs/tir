// RUN: tir opt --pass restructure-nodes --pass lower-intrinsics --pass verify-deps --verify %s | filecheck %s

module {target_env = {memory_inline_bytes = 0}} {
  %copy = func.func @zero(%dst: !ptr.p, %src: !ptr.p, %byte: !i8) {
    %n = constant {value = 0} : !i64
    ptr.memcpy %dst, %src, %n
    ptr.memset %dst, %byte, %n
    func.return
  }
  module_end
}

// CHECK-LABEL: func.func @zero
// CHECK: %[[STATE:[0-9]+]] = state.entry_state
// CHECK-NOT: ptr.memcpy
// CHECK-NOT: ptr.memset
// CHECK-NOT: ptr.load
// CHECK-NOT: ptr.store
// CHECK: -> %[[STATE]]
