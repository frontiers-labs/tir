// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: not tir opt --pass lower-intrinsics %s 2>&1 | filecheck %s

module {target_env = {memory_copy_bytes = [32]}} {
  %copy = func.func @copy(%dst: !ptr.p, %src: !ptr.p) {
    %n = constant {value = 32} : !i64
    ptr.memcpy %dst, %src, %n
    func.return
  }
  module_end
}

// CHECK: memory_copy_bytes contains an unsupported access width
