// RUN: not tir opt --pass lower-intrinsics %s 2>&1 | filecheck %s

module {target_env = {libc = false}} {
  %copy = func.func @copy(%dst: !ptr.p, %src: !ptr.p, %n: !i64) {
    ptr.memcpy %dst, %src, %n
    func.return
  }
  module_end
}

// CHECK: cannot expand memcpy: no inline implementation fits and libc is unavailable
