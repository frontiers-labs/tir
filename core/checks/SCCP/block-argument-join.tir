// RUN: tir opt --pass func.func(sccp) %s | filecheck %s

// The merge argument is fed the same literal on every edge that reaches it, so
// it is constant however the branch goes — a fact no local fold can see.

module {
  %fn_f = func.func @f(%c: !i1) -> !i32 {
    %0 = constant {value = 5} : !i32
    cfg.cond_br %c, ^bb1(%0 : !i32), ^bb2(%0 : !i32)
  ^bb1(%1: !i32):
    cfg.br ^bb3(%1 : !i32)
  ^bb2(%2: !i32):
    cfg.br ^bb3(%2 : !i32)
  ^bb3(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK: ^bb3(%{{[0-9]+}}: !i32):
// CHECK-NEXT: %[[C:[0-9]+]] = constant {value = 5} : !i32
// CHECK-NEXT: func.return %[[C]]
