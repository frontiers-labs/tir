// RUN: tir opt --pass restructure-nodes,verify-deps --verify %s | filecheck %s

module {
  %f = func.func @repeat(%count: !i32, %a: !f32, %b: !f32) -> !i5 {
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    cfg.br ^head(%zero : !i32)
  ^head(%i: !i32):
    %more = cmpi %i, %count {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body, ^exit
  ^body:
    %unused = fp.div %a, %b {semantics = {exceptions = "flags"}} : !f32
    %next = addi %i, %one : !i32
    cfg.br ^head(%next : !i32)
  ^exit:
    %flags = fp.get_flags : !i5
    func.return %flags
  }
  module_end
}

// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state : !state<fp.env>
// CHECK: %{{[0-9]+}}, %[[ENV:[0-9]+]] = scf.loop ({{.*}}%[[PORT:[0-9]+]] = %[[ENTRY]]) {
// CHECK: %{{[0-9]+}}, %[[NEXT:[0-9]+]] = scf.switch {{.*}} args(%[[PORT]]) (%[[EXIT:[0-9]+]]) {
// CHECK: -> {{.*}}%[[EXIT]]
// CHECK: (%[[BODY:[0-9]+]]) {
// CHECK: %{{[0-9]+}}, %[[DIV:[0-9]+]] = fp.div {{.*}} state(%[[BODY]]) {semantics = {exceptions = "flags"}}
// CHECK: -> {{.*}}%[[DIV]]
// CHECK: %{{[0-9]+}}, %{{[0-9]+}} = fp.get_flags state(%[[ENV]]) : !i5
