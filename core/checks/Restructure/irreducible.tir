// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// The classic irreducible loop: two blocks entered from outside and from each
// other. Restructuring gives it one entry — a dispatch on which of the two the
// edge wanted — instead of copying either of them.

module {
  %fn_irr = func.func @irr(%0: !i1, %1: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %2 = addi %1, %1 : !i32
    cfg.br ^bb2
  ^bb2:
    %3 = subi %1, %1 : !i32
    cfg.cond_br %0, ^bb1, ^bb3
  ^bb3:
    func.return %1
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @irr
// CHECK-NOT: br
// CHECK: %[[ENTRY:[0-9]+]] = scf.switch %{{[0-9]+}} {
// CHECK: scf.loop (%[[SEL:[0-9]+]] = %[[ENTRY]]) {
// CHECK-NEXT: %{{[0-9]+}}, %{{[0-9]+}} = scf.switch %[[SEL]] {
// CHECK-NEXT: %{{[0-9]+}} = addi
// CHECK: -> %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: %{{[0-9]+}} = subi
// CHECK: -> %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: -> %{{[0-9]+}}
