// IR migration: the requested transformation pass is a registered no-op.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// A head-controlled counted loop accumulating into a slot. The loop becomes an
// `scf.loop` whose body tests first and stores only when it repeats; the
// counter and memory chain cross the iteration as ports; its original
// comparison decides repetition. With n = 0 the store never runs.

module {
  %fn_sum = func.func @sum(%0: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    ptr.store %zero, %p
    cfg.br ^head(%zero : !i32)
  ^head(%i: !i32):
    %more = cmpi %i, %0 {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body, ^exit
  ^body:
    %acc = ptr.load %p : !i32
    %next = addi %acc, %i : !i32
    ptr.store %next, %p
    %i1 = addi %i, %one : !i32
    cfg.br ^head(%i1 : !i32)
  ^exit:
    %r = ptr.load %p : !i32
    func.return %r
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @sum
// CHECK: %[[I:[0-9]+]], %[[M:[0-9]+]] = scf.loop (%[[IP:[0-9]+]] = %{{[0-9]+}}, %[[D:[0-9]+]] = %{{[0-9]+}}) {
// CHECK-NEXT: %[[MORE:[0-9]+]] = cmpi %[[IP]], %{{[0-9]+}} {predicate = "slt"} : !i1
// CHECK-NEXT: %{{[0-9]+}} = constant {value = 0} : !i1
// CHECK-NEXT: %[[NI:[0-9]+]], %[[ND:[0-9]+]] = scf.switch %[[MORE]] args(%[[D]]) (%[[E:[0-9]+]]) {
// CHECK-NEXT: %[[STOP:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[IP]], %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: (%[[B:[0-9]+]]) {
// CHECK-NEXT: %{{[0-9]+}}, %[[R:[0-9]+]] = ptr.load %{{[0-9]+}} state(%[[B]]) : !i32
// CHECK: %[[S:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[R]])
// CHECK: -> %{{[0-9]+}}, %[[S]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[MORE]], %[[NI]], %[[NI]], %[[ND]], %[[ND]]
// CHECK-NEXT: }
// CHECK-NEXT: %[[V:[0-9]+]], %[[VD:[0-9]+]] = ptr.load %{{[0-9]+}} state(%[[M]]) : !i32
// CHECK-NEXT: -> %[[V]], %[[VD]]
