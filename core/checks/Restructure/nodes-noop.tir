// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// A function whose body is already unordered is left as it is.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1, state(%2) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%3) = ptr.store %0, %1 state(%2)
    %4, state(%5) = ptr.load %1 state(%3) : !i32
    -> %4, state(%5)
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @f(%[[A:[0-9]+]]: !i32) -> !i32 {
// CHECK-NEXT: %[[P:[0-9]+]], state(%[[D:[0-9]+]]) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: state(%[[S:[0-9]+]]) = ptr.store %[[A]], %[[P]] state(%[[D]])
// CHECK-NEXT: %[[V:[0-9]+]], state(%[[R:[0-9]+]]) = ptr.load %[[P]] state(%[[S]]) : !i32
// CHECK-NEXT: -> %[[V]], state(%[[R]])
// CHECK-NEXT: }
