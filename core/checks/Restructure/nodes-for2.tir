// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s
// RUN: tir interp %s -f sum --args=4 | filecheck --check-prefix=FOUR %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f sum --args=4 | filecheck --check-prefix=FOUR %s
// RUN: tir interp %s -f sum --args=0 | filecheck --check-prefix=ZERO %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f sum --args=0 | filecheck --check-prefix=ZERO %s
// RUN: tir opt --pass restructure-nodes --shuffle-seed 1 %s | tir interp -f sum --args=4 | filecheck --check-prefix=FOUR %s
// RUN: tir opt --pass restructure-nodes --shuffle-seed 7 %s | tir interp -f sum --args=4 | filecheck --check-prefix=FOUR %s

// The counted loop `raise-loops` emits: the counter is carried and written back
// to its slot at the top of every iteration. It becomes `scf.for` with the
// counter as port 0, the carried argument following, and one dependency port
// per slot, since neither slot's address escapes its own accesses and no chain
// joins the other. With n = 0 the body never runs and the slot keeps its first
// store.

module {
  %fn_sum = func.func @sum(%0: !i32) -> !i32 {
    %i = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %t = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    ptr.store %zero, %t
    ptr.store %zero, %i
    %lb = ptr.load %i : !i32
    %i1_end, %fin = scf.for %i1 = %lb to %0 step %one (%iv = %lb) {
      ptr.store %iv, %i
      %a = ptr.load %t : !i32
      %c = ptr.load %i : !i32
      %s = addi %a, %c : !i32
      ptr.store %s, %t
      %next = addi %iv, %one : !i32
      scf.yield %next
    }
    ptr.store %fin, %i
    %r = ptr.load %t : !i32
    %k = ptr.load %i : !i32
    %out = addi %r, %k : !i32
    func.return %out
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @sum(%[[N:[0-9]+]]: !i32) -> !i32 {
// CHECK: state(%[[ENTRY:[0-9]+]]) = state.entry_state
// CHECK-NEXT: state(%[[EI:[0-9]+]], %[[ET:[0-9]+]]) = state.split state(%[[ENTRY]])
// CHECK-NEXT: state(%[[TS:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[T:[0-9]+]] state(%[[ET]])
// CHECK-NEXT: state(%[[IS:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[I:[0-9]+]] state(%[[EI]])
// CHECK-NEXT: %[[LB:[0-9]+]], state(%[[LBS:[0-9]+]]) = ptr.load %[[I]] state(%[[IS]]) : !i32
// CHECK-NEXT: %{{[0-9]+}}, %[[FIN:[0-9]+]], state(%[[MI:[0-9]+]], %[[MT:[0-9]+]]) = scf.for %[[C:[0-9]+]] = %[[LB]] to %[[N]] step %[[ONE:[0-9]+]] (%[[IV:[0-9]+]] = %[[LB]], state(%[[DI:[0-9]+]] = %[[LBS]], %[[DT:[0-9]+]] = %[[TS]])) {
// CHECK-NEXT: state(%[[S1:[0-9]+]]) = ptr.store %[[IV]], %[[I]] state(%[[DI]])
// CHECK-NEXT: %{{[0-9]+}}, state(%[[R1:[0-9]+]]) = ptr.load %[[T]] state(%[[DT]]) : !i32
// CHECK-NEXT: %{{[0-9]+}}, state(%[[R2:[0-9]+]]) = ptr.load %[[I]] state(%[[S1]]) : !i32
// CHECK: state(%[[S2:[0-9]+]]) = ptr.store %{{[0-9]+}}, %[[T]] state(%[[R1]])
// CHECK-NEXT: %[[NEXT:[0-9]+]] = addi %[[IV]], %[[ONE]] : !i32
// CHECK-NEXT: -> %[[NEXT]], state(%[[R2]], %[[S2]])
// CHECK-NEXT: }
// CHECK-NEXT: state(%{{[0-9]+}}) = ptr.store %[[FIN]], %[[I]] state(%[[MI]])
// CHECK-NEXT: %{{[0-9]+}}, state(%{{[0-9]+}}) = ptr.load %[[T]] state(%[[MT]]) : !i32

// FOUR: i32 10
// ZERO: i32 0
