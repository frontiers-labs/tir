// RUN: tir opt --pass restructure --verify %s | filecheck %s

// Two arms joining at a block parameter: the parameter becomes the result of
// the `scf.if` the arms turned into.

module {
  func.func @pick(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %3 = addi %1, %2 : !i32
    cfg.br ^bb3(%3 : !i32)
  ^bb2:
    %4 = subi %1, %2 : !i32
    cfg.br ^bb3(%4 : !i32)
  ^bb3(%5: !i32):
    func.return %5
  }
  module_end
}

// CHECK-LABEL: func.func @pick
// CHECK-NOT: br
// CHECK: %[[R:[0-9]+]] = scf.if %{{[0-9]+}} -> !i32 {
// CHECK-NEXT: %[[T:[0-9]+]] = addi
// CHECK-NEXT: scf.yield %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: %[[E:[0-9]+]] = subi
// CHECK-NEXT: scf.yield %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[R]]
