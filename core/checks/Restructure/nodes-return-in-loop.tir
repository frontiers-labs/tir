// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s
// RUN: tir interp %s -f find --args=2 | filecheck --check-prefix=FOUND %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f find --args=2 | filecheck --check-prefix=FOUND %s
// RUN: tir interp %s -f find --args=7 | filecheck --check-prefix=MISSED %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f find --args=7 | filecheck --check-prefix=MISSED %s
// RUN: tir opt --pass restructure-nodes --shuffle-seed 1 %s | tir interp -f find --args=2 | filecheck --check-prefix=FOUND %s
// RUN: tir opt --pass restructure-nodes --shuffle-seed 7 %s | tir interp -f find --args=2 | filecheck --check-prefix=FOUND %s

// A return inside the loop and one after it. The exits merge into one before
// conversion, so the callable's results are the value and memory whichever
// return produced, and the stores each path made are on the chain it hands
// back.

module {
  %fn_find = func.func @find(%0: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    %four = constant {value = 4} : !i32
    %ten = constant {value = 10} : !i32
    ptr.store %zero, %p
    cfg.br ^head(%zero : !i32)
  ^head(%i: !i32):
    %more = cmpi %i, %four {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body, ^exit
  ^body:
    %acc = ptr.load %p : !i32
    %next = addi %acc, %ten : !i32
    ptr.store %next, %p
    %hit = cmpi %i, %0 {predicate = "eq"} : !i1
    cfg.cond_br %hit, ^found, ^step
  ^found:
    %m = ptr.load %p : !i32
    %found = addi %m, %one : !i32
    func.return %found
  ^step:
    %i1 = addi %i, %one : !i32
    cfg.br ^head(%i1 : !i32)
  ^exit:
    %r = ptr.load %p : !i32
    func.return %r
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @find
// CHECK: scf.loop
// CHECK-NOT: func.return
// CHECK: -> %{{[0-9]+}} | %{{[0-9]+}}
// CHECK-NEXT: }

// FOUND: i32 31
// MISSED: i32 40
