// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// One arm jumping straight to the join: the empty arm yields the value that
// already reached the branch.

module {
  %fn_maybe_double = func.func @maybe_double(%0: !i1, %1: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2(%1 : !i32)
  ^bb1:
    %2 = addi %1, %1 : !i32
    cfg.br ^bb2(%2 : !i32)
  ^bb2(%3: !i32):
    func.return %3
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @maybe_double
// CHECK-NOT: br
// CHECK: %[[R:[0-9]+]] = scf.switch %[[C:[0-9]+]] {
// CHECK-NEXT: -> %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: %[[T:[0-9]+]] = addi
// CHECK-NEXT: -> %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[R]]
