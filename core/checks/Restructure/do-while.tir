// RUN: tir opt --pass restructure --verify %s | filecheck %s

// A tail-controlled loop needs no dispatch: the value the body computes leaves
// through a carried port, since the structure closes the loop before the exit
// reads it.

module {
  func.func @dowhile(%0: !i32) -> !i32 {
    cfg.br ^bb1(%0 : !i32)
  ^bb1(%1: !i32):
    %2 = addi %1, %1 : !i32
    %3 = cmpi %2, %0 {predicate = "slt"} : !i1
    cfg.cond_br %3, ^bb1(%2 : !i32), ^bb2
  ^bb2:
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @dowhile
// CHECK-NOT: br
// CHECK: scf.while iter_args
// CHECK: %[[SUM:[0-9]+]] = addi
// CHECK: cmpi
// CHECK: scf.condition %{{[0-9]+}}, %{{[0-9]+}}, %[[SUM]]
