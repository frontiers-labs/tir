// RUN: not tir opt --pass restructure --verify %s 2>&1 | filecheck %s

// A body that mixes branches with structured control flow is in neither form:
// restructuring consumes CFG form, so the `scf.if` is a precondition violation.

module {
  func.func @mixed(%0: !i1, %1: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %2 = addi %1, %1 : !i32
    cfg.br ^bb3(%2 : !i32)
  ^bb2:
    cfg.br ^bb3(%1 : !i32)
  ^bb3(%3: !i32):
    %4 = scf.if %0 -> !i32 {
      scf.yield %3
    } else {
      scf.yield %1
    }
    func.return %4
  }
  module_end
}

// CHECK: dialect 'scf' is not part of the 'cfg' form
