// RUN: tir opt --pass restructure-nodes,verify-deps --verify %s | filecheck %s

// The slot's address is handed to a call, so a pointer of unknown provenance
// may name it: its chain is one the world reaches. Every effect here names
// both that chain and the world's, so nothing ever tells the two apart and
// they are one chain — which is the whole of what a merge and a split at every
// effect would have said. The read after the call observes what the call left,
// not what the write before it did.

module {
  %fn_h = func.declare @h(!ptr.p<!i32>) -> !unit
  %fn_f = func.func @f(%v: !i32) -> !i32 {
    %a = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %v, %a
    func.call %fn_h(%a : !ptr.p<!i32>)
    %x = ptr.load %a : !i32
    func.return %x
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @f(%[[V:[0-9]+]]: !i32) -> !i32 {
// CHECK: %[[ENTRY:[0-9]+]] = state.entry_state
// CHECK-NEXT: %[[S:[0-9]+]] = ptr.store %[[V]], %[[A:[0-9]+]] state(%[[ENTRY]])
// CHECK-NEXT: %[[C:[0-9]+]] = func.call %{{[0-9]+}}(%[[A]] : !ptr.p<!i32>) state(%[[S]])
// CHECK-NEXT: %[[X:[0-9]+]], %[[R:[0-9]+]] = ptr.load %[[A]] state(%[[C]]) : !i32
// CHECK-NEXT: -> %[[X]], %[[R]]
