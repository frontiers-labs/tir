// RUN: tir opt --pass restructure --verify %s | filecheck %s

// A switch lowered to a comparison chain: each test is a conditional, and the
// arms rejoin in one place, so no continuation predicate is needed.

module {
  func @sw(%0: !i32, %1: !i32) -> !i32 {
    %2 = constant {value = 1} : !i32
    %3 = cmpi %0, %2 {predicate = "eq"} : !i1
    cfg.cond_br %3, ^bb3, ^bb1
  ^bb1:
    %4 = constant {value = 2} : !i32
    %5 = cmpi %0, %4 {predicate = "eq"} : !i1
    cfg.cond_br %5, ^bb4, ^bb2
  ^bb2:
    %6 = subi %1, %1 : !i32
    cfg.br ^bb5(%6 : !i32)
  ^bb3:
    cfg.br ^bb5(%1 : !i32)
  ^bb4:
    %7 = addi %1, %1 : !i32
    cfg.br ^bb5(%7 : !i32)
  ^bb5(%8: !i32):
    return %8
  }
  module_end
}

// CHECK-LABEL: func @sw
// CHECK-NOT: br
// CHECK-NOT: scf.switch
// CHECK: %[[OUTER:[0-9]+]] = scf.if %{{[0-9]+}} -> !i32 {
// CHECK: %[[INNER:[0-9]+]] = scf.if %{{[0-9]+}} -> !i32 {
// CHECK: addi
// CHECK: subi
// CHECK: return %[[OUTER]]
