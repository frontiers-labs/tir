// RUN: tir opt --pass restructure --verify %s | filecheck %s

// A branch inside a branch: the inner join is the continuation of the inner
// conditional, the outer join the continuation of the outer one.

module {
  %fn_nest = func.func @nest(%0: !i1, %1: !i1, %2: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb4(%2 : !i32)
  ^bb1:
    cfg.cond_br %1, ^bb2, ^bb3
  ^bb2:
    %3 = addi %2, %2 : !i32
    cfg.br ^bb4(%3 : !i32)
  ^bb3:
    %4 = subi %2, %2 : !i32
    cfg.br ^bb4(%4 : !i32)
  ^bb4(%5: !i32):
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @nest
// CHECK-NOT: br
// CHECK: %[[OUTER:[0-9]+]] = scf.if %{{[0-9]+}} -> !i32 {
// CHECK-NEXT: %[[INNER:[0-9]+]] = scf.if %{{[0-9]+}} -> !i32 {
// CHECK-NEXT: %[[T:[0-9]+]] = addi
// CHECK-NEXT: scf.yield %[[T]]
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: %[[E:[0-9]+]] = subi
// CHECK-NEXT: scf.yield %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: scf.yield %[[INNER]]
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: scf.yield %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[OUTER]]
