// RUN: tir opt --pass restructure --verify %s | filecheck %s

// A jump into the middle of a comparison chain — the shape a `goto` into a
// `switch` body makes. The arms rejoin in two places, so a continuation
// variable says which, and the block jumped into is emitted once.

module {
  func @gis(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    cfg.cond_br %0, ^bb3, ^bb1
  ^bb1:
    %3 = constant {value = 1} : !i32
    %4 = cmpi %1, %3 {predicate = "eq"} : !i1
    cfg.cond_br %4, ^bb2, ^bb3
  ^bb2:
    %5 = addi %2, %2 : !i32
    cfg.br ^bb4(%5 : !i32)
  ^bb3:
    %6 = subi %2, %2 : !i32
    cfg.br ^bb4(%6 : !i32)
  ^bb4(%7: !i32):
    return %7
  }
  module_end
}

// CHECK-LABEL: func @gis
// CHECK-NOT: br
// CHECK: scf.if
// CHECK: cmpi
// CHECK: scf.if
// CHECK: addi
// CHECK: scf.switch %{{[0-9]+}} -> !i32 case 0 {
// CHECK: subi
// CHECK: }
// CHECK: default {
// CHECK: return
