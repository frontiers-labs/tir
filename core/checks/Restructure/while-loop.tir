// RUN: tir opt --pass restructure --verify %s | filecheck %s

// A head-controlled loop becomes the tail-controlled shape: the test and the
// body both live in the condition region, and the repetition predicate says
// whether the iteration that just ran was the last one.

module {
  func.func @count(%0: !i32, %1: !i32) -> !i32 {
    cfg.br ^bb1(%0 : !i32)
  ^bb1(%2: !i32):
    %3 = cmpi %2, %1 {predicate = "slt"} : !i1
    cfg.cond_br %3, ^bb2, ^bb3
  ^bb2:
    %4 = addi %2, %2 : !i32
    cfg.br ^bb1(%4 : !i32)
  ^bb3:
    func.return %2
  }
  module_end
}

// CHECK-LABEL: func.func @count
// CHECK-NOT: br
// CHECK: %[[R:[0-9]+]] = scf.while iter_args(%[[IV:[0-9]+]] = %{{[0-9]+}}) -> !i32 {
// CHECK-NEXT: %[[C:[0-9]+]] = cmpi %[[IV]], %{{[0-9]+}} {predicate = "slt"} : !i1
// CHECK-NEXT: %[[NEXT:[0-9]+]], %[[REPEAT:[0-9]+]] = scf.if %[[C]] -> !i32, !i1 {
// CHECK: scf.condition %[[REPEAT]], %[[NEXT]]
// CHECK-NEXT: }
// CHECK-NEXT: do(%[[BODY:[0-9]+]]) {
// CHECK-NEXT: scf.yield %[[BODY]]
// CHECK-NEXT: }
// CHECK-NEXT: func.return %[[R]]
