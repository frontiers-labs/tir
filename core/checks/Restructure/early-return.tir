// RUN: tir opt --pass restructure --verify %s | filecheck %s

// Two returns become one: each arm assigns the value the single exit reports.

module {
  func @early(%0: !i1, %1: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    return %1
  ^bb2:
    %2 = addi %1, %1 : !i32
    return %2
  }
  module_end
}

// CHECK-LABEL: func @early
// CHECK-NOT: br
// CHECK: %[[R:[0-9]+]] = scf.if %{{[0-9]+}} -> !i32 {
// CHECK-NEXT: scf.yield %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: else {
// CHECK-NEXT: %[[E:[0-9]+]] = addi
// CHECK-NEXT: scf.yield %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: return %[[R]]
// CHECK-NOT: return
