// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s

// Two returns become one: each arm assigns the value the single exit reports.

module {
  %fn_early = func.func @early(%0: !i1, %1: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    func.return %1
  ^bb2:
    %2 = addi %1, %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @early
// CHECK-NOT: br
// CHECK: %[[R:[0-9]+]] = scf.switch %{{[0-9]+}} {
// CHECK-NEXT: %[[E:[0-9]+]] = addi
// CHECK-NEXT: -> %[[E]]
// CHECK-NEXT: }
// CHECK-NEXT: {
// CHECK-NEXT: -> %{{[0-9]+}}
// CHECK-NEXT: }
// CHECK-NEXT: -> %[[R]]
// CHECK-NOT: func.return
