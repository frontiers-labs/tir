// RUN: tir opt --pass restructure --verify %s | filecheck %s

// An edge from outside the loop landing past its header: the loop keeps two
// entries, and a dispatch inside the body picks the one an iteration wants.

module {
  func.func @into(%0: !i1, %1: !i32) -> !i32 {
    cfg.cond_br %0, ^bb1(%1 : !i32), ^bb2(%1 : !i32)
  ^bb1(%2: !i32):
    %3 = addi %2, %2 : !i32
    cfg.br ^bb2(%3 : !i32)
  ^bb2(%4: !i32):
    %5 = subi %4, %1 : !i32
    cfg.cond_br %0, ^bb1(%5 : !i32), ^bb3
  ^bb3:
    func.return %5
  }
  module_end
}

// CHECK-LABEL: func.func @into
// CHECK-NOT: br
// CHECK: scf.while iter_args
// CHECK: scf.switch %{{[0-9]+}}
// CHECK: addi
// CHECK: default {
// CHECK: subi
// CHECK: scf.condition
// CHECK: func.return
