// RUN: tir opt --pass restructure-nodes,verify-deps --verify %s | filecheck %s

// CHECK: scf.loop
// CHECK: ptr.load

module {
  %f = func.func @read_last(%slot: !ptr.p, %again: !i1) -> !ptr.p {
    cfg.br ^head
  ^head:
    %value = ptr.load %slot : !ptr.p
    cfg.cond_br %again, ^head, ^exit
  ^exit:
    func.return %value
  }
  module_end
}
