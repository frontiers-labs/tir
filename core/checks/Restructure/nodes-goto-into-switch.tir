// RUN: tir opt --pass restructure-nodes --verify %s | filecheck %s
// RUN: tir interp %s -f gis --args=1,1,5 | filecheck --check-prefix=JUMP %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f gis --args=1,1,5 | filecheck --check-prefix=JUMP %s
// RUN: tir interp %s -f gis --args=0,1,5 | filecheck --check-prefix=CASE %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f gis --args=0,1,5 | filecheck --check-prefix=CASE %s
// RUN: tir interp %s -f gis --args=0,2,5 | filecheck --check-prefix=FALL %s
// RUN: tir opt --pass restructure-nodes %s | tir interp -f gis --args=0,2,5 | filecheck --check-prefix=FALL %s

// A jump into the middle of a comparison chain: the arms rejoin in two places,
// so a continuation variable says which, and the dispatch on it is a gamma
// whose predicate indexes the arms. The block jumped into is emitted once.

module {
  %fn_gis = func.func @gis(%0: !i1, %1: !i32, %2: !i32) -> !i32 {
    %3 = constant {value = 1} : !i32
    cfg.cond_br %0, ^bb3, ^bb1
  ^bb1:
    %4 = cmpi %1, %3 {predicate = "eq"} : !i1
    cfg.cond_br %4, ^bb2, ^bb3
  ^bb2:
    %5 = addi %2, %2 : !i32
    cfg.br ^bb4(%5 : !i32)
  ^bb3:
    %6 = subi %2, %3 : !i32
    cfg.br ^bb4(%6 : !i32)
  ^bb4(%7: !i32):
    func.return %7
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @gis
// CHECK: scf.switch
// CHECK: scf.switch
// CHECK: %{{[0-9]+}} = scf.switch %{{[0-9]+}} {
// CHECK: subi
// CHECK: }

// JUMP: i32 4
// CASE: i32 10
// FALL: i32 4
