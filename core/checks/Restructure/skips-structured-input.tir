// RUN: tir opt --pass restructure --verify %s | filecheck %s

// Input already in RVSDG form has no CFG to restructure, so the pass leaves the
// structured operation untouched.

module {
  %fn_already_structured = func.func @already_structured(%0: !i1) -> !i32 {
    %2 = scf.if %0 -> !i32 {
      %3 = constant {value = 7} : !i32
      scf.yield %3
    } else {
      %4 = constant {value = 9} : !i32
      scf.yield %4
    }
    func.return %2
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @already_structured
// CHECK: scf.if
// CHECK: func.return
