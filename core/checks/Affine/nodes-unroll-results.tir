// RUN: tir opt --pass restructure-nodes,affine,verify-deps --verify %s | filecheck %s
// RUN: tir interp %s | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,affine %s | tir interp - | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes --shuffle-seed 3 %s | tir opt --pass affine | tir interp - | filecheck %s --check-prefix=VALUE

// An unrolled loop whose results are read: the counter's final value and the
// carried sum both come out of the last copy, so the copies' latches stay
// while the comparisons the copies no longer need go.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @main() -> !i32 {
    %1 = ptr.alloca {size = 16, align = 4} : !ptr.p
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 4} : !i32
    %4 = constant {value = 1} : !i32
    %5 = constant {value = 4} : !i64
    %6 = constant {value = 12} : !i64
    %7, %8 = scf.for %2, %3, %4 iter_args(%9 = %2, %10 = %2) -> !i32, !i32 {
      %11 = extsi %9 : !i64
      %12 = muli %11, %5 : !i64
      %13 = ptr.ptradd %1, %12 : !ptr.p
      %14 = addi %10, %9 : !i32
      ptr.store %14, %13
      %15 = addi %9, %4 : !i32
      scf.yield %15, %14
    }
    %16 = ptr.ptradd %1, %6 : !ptr.p
    %17 = ptr.load %16 : !i32
    %18 = ptr.load %1 : !i32
    %19 = addi %17, %18 : !i32
    %20 = addi %19, %7 : !i32
    %21 = muli %20, %8 : !i32
    func.return %21
  }
  module_end
}

// CHECK: func.func @main
// CHECK-NOT: scf.for2
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK-NOT: ptr.store

// A[3] = 6, A[0] = 0, final counter 4, sum 6: (6 + 0 + 4) * 6.
// VALUE: i32 60
