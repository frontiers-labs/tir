// RUN: tir opt --pass restructure-nodes,affine,instcombine-nodes,verify-deps --verify %s | filecheck %s
// RUN: tir interp %s | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,affine,instcombine-nodes %s | tir interp - | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes --shuffle-seed 2 %s | tir opt --pass affine,instcombine-nodes | tir interp - | filecheck %s --check-prefix=VALUE

// Four iterations of a small unordered body: the loop is replaced by four
// copies, each naming its counter outright, with the chain threaded from copy
// to copy so the stores stay ordered before the load that sums them.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @main() -> !i32 {
    %1 = ptr.alloca {size = 16, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 4} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    %30 = constant {value = 12} : !i64
    %7 = scf.for %3, %4, %5 iter_args(%8 = %3) -> !i32 {
      %9 = extsi %8 : !i64
      %10 = muli %9, %6 : !i64
      %11 = ptr.ptradd %1, %10 : !ptr.p
      %13 = addi %8, %5 : !i32
      ptr.store %13, %11
      %12 = addi %8, %5 : !i32
      scf.yield %12
    }
    %14 = ptr.ptradd %1, %30 : !ptr.p
    %15 = ptr.load %14 : !i32
    %16 = ptr.load %1 : !i32
    %17 = addi %15, %16 : !i32
    func.return %17
  }
  module_end
}

// CHECK: func.func @main
// CHECK-NOT: scf.for2
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK-NOT: ptr.store

// VALUE: i32 5
