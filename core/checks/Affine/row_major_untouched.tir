// RUN: tir opt --pass func.func(thread-state,affine) --verify %s | filecheck %s

// `A[i][j]` walked with `i` outside and `j` inside already runs each row to its
// end. Every other order touches more lines per innermost iteration, and no
// tiling fetches fewer than the one pass over the array; the identity is the
// least cost, and the nest is left as it stands.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @touch() {
    %1 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 16} : !i32
    %4 = constant {value = 1} : !i32
    %5 = constant {value = 64} : !i64
    %6 = constant {value = 4} : !i64
    %7 = scf.for %2, %3, %4 iter_args(%8 = %2) -> !i32 {
      %9 = scf.for %2, %3, %4 iter_args(%10 = %2) -> !i32 {
        %11 = extsi %8 : !i64
        %12 = extsi %10 : !i64
        %13 = muli %11, %5 : !i64
        %14 = muli %12, %6 : !i64
        %15 = ptr.ptradd %1, %13 : !ptr.p
        %16 = ptr.ptradd %15, %14 : !ptr.p
        %17 = ptr.load %16 : !i32
        %18 = addi %17, %4 : !i32
        ptr.store %18, %16
        %19 = addi %10, %4 : !i32
        scf.yield %19
      }
      %20 = addi %8, %4 : !i32
      scf.yield %20
    }
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @touch
// CHECK: scf.for %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} iter_args(%[[OUTER:[0-9]+]] = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}})
// CHECK-NEXT: scf.for %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} iter_args(%[[INNER:[0-9]+]] = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}})
// CHECK-NEXT: %[[ROW:[0-9]+]] = extsi %[[OUTER]]
// CHECK-NEXT: %[[WORD:[0-9]+]] = extsi %[[INNER]]
// CHECK-NEXT: muli %[[ROW]], %{{[0-9]+}}
// CHECK-NEXT: muli %[[WORD]], %{{[0-9]+}}
