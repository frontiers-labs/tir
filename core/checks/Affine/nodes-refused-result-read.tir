// RUN: tir opt --pass restructure-nodes,affine,verify-deps --verify %s | filecheck %s
// RUN: tir interp %s | filecheck %s --check-prefix=VALUE
// RUN: tir opt --pass restructure-nodes,affine %s | tir interp - | filecheck %s --check-prefix=VALUE

// The nest of `nodes-interchange.tir`, but the function returns the outer
// loop's final counter. A rebuilt nest counts with fresh loops and leaves no
// such value, so the nest is refused and left as it stands: the result list
// naming the counter is a reader like any other, though no use list holds it.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @main() -> !i32 {
    %1 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 16} : !i32
    %4 = constant {value = 1} : !i32
    %5 = constant {value = 64} : !i64
    %6 = constant {value = 4} : !i64
    %30 = constant {value = 1024} : !i64
    %32 = constant {value = 0} : !i8
    ptr.memset %1, %32, %30
    %7 = scf.for %2, %3, %4 iter_args(%8 = %2) -> !i32 {
      %9 = scf.for %2, %3, %4 iter_args(%10 = %2) -> !i32 {
        %11 = extsi %8 : !i64
        %12 = extsi %10 : !i64
        %13 = muli %12, %5 : !i64
        %14 = muli %11, %6 : !i64
        %15 = ptr.ptradd %1, %13 : !ptr.p
        %16 = ptr.ptradd %15, %14 : !ptr.p
        %17 = ptr.load %16 : !i32
        %18 = addi %17, %8 : !i32
        %19 = addi %18, %10 : !i32
        ptr.store %19, %16
        %20 = addi %10, %4 : !i32
        scf.yield %20
      }
      %21 = addi %8, %4 : !i32
      scf.yield %21
    }
    func.return %7
  }
  module_end
}

// CHECK: func.func @main
// CHECK: scf.for2 %[[OUTER:[0-9]+]] = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%[[ROW:[0-9]+]] = %{{[0-9]+}} | {{.*}}) {
// CHECK: scf.for2 %[[INNER:[0-9]+]] = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%[[WORD:[0-9]+]] = %{{[0-9]+}} | {{.*}}) {
// The word index is still the inner counter: nothing was interchanged.
// CHECK: extsi %[[ROW]]
// CHECK: extsi %[[WORD]]

// VALUE: i32 16
