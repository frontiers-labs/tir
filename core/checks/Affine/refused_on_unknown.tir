// RUN: tir opt --pass func.func(restructure-nodes,affine) --verify %s | filecheck %s

// One subscript the view cannot read as a form leaves one pair undecided, and an
// undecided pair pins the schedule at the identity: the nest that would have
// been swapped is left as it stands, byte for byte.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @touch(%1: !ptr.p) {
    %2 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 16} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 64} : !i64
    %7 = constant {value = 4} : !i64
    %i1_end, %8 = scf.ordered_for %i1 = %3 to %4 step %5 (%9 = %3) {
      %i2_end, %10 = scf.ordered_for %i2 = %3 to %4 step %5 (%11 = %3) {
        %12 = extsi %9 : !i64
        %13 = extsi %11 : !i64
        %14 = muli %13, %6 : !i64
        %15 = muli %12, %7 : !i64
        %16 = ptr.ptradd %2, %14 : !ptr.p
        %17 = ptr.ptradd %16, %15 : !ptr.p
        %18 = ptr.load %17 : !i32
        %19 = muli %13, %13 : !i64
        %20 = ptr.ptradd %2, %19 : !ptr.p
        ptr.store %18, %20
        %21 = addi %11, %5 : !i32
        scf.yield %21
      }
      %22 = addi %9, %5 : !i32
      scf.yield %22
    }
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @touch
// The counter the outer loop enters on is still the one the row index reads.
// CHECK: scf.for %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%[[OUTER:[0-9]+]] = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}})
// CHECK: scf.for %{{[0-9]+}} = %{{[0-9]+}} to %{{[0-9]+}} step %{{[0-9]+}} (%[[INNER:[0-9]+]] = %{{[0-9]+}}, %{{[0-9]+}} = %{{[0-9]+}})
// CHECK-NEXT: %[[A:[0-9]+]] = extsi %[[OUTER]]
// CHECK-NEXT: %[[B:[0-9]+]] = extsi %[[INNER]]
// CHECK-NEXT: muli %[[B]], %{{[0-9]+}}
// CHECK-NEXT: muli %[[A]], %{{[0-9]+}}
