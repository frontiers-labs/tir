// RUN: tir opt --pass func.func(thread-state,affine,instcombine) --verify %s | filecheck %s

// Four iterations of a small body: the loop is replaced by the four copies, each
// naming its counter outright, and folding turns what was an address computation
// per iteration into four constants. The array is a parameter, so the writes are
// memory the caller reads. Nothing here is a placement — the arranger decides
// orders, not sizes.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @fill(%1: !i32, %2: !ptr.p) {
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 4} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    %7 = scf.for %3, %4, %5 iter_args(%8 = %3) -> !i32 {
      %9 = extsi %8 : !i64
      %10 = muli %9, %6 : !i64
      %11 = ptr.ptradd %2, %10 : !ptr.p
      ptr.store %1, %11
      %12 = addi %8, %5 : !i32
      scf.yield %12
    }
    func.return
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @fill
// CHECK-NOT: scf.for
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK: ptr.store
// CHECK-NOT: ptr.store
