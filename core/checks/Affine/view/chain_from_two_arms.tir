// RUN: tir opt --print-affine %s -o /dev/null | filecheck %s

// A gate whose arms leave different memories behind names no one chain: the
// then-arm hands on the first allocation's state, the else-arm the second's.
// An access on what the gate yields is of a memory the view cannot name, and
// the nest is opaque — not the memory the first arm happens to name.

#data_layout = {types = {i1 = {abi = 8, size = 8}, i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %18 = func.func @pick(%0: !i32, %30: !i1) {
    | %19 = state.entry_state
    %1 | %20 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %2 | %21 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 64} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    %17 | %27, %28 = scf.for %3, %4, %5 iter_args(%7 = %3 | %22 = %20, %23 = %21) -> !i32 {
      %8 = extsi %7 : !i64
      %9 = muli %8, %6 : !i64
      %10 = ptr.ptradd %1, %9 : !ptr.p
      %11 = ptr.ptradd %2, %9 : !ptr.p
      | %24 = scf.if %30 args(| %22) (| %31) {
        scf.yield | %31
      } else (| %32) {
        scf.yield | %23
      }
      | %25 = ptr.store %0, %10 | %24
      | %26 = ptr.store %0, %11 | %23
      %16 = addi %7, %5 : !i32
      scf.yield %16 | %25, %26
    }
    func.return | %19
  }
  module_end
}

// CHECK: affine.view %{{[0-9]+}} {
// CHECK-NEXT: opaque
