// RUN: tir opt --pass func.func(restructure-nodes) --print-affine %s -o /dev/null | filecheck %s

// Refusal is per access. `a[i·i]` is no affine form, so that one access has
// none; the access beside it keeps the form it always had, and the pair the two
// make is the only thing the refusal costs.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @square() {
    %1 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 16} : !i32
    %4 = constant {value = 1} : !i32
    %5 = constant {value = 4} : !i64
    %6 = scf.for_legacy %2, %3, %4 iter_args(%7 = %2) -> !i32 {
      %8 = extsi %7 : !i64
      %9 = muli %8, %8 : !i64
      %10 = muli %9, %5 : !i64
      %11 = ptr.ptradd %1, %10 : !ptr.p
      %12 = ptr.load %11 : !i32
      %13 = muli %8, %5 : !i64
      %14 = ptr.ptradd %1, %13 : !ptr.p
      ptr.store %12, %14
      %15 = addi %7, %4 : !i32
      scf.yield %15
    }
    func.return
  }
  module_end
}

// CHECK: access 0 read %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset non-affine extent 4
// CHECK-NEXT: access 1 write %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset 4*d0 extent 4
// CHECK-NEXT: dep 0 1 unknown
