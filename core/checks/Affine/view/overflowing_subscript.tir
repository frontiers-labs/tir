// RUN: tir opt --pass func.func(thread-state) --print-affine %s -o /dev/null | filecheck %s

// Three products by the widest literal there is: what the form would name is
// past what any width holds, and past what the view's own arithmetic holds. The
// access is refused, not miscounted.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @huge() {
    %1 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 16} : !i32
    %4 = constant {value = 1} : !i32
    %5 = constant {value = 9223372036854775807} : !i64
    %6 = scf.for %2, %3, %4 iter_args(%7 = %2) -> !i32 {
      %8 = extsi %7 : !i64
      %9 = muli %8, %5 : !i64
      %10 = muli %9, %5 : !i64
      %11 = muli %10, %5 : !i64
      %12 = ptr.ptradd %1, %11 : !ptr.p
      %13 = ptr.load %12 : !i32
      ptr.store %13, %12
      %14 = addi %7, %4 : !i32
      scf.yield %14
    }
    func.return
  }
  module_end
}

// CHECK: access 0 read %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset non-affine extent 4
// CHECK-NEXT: access 1 write %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset non-affine extent 4
// CHECK-NEXT: dep 0 1 unknown
