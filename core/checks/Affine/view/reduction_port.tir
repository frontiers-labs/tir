// RUN: tir opt --pass func.func(thread-state) --print-affine %s -o /dev/null | filecheck %s

// The counter is not the only recurrence a loop carries. A port whose latch
// accumulates the iteration's value under one operator is a reduction, and
// saying so is what an eventual vectorizer needs and what scheduling ignores.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @sum(%1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 64} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    %7, %8 = scf.for %3, %4, %5 iter_args(%9 = %3, %10 = %1) -> !i32, !i32 {
      %11 = extsi %9 : !i64
      %12 = muli %11, %6 : !i64
      %13 = ptr.ptradd %2, %12 : !ptr.p
      %14 = ptr.load %13 : !i32
      %15 = addi %10, %14 : !i32
      %16 = addi %9, %5 : !i32
      scf.yield %16, %15
    }
    func.return %8
  }
  module_end
}

// CHECK: port 0 %{{[0-9]+}} induction init %{{[0-9]+}} step 1
// CHECK-NEXT: port 1 %{{[0-9]+}} reduction add
