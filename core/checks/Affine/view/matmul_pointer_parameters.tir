// RUN: tir opt --pass func.func(thread-state) --print-affine %s -o /dev/null | filecheck %s

// The same nest over pointer parameters. No two parameters are told apart, so
// all three accesses are of one chain, and the pairs across objects are decided
// by whether the byte ranges the two sides touch are disjoint — the predicate a
// caller could be asked, and versioning could materialize. The same-object pair
// is unchanged: it never goes through the ranges.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @matmul(%1: !ptr.p, %2: !ptr.p, %3: !ptr.p) {
    %4 = constant {value = 0} : !i32
    %5 = constant {value = 8} : !i32
    %6 = constant {value = 1} : !i32
    %7 = constant {value = 32} : !i64
    %8 = constant {value = 4} : !i64
    %9 = scf.for %4, %5, %6 iter_args(%10 = %4) -> !i32 {
      %11 = scf.for %4, %5, %6 iter_args(%12 = %4) -> !i32 {
        %13 = scf.for %4, %5, %6 iter_args(%14 = %4) -> !i32 {
          %15 = extsi %10 : !i64
          %16 = extsi %12 : !i64
          %17 = extsi %14 : !i64
          %18 = muli %15, %7 : !i64
          %19 = muli %17, %8 : !i64
          %20 = ptr.ptradd %1, %18 : !ptr.p
          %21 = ptr.ptradd %20, %19 : !ptr.p
          %22 = muli %17, %7 : !i64
          %23 = muli %16, %8 : !i64
          %24 = ptr.ptradd %2, %22 : !ptr.p
          %25 = ptr.ptradd %24, %23 : !ptr.p
          %26 = ptr.ptradd %3, %18 : !ptr.p
          %27 = ptr.ptradd %26, %23 : !ptr.p
          %28 = ptr.load %21 : !i32
          %29 = ptr.load %25 : !i32
          %30 = muli %28, %29 : !i32
          %31 = ptr.load %27 : !i32
          %32 = addi %31, %30 : !i32
          ptr.store %32, %27
          %33 = addi %14, %6 : !i32
          scf.yield %33
        }
        %34 = addi %12, %6 : !i32
        scf.yield %34
      }
      %35 = addi %10, %6 : !i32
      scf.yield %35
    }
    func.return
  }
  module_end
}

// CHECK: affine.view %{{[0-9]+}} {
// CHECK: access 0 read %{{[0-9]+}} chain %[[S:[0-9]+]] base %[[A:[0-9]+]] offset 32*d0 + 4*d2 extent 4
// CHECK-NEXT: access 1 read %{{[0-9]+}} chain %[[S]] base %[[B:[0-9]+]] offset 4*d1 + 32*d2 extent 4
// CHECK-NEXT: access 2 read %{{[0-9]+}} chain %[[S]] base %[[C:[0-9]+]] offset 32*d0 + 4*d1 extent 4
// CHECK-NEXT: access 3 write %{{[0-9]+}} chain %[[S]] base %[[C]] offset 32*d0 + 4*d1 extent 4
// CHECK-NEXT: dep 0 3 conditional disjoint %[[A]][0, 255] %[[C]][0, 255]
// CHECK-NEXT: dep 1 3 conditional disjoint %[[B]][0, 255] %[[C]][0, 255]
// CHECK-NEXT: dep 2 3 (0, 0, +)
// CHECK-NEXT: port 0 %{{[0-9]+}} induction init %{{[0-9]+}} step 1
// CHECK-NEXT: }
