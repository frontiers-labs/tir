// RUN: tir opt --pass func.func(restructure-nodes) --print-affine %s -o /dev/null | filecheck %s

// The view covers the counted prefix. A loop that does not count is not a level,
// so the nest stops above it — and what runs inside it is memory traffic the
// view cannot enumerate, so the nest it stops in is opaque and every pair it
// holds is undecided.

#data_layout = {types = {i1 = {abi = 8, size = 8}, i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @prefix(%1: !i1) {
    %2 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 8} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    | %7 = state.entry_state
    | %8 = scf.for %9 = %3 to %4 step %5 (| %10 = %7) {
      | %11 = scf.for %12 = %3 to %4 step %5 (| %13 = %10) {
        %14 = extsi %12 : !i64
        %15 = muli %14, %6 : !i64
        %16 = ptr.ptradd %2, %15 : !ptr.p
        | %17 = ptr.store %3, %16 | %13
        | %18 = scf.loop (| %19 = %17) {
          %20 | %21 = scf.switch %1 args(| %19) (| %22) {
            %23 = constant {value = 0} : !i1
            -> %23 | %22
          }
          (| %24) {
            | %25 = ptr.store %5, %16 | %24
            %26 = constant {value = 1} : !i1
            -> %26 | %25
          }
          -> %20 | %21, %21
        }
        -> | %18
      }
      -> | %11
    }
    -> | %8
  }
  module_end
}

// CHECK: affine.view %{{[0-9]+}} {
// CHECK-NEXT: opaque
// CHECK-NEXT: loop 0
// CHECK-NEXT: loop 1
// CHECK-NOT: loop 2
