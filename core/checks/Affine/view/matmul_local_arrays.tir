// RUN: tir opt --pass func.func(thread-state) --print-affine %s -o /dev/null | filecheck %s

// Three local arrays are three memories, so the only pair the nest has is C's
// read against its own write: one equation, `32·δi + 4·δj = 0`, which the
// iteration space admits only at `δi = δj = 0`, with `k` free.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @matmul() {
    %1 = ptr.alloca {size = 256, align = 4} : !ptr.p
    %2 = ptr.alloca {size = 256, align = 4} : !ptr.p
    %3 = ptr.alloca {size = 256, align = 4} : !ptr.p
    %4 = constant {value = 0} : !i32
    %5 = constant {value = 8} : !i32
    %6 = constant {value = 1} : !i32
    %7 = constant {value = 32} : !i64
    %8 = constant {value = 4} : !i64
    %9 = scf.for_legacy %4, %5, %6 iter_args(%10 = %4) -> !i32 {
      %11 = scf.for_legacy %4, %5, %6 iter_args(%12 = %4) -> !i32 {
        %13 = scf.for_legacy %4, %5, %6 iter_args(%14 = %4) -> !i32 {
          %15 = extsi %10 : !i64
          %16 = extsi %12 : !i64
          %17 = extsi %14 : !i64
          %18 = muli %15, %7 : !i64
          %19 = muli %17, %8 : !i64
          %20 = ptr.ptradd %1, %18 : !ptr.p
          %21 = ptr.ptradd %20, %19 : !ptr.p
          %22 = muli %17, %7 : !i64
          %23 = muli %16, %8 : !i64
          %24 = ptr.ptradd %2, %22 : !ptr.p
          %25 = ptr.ptradd %24, %23 : !ptr.p
          %26 = ptr.ptradd %3, %18 : !ptr.p
          %27 = ptr.ptradd %26, %23 : !ptr.p
          %28 = ptr.load %21 : !i32
          %29 = ptr.load %25 : !i32
          %30 = muli %28, %29 : !i32
          %31 = ptr.load %27 : !i32
          %32 = addi %31, %30 : !i32
          ptr.store %32, %27
          %33 = addi %14, %6 : !i32
          scf.yield %33
        }
        %34 = addi %12, %6 : !i32
        scf.yield %34
      }
      %35 = addi %10, %6 : !i32
      scf.yield %35
    }
    func.return
  }
  module_end
}

// CHECK: affine.view %[[NEST:[0-9]+]] {
// CHECK-NEXT: loop 0 %[[NEST]] i32 [0, 8) step 1 counter %[[I:[0-9]+]] trip 8
// CHECK-NEXT: loop 1 %{{[0-9]+}} i32 [0, 8) step 1 counter %{{[0-9]+}} trip 8
// CHECK-NEXT: loop 2 %{{[0-9]+}} i32 [0, 8) step 1 counter %[[K:[0-9]+]] trip 8
// CHECK-NEXT: access 0 read %{{[0-9]+}} chain %{{[0-9]+}} base %[[A:[0-9]+]] offset 32*d0 + 4*d2 extent 4
// CHECK-NEXT: access 1 read %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset 4*d1 + 32*d2 extent 4
// CHECK-NEXT: access 2 read %{{[0-9]+}} chain %[[C:[0-9]+]] base %[[CB:[0-9]+]] offset 32*d0 + 4*d1 extent 4
// CHECK-NEXT: access 3 write %{{[0-9]+}} chain %[[C]] base %[[CB]] offset 32*d0 + 4*d1 extent 4
// CHECK-NEXT: dep 2 3 (0, 0, +)
// CHECK-NEXT: port 0 %[[K]] induction init %{{[0-9]+}} step 1
// CHECK-NEXT: }
