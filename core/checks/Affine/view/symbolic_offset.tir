// RUN: tir opt --pass func.func(restructure-nodes) --print-affine %s -o /dev/null | filecheck %s

// `a[n + i]` against itself: the parameter was widened before the nest, and the
// form's range is the range of what was widened — a 32-bit `n` scaled by four
// never leaves 64 bits, so the pair is decided, not refused for a wrap that
// cannot happen.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @shift(%1: !i32) {
    %2 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 16} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    %7 = extsi %1 : !i64
    %8 = muli %7, %6 : !i64
    %9 = scf.for_legacy %3, %4, %5 iter_args(%10 = %3) -> !i32 {
      %11 = extsi %10 : !i64
      %12 = muli %11, %6 : !i64
      %13 = ptr.ptradd %2, %12 : !ptr.p
      %14 = ptr.ptradd %13, %8 : !ptr.p
      %15 = ptr.load %14 : !i32
      %16 = addi %15, %15 : !i32
      ptr.store %16, %14
      %17 = addi %10, %5 : !i32
      scf.yield %17
    }
    func.return
  }
  module_end
}

// CHECK: symbols s0 = %{{[0-9]+}}
// CHECK: access 0 read %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset 4*d0 + s0 extent 4
// CHECK-NEXT: access 1 write %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset 4*d0 + s0 extent 4
// CHECK-NEXT: dep 0 1 independent
