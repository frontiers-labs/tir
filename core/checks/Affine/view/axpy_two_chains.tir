// RUN: tir opt --pass func.func(thread-state) --print-affine %s -o /dev/null | filecheck %s

// Two allocations are two memories, which is what a `restrict` pair claims about
// two parameters. Law S3 makes it structural: the accesses sit on different
// chains, so no pair spans them at all and there is nothing for the dependence
// test to decide.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @axpy(%1: !i32) {
    %2 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %4 = constant {value = 0} : !i32
    %5 = constant {value = 64} : !i32
    %6 = constant {value = 1} : !i32
    %7 = constant {value = 4} : !i64
    %8 = scf.for %4, %5, %6 iter_args(%9 = %4) -> !i32 {
      %10 = extsi %9 : !i64
      %11 = muli %10, %7 : !i64
      %12 = ptr.ptradd %2, %11 : !ptr.p
      %13 = ptr.ptradd %3, %11 : !ptr.p
      %14 = ptr.load %12 : !i32
      %15 = ptr.load %13 : !i32
      %16 = muli %14, %1 : !i32
      %17 = addi %15, %16 : !i32
      ptr.store %17, %13
      %18 = addi %9, %6 : !i32
      scf.yield %18
    }
    func.return
  }
  module_end
}

// CHECK: access 0 read %{{[0-9]+}} chain %[[X:[0-9]+]] base %{{[0-9]+}} offset 4*d0 extent 4
// CHECK-NEXT: access 1 read %{{[0-9]+}} chain %[[Y:[0-9]+]] base %{{[0-9]+}} offset 4*d0 extent 4
// CHECK-NEXT: access 2 write %{{[0-9]+}} chain %[[Y]] base %{{[0-9]+}} offset 4*d0 extent 4
// CHECK-NEXT: dep 1 2 independent
// CHECK-NEXT: port 0
