// RUN: tir opt --pass func.func(thread-state) --print-affine %s -o /dev/null | filecheck %s

// `step + i` steps the counter as well as `i + step` does.

#data_layout = {types = {i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @fill(%1: !i32) {
    %2 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %3 = constant {value = 0} : !i32
    %4 = constant {value = 16} : !i32
    %5 = constant {value = 1} : !i32
    %6 = constant {value = 4} : !i64
    %7 = scf.for %3, %4, %5 iter_args(%8 = %3) -> !i32 {
      %9 = extsi %8 : !i64
      %10 = muli %9, %6 : !i64
      %11 = ptr.ptradd %2, %10 : !ptr.p
      ptr.store %1, %11
      %12 = addi %5, %8 : !i32
      scf.yield %12
    }
    func.return
  }
  module_end
}

// CHECK: loop 0 %{{[0-9]+}} i32 [0, 16) step 1 counter %[[I:[0-9]+]] trip 16
// CHECK-NEXT: access 0 write %{{[0-9]+}} chain %{{[0-9]+}} base %{{[0-9]+}} offset 4*d0 extent 4
// CHECK-NEXT: port 0 %[[I]] induction init %{{[0-9]+}} step 1
