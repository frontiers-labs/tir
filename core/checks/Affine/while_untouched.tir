// RUN: tir opt --pass func.func(thread-state,affine) --verify %s | filecheck %s

// A loop that does not count is no nest, so the pass has nothing to place and
// nothing to build.

#data_layout = {types = {i1 = {abi = 8, size = 8}, i32 = {abi = 32, size = 32}, i64 = {abi = 64, size = 64}, p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %0 = func.func @spin(%1: !i1, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %4 = constant {value = 1} : !i32
    %5 = scf.while iter_args(%6 = %2) -> !i32 {
      scf.condition %1, %6
    } do(%7) {
      ptr.store %7, %3
      %8 = addi %7, %4 : !i32
      scf.yield %8
    }
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @spin
// CHECK: scf.while
// CHECK-NOT: scf.for
