// RUN: tir opt --pass func.func(restructure-nodes,affine) --verify %s | filecheck %s

// A loop that does not count is no nest, so the pass has nothing to place and
// nothing to build.

#layout_spec = #layout.spec<!i1 = {size = 8, abi = 8}, !i32 = {size = 32, abi = 32}, !i64 = {size = 64, abi = 64}, !ptr.p = {size = 64, abi = 64}>

module {layout.spec = #layout_spec} {
  %0 = func.func @spin(%1: !i1, %2: !i32) -> !i32 {
    %3 = ptr.alloca {size = 1024, align = 4} : !ptr.p
    %4 = constant {value = 1} : !i32
    cfg.br ^head(%2 : !i32)
  ^head(%5: !i32):
    cfg.cond_br %1, ^body, ^exit
  ^body:
    ptr.store %5, %3
    %6 = addi %5, %4 : !i32
    cfg.br ^head(%6 : !i32)
  ^exit:
    func.return %5
  }
  module_end
}

// CHECK-LABEL: %{{[0-9]+}} = func.func @spin
// CHECK: scf.loop
// CHECK-NOT: scf.for
