// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// addi's scheme gives both operands one width; mixing i32 and i64 fails, and
// the error names where the op is written and the binding the first operand
// made.

module {
  %fn_f = func.func @f() -> !i32 {
    %0 = constant {value = 1} : !i32
    %1 = constant {value = 2} : !i64
    %2 = addi %0, %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK: addi at byte 340: operand 2 is !i64, expected !i32; W := 32 from operand 1
