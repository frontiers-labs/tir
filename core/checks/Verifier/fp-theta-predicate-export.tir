// RUN: not tir opt --verify --pass verify-deps %s 2>&1 | filecheck %s

// The predicate depends on the write in both paths. The exit cannot export
// the incoming state without accounting for that write.

module {
  %f = func.func @main(%p: !ptr.p<!i32>, %value: !i32) {
    %initial = state.entry_state : !state<memory>
    %exit = scf.loop (%memory = %initial) {
      %next = ptr.store %value, %p state(%memory)
      %observed, %read = ptr.load %p state(%next) : !i32
      %again = cmpi %observed, %value {predicate = "slt"} : !i1
      -> %again, %read, %memory
    }
    -> %exit
  }
  module_end
}

// CHECK: state %{{[0-9]+}} has incompatible concurrent uses
