// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// Nothing orders an unordered region but its dependencies, so a def-use cycle
// inside one has no evaluation order and is rejected.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = addi %2, %0 : !i32
    %2 = addi %1, %0 : !i32
    -> %1
  }
  module_end
}

// CHECK: addi closes a dependency cycle
