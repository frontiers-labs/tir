// RUN: not tir opt --verify %s

// Each arm of an scf.if must yield one value per result; an else arm yielding
// fewer values than the op produces fails verification.

module {
  func.func @bad(%0: !i1) -> !i32 {
    %1, %2 = scf.if %0 -> !i32, !i64 {
      %3 = constant {value = 7} : !i32
      %4 = constant {value = 8} : !i64
      scf.yield %3, %4
    } else {
      %5 = constant {value = 9} : !i32
      scf.yield %5
    }
    func.return %1
  }
  module_end
}
