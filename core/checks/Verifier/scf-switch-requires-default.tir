// RUN: not tir opt --verify %s

// Every scf.switch is total: the predicate always selects an arm, so the trailing
// default arm is mandatory. A switch made of case arms alone is rejected.

module {
  %fn_dispatch = func.func @dispatch(%0: !i32) {
    scf.switch %0 case 1 {
      scf.yield
    }
    func.return
  }
  module_end
}
