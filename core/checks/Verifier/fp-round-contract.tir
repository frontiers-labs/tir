// RUN: tir opt --verify %s

module {
  %f = func.func @round_contract(%a: !f64, %b: !f64) -> !f64 {
    %sum = fp.round (%x = %a, %y = %b) {contract = {arithmetic = {kind = "arithmetic", rounding = "nearest_even", exceptions = "ignore", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}, permissions = {expression_contraction = true, cross_statement_contraction = false, reassociation = false, reciprocal = false, approved_approximation = false, ignore_signed_zero = false}, assumptions = {finite = false}, accuracy = {kind = "reference"}, result_formats = [!f64], environment_epoch = 0, intermediate_exceptions = "allow_contracted_group_removal"}} : !f64 {
      %value = fp.add %x, %y : !f64
      -> %value
    }
    -> %sum
  }
  module_end
}
