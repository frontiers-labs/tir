// RUN: not tir opt --verify %s

// One state names the memory at one point, so two writes taking it would
// describe two futures for the same memory.

module {
  %fn_bad = func.func @bad(%0: !i32) {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32> state(-> %2)
    ptr.store %0, %1 state(%2 -> %3)
    ptr.store %0, %1 state(%2 -> %4)
    func.return
  }
  module_end
}
