// RUN: tir opt --verify %s | filecheck %s

// Two reads fork off one write; the next write takes the join of what they left,
// which is the one edge ordering it after both.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1, state(%2) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3, state(%4) = ptr.load %1 state(%2) : !i32
    %5, state(%6) = ptr.load %1 state(%2) : !i32
    state(%7) = state.join state(%4, %6)
    state(%8) = ptr.store %0, %1 state(%7)
    %9 = addi %3, %5 : !i32
    func.return %9 state(%8)
  }
  module_end
}

// CHECK: state(%[[J:[0-9]+]]) = state.join state(%{{[0-9]+}}, %{{[0-9]+}})
// CHECK-NEXT: state(%[[W:[0-9]+]]) = ptr.store %0, %{{[0-9]+}} state(%[[J]])
// CHECK: func.return %{{[0-9]+}} state(%[[W]])
