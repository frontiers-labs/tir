// RUN: tir opt --verify %s | filecheck %s

// Two reads fork off one write; the next write takes the join of what they left,
// which is the one edge ordering it after both.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 | %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %3 | %4 = ptr.load %1 | %2 : !i32
    %5 | %6 = ptr.load %1 | %2 : !i32
    | %7 = state.join | %4, %6
    | %8 = ptr.store %0, %1 | %7
    %9 = addi %3, %5 : !i32
    func.return %9 | %8
  }
  module_end
}

// CHECK: | %[[J:[0-9]+]] = state.join | %{{[0-9]+}}, %{{[0-9]+}}
// CHECK-NEXT: | %[[W:[0-9]+]] = ptr.store %0, %{{[0-9]+}} | %[[J]]
// CHECK: func.return %{{[0-9]+}} | %[[W]]
