// RUN: tir opt --verify %s | filecheck %s

// The accepting half of `split-two-changers`: one changer per split result is
// what a split is for. The two stores name two chains, so neither describes a
// future for the other's memory, and the join merges what each left.

module {
  %fn_f = func.func @f(%a: !ptr.p<!i32>, %b: !ptr.p<!i32>, %v: !i32) {
    %s0 = state.entry_state
    %s1, %s2 = state.split state(%s0)
    %s3 = ptr.store %v, %a state(%s1)
    %s4 = ptr.store %v, %b state(%s2)
    %s5 = state.join state(%s3, %s4)
    func.return state(%s5)
  }
  module_end
}

// CHECK: %[[A:[0-9]+]], %[[B:[0-9]+]] = state.split
// CHECK: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[A]])
// CHECK: ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[B]])
