// RUN: not tir opt --verify %s

// A branch carries the memory along its edge, so one forwarding a state a
// store in the same block already changed describes two futures for it.

module {
  %fn_main = func.func @main() -> !i32 {
    %p, %d0 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %one = constant {value = 1} : !i32
    %d1 = ptr.store %one, %p state(%d0)
    cfg.br ^a(%d0 : !state)
  ^a(%d2: !state):
    %x, %d3 = ptr.load %p state(%d2) : !i32
    func.return %x state(%d3)
  }
  module_end
}
