// RUN: not tir opt --verify %s 2>&1 | filecheck %s
// RUN: not tir mc --march=riscv64 --stage=isel %s 2>&1 | filecheck %s

// A pointer offset is as wide as the pointer the layout declares: a narrower
// index has to be extended by an op that says whether it is signed. The module
// declares no layout, so the one checked against is the target's: the one its
// environment names, or the one `--march` selects.

module {target_env = {arch = "x86_64"}} {
  %fn_narrow = func.func @narrow(%0: !ptr.p, %1: !i32) -> !ptr.p {
    %2 = ptr.ptradd %0, %1 : !ptr.p
    func.return %2
  }
  module_end
}

// CHECK: ptr.ptradd offset must be 64 bits wide, the pointer width
