// RUN: not tir opt --verify %s

// An scf.switch selects on an integer predicate; a float predicate fails verification.

module {
  %fn_dispatch = func.func @dispatch(%0: !f32) {
    scf.switch %0 case 1 {
      scf.yield
    }
    default {
      scf.yield
    }
    func.return
  }
  module_end
}
