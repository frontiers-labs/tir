// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// A `state.split` names one memory per chain carrying on from the state it
// takes, and each of those is a memory of its own: one operation may change
// it. Two stores on one split result describe two futures for that chain,
// which the fork check rejects the same way it rejects two changers of any
// other state.

module {
  %fn_f = func.func @f(%a: !ptr.p<!i32>, %b: !ptr.p<!i32>, %v: !i32) {
    %s0 = state.entry_state
    %s1, %s2 = state.split state(%s0)
    %s3 = ptr.store %v, %a state(%s1)
    %s4 = ptr.store %v, %b state(%s1)
    %s5 = state.join state(%s3, %s4, %s2)
    func.return state(%s5)
  }
  module_end
}

// CHECK: state %{{[0-9]+}} is both observed and changed
