// RUN: not tir opt --verify %s

// A state carries no bits: naming one where an integer belongs fails the
// operand's type constraint like any other mistyped value.

module {
  %fn_bad = func.func @bad() -> !i32 {
    %0 = state.entry_state
    %1 = addi %0, %0 : !i32
    func.return %1
  }
  module_end
}
