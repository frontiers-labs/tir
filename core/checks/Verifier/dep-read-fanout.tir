// RUN: tir opt --verify %s | filecheck %s

// Reads leave memory as they found it, so any number of them may observe one
// dependency.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 | %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %3 = ptr.store %0, %1 | %2
    %4 | %5 = ptr.load %1 | %3 : !i32
    %6 | %7 = ptr.load %1 | %3 : !i32
    %8 = addi %4, %6 : !i32
    func.return %8
  }
  module_end
}

// CHECK: %[[A:[0-9]+]] | %[[S:[0-9]+]] = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
// CHECK-NEXT: | %[[W:[0-9]+]] = ptr.store %0, %[[A]] | %[[S]]
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %[[A]] | %[[W]] : !i32
// CHECK-NEXT: %{{[0-9]+}} | %{{[0-9]+}} = ptr.load %[[A]] | %[[W]] : !i32
