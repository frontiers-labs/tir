// RUN: not tir opt --verify %s

// Two functions with the same name and the same argument types are the same
// symbol: overloading keys on argument types, so this is a redefinition.

module {
  func @f(%0: !i32) -> !i32 {
    return %0
  }
  func @f(%1: !i32) -> !i64 {
    %2 = constant {value = 1} : !i64
    return %2
  }
  module_end
}
