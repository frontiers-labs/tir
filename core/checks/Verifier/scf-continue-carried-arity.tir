// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// A `scf.continue` feeds the next iteration's carried arguments, so it must carry
// one value per carried port; carrying more fails verification.

module {
  %fn_bad = func.func @bad(%0: !i1, %1: !i32, %2: !i64) -> !i32 {
    %3, %4 = scf.while iter_args(%5 = %1, %6 = %2) -> !i32, !i64 {
      scf.condition %0, %5, %6
    } do scope(%7)(%8, %9) {
      scf.if %0 {
        scf.continue %7, %8, %9, %8
      } else {
        scf.yield
      }
      scf.yield %8, %9
    }
    func.return %3
  }
  module_end
}

// CHECK: scf.while carries 2 values but its scf.continue carries 3
