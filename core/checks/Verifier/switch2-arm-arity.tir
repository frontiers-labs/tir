// RUN: not tir opt --verify %s 2>&1 | filecheck %s

module {
  %fn_main = func.func @main(%0: !i32, %1: !i32) -> !i32 {
    %2 = scf.switch %0 args(%1) (%3) {
      -> %3
    }
    (%4) {
      -> %4, %4
    }
    func.return %2
  }
  module_end
}

// CHECK: scf.switch arm 1 produces 2 values but the op produces 1
