// RUN: not tir opt --verify %s

// A predicate value selects exactly one arm, so no case value may repeat.

module {
  %fn_dispatch = func.func @dispatch(%0: !i32) {
    scf.switch %0 case 1 {
      scf.yield
    }
    case 1 {
      scf.yield
    }
    default {
      scf.yield
    }
    func.return
  }
  module_end
}
