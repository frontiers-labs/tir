// RUN: not tir opt --verify %s

// A value-producing scf.ordered_for must carry an init operand whose type matches the
// result type; an i1 init for an i32 result fails verification.

module {
  %fn_bad = func.func @bad(%0: !index, %1: !index, %2: !index, %3: !i1) -> !i32 {
    %i1_end, %4 = scf.ordered_for %i1 = %0 to %1 step %2 (%5 = %3) {
      %6 = constant {value = 1} : !i32
      scf.yield %6
    }
    func.return %4
  }
  module_end
}
