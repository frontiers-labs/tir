// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// A counted loop counts through an index or an integer; its scheme bounds the
// counter's binder by those shapes.

module {
  %fn_bad = func.func @bad(%0: !f32, %1: !f32, %2: !f32) -> !i32 {
    %i1_end = scf.ordered_for %i1 = %0 to %1 step %2 {
      scf.yield
    }
    %3 = constant {value = 0} : !i32
    func.return %3
  }
  module_end
}

// CHECK: ordered_for at byte {{[0-9]+}}: operand 1 is !f32, expected C; C is one of !index | !builtin.i<_>
