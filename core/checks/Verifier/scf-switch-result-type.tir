// RUN: not tir opt --verify %s

// Every arm of a value-producing scf.switch yields a value of the result type; a
// default arm yielding i1 for an i32 result fails verification.

module {
  func.func @select(%0: !i32) -> !i32 {
    %1 = scf.switch %0 -> !i32 case 1 {
      %2 = constant {value = 10} : !i32
      scf.yield %2
    }
    default {
      %3 = constant {value = 0} : !i1
      scf.yield %3
    }
    func.return %1
  }
  module_end
}
