// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// Addresses are unsigned, so a signed pointer comparison has no meaning: the
// verifier names the predicates that do.

module {
  %fn_signed = func.func @signed(%0: !ptr.p, %1: !ptr.p) -> !i1 {
    %2 = ptr.cmp %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  module_end
}

// CHECK: ptr.cmp predicate 'slt' is not a pointer comparison (expected eq, ne, ult, ule, ugt, uge)
