// RUN: not tir opt --verify %s 2>&1 | filecheck %s

// An operation reading its own result is the shortest dependency cycle there
// is, and has no more of an evaluation order than a longer one.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = addi %1, %0 : !i32
    -> %1
  }
  module_end
}

// CHECK: addi closes a dependency cycle
