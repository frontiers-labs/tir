// RUN: not tir opt %s 2>&1 | filecheck %s
// CHECK: failed typechecking: signature

// fp.add accepts captured computations. An integer cannot stand in for one.

module {
  %fn_f = func.func @f() -> !f32 {
    %0 = constant {value = 1} : !i32
    %1 = constant {value = 2} : !i32
    %2 = fp.add %0, %1 : !fp.computation<!f32, nearest_even, separate>
    %3 = fp.materialize %2 : !f32
    func.return %3
  }
  module_end
}
