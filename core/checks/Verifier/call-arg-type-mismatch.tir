// RUN: not tir opt --verify %s

// Overloads resolve on exact argument types: an i64 argument does not select
// the i32 overload.

module {
  %fn_f = func.declare @f(!i32) -> !i32
  %fn_caller = func.func @caller(%0: !i64) -> !i32 {
    %1 = func.call %fn_f(%0 : !i64) -> !i32
    func.return %1
  }
  module_end
}
