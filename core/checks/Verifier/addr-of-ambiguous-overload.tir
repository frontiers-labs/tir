// RUN: not tir opt --verify %s

// An address-of reference carries no argument types, so it cannot pick between
// two overloads of the same name.

module {
  func.func @f(%0: !i32) -> !i32 {
    func.return %0
  }
  func.func @f(%1: !i64) -> !i64 {
    func.return %1
  }
  func.func @take() -> !ptr.p {
    %2 = func.addr_of {sym_name = "f"} : !ptr.p
    func.return %2
  }
  module_end
}
