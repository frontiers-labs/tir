// RUN: not tir opt %s 2>&1 | filecheck %s
// CHECK: failed typechecking: signature

// fp.add must preserve the operand format.

module {
  %fn_f = func.func @f(%x: !f32, %y: !f32) -> !f64 {
    %0 = fp.capture %x : !fp.computation<!f32, nearest_even, separate>
    %1 = fp.capture %y : !fp.computation<!f32, nearest_even, separate>
    %2 = fp.add %0, %1 : !fp.computation<!f64, nearest_even, separate>
    %3 = fp.materialize %2 : !f64
    func.return %3
  }
  module_end
}
