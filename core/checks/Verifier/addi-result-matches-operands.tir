// RUN: not tir opt --verify %s

// addi requires its result to share the operand type; i32 operands with an i64
// result fails.

module {
  %fn_f = func.func @f() -> !i64 {
    %0 = constant {value = 1} : !i32
    %1 = constant {value = 2} : !i32
    %2 = addi %0, %1 : !i64
    func.return %2
  }
  module_end
}
