// RUN: tir opt --verify --pass verify-deps %s | filecheck %s

// The write belongs only to the continue path. The exit can export the
// incoming state because the predicate does not depend on the write.

module {
  %f = func.func @main(%p: !ptr.p<!i32>, %value: !i32) {
    %initial = state.entry_state : !state<memory>
    %exit = scf.loop (%memory = %initial) {
      %next = ptr.store %value, %p state(%memory)
      %stop = constant {value = 0} : !i1
      -> %stop, %next, %memory
    }
    -> %exit
  }
  module_end
}

// CHECK: %[[INITIAL:[0-9]+]] = state.entry_state : !state<memory>
// CHECK: %[[EXIT:[0-9]+]] = scf.loop (%[[MEMORY:[0-9]+]] = %[[INITIAL]]) {
// CHECK: %[[NEXT:[0-9]+]] = ptr.store %{{[0-9]+}}, %{{[0-9]+}} state(%[[MEMORY]])
// CHECK: %[[STOP:[0-9]+]] = constant {value = 0} : !i1
// CHECK-NEXT: -> %[[STOP]], %[[NEXT]], %[[MEMORY]]
// CHECK: -> %[[EXIT]]
