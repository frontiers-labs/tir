// RUN: not tir opt --verify %s

// One state, a write and a read: nothing orders the read against the write, so
// the two describe two futures for one memory.

module {
  %fn_bad = func.func @bad(%0: !i32) {
    %1 | %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    | %3 = ptr.store %0, %1 | %2
    %4 = ptr.load %1 | %2 : !i32
    func.return
  }
  module_end
}
