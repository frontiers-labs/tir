// RUN: tir opt --pass destructure %s | tir interp | filecheck %s
// RUN: tir opt --pass destructure --verify %s

// An exit value is whatever the body names, not the carried value: initial 0,
// continue port 0, exit 1, predicate false produces 1.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = constant {value = 0} : !i32
    %1 = constant {value = 1} : !i32
    %2 = constant {value = 0} : !i1
    %3 = scf.loop (%4 = %0) {
      -> %2, %4, %1
    }
    func.return %3
  }
  module_end
}

// CHECK: i32 1
