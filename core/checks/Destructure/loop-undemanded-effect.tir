// RUN: not tir opt --pass destructure %s 2>&1 | filecheck %s

// Both dependency results of the body name the port it entered on, so no cone
// of the loop reaches the store. Demand evaluation does not defer an effect no
// result demands, it drops it, so destructure refuses rather than emitting a
// loop whose body is silently empty.

module {
  %fn = func.func @count() -> !i32 {
    %0 = constant {value = 0} : !i32
    %1 = constant {value = 1} : !i32
    %2 = constant {value = 3} : !i32
    %3, state(%4) = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    state(%5) = ptr.store %0, %3 state(%4)
    %6, state(%7) = scf.loop (%8 = %0, state(%9 = %5)) {
      %10 = cmpi %8, %2 {predicate = "slt"} : !i1
      %11 = addi %8, %1 : !i32
      state(%12) = ptr.store %1, %3 state(%9)
      -> %10, %11, %8, state(%9, %9)
    }
    %13 = ptr.load %3 state(%7) : !i32
    func.return %13
  }
  module_end
}

// CHECK: ptr.store leaves a dependency no result demands
