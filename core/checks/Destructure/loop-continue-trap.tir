// RUN: tir opt --pass destructure %s | tir interp | filecheck %s
// RUN: tir opt --pass destructure %s | not tir interp -f trapped 2>&1 | filecheck --check-prefix=TRAP %s
// RUN: tir opt --pass destructure --verify %s

// The continue cone is not evaluated when the predicate is false: the load
// from a cell nothing wrote sits there and never runs. With the predicate
// true it runs and the interpreter refuses the read.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = constant {value = 7} : !i32
    %1 = constant {value = 0} : !i1
    %2 | %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 | %5 = scf.loop (%6 = %0 | %7 = %3) {
      %8 = ptr.load %2 | %7 : !i32
      -> %1, %8, %6 | %7, %7
    }
    func.return %4
  }
  %fn_trapped = func.func @trapped() -> !i32 {
    %0 = constant {value = 7} : !i32
    %1 = constant {value = 1} : !i1
    %2 | %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %4 | %5 = scf.loop (%6 = %0 | %7 = %3) {
      %8 = ptr.load %2 | %7 : !i32
      -> %1, %8, %6 | %7, %7
    }
    func.return %4
  }
  module_end
}

// CHECK: i32 7
// TRAP: uninitialized
