// RUN: tir interp %s --args=3 | filecheck --check-prefix=BREAK %s
// RUN: tir opt --pass restructure-nodes,destructure --verify %s | tir interp --args=3 | filecheck --check-prefix=BREAK %s
// RUN: tir opt --pass restructure-nodes --shuffle-seed 5 %s | tir opt --pass destructure | tir interp --args=3 | filecheck --check-prefix=BREAK %s
// RUN: tir interp %s --args=9 | filecheck --check-prefix=DONE %s
// RUN: tir opt --pass restructure-nodes,destructure %s | tir interp --args=9 | filecheck --check-prefix=DONE %s
// RUN: tir opt --pass restructure-nodes,destructure %s | filecheck --check-prefix=CFG %s

// A loop with two exits, each storing a different marker after it, goes
// through the unordered form and back: the exit taken leaves the loop as a
// carried selector, and the gate dispatching on it becomes a branch again.

module {
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %p = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    %five = constant {value = 5} : !i32
    %hundred = constant {value = 100} : !i32
    ptr.store %zero, %p
    cfg.br ^head(%zero : !i32)
  ^head(%i: !i32):
    %more = cmpi %i, %five {predicate = "slt"} : !i1
    cfg.cond_br %more, ^body, ^done
  ^body:
    %hit = cmpi %i, %0 {predicate = "eq"} : !i1
    cfg.cond_br %hit, ^broke, ^step
  ^step:
    %i1 = addi %i, %one : !i32
    cfg.br ^head(%i1 : !i32)
  ^broke:
    ptr.store %hundred, %p
    %m = ptr.load %p : !i32
    func.return %m
  ^done:
    ptr.store %i, %p
    %r = ptr.load %p : !i32
    func.return %r
  }
  module_end
}

// BREAK: i32 100
// DONE: i32 5
// CFG-NOT: scf.
// CFG: func.return
