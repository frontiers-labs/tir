// RUN: tir interp %s | filecheck --check-prefix=BASE %s
// RUN: tir opt --pass destructure %s | tir interp | filecheck --check-prefix=BASE %s
// RUN: tir opt --pass destructure --verify %s | filecheck --check-prefix=CFG %s

// The loop predicate is a short-circuit Gamma: the second comparison is only
// evaluated when the first one is true. Its boolean result is forwarded as the
// Theta repeat selector. The bounds reach the first-false arm after two
// iterations, so that arm's constant selector is exercised.

module {
  %fn_main = func.func @main() -> !i32 {
    %zero = constant {value = 0} : !i32
    %one = constant {value = 1} : !i32
    %two = constant {value = 2} : !i32
    %first_limit = constant {value = 2} : !i32
    %second_limit = constant {value = 4} : !i32
    %result = scf.loop (%i = %zero) {
      %first = cmpi %i, %first_limit {predicate = "slt"} : !i1
      %both = scf.switch %first {
        %false = constant {value = 0} : !i1
        -> %false
      }
      {
        %second = cmpi %i, %second_limit {predicate = "slt"} : !i1
        -> %second
      }
      %next = addi %i, %one : !i32
      -> %both, %next, %i
    }
    %scaled = muli %result, %two : !i32
    func.return %scaled
  }
  module_end
}

// BASE: i32 4
// CFG-NOT: scf.loop
// CFG-NOT: scf.switch
// CFG: cfg.cond_br
// CFG-NOT: constant {value = 0} : !i1
// CFG: func.return
