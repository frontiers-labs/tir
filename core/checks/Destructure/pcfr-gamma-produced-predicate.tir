// RUN: tir interp %s -f main --args=0,5 | filecheck --check-prefix=FALSE %s
// RUN: tir interp %s -f main --args=0,10 | filecheck --check-prefix=TRUE %s
// RUN: tir interp %s -f main --args=1,5 | filecheck --check-prefix=TRUE %s
// RUN: tir interp %s -f main --args=1,11 | filecheck --check-prefix=FALSE %s
// RUN: tir opt --pass destructure --verify %s | tir interp -f main --args=0,5 | filecheck --check-prefix=FALSE %s
// RUN: tir opt --pass destructure --verify %s | tir interp -f main --args=0,10 | filecheck --check-prefix=TRUE %s
// RUN: tir opt --pass destructure --verify %s | tir interp -f main --args=1,5 | filecheck --check-prefix=TRUE %s
// RUN: tir opt --pass destructure --verify %s | tir interp -f main --args=1,11 | filecheck --check-prefix=FALSE %s
// RUN: tir opt --pass destructure --verify %s | filecheck --check-prefix=CFG %s

// The inner Gamma computes its selector in either arm. The outer Gamma uses
// that result as its selector, so recovery must branch at the arm's cmpi
// instead of joining and materializing a boolean first.

module {
  %fn_main = func.func @main(%x: !i32, %y: !i32) -> !i32 {
    %zero = constant {value = 0} : !i32
    %ten = constant {value = 10} : !i32
    %true_value = constant {value = 111} : !i32
    %false_value = constant {value = 222} : !i32
    %path = cmpi %x, %zero {predicate = "eq"} : !i1
    %predicate = scf.switch %path {
      %left = cmpi %y, %ten {predicate = "slt"} : !i1
      -> %left
    }
    {
      %right = cmpi %y, %ten {predicate = "eq"} : !i1
      -> %right
    }
    %result = scf.switch %predicate {
      -> %false_value
    }
    {
      -> %true_value
    }
    func.return %result
  }
  module_end
}

// TRUE: i32 111
// FALSE: i32 222
// CFG-NOT: scf.
// CFG: cmpi
// CFG-COUNT-3: cfg.cond_br
// CFG-NOT: ^{{.*}}(%{{[0-9]+}}: !i1):
