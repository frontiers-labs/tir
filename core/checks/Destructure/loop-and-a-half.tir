// RUN: tir opt --pass destructure %s | tir interp | filecheck %s
// RUN: tir opt --pass destructure --verify %s

// A loop-and-a-half: the value tested is the one the loop produces, and the
// next iteration carries something else.

module {
  %fn_main = func.func @main() -> !i32 {
    %0 = constant {value = 1} : !i32
    %1 = constant {value = 2} : !i32
    %2 = constant {value = 20} : !i32
    %3 = scf.loop (%4 = %0) {
      %5 = addi %4, %0 : !i32
      %6 = cmpi %5, %2 {predicate = "slt"} : !i1
      %7 = muli %5, %1 : !i32
      -> %6, %7, %5
    }
    func.return %3
  }
  module_end
}

// CHECK: i32 23
