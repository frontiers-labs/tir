// RUN: tir opt --pass destructure --verify %s | filecheck %s
// RUN: tir opt --pass destructure %s | tir interp --args=10 | filecheck --check-prefix=TEN %s
// RUN: tir opt --pass destructure %s | tir interp --args=-1 | filecheck --check-prefix=MINUS %s
// RUN: tir opt --pass destructure %s | tir interp --args=1 | filecheck --check-prefix=DEFAULT %s

// A gate naming its cases tests each case value, not its arm index: the value
// 1 names no case here, so it reaches the default.

module {
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %1 = scf.switch %0 case 10 {
      %2 = constant {value = 100} : !i32
      -> %2
    }
    case -1 {
      %3 = constant {value = 200} : !i32
      -> %3
    }
    default {
      %4 = constant {value = 300} : !i32
      -> %4
    }
    func.return %1
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @main(%[[P:[0-9]+]]: !i32) -> !i32 {
// CHECK: %[[K0:[0-9]+]] = constant {value = 10} : !i32
// CHECK: %[[T0:[0-9]+]] = cmpi %[[P]], %[[K0]] {predicate = "eq"} : !i1
// CHECK: %[[K1:[0-9]+]] = constant {value = -1} : !i32
// CHECK-NEXT: %[[T1:[0-9]+]] = cmpi %[[P]], %[[K1]] {predicate = "eq"} : !i1

// TEN: i32 100
// MINUS: i32 200
// DEFAULT: i32 300
