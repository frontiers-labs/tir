// RUN: tir opt --pass destructure --verify %s | filecheck %s

// A gate naming its cases tests each case value, not its arm index: the value
// 1 names no case here, so it reaches the default.

module {
  %fn_main = func.func @main(%0: !i32) -> !i32 {
    %1 = scf.switch %0 case 10 {
      %2 = constant {value = 100} : !i32
      -> %2
    }
    case -1 {
      %3 = constant {value = 200} : !i32
      -> %3
    }
    default {
      %4 = constant {value = 300} : !i32
      -> %4
    }
    func.return %1
  }
  module_end
}

// CHECK: %{{[0-9]+}} = func.func @main(%[[P:[0-9]+]]: !i32) -> !i32 {
// CHECK: cfg.switch %[[P]] : !i32, [
// CHECK-NEXT: default: ^[[DEFAULT:bb[0-9]+]],
// CHECK-NEXT: 10: ^[[TEN:bb[0-9]+]],
// CHECK-NEXT: -1: ^[[NEG:bb[0-9]+]]
// CHECK: ^[[TEN]]:
// CHECK-NEXT: %[[V10:[0-9]+]] = constant {value = 100} : !i32
// CHECK-NEXT: cfg.br ^[[JOIN:bb[0-9]+]](%[[V10]] : !i32)
// CHECK: ^[[NEG]]:
// CHECK-NEXT: %[[VN:[0-9]+]] = constant {value = 200} : !i32
// CHECK-NEXT: cfg.br ^[[JOIN]](%[[VN]] : !i32)
// CHECK: ^[[DEFAULT]]:
// CHECK-NEXT: %[[VD:[0-9]+]] = constant {value = 300} : !i32
// CHECK-NEXT: cfg.br ^[[JOIN]](%[[VD]] : !i32)
// CHECK: ^[[JOIN]](%[[RESULT:[0-9]+]]: !i32):
// CHECK-NEXT: func.return %[[RESULT]]
