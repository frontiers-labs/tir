// A store establishes a cell only for its own state result and exact address.
pub let EqSatWrite: (Int, Int, Int, Int, Int, String, Int, Int, Int) -> Prop;
pub let EqSatStoreSite: (Int, Int, Int, Int, Int, String, Int, Int, Int) -> Prop;
pub let EqSatLoadSite: (Int, Int, Int, Int, Int, String, Int) -> Prop;
pub let EqSatAdjacentWrite: (Int, Int, Int, Int, Int, Int, Int, Int, Int) -> Prop;
pub let EqSatStored: (Int, Int, Int, Int, Int) -> Prop;
pub let EqSatFunctionGraph: Int -> Prop;
pub let EqSatRequiredGraphValue: (Int, Int) -> Prop;
pub let EqSatMemoryOrdered: (Int, Int) -> Prop;
pub let EqSatLoad: (Int, Int, Int, Int) -> Prop;

pub mod memory {
    pub let store<node,address,ty,value,state,place,home,pos,st>:
        (EqSatStoreSite(node,address,ty,value,state,place,home,pos,st),
         EqSatOrdinaryAccess(node), EqSatInteger(ty))
        -> (EqSatWrite(state,address,ty,value,node,place,home,pos,st), EqSatStored(state,address,ty,value,node));
    pub let pointer_store<node,address,ty,value,state,place,home,pos,st,width,alignment>:
        (EqSatStoreSite(node,address,ty,value,state,place,home,pos,st), EqSatOrdinaryAccess(node),
         EqSatPointerType(ty), EqSatStoreLayout(node,width,alignment))
        -> EqSatWrite(state,address,ty,value,node,place,home,pos,st);

    pub let adjacent<first,second,state,next,addr,ty,data,other,block,p,q,st,nt>:
        (EqSatWrite(state,addr,ty,data,first,"block",block,p,st),
         EqSatWrite(next,addr,ty,other,second,"block",block,q,nt),
         q == eqsat_int_add(p,1), Operand(second,2,state))
        -> EqSatAdjacentWrite(first,second,state,next,addr,data,other,st,nt);

    pub let ordered<read,write,kind,block,origin,region,order,prior,q,e,loc,state,ty,slot,decl,addr,out,ot>:
        (EqSatLoadSite(read,addr,ot,out,state,"block",block), EqSatLive(write),
         Operation(write,kind,"block",origin,q,e,loc), Block(block,region,order), Block(origin,region,prior),
         !EqSatMixedRegion(region), Value(state,ty,"result",write,slot,decl))
        -> EqSatMemoryOrdered(read,state);
    pub let block_state<read,block,state,ty,slot,decl,region,order,addr,out,ot>:
        (EqSatLoadSite(read,addr,ot,out,state,"block",block), Value(state,ty,"block",block,slot,decl),
         Block(block,region,order), !EqSatMixedRegion(region))
        -> EqSatMemoryOrdered(read,state);
    // A function exports all its results together. Theta feedback and exit do not.
    pub let function_graph<node, place, home, pos, display, loc, region, slot, entry>:
        (EqSatLive(node), Operation(node, "func.func", place, home, pos, display, loc),
         Region(region, "graph", node, slot, entry)) -> EqSatFunctionGraph(region);
    pub let returned<region,slot,value>:
        (EqSatFunctionGraph(region), Yield(region,slot,value)) -> EqSatRequiredGraphValue(region,value);
    pub let joined<region,out,ty,node,slot,decl,p,d,l,input,i>:
        (EqSatRequiredGraphValue(region,out), Value(out,ty,"result",node,slot,decl),
         Operation(node,"state.join","graph",region,p,d,l), Operand(node,i,input))
        -> EqSatRequiredGraphValue(region,input);
    pub let split<region,out,ty,node,slot,decl,p,d,l,input>:
        (EqSatRequiredGraphValue(region,out), Value(out,ty,"result",node,slot,decl),
         Operation(node,"state.split","graph",region,p,d,l), Operand(node,0,input))
        -> EqSatRequiredGraphValue(region,input);
    pub let written<region,out,node,addr,ty,data,pos,st,input>:
        (EqSatRequiredGraphValue(region,out), EqSatStoreSite(node,addr,ty,data,out,"graph",region,pos,st),
         Operand(node,2,input)) -> EqSatRequiredGraphValue(region,input);
    pub let returned_state<read, write, kind, region, q, e, loc, state, next, addr, out, ot,
                           ty, decl, nd, source_slot>:
        (EqSatLoadSite(read,addr,ot,out,state,"graph",region), EqSatLive(write), EqSatFunctionGraph(region),
         Operation(write,kind,"graph",region,q,e,loc), Value(state,ty,"result",write,source_slot,decl),
         Value(next, ty, "result", read, 1, nd), EqSatRequiredGraphValue(region,next))
        -> EqSatMemoryOrdered(read, state);
    pub let returned_input<read, write, kind, region, q, e, loc, state, addr, out, ot,
                           ty, decl, source_slot>:
        (EqSatLoadSite(read,addr,ot,out,state,"graph",region), EqSatLive(write), EqSatFunctionGraph(region),
         Operation(write,kind,"graph",region,q,e,loc), Value(state,ty,"result",write,source_slot,decl),
         EqSatRequiredGraphValue(region,state))
        -> EqSatMemoryOrdered(read, state);

    pub let forward<node,place,home,address,state,result,ty,value,producer>:
        (EqSatLoadSite(node,address,ty,result,state,place,home), EqSatStored(state,address,ty,value,producer),
         EqSatMemoryOrdered(node,state), EqSatOrdinaryAccess(node))
        -> EqSatLoad(node,state,result,value);
    pub let repeated_read<first,second,address,ty,value,result,state,region>:
        (EqSatLoadSite(first,address,ty,value,state,"graph",region),
         EqSatLoadSite(second,address,ty,result,state,"graph",region), less_id(first,second) == true,
         EqSatOrdinaryAccess(first), EqSatOrdinaryAccess(second), EqSatMemoryOrdered(second,state))
        -> EqSatLoad(second,state,result,value);

    pub let disjoint_write<first,second,state,next,a,b,ty,bt,v,w,place,home,pos,st>:
        (EqSatStored(state,a,ty,v,first), EqSatWrite(next,b,bt,w,second,place,home,pos,st), Operand(second,2,state),
         EqSatAllocation(a), EqSatAllocation(b), equal_id(a,b) == false)
        -> EqSatStored(next,a,ty,v,second);

    pub let forward_value<node, state, result, value>:
        EqSatLoad(node, state, result, value) -> (EqSatReplace(node, result, value), EqSatErase(node));
    pub let forward_state<node, state, result, value, next, ty, declared, kind, owner, slot, input_declared>:
        (EqSatLoad(node, state, result, value), Value(next, ty, "result", node, 1, declared),
         Value(state, ty, kind, owner, slot, input_declared))
        -> EqSatReplace(node, next, state);
}

pub let eqsat_int_add: (Int, Int) -> Int;
pub let EqSatAllocation: Int -> Prop;
pub let EqSatAddressSlot: (String, Int) -> Prop;
pub let EqSatEscapes: Int -> Prop;
pub let EqSatOverwrite: (Int, Int, Int, Int) -> Prop;
pub let EqSatStateOtherUse: Int -> Prop;

pub mod allocation {
    pub let alloc<node, place, home, pos, display, loc, address, ty, decl>:
        (EqSatLive(node), Operation(node, "ptr.alloca", place, home, pos, display, loc),
         Value(address, ty, "result", node, 0, decl)) -> EqSatAllocation(address);
    pub let load: EqSatAddressSlot("ptr.load", 0);
    pub let store: EqSatAddressSlot("ptr.store", 1);
}

pub mod escape {
    pub let escape_use<address, user, slot, kind, place, home, pos, display, loc>:
        (EqSatAllocation(address), Operand(user, slot, address),
         Operation(user, kind, place, home, pos, display, loc), !EqSatAddressSlot(kind, slot))
        -> EqSatEscapes(address);
    pub let escape_result<address, region, slot>:
        (EqSatAllocation(address), Yield(region, slot, address)) -> EqSatEscapes(address);
}

pub mod dead_store_proof {
    pub let adjacent<first,second,state,incoming,next,addr,data,other,st,nt,kind,owner,slot,decl>:
        (EqSatAdjacentWrite(first,second,state,next,addr,data,other,st,nt),
         EqSatDefined(data),
         Operand(first,2,incoming), Value(incoming,st,kind,owner,slot,decl))
        -> EqSatOverwrite(first,second,state,incoming);
    pub let same_value<first,second,state,incoming,next,addr,data,st,nt,kind,owner,slot,decl>:
        (EqSatAdjacentWrite(first,second,state,next,addr,data,data,st,nt),
         Operand(first,2,incoming), Value(incoming,st,kind,owner,slot,decl))
        -> EqSatOverwrite(first,second,state,incoming);
}

pub mod dead_store_uses {
    pub let another<first, second, state, in_state, other, slot>:
        (EqSatOverwrite(first, second, state, in_state), Operand(other, slot, state),
         equal_id(other,second) == false) -> EqSatStateOtherUse(state);
    pub let yielded<first, second, state, in_state, region, slot>:
        (EqSatOverwrite(first, second, state, in_state), Yield(region, slot, state))
        -> EqSatStateOtherUse(state);
}

pub mod dead_store {
    pub let overwrite<first, second, state, incoming>:
        (EqSatOverwrite(first, second, state, incoming), !EqSatStateOtherUse(state))
        -> (EqSatReplace(first, state, incoming), EqSatErase(first));
}

pub let EqSatVisibleAt: (Int, Int) -> Prop;
pub let EqSatBranchCell: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let EqSatBranchDisagrees: (Int, Int, Int, Int, Int) -> Prop;

pub mod memory_join {
    pub let enclosing_port<node, kind, region, pos, display, loc, data, ty, slot, decl>:
        (EqSatLive(node), Operation(node, kind, "graph", region, pos, display, loc),
         Value(data, ty, "region", region, slot, decl)) -> EqSatVisibleAt(node, data);

    pub let captured_literal<node,k,region,p,d,l,data,ty,source,decl,q,sd,sl>:
        (EqSatLive(node), Operation(node,k,"graph",region,p,d,l),
         Value(data,ty,"result",source,0,decl), Operation(source,"builtin.constant","graph",region,q,sd,sl))
        -> EqSatVisibleAt(node,data);
    pub let branch<node,arm,result_slot,arm_state,forwarded,addr,ty,data,producer>:
        (EqSatArmResult(node,arm,result_slot,arm_state,forwarded),
         EqSatStored(arm_state,addr,ty,data,producer), EqSatVisibleAt(node,data))
        -> EqSatBranchCell(node,arm,result_slot,addr,ty,data);

    pub let loop_cell<node, body, port_slot, port, init, exit,
                      result_slot, result, st, decl, addr, ty, data, producer>:
        (EqSatInvariantPort(node,body,port_slot,port,init),
         Binding(body, "exit", result_slot, exit), Yield(body, exit, port),
         EqSatStored(init, addr, ty, data, producer),
         Value(result, st, "result", node, result_slot, decl), EqSatVisibleAt(node, data))
        -> EqSatStored(result, addr, ty, data, node);
}

pub mod memory_join_missing {
    pub let missing<node, result_slot, addr, ty, data, witness, arm, mode, slot, entry>:
        (EqSatBranchCell(node, witness, result_slot, addr, ty, data),
         Region(arm, mode, node, slot, entry), !EqSatBranchCell(node, arm, result_slot, addr, ty, data))
        -> EqSatBranchDisagrees(node, result_slot, addr, ty, data);
}

pub mod memory_join_apply {
    pub let agreed<node, result_slot, addr, ty, data, witness, state, st, decl>:
        (EqSatBranchCell(node, witness, result_slot, addr, ty, data),
         !EqSatBranchDisagrees(node, result_slot, addr, ty, data),
         Value(state, st, "result", node, result_slot, decl))
        -> EqSatStored(state, addr, ty, data, node);
}

pub mod memory_siblings {
    pub let existing_result<node,arm,state_slot,state,addr,ty,data,producer,data_slot,data_exit,value,decl>:
        (EqSatArmResult(node,arm,state_slot,state,false), EqSatStored(state,addr,ty,data,producer),
         Binding(arm,"exit",data_slot,data_exit), Yield(arm,data_exit,data),
         Value(value,ty,"result",node,data_slot,decl))
        -> EqSatBranchCell(node,arm,state_slot,addr,ty,value);
}

pub let SuccessorArgument: (Int, Int, Int, Int) -> Prop;
pub let EqSatCfgCell: (Int, Int, Int, Int, Int, Int, Int) -> Prop;
pub let EqSatCfgDisagrees: (Int, Int, Int, Int, Int) -> Prop;

pub mod memory_cfg {
    pub let edge<node, edge, target, param, operand, state, addr, ty, data, producer,
                 region, order, mode, function, region_slot, entry, data_slot, decl>:
        (EqSatLive(node), Successor(node,edge,target), SuccessorArgument(node,edge,param,operand),
         Operand(node,operand,state), EqSatStored(state,addr,ty,data,producer),
         Block(target,region,order), Region(region,mode,function,region_slot,entry),
         equal_id(target,entry) == false, Value(data,ty,"block",entry,data_slot,decl))
        -> EqSatCfgCell(target,param,node,edge,addr,ty,data);
}

pub mod memory_cfg_missing {
    pub let missing<target, param, addr, ty, data, witness, incoming, node, edge>:
        (EqSatCfgCell(target,param,witness,incoming,addr,ty,data), Successor(node,edge,target),
         !EqSatCfgCell(target,param,node,edge,addr,ty,data))
        -> EqSatCfgDisagrees(target,param,addr,ty,data);
}

pub mod memory_cfg_apply {
    pub let agreed<target, param, addr, ty, data, witness, incoming, state, state_ty, decl>:
        (EqSatCfgCell(target,param,witness,incoming,addr,ty,data), !EqSatCfgDisagrees(target,param,addr,ty,data),
         Value(state,state_ty,"block",target,param,decl))
        -> EqSatStored(state,addr,ty,data,state);
}

// Unthreaded accesses use the verified order of their CFG block.
pub let EqSatOrdinaryAccess: Int -> Prop;
pub let EqSatOperandSlot: (Int, Int) -> Prop;
pub let EqSatPlainStore: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let EqSatPlainLoad: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let EqSatWindow: (Int, Int, Int, Int, Int, Int, Int) -> Prop;
pub let EqSatTransparent: String -> Prop;
pub let EqSatClobber: (Int, Int) -> Prop;
pub let EqSatBlockedSlot: Int -> Prop;
pub let EqSatPrivateWrite: (Int, Int) -> Prop;
pub let EqSatLocalPointerUse: (Int, Int) -> Prop;
pub let eqsat_attr_int: Int -> BigInt;
pub let eqsat_mod: (BigInt, BigInt) -> BigInt;
pub let eqsat_leq_bits: (BigInt, BigInt) -> Bool;

pub mod memory_sites {
    pub let operand<node,slot,value>: Operand(node,slot,value) -> EqSatOperandSlot(node,slot);
    pub let ordinary<node,kind,place,home,pos,display,loc,slot>:
        (EqSatLive(node), Operation(node,kind,place,home,pos,display,loc), EqSatAddressSlot(kind,slot),
         !EqSatHasAttr(node,"volatile"), !EqSatHasAttr(node,"atomic"),
         !EqSatHasAttr(node,"align"), !EqSatHasAttr(node,"alignment"))
        -> EqSatOrdinaryAccess(node);
    pub let store<node,place,home,pos,display,loc,address,ty,data,state,st,sd,kind,owner,slot,decl>:
        (EqSatLive(node), Operation(node,"ptr.store",place,home,pos,display,loc),
         Operand(node,0,data), Operand(node,1,address), Value(data,ty,kind,owner,slot,decl),
         Value(state,st,"result",node,0,sd)) -> EqSatStoreSite(node,address,ty,data,state,place,home,pos,st);
    pub let load<node,place,home,pos,display,loc,address,ty,result,state,decl>:
        (EqSatLive(node), Operation(node,"ptr.load",place,home,pos,display,loc),
         Operand(node,0,address), Operand(node,1,state), Value(result,ty,"result",node,0,decl))
        -> EqSatLoadSite(node,address,ty,result,state,place,home);
}

pub mod plain_access {
    pub let harmless<k>: EqSatDropKind(k) -> EqSatTransparent(k);
    pub let alloca: EqSatTransparent("ptr.alloca");
    pub let plain_store<node,block,pos,display,loc,data,addr,ty,kind,owner,slot,decl>:
        (EqSatLive(node), Operation(node,"ptr.store","block",block,pos,display,loc),
         Operand(node,0,data), Operand(node,1,addr), !EqSatOperandSlot(node,2),
         Value(data,ty,kind,owner,slot,decl), EqSatInteger(ty), EqSatOrdinaryAccess(node))
        -> EqSatPlainStore(node,block,pos,addr,ty,data);
    pub let plain_load<node,block,pos,display,loc,data,addr,ty,decl>:
        (EqSatLive(node), Operation(node,"ptr.load","block",block,pos,display,loc),
         Operand(node,0,addr), !EqSatOperandSlot(node,1),
         Value(data,ty,"result",node,0,decl), EqSatInteger(ty), EqSatOrdinaryAccess(node))
        -> EqSatPlainLoad(node,block,pos,addr,ty,data);
    pub let exact<write,block,pos,addr,ty,data>:
        EqSatPlainStore(write,block,pos,addr,ty,data) -> EqSatAddressEquals(addr,addr);
    pub let pair<read,write,block,p,q,a,b,ty,value,data>:
        (EqSatPlainLoad(read,block,q,a,ty,value), EqSatPlainStore(write,block,p,b,ty,data),
         EqSatAddressEquals(b,a),
         less_id(p,q) == true) -> EqSatWindow(read,write,block,p,q,value,data);
}

pub mod plain_clobber {
    pub let alias<read,write,block,p,q,value,data,node,k,pos,display,loc>:
        (EqSatWindow(read,write,block,p,q,value,data), Operation(node,k,"block",block,pos,display,loc),
         less_id(p,pos) == true, less_id(pos,q) == true, !EqSatTransparent(k),
         !EqSatPreservesCell(write,node))
        -> EqSatClobber(read,write);
}
pub let EqSatPreservesCell: (Int, Int) -> Prop;
pub mod plain_disjoint {
    pub let read_only<first,read,block,p,addr,ty,value,q,d,l>:
        (EqSatPlainStore(first,block,p,addr,ty,value), Operation(read,"ptr.load","block",block,q,d,l),
         EqSatOrdinaryAccess(read)) -> EqSatPreservesCell(first,read);
    pub let different<first,second,block,p,q,a,b,at,bt,x,y>:
        (EqSatPlainStore(first,block,p,a,at,x), EqSatPlainStore(second,block,q,b,bt,y),
         EqSatAllocation(a), EqSatAllocation(b), equal_id(a,b) == false)
        -> EqSatPreservesCell(first,second);
}

pub mod plain_forward {
    pub let load<read,write,block,p,q,value,data>:
        (EqSatWindow(read,write,block,p,q,value,data), !EqSatClobber(read,write))
        -> (EqSatReplace(read,value,data), EqSatErase(read));
}

pub let EqSatStoreLayout: (Int, BigInt, BigInt) -> Prop;
pub let EqSatHasStoreLayout: Int -> Prop;
pub let EqSatPrivateExtent: (Int, BigInt, BigInt) -> Prop;
pub mod private_layout {
    pub let layout<write,width,align>: EqSatStoreLayout(write,width,align)
        -> (EqSatHasStoreLayout(write), EqSatPrivateExtent(write,width,align));
}
pub mod private_extent {
    pub let native_integer<write,block,p,addr,ty,data,ctor,args,width>:
        (EqSatPlainStore(write,block,p,addr,ty,data), !EqSatHasStoreLayout(write),
         EqSatAllocation(addr), TypeTerm(ty,ctor,args), width == eqsat_width(args))
        -> EqSatPrivateExtent(write,eqsat_bigint(width),eqsat_bigint(1));
}

pub mod private_store {
    pub let bounded_defined<write,block,position,addr,base,offset,ty,data,alloc,st,decl,p,d,l,handle,bytes,alignment,align,width,end,start,required>:
        (EqSatPlainStore(write,block,position,addr,ty,data), EqSatLocalAddress(addr,base,offset),
         Value(base,st,"result",alloc,0,decl),
         Operation(alloc,"ptr.alloca","block",block,p,d,l),
         Attribute("operation",alloc,"size",handle), bytes == eqsat_attr_int(handle),
         Attribute("operation",alloc,"align",alignment), align == eqsat_attr_int(alignment),
         EqSatPrivateExtent(write,width,required), start == eqsat_product(offset,eqsat_bigint(8)),
         eqsat_leq_bits(eqsat_bigint(1),align) == true, eqsat_leq_bits(eqsat_bigint(1),width) == true,
         eqsat_mod(start,required) == eqsat_bigint(0),
         eqsat_mod(eqsat_product(align,eqsat_bigint(8)),required) == eqsat_bigint(0),
         end == eqsat_sum(start,width),
         eqsat_leq_bits(end,eqsat_product(bytes,eqsat_bigint(8))) == true,
         EqSatDefined(data))
        -> EqSatPrivateWrite(base,write);
    pub let derivation<addr,base,offset,result,off,node,ty,decl,p,d,l,b,i,w,m,dist>:
        (EqSatLocalAddress(addr,base,offset), EqSatLocalAddress(result,base,off),
         EqSatOffsetStep(result,addr,ty,i,w,dist,m), Value(result,ty,"result",node,0,decl),
         Operation(node,"ptr.ptradd","block",b,p,d,l), !EqSatPinned(result))
        -> (EqSatLocalPointerUse(addr,node), EqSatRemovable(node,result), EqSatRemovableNode(node));
}

pub mod private_other {
    pub let other<addr,base,offset,node,slot>:
        (EqSatLocalAddress(addr,base,offset), Operand(node,slot,addr),
         !EqSatPrivateWrite(base,node), !EqSatLocalPointerUse(addr,node))
        -> EqSatBlockedSlot(base);
    pub let yielded<addr,base,offset,region,slot>:
        (EqSatLocalAddress(addr,base,offset), Yield(region,slot,addr)) -> EqSatBlockedSlot(base);
}

pub mod private_drop {
    pub let write<addr,node>: (EqSatPrivateWrite(addr,node), !EqSatBlockedSlot(addr)) -> EqSatDead(node);
    pub let alloca<addr,node,ty,decl,h,p,d,l>:
        (EqSatAllocation(addr), !EqSatBlockedSlot(addr), !EqSatPinned(addr),
         Value(addr,ty,"result",node,0,decl), Operation(node,"ptr.alloca","block",h,p,d,l),
         !EqSatExtraResult(node)) -> EqSatDead(node);
}
pub let EqSatExtraResult: Int -> Prop;
pub mod allocation_shape {
    pub let multiple<node,value,ty,slot,decl>:
        (Value(value,ty,"result",node,slot,decl), less_id(0,slot) == true)
        -> EqSatExtraResult(node);
}

pub let EqSatPointerSize: (Int, Int) -> Prop;
pub let EqSatPointerType: Int -> Prop;
pub let EqSatPointerCell: (Int, Int, Int, Int, Int) -> Prop;
pub mod pointer_cells {
    pub let pointer<ty,ctor,args,decl,default>:
        (TypeTerm(ty,ctor,args), TypeCtor(ctor,"ptr","p",decl,default)) -> EqSatPointerType(ty);
    pub let write<node,place,home,pos,state,st,address,value,ty,width>:
        (EqSatStoreSite(node,address,ty,value,state,place,home,pos,st),
         EqSatPointerSize(node,width), EqSatPointerType(ty), EqSatOrdinaryAccess(node))
        -> EqSatPointerCell(state,address,ty,width,value);
    pub let read<node,place,home,address,state,result,ty,width,value>:
        (EqSatLoadSite(node,address,ty,result,state,place,home), EqSatPointerSize(node,width),
         EqSatPointerCell(state,address,ty,width,value), EqSatMemoryOrdered(node,state), EqSatOrdinaryAccess(node))
        -> EqSatLoad(node,state,result,value);
}

pub let EqSatPlainOverwrite: (Int, Int, Int, Int, Int) -> Prop;
pub let EqSatOverwriteBarrier: (Int, Int) -> Prop;
pub mod plain_overwrites {
    pub let repeated<first,second,block,p,q,addr,ty,value>:
        (EqSatPlainStore(first,block,p,addr,ty,value),
         EqSatPlainStore(second,block,q,addr,ty,value), q == eqsat_int_add(p,1))
        -> EqSatDead(first);
    pub let candidate<first,second,block,p,q,addr,ty,x,y>:
        (EqSatPlainStore(first,block,p,addr,ty,x), EqSatPlainStore(second,block,q,addr,ty,y),
         less_id(p,q) == true, EqSatDefined(x)) -> EqSatPlainOverwrite(first,second,block,p,q);
}
pub mod overwrite_barriers {
    pub let intervening<first,second,block,p,q,node,k,pos,d,l>:
        (EqSatPlainOverwrite(first,second,block,p,q), Operation(node,k,"block",block,pos,d,l),
         less_id(p,pos) == true, less_id(pos,q) == true, !EqSatDropKind(k))
        -> EqSatOverwriteBarrier(first,second);
}
pub mod overwrite_plain {
    pub let unobserved<first,second,block,p,q>:
        (EqSatPlainOverwrite(first,second,block,p,q), !EqSatOverwriteBarrier(first,second))
        -> EqSatDead(first);
}

pub mod read_state {
    pub let retain_cell<node,block,addr,before,after,ty,value,producer,st,decl,result>:
        (EqSatLoadSite(node,addr,ty,result,before,"block",block), Value(after,st,"result",node,1,decl),
         EqSatStored(before,addr,ty,value,producer), EqSatOrdinaryAccess(node))
        -> EqSatStored(after,addr,ty,value,node);
}

pub mod private_call {
    pub let inaccessible<write,block,p,addr,ty,value,call,q,d,l>:
        (EqSatPlainStore(write,block,p,addr,ty,value), EqSatAllocation(addr),
         !EqSatEscapes(addr), Operation(call,"func.call","block",block,q,d,l))
        -> EqSatPreservesCell(write,call);
}

pub let EqSatMixedRegion: Int -> Prop;
pub let EqSatOpaqueMemory: String -> Prop;
pub mod memory_barriers {
    pub let call: EqSatOpaqueMemory("func.call");
    pub let indirect: EqSatOpaqueMemory("func.call_indirect");
    pub let copy: EqSatOpaqueMemory("ptr.memcpy");
    pub let fill: EqSatOpaqueMemory("ptr.memset");
    pub let typed_copy: EqSatOpaqueMemory("ptr.copy");
    pub let unthreaded<node,k,block,p,d,l,region,order,address,token>:
        (Operation(node,k,"block",block,p,d,l), Block(block,region,order), EqSatAddressSlot(k,address),
         token == eqsat_int_add(address,1), !EqSatOperandSlot(node,token))
        -> EqSatMixedRegion(region);
    pub let flagged<node,k,block,p,d,l,region,order,address>:
        (EqSatLive(node), Operation(node,k,"block",block,p,d,l), Block(block,region,order),
         EqSatAddressSlot(k,address), !EqSatOrdinaryAccess(node))
        -> EqSatMixedRegion(region);
    pub let opaque<node,k,block,p,d,l,region,order>:
        (Operation(node,k,"block",block,p,d,l), Block(block,region,order), EqSatOpaqueMemory(k))
        -> EqSatMixedRegion(region);
}


pub mod storage_defined {
    pub let literal<node,place,home,p,d,l,out,ty,decl>:
        (EqSatLive(node), Operation(node,"builtin.constant",place,home,p,d,l),
         Value(out,ty,"result",node,0,decl), EqSatInteger(ty)) -> EqSatDefined(out);
    pub let argument<node,out>: EqSatArgumentFreeze(node,out) -> EqSatDefined(out);
    pub let product<node,out,ty,x,y,home>:
        (EqSatBinary(node,"builtin.muli",out,ty,x,y,home), EqSatDefined(x), EqSatDefined(y))
        -> EqSatDefined(out);
}
