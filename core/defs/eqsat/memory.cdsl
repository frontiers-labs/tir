// Migrated faithfully from `core/defs/eqsat/memory.cdsl` to pure CDSL v3 `Rule(...)` syntax.

use std::core::*;
use std::bigint::*;
use std::int::*;

pub let memory_facts: List<Rule> = {
    let store<node, address, ty, value, state, place, home, pos, st>: Rule((EqSatStoreSite(node,address,ty,value,state,place,home,pos,st),
         EqSatOrdinaryAccess(node), EqSatInteger(ty)) -> (EqSatWrite(state,address,ty,value,node,place,home,pos,st), EqSatStored(state,address,ty,value)));
    let pointer_store<node, address, ty, value, state, place, home, pos, st, width, alignment>: Rule((EqSatStoreSite(node,address,ty,value,state,place,home,pos,st), EqSatOrdinaryAccess(node),
         EqSatPointerType(ty), EqSatStoreLayout(node,width,alignment)) -> EqSatWrite(state,address,ty,value,node,place,home,pos,st));
    let adjacent<first, second, state, next, addr, ty, data, other, block, p, q, st, nt>: Rule((EqSatWrite(state,addr,ty,data,first,"block",block,p,st),
         EqSatWrite(next,addr,ty,other,second,"block",block,q,nt),
         q == (p + 1), Operand(second,2,state)) -> EqSatAdjacentWrite(first,second,state,next,addr,data,other,st,nt));
    let ordered<read, write, kind, block, origin, region, order, prior, q, e, loc, state, ty, slot, decl, addr, out, ot>: Rule((EqSatLoadSite(read,addr,ot,out,state,"block",block), EqSatLive(write),
         Operation(write, kind, "block", origin, q, e, loc), Block(block,region,order), Block(origin,region,prior),
         !EqSatMixedRegion(region), Value(state, ty, "result", write, slot, decl)) -> EqSatMemoryOrdered(read,state));
    let block_state<read, block, state, ty, slot, decl, region, order, addr, out, ot>: Rule((EqSatLoadSite(read,addr,ot,out,state,"block",block), Value(state,ty,"block",block,slot,decl),
         Block(block,region,order), !EqSatMixedRegion(region)) -> EqSatMemoryOrdered(read,state));
    // A function exports all its results together. Theta feedback and exit do not.
    let function_graph<node, place, home, pos, display, loc, region, slot, entry>: Rule((EqSatLive(node), Operation(node, dialects::func::func.kind, place, home, pos, display, loc),
         Region(region, "graph", node, slot, entry)) -> EqSatFunctionGraph(region));
    let returned<region, slot, value>: Rule((EqSatFunctionGraph(region), Yield(region,slot,value)) -> EqSatRequiredGraphValue(region,value));
    let joined<region, out, ty, node, slot, decl, p, d, l, input, i>: Rule((EqSatRequiredGraphValue(region,out), Value(out, ty, "result", node, slot, decl),
         Operation(node, dialects::state::join.kind, "graph", region, p, d, l), Operand(node,i,input)) -> EqSatRequiredGraphValue(region,input));
    let split<region, out, ty, node, slot, decl, p, d, l, input>: Rule((EqSatRequiredGraphValue(region,out), Value(out, ty, "result", node, slot, decl),
         Operation(node, dialects::state::split.kind, "graph", region, p, d, l), Operand(node,0,input)) -> EqSatRequiredGraphValue(region,input));
    let written<region, out, node, addr, ty, data, pos, st, input>: Rule((EqSatRequiredGraphValue(region,out), EqSatStoreSite(node,addr,ty,data,out,"graph",region,pos,st),
         Operand(node,2,input)) -> EqSatRequiredGraphValue(region,input));
    let returned_state<read, write, kind, region, q, e, loc, state, next, addr, out, ot, ty, decl, nd, source_slot>: Rule((EqSatLoadSite(read,addr,ot,out,state,"graph",region), EqSatLive(write), EqSatFunctionGraph(region),
         Operation(write, kind, "graph", region, q, e, loc), Value(state, ty, "result", write, source_slot, decl),
         Value(next, ty, "result", read, 1, nd), EqSatRequiredGraphValue(region,next)) -> EqSatMemoryOrdered(read, state));
    let returned_input<read, write, kind, region, q, e, loc, state, addr, out, ot, ty, decl, source_slot>: Rule((EqSatLoadSite(read,addr,ot,out,state,"graph",region), EqSatLive(write), EqSatFunctionGraph(region),
         Operation(write, kind, "graph", region, q, e, loc), Value(state, ty, "result", write, source_slot, decl),
         EqSatRequiredGraphValue(region,state)) -> EqSatMemoryOrdered(read, state));
    let forward<node, place, home, address, state, result, ty, value>: Rule((EqSatLoadSite(node,address,ty,result,state,place,home), EqSatStored(state,address,ty,value),
         EqSatMemoryOrdered(node,state), EqSatOrdinaryAccess(node)) -> EqSatLoad(node,state,result,value));
    let repeated_read<first, second, address, ty, value, result, state, region>: Rule((EqSatLoadSite(first,address,ty,value,state,"graph",region),
         EqSatLoadSite(second,address,ty,result,state,"graph",region), less(first,second) == true,
         EqSatOrdinaryAccess(first), EqSatOrdinaryAccess(second), EqSatMemoryOrdered(second,state)) -> EqSatLoad(second,state,result,value));
    let disjoint_write<second, state, next, a, b, ty, bt, v, w, place, home, pos, st>: Rule((EqSatStored(state,a,ty,v), EqSatWrite(next,b,bt,w,second,place,home,pos,st), Operand(second,2,state),
         EqSatAllocation(a), EqSatAllocation(b), a != b) -> EqSatStored(next,a,ty,v));
    let forward_value<node, state, result, value>: Rule(EqSatLoad(node, state, result, value) -> (EqSatReplace(node, result, value), EqSatErase(node)));
    let forward_state<node, state, result, value, next, ty, declared, kind, owner, slot, input_declared>: Rule((EqSatLoad(node, state, result, value), Value(next, ty, "result", node, 1, declared),
         Value(state, ty, kind, owner, slot, input_declared)) -> EqSatReplace(node, next, state));
    List(store, pointer_store, adjacent, ordered, block_state, function_graph, returned, joined, split, written, returned_state, returned_input, forward, repeated_read, disjoint_write, forward_value, forward_state)
};

pub let allocation: List<Rule> = {
    let alloc<node, place, home, pos, display, loc, address, ty, decl>: Rule((EqSatLive(node), Operation(node, dialects::ptr::alloca.kind, place, home, pos, display, loc),
         Value(address, ty, "result", node, 0, decl)) -> EqSatAllocation(address));
    let load: Rule(() -> EqSatAddressSlot(dialects::ptr::load.kind, 0));
    let store: Rule(() -> EqSatAddressSlot(dialects::ptr::store.kind, 1));
    List(alloc, load, store)
};

pub let escape: List<Rule> = {
    let escape_use<address, user, slot, kind, place, home, pos, display, loc>: Rule((EqSatAllocation(address), Operand(user, slot, address),
         Operation(user, kind, place, home, pos, display, loc), !EqSatAddressSlot(kind, slot)) -> EqSatEscapes(address));
    let escape_result<address, region, slot>: Rule((EqSatAllocation(address), Yield(region, slot, address)) -> EqSatEscapes(address));
    List(escape_use, escape_result)
};

pub let dead_store_proof: List<Rule> = {
    let adjacent<first, second, state, incoming, next, addr, data, other, st, nt, kind, owner, slot, decl>: Rule((EqSatAdjacentWrite(first,second,state,next,addr,data,other,st,nt),
         EqSatDefined(data),
         Operand(first,2,incoming), Value(incoming,st,kind,owner,slot,decl)) -> EqSatOverwrite(first,second,state,incoming));
    let same_value<first, second, state, incoming, next, addr, data, st, nt, kind, owner, slot, decl>: Rule((EqSatAdjacentWrite(first,second,state,next,addr,data,data,st,nt),
         Operand(first,2,incoming), Value(incoming,st,kind,owner,slot,decl)) -> EqSatOverwrite(first,second,state,incoming));
    List(adjacent, same_value)
};

pub let dead_store_uses: List<Rule> = {
    let another<first, second, state, in_state, other, slot>: Rule((EqSatOverwrite(first, second, state, in_state), Operand(other, slot, state),
         other != second) -> EqSatStateOtherUse(state));
    let yielded<first, second, state, in_state, region, slot>: Rule((EqSatOverwrite(first, second, state, in_state), Yield(region, slot, state)) -> EqSatStateOtherUse(state));
    List(another, yielded)
};

pub let dead_store: List<Rule> = {
    let overwrite<first, second, state, incoming>: Rule((EqSatOverwrite(first, second, state, incoming), !EqSatStateOtherUse(state)) -> (EqSatReplace(first, state, incoming), EqSatErase(first)));
    List(overwrite)
};

pub let memory_join: List<Rule> = {
    let enclosing_port<node, kind, region, pos, display, loc, data, ty, slot, decl>: Rule((EqSatLive(node), Operation(node, kind, "graph", region, pos, display, loc),
         Value(data, ty, "region", region, slot, decl)) -> EqSatVisibleAt(node, data));
    let captured_literal<node, k, region, p, d, l, data, source, source_kind, q, sd, sl, _m_p0, _m_h0, _m_pos0, _m_d0, _m_l0, _m_ty0_0, _m_dl0_0>: Rule((EqSatLive(node), Operation(node, k, "graph", region, p, d, l),
         Operation(source, dialects::builtin::constant.kind, _m_p0, _m_h0, _m_pos0, _m_d0, _m_l0), Value(data, _m_ty0_0, "result", source, 0, _m_dl0_0),
         Operation(source, source_kind, "graph", region, q, sd, sl)) -> EqSatVisibleAt(node,data));
    let branch<node, arm, result_slot, arm_state, forwarded, addr, ty, data>: Rule((EqSatArmResult(node,arm,result_slot,arm_state,forwarded),
         EqSatStored(arm_state,addr,ty,data), EqSatVisibleAt(node,data)) -> EqSatBranchCell(node,arm,result_slot,addr,ty,data));
    let loop_cell<node, body, port_slot, port, init, exit, result_slot, result, st, decl, addr, ty, data>: Rule((EqSatInvariantPort(node,body,port_slot,port,init),
         Binding(body, "exit", result_slot, exit), Yield(body, exit, port),
         EqSatStored(init, addr, ty, data),
         Value(result, st, "result", node, result_slot, decl), EqSatVisibleAt(node, data)) -> EqSatStored(result, addr, ty, data));
    List(enclosing_port, captured_literal, branch, loop_cell)
};

pub let memory_join_missing: List<Rule> = {
    let missing<node, result_slot, addr, ty, data, witness, arm, mode, slot, entry>: Rule((EqSatBranchCell(node, witness, result_slot, addr, ty, data),
         Region(arm, mode, node, slot, entry), !EqSatBranchCell(node, arm, result_slot, addr, ty, data)) -> EqSatBranchDisagrees(node, result_slot, addr, ty, data));
    List(missing)
};

pub let memory_join_apply: List<Rule> = {
    let agreed<node, result_slot, addr, ty, data, witness, state, st, decl>: Rule((EqSatBranchCell(node, witness, result_slot, addr, ty, data),
         !EqSatBranchDisagrees(node, result_slot, addr, ty, data),
         Value(state, st, "result", node, result_slot, decl)) -> EqSatStored(state, addr, ty, data));
    List(agreed)
};

pub let memory_siblings: List<Rule> = {
    let existing_result<node, arm, state_slot, state, addr, ty, data, data_slot, data_exit, value, decl>: Rule((EqSatArmResult(node,arm,state_slot,state,false), EqSatStored(state,addr,ty,data),
         Binding(arm,"exit",data_slot,data_exit), Yield(arm,data_exit,data),
         Value(value, ty, "result", node, data_slot, decl)) -> EqSatBranchCell(node,arm,state_slot,addr,ty,value));
    List(existing_result)
};

pub let memory_cfg: List<Rule> = {
    let edge<node, edge, target, param, operand, state, addr, ty, data, region, order, mode, function, region_slot, entry, data_slot, decl>: Rule((EqSatLive(node), Successor(node,edge,target), SuccessorArgument(node,edge,param,operand),
         Operand(node,operand,state), EqSatStored(state,addr,ty,data),
         Block(target,region,order), Region(region,mode,function,region_slot,entry),
         target != entry, Value(data,ty,"block",entry,data_slot,decl)) -> EqSatCfgCell(target,param,node,edge,addr,ty,data));
    List(edge)
};

pub let memory_cfg_missing: List<Rule> = {
    let missing<target, param, addr, ty, data, witness, incoming, node, edge>: Rule((EqSatCfgCell(target,param,witness,incoming,addr,ty,data), Successor(node,edge,target),
         !EqSatCfgCell(target,param,node,edge,addr,ty,data)) -> EqSatCfgDisagrees(target,param,addr,ty,data));
    List(missing)
};

pub let memory_cfg_apply: List<Rule> = {
    let agreed<target, param, addr, ty, data, witness, incoming, state, state_ty, decl>: Rule((EqSatCfgCell(target,param,witness,incoming,addr,ty,data), !EqSatCfgDisagrees(target,param,addr,ty,data),
         Value(state,state_ty,"block",target,param,decl)) -> EqSatStored(state,addr,ty,data));
    List(agreed)
};

pub let memory_sites: List<Rule> = {
    let operand<node, slot, value>: Rule(Operand(node,slot,value) -> EqSatOperandSlot(node,slot));
    let ordinary<node, kind, place, home, pos, display, loc, slot>: Rule((EqSatLive(node), Operation(node, kind, place, home, pos, display, loc), EqSatAddressSlot(kind,slot),
         !EqSatHasAttr(node,"volatile"), !EqSatHasAttr(node,"atomic"),
         !EqSatHasAttr(node,"align"), !EqSatHasAttr(node,"alignment")) -> EqSatOrdinaryAccess(node));
    let store<node, place, home, pos, display, loc, address, ty, data, state, st, sd, kind, owner, slot, decl>: Rule((EqSatLive(node), Operation(node, dialects::ptr::store.kind, place, home, pos, display, loc),
         Operand(node,0,data), Operand(node,1,address), Value(data,ty,kind,owner,slot,decl),
         Value(state, st, "result", node, 0, sd)) -> EqSatStoreSite(node,address,ty,data,state,place,home,pos,st));
    let load<node, place, home, pos, display, loc, address, ty, result, state, decl>: Rule((EqSatLive(node), Operation(node, dialects::ptr::load.kind, place, home, pos, display, loc),
         Operand(node,0,address), Operand(node,1,state), Value(result, ty, "result", node, 0, decl)) -> EqSatLoadSite(node,address,ty,result,state,place,home));
    List(operand, ordinary, store, load)
};

pub let plain_access: List<Rule> = {
    let harmless<k>: Rule(EqSatDropKind(k) -> EqSatTransparent(k));
    let alloca: Rule(() -> EqSatTransparent(dialects::ptr::alloca.kind));
    let plain_store<node, block, pos, display, loc, data, addr, ty, kind, owner, slot, decl>: Rule((EqSatLive(node), Operation(node, dialects::ptr::store.kind, "block", block, pos, display, loc),
         Operand(node,0,data), Operand(node,1,addr), !EqSatOperandSlot(node,2),
         Value(data,ty,kind,owner,slot,decl), EqSatInteger(ty), EqSatOrdinaryAccess(node)) -> EqSatPlainStore(node,block,pos,addr,ty,data));
    let plain_load<node, block, pos, display, loc, data, addr, ty, decl>: Rule((EqSatLive(node), Operation(node, dialects::ptr::load.kind, "block", block, pos, display, loc),
         Operand(node,0,addr), !EqSatOperandSlot(node,1),
         Value(data, ty, "result", node, 0, decl), EqSatInteger(ty), EqSatOrdinaryAccess(node)) -> EqSatPlainLoad(node,block,pos,addr,ty,data));
    let exact<write, block, pos, addr, ty, data>: Rule(EqSatPlainStore(write,block,pos,addr,ty,data) -> EqSatAddressEquals(addr,addr));
    let pair<read, write, block, p, q, a, b, ty, value, data>: Rule((EqSatPlainLoad(read,block,q,a,ty,value), EqSatPlainStore(write,block,p,b,ty,data),
         EqSatAddressEquals(b,a),
         less(p,q) == true) -> EqSatWindow(read,write,block,p,q,value,data));
    List(harmless, alloca, plain_store, plain_load, exact, pair)
};

pub let plain_clobber: List<Rule> = {
    let alias<read, write, block, p, q, value, data, node, k, pos, display, loc>: Rule((EqSatWindow(read,write,block,p,q,value,data), Operation(node, k, "block", block, pos, display, loc),
         less(p,pos) == true, less(pos,q) == true, !EqSatTransparent(k),
         !EqSatPreservesCell(write,node)) -> EqSatClobber(read,write));
    List(alias)
};

pub let plain_disjoint: List<Rule> = {
    let read_only<first, read, block, p, addr, ty, value, q, d, l>: Rule((EqSatPlainStore(first,block,p,addr,ty,value), Operation(read, dialects::ptr::load.kind, "block", block, q, d, l),
         EqSatOrdinaryAccess(read)) -> EqSatPreservesCell(first,read));
    let different<first, second, block, p, q, a, b, at, bt, x, y>: Rule((EqSatPlainStore(first,block,p,a,at,x), EqSatPlainStore(second,block,q,b,bt,y),
         EqSatAllocation(a), EqSatAllocation(b), a != b) -> EqSatPreservesCell(first,second));
    List(read_only, different)
};

pub let plain_forward: List<Rule> = {
    let load<read, write, block, p, q, value, data>: Rule((EqSatWindow(read,write,block,p,q,value,data), !EqSatClobber(read,write)) -> (EqSatReplace(read, value, data), EqSatErase(read)));
    List(load)
};

pub let private_layout: List<Rule> = {
    let layout<write, width, align>: Rule(EqSatStoreLayout(write,width,align) -> (EqSatHasStoreLayout(write), EqSatPrivateExtent(write,width,align)));
    List(layout)
};

pub let private_extent: List<Rule> = {
    let native_integer<write, block, p, addr, ty, data, ctor, args, width>: Rule((EqSatPlainStore(write,block,p,addr,ty,data), !EqSatHasStoreLayout(write),
         EqSatAllocation(addr), TypeTerm(ty,ctor,args), width == integer_width(args)) -> EqSatPrivateExtent(write,bigint_of(width),bigint(1)));
    List(native_integer)
};

pub let private_store: List<Rule> = {
    let bounded_defined<write, block, position, addr, base, offset, ty, data, alloc, st, decl, p, d, l, handle, bytes, alignment, align, width, end, start, required>: Rule((EqSatPlainStore(write,block,position,addr,ty,data), EqSatLocalAddress(addr,base,offset),
         Value(base, st, "result", alloc, 0, decl),
         Operation(alloc, dialects::ptr::alloca.kind, "block", block, p, d, l),
         Attribute("operation", alloc, "size", handle), bytes == eqsat_attr_int(handle),
         Attribute("operation", alloc, "align", alignment), align == eqsat_attr_int(alignment),
         EqSatPrivateExtent(write,width,required), start == (offset * bigint(8)),
         big_le(bigint(1),align) == true, big_le(bigint(1),width) == true,
         (start % required) == bigint(0),
         ((align * bigint(8)) % required) == bigint(0),
         end == (start + width),
         big_le(end,big_mul(bytes, bigint(8))) == true,
         EqSatDefined(data)) -> EqSatPrivateWrite(base,write));
    let derivation<addr, base, offset, result, off, node, ty, decl, p, d, l, b, i, w, m, dist>: Rule((EqSatLocalAddress(addr,base,offset), EqSatLocalAddress(result,base,off),
         EqSatOffsetStep(result,addr,ty,i,w,dist,m), Value(result, ty, "result", node, 0, decl),
         Operation(node, dialects::ptr::ptradd.kind, "block", b, p, d, l), !EqSatPinned(result)) -> (EqSatLocalPointerUse(addr,node), EqSatRemovable(node,result), EqSatRemovableNode(node)));
    List(bounded_defined, derivation)
};

pub let private_other: List<Rule> = {
    let other<addr, base, offset, node, slot>: Rule((EqSatLocalAddress(addr,base,offset), Operand(node,slot,addr),
         !EqSatPrivateWrite(base,node), !EqSatLocalPointerUse(addr,node)) -> EqSatBlockedSlot(base));
    let yielded<addr, base, offset, region, slot>: Rule((EqSatLocalAddress(addr,base,offset), Yield(region,slot,addr)) -> EqSatBlockedSlot(base));
    List(other, yielded)
};

pub let private_drop: List<Rule> = {
    let write<addr, node>: Rule((EqSatPrivateWrite(addr,node), !EqSatBlockedSlot(addr)) -> EqSatDead(node));
    let alloca<addr, node, ty, decl, h, p, d, l>: Rule((EqSatAllocation(addr), !EqSatBlockedSlot(addr), !EqSatPinned(addr),
         Value(addr, ty, "result", node, 0, decl), Operation(node, dialects::ptr::alloca.kind, "block", h, p, d, l),
         !EqSatExtraResult(node)) -> EqSatDead(node));
    List(write, alloca)
};

pub let allocation_shape: List<Rule> = {
    let multiple<node, value, ty, slot, decl>: Rule((Value(value, ty, "result", node, slot, decl), less(int_lit(0),slot) == true) -> EqSatExtraResult(node));
    List(multiple)
};

pub let pointer_cells: List<Rule> = {
    let pointer<ty, ctor, args, decl, default>: Rule((TypeTerm(ty,ctor,args), TypeCtor(ctor,"ptr","p",decl,default)) -> EqSatPointerType(ty));
    let write<node, place, home, pos, state, st, address, value, ty, width>: Rule((EqSatStoreSite(node,address,ty,value,state,place,home,pos,st),
         EqSatPointerSize(node,width), EqSatPointerType(ty), EqSatOrdinaryAccess(node)) -> EqSatPointerCell(state,address,ty,width,value));
    let read<node, place, home, address, state, result, ty, width, value>: Rule((EqSatLoadSite(node,address,ty,result,state,place,home), EqSatPointerSize(node,width),
         EqSatPointerCell(state,address,ty,width,value), EqSatMemoryOrdered(node,state), EqSatOrdinaryAccess(node)) -> EqSatLoad(node,state,result,value));
    List(pointer, write, read)
};

pub let plain_overwrites: List<Rule> = {
    let repeated<first, second, block, p, q, addr, ty, value>: Rule((EqSatPlainStore(first,block,p,addr,ty,value),
         EqSatPlainStore(second,block,q,addr,ty,value), q == (p + 1)) -> EqSatDead(first));
    let candidate<first, second, block, p, q, addr, ty, x, y>: Rule((EqSatPlainStore(first,block,p,addr,ty,x), EqSatPlainStore(second,block,q,addr,ty,y),
         less(p,q) == true, EqSatDefined(x)) -> EqSatPlainOverwrite(first,second,block,p,q));
    List(repeated, candidate)
};

pub let overwrite_barriers: List<Rule> = {
    let intervening<first, second, block, p, q, node, k, pos, d, l>: Rule((EqSatPlainOverwrite(first,second,block,p,q), Operation(node, k, "block", block, pos, d, l),
         less(p,pos) == true, less(pos,q) == true, !EqSatDropKind(k)) -> EqSatOverwriteBarrier(first,second));
    List(intervening)
};

pub let overwrite_plain: List<Rule> = {
    let unobserved<first, second, block, p, q>: Rule((EqSatPlainOverwrite(first,second,block,p,q), !EqSatOverwriteBarrier(first,second)) -> EqSatDead(first));
    List(unobserved)
};

pub let read_state: List<Rule> = {
    let retain_cell<node, block, addr, before, after, ty, value, st, decl, result>: Rule((EqSatLoadSite(node,addr,ty,result,before,"block",block), Value(after, st, "result", node, 1, decl),
         EqSatStored(before,addr,ty,value), EqSatOrdinaryAccess(node)) -> EqSatStored(after,addr,ty,value));
    List(retain_cell)
};

pub let private_call: List<Rule> = {
    let inaccessible<write, block, p, addr, ty, value, call, q, d, l>: Rule((EqSatPlainStore(write,block,p,addr,ty,value), EqSatAllocation(addr),
         !EqSatEscapes(addr), Operation(call, dialects::func::call.kind, "block", block, q, d, l)) -> EqSatPreservesCell(write,call));
    List(inaccessible)
};

pub let memory_barriers: List<Rule> = {
    let call: Rule(() -> EqSatOpaqueMemory(dialects::func::call.kind));
    let copy: Rule(() -> EqSatOpaqueMemory(dialects::ptr::memcpy.kind));
    let fill: Rule(() -> EqSatOpaqueMemory(dialects::ptr::memset.kind));
    let typed_copy: Rule(() -> EqSatOpaqueMemory(dialects::ptr::copy.kind));
    let unthreaded<node, k, block, p, d, l, region, order, address, token>: Rule((Operation(node, k, "block", block, p, d, l), Block(block,region,order), EqSatAddressSlot(k,address),
         token == (address + 1), !EqSatOperandSlot(node,token)) -> EqSatMixedRegion(region));
    let flagged<node, k, block, p, d, l, region, order, address>: Rule((EqSatLive(node), Operation(node, k, "block", block, p, d, l), Block(block,region,order),
         EqSatAddressSlot(k,address), !EqSatOrdinaryAccess(node)) -> EqSatMixedRegion(region));
    let opaque<node, k, block, p, d, l, region, order>: Rule((Operation(node, k, "block", block, p, d, l), Block(block,region,order), EqSatOpaqueMemory(k)) -> EqSatMixedRegion(region));
    List(call, copy, fill, typed_copy, unthreaded, flagged, opaque)
};

pub let storage_defined: List<Rule> = {
    let literal<node, out, ty, decl, _m_p0, _m_h0, _m_pos0, _m_d0, _m_l0, _m_ty0_0, _m_dl0_0>: Rule((EqSatLive(node), Operation(node, dialects::builtin::constant.kind, _m_p0, _m_h0, _m_pos0, _m_d0, _m_l0), Value(out, _m_ty0_0, "result", node, 0, _m_dl0_0),
         Value(out, ty, "result", node, 0, decl), EqSatInteger(ty)) -> EqSatDefined(out));
    let argument<node, out>: Rule(EqSatArgumentFreeze(node,out) -> EqSatDefined(out));
    let product<node, out, ty, x, y, home>: Rule((EqSatBinary(node,dialects::builtin::muli.kind,out,ty,x,y,home), EqSatDefined(x), EqSatDefined(y)) -> EqSatDefined(out));
    List(literal, argument, product)
};

