pub mod floating_point {
    pub let capture_round_trip<node, place, home, pos, display, loc,
                               capture, cplace, chome, cpos, cdisplay, cloc,
                               computation, cty, cdecl, x, kind, owner, slot, xdecl,
                               result, ty, declared>:
        (EqSatLive(node), Operation(node, "fp.materialize", place, home, pos, display, loc),
         Operand(node, 0, computation), Value(computation, cty, "result", capture, 0, cdecl),
         Operation(capture, "fp.capture", cplace, chome, cpos, cdisplay, cloc),
         Operand(capture, 0, x), Value(x, ty, kind, owner, slot, xdecl),
         Value(result, ty, "result", node, 0, declared),
         !EqSatHasAttr(node, "semantics"))
        -> (EqSatReplace(node, result, x), EqSatErase(node));
}

// Computation type identity includes format, rounding and contraction.
pub let EqSatFpBinary: String -> Prop;
pub let EqSatFpUnary: String -> Prop;
pub let EqSatFpKey: (Int, String, Int, Int, Int, Int) -> Prop;
pub mod fp_keys {
    pub let capture: EqSatFpUnary("fp.capture");
    pub let materialize: EqSatFpUnary("fp.materialize");
    pub let add: EqSatFpBinary("fp.add");
    pub let sub: EqSatFpBinary("fp.sub");
    pub let mul: EqSatFpBinary("fp.mul");
    pub let div: EqSatFpBinary("fp.div");
    pub let unary<node,k,place,home,p,d,l,x,result,ty,decl>:
        (EqSatLive(node), Operation(node,k,place,home,p,d,l), EqSatFpUnary(k),
         Operand(node,0,x), Value(result,ty,"result",node,0,decl), !EqSatHasAttr(node,"semantics"),
         !EqSatOperandSlot(node,1), !EqSatExtraResult(node))
        -> EqSatFpKey(node,k,result,ty,x,0);
    pub let binary<node,k,place,home,p,d,l,x,y,result,ty,decl>:
        (EqSatLive(node), Operation(node,k,place,home,p,d,l), EqSatFpBinary(k),
         Operand(node,0,x), Operand(node,1,y), Value(result,ty,"result",node,0,decl),
         !EqSatHasAttr(node,"semantics"), !EqSatOperandSlot(node,2), !EqSatExtraResult(node))
        -> EqSatFpKey(node,k,result,ty,x,y);
}
pub mod fp_congruence {
    pub let ordered<a,b,k,x,y,ty,lhs,rhs,block,p,q,ad,bd,al,bl>:
        (EqSatFpKey(a,k,x,ty,lhs,rhs), EqSatFpKey(b,k,y,ty,lhs,rhs),
         Operation(a,k,"block",block,p,ad,al), Operation(b,k,"block",block,q,bd,bl),
         less_id(p,q) == true)
        -> (EqSatReplace(b,y,x), EqSatErase(b));
    pub let graph<a,b,k,x,y,ty,lhs,rhs,region,p,q,ad,bd,al,bl>:
        (EqSatFpKey(a,k,x,ty,lhs,rhs), EqSatFpKey(b,k,y,ty,lhs,rhs),
         Operation(a,k,"graph",region,p,ad,al), Operation(b,k,"graph",region,q,bd,bl),
         less_id(a,b) == true)
        -> (EqSatReplace(b,y,x), EqSatErase(b));
}
