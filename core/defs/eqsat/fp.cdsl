// Floating-point congruence CSE — op arities derived directly from `dialects::fp::all_ops`.
// (Capture/materialize round-trip lives in `rewrites.cdsl` as a 1-line `Rewrite`.)

use std::core::*;
use std::int::*;
use std::ir::fp_op_rules;
use dialects::fp;

pub let fp_keys: List<Rule> = {
    let unary<node, k, x, result, ty, decl, pl, hm, pos, dp, lc>: Rule(
        (
            EqSatLive(node),
            EqSatFpUnary(k),
            Operation(node, k, pl, hm, pos, dp, lc),
            Operand(node, 0, x),
            Value(result, ty, "result", node, 0, decl),
            !EqSatHasAttr(node, "semantics"),
            !EqSatOperandSlot(node, 1),
            !EqSatExtraResult(node),
        ) -> EqSatFpKey(node, k, result, ty, x, x)
    );
    let binary<node, k, x, y, result, ty, decl, pl, hm, pos, dp, lc>: Rule(
        (
            EqSatLive(node),
            EqSatFpBinary(k),
            Operation(node, k, pl, hm, pos, dp, lc),
            Operand(node, 0, x),
            Operand(node, 1, y),
            Value(result, ty, "result", node, 0, decl),
            !EqSatHasAttr(node, "semantics"),
            !EqSatOperandSlot(node, 2),
            !EqSatExtraResult(node),
        ) -> EqSatFpKey(node, k, result, ty, x, y)
    );
    append(fp_op_rules(fp::all_ops), List(unary, binary))
};

pub let fp_congruence: List<Rule> = {
    let ordered<a, b, k, x, y, ty, lhs, rhs, block, p, q, ad, bd, al, bl>: Rule(
        (
            EqSatFpKey(a, k, x, ty, lhs, rhs),
            EqSatFpKey(b, k, y, ty, lhs, rhs),
            Operation(a, k, "block", block, p, ad, al),
            Operation(b, k, "block", block, q, bd, bl),
            less(p, q) == true,
        ) -> (EqSatReplace(b, y, x), EqSatErase(b))
    );
    let graph<a, b, k, x, y, ty, lhs, rhs, region, p, q, ad, bd, al, bl>: Rule(
        (
            EqSatFpKey(a, k, x, ty, lhs, rhs),
            EqSatFpKey(b, k, y, ty, lhs, rhs),
            Operation(a, k, "graph", region, p, ad, al),
            Operation(b, k, "graph", region, q, bd, bl),
            less(a, b) == true,
        ) -> (EqSatReplace(b, y, x), EqSatErase(b))
    );
    List(ordered, graph)
};

extract rust fp_keys       => "@ct";
extract rust fp_congruence => "@ct";
