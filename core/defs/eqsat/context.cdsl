// Migrated faithfully from `core/defs/eqsat/context.cdsl` to pure CDSL v3 `Rule(...)` syntax.

use std::core::*;
use std::bigint::*;
use std::int::*;
use std::ir::dialect_drop_rules;
use dialects::builtin;

pub let select: List<Rule> = {
    let root<node>: Rule(EqSatRoot(node) -> EqSatLive(node));
    let within<root, region, mode, slot, entry, node, representative>: Rule((EqSatRoot(root), Region(region, mode, root, slot, entry), ReaderAt(node, region, representative)) -> EqSatLive(node));
    List(root, within)
};

pub let paths: List<Rule> = {
    let direct<owner, old, new>: Rule((EqSatReplace(owner, old, new), !EqSatPinned(old)) -> EqSatPath(old, new));
    let through<old, next, new>: Rule((EqSatPath(old, next), EqSatPath(next, new)) -> EqSatPath(old, new));
    List(direct, through)
};

pub let used: List<Rule> = {
    let from<old, new>: Rule(EqSatPath(old, new) -> outgoing(old));
    List(from)
};

pub let edits: List<Rule> = {
    let terminal<old, new>: Rule((EqSatPath(old, new), !outgoing(new)) -> EqSatRedirect(old, new));
    let operand<user, slot, old, new>: Rule((EqSatRedirect(old, new), Operand(user, slot, old)) -> EqSatAliasEdit(UseOwner::Operand(user), slot, old, new));
    let yield_value<region, slot, old, new>: Rule((EqSatRedirect(old, new), Yield(region, slot, old)) -> EqSatAliasEdit(UseOwner::Yield(region), slot, old, new));
    List(terminal, operand, yield_value)
};

pub let attributes: List<Rule> = {
    let present<node, name, attr>: Rule((EqSatLive(node), Attribute("operation", node, name, attr)) -> EqSatHasAttr(node, name));
    List(present)
};

pub let incoming: List<Rule> = {
    let untaken<node, home, pos, display, loc, pred, edge, target, bit, known>: Rule((EqSatLive(node), Operation(node, dialects::cfg::cond_br.kind, "block", home, pos, display, loc),
         Operand(node,0,pred), Successor(node,edge,target), EqSatEdgeTruth(edge,bit),
         EqSatFolded(pred,known), known != bigint_of(bit)) -> EqSatUntaken(node,edge));
    let sources<a, x, b, y, target>: Rule((Successor(a, x, target), Successor(b, y, target), a != b) -> EqSatMultipleEdges(target));
    let slots<a, x, y, target>: Rule((Successor(a, x, target), Successor(a, y, target), x != y) -> EqSatMultipleEdges(target));
    let entry<region, mode, node, slot, block>: Rule(Region(region, mode, node, slot, block) -> EqSatEntryBlock(block));
    let literal<value, bits>: Rule(EqSatFolded(value, bits) -> EqSatDefinedLiteral(value));
    let true_edge: Rule(() -> EqSatEdgeTruth(0, 1));
    let false_edge: Rule(() -> EqSatEdgeTruth(1, 0));
    List(untaken, sources, slots, entry, literal, true_edge, false_edge)
};

pub let assumptions: List<Rule> = {
    let cfg<node, block, pos, display, loc, selector, edge, target, bit>: Rule((EqSatLive(node), Operation(node, dialects::cfg::cond_br.kind, "block", block, pos, display, loc),
         Operand(node, 0, selector), Successor(node, edge, target), EqSatEdgeTruth(edge, bit),
         !EqSatMultipleEdges(target), !EqSatEntryBlock(target), block != target) -> EqSatAssumption(target, selector, bit));
    let explicit_arm<node, selector_slot, body, pred, polarity, selector, bits, region, bit>: Rule((EqSatLive(node), Control(node, true, selector_slot, false, body, pred, polarity),
         Operand(node, selector_slot, selector), Arm(node, false, bits, region),
         EqSatCaseBit(bits, bit)) -> EqSatAssumption(region, selector, bit));
    let literal_false: Rule(() -> EqSatCaseBit("0", 0));
    let literal_true: Rule(() -> EqSatCaseBit("1", 1));
    let boolean_default<node, selector_slot, body, pred, polarity, selector, case_region, region, ty, term>: Rule((EqSatLive(node), Control(node, true, selector_slot, false, body, pred, polarity),
         Operand(node, selector_slot, selector), EqSatScalar(selector, ty, term),
         EqSatAllBits(ty, bigint(1)), Arm(node, false, "0", case_region),
         Arm(node, true, "", region)) -> EqSatAssumption(region, selector, 1));
    let forwarded<node, region, index, port, selector, bit>: Rule((EqSatAssumption(region, selector, bit), EqSatPort(node, region, index, port, selector)) -> EqSatAssumption(region, port, bit));
    let low_bit<scope, selector, bit, ty, trunc, declared, masked, mt, result, x, y, home, mask, pl, hm, pos, dp, lc>: Rule((EqSatAssumption(scope, selector, bit),
         Operation(trunc, builtin::trunci.kind, pl, hm, pos, dp, lc), Operand(trunc, 0, masked),
         Value(selector, ty, "result", trunc, 0, declared),
         EqSatAllBits(ty, bigint(1)),
         EqSatBinary(result, builtin::andi.kind, masked, mt, x, y, home),
         EqSatScalar(y, mt, mask), mask == Scalar::Literal(mt, bigint(1))) -> EqSatAssumption(scope, masked, bit));
    let unconditional<scope, value, bit, node, p, d, l, target>: Rule((EqSatAssumption(scope,value,bit), EqSatLive(node), Operation(node, dialects::cfg::br.kind, "block", scope, p, d, l),
         Successor(node,0,target), !EqSatMultipleEdges(target), !EqSatEntryBlock(target)) -> EqSatAssumption(target,value,bit));
    let graph_child<scope, value, bit, node, k, p, d, l, region, mode, slot, entry>: Rule((EqSatAssumption(scope,value,bit), EqSatLive(node), Operation(node, k, "graph", scope, p, d, l),
         Region(region,mode,node,slot,entry)) -> EqSatAssumption(region,value,bit));
    let predicate_complement<scope, value, bit, other, flipped, ty, term, comparison, k, opposite, a, b>: Rule((EqSatAssumption(scope,value,bit), EqSatScalar(value,ty,term), EqSatScalar(other,ty,comparison),
         term == Scalar::Compare(k,ty,a,b), comparison == Scalar::Compare(opposite,ty,a,b),
         EqSatPredicateComplement(k,opposite), EqSatEdgeTruth(bit,flipped)) -> EqSatAssumption(scope,other,flipped));
    let equal_difference<scope, selector, result, owner, k, ty, bit_ty, term, x, y, lhs, rhs, home, predicate, bit>: Rule((EqSatAssumption(scope,selector,bit), EqSatScalar(selector,bit_ty,term),
         term == Scalar::Compare(predicate,bit_ty,lhs,rhs), EqSatEqualityCondition(predicate,bit),
         EqSatBinary(owner,k,result,ty,x,y,home), EqSatEqualDifference(k),
         EqSatScalar(x,ty,lhs), EqSatScalar(y,ty,rhs)) -> EqSatAssumption(scope,result,0));
    let equality_literal<scope, selector, known, ty, bit_ty, term, input, predicate, bit, left, right>: Rule((EqSatAssumption(scope,selector,bit), EqSatScalar(selector,bit_ty,term),
         EqSatEqualityCondition(predicate,bit), term == Scalar::Compare(predicate,bit_ty,left,right),
         EqSatScalar(input,ty,left), right == Scalar::Literal(ty,known), !EqSatDefinedLiteral(input)) -> EqSatColorSeed(scope,left,Scalar::Literal(ty,known)));
    let eq_true: Rule(() -> EqSatEqualityCondition("eq",1));
    let ne_false: Rule(() -> EqSatEqualityCondition("ne",0));
    let subtract: Rule(() -> EqSatEqualDifference(dialects::builtin::subi.kind));
    let exclusive_or: Rule(() -> EqSatEqualDifference(dialects::builtin::xori.kind));
    let eq_ne: Rule(() -> EqSatPredicateComplement("eq","ne"));
    let slt_sge: Rule(() -> EqSatPredicateComplement("slt","sge"));
    let sgt_sle: Rule(() -> EqSatPredicateComplement("sgt","sle"));
    let ult_uge: Rule(() -> EqSatPredicateComplement("ult","uge"));
    let ugt_ule: Rule(() -> EqSatPredicateComplement("ugt","ule"));
    let inverse<a, b>: Rule(EqSatPredicateComplement(a,b) -> EqSatPredicateComplement(b,a));
    let seed<scope, value, bit, ty, term>: Rule((EqSatAssumption(scope, value, bit), EqSatScalar(value, ty, term),
         !EqSatDefinedLiteral(value)) -> EqSatColorSeed(scope, term, Scalar::Literal(ty, bigint_of(bit))));
    List(cfg, explicit_arm, literal_false, literal_true, boolean_default, forwarded, low_bit, unconditional, graph_child, predicate_complement, equal_difference, equality_literal, eq_true, ne_false, subtract, exclusive_or, eq_ne, slt_sge, sgt_sle, ult_uge, ugt_ule, inverse, seed)
};

pub let branch_local: List<Rule> = {
    let rewrite<scope, user, kind, place, pos, display, location, slot, value, ty, term, bits>: Rule((EqSatColorSite(scope), EqSatColorSubject(term), EqSatLive(user),
         Operation(user, kind, place, scope, pos, display, location), Operand(user, slot, value),
         EqSatScalar(value, ty, term), !EqSatDefinedLiteral(value), !EqSatPinned(value), term == Scalar::Literal(ty, bits)) -> EqSatScopedEdit(UseOwner::Operand(user), slot, value, bits));
    let yield_value<scope, slot, value, ty, term, bits>: Rule((EqSatColorSite(scope), EqSatColorSubject(term), Yield(scope, slot, value),
         EqSatScalar(value, ty, term), !EqSatDefinedLiteral(value), !EqSatPinned(value), term == Scalar::Literal(ty, bits)) -> EqSatScopedEdit(UseOwner::Yield(scope), slot, value, bits));
    List(rewrite, yield_value)
};

pub let removable: List<Rule> = {
    let frozen_argument<node, result>: Rule((EqSatArgumentFreeze(node,result), !EqSatPinnedOp(node), !EqSatPinned(result)) -> (EqSatRemovable(node,result), EqSatRemovableNode(node)));
    let candidate<node, k, place, home, pos, display, loc, result, ty, decl>: Rule((EqSatLive(node), Operation(node, k, place, home, pos, display, loc), EqSatDropKind(k),
         Value(result, ty, "result", node, 0, decl), !EqSatPinnedOp(node), !EqSatPinned(result)) -> (EqSatRemovable(node,result), EqSatRemovableNode(node)));
    append(dialect_drop_rules(builtin::all_ops), List(frozen_argument, candidate))
};

pub let demand: List<Rule> = {
    let root<user, slot, value>: Rule((Operand(user,slot,value), !EqSatRemovableNode(user), !EqSatDead(user)) -> EqSatDemand(value));
    let yielded<region, slot, value>: Rule(Yield(region,slot,value) -> EqSatDemand(value));
    let input<node, result, slot, value>: Rule((EqSatRemovable(node,result), EqSatDemand(result), Operand(node,slot,value)) -> EqSatDemand(value));
    List(root, yielded, input)
};

pub let dead: List<Rule> = {
    let unused<node, result>: Rule((EqSatRemovable(node,result), !EqSatDemand(result)) -> EqSatDead(node));
    List(unused)
};

pub let phi_candidates: List<Rule> = {
    let edge<node, edge, block, param, slot, value, bits>: Rule((EqSatLive(node), Successor(node,edge,block), SuccessorArgument(node,edge,param,slot),
         Operand(node,slot,value), EqSatFolded(value,bits), !EqSatEntryBlock(block), !EqSatUntaken(node,edge)) -> EqSatEdgeBits(node,edge,block,param,bits));
    List(edge)
};

pub let phi_disagreement: List<Rule> = {
    let missing<block, param, bits, witness, incoming, node, edge>: Rule((EqSatEdgeBits(witness,incoming,block,param,bits), Successor(node,edge,block),
         !EqSatEdgeBits(node,edge,block,param,bits), !EqSatUntaken(node,edge)) -> EqSatPhiDisagrees(block,param,bits));
    List(missing)
};

pub let phi_literals: List<Rule> = {
    let agreed<block, param, bits, witness, incoming, value, ty, decl>: Rule((EqSatEdgeBits(witness,incoming,block,param,bits), !EqSatPhiDisagrees(block,param,bits),
         Value(value,ty,"block",block,param,decl), EqSatInteger(ty), !EqSatPinned(value)) -> (EqSatPhiLiteral(value,bits), EqSatFolded(value,bits)));
    List(agreed)
};

pub let phi_uses: List<Rule> = {
    let yielded<region, slot, value, bits, node, mode, region_slot, entry>: Rule((EqSatPhiLiteral(value,bits), Yield(region,slot,value), Region(region,mode,node,region_slot,entry),
         EqSatLive(node)) -> EqSatScopedEdit(UseOwner::Yield(region),slot,value,bits));
    let operand<user, slot, value, bits>: Rule((EqSatPhiLiteral(value,bits), EqSatLive(user), Operand(user,slot,value)) -> EqSatScopedEdit(UseOwner::Operand(user),slot,value,bits));
    List(yielded, operand)
};

extract rust select => "@ct";
extract rust paths => "@ct";
extract rust used => "@ct";
extract rust edits => "@ct";
extract rust attributes => "@ct";
extract rust incoming => "@ct";
extract rust assumptions => "@ct";
extract rust branch_local => "@ct";
extract rust removable => "@ct";
extract rust demand => "@ct";
extract rust dead => "@ct";
extract rust phi_candidates => "@ct";
extract rust phi_disagreement => "@ct";
extract rust phi_literals => "@ct";
extract rust phi_uses => "@ct";
