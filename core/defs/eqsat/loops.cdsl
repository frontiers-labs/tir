// Migrated faithfully from `core/defs/eqsat/loops.cdsl` to pure CDSL v3 `Rule(...)` syntax.

use std::core::*;
use std::bigint::*;
use std::int::*;

pub let ports: List<Rule> = {
    let entry<node, region, mode, slot, entry, port_slot, operand_slot, init, port, ty, declared>: Rule((EqSatLive(node), Region(region, mode, node, slot, entry),
         Binding(region, "entry", port_slot, operand_slot), Operand(node, operand_slot, init),
         Value(port, ty, "region", region, port_slot, declared)) -> EqSatPort(node, region, port_slot, port, init));
    List(entry)
};

pub let loop_facts: List<Rule> = {
    let carried<node, selector, body, pred, polarity, slot, port, init, feedback>: Rule((Control(node,false,selector,true,body,pred,polarity), EqSatPort(node,body,slot,port,init),
         Binding(body,"feedback",slot,feedback), Yield(body,feedback,port)) -> EqSatInvariantPort(node,body,slot,port,init));
    let equal_literals<node, selector, body, pred, polarity, slot, port, init, feedback, next, bits>: Rule((Control(node,false,selector,true,body,pred,polarity), EqSatPort(node,body,slot,port,init),
         Binding(body,"feedback",slot,feedback), Yield(body,feedback,next),
         EqSatFolded(init,bits), EqSatFolded(next,bits)) -> EqSatInvariantPort(node,body,slot,port,init));
    let invariant<node, body, port_slot, port, init, exit, result_slot, result, ty, declared, kind, owner, init_slot, init_declared, loop_kind, home, pos, display, loc>: Rule((EqSatInvariantPort(node,body,port_slot,port,init), Operation(node, loop_kind, "block", home, pos, display, loc),
         Binding(body, "exit", result_slot, exit), Yield(body, exit, port),
         Value(result, ty, "result", node, result_slot, declared),
         Value(init, ty, kind, owner, init_slot, init_declared)) -> EqSatReplace(node, result, init));
    List(carried, equal_literals, invariant)
};

pub let gamma_witness: List<Rule> = {
    let forwarded<node, selector, body, pred, polarity, region, port_slot, port, init, result_slot, exit>: Rule((Control(node, true, selector, false, body, pred, polarity),
         EqSatPort(node, region, port_slot, port, init),
         Binding(region, "exit", result_slot, exit), Yield(region, exit, port)) -> EqSatArmResult(node,region,result_slot,init,true));
    let yielded<node, selector, body, pred, polarity, arm, mode, arm_slot, entry, result_slot, exit, state>: Rule((EqSatLive(node), Control(node,true,selector,false,body,pred,polarity),
         Region(arm,mode,node,arm_slot,entry), Binding(arm,"exit",result_slot,exit), Yield(arm,exit,state)) -> EqSatArmResult(node,arm,result_slot,state,false));
    List(forwarded, yielded)
};

pub let gamma_missing: List<Rule> = {
    let missing<node, result_slot, init, witness, region, mode, slot, entry>: Rule((EqSatArmResult(node, witness, result_slot, init, true), Region(region, mode, node, slot, entry),
         !EqSatArmResult(node, region, result_slot, init, true)) -> EqSatArmDisagrees(node, result_slot, init));
    List(missing)
};

pub let gamma_agrees: List<Rule> = {
    let agreement<node, result_slot, init, witness, result, ty, declared, kind, owner, slot, init_declared, switch_kind, home, pos, display, loc>: Rule((EqSatArmResult(node, witness, result_slot, init, true), !EqSatArmDisagrees(node, result_slot, init),
         Operation(node, switch_kind, "block", home, pos, display, loc),
         Value(result, ty, "result", node, result_slot, declared),
         Value(init, ty, kind, owner, slot, init_declared)) -> EqSatReplace(node, result, init));
    List(agreement)
};

pub let counted_exits: List<Rule> = {
    let binding<node, home, position, display, location, region, entry, j, i, port, init, result, ty, pdecl, rdecl, kind, owner, input_slot, idecl>: Rule((EqSatLive(node), Operation(node, dialects::scf::ordered_for.kind, "block", home, position, display, location),
         Region(region, "cfg", node, 0, entry), Value(port, ty, "block", entry, i, pdecl),
         less(int_lit(0),i) == true, j == (i - 1), Operand(node, i, init),
         Value(init, ty, kind, owner, input_slot, idecl), Value(result, ty, "result", node, i, rdecl)) -> EqSatCountedPort(node, region, j, port, result, init));
    let sites<region, block, order, exit, pos, display, loc>: Rule((Block(block, region, order), Operation(exit, dialects::scf::r#yield.kind, "block", block, pos, display, loc)) -> EqSatCountedYield(region, exit));
    let same<node, region, j, port, result, init, exit>: Rule((EqSatCountedPort(node, region, j, port, result, init),
         EqSatCountedYield(region, exit), Operand(exit, j, port)) -> EqSatCountedSame(result, exit));
    let equal<node, region, j, port, result, init, exit, output>: Rule((EqSatCountedPort(node, region, j, port, result, init),
         EqSatCountedYield(region, exit), Operand(exit, j, output), EqSatPath(output, port)) -> EqSatCountedSame(result, exit));
    let same_literal<node, region, j, port, result, init, exit, output, bits>: Rule((EqSatCountedPort(node,region,j,port,result,init), EqSatCountedYield(region,exit),
         Operand(exit,j,output), EqSatFolded(init,bits), EqSatFolded(output,bits)) -> EqSatCountedSame(result,exit));
    List(binding, sites, same, equal, same_literal)
};

pub let counted_missing: List<Rule> = {
    let refuted<node, region, slot, port, result, init, exit>: Rule((EqSatCountedPort(node, region, slot, port, result, init), EqSatCountedYield(region, exit),
         !EqSatCountedSame(result, exit)) -> EqSatCountedDiffer(result));
    List(refuted)
};

pub let counted_agrees: List<Rule> = {
    let invariant<node, region, slot, port, result, init, exit>: Rule((EqSatCountedPort(node, region, slot, port, result, init), EqSatCountedSame(result, exit),
         !EqSatCountedDiffer(result)) -> EqSatReplace(node, result, init));
    let literal<node, region, slot, port, result, init, exit, bits>: Rule((EqSatCountedPort(node,region,slot,port,result,init), EqSatCountedSame(result,exit),
         !EqSatCountedDiffer(result), EqSatFolded(init,bits)) -> EqSatKnownCountedPort(region,port,bits));
    List(invariant, literal)
};

pub let counted_reads: List<Rule> = {
    let folded<user, region, member, port, bits, slot, k, place, home, p, d, l>: Rule((EqSatKnownCountedPort(region,port,bits), ReaderAt(user,region,member), Operand(user,slot,port),
         Operation(user, k, place, home, p, d, l), EqSatDropKind(k), !EqSatPinnedOp(user)) -> EqSatScopedEdit(UseOwner::Operand(user),slot,port,bits));
    List(folded)
};

pub let invariant_ports: List<Rule> = {
    let induction<node, body, port_slot, port, init, ty, decl>: Rule((EqSatInvariantPort(node,body,port_slot,port,init),
         Value(port, ty, "region", body, port_slot, decl), EqSatInteger(ty)) -> EqSatReplace(node, port, init));
    let known<node, body, slot, port, init, bits>: Rule((EqSatInvariantPort(node,body,slot,port,init), EqSatFolded(init,bits)) -> EqSatFolded(port,bits));
    List(induction, known)
};

pub let counted_pins: List<Rule> = {
    let body<node, place, home, pos, display, loc, select, body, pred, polarity>: Rule((Operation(node, dialects::scf::r#for.kind, place, home, pos, display, loc),
         Control(node, false, select, true, body, pred, polarity)) -> (EqSatCounted(node, body), EqSatPinnedYield(body, pred)));
    let advance<node, region, slot>: Rule((EqSatCounted(node,region), Binding(region,"feedback",0,slot)) -> EqSatPinnedYield(region,slot));
    let exit<node, region, index, slot>: Rule((EqSatCounted(node,region), Binding(region,"exit",index,slot)) -> EqSatPinnedYield(region,slot));
    let value<region, slot, value>: Rule((EqSatPinnedYield(region,slot), Yield(region,slot,value)) -> EqSatPinned(value));
    let computation<region, slot, value, ty, node, index, decl>: Rule((EqSatPinnedYield(region,slot), Yield(region,slot,value),
         Value(value, ty, "result", node, index, decl)) -> EqSatPinnedOp(node));
    let operand<node, slot, value>: Rule((EqSatPinnedOp(node), Operand(node,slot,value)) -> EqSatPinned(value));
    List(body, advance, exit, value, computation, operand)
};

pub let safe_control_inputs: List<Rule> = {
    let switch: Rule(() -> EqSatCheckControl(dialects::scf::r#switch.kind));
    let loop_kind: Rule(() -> EqSatCheckControl(dialects::scf::r#loop.kind));
    let defined<value>: Rule(EqSatDefined(value) -> EqSatControlInputSafe(value));
    let parameter<value, ty, kind, owner, slot, decl>: Rule((EqSatIncomingParameter(value), Value(value,ty,kind,owner,slot,decl), EqSatInteger(ty)) -> EqSatControlInputSafe(value));
    List(switch, loop_kind, defined, parameter)
};

pub let control_effects: List<Rule> = {
    let input<node, k, place, home, p, d, l, slot, value>: Rule((EqSatCheckControl(k), Operation(node, k, place, home, p, d, l), Operand(node,slot,value), !EqSatControlInputSafe(value)) -> EqSatUnprovedControl(node));
    let effect<node, region, mode, slot, entry, child, member, kind, place, home, p, d, l>: Rule((Region(region,mode,node,slot,entry), ReaderAt(child,region,member),
         Operation(child, kind, place, home, p, d, l), !EqSatDropKind(kind)) -> EqSatUnprovedControl(node));
    List(input, effect)
};

pub let switch_inputs: List<Rule> = {
    let incoming<node, region, slot, port, init, selector, body, pred, polarity, bits>: Rule((Control(node,true,selector,false,body,pred,polarity), EqSatPort(node,region,slot,port,init),
         EqSatFolded(init,bits)) -> EqSatFolded(port,bits));
    List(incoming)
};

pub let switch_cases: List<Rule> = {
    let control<node, selector, body, pred, polarity, value, bits>: Rule((EqSatLive(node), Control(node,true,selector,false,body,pred,polarity),
         Operand(node,selector,value), EqSatFolded(value,bits)) -> EqSatKnownSelector(node,bits));
    let exact<node, bits, key, region>: Rule((EqSatKnownSelector(node,bits), key == to_string(bits), Arm(node,false,key,region)) -> (EqSatHasExplicitArm(node), EqSatSelectedArm(node,region)));
    List(control, exact)
};

pub let switch_default: List<Rule> = {
    let chosen<node, bits, region, key>: Rule((EqSatKnownSelector(node,bits), !EqSatHasExplicitArm(node), Arm(node,true,key,region)) -> EqSatSelectedArm(node,region));
    List(chosen)
};

pub let pure_switch: List<Rule> = {
    let safe<node, home, p, d, l, selector, body, pred, polarity, value, result, ty, decl>: Rule((EqSatLive(node), Operation(node, dialects::scf::r#switch.kind, "graph", home, p, d, l),
         Control(node,true,selector,false,body,pred,polarity), Operand(node,selector,value),
         EqSatDefined(value), !EqSatUnprovedControl(node), !EqSatExtraResult(node),
         Value(result, ty, "result", node, 0, decl), EqSatInteger(ty), !EqSatPinned(result)) -> (EqSatPureSwitch(node,result,ty), EqSatRemovable(node,result), EqSatRemovableNode(node)));
    List(safe)
};

pub let switch_values: List<Rule> = {
    let selected_literal<node, result, ty, arm, slot, value, bits>: Rule((EqSatPureSwitch(node,result,ty), EqSatSelectedArm(node,arm),
         Binding(arm,"exit",0,slot), Yield(arm,slot,value), EqSatFolded(value,bits)) -> EqSatPhiLiteral(result,bits));
    let capture<node, result, ty, arm, mode, arm_slot, entry, slot, value, kind, owner, i, decl>: Rule((EqSatPureSwitch(node,result,ty), Region(arm,mode,node,arm_slot,entry),
         Binding(arm,"exit",0,slot), Yield(arm,slot,value),
         EqSatVisibleAt(node,value), Value(value,ty,kind,owner,i,decl)) -> EqSatSwitchYield(node,result,arm,value));
    let forwarded<node, result, ty, arm, value, kind, owner, slot, decl>: Rule((EqSatPureSwitch(node,result,ty),
         EqSatArmResult(node,arm,0,value,true), Value(value,ty,kind,owner,slot,decl)) -> EqSatSwitchYield(node,result,arm,value));
    List(selected_literal, capture, forwarded)
};

pub let switch_agreement: List<Rule> = {
    let disagree<node, result, witness, value, arm, mode, slot, entry>: Rule((EqSatSwitchYield(node,result,witness,value), Region(arm,mode,node,slot,entry),
         !EqSatSwitchYield(node,result,arm,value)) -> EqSatSwitchDisagrees(node,value));
    List(disagree)
};

pub let switch_aliases: List<Rule> = {
    let selected<node, result, arm, value>: Rule((EqSatSwitchYield(node,result,arm,value), EqSatSelectedArm(node,arm)) -> EqSatReplace(node, result, value));
    let all_arms<node, result, arm, value>: Rule((EqSatSwitchYield(node,result,arm,value), !EqSatSwitchDisagrees(node,value)) -> EqSatReplace(node, result, value));
    List(selected, all_arms)
};

pub let finite_loops: List<Rule> = {
    // A nonnegative counter reaches its signed limit before a unit increment can wrap.
    let finite<node, home, pos, display, loc, selector, body, predicate, condition, ct, cmp, slot, counter, init, feedback, next, step, add, ty, term, bound_term, bound, start, mask>: Rule((EqSatLive(node), Operation(node, dialects::scf::r#loop.kind, "graph", home, pos, display, loc), !EqSatUnprovedControl(node),
         Control(node,false,selector,true,body,predicate,"true"), Yield(body,predicate,condition),
         EqSatPort(node,body,slot,counter,init), Binding(body,"feedback",slot,feedback), Yield(body,feedback,next),
         EqSatBinary(add,dialects::builtin::addi.kind,next,ty,counter,step,body), EqSatWrappingAdd(add),
         EqSatFolded(step,bigint(1)), EqSatScalar(counter,ty,term), EqSatScalar(condition,ct,cmp),
         cmp == Scalar::Compare("slt",ct,term,bound_term), bound_term == Scalar::Literal(ty,bound),
         EqSatFolded(init,start), EqSatAllBits(ty,mask),
         big_le(big_add(start, start),mask) == true, big_le(big_add(bound, bound),mask) == true) -> EqSatFiniteLoop(node,body));
    let output<node, body, exits, slot, value, result, ty, decl, bits>: Rule((EqSatFiniteLoop(node,body), Binding(body,"exit",slot,exits), Yield(body,exits,value),
         EqSatFolded(value,bits), Value(result, ty, "result", node, slot, decl), EqSatInteger(ty), !EqSatPinned(result)) -> EqSatPhiLiteral(result,bits));
    List(finite, output)
};

