extract rust counted_reads => "@ct";
extract rust invariant_ports => "@ct";
extract rust counted_pins => "@ct";
extract rust safe_control_inputs => "@ct";
extract rust control_effects => "@ct";
extract rust switch_inputs => "@ct";
extract rust switch_cases => "@ct";
extract rust switch_default => "@ct";
extract rust pure_switch => "@ct";
extract rust switch_values => "@ct";
extract rust switch_agreement => "@ct";
extract rust switch_aliases => "@ct";
extract rust finite_loops => "@ct";
