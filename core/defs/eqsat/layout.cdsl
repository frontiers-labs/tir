use std::bigint::BigInt;

pub let EqSatLayoutKind: String -> Prop;
pub let EqSatLayoutQuery: (Int, String) -> Prop;
pub let EqSatLayoutValue: (Int, BigInt) -> Prop;

pub mod layout_queries {
    pub let size: EqSatLayoutKind("layout.sizeof");
    pub let alignment: EqSatLayoutKind("layout.alignof");
    pub let offset: EqSatLayoutKind("layout.offsetof");
    pub let pointer: EqSatLayoutKind("ptr.ptradd");
    pub let write: EqSatLayoutKind("ptr.store");
    pub let read: EqSatLayoutKind("ptr.load");
    pub let query<node, kind, place, home, pos, display, loc>:
        (EqSatLive(node), EqSatLayoutKind(kind), Operation(node, kind, place, home, pos, display, loc))
        -> EqSatLayoutQuery(node, kind);
}

pub mod layout_values {
    pub let fold<node, value, result, ty, declared, mask, bits>:
        (EqSatLayoutValue(node, value), Value(result, ty, "result", node, 0, declared),
         EqSatAllBits(ty, mask), bits == eqsat_bit_and(value, mask))
        -> (EqSatFolded(result, bits), EqSatConstant(node, result, bits));
}

pub let EqSatLayoutScoped: Int -> Prop;
pub mod layout_pointer {
    pub let identity<node, place, home, pos, display, loc, ptr, offset, result, ty, pk, po, ps, pd, rd>:
        (EqSatLive(node), Operation(node, "ptr.ptradd", place, home, pos, display, loc),
         EqSatLayoutScoped(node), Operand(node, 0, ptr), Operand(node, 1, offset),
         EqSatFolded(offset, eqsat_bigint(0)),
         Value(ptr, ty, pk, po, ps, pd), Value(result, ty, "result", node, 0, rd))
        -> (EqSatReplace(node, result, ptr), EqSatErase(node));
}

pub let EqSatOffsetStep: (Int, Int, Int, Int, Int, BigInt, BigInt) -> Prop;
pub let EqSatAddress: (Int, Int, Int, Int, Int, BigInt) -> Prop;
pub let EqSatAddressEquals: (Int, Int) -> Prop;
pub let EqSatLocalAddress: (Int, Int, BigInt) -> Prop;
pub mod address_keys {
    pub let step<node,place,home,p,d,l,base,disp,address,ty,decl,index,kind,owner,slot,id,
                 width,offset,mask>:
        (EqSatLive(node), Operation(node,"ptr.ptradd",place,home,p,d,l),
         EqSatLayoutScoped(node), EqSatPointerSize(node,width),
         Operand(node,0,base), Operand(node,1,disp), Value(address,ty,"result",node,0,decl),
         Value(disp,index,kind,owner,slot,id), EqSatFolded(disp,offset), EqSatAllBits(index,mask),
         eqsat_leq_bits(eqsat_sum(offset,offset),mask) == true,
         !EqSatHasAttr(node,"inbounds"), !EqSatHasAttr(node,"nuw"), !EqSatHasAttr(node,"nsw"))
        -> EqSatOffsetStep(address,base,ty,index,width,offset,mask);
    pub let direct<address,base,ty,index,width,offset,mask>:
        EqSatOffsetStep(address,base,ty,index,width,offset,mask)
        -> EqSatAddress(address,base,ty,index,width,offset);
    pub let add<address,parent,base,ty,index,width,offset,prior,total,mask>:
        (EqSatOffsetStep(address,parent,ty,index,width,offset,mask),
         EqSatAddress(parent,base,ty,index,width,prior), total == eqsat_sum(offset,prior),
         eqsat_leq_bits(eqsat_sum(total,total),mask) == true)
        -> EqSatAddress(address,base,ty,index,width,total);

    pub let twins<a,b,base,ty,index,width,offset>:
        (EqSatAddress(a,base,ty,index,width,offset), EqSatAddress(b,base,ty,index,width,offset))
        -> EqSatAddressEquals(a,b);
    pub let same_cell<a,b,state,ty,data,producer>:
        (EqSatAddressEquals(a,b), EqSatStored(state,a,ty,data,producer))
        -> EqSatStored(state,b,ty,data,producer);
    pub let root<base>: EqSatAllocation(base) -> EqSatLocalAddress(base,base,eqsat_bigint(0));
    pub let local<address,base,ty,index,width,offset>:
        (EqSatAddress(address,base,ty,index,width,offset), EqSatAllocation(base))
        -> EqSatLocalAddress(address,base,offset);
}
