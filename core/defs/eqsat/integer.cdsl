use std::bigint::BigInt;

pub let EqSatIdentity: (Int, Int, Int) -> Prop;
pub let EqSatZeroRhs: String -> Prop;
pub let EqSatIdempotent: String -> Prop;

pub mod integer {
    pub let add: EqSatZeroRhs("builtin.addi");
    pub let or: EqSatZeroRhs("builtin.ori");
    pub let xor: EqSatZeroRhs("builtin.xori");
    pub let sub: EqSatZeroRhs("builtin.subi");
    pub let shl: EqSatZeroRhs("builtin.shli");
    pub let lshr: EqSatZeroRhs("builtin.shrui");
    pub let ashr: EqSatZeroRhs("builtin.shrsi");
    pub let and_dup: EqSatIdempotent("builtin.andi");
    pub let or_dup: EqSatIdempotent("builtin.ori");

    pub let right_zero<owner, kind, out, ty, x, y, home, b>:
        (EqSatBinary(owner, kind, out, ty, x, y, home), EqSatZeroRhs(kind),
         EqSatScalar(y, ty, b), b == Scalar::Literal(ty, eqsat_bigint(0)))
        -> EqSatIdentity(owner, out, x);
    pub let idempotent<owner, kind, out, ty, x, y, home, t>:
        (EqSatBinary(owner, kind, out, ty, x, y, home), EqSatIdempotent(kind),
         EqSatScalar(x, ty, t), EqSatScalar(y, ty, t))
        -> EqSatIdentity(owner, out, x);
    pub let multiply_one<owner, out, ty, x, y, home, b>:
        (EqSatBinary(owner, "builtin.muli", out, ty, x, y, home),
         EqSatScalar(y, ty, b), b == Scalar::Literal(ty, eqsat_bigint(1)))
        -> EqSatIdentity(owner, out, x);
    pub let and_all<owner, out, ty, x, y, home, b, all>:
        (EqSatBinary(owner, "builtin.andi", out, ty, x, y, home),
         EqSatScalar(y, ty, b), EqSatAllBits(ty, all), b == Scalar::Literal(ty, all))
        -> EqSatIdentity(owner, out, x);
    pub let unsigned_divide_one<owner, out, ty, x, y, home, b>:
        (EqSatBinary(owner, "builtin.divui", out, ty, x, y, home),
         EqSatScalar(y, ty, b), b == Scalar::Literal(ty, eqsat_bigint(1)))
        -> EqSatIdentity(owner, out, x);
    pub let redundant_mask<owner, out, ty, input, mask, home, a, b, kept, zero, all>:
        (EqSatBinary(owner, "builtin.andi", out, ty, input, mask, home),
         EqSatScalar(input, ty, a), EqSatScalar(mask, ty, b), b == Scalar::Literal(ty, kept),
         EqSatZeros(a, ty, zero), EqSatAllBits(ty, all),
         eqsat_same_bits(eqsat_bit_or(kept, zero), all) == true)
        -> EqSatIdentity(owner, out, input);

    pub let congruent_cfg<a, b, ak, bk, block, ap, bp, ad, bd, al, bl, x, y, ty, term, xd, yd>:
        (Operation(a, ak, "block", block, ap, ad, al), Operation(b, bk, "block", block, bp, bd, bl),
         less_id(ap,bp) == true, EqSatBinaryKey(a), EqSatBinaryKey(b),
         Value(x, ty, "result", a, 0, xd), Value(y, ty, "result", b, 0, yd),
         EqSatScalar(x, ty, term), EqSatScalar(y, ty, term))
        -> EqSatIdentity(b, y, x);

    pub let congruent_graph<a, b, k, region, ap, bp, ad, bd, al, bl, x, y, ty, left, right>:
        (Operation(a, k, "graph", region, ap, ad, al), Operation(b, k, "graph", region, bp, bd, bl),
         less_id(a,b) == true, EqSatBinaryKey(a), EqSatBinaryKey(b),
         EqSatBinary(a, k, x, ty, left, right, region), EqSatBinary(b, k, y, ty, left, right, region))
        -> EqSatIdentity(b, y, x);

    pub let equal<owner, out, input, ty, a, b>:
        (EqSatIdentity(owner, out, input), EqSatScalar(out, ty, a), EqSatScalar(input, ty, b))
        -> a == b;
    pub let candidate<owner, out, input>:
        EqSatIdentity(owner, out, input) -> (EqSatReplace(owner, out, input), EqSatErase(owner));
}

pub let analyze = std::schedule::saturate((scalars, integer_inputs, commute, congruence, known_bits, shift_bits, integer, strength, casts, cast_cse, extraction, modular, integer_shapes, defined_integer, guarded_cancel, complements, memory, read_state, pointer_cells, memory_join, memory_siblings, switch_inputs, loops, invariant_ports, floating_point, fp_keys, fp_congruence, layout_values, layout_pointer, address_keys));

pub let EqSatPowerForm: (String, String) -> Prop;
pub let EqSatPower: (BigInt, BigInt) -> Prop;
pub enum Form {
    Read(Int),
    Bits(BigInt),
    Bin(String, Form, Form),
}
pub let EqSatRebuild: (Int, Int, Form) -> Prop;
pub mod forms {
    pub let EqSatRebuild: std::Table<(Int, Int), Form, std::Merge::Union>;
}
pub let EqSatWrappingAdd: Int -> Prop;
pub let EqSatWrappingSub: Int -> Prop;
pub let eqsat_bit_len: BigInt -> BigInt;
pub let eqsat_shift_amount: BigInt -> Int;
pub let eqsat_sum: (BigInt, BigInt) -> BigInt;

pub mod strength {
    pub let multiply: EqSatPowerForm("builtin.muli", "shli");
    pub let divide: EqSatPowerForm("builtin.divui", "shrui");

    pub let power<value, bits, log, width>:
        (EqSatFolded(value, bits), log == eqsat_sub(eqsat_bit_len(bits), eqsat_bigint(1)),
         width == eqsat_shift_amount(log), less_id(width, 0) == false,
         eqsat_same_bits(eqsat_shift(eqsat_bigint(1),width),bits) == true)
        -> EqSatPower(bits,log);

    pub let shift<node, kind, target, result, ty, x, y, home, value, power>:
        (EqSatBinary(node, kind, result, ty, x, y, home), EqSatPowerForm(kind,target),
         EqSatFolded(y, value), EqSatPower(value,power), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,result,Form::Bin(target,Form::Read(x),Form::Bits(power)));

    pub let remainder<node, result, ty, x, y, home, value, power>:
        (EqSatBinary(node, "builtin.remui", result, ty, x, y, home),
         EqSatFolded(y,value), EqSatPower(value,power), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,result,Form::Bin("andi",Form::Read(x),Form::Bits(eqsat_sub(value,eqsat_bigint(1)))));

    pub let wrapping_add<node, result, ty, x, y, home>:
        (EqSatBinary(node,"builtin.addi",result,ty,x,y,home),
         !EqSatHasAttr(node,"nsw"), !EqSatHasAttr(node,"nuw")) -> EqSatWrappingAdd(node);
    pub let wrapping_sub<node, result, ty, x, y, home>:
        (EqSatBinary(node,"builtin.subi",result,ty,x,y,home),
         !EqSatHasAttr(node,"nsw"), !EqSatHasAttr(node,"nuw")) -> EqSatWrappingSub(node);

    pub let reassociate<inner, outer, result, middle, ty, x, y, z, home, prior, a, b, mask>:
        (EqSatBinary(inner,"builtin.addi",middle,ty,x,y,prior), EqSatWrappingAdd(inner),
         EqSatBinary(outer,"builtin.addi",result,ty,middle,z,home), EqSatWrappingAdd(outer),
         EqSatFolded(y,a), EqSatFolded(z,b), EqSatAllBits(ty,mask), !EqSatPinnedOp(outer))
        -> EqSatRebuild(outer,result,Form::Bin("addi",Form::Read(x),Form::Bits(eqsat_bit_and(eqsat_sum(a,b),mask))));

    pub let cancel<inner, outer, result, middle, ty, x, y, z, home, prior, a>:
        (EqSatBinary(inner,"builtin.addi",middle,ty,x,y,prior), EqSatWrappingAdd(inner),
         EqSatBinary(outer,"builtin.subi",result,ty,middle,z,home), EqSatWrappingSub(outer),
         EqSatFolded(y,a), EqSatFolded(z,a))
        -> EqSatIdentity(outer,result,x);
}

pub mod casts {
    pub let extension_kind: EqSatExtends("builtin.extui");
    pub let sign_extension: EqSatExtends("builtin.extsi");
    pub let round_trip<outer, inner, out, ot, of, oh, op_, od, ol, middle, mt, md, kind, inf, inh,
                       inp, ind, inl, x, xt, xk, xo, xs, xd>:
        (EqSatLive(outer), Operation(outer,"builtin.trunci",of,oh,op_,od,ol),
         Operand(outer,0,middle), Value(middle,mt,"result",inner,0,md),
         Operation(inner,kind,inf,inh,inp,ind,inl), EqSatExtends(kind),
         Operand(inner,0,x), Value(x,xt,xk,xo,xs,xd), Value(out,xt,"result",outer,0,ot))
        -> EqSatIdentity(outer,out,x);
}
pub let EqSatExtends: String -> Prop;


pub let EqSatBitPair: (String, String) -> Prop;
pub mod extraction {
    pub let union_and: EqSatBitPair("builtin.ori","xori");
    pub let xor_and: EqSatBitPair("builtin.xori","ori");
    pub let bit_pair<node,out,ty,u,v,home,a,b,kind,target,ha,hb,x,y>:
        (EqSatBinary(node,"builtin.xori",out,ty,u,v,home), !EqSatPinnedOp(node),
         EqSatBinary(a,kind,u,ty,x,y,ha), EqSatBinary(b,"builtin.andi",v,ty,x,y,hb),
         EqSatBitPair(kind,target))
        -> EqSatRebuild(node,out,Form::Bin(target,Form::Read(x),Form::Read(y)));

    pub let offsets<node,out,ty,u,v,home,left,right,lh,rh,x,y,c,d,a,b,mask>:
        (EqSatBinary(node,"builtin.addi",out,ty,u,v,home), EqSatWrappingAdd(node), !EqSatPinnedOp(node),
         EqSatBinary(left,"builtin.addi",u,ty,x,c,lh), EqSatWrappingAdd(left),
         EqSatBinary(right,"builtin.addi",v,ty,y,d,rh), EqSatWrappingAdd(right),
         EqSatFolded(c,a), EqSatFolded(d,b), EqSatAllBits(ty,mask), less_id(y,x) == false)
        -> EqSatRebuild(node,out,Form::Bin("addi",Form::Bin("addi",Form::Read(x),Form::Read(y)),
                                                Form::Bits(eqsat_bit_and(eqsat_sum(a,b),mask))));
}

pub let eqsat_product: (BigInt, BigInt) -> BigInt;
pub mod modular {

    pub let subtract<inner,outer,result,middle,ty,x,y,z,home,prior,a,b,mask>:
        (EqSatBinary(inner,"builtin.addi",middle,ty,x,y,prior), EqSatWrappingAdd(inner),
         EqSatBinary(outer,"builtin.subi",result,ty,middle,z,home), EqSatWrappingSub(outer),
         EqSatFolded(y,a), EqSatFolded(z,b), EqSatAllBits(ty,mask), !EqSatPinnedOp(outer))
        -> EqSatRebuild(outer,result,Form::Bin("addi",Form::Read(x),Form::Bits(eqsat_bit_and(eqsat_sub(a,b),mask))));
    pub let multiply<inner,outer,result,middle,ty,x,y,z,home,prior,a,b,mask>:
        (EqSatBinary(inner,"builtin.muli",middle,ty,x,y,prior),
         EqSatBinary(outer,"builtin.muli",result,ty,middle,z,home),
         EqSatFolded(y,a), EqSatFolded(z,b), EqSatAllBits(ty,mask), !EqSatPinnedOp(outer))
        -> EqSatRebuild(outer,result,Form::Bin("muli",Form::Read(x),Form::Bits(eqsat_bit_and(eqsat_product(a,b),mask))));
}

pub let EqSatCast: (Int, String, Int, Int, Int) -> Prop;
pub let EqSatUnaryKind: String -> Prop;
pub mod cast_cse {
    pub let introduce<node,k,place,home,pos,display,loc,input,result,ty,decl>:
        (EqSatLive(node), Operation(node,k,place,home,pos,display,loc),
         EqSatUnaryKind(k), Operand(node,0,input), Value(result,ty,"result",node,0,decl))
        -> EqSatCast(node,k,input,result,ty);
    pub let existing<first,last,k,input,a,b,ty,place,home,p,q,ad,bd,al,bl>:
        (EqSatCast(first,k,input,a,ty), EqSatCast(last,k,input,b,ty),
         Operation(first,k,place,home,p,ad,al), Operation(last,k,place,home,q,bd,bl),
         less_id(p,q) == true)
        -> EqSatIdentity(last,b,a);
    pub let extend<k>: EqSatExtends(k) -> EqSatUnaryKind(k);
    pub let truncate: EqSatUnaryKind("builtin.trunci");
}

pub mod integer_shapes {
    pub let signed_divide_one<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,"builtin.divsi",out,ty,x,y,home), EqSatFolded(y,eqsat_bigint(1)),
         EqSatAllBits(ty,all), eqsat_same_bits(all,eqsat_bigint(1)) == false)
        -> EqSatIdentity(node,out,x);
    pub let signed_remainder_one<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,"builtin.remsi",out,ty,x,y,home), EqSatFolded(y,eqsat_bigint(1)),
         EqSatAllBits(ty,all), eqsat_same_bits(all,eqsat_bigint(1)) == false, !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("andi",Form::Read(x),Form::Bits(eqsat_bigint(0))));

    pub let factor<node,out,ty,u,v,home,left,right,lh,rh,x,y,factor>:
        (EqSatBinary(node,"builtin.addi",out,ty,u,v,home), EqSatWrappingAdd(node),
         EqSatBinary(left,"builtin.muli",u,ty,x,factor,lh),
         EqSatBinary(right,"builtin.muli",v,ty,y,factor,rh), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("muli",Form::Bin("addi",Form::Read(x),Form::Read(y)),Form::Read(factor)));

    pub let double_negation<node,out,ty,zero,value,home,inner,input,prior,other_zero>:
        (EqSatBinary(node,"builtin.subi",out,ty,zero,value,home), EqSatWrappingSub(node), EqSatFolded(zero,eqsat_bigint(0)),
         EqSatBinary(inner,"builtin.subi",value,ty,other_zero,input,prior), EqSatWrappingSub(inner),
         EqSatFolded(other_zero,eqsat_bigint(0))) -> EqSatIdentity(node,out,input);
}

pub let EqSatDefined: Int -> Prop;
pub let EqSatIncomingParameter: Int -> Prop;
pub let EqSatAnnihilator: String -> Prop;
pub let EqSatCancelSelf: String -> Prop;
pub let EqSatDefinedFold: (Int, Int, BigInt) -> Prop;
pub let EqSatArgumentFreeze: (Int, Int) -> Prop;
pub mod arguments {
    pub let cfg_parameter<func,k,h,p,d,l,region,slot,entry,value,ty,i,decl>:
        (Operation(func,"func.func",k,h,p,d,l), Region(region,"cfg",func,slot,entry),
         Value(value,ty,"block",entry,i,decl)) -> EqSatIncomingParameter(value);
    pub let graph_parameter<func,k,h,p,d,l,region,slot,entry,value,ty,i,decl>:
        (Operation(func,"func.func",k,h,p,d,l), Region(region,"graph",func,slot,entry),
         Value(value,ty,"region",region,i,decl)) -> EqSatIncomingParameter(value);
    // Freezing an already supplied argument cannot hide an undefined computation.
    pub let freeze<node,place,home,p,d,l,input,out,ty,decl>:
        (EqSatLive(node), Operation(node,"builtin.freeze",place,home,p,d,l),
         Operand(node,0,input), EqSatIncomingParameter(input), Value(out,ty,"result",node,0,decl))
        -> EqSatArgumentFreeze(node,out);

}
pub mod defined_integer {
    pub let known<value,bits>: EqSatFolded(value,bits) -> EqSatDefined(value);
    pub let frozen<node,value>: EqSatArgumentFreeze(node,value) -> EqSatDefined(value);

    pub let and_zero: EqSatAnnihilator("builtin.andi");
    pub let multiply_zero: EqSatAnnihilator("builtin.muli");
    pub let xor_self: EqSatCancelSelf("builtin.xori");
    pub let sub_self: EqSatCancelSelf("builtin.subi");
    pub let zero<node,k,out,ty,x,y,home>:
        (EqSatBinary(node,k,out,ty,x,y,home), EqSatAnnihilator(k), EqSatDefined(x),
         EqSatFolded(y,eqsat_bigint(0))) -> EqSatDefinedFold(node,out,eqsat_bigint(0));
    pub let self_cancel<node,k,out,ty,x,y,home,term>:
        (EqSatBinary(node,k,out,ty,x,y,home), EqSatCancelSelf(k), EqSatDefined(x),
         EqSatScalar(x,ty,term), EqSatScalar(y,ty,term)) -> EqSatDefinedFold(node,out,eqsat_bigint(0));
    pub let ones<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,"builtin.ori",out,ty,x,y,home), EqSatDefined(x),
         EqSatFolded(y,all), EqSatAllBits(ty,all)) -> EqSatDefinedFold(node,out,all);
    pub let fold<node,out,bits>:
        (EqSatDefinedFold(node,out,bits), !EqSatPinnedOp(node))
        -> (EqSatFolded(out,bits), EqSatConstant(node,out,bits));
}

pub let EqSatAbsorbs: (String, String) -> Prop;
pub mod guarded_cancel {
    pub let intersection: EqSatAbsorbs("builtin.andi","builtin.ori");
    pub let union: EqSatAbsorbs("builtin.ori","builtin.andi");
    pub let absorb<outer,inner,out,ty,x,y,mid,k,other,home,prior>:
        (EqSatBinary(outer,k,out,ty,x,mid,home), EqSatAbsorbs(k,other),
         EqSatBinary(inner,other,mid,ty,x,y,prior), EqSatDefined(y))
        -> EqSatIdentity(outer,out,x);
    pub let exclusive_or<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,"builtin.xori",out,ty,mid,y,home),
         EqSatBinary(inner,"builtin.xori",mid,ty,x,y,prior), EqSatDefined(y))
        -> EqSatIdentity(outer,out,x);

    pub let undo_add<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,"builtin.subi",out,ty,mid,y,home), EqSatWrappingSub(outer),
         EqSatBinary(inner,"builtin.addi",mid,ty,x,y,prior), EqSatWrappingAdd(inner), EqSatDefined(y))
        -> EqSatIdentity(outer,out,x);
    pub let undo_subtract<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,"builtin.addi",out,ty,mid,y,home), EqSatWrappingAdd(outer),
         EqSatBinary(inner,"builtin.subi",mid,ty,x,y,prior), EqSatWrappingSub(inner), EqSatDefined(y))
        -> EqSatIdentity(outer,out,x);
    pub let subtract_difference<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,"builtin.subi",out,ty,y,mid,home), EqSatWrappingSub(outer),
         EqSatBinary(inner,"builtin.subi",mid,ty,y,x,prior), EqSatWrappingSub(inner), EqSatDefined(y))
        -> EqSatIdentity(outer,out,x);
}


pub let EqSatDefinition: (Int, Int, Form) -> Prop;
pub let EqSatConstantNode: Int -> Prop;
pub mod definition_constants {
    pub let selected<node,result,bits>: EqSatConstant(node,result,bits)
        -> (EqSatDefinition(node,result,Form::Bits(bits)), EqSatConstantNode(node));
}
pub mod definition_expressions {
    pub let selected<node,result,form>:
        (EqSatRebuild(node,result,form), !EqSatConstantNode(node)) -> EqSatDefinition(node,result,form);
}

pub let frame = std::schedule::saturate((allocation, attributes, allocation_shape, ports, counted_pins, arguments));
pub let sites = std::schedule::Schedule::Rules((escape, memory_sites));


pub let EqSatComplement: (Int, Int, Int, BigInt) -> Prop;
pub mod complements {
    pub let neg_one<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,"builtin.muli",out,ty,x,y,home), EqSatFolded(y,all),
         EqSatAllBits(ty,all), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Bits(eqsat_bigint(0)),Form::Read(x)));

    pub let common_addend<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,"builtin.subi",out,ty,a,b,home), EqSatWrappingSub(node),
         EqSatBinary(left,"builtin.addi",a,ty,x,y,lh), EqSatWrappingAdd(left),
         EqSatBinary(right,"builtin.addi",b,ty,x,z,rh), EqSatWrappingAdd(right),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Read(y),Form::Read(z)));
    pub let common_minuend<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,"builtin.subi",out,ty,a,b,home), EqSatWrappingSub(node),
         EqSatBinary(left,"builtin.subi",a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatBinary(right,"builtin.subi",b,ty,x,z,rh), EqSatWrappingSub(right),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Read(z),Form::Read(y)));
    pub let common_subtrahend<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,"builtin.subi",out,ty,a,b,home), EqSatWrappingSub(node),
         EqSatBinary(left,"builtin.subi",a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatBinary(right,"builtin.subi",b,ty,z,y,rh), EqSatWrappingSub(right),
         EqSatDefined(y), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Read(x),Form::Read(z)));

    pub let negate_addend<node,out,ty,x,b,home,right,y,rh>:
        (EqSatBinary(node,"builtin.subi",out,ty,x,b,home), EqSatWrappingSub(node),
         EqSatBinary(right,"builtin.addi",b,ty,x,y,rh), EqSatWrappingAdd(right),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Bits(eqsat_bigint(0)),Form::Read(y)));
    pub let negate_subtrahend<node,out,ty,a,x,home,left,y,lh>:
        (EqSatBinary(node,"builtin.subi",out,ty,a,x,home), EqSatWrappingSub(node),
         EqSatBinary(left,"builtin.subi",a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Bits(eqsat_bigint(0)),Form::Read(y)));

    pub let complement<node,out,ty,x,mask,home,all>:
        (EqSatBinary(node,"builtin.xori",out,ty,x,mask,home),
         EqSatFolded(mask,all), EqSatAllBits(ty,all), EqSatDefined(x))
        -> EqSatComplement(out,x,ty,all);
    pub let intersection<node,out,ty,x,inverse,home,all>:
        (EqSatBinary(node,"builtin.andi",out,ty,x,inverse,home), EqSatComplement(inverse,x,ty,all))
        -> EqSatDefinedFold(node,out,eqsat_bigint(0));
    pub let union<node,out,ty,x,inverse,home,all>:
        (EqSatBinary(node,"builtin.ori",out,ty,x,inverse,home), EqSatComplement(inverse,x,ty,all))
        -> EqSatDefinedFold(node,out,all);
    pub let cancel_pair<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,"builtin.addi",out,ty,a,b,home), EqSatWrappingAdd(node),
         EqSatBinary(left,"builtin.addi",a,ty,x,y,lh), EqSatWrappingAdd(left),
         EqSatBinary(right,"builtin.subi",b,ty,z,y,rh), EqSatWrappingSub(right),
         EqSatDefined(y), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("addi",Form::Read(x),Form::Read(z)));
    pub let telescope<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,"builtin.addi",out,ty,a,b,home), EqSatWrappingAdd(node),
         EqSatBinary(left,"builtin.subi",a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatBinary(right,"builtin.subi",b,ty,y,z,rh), EqSatWrappingSub(right),
         EqSatDefined(y), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin("subi",Form::Read(x),Form::Read(z)));
}
