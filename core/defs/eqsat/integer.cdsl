use std::bigint::BigInt;

pub let EqSatIdentity: (std::ir::OperationId, std::ir::ValueId, std::ir::ValueId) -> Prop;
pub let EqSatZeroRhs: std::ir::BinaryIntegerOperation -> Prop;
pub let EqSatIdempotent: std::ir::BinaryIntegerOperation -> Prop;

pub mod integer_facts {
    pub let add: EqSatZeroRhs(dialects::builtin::addi.typed_kind);
    pub let or: EqSatZeroRhs(dialects::builtin::ori.typed_kind);
    pub let xor: EqSatZeroRhs(dialects::builtin::xori.typed_kind);
    pub let sub: EqSatZeroRhs(dialects::builtin::subi.typed_kind);
    pub let shl: EqSatZeroRhs(dialects::builtin::shli.typed_kind);
    pub let lshr: EqSatZeroRhs(dialects::builtin::shrui.typed_kind);
    pub let ashr: EqSatZeroRhs(dialects::builtin::shrsi.typed_kind);
    pub let and_dup: EqSatIdempotent(dialects::builtin::andi.typed_kind);
    pub let or_dup: EqSatIdempotent(dialects::builtin::ori.typed_kind);

    pub let right_zero<owner, kind, out, ty, x, y, home, b>:
        (EqSatBinary(owner, kind, out, ty, x, y, home), EqSatZeroRhs(kind),
         EqSatScalar(y, ty, b), b == Scalar::Literal(ty, std::bigint::bigint(0)))
        -> EqSatIdentity(owner, out, x);
    pub let idempotent<owner, kind, out, ty, x, y, home, t>:
        (EqSatBinary(owner, kind, out, ty, x, y, home), EqSatIdempotent(kind),
         EqSatScalar(x, ty, t), EqSatScalar(y, ty, t))
        -> EqSatIdentity(owner, out, x);
    pub let multiply_one<owner, out, ty, x, y, home, b>:
        (EqSatBinary(owner, dialects::builtin::muli.typed_kind, out, ty, x, y, home),
         EqSatScalar(y, ty, b), b == Scalar::Literal(ty, std::bigint::bigint(1)))
        -> EqSatIdentity(owner, out, x);
    pub let and_all<owner, out, ty, x, y, home, b, all>:
        (EqSatBinary(owner, dialects::builtin::andi.typed_kind, out, ty, x, y, home),
         EqSatScalar(y, ty, b), EqSatAllBits(ty, all), b == Scalar::Literal(ty, all))
        -> EqSatIdentity(owner, out, x);
    pub let unsigned_divide_one<owner, out, ty, x, y, home, b>:
        (EqSatBinary(owner, dialects::builtin::divui.typed_kind, out, ty, x, y, home),
         EqSatScalar(y, ty, b), b == Scalar::Literal(ty, std::bigint::bigint(1)))
        -> EqSatIdentity(owner, out, x);
    pub let redundant_mask<owner, out, ty, input, mask, home, a, b, kept, zero, all>:
        (EqSatBinary(owner, dialects::builtin::andi.typed_kind, out, ty, input, mask, home),
         EqSatScalar(input, ty, a), EqSatScalar(mask, ty, b), b == Scalar::Literal(ty, kept),
         EqSatZeros(a, ty, zero), EqSatAllBits(ty, all),
         std::bigint::bit_or(kept, zero) == all)
        -> EqSatIdentity(owner, out, input);

    pub let congruent_cfg<a, b, ak, bk, block, ap, bp, ad, bd, al, bl, x, y, ty, term, xd, yd>:
        (ir::Operation{ id: a, kind: ak, placement: "block", container: block, position: ap, display: ad, location: al }(), ir::Operation{ id: b, kind: bk, placement: "block", container: block, position: bp, display: bd, location: bl }(),
         std::int::less(ap,bp) == true, EqSatBinaryKey(a), EqSatBinaryKey(b),
         ir::result(x, ty, a, 0, xd), ir::result(y, ty, b, 0, yd),
         EqSatScalar(x, ty, term), EqSatScalar(y, ty, term))
        -> EqSatIdentity(b, y, x);

    pub let congruent_graph<a, b, k, region, ap, bp, ad, bd, al, bl, x, y, ty, left, right>:
        (ir::Operation{ id: a, kind: std::ir::operation_kind(k), placement: "graph", container: region, position: ap, display: ad, location: al }(), ir::Operation{ id: b, kind: std::ir::operation_kind(k), placement: "graph", container: region, position: bp, display: bd, location: bl }(),
         std::ir::operation_ids::less(a,b) == true, EqSatBinaryKey(a), EqSatBinaryKey(b),
         EqSatBinary(a, k, x, ty, left, right, region), EqSatBinary(b, k, y, ty, left, right, region))
        -> EqSatIdentity(b, y, x);

    pub let equal<owner, out, input, ty, a, b>:
        (EqSatIdentity(owner, out, input), EqSatScalar(out, ty, a), EqSatScalar(input, ty, b))
        -> a == b;
    pub let candidate<owner, out, input>:
        EqSatIdentity(owner, out, input) -> (EqSatReplace(owner, out, input), EqSatErase(owner));
}

pub let EqSatPowerForm: (std::ir::BinaryIntegerOperation, std::ir::BinaryIntegerOperation) -> Prop;
pub let EqSatPower: (BigInt, BigInt) -> Prop;
pub let EqSatRebuild: std::Table<(std::ir::OperationId, std::ir::IntegerRef), Form, std::Merge::Union>;

pub let EqSatWrappingAdd: std::ir::OperationId -> Prop;
pub let EqSatWrappingSub: std::ir::OperationId -> Prop;

pub mod strength {
    pub let multiply: EqSatPowerForm(dialects::builtin::muli.typed_kind, dialects::builtin::shli.typed_kind);
    pub let divide: EqSatPowerForm(dialects::builtin::divui.typed_kind, dialects::builtin::shrui.typed_kind);

    pub let power<value, bits, log, width>:
        (EqSatFolded(value, bits), log == (std::bigint::bits(bits) - std::bigint::bigint(1)),
         width == eqsat_shift_amount(log), std::int::less(width, 0) == false,
         std::bigint::shl(std::bigint::bigint(1),width) == bits)
        -> EqSatPower(bits,log);

    pub let shift<node, kind, target, result, ty, x, y, home, value, power>:
        (EqSatBinary(node, kind, result, ty, x, y, home), EqSatPowerForm(kind,target),
         EqSatFolded(y, value), EqSatPower(value,power), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,result,Form::Bin(target,Form::Read(x),Form::Bits(power)));

    pub let remainder<node, result, ty, x, y, home, value, power>:
        (EqSatBinary(node, dialects::builtin::remui.typed_kind, result, ty, x, y, home),
         EqSatFolded(y,value), EqSatPower(value,power), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,result,Form::Bin(dialects::builtin::andi.typed_kind,Form::Read(x),Form::Bits((value - std::bigint::bigint(1)))));

    pub let wrapping_add<node, result, ty, x, y, home>:
        (EqSatBinary(node,dialects::builtin::addi.typed_kind,result,ty,x,y,home),
         !EqSatHasAttr(node,"nsw"), !EqSatHasAttr(node,"nuw")) -> EqSatWrappingAdd(node);
    pub let wrapping_sub<node, result, ty, x, y, home>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,result,ty,x,y,home),
         !EqSatHasAttr(node,"nsw"), !EqSatHasAttr(node,"nuw")) -> EqSatWrappingSub(node);

    pub let reassociate<inner, outer, result, middle, ty, x, y, z, home, prior, a, b, mask>:
        (EqSatBinary(inner,dialects::builtin::addi.typed_kind,middle,ty,x,y,prior), EqSatWrappingAdd(inner),
         EqSatBinary(outer,dialects::builtin::addi.typed_kind,result,ty,middle,z,home), EqSatWrappingAdd(outer),
         EqSatFolded(y,a), EqSatFolded(z,b), EqSatAllBits(ty,mask), !EqSatPinnedOp(outer))
        -> EqSatRebuild(outer,result,Form::Bin(dialects::builtin::addi.typed_kind,Form::Read(x),Form::Bits(std::bigint::bit_and((a + b),mask))));

    pub let cancel<inner, outer, result, middle, ty, x, y, z, home, prior, a>:
        (EqSatBinary(inner,dialects::builtin::addi.typed_kind,middle,ty,x,y,prior), EqSatWrappingAdd(inner),
         EqSatBinary(outer,dialects::builtin::subi.typed_kind,result,ty,middle,z,home), EqSatWrappingSub(outer),
         EqSatFolded(y,a), EqSatFolded(z,a))
        -> EqSatIdentity(outer, result, x);
}

pub mod casts {
    pub let extension_kind: EqSatExtends(dialects::builtin::extui.typed_kind);
    pub let sign_extension: EqSatExtends(dialects::builtin::extsi.typed_kind);
    pub let round_trip<outer, inner, out, ot, middle, kind, x, xt, xk, xo, xs, xd>:
        (EqSatLive(outer), dialects::builtin::trunci.matches(outer, (middle,), (out,)),
         EqSatExtends(kind), std::ir::match_kind(kind, inner, (x,), (middle,)),
         ir::Value(x, xt, xk, xo, xs, xd),
         ir::result(out, xt, outer, 0, ot))
        -> EqSatIdentity(outer, out, x);
}
pub let EqSatExtends<I: Nat, O: Nat>:
    std::ir::OperationKindOf<(std::ir::ValueRef<std::El<std::Bits<I>>>,), (std::ir::ValueRef<std::El<std::Bits<O>>>,)> -> Prop;

pub let EqSatBitPair: (std::ir::BinaryIntegerOperation, std::ir::BinaryIntegerOperation) -> Prop;
pub mod extraction {
    pub let union_and: EqSatBitPair(dialects::builtin::ori.typed_kind,dialects::builtin::xori.typed_kind);
    pub let xor_and: EqSatBitPair(dialects::builtin::xori.typed_kind,dialects::builtin::ori.typed_kind);
    pub let bit_pair<node,out,ty,u,v,home,a,b,kind,target,ha,hb,x,y>:
        (EqSatBinary(node,dialects::builtin::xori.typed_kind,out,ty,u,v,home), !EqSatPinnedOp(node),
         EqSatBinary(a,kind,u,ty,x,y,ha), EqSatBinary(b,dialects::builtin::andi.typed_kind,v,ty,x,y,hb),
         EqSatBitPair(kind,target))
        -> EqSatRebuild(node,out,Form::Bin(target,Form::Read(x),Form::Read(y)));

    pub let offsets<node,out,ty,u,v,home,left,right,lh,rh,x,y,c,d,a,b,mask>:
        (EqSatBinary(node,dialects::builtin::addi.typed_kind,out,ty,u,v,home), EqSatWrappingAdd(node), !EqSatPinnedOp(node),
         EqSatBinary(left,dialects::builtin::addi.typed_kind,u,ty,x,c,lh), EqSatWrappingAdd(left),
         EqSatBinary(right,dialects::builtin::addi.typed_kind,v,ty,y,d,rh), EqSatWrappingAdd(right),
         EqSatFolded(c,a), EqSatFolded(d,b), EqSatAllBits(ty,mask), std::ir::value_ids::less(y,x) == false)
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::addi.typed_kind,Form::Bin(dialects::builtin::addi.typed_kind,Form::Read(x),Form::Read(y)),
                                                Form::Bits(std::bigint::bit_and((a + b),mask))));
}

pub mod modular {
    pub let subtract<inner,outer,result,middle,ty,x,y,z,home,prior,a,b,mask>:
        (EqSatBinary(inner,dialects::builtin::addi.typed_kind,middle,ty,x,y,prior), EqSatWrappingAdd(inner),
         EqSatBinary(outer,dialects::builtin::subi.typed_kind,result,ty,middle,z,home), EqSatWrappingSub(outer),
         EqSatFolded(y,a), EqSatFolded(z,b), EqSatAllBits(ty,mask), !EqSatPinnedOp(outer))
        -> EqSatRebuild(outer,result,Form::Bin(dialects::builtin::addi.typed_kind,Form::Read(x),Form::Bits(std::bigint::bit_and((a - b),mask))));
    pub let multiply<inner,outer,result,middle,ty,x,y,z,home,prior,a,b,mask>:
        (EqSatBinary(inner,dialects::builtin::muli.typed_kind,middle,ty,x,y,prior),
         EqSatBinary(outer,dialects::builtin::muli.typed_kind,result,ty,middle,z,home),
         EqSatFolded(y,a), EqSatFolded(z,b), EqSatAllBits(ty,mask), !EqSatPinnedOp(outer))
        -> EqSatRebuild(outer,result,Form::Bin(dialects::builtin::muli.typed_kind,Form::Read(x),Form::Bits(std::bigint::bit_and((a * b),mask))));
}

pub let EqSatCast: (std::ir::OperationId, std::ir::OperationKind, std::ir::ValueId, std::ir::ValueId, Int) -> Prop;
pub let EqSatUnaryKind<I: Nat, O: Nat>:
    std::ir::OperationKindOf<(std::ir::ValueRef<std::El<std::Bits<I>>>,), (std::ir::ValueRef<std::El<std::Bits<O>>>,)> -> Prop;
pub mod cast_cse {
    pub let introduce<node,k,input,result,ty,decl>:
        (EqSatLive(node), EqSatUnaryKind(k), std::ir::match_kind(k, node, (input,), (result,)),
         ir::result(result, ty, node,0,decl))
        -> EqSatCast(node,std::ir::operation_kind(k),input,result,ty);
    pub let existing<first,last,k,input,a,b,ty,place,home,p,q,ad,bd,al,bl>:
        (EqSatCast(first,k,input,a,ty), EqSatCast(last,k,input,b,ty),
         ir::Operation{ id: first, kind: k, placement: place, container: home, position: p, display: ad, location: al }(), ir::Operation{ id: last, kind: k, placement: place, container: home, position: q, display: bd, location: bl }(),
         std::int::less(p,q) == true)
        -> EqSatIdentity(last, b, a);
    pub let extend<k>: EqSatExtends(k) -> EqSatUnaryKind(k);
    pub let truncate: EqSatUnaryKind(dialects::builtin::trunci.typed_kind);
}

pub mod integer_shapes {
    pub let signed_divide_one<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,dialects::builtin::divsi.typed_kind,out,ty,x,y,home), EqSatFolded(y,std::bigint::bigint(1)),
         EqSatAllBits(ty,all), all != std::bigint::bigint(1))
        -> EqSatIdentity(node, out, x);
    pub let signed_remainder_one<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,dialects::builtin::remsi.typed_kind,out,ty,x,y,home), EqSatFolded(y,std::bigint::bigint(1)),
         EqSatAllBits(ty,all), all != std::bigint::bigint(1), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::andi.typed_kind,Form::Read(x),Form::Bits(std::bigint::bigint(0))));

    pub let factor<node,out,ty,u,v,home,left,right,lh,rh,x,y,factor>:
        (EqSatBinary(node,dialects::builtin::addi.typed_kind,out,ty,u,v,home), EqSatWrappingAdd(node),
         EqSatBinary(left,dialects::builtin::muli.typed_kind,u,ty,x,factor,lh),
         EqSatBinary(right,dialects::builtin::muli.typed_kind,v,ty,y,factor,rh), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::muli.typed_kind,Form::Bin(dialects::builtin::addi.typed_kind,Form::Read(x),Form::Read(y)),Form::Read(factor)));

    pub let double_negation<node,out,ty,zero,value,home,inner,input,prior,other_zero>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,out,ty,zero,value,home), EqSatWrappingSub(node), EqSatFolded(zero,std::bigint::bigint(0)),
         EqSatBinary(inner,dialects::builtin::subi.typed_kind,value,ty,other_zero,input,prior), EqSatWrappingSub(inner),
         EqSatFolded(other_zero,std::bigint::bigint(0))) -> EqSatIdentity(node, out, input);
}

pub let EqSatDefined: std::ir::ValueId -> Prop;
pub let EqSatIncomingParameter: std::ir::ValueId -> Prop;
pub let EqSatAnnihilator: std::ir::BinaryIntegerOperation -> Prop;
pub let EqSatCancelSelf: std::ir::BinaryIntegerOperation -> Prop;
pub let EqSatDefinedFold: (std::ir::OperationId, std::ir::ValueId, BigInt) -> Prop;
pub let EqSatArgumentFreeze: (std::ir::OperationId, std::ir::ValueId) -> Prop;
pub mod arguments {
    pub let cfg_parameter<func,k,h,p,d,l,region,slot,entry,value,ty,i,decl>:
        (ir::Operation{ id: func, kind: dialects::func::func.kind, placement: k, container: h, position: p, display: d, location: l }(), ir::Region(region,"cfg",func,slot,entry),
         ir::Value(value,ty,"block",entry,i,decl)) -> EqSatIncomingParameter(value);
    pub let graph_parameter<func,k,h,p,d,l,region,slot,entry,value,ty,i,decl>:
        (ir::Operation{ id: func, kind: dialects::func::func.kind, placement: k, container: h, position: p, display: d, location: l }(), ir::Region(region,"graph",func,slot,entry),
         ir::Value(value,ty,"region",region,i,decl)) -> EqSatIncomingParameter(value);
    // Freezing an already supplied argument cannot hide an undefined computation.
    pub let freeze<node, input, out>:
        (EqSatLive(node), dialects::builtin::freeze.matches(node, (input,), (out,)),
         EqSatIncomingParameter(input))
        -> EqSatArgumentFreeze(node, out);

}
pub mod defined_integer {
    pub let known<value,bits>: EqSatFolded(value,bits) -> EqSatDefined(value);
    pub let frozen<node,value>: EqSatArgumentFreeze(node,value) -> EqSatDefined(value);

    pub let and_zero: EqSatAnnihilator(dialects::builtin::andi.typed_kind);
    pub let multiply_zero: EqSatAnnihilator(dialects::builtin::muli.typed_kind);
    pub let xor_self: EqSatCancelSelf(dialects::builtin::xori.typed_kind);
    pub let sub_self: EqSatCancelSelf(dialects::builtin::subi.typed_kind);
    pub let zero<node,k,out,ty,x,y,home>:
        (EqSatBinary(node,k,out,ty,x,y,home), EqSatAnnihilator(k), EqSatDefined(x),
         EqSatFolded(y,std::bigint::bigint(0))) -> EqSatDefinedFold(node,out,std::bigint::bigint(0));
    pub let self_cancel<node,k,out,ty,x,y,home,term>:
        (EqSatBinary(node,k,out,ty,x,y,home), EqSatCancelSelf(k), EqSatDefined(x),
         EqSatScalar(x,ty,term), EqSatScalar(y,ty,term)) -> EqSatDefinedFold(node,out,std::bigint::bigint(0));
    pub let ones<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,dialects::builtin::ori.typed_kind,out,ty,x,y,home), EqSatDefined(x),
         EqSatFolded(y,all), EqSatAllBits(ty,all)) -> EqSatDefinedFold(node,out,all);
    pub let fold<node,out,bits>:
        (EqSatDefinedFold(node,out,bits), !EqSatPinnedOp(node))
        -> (EqSatFolded(out,bits), EqSatConstant(node,out,bits));
}

pub let EqSatAbsorbs: (std::ir::BinaryIntegerOperation, std::ir::BinaryIntegerOperation) -> Prop;
pub mod guarded_cancel {
    pub let intersection: EqSatAbsorbs(dialects::builtin::andi.typed_kind,dialects::builtin::ori.typed_kind);
    pub let union: EqSatAbsorbs(dialects::builtin::ori.typed_kind,dialects::builtin::andi.typed_kind);
    pub let absorb<outer,inner,out,ty,x,y,mid,k,other,home,prior>:
        (EqSatBinary(outer,k,out,ty,x,mid,home), EqSatAbsorbs(k,other),
         EqSatBinary(inner,other,mid,ty,x,y,prior), EqSatDefined(y))
        -> EqSatIdentity(outer, out, x);
    pub let exclusive_or<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,dialects::builtin::xori.typed_kind,out,ty,mid,y,home),
         EqSatBinary(inner,dialects::builtin::xori.typed_kind,mid,ty,x,y,prior), EqSatDefined(y))
        -> EqSatIdentity(outer, out, x);

    pub let undo_add<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,dialects::builtin::subi.typed_kind,out,ty,mid,y,home), EqSatWrappingSub(outer),
         EqSatBinary(inner,dialects::builtin::addi.typed_kind,mid,ty,x,y,prior), EqSatWrappingAdd(inner), EqSatDefined(y))
        -> EqSatIdentity(outer, out, x);
    pub let undo_subtract<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,dialects::builtin::addi.typed_kind,out,ty,mid,y,home), EqSatWrappingAdd(outer),
         EqSatBinary(inner,dialects::builtin::subi.typed_kind,mid,ty,x,y,prior), EqSatWrappingSub(inner), EqSatDefined(y))
        -> EqSatIdentity(outer, out, x);
    pub let subtract_difference<outer,inner,out,ty,x,y,mid,home,prior>:
        (EqSatBinary(outer,dialects::builtin::subi.typed_kind,out,ty,y,mid,home), EqSatWrappingSub(outer),
         EqSatBinary(inner,dialects::builtin::subi.typed_kind,mid,ty,y,x,prior), EqSatWrappingSub(inner), EqSatDefined(y))
        -> EqSatIdentity(outer, out, x);
}

pub let EqSatDefinition: (std::ir::OperationId, std::ir::ValueId, Form) -> Prop;
pub let EqSatConstantNode: std::ir::OperationId -> Prop;
pub mod definition_constants {
    pub let selected<node,result,bits>: EqSatConstant(node,result,bits)
        -> (EqSatDefinition(node,result,Form::Bits(bits)), EqSatConstantNode(node));
}
pub mod definition_expressions {
    pub let selected<node,result,form>:
        (EqSatRebuild(node,result,form), !EqSatConstantNode(node))
        -> EqSatDefinition(node,result,form);
}

pub let EqSatComplement: (std::ir::ValueId, std::ir::ValueId, Int, BigInt) -> Prop;
pub mod complements {
    pub let neg_one<node,out,ty,x,y,home,all>:
        (EqSatBinary(node,dialects::builtin::muli.typed_kind,out,ty,x,y,home), EqSatFolded(y,all),
         EqSatAllBits(ty,all), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Bits(std::bigint::bigint(0)),Form::Read(x)));

    pub let common_addend<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,out,ty,a,b,home), EqSatWrappingSub(node),
         EqSatBinary(left,dialects::builtin::addi.typed_kind,a,ty,x,y,lh), EqSatWrappingAdd(left),
         EqSatBinary(right,dialects::builtin::addi.typed_kind,b,ty,x,z,rh), EqSatWrappingAdd(right),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Read(y),Form::Read(z)));
    pub let common_minuend<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,out,ty,a,b,home), EqSatWrappingSub(node),
         EqSatBinary(left,dialects::builtin::subi.typed_kind,a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatBinary(right,dialects::builtin::subi.typed_kind,b,ty,x,z,rh), EqSatWrappingSub(right),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Read(z),Form::Read(y)));
    pub let common_subtrahend<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,out,ty,a,b,home), EqSatWrappingSub(node),
         EqSatBinary(left,dialects::builtin::subi.typed_kind,a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatBinary(right,dialects::builtin::subi.typed_kind,b,ty,z,y,rh), EqSatWrappingSub(right),
         EqSatDefined(y), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Read(x),Form::Read(z)));

    pub let negate_addend<node,out,ty,x,b,home,right,y,rh>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,out,ty,x,b,home), EqSatWrappingSub(node),
         EqSatBinary(right,dialects::builtin::addi.typed_kind,b,ty,x,y,rh), EqSatWrappingAdd(right),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Bits(std::bigint::bigint(0)),Form::Read(y)));
    pub let negate_subtrahend<node,out,ty,a,x,home,left,y,lh>:
        (EqSatBinary(node,dialects::builtin::subi.typed_kind,out,ty,a,x,home), EqSatWrappingSub(node),
         EqSatBinary(left,dialects::builtin::subi.typed_kind,a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatDefined(x), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Bits(std::bigint::bigint(0)),Form::Read(y)));

    pub let complement<node,out,ty,x,mask,home,all>:
        (EqSatBinary(node,dialects::builtin::xori.typed_kind,out,ty,x,mask,home),
         EqSatFolded(mask,all), EqSatAllBits(ty,all), EqSatDefined(x))
        -> EqSatComplement(out,x,ty,all);
    pub let intersection<node,out,ty,x,inverse,home,all>:
        (EqSatBinary(node,dialects::builtin::andi.typed_kind,out,ty,x,inverse,home), EqSatComplement(inverse,x,ty,all))
        -> EqSatDefinedFold(node,out,std::bigint::bigint(0));
    pub let union<node,out,ty,x,inverse,home,all>:
        (EqSatBinary(node,dialects::builtin::ori.typed_kind,out,ty,x,inverse,home), EqSatComplement(inverse,x,ty,all))
        -> EqSatDefinedFold(node,out,all);
    pub let cancel_pair<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,dialects::builtin::addi.typed_kind,out,ty,a,b,home), EqSatWrappingAdd(node),
         EqSatBinary(left,dialects::builtin::addi.typed_kind,a,ty,x,y,lh), EqSatWrappingAdd(left),
         EqSatBinary(right,dialects::builtin::subi.typed_kind,b,ty,z,y,rh), EqSatWrappingSub(right),
         EqSatDefined(y), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::addi.typed_kind,Form::Read(x),Form::Read(z)));
    pub let telescope<node,out,ty,a,b,home,left,right,x,y,z,lh,rh>:
        (EqSatBinary(node,dialects::builtin::addi.typed_kind,out,ty,a,b,home), EqSatWrappingAdd(node),
         EqSatBinary(left,dialects::builtin::subi.typed_kind,a,ty,x,y,lh), EqSatWrappingSub(left),
         EqSatBinary(right,dialects::builtin::subi.typed_kind,b,ty,y,z,rh), EqSatWrappingSub(right),
         EqSatDefined(y), !EqSatPinnedOp(node))
        -> EqSatRebuild(node,out,Form::Bin(dialects::builtin::subi.typed_kind,Form::Read(x),Form::Read(z)));
}
