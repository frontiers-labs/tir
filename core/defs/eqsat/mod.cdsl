        (EqSatCountedPort(node, region, j, port, result, init),
         EqSatCountedYield(region, exit), ir::Operand(exit, j, output), EqSatPath(std::ir::value_key(output), std::ir::value_key(port)))
        -> EqSatCountedSame(result, exit);
    pub let same_literal<node,region,j,port,result,init,exit,output,bits>:
        (EqSatCountedPort(node,region,j,port,result,init), EqSatCountedYield(region,exit),
         ir::Operand(exit,j,output), EqSatFolded(init,bits), EqSatFolded(output,bits))
