// ── Modular Rule Submodules ──────────────────────────────────────────────────

pub mod bits;
pub mod context;
pub mod integer;
pub mod layout;
pub mod rewrites;
pub mod rvsdg;
pub mod schedule;

// ── Exported Standalone Rewrite Collections ──────────────────────────────────

pub let add_zero_rewrites = || -> List<Rewrite> { rewrites::add_zero_list };
pub let builtin_rewrites = || -> List<Rewrite> { rewrites::builtin_list };

// ── Equality Saturation Pass Drivers ─────────────────────────────────────────

let eqsat_driver = |
    session: Session,
    root: OperationId,
    rules: List<Rewrite>,
    extras: RuleSlice,
| -> EditSummary {
    let analyze = schedule::build_analyze(rules);
    seed_root(session, root);
    run_stage(session, schedule::prepare_stage);
    resolve_layouts(session);
    saturate(session, analyze, "eqsat::global", extras);
    publish_rewrites(session)
};

pub let run_builtin_eqsat = |
    session: Session,
    root: OperationId,
    extras: RuleSlice,
| -> EditSummary {
    eqsat_driver(session, root, rewrites::algebraic_rewrites, extras)
};

pub let run_custom_eqsat = |
    session: Session,
    root: OperationId,
    rules: RuleCollection,
| -> EditSummary {
    seed_root(session, root);
    run_stage(session, schedule::prepare_custom_stage);
    run_collection(session, rules, 64);
    run_stage(session, schedule::publish_aliases_stage);
    publish_rewrites(session)
};
