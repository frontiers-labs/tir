                     pdecl, rdecl, kind, owner, input_slot, idecl>:
        (EqSatLive(node), ir::Operation{ id: node, kind: dialects::scf::ordered_for.kind, placement: "block", container: home, position: position, display: display, location: location }(),
         ir::Region(region, "cfg", node, 0, entry), ir::Value(port, ty, "block", entry, i, pdecl),
         ir::less_id(0,i) == true, j == eqsat_int_sub(i,1), ir::Operand(node, i, init),
         ir::Value(init, ty, kind, owner, input_slot, idecl), ir::Value(result, ty, "result", node, i, rdecl))
        -> EqSatCountedPort(node, region, j, port, result, init);

    pub let sites<region, block, order, exit, pos, display, loc>:
