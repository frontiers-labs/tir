         ir::Control(node,true,selector,false,body,pred,polarity), ir::Operand(node,selector,value),
         EqSatDefined(value), !EqSatUnprovedControl(node), !EqSatExtraResult(node),
         ir::Value(result,ty,"result",node,0,decl), EqSatInteger(ty), !EqSatPinned(result))
        -> (EqSatPureSwitch(node,result,ty), EqSatRemovable(node,result), EqSatRemovableNode(node));
}
pub mod switch_values {
    pub let selected_literal<node,result,ty,arm,slot,value,bits>:
        (EqSatPureSwitch(node,result,ty), EqSatSelectedArm(node,arm),
         ir::Binding(arm,"exit",0,slot), ir::Yield(arm,slot,value), EqSatFolded(value,bits))
        -> EqSatPhiLiteral(result,bits);
    pub let capture<node,result,ty,arm,mode,arm_slot,entry,slot,value,kind,owner,i,decl>:
        (EqSatPureSwitch(node,result,ty), ir::Region(arm,mode,node,arm_slot,entry),
         ir::Binding(arm,"exit",0,slot), ir::Yield(arm,slot,value),
         EqSatVisibleAt(node,value), ir::Value(value,ty,kind,owner,i,decl))
        -> EqSatSwitchYield(node,result,arm,value);
    pub let forwarded<node,result,ty,arm,value,kind,owner,slot,decl>:
        (EqSatPureSwitch(node,result,ty),
         EqSatArmResult(node,arm,0,value,true), ir::Value(value,ty,kind,owner,slot,decl))
        -> EqSatSwitchYield(node,result,arm,value);
}
pub mod switch_agreement {
    pub let disagree<node,result,witness,value,arm,mode,slot,entry>:
        (EqSatSwitchYield(node,result,witness,value), ir::Region(arm,mode,node,slot,entry),
         !EqSatSwitchYield(node,result,arm,value)) -> EqSatSwitchDisagrees(node,value);
}
pub mod switch_aliases {
    pub let selected<node,result,arm,value>:
        (EqSatSwitchYield(node,result,arm,value), EqSatSelectedArm(node,arm))
        -> EqSatReplace(std::ir::operation_key(node), std::ir::value_key(result), std::ir::value_key(value));
    pub let all_arms<node,result,arm,value>:
        (EqSatSwitchYield(node,result,arm,value), !EqSatSwitchDisagrees(node,value))
        -> EqSatReplace(std::ir::operation_key(node), std::ir::value_key(result), std::ir::value_key(value));
}

pub let EqSatFiniteLoop: (Int, Int) -> Prop;
pub mod finite_loops {
    // A nonnegative counter reaches its signed limit before a unit increment can wrap.
    pub let finite<node,home,pos,display,loc,selector,body,predicate,condition,ct,cmp,
                   slot,counter,init,feedback,next,step,add,ty,term,bound_term,bound,start,mask>:
        (EqSatLive(node), ir::Operation{ id: node, kind: dialects::scf::r#loop.kind, placement: "graph", container: home, position: pos, display: display, location: loc }(), !EqSatUnprovedControl(node),
         ir::Control(node,false,selector,true,body,predicate,"true"), ir::Yield(body,predicate,condition),
         EqSatPort(node,body,slot,std::ir::value_id(counter),init), ir::Binding(body,"feedback",slot,feedback), ir::Yield(body,feedback,std::ir::value_id(next)),
         EqSatBinary(add,dialects::builtin::addi.typed_kind,next,ty,counter,step,body), EqSatWrappingAdd(add),
         EqSatFolded(std::ir::value_id(step),eqsat_bigint(1)), EqSatScalar(std::ir::value_id(counter),ty,term), EqSatScalar(condition,ct,cmp),
         cmp == Scalar::Compare("slt",ct,term,bound_term), bound_term == Scalar::Literal(ty,bound),
         EqSatFolded(init,start), EqSatAllBits(ty,mask),
         eqsat_leq_bits(eqsat_sum(start,start),mask) == true, eqsat_leq_bits(eqsat_sum(bound,bound),mask) == true)
        -> EqSatFiniteLoop(node,body);
    pub let output<node,body,exits,slot,value,result,ty,decl,bits>:
        (EqSatFiniteLoop(node,body), ir::Binding(body,"exit",slot,exits), ir::Yield(body,exits,value),
         EqSatFolded(value,bits), ir::Value(result,ty,"result",node,slot,decl), EqSatInteger(ty), !EqSatPinned(result))
        -> EqSatPhiLiteral(result,bits);
}

pub mod floating_point {
    pub let capture_round_trip<node, capture, computation, x, kind, owner, slot, xdecl, result, ty, declared>:
        (EqSatLive(node), dialects::fp::materialize.matches(node, (computation,), (result,)),
         dialects::fp::capture.matches(capture, (x,), (computation,)),
         ir::Value(std::ir::value_id(x), ty, kind, owner, slot, xdecl),
         ir::Value(std::ir::value_id(result), ty, "result", node, 0, declared),
         !EqSatHasAttr(node, "semantics"))
        -> (EqSatReplace(std::ir::operation_key(node), std::ir::value_ref_key(result), std::ir::value_ref_key(x)), EqSatErase(std::ir::operation_key(node)));
}

// Computation type identity includes format, rounding and contraction.
pub let EqSatFpBinary<T: Type>: std::ir::OperationKindOf<(std::ir::ValueRef<T>, std::ir::ValueRef<T>), (std::ir::ValueRef<T>,)> -> Prop;
pub let EqSatFpUnary<I: Type, O: Type>: std::ir::OperationKindOf<(std::ir::ValueRef<I>,), (std::ir::ValueRef<O>,)> -> Prop;
pub let EqSatFpKey: (Int, std::ir::OperationKind, Int, Int, Int, Int) -> Prop;
pub mod fp_keys {
    pub let capture: EqSatFpUnary(dialects::fp::capture.typed_kind);
    pub let materialize: EqSatFpUnary(dialects::fp::materialize.typed_kind);
    pub let add: EqSatFpBinary(dialects::fp::add.typed_kind);
    pub let sub: EqSatFpBinary(dialects::fp::sub.typed_kind);
    pub let mul: EqSatFpBinary(dialects::fp::mul.typed_kind);
    pub let div: EqSatFpBinary(dialects::fp::div.typed_kind);
    pub let unary<node,k,x,result,ty,decl>:
        (EqSatLive(node), EqSatFpUnary(k), std::ir::match_kind(k, node, (x,), (result,)),
         ir::Value(std::ir::value_id(result),ty,"result",node,0,decl), !EqSatHasAttr(node,"semantics"),
         !EqSatOperandSlot(node,1), !EqSatExtraResult(node))
        -> EqSatFpKey(node,std::ir::operation_kind(k),std::ir::value_id(result),ty,std::ir::value_id(x),0);
    pub let binary<node,k,x,y,result,ty,decl>:
        (EqSatLive(node), EqSatFpBinary(k), std::ir::match_kind(k, node, (x, y), (result,)),
         ir::Value(std::ir::value_id(result),ty,"result",node,0,decl),
         !EqSatHasAttr(node,"semantics"), !EqSatOperandSlot(node,2), !EqSatExtraResult(node))
        -> EqSatFpKey(node,std::ir::operation_kind(k),std::ir::value_id(result),ty,std::ir::value_id(x),std::ir::value_id(y));
}
pub mod fp_congruence {
    pub let ordered<a,b,k,x,y,ty,lhs,rhs,block,p,q,ad,bd,al,bl>:
        (EqSatFpKey(a,k,x,ty,lhs,rhs), EqSatFpKey(b,k,y,ty,lhs,rhs),
         ir::Operation{ id: a, kind: k, placement: "block", container: block, position: p, display: ad, location: al }(), ir::Operation{ id: b, kind: k, placement: "block", container: block, position: q, display: bd, location: bl }(),
         ir::less_id(p,q) == true)
        -> (EqSatReplace(std::ir::operation_key(b), std::ir::value_key(y), std::ir::value_key(x)), EqSatErase(std::ir::operation_key(b)));
    pub let graph<a,b,k,x,y,ty,lhs,rhs,region,p,q,ad,bd,al,bl>:
        (EqSatFpKey(a,k,x,ty,lhs,rhs), EqSatFpKey(b,k,y,ty,lhs,rhs),
         ir::Operation{ id: a, kind: k, placement: "graph", container: region, position: p, display: ad, location: al }(), ir::Operation{ id: b, kind: k, placement: "graph", container: region, position: q, display: bd, location: bl }(),
         ir::less_id(a,b) == true)
        -> (EqSatReplace(std::ir::operation_key(b), std::ir::value_key(y), std::ir::value_key(x)), EqSatErase(std::ir::operation_key(b)));
}

pub let EqSatLayoutKind: std::ir::OperationKind -> Prop;
pub let EqSatLayoutQuery: (Int, std::ir::OperationKind) -> Prop;
pub let EqSatLayoutValue: (Int, BigInt) -> Prop;

pub mod layout_queries {
    pub let size: EqSatLayoutKind(dialects::layout::sizeof.kind);
    pub let alignment: EqSatLayoutKind(dialects::layout::alignof.kind);
    pub let offset: EqSatLayoutKind(dialects::layout::offsetof.kind);
    pub let pointer: EqSatLayoutKind(dialects::ptr::ptradd.kind);
    pub let write: EqSatLayoutKind(dialects::ptr::store.kind);
    pub let read: EqSatLayoutKind(dialects::ptr::load.kind);
    pub let query<node, kind, place, home, pos, display, loc>:
        (EqSatLive(node), EqSatLayoutKind(kind), ir::Operation{ id: node, kind: kind, placement: place, container: home, position: pos, display: display, location: loc }())
        -> EqSatLayoutQuery(node, kind);
}

pub mod layout_values {
    pub let fold<node, value, result, ty, declared, mask, bits>:
        (EqSatLayoutValue(node, value), ir::Value(result, ty, "result", node, 0, declared),
         EqSatAllBits(ty, mask), bits == eqsat_bit_and(value, mask))
        -> (EqSatFolded(result, bits), EqSatConstant(node, result, bits));
}

pub let EqSatLayoutScoped: Int -> Prop;
pub mod layout_pointer {
    pub let identity<node, place, home, pos, display, loc, ptr, offset, result, ty, pk, po, ps, pd, rd>:
        (EqSatLive(node), ir::Operation{ id: node, kind: dialects::ptr::ptradd.kind, placement: place, container: home, position: pos, display: display, location: loc }(),
         EqSatLayoutScoped(node), ir::Operand(node, 0, ptr), ir::Operand(node, 1, offset),
         EqSatFolded(offset, eqsat_bigint(0)),
         ir::Value(ptr, ty, pk, po, ps, pd), ir::Value(result, ty, "result", node, 0, rd))
        -> (EqSatReplace(std::ir::operation_key(node), std::ir::value_key(result), std::ir::value_key(ptr)), EqSatErase(std::ir::operation_key(node)));
}

pub let EqSatOffsetStep: (Int, Int, Int, Int, Int, BigInt, BigInt) -> Prop;
pub let EqSatAddress: (Int, Int, Int, Int, Int, BigInt) -> Prop;
pub let EqSatAddressEquals: (Int, Int) -> Prop;
pub let EqSatLocalAddress: (Int, Int, BigInt) -> Prop;
pub mod address_keys {
    pub let step<node,place,home,p,d,l,base,disp,address,ty,decl,index,kind,owner,slot,id,
                 width,offset,mask>:
        (EqSatLive(node), ir::Operation{ id: node, kind: dialects::ptr::ptradd.kind, placement: place, container: home, position: p, display: d, location: l }(),
         EqSatLayoutScoped(node), EqSatPointerSize(node,width),
         ir::Operand(node,0,base), ir::Operand(node,1,disp), ir::Value(address,ty,"result",node,0,decl),
         ir::Value(disp,index,kind,owner,slot,id), EqSatFolded(disp,offset), EqSatAllBits(index,mask),
         eqsat_leq_bits(eqsat_sum(offset,offset),mask) == true,
         !EqSatHasAttr(node,"inbounds"), !EqSatHasAttr(node,"nuw"), !EqSatHasAttr(node,"nsw"))
        -> EqSatOffsetStep(address,base,ty,index,width,offset,mask);
    pub let direct<address,base,ty,index,width,offset,mask>:
        EqSatOffsetStep(address,base,ty,index,width,offset,mask)
        -> EqSatAddress(address,base,ty,index,width,offset);
    pub let add<address,parent,base,ty,index,width,offset,prior,total,mask>:
        (EqSatOffsetStep(address,parent,ty,index,width,offset,mask),
         EqSatAddress(parent,base,ty,index,width,prior), total == eqsat_sum(offset,prior),
         eqsat_leq_bits(eqsat_sum(total,total),mask) == true)
        -> EqSatAddress(address,base,ty,index,width,total);

    pub let twins<a,b,base,ty,index,width,offset>:
        (EqSatAddress(a,base,ty,index,width,offset), EqSatAddress(b,base,ty,index,width,offset))
        -> EqSatAddressEquals(a,b);
    pub let same_cell<a,b,state,ty,data,producer>:
        (EqSatAddressEquals(a,b), EqSatStored(state,a,ty,data,producer))
        -> EqSatStored(state,b,ty,data,producer);
    pub let root<base>: EqSatAllocation(base) -> EqSatLocalAddress(base,base,eqsat_bigint(0));
    pub let local<address,base,ty,index,width,offset>:
        (EqSatAddress(address,base,ty,index,width,offset), EqSatAllocation(base))
        -> EqSatLocalAddress(address,base,offset);
}

let integers = std::schedule::integer_rules(dialects::builtin, dialects::builtin::ConstantLike<1>, {
    binary: EqSatBinaryKind,
    flag_field: EqSatFlagField,
    result: EqSatIntegerResult,
    operand: EqSatIntegerOperand,
    folded: EqSatFolded,
    constant_kind: EqSatConstantImplementation,
    flag_value: EqSatFlag,
    constant: EqSatConstant,
    attribute: ir::Attribute,
    attr_int: eqsat_attr_int,
    attr_case: eqsat_attr_case,
    pick_case: eqsat_pick_case,
    bool_bit: eqsat_bool_bit,
    shift_amount: eqsat_shift_amount,
});

let global = Schedule::Repeat(64, (
    scalars, integer_inputs, commute, congruence, known_bits,
    shift_bits, integer, strength, casts, cast_cse,
    extraction, modular, integer_shapes, defined_integer, guarded_cancel,
    complements, memory, read_state, pointer_cells, memory_join,
    memory_siblings, switch_inputs, loops, invariant_ports, floating_point,
    fp_keys, fp_congruence, layout_values, layout_pointer, address_keys,
    integers.fold,
));

pub let analyze = sequence((
    Schedule::Rules(flag_values),
    Schedule::Repeat(4, memory_barriers),
    Schedule::Rules(gamma_witness),
    Schedule::Rules(gamma_missing),
    Schedule::Rules(gamma_agrees),
    global,
    Schedule::Repeat(4, incoming),
    Schedule::Rules(phi_candidates),
    Schedule::Rules(phi_disagreement),
    Schedule::Rules(phi_literals),
    Schedule::Rules(memory_cfg),
    Schedule::Rules(memory_cfg_missing),
    Schedule::Rules(memory_cfg_apply),
    Schedule::Rules(memory_join_missing),
    Schedule::Rules(memory_join_apply),
    global,
    Schedule::Repeat(4, removable),
    Schedule::Repeat(8, plain_access),
    Schedule::Rules(plain_disjoint),
    Schedule::Rules(private_call),
    Schedule::Rules(plain_clobber),
    Schedule::Rules(safe_control_inputs),
    Schedule::Rules(control_effects),
    Schedule::Repeat(2, finite_loops),
    Schedule::Repeat(4, switch_cases),
    Schedule::Rules(switch_default),
    Schedule::Rules(pure_switch),
    Schedule::Rules(switch_values),
    Schedule::Rules(switch_agreement),
    Schedule::Rules(switch_aliases),
    Schedule::Rules(plain_forward),
    Schedule::Rules(dead_store_proof),
    Schedule::Rules(dead_store_uses),
    Schedule::Rules(dead_store),
    Schedule::Repeat(64, paths),
    Schedule::Repeat(4, counted_exits),
    Schedule::Rules(counted_missing),
    Schedule::Rules(counted_agrees),
    Schedule::Rules(counted_reads),
    Schedule::Repeat(64, paths),
    Schedule::Rules(used),
    Schedule::Repeat(4, edits),
    Schedule::Rules(phi_uses),
    Schedule::Rules(definition_constants),
    Schedule::Rules(definition_expressions),
));

pub let prepare = sequence((
    Schedule::Saturate(select),
    Schedule::Rules(integers.flags),
    frame,
    sites,
    Schedule::Repeat(4, layout_queries),
));

pub let sweep = sequence((
    Schedule::Rules(congruence),
    Schedule::Repeat(4, scalars),
    Schedule::Repeat(4, cast_cse),
    Schedule::Repeat(8, removable),
    Schedule::Repeat(2, integer_inputs),
    Schedule::Rules(integers.fold),
    Schedule::Saturate(address_keys),
    Schedule::Repeat(8, plain_access),
    Schedule::Saturate(storage_defined),
    Schedule::Rules(private_layout),
    Schedule::Rules(private_extent),
    Schedule::Repeat(8, private_store),
    Schedule::Rules(private_other),
    Schedule::Rules(private_drop),
    Schedule::Rules(plain_overwrites),
    Schedule::Rules(overwrite_barriers),
    Schedule::Rules(overwrite_plain),
    Schedule::Rules(safe_control_inputs),
    Schedule::Rules(control_effects),
    Schedule::Rules(pure_switch),
    Schedule::Saturate(demand),
    Schedule::Rules(dead),
));

pub let seed_assumptions = sequence((
    Schedule::Rules(incoming),
    Schedule::Repeat(64, assumptions),
));
pub let propagate_scoped = std::schedule::repeat_colored(8, branch_local);
