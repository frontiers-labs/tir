// ── Modular Rule Submodules ──────────────────────────────────────────────────

pub mod bits;
pub mod context;
pub mod fp;
pub mod integer;
pub mod layout;
pub mod loops;
pub mod memory;
pub mod rewrites;
pub mod schedule;

// ── Memoized Known-Zeros Analysis ────────────────────────────────────────────

pub let known_zeros = memo || {
    (
        Schedule::Saturate(append(bits::known_bits, bits::shift_bits)),
        { eq_sat_zeros: "EqSatZeros" },
    )
};

// ── Exported Standalone Rewrite Collections ──────────────────────────────────

pub let add_zero_rewrites = || -> List<Rewrite> { rewrites::add_zero_list };
pub let builtin_rewrites = || -> List<Rewrite> { rewrites::builtin_list };

// ── Equality Saturation Pass Drivers (Pure CDSL!) ────────────────────────────

// Higher-order compile-time EqSat driver parameterized by any `List<Rewrite>`.
// NbE specializes each instantiation directly into a static TEGG schedule.
let eqsat_driver = |
    session: Session,
    root: OperationId,
    rules: List<Rewrite>,
    extras: RuleSlice,
| -> EditSummary {
    let analyze = schedule::build_analyze(rules);
    seed_root(session, root);
    run_stage(session, schedule::prepare_stage);
    resolve_layouts(session);
    saturate_with_masks(session, analyze, "eqsat::global", extras, schedule::apply_masks_stage);
    run_stage(session, schedule::seed_assumptions_stage);
    propagate_scoped(session, schedule::propagate_scoped_stage);
    publish_rewrites(session);
    sweep_dead(session, root, schedule::prepare_stage, schedule::sweep_stage)
};

// Built-in EqSat pass (all algebraic/cast/fp/pointer rewrites + optional extras).
pub let run_builtin_eqsat = |
    session: Session,
    root: OperationId,
    extras: RuleSlice,
| -> EditSummary {
    eqsat_driver(session, root, rewrites::algebraic_rewrites, extras)
};

// Custom ruleset EqSat pass (exclusive user-supplied `RuleCollection`).
pub let run_custom_eqsat = |
    session: Session,
    root: OperationId,
    rules: RuleCollection,
| -> EditSummary {
    seed_root(session, root);
    run_stage(session, schedule::prepare_custom_stage);
    run_collection(session, rules, 64);
    run_stage(session, schedule::publish_aliases_stage);
    publish_rewrites(session)
};
