pub enum Scalar {
    Read(Int, std::ir::ValueId),
    Literal(Int, BigInt),
    Binary(std::ir::BinaryIntegerOperation, Int, Scalar, Scalar),
    Compare(String, Int, Scalar, Scalar),
}

pub enum Form {
    Read(std::ir::IntegerRef),
    Bits(BigInt),
    Bin(std::ir::BinaryIntegerOperation, Form, Form),
}

pub enum UseOwner {
    Operand(std::ir::OperationId),
    Yield(Int),
}

