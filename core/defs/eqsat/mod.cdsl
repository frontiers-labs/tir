// EqSat Equality Saturation Pass — flat `Color::BASE` CDSL v3 e-graph.
//
// Single unified `Expr` e-graph covering:
// - Pure arithmetic, bitwise, cast, FP, and pointer expressions + `KnownZeros` lattice
// - Zero-color branch-scoped refinement via SSI `Expr::Pi(scope, expr)`
// - RVSDG state-threaded memory via McCarthy `Store`/`LoadVal`/`LoadState`
// - RVSDG structured control flow via Peggy `Gamma2`/`StateGamma2`/`Theta`
// Extracted in one `Color::BASE` pass via `tir_egglog::TreeExtractor` + `OpCostModel`.

use std::core::*;
use std::ir::{
    EditSummary, OperationId, OperationKind, RuleCollection, RuleSlice, Session, ValueId,
    publish_rewrites, resolve_layouts, run_collection, run_stage, saturate, seed_root,
};

// ── Unified `Expr` E-Graph Sort (Flat `Color::BASE`, Zero `Color` Overlays) ──

pub enum Expr {
    Var(ValueId),
    Const(Int, BigInt),
    CustomConst(OperationKind, String, BigInt),
    Unary(OperationKind, Int, Expr),
    Bin(OperationKind, Int, Expr, Expr),
    Compare(String, Int, Expr, Expr),
    Pi(Int, Expr),
    Store(Expr, Expr, Int, Expr),
    LoadVal(Expr, Expr, Int),
    LoadState(Expr, Expr, Int),
    Gamma2(Expr, Expr, Expr),
    StateGamma2(Expr, Expr, Expr),
    LoadGamma(Expr, Expr),
}

pub enum UseOwner {
    Operand(OperationId),
    Yield(Int),
}

// ── Host Attribute & Folding Primitives ──────────────────────────────────────

pub let eqsat_attr_case: Int -> String;
pub let eqsat_attr_bool: Int -> Bool;
pub let eqsat_shift_amount: BigInt -> Int;
pub let eqsat_attr_int: Int -> BigInt;
pub let eqsat_bool_bit: Bool -> BigInt;
pub let eqsat_pick_case: (String, String, Bool, Bool) -> Bool;

let bigint_or: (BigInt, BigInt) -> BigInt;
extract egglog bigint_or => "bit_or";

// ── Core `Expr` E-Graph Schema ───────────────────────────────────────────────

pub let ValExpr: Table<ValueId, Expr, Merge::Union>;
pub let OpExpr: Table<(OperationId, Int), Expr, Merge::Union>;
pub let ExprLifted: Relation<(ValueId,)>;
pub let EqSatLiftedOp: Relation<(OperationId,)>;
pub let ExprDefined: Relation<(Expr,)>;
pub let KnownZeros: Table<Expr, BigInt, Merge::With(bigint_or)>;
