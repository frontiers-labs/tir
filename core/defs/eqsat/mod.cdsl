// EqSat Equality Saturation Pass — pure CDSL v3.
//
// Defines the pass schema, memoized known-zeros analysis, algebraic rewrite
// collections, and the top-level CDSL pass drivers (`run_builtin_eqsat`,
// `run_custom_eqsat`) compiled directly into static TEGG bytecode + Rust.

use std::core::*;
use std::ir::{
    EditSummary, OperationId, OperationKind, RuleCollection, RuleSlice, Session, ValueId,
    propagate_scoped, publish_rewrites, resolve_layouts, run_collection, run_stage,
    saturate_with_masks, seed_root, sweep_dead,
};

// ── E-Graph Value Sorts ──────────────────────────────────────────────────────

pub enum Scalar {
    Read(Int, ValueId),
    Literal(Int, BigInt),
    Binary(OperationKind, Int, Scalar, Scalar),
    Compare(String, Int, Scalar, Scalar),
}

pub enum Form {
    Read(ValueId),
    Bits(BigInt),
    Bin(OperationKind, Form, Form),
    Constant(OperationKind, String, BigInt),
}

pub enum UseOwner {
    Operand(OperationId),
    Yield(Int),
}

// ── Host Attribute & Folding Primitives ──────────────────────────────────────

pub let eqsat_attr_case: Int -> String;
pub let eqsat_attr_bool: Int -> Bool;
pub let eqsat_shift_amount: BigInt -> Int;
pub let eqsat_attr_int: Int -> BigInt;
pub let eqsat_bool_bit: Bool -> BigInt;
pub let eqsat_pick_case: (String, String, Bool, Bool) -> Bool;

