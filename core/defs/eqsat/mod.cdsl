use std::bigint::BigInt;

mod bits;
mod context;
mod integer;
mod memory;
mod loops;
mod fp;
mod layout;
mod schedule;
mod rewrites;

pub use bits::*;
pub use context::*;
pub use integer::*;
pub use memory::*;
pub use loops::*;
pub use fp::*;
pub use layout::*;
pub use schedule::*;
pub use rewrites::*;

pub enum Scalar {
    Read(Int, std::ir::ValueId),
    Literal(Int, BigInt),
    Binary(std::ir::BinaryIntegerOperation, Int, Scalar, Scalar),
    Compare(String, Int, Scalar, Scalar),
}

pub enum Form {
    Read(std::ir::IntegerRef),
    Bits(BigInt),
    Bin(std::ir::BinaryIntegerOperation, Form, Form),
    Constant(std::ir::OperationKind, String, BigInt),
}

pub enum UseOwner {
    Operand(std::ir::OperationId),
    Yield(Int),
}

pub let eqsat_attr_case: Int -> String;
pub let eqsat_attr_bool: Int -> Bool;
pub let eqsat_shift_amount: BigInt -> Int;
pub let eqsat_attr_int: Int -> BigInt;
let eqsat_bool_bit: Bool -> BigInt;
let eqsat_pick_case: (String, String, Bool, Bool) -> Bool;


// Kept separate from the main program so the consumer binds the completed
// function-local table instead of creating a named analysis table.
pub mod masks {
    let redundant_mask<owner, out, ty, input, mask, home, a, b, kept, zero, all>:
        (EqSatBinary(owner, dialects::builtin::andi.typed_kind, out, ty, input, mask, home),
         EqSatScalar(input, ty, a), EqSatScalar(mask, ty, b), b == Scalar::Literal(ty, kept),
         EqSatZeros(a, ty, zero), EqSatAllBits(ty, all),
         std::bigint::bit_or(kept, zero) == all)
        -> integer::EqSatIdentity(owner, out, input);

    pub let apply = || { std::schedule::Schedule::Rules(redundant_mask) };
}
