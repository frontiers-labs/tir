// Scalar e-graph lifting, known-zero bits, commutativity, and congruence.
//
// Commutative and pure-binary classifications are derived automatically from
// `dialects::builtin::all_ops` via `OpDef` interface introspection!

use std::core::*;
use std::bigint::*;
use std::int::*;
use std::ir::{dialect_commute_rules, dialect_pure_binary_rules};
use dialects::builtin;

pub let scalars_integer: List<Rule> = {
    let integer<ty, ctor, args, decl, default>: Rule(
        (TypeTerm(ty, ctor, args), TypeCtor(ctor, "builtin", "i", decl, default))
        -> EqSatInteger(ty)
    );
    List(integer)
};

pub let scalars: List<Rule> = {
    let integer<ty, ctor, args, decl, default>: Rule(
        (TypeTerm(ty, ctor, args), TypeCtor(ctor, "builtin", "i", decl, default))
        -> EqSatInteger(ty)
    );
    let binary<node, kind, place, home, pos, disp, loc, out, ty, d, x, y, xd, xo, xi, xt, yd, yo, yi, yt>: Rule(
        (
            EqSatLive(node), EqSatBinaryKind(kind),
            Operation(node, kind, place, home, pos, disp, loc),
            Operand(node, 0, x), Operand(node, 1, y),
            Value(out, ty, "result", node, 0, d), EqSatInteger(ty),
            Value(x, ty, xd, xo, xi, xt), Value(y, ty, yd, yo, yi, yt),
        ) -> EqSatBinary(node, kind, out, ty, x, y, home)
    );
    let used<node, slot, value>: Rule((EqSatLive(node), Operand(node, slot, value)) -> EqSatNeeded(value));
    let defined<value, ty, node, slot, declared>: Rule((EqSatLive(node), Value(value, ty, "result", node, slot, declared)) -> EqSatNeeded(value));
    let forwarded<node, region, slot, port, init>: Rule(EqSatPort(node, region, slot, port, init) -> EqSatNeeded(port));
    let read<value, ty, kind, owner, slot, declared>: Rule((EqSatNeeded(value), Value(value, ty, kind, owner, slot, declared), EqSatInteger(ty)) -> EqSatScalar(value, ty, Scalar::Read(ty, value)));
    let literal<value, ty, bits, term>: Rule((EqSatScalar(value, ty, term), EqSatFolded(value, bits)) -> term == Scalar::Literal(ty, bits));
    let evaluated<value, ty, term, bits>: Rule((EqSatScalar(value, ty, term), term == Scalar::Literal(ty, bits)) -> EqSatFolded(value, bits));
    let mask<ty, ctor, args, w>: Rule((EqSatInteger(ty), TypeTerm(ty, ctor, args), w == integer_width(args)) -> EqSatAllBits(ty, (shl(bigint(1), w) - bigint(1))));
    List(integer, binary, used, defined, forwarded, read, literal, evaluated, mask)
};

pub let congruence: List<Rule> = {
    let pure<owner, kind, out, ty, x, y, home>: Rule((EqSatBinary(owner, kind, out, ty, x, y, home), EqSatPureBinary(kind)) -> EqSatBinaryKey(owner));
    let add<owner>: Rule(EqSatWrappingAdd(owner) -> EqSatBinaryKey(owner));
    let sub<owner>: Rule(EqSatWrappingSub(owner) -> EqSatBinaryKey(owner));
    let node<owner, kind, out, ty, x, y, home, t, a, b>: Rule(
        (
            EqSatBinary(owner, kind, out, ty, x, y, home), EqSatBinaryKey(owner),
            EqSatScalar(out, ty, t), EqSatScalar(x, ty, a), EqSatScalar(y, ty, b),
        ) -> t == Scalar::Binary(kind, ty, a, b)
    );
    let comparison<node, out, ty, lhs, rhs, width, a, b, result, attr, pred, pl, hm, pos, dp, lc, decl>: Rule(
        (
            EqSatLive(node),
            Operation(node, builtin::cmpi.kind, pl, hm, pos, dp, lc),
            Operand(node, 0, lhs), Operand(node, 1, rhs),
            Value(out, ty, "result", node, 0, decl),
            EqSatScalar(out, ty, result),
            EqSatScalar(lhs, width, a), EqSatScalar(rhs, width, b),
            Attribute("operation", node, "predicate", attr),
            pred == eqsat_attr_case(attr),
        ) -> result == Scalar::Compare(pred, ty, a, b)
    );
    append(dialect_pure_binary_rules(builtin::all_ops), List(pure, add, sub, node, comparison))
};

pub let known_bits: List<Rule> = {
    let constant<value, ty, bits, term, width>: Rule((EqSatScalar(value, ty, term), term == Scalar::Literal(ty, bits), EqSatAllBits(ty, width)) -> EqSatZeros(term, ty, bit_and(bit_not(bits), width)));
    let and_left<ty, a, b, zeros, expr>: Rule((expr == Scalar::Binary(builtin::andi.kind, ty, a, b), EqSatZeros(a, ty, zeros)) -> EqSatZeros(expr, ty, zeros));
    let and_right<ty, a, b, zeros, expr>: Rule((expr == Scalar::Binary(builtin::andi.kind, ty, a, b), EqSatZeros(b, ty, zeros)) -> EqSatZeros(expr, ty, zeros));
    let or_both<ty, a, b, x, y, expr>: Rule((expr == Scalar::Binary(builtin::ori.kind, ty, a, b), EqSatZeros(a, ty, x), EqSatZeros(b, ty, y)) -> EqSatZeros(expr, ty, bit_and(x, y)));
    List(constant, and_left, and_right, or_both)
};

pub let redundant_masks: List<Rule> = {
    let redundant_mask<owner, out, ty, input, mask, home, a, b, kept, zero, all>: Rule(
        (
            EqSatBinary(owner, builtin::andi.kind, out, ty, input, mask, home),
            EqSatScalar(input, ty, a),
            EqSatScalar(mask, ty, b),
            b == Scalar::Literal(ty, kept),
            EqSatZeros(a, ty, zero),
            EqSatAllBits(ty, all),
            bit_or(kept, zero) == all,
        ) -> EqSatIdentity(owner, out, input)
    );
    List(redundant_mask)
};

pub let commute: List<Rule> = {
    let swap<node, kind, value, ty, x, y, home>: Rule(
        (EqSatBinary(node, kind, value, ty, x, y, home), EqSatCommutative(kind))
        -> EqSatBinary(node, kind, value, ty, y, x, home)
    );
    append(dialect_commute_rules(builtin::all_ops), List(swap))
};

pub let shift_bits: List<Rule> = {
    let left_zeroes<node, value, ty, x, y, home, shift, amount, term, ctor, args, width>: Rule(
        (
            EqSatBinary(node, builtin::shli.kind, value, ty, x, y, home), EqSatFolded(y, shift),
            EqSatScalar(value, ty, term), TypeTerm(ty, ctor, args), width == integer_width(args),
            amount == eqsat_shift_amount(shift), less(amount, width) == true,
        ) -> EqSatZeros(term, ty, (shl(bigint(1), amount) - bigint(1)))
    );
    List(left_zeroes)
};

pub let integer_inputs: List<Rule> = {
    let width<ty, ctor, args, bits>: Rule((EqSatInteger(ty), TypeTerm(ty, ctor, args), bits == integer_width(args)) -> EqSatIntegerWidth(ty, bits));
    let result<node, kind, place, home, pos, display, loc, out, ty, decl, bits>: Rule(
        (
            EqSatLive(node), !EqSatPinnedOp(node), Operation(node, kind, place, home, pos, display, loc),
            Value(out, ty, "result", node, 0, decl), EqSatIntegerWidth(ty, bits),
        ) -> EqSatIntegerResult(node, kind, out, bits)
    );
    let operand<node, slot, input, ty, kind, owner, index, decl, bits>: Rule(
        (
            EqSatLive(node), Operand(node, slot, input), Value(input, ty, kind, owner, index, decl),
            EqSatIntegerWidth(ty, bits),
        ) -> EqSatIntegerOperand(node, slot, input, bits)
    );
    List(width, result, operand)
};

pub let flag_values: List<Rule> = {
    let present<node, name, default, attr, value>: Rule(
        (EqSatLive(node), EqSatFlagField(name, default), Attribute("operation", node, name, attr), value == eqsat_attr_bool(attr))
        -> EqSatFlag(node, name, default, value)
    );
    let absent<node, name, default>: Rule(
        (EqSatLive(node), EqSatFlagField(name, default), !EqSatHasAttr(node, name))
        -> EqSatFlag(node, name, default, default)
    );
    List(present, absent)
};

extract rust scalars_integer => "@ct";
extract rust scalars         => "@ct";
extract rust congruence      => "@ct";
extract rust known_bits      => "@ct";
extract rust redundant_masks => "@ct";
extract rust commute         => "@ct";
extract rust shift_bits      => "@ct";
extract rust integer_inputs  => "@ct";
extract rust flag_values     => "@ct";
