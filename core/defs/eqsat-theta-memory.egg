(relation EQTCell (i64 i64 i64 TypeExpr))
(relation EQTScope (i64 i64))
(relation EQTEntry (i64 i64))
(relation EQTStore (i64 i64 i64 i64 i64))
(relation EQTLoad (i64 i64 i64 i64 i64))
(relation EQTArm (i64 i64 i64 i64))
(relation EQTFlow (i64 i64))
(relation EQTScalar (i64 i64 i64))
(relation EQTAddressUse (i64 i64 UseSite))
(relation EQTStateUse (i64 i64 i64 UseSite))
(relation EQTBlocked (i64))
(relation EQTElide (i64 i64))
(relation EQTRetype (i64 i64 TypeExpr))
(relation EQTOperand (i64 i64 i64 i64))
(relation EQTYield (i64 i64 i64 i64))
(relation EQTTheta (i64 i64 i64 i64 i64 i64 i64 i64))
(relation EQTGammaPort (i64 i64 i64 i64 i64 i64 i64))
(relation EQTArmPort (i64 i64 i64 i64 i64))
(relation EQTCarrier (i64 i64))
(relation EQTDataDemand (i64 i64))
(relation EQTDataAlias (i64 i64 i64))
(relation EQTValue (i64 i64 i64))
(relation EQTPair (i64 i64 i64))
(relation EQTPort (i64 i64 i64 i64 i64))
(relation EQTKeepValue (i64 i64))
(relation EQTGroupAccess (i64 i64))

(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= (OpPlacement allocation) (InGraph region)) (= root (RegionOwner region)) (Function root)
       (Result allocation 0 pointer) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (= (ValueType pointer) (Apply (Ctor "ptr.p") (TCons ty (TNil))))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (EQCellWidth width bytes)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 bytes))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment))
      ((EQTCell allocation pointer region ty) (EQTScope allocation region)) :ruleset EQscalar-scope)
(rule ((EQTCell a pointer region ty) (= (OpKind op) "state.entry_state")
       (= (OpPlacement op) (InGraph region)) (Result op 0 state)
       (= (ValueType state) (Apply (Ctor "builtin.state") (TCons (SymbolParam resource) (TNil))))
       (= (SymbolName resource) "memory"))
      ((EQTEntry a state) (EQTFlow a state)) :ruleset EQscalar-check)
(rule ((EQTCell a pointer outer ty) (EQTScope a region)
       (= (OpPlacement store) (InGraph region)) (= (OpKind store) "ptr.store")
       (= value (Operand store 0)) (= pointer (Operand store 1)) (= before (Operand store 2))
       (not (Operand store 3 extra)) (Result store 0 after) (not (Result store 1 extra))
       (= ty (ValueType value)) (not (OwnedRegion store slot child))
       (= (Attribute store "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil)))))))
      ((EQTStore a store before after value) (EQTAddressUse a store (OperandUse 1))
       (EQTStateUse a before store (OperandUse 2))) :ruleset EQscalar-check)
(rule ((EQTCell a pointer outer ty) (EQTScope a region)
       (= (OpPlacement load) (InGraph region)) (= (OpKind load) "ptr.load")
       (= pointer (Operand load 0)) (= before (Operand load 1)) (not (Operand load 2 extra))
       (Result load 0 value) (Result load 1 after) (not (Result load 2 extra))
       (= ty (ValueType value)) (not (OwnedRegion load slot child))
       (= (Attribute load "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil))))))
      ((EQTLoad a load before after value) (EQTAddressUse a load (OperandUse 0))
       (EQTStateUse a before load (OperandUse 1))) :ruleset EQscalar-check)

(rule ((EQTLoad a load before after value) (EQTScalar a before scalar) (!= value scalar))
      ((EQTDataAlias a value scalar)) :ruleset EQscalar-check)
(rule ((EQTScalar a state value) (not (EQTDataAlias a value other)))
      ((EQTValue a value value)) :ruleset EQassumptions)
(rule ((EQTDataAlias a value middle) (not (EQTDataAlias a middle next)))
      ((EQTValue a value middle)) :ruleset EQassumptions)
(rule ((EQTDataAlias a value middle) (EQTValue a middle resolved))
      ((EQTValue a value resolved)) :ruleset EQassumptions)
(rule ((EQTDataDemand a value) (EQTDataAlias a value scalar))
      ((EQTDataDemand a scalar)) :ruleset EQscalar-check)

(rule ((EQTCell a pointer outer ty) (EQTScope a outer)
       (= (OpPlacement theta) (InGraph outer)) (Theta theta) (= (OpKind theta) "scf.loop")
       (= body (ThetaBody theta)) (= (Mode body) (Graph))
       (RegionParam body port local) (= input (EntryBinding body port))
       (= feedback_index (FeedbackBinding body port)) (= exit_index (ExitBinding body result))
       (EntryValue body port before) (= before (Operand theta input)) (Result theta result after)
       (= state_ty (ValueType before)) (= state_ty (ValueType local)) (= state_ty (ValueType after))
       (= state_ty (Apply (Ctor "builtin.state") (TCons (SymbolParam resource) (TNil))))
       (= (SymbolName resource) "memory"))
      ((EQTTheta a theta body before local after port result) (EQTScope a body)
       (EQTStateUse a before theta (OperandUse input))) :ruleset EQscalar-check)
(rule ((EQTCell a pointer outer ty) (EQTScope a region)
       (= (OpPlacement gamma) (InGraph region)) (Gamma gamma) (= (OpKind gamma) "scf.switch")
       (= before (Operand gamma input)) (Result gamma result after)
       (= state_ty (ValueType before)) (= state_ty (ValueType after))
       (= state_ty (Apply (Ctor "builtin.state") (TCons (SymbolParam resource) (TNil))))
       (= (SymbolName resource) "memory"))
      ((EQTGammaPort a gamma before after region input result) (EQTStateUse a before gamma (OperandUse input))) :ruleset EQscalar-check)
(rule ((EQTGammaPort a gamma before after region input result) (= arm (OwnedRegion gamma slot))
       (= (Mode arm) (Graph)) (RegionParam arm port local)
       (= (EntryBinding arm port) input) (= yield (ExitBinding arm result))
       (EntryValue arm port before) (ExitValue arm result exit)
       (= (ValueType local) (ValueType before)) (= (ValueType exit) (ValueType before))
       (not (FeedbackBinding arm slot2 feedback)))
      ((EQTArm a gamma arm local) (EQTArmPort a gamma arm result yield)
       (EQTScope a arm) (EQTStateUse a exit gamma (YieldUse arm yield))) :ruleset EQscalar-check)
(rule ((EQTStore a store before after value) (EQTFlow a before))
      ((EQTFlow a after) (EQTScalar a after value)) :ruleset EQscalar-check)
(rule ((EQTTheta a theta body before local after port result) (EQTScalar a before scalar)
       (EQTPort a theta local_data result_data slot))
      ((EQTFlow a local) (EQTScalar a local local_data)
       (EQTFlow a after) (EQTScalar a after result_data)) :ruleset EQscalar-check)
(rule ((EQTTheta a theta body before local after port result) (FeedbackValue body port state)
       (= feedback_index (FeedbackBinding body port)))
      ((EQTStateUse a state theta (YieldUse body feedback_index))) :ruleset EQscalar-check)
(rule ((EQTTheta a theta body before local after port result) (ExitValue body result state)
       (= exit_index (ExitBinding body result)))
      ((EQTStateUse a state theta (YieldUse body exit_index))) :ruleset EQscalar-check)
(rule ((EQTGammaPort a gamma before after region input result) (EQTScalar a before scalar)
       (EQTPort a gamma local_data result_data slot))
      ((EQTFlow a after) (EQTScalar a after result_data)) :ruleset EQscalar-check)
(rule ((EQTCell a pointer outer ty) (not (EQTPair outer first second))
       (EQTArm a gamma arm local) (EQTGammaPort a gamma before after region input result) (EQTScalar a before scalar))
      ((EQTFlow a local) (EQTScalar a local local) (EQTCarrier a local)) :ruleset EQscalar-check)
(rule ((EQTLoad a load before after value) (EQTScalar a before scalar))
      ((EQTFlow a after) (EQTScalar a after scalar)) :ruleset EQscalar-check)
(rule ((EQTCell a pointer region ty) (= root (RegionOwner region))
       (= state (Yield region slot)) (EQTFlow a state))
      ((EQTStateUse a state root (YieldUse region slot))) :ruleset EQscalar-check)
(rule ((EQTCell a pointer region ty) (EQTLoad a load before after value)
       (= value (Yield region slot)) (EQTScalar a before scalar))
      ((EQTDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQTDataDemand a after) (EQTTheta a theta body before local after port result)
       (ExitValue body result exit) (EQTScalar a exit scalar))
      ((EQTDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQTDataDemand a after) (EQTTheta a theta body before local after port result)
       (FeedbackValue body port exit) (EQTScalar a exit scalar))
      ((EQTDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQTDataDemand a after) (EQTGammaPort a gamma before after region input result) (EQTArm a gamma arm local) (EQTArmPort a gamma arm result yield)
       (ExitValue arm result exit) (EQTScalar a exit scalar))
      ((EQTDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQTCell a pointer region ty) (Uses pointer op site) (not (EQTAddressUse a op site)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (EQScalarAttrRef attr pointer)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (= attr (Attribute a key)) (!= key "size") (!= key "align"))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTAddressUse a access site) (= attr (Attribute access key)) (!= key "operand_segment_sizes"))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (= root (RegionOwner region)) (= root (OwningFunction op))
       (= (OpKind op) "ptr.alloca") (not (EQTCell op other region ty2))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (= root (RegionOwner region)) (= root (OwningFunction op))
       (HasInterface op "dyn tir::interfaces::ResourceEffects") (not (EQTGroupAccess region op)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (not (EQOrdinaryLayout a)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTAddressUse a access site) (not (EQOrdinaryLayout access)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (EQMalformedLayout a))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTAddressUse a access site) (EQMalformedLayout access))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTStore a store before after value) (not (EQTFlow a before))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTLoad a load before after value) (not (EQTScalar a before scalar))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTFlow a state) (Uses state op site) (not (EQTStateUse a state op site)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTFlow a state) (EQScalarAttrRef attr state)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTLoad a load before after value) (EQScalarAttrRef attr value)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a pointer region ty) (EQTEntry a first) (EQTEntry a second) (!= first second))
      ((EQTBlocked a)) :ruleset EQscopes)


(rule ((EQTTheta a theta body before local after port result) (not (EQTScalar a before scalar))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTTheta a theta body before local after port result) (FeedbackValue body port exit) (not (EQTScalar a exit scalar))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTTheta a theta body before local after port result) (ExitValue body result exit) (not (EQTScalar a exit scalar))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTTheta a theta body before local after port result) (not (EQTDataDemand a after))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTTheta a theta body before local after port result) (= attr (Attribute theta key)) (!= key "operand_segment_sizes")) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result) (not (EQTScalar a before scalar))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result) (= arm (OwnedRegion gamma slot)) (not (EQTArm a gamma arm local))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTArm a gamma arm local) (EQTArmPort a gamma arm result yield) (ExitValue arm result exit) (not (EQTScalar a exit scalar))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result) (not (EQTDataDemand a after))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result) (= attr (Attribute gamma key)) (!= key "operand_segment_sizes")) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCarrier a carrier) (EQScalarAttrRef attr carrier)) ((EQTBlocked a)) :ruleset EQscopes)

(rule ((EQTCell a pointer region ty) (EQSeed region) (EQTTheta a theta body before local after port result) (not (EQTBlocked a)))
      ((EQTElide region a)) :ruleset EQassumptions)
(rule ((EQTElide region a) (EQTStore a store before after value)) ((EQTElide region store)) :ruleset EQassumptions)
(rule ((EQTElide region a) (EQTLoad a load before after value) (EQTScalar a before data)
       (EQTValue a data scalar) (!= value scalar) (= (OpPlacement load) (InGraph local)))
      ((EQTElide region load) (EQExactReplacement local value scalar)) :ruleset EQassumptions)
(rule ((EQTElide region a) (EQTCell a pointer region ty) (EQTCarrier a carrier))
      ((EQTRetype region carrier ty)) :ruleset EQassumptions)
(rule ((EQTElide region a) (not (EQTPair region first second)) (EQTTheta a theta body before local after port result) (= input (EntryBinding body port))
       (EQTScalar a before data) (EQTValue a data scalar))
      ((EQTOperand region theta input scalar)) :ruleset EQassumptions)
(rule ((EQTElide region a) (not (EQTPair region first second)) (EQTTheta a theta body before local after port result) (FeedbackValue body port state)
       (= feedback_index (FeedbackBinding body port)) (EQTScalar a state data) (EQTValue a data scalar))
      ((EQTYield region body feedback_index scalar)) :ruleset EQassumptions)
(rule ((EQTElide region a) (not (EQTPair region first second)) (EQTTheta a theta body before local after port result) (ExitValue body result state)
       (= exit_index (ExitBinding body result)) (EQTScalar a state data) (EQTValue a data scalar))
      ((EQTYield region body exit_index scalar)) :ruleset EQassumptions)
(rule ((EQTElide region a) (not (EQTPair region first second)) (EQTGammaPort a gamma before after outer input result) (EQTScalar a before data) (EQTValue a data scalar))
      ((EQTOperand region gamma input scalar)) :ruleset EQassumptions)
(rule ((EQTElide region a) (not (EQTPair region first second)) (EQTArm a gamma arm local) (EQTArmPort a gamma arm result yield) (ExitValue arm result state) (EQTScalar a state data) (EQTValue a data scalar))
      ((EQTYield region arm yield scalar)) :ruleset EQassumptions)
(rule ((EQTElide region a) (EQTEntry a entry) (= state (Yield region slot)) (EQTFlow a state))
      ((EQTYield region region slot entry)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope op))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope op) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope op) (= attr (Attribute op key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p op key)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope op) (Result op slot value) (not (EQTKeepValue scope value)))
      ((let p (EQProposal invocation root scope root))
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTRetype scope value ty))
      ((let p (EQProposal invocation root scope root)) (EQPutValueType p value ty)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTRetype scope value ty) (= old (DeclaredType value)))
      ((let p (EQProposal invocation root scope root)) (EQPutDeclaredType p value ty)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTOperand scope op slot value))
      ((let p (EQProposal invocation root scope root)) (EQPutOperand p op slot value)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTYield scope region slot value))
      ((let p (EQProposal invocation root scope root)) (EQPutYield p region slot value)) :ruleset EQscoped-edits)


(rule ((EQTStore a first before middle value) (EQTStore a last input after other) (!= first last)
       (OpRegion first region) (OpRegion last region))
      ((EQTBlocked a)) :ruleset EQscopes)

(rule ((EQTStore a store before after value) (EQTEntry a before) (not (EQTotalValue value)))
      ((EQTBlocked a)) :ruleset EQscopes)

(rule ((EQTElide region a) (EQTLoad a load before after value) (EQTScalar a before data)
       (EQTValue a data scalar) (= (OpPlacement load) (InGraph local))
       (Uses value reader site) (OpUnderRegion local reader) (OpRegion reader scope))
      ((EQExactReplacement scope value scalar)) :ruleset EQassumptions)

(rule ((EQTTheta a theta body before local after port result) (= input (EntryBinding body port))
       (= other (Operand theta other_input)) (!= input other_input) (= (ValueType other) (ValueType before)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTTheta a theta body before local after port result)
       (Result theta other_result other) (!= result other_result) (= (ValueType other) (ValueType after)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result)
       (= other (Operand gamma other_input)) (!= input other_input) (= (ValueType other) (ValueType before)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result)
       (Result gamma other_result other) (!= result other_result) (= (ValueType other) (ValueType after)))
      ((EQTBlocked a)) :ruleset EQscopes)
;; A demanded sibling result evaluates every theta exit, including the scalar carrier.
(rule ((EQTCell a pointer region ty)
       (EQTTheta a theta body before local after port result)
       (Result theta other_result value) (!= other_result result) (= value (Yield region slot)))
      ((EQTDataDemand a after)) :ruleset EQscalar-check)

;; A demanded sibling result evaluates every selected gamma exit, including the scalar carrier.
(rule ((EQTCell a pointer region ty)
       (EQTGammaPort a gamma before after region input result)
       (Result gamma other_result value) (!= other_result result) (= value (Yield region slot)))
      ((EQTDataDemand a after)) :ruleset EQscalar-check)
(rule ((EQTCell a pointer region ty) (EQSeed region)
       (EQTGammaPort a gamma before after region input result)
       (Result gamma other_result value) (!= other_result result) (= value (Yield region slot))
       (not (EQTBlocked a)))
      ((EQTElide region a)) :ruleset EQassumptions)

(rule ((EQTCell a p region ty) (EQTCell b q region other) (< a b))
      ((EQTPair region a b)) :ruleset EQscalar-scope)
(rule ((EQTCell a p region ty) (not (EQTPair region x y))
       (EQTTheta a theta body before local after port result))
      ((EQTPort a theta local after port) (EQTCarrier a local) (EQTCarrier a after)) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (not (EQTPair region x y))
       (EQTGammaPort a gamma before after outer input result) (EQTArm a gamma arm local))
      ((EQTPort a gamma local after result) (EQTCarrier a local) (EQTCarrier a after)) :ruleset EQscalar-check)
(rule ((EQTPair region a b) (EQTTheta a theta body before local after 0 0)
       (EQTLoad a load state next data) (OpUnderRegion body load)
       (EQTLoad a final after final_state result) (= (OpPlacement final) (InGraph region)))
      ((EQTPort a theta data result 0)) :ruleset EQscalar-check)
(rule ((EQTPair region a b) (EQTTheta b theta body before local after 0 0)
       (EQTLoad b load state next data) (OpUnderRegion body load))
      ((EQTPort b theta data after 1)) :ruleset EQscalar-check)
(rule ((EQTPair region a b) (EQTPort a theta data result 0)
       (EQTTheta a theta body start local end 0 0)
       (EQTGammaPort a gamma before after body input result_slot))
      ((EQTPort a gamma data after 1)) :ruleset EQscalar-check)
(rule ((EQTPair region a b) (EQTPort b theta data result 1)
       (EQTTheta b theta body start local end 0 0)
       (EQTGammaPort b gamma before after body input result_slot)
       (EQTStore b store state store_result value) (EQTArm b gamma arm arm_local)
       (= (OpPlacement store) (InGraph arm)))
      ((EQTPort b gamma data store_result 2)) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTAddressUse a op site)) ((EQTGroupAccess region op)) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTCell b q region other) (!= a b)
       (EQTLoad b op before after value) (EQTFlow a before))
      ((EQTFlow a after) (EQTStateUse a before op (OperandUse 1))) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTCell b q region other) (!= a b)
       (EQTLoad b op before after value) (EQTScalar a before scalar))
      ((EQTScalar a after scalar)) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTCell b q region other) (!= a b)
       (EQTStore b op before after value) (EQTFlow a before))
      ((EQTFlow a after) (EQTStateUse a before op (OperandUse 2))) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTCell b q region other) (!= a b)
       (EQTStore b op before after value) (EQTScalar a before scalar))
      ((EQTScalar a after scalar)) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTCell b q region other) (EQTBlocked b)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTPair region a b) (EQTCell c p region ty) (!= c a) (!= c b)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTTheta a theta body before local after port result) (not (EQTPort a theta x y slot))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTGammaPort a gamma before after region input result) (not (EQTPort a gamma x y slot))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p region ty) (EQTPair region x y) (EQTPort a op local result slot) (EQTPort a op other extra port) (!= local other)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p region ty) (EQTPair region x y) (EQTPort a op local result slot) (EQTPort a op other extra port) (!= result extra)) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTPair region a b) (EQTStore a store before after value) (= (OpPlacement store) (InGraph region)) (not (EQTotalValue value))) ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTPair region a b) (EQTStore b store before after value) (= (OpPlacement store) (InGraph region)) (not (EQTotalValue value))) ((EQTBlocked b)) :ruleset EQscopes)
(rule ((EQTCell a p region ty) (EQTPair region x y) (EQTTheta a theta body before local after port result) (EQTLoad x load after next value) (= value (Yield region slot)))
      ((EQTDataDemand a after)) :ruleset EQscalar-check)
(rule ((EQTCell a p region ty) (EQTPair region x y) (EQTGammaPort a gamma before after outer input result))
      ((EQTDataDemand a after)) :ruleset EQscalar-check)
(rule ((EQTElide region a) (EQTPair region x y) (EQTLoad a load before after value)) ((EQTElide region load)) :ruleset EQassumptions)
(rule ((EQTElide region a) (EQTPort a op local result slot)) ((EQTKeepValue region local) (EQTKeepValue region result)) :ruleset EQassumptions)

(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTTheta a theta body before oldlocal after port result) (EQTPort a theta local output slot)
       (EQTCell a pointer scope ty) (EQTScalar a before data) (EQTValue a data scalar))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQPutValueDefinition p local (RegionParamDef body slot)) (EQPutValueType p local ty) (EQPutDeclaredType p local ty)
       (EQPutValueDefinition p output (ResultDef theta slot)) (EQPutValueType p output ty)
       (EQPutOperand p theta slot scalar) (EQPutEntryBinding p body slot slot)
       (EQPutFeedbackBinding p body slot (+ 3 slot)) (EQPutExitBinding p body slot (+ 1 slot))
       (EQEraseValueDefinition p oldlocal) (EQEraseValueType p oldlocal) (EQEraseDeclaredType p oldlocal)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTTheta a theta body before oldlocal after port result) (EQTPort a theta local output slot)
       (FeedbackValue body port exit) (EQTScalar a exit data) (EQTValue a data scalar))
      ((let p (EQProposal invocation root scope root)) (EQPutYield p body (+ 3 slot) scalar)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTTheta a theta body before oldlocal after port result) (EQTPort a theta local output slot)
       (ExitValue body result exit) (EQTScalar a exit data) (EQTValue a data scalar))
      ((let p (EQProposal invocation root scope root)) (EQPutYield p body (+ 1 slot) scalar)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTGammaPort a gamma before after outer input result) (EQTPort a gamma local output slot)
       (EQTCell a pointer scope ty))
      ((let p (EQProposal invocation root scope root)) (EQPutValueDefinition p output (ResultDef gamma slot))
       (EQPutValueType p output ty) (EQEraseOperand p gamma input)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTArm a gamma arm local) (EQTArmPort a gamma arm result yield) (EQTPort a gamma param output slot)
       (ExitValue arm result exit) (EQTScalar a exit data) (EQTValue a data scalar))
      ((let p (EQProposal invocation root scope root)) (EQPutYield p arm slot scalar)
       (EQPutExitBinding p arm slot slot) (EQEraseEntryBinding p arm 0)
       (EQEraseValueDefinition p local) (EQEraseValueType p local) (EQEraseDeclaredType p local)) :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTTheta a theta body before local after port result))
      ((let p (EQProposal invocation root scope root))
       (EQPutAttribute p theta "operand_segment_sizes" (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000002") (ANil))))) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQTElide scope a) (EQTPair scope x y)
       (EQTGammaPort a gamma before after outer input result))
      ((let p (EQProposal invocation root scope root))
       (EQPutAttribute p gamma "operand_segment_sizes" (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))) :ruleset EQscoped-edits)

(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTTheta a theta body before local after port result) (= extra (Operand theta 1)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTTheta a theta body before local after port result) (Result theta 1 extra))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTTheta a theta body before local after port result) (RegionParam body 1 extra))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTTheta a first body before local after port result)
       (EQTTheta a second child input param output p2 r2) (!= first second))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTGammaPort a first before after region input result)
       (EQTGammaPort a second start end outer input2 result2) (!= first second))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTGammaPort a gamma before after region input result) (!= input 1))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTGammaPort a gamma before after region input result) (!= result 1))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTGammaPort a gamma before after region input result) (= extra (Operand gamma 2)))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTGammaPort a gamma before after region input result) (Result gamma 2 extra))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTArm a gamma arm local) (RegionParam arm 1 extra))
      ((EQTBlocked a)) :ruleset EQscopes)
(rule ((EQTCell a p scope ty) (EQTPair scope x y)
       (EQTArm a gamma arm local) (= extra (Yield arm 2)))
      ((EQTBlocked a)) :ruleset EQscopes)

(rule ((EQTCell a pointer outer ty) (EQTPair outer first second)
       (EQTArm a gamma arm local) (EQTGammaPort a gamma before after region input result) (EQTScalar a before scalar)
       (EQTPort a gamma local_data result_data slot))
      ((EQTFlow a local) (EQTScalar a local local_data)) :ruleset EQscalar-check)
