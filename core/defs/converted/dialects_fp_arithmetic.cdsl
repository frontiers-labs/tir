pub let fp::fma<E: Nat, M: Nat, StateResources> = {
    signature: (a: Float<E, M>, b: Float<E, M>, c: Float<E, M>, state: States<StateResources>) -> (result: Float<E, M>, state: States<StateResources>,),
    attributes: { semantics: { ty: AttrFpSemantics, codec: fpsemantics_codec } },
    exec: fma_exec_model<E, M, StateResources>,
