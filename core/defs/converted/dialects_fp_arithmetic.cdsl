pub let fp::sqrt<E: Nat, M: Nat, StateResources> = {
    signature: (input: Float<E, M>, state: States<StateResources>) -> (result: Float<E, M>, state: States<StateResources>,),
    attributes: { semantics: { ty: AttrFpSemantics, codec: fpsemantics_codec } },
    exec: sqrt_exec_model<E, M, StateResources>,
