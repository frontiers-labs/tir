pub let constructors::REG: ConstructorSpec = {
    dialect: "backend",
    name: "reg",
    params: [{ name: "target", param: Param::One(Kind::Sym()) }, { name: "class", param: Param::One(Kind::Sym()) }],
    kind: Kind::Data(),
    validate: REG_validate,
    carrier: REG_carrier,
};

pub let spellings::RegClassType: SpellingSpec = {
    ctor_id: RegClassType_ctor_id,
    keys: [],
    parse: RegClassType_parse,
    print: RegClassType_print,
    variadic_tail: false,
