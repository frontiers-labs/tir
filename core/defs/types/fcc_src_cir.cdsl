extern let VA_LIST_carrier: (terms: Terms, args: TypeArgs) -> Carrier;
extern let VaListType_parse: (mnemonic: Mnemonic, parser: Parser, context: Context) -> ParseResult;
extern let VaListType_print: (spellings: Spellings, ty: TypeId, formatter: Formatter) -> PrintResult;
