    ctor_id: VarArgsType_ctor_id,
    keys: ["varargs"],
    parse: VarArgsType_parse,
    print: VarArgsType_print,
    variadic_tail: true,
};

pub let constructors::VA_LIST: ConstructorSpec = {
    dialect: "cir",
