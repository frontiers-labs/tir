    pub let gv_ham_exsel<r, lh, h>: (ActiveHammock(r, lh, h), !analysis::cfg::DagHasIpdom(r, lh, h), analysis::cfg::NatLoopHeader(r, lh), !IsTailLoop(r, lh), analysis::cfg::LoopMultiExit(r, lh)) -> (GuardVar(r, lh, h, (0 - 2)), OrdItem("gv", r, lh, h, 2, (0 - 2)));
    pub let gv_ham_bo<r, s, h, v>: (ActiveHammock(r, s, h), analysis::cfg::BranchOutput(r, s, h, v)) -> (GuardVar(r, s, h, v), OrdItem("gv", r, s, h, (4294967296 + v), v));
    pub let gv_ham_mw<r, s, h, m, v>: (ActiveHammock(r, s, h), analysis::cfg::HammockMember(r, s, h, m), analysis::cfg::BlockVarWrite(r, m, v)) -> (GuardVar(r, s, h, v), OrdItem("gv", r, s, h, (4294967296 + v), v));
    pub let gv_ham_mr<r, s, h, m, v>: (ActiveHammock(r, s, h), analysis::cfg::HammockMember(r, s, h, m), analysis::cfg::BlockLiveIn(r, m, v)) -> (GuardVar(r, s, h, v), OrdItem("gv", r, s, h, (4294967296 + v), v));
    pub let gm_ham<r, s, h, c>: (ActiveHammock(r, s, h), analysis::cfg::BranchReadsMem(r, s, h, c)) -> (GuardMem(r, s, h, c), OrdItem("gm", r, s, h, c, c));

