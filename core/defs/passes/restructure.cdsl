        (analysis::cfg::IrredLoop(r, s, rep), OrdIdx("exit", r, rep, 0, k, x, eidx), OrdCount("gmem", r, s, rep, n)) -> GuardTarget(r, s, rep, x, (n + eidx));

    // Variable types per (r, scope_or_loop, var).
    pub let vs_dag<r, o, e, s, d>: (TargetRegion(r, o, e), analysis::cfg::DagEntry(r, s, d)) -> VarScope(r, s);
