// RVSDG Control Tree Translation pass (Reissmann §5.1.2 Algorithm III) in CDSL/Egglog.
// Reads IR + AnalysisManager tables (core/defs/analysis/cfg.cdsl) and computes the complete
// restructured Nodes region tree, value/state dataflow, switch folding, and emission plan.

use std::bigint::BigInt;

// Symbolic RVSDG sorts.
pub enum Reg {
    Orig(Int),
    LoopBody(Int, Int),
    SeseArm(Int, Int, Int, Int),
    GuardArm(Int, Int, Int, Int, Int),
    StepArm(Int, Int, Int, Int, Int),
}
pub enum Sw {
    Sese(Int, Int, Int),
    Guard(Int, Int, Int, Int),
    Step(Int, Int, Int, Int),
}
pub enum Ty { I1, I32, State, Exact(Int), RetType(Int) }
pub enum Val {
    Orig(Int),
    EntryState(Int),
    SplitState(Int, Int),
    JoinState(Int),
    MemState(Int),
    ForRes(Int, Int),
    ForState(Int, Int),
    ForPort(Int, Int),
    LoopPort(Int, Int, Int),
    LoopRes(Int, Int, Int),
    SesePort(Int, Int, Int, Int, Int),
    SeseRes(Int, Int, Int, Int),
    GuardPort(Int, Int, Int, Int, Int, Int),
    GuardRes(Int, Int, Int, Int, Int),
    StepRes(Int, Int, Int, Int, Int),
    IntConst(Reg, Int, Int),
    Zero(Reg, Ty),
    Not(Reg, Val),
    Cmp(Reg, dialects::builtin::IntegerPredicate, Val, Val),
    Sub(Reg, Val, Val),
}

// Keyed aggregation tables.
pub let OrdNext: std::Table<(String, Int, Int, Int, Int), Int, std::Merge::Min>;
pub let RegDepth: std::Table<Reg, Int, std::Merge::Max>;
pub let SeseDupMin: std::Table<(Int, Int, Int, Int), Int, std::Merge::Min>;


// Generic dense-ordering relations.
pub let OrdItem: (String, Int, Int, Int, Int, Int) -> Prop;
pub let OrdHasPrev: (String, Int, Int, Int, Int) -> Prop;
pub let OrdHasNext: (String, Int, Int, Int, Int) -> Prop;
pub let OrdIdx: (String, Int, Int, Int, Int, Int, Int) -> Prop;
pub let OrdCount: (String, Int, Int, Int, Int) -> Prop;

// Target regions, classification, homes, linear chains.
pub let TargetRegion: (Int, Int, Int) -> Prop;
pub let IsForBody: Int -> Prop;
pub let IsForOp: Int -> Prop;
pub let ForOpInfo: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let ForOrigRes: (Int, Int, Int, Int) -> Prop;
pub let IsTailLoop: (Int, Int) -> Prop;
pub let IsTailLatch: (Int, Int, Int) -> Prop;
pub let ActiveSese: (Int, Int, Int) -> Prop;
pub let ActiveHammock: (Int, Int, Int) -> Prop;
pub let IsLoopDagNode: (Int, Int, Int) -> Prop;
pub let IsCondBranch: (Int, Int, Int) -> Prop;
pub let BranchArm: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let BlockTerm: (Int, Int, Int, std::ir::OperationKind) -> Prop;
pub let BlockIsBr: (Int, Int) -> Prop;
pub let TermOp: Int -> Prop;
pub let TermOperand: (Int, Int, Int) -> Prop;
pub let IsLiveParam: (Int, Int) -> Prop;
pub let LiveEdgeAssign: (Int, Int, Int, Int, Int) -> Prop;
pub let OrigConstBit: (Int, Int) -> Prop;
pub let IsConstBit: (Val, Int) -> Prop;

pub let ScopeBaseReg: (Int, Int, Reg) -> Prop;
pub let NonInnerSese: (Int, Int, Int, Int) -> Prop;
pub let InnerSese: (Int, Int, Int, Int, Int) -> Prop;
pub let NodeInSese: (Int, Int, Int) -> Prop;
pub let NodeInHammock: (Int, Int, Int) -> Prop;
pub let NodeHome: (Int, Int, Int, Reg) -> Prop;
pub let BlockHome: (Int, Int, Reg) -> Prop;
pub let BlockScope: (Int, Int, Int) -> Prop;
pub let LoopHome: (Int, Int, Reg) -> Prop;
pub let GuardHome: (Int, Int, Int, Reg) -> Prop;
pub let StepHome: (Int, Int, Int, Int, Reg) -> Prop;
pub let RegParent: (Reg, Reg) -> Prop;
pub let RegDepthStep: (Reg, Int) -> Prop;
pub let ChildReg: Reg -> Prop;

pub let StructStep: (Int, Int, Int, Int) -> Prop;
pub let HasStructPrev: (Int, Int, Int) -> Prop;
pub let HasStructNext: (Int, Int, Int) -> Prop;
pub let ChainHead: (Reg, Int, Int, Int) -> Prop;
pub let ChainTail: (Reg, Int, Int, Int) -> Prop;
pub let ChainPos: (Reg, Int, Int) -> Prop;
pub let SeseArmHasBody: (Int, Int, Int, Int) -> Prop;

// Variables, types, ports, switches, target codes, static overwrite sets.
pub let TrackedVar: (Int, Int) -> Prop;
pub let VarScope: (Int, Int) -> Prop;
pub let BlockBaseOrder: (Int, Int, Int) -> Prop;
pub let ExitSelTy: (Int, Int, Ty) -> Prop;
pub let ExitSelWidth: (Int, Int, Int) -> Prop;
pub let LoopHasExit: (Int, Int) -> Prop;
pub let VarTy: (Int, Int, Int, Ty) -> Prop;
pub let VarIsI1: (Int, Int, Int) -> Prop;
pub let LoopPortVar: (Int, Int, Int) -> Prop;
pub let LoopExitCount: (Int, Int, Int) -> Prop;
pub let LoopSingleExit: (Int, Int, Int) -> Prop;
pub let SeseOutVar: (Int, Int, Int, Int) -> Prop;
pub let SeseFwdChain: (Int, Int, Int, Int) -> Prop;
pub let GuardVar: (Int, Int, Int, Int) -> Prop;
pub let GuardMem: (Int, Int, Int, Int) -> Prop;
pub let StepSite: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let StepSiteArm: (Int, Int, Int, Int, Int, Int, Int) -> Prop;
pub let StepVar: (Int, Int, Int, Int, Int) -> Prop;
pub let GenLoopTarget: (Int, Int, Int, Int, Int, Int) -> Prop; // r, lh, dst, var, width, const_val
pub let GuardTarget: (Int, Int, Int, Int, Int) -> Prop; // r, s, owner, dst, code
pub let BlockHasMemOp: (Int, Int, Int) -> Prop;
pub let BlockWritesVar: (Int, Int, Int) -> Prop;
pub let BlockEdgeWrites: (Int, Int, Int, Int) -> Prop;
pub let BlockTermSetsCtrl: (Int, Int, Int) -> Prop;
pub let LoopWritesPort: (Int, Int, Int) -> Prop;
pub let LoopSetsOuterCtrl: (Int, Int, Int, Int) -> Prop;
pub let SeseArmSetsCtrl: (Int, Int, Int, Int, Int) -> Prop;
pub let GuardMemberSetsCtrl: (Int, Int, Int, Int, Int) -> Prop;
pub let StepArmSetsCtrl: (Int, Int, Int, Int, Int, Int) -> Prop;

// Value & state dataflow.
pub let ChainInit: (Int, Int, Val) -> Prop;
pub let RegInVal: (Reg, Int, Int, Val) -> Prop;
pub let NodeInVal: (Int, Int, Int, Int, Val) -> Prop;
pub let BlockInVal: (Int, Int, Int, Val) -> Prop;
pub let MemOpInState: (Int, Int, Int, Int, Val) -> Prop;
pub let MemOpOutState: (Int, Int, Int, Int, Val) -> Prop;
pub let BlockOutVal: (Int, Int, Int, Val) -> Prop;
pub let TermReadVal: (Int, Int, Int, Val) -> Prop;
pub let BlockPostBrVal: (Int, Int, Int, Val) -> Prop;
pub let PreBranchVal: (Int, Int, Int, Int, Val) -> Prop;
pub let NodeOutVal: (Int, Int, Int, Int, Val) -> Prop;
pub let SesePredVal: (Int, Int, Int, Val) -> Prop;
pub let SeseArmInVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let SeseArmOutVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let HasSeseArmOutVal: (Int, Int, Int, Int, Int) -> Prop;
pub let GuardStepInVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let GuardTruePreStepVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let GuardTrueOutVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let HasGuardTrueOutVal: (Int, Int, Int, Int, Int) -> Prop;
pub let GuardFalseOutVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let HasGuardFalseOutVal: (Int, Int, Int, Int, Int) -> Prop;
pub let StepPreVal: (Int, Int, Int, Int, Int, Val) -> Prop;
pub let StepPredVal: (Int, Int, Int, Int, Val) -> Prop;
pub let StepArmOutVal: (Int, Int, Int, Int, Int, Int, Val) -> Prop;
pub let HasStepArmOutVal: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let LoopExitSelVal: (Int, Int, Int, Val) -> Prop;
pub let LoopInitVal: (Int, Int, Int, Val) -> Prop;
pub let HasLoopInitVal: (Int, Int, Int) -> Prop;
pub let LoopPredVal: (Int, Int, Val) -> Prop;
pub let HasLoopPredVal: (Int, Int) -> Prop;
pub let LoopContVal: (Int, Int, Int, Val) -> Prop;
pub let HasLoopContVal: (Int, Int, Int) -> Prop;
pub let LoopExitVal: (Int, Int, Int, Val) -> Prop;
pub let HasLoopExitVal: (Int, Int, Int) -> Prop;
pub let RootRetVal: (Int, Val) -> Prop;
pub let RootChainVal: (Int, Int, Val) -> Prop;
pub let ForBodyYieldVal: (Int, Int, Val) -> Prop;
pub let ForOpChainIn: (Int, Int, Val) -> Prop;

// SESE switch folding & value alias resolution.
pub let SeseArmHasOps: (Int, Int, Int) -> Prop;
pub let SeseFolded: (Int, Int, Int, Int, Val) -> Prop;
pub let SeseIsFolded: (Int, Int, Int, Int) -> Prop;
pub let SeseArmAgree: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let SeseArmDiff: (Int, Int, Int, Int, Int) -> Prop;
pub let SeseIsDup: (Int, Int, Int, Int) -> Prop;
pub let SeseHasOut: (Int, Int, Int) -> Prop;
pub let SeseHasKept: (Int, Int, Int) -> Prop;
pub let SeseSkipped: (Int, Int, Int) -> Prop;
pub let SkippedReg: Reg -> Prop;
pub let ValAlias: (Val, Val) -> Prop;
pub let NeedVal: Val -> Prop;
pub let SynthOrd: (Val, Int) -> Prop;
pub let MovedOp: Int -> Prop;

// Final flat materialization tables read by core/src/passes/restructure.rs.
pub let OutOrigRegion: { original: Int, owner: Int, entry: Int, ordered_for: Int, depth: Int } -> Prop;
pub let OutChildRegion: { region: Reg, depth: Int } -> Prop;
pub let OutRegPort: { region: Reg, slot: Int, ty: Ty, value: Val } -> Prop;
pub let OutChainCount: { region: Int, count: Int } -> Prop;
pub let OutJoinState: { region: Int, slot: Int, value: Val } -> Prop;
pub let OutLoop: { body: Reg, region: Reg, order: Int } -> Prop;
pub let OutLoopInit: { body: Reg, slot: Int, value: Val } -> Prop;
pub let OutLoopRes: { body: Reg, slot: Int, ty: Ty, value: Val } -> Prop;
pub let OutSwitch: { switch: Sw, region: Reg, order: Int, terminator: Int, selector: Val } -> Prop;
pub let OutSwitchInput: { switch: Sw, slot: Int, value: Val } -> Prop;
pub let OutSwitchArm: { switch: Sw, slot: Int, arm: Reg } -> Prop;
pub let OutSwitchRes: { switch: Sw, slot: Int, ty: Ty, value: Val } -> Prop;
pub let OutFor: { loop_op: Int, region: Reg, order: Int, body: Int, lower: Val, upper: Val, step: Val } -> Prop;
pub let OutForInit: { loop_op: Int, slot: Int, value: Val } -> Prop;
pub let OutForRes: { loop_op: Int, slot: Int, ty: Ty, value: Val } -> Prop;
pub let OutForPort: { region: Int, slot: Int, value: Val } -> Prop;
pub let OutForBody: { region: Reg, induction: Val, upper: Val, step: Val } -> Prop;
pub let OutMovedOp: { operation: Int, region: Reg, order: Int } -> Prop;
pub let OutRewriteOperand: { operation: Int, slot: Int, value: Val } -> Prop;
pub let OutAppendState: { operation: Int, input: Val, output: Val } -> Prop;
pub let OutYield: { region: Reg, slot: Int, value: Val } -> Prop;
pub let OutSynth: { value: Val, region: Reg, order: Int } -> Prop;
pub let OutEraseOp: Int -> Prop;
pub let OutEraseBlock: Int -> Prop;

// ── Phase 1: Target regions, terminators, loops, branches ────────────────────
pub mod phase_targets {
    pub let func_reg<r, owner, entry, p, h, pos, d, loc>:
        (analysis::cfg::CfgRegion(r, owner, entry), ir::Operation{ id: std::ir::operation_key(owner), kind: dialects::func::r#func.kind, placement: p, container: h, position: pos, display: d, location: loc }()) -> TargetRegion(r, owner, entry);
    pub let for_reg<outer, for_op, body, entry, blk, pos, d, loc, o, e>:
        (TargetRegion(outer, o, e), analysis::cfg::OrderedForInRegion(outer, for_op, body), analysis::cfg::CfgRegion(body, for_op, entry), ir::Operation{ id: std::ir::operation_key(for_op), kind: dialects::scf::r#ordered_for.kind, placement: "block", container: blk, position: pos, display: d, location: loc }())
        -> (TargetRegion(body, for_op, entry), IsForBody(body), IsForOp(for_op), ForOpInfo(outer, blk, for_op, pos, body, entry));
    pub let for_res<outer, blk, for_op, pos, body, entry, v, ty, slot, decl>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), ir::Value(std::ir::value_key(v), ty, "result", for_op, slot, decl)) -> ForOrigRes(outer, for_op, slot, v);
    pub let tail_loop<r, h, latch, exit, be, ee>: analysis::cfg::TailLoop(r, h, latch, exit, be, ee) -> (IsTailLoop(r, h), IsTailLatch(r, h, latch));
    pub let term_br<r, o, e, b, node, pos, d, loc>:
        (TargetRegion(r, o, e), analysis::cfg::CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::cfg::r#br.kind, placement: "block", container: b, position: pos, display: d, location: loc }()) -> (BlockTerm(r, b, node, dialects::cfg::r#br.kind), BlockIsBr(r, b), TermOp(node));
    pub let term_cond<r, o, e, b, node, pos, d, loc>:
        (TargetRegion(r, o, e), analysis::cfg::CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::cfg::r#cond_br.kind, placement: "block", container: b, position: pos, display: d, location: loc }()) -> (BlockTerm(r, b, node, dialects::cfg::r#cond_br.kind), TermOp(node));
    pub let term_sw<r, o, e, b, node, pos, d, loc>:
        (TargetRegion(r, o, e), analysis::cfg::CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::cfg::r#switch.kind, placement: "block", container: b, position: pos, display: d, location: loc }()) -> (BlockTerm(r, b, node, dialects::cfg::r#switch.kind), TermOp(node));
    pub let term_ret<r, o, e, b, node, kind>: (TargetRegion(r, o, e), analysis::cfg::CfgReachableExit(r, b, node, kind)) -> (BlockTerm(r, b, node, kind), TermOp(node));
    pub let live_assign<r, o, e, src, edge, param, arg, dst, ty, slot, decl>:
        (TargetRegion(r, o, e), analysis::cfg::EdgeAssign(r, src, edge, param, arg), ir::Value(std::ir::value_key(param), ty, "block", dst, slot, decl), !analysis::cfg::DeadBlockArg(r, dst, slot, param))
        -> (LiveEdgeAssign(r, src, edge, param, arg), IsLiveParam(r, param), BlockEdgeWrites(r, src, edge, param));
    pub let loop_node_nat<r, o, e, s, h>: (TargetRegion(r, o, e), analysis::cfg::DagNode(r, s, h), analysis::cfg::NatLoopHeader(r, h), h != s) -> IsLoopDagNode(r, s, h);
    pub let loop_node_irred<r, o, e, s, rep>: (TargetRegion(r, o, e), analysis::cfg::IrredLoop(r, s, rep)) -> IsLoopDagNode(r, s, rep);
    pub let const_bit_bool_f<v, ty, ctor, args, node, p, h, pos, d, loc, attr, decl>:
        (ir::Value(std::ir::value_key(v), ty, "result", node, 0, decl), ir::TypeTerm(ty, ctor, args), std::ir::integer_width(args) == 1, ir::Operation{ id: std::ir::operation_key(node), kind: dialects::builtin::r#constant.kind, placement: p, container: h, position: pos, display: d, location: loc }(), ir::Attribute("operation", node, "value", attr), eqsat::eqsat_attr_bool(attr) == false) -> OrigConstBit(v, 0);
    pub let const_bit_bool_t<v, ty, ctor, args, node, p, h, pos, d, loc, attr, decl>:
        (ir::Value(std::ir::value_key(v), ty, "result", node, 0, decl), ir::TypeTerm(ty, ctor, args), std::ir::integer_width(args) == 1, ir::Operation{ id: std::ir::operation_key(node), kind: dialects::builtin::r#constant.kind, placement: p, container: h, position: pos, display: d, location: loc }(), ir::Attribute("operation", node, "value", attr), eqsat::eqsat_attr_bool(attr) == true) -> OrigConstBit(v, 1);
    pub let const_bit_int_0<v, ty, ctor, args, node, p, h, pos, d, loc, attr, decl>:
        (ir::Value(std::ir::value_key(v), ty, "result", node, 0, decl), ir::TypeTerm(ty, ctor, args), std::ir::integer_width(args) == 1, ir::Operation{ id: std::ir::operation_key(node), kind: dialects::builtin::r#constant.kind, placement: p, container: h, position: pos, display: d, location: loc }(), ir::Attribute("operation", node, "value", attr), eqsat::eqsat_shift_amount(eqsat::eqsat_attr_int(attr)) == 0) -> OrigConstBit(v, 0);
    pub let const_bit_int_1<v, ty, ctor, args, node, p, h, pos, d, loc, attr, decl>:
        (ir::Value(std::ir::value_key(v), ty, "result", node, 0, decl), ir::TypeTerm(ty, ctor, args), std::ir::integer_width(args) == 1, ir::Operation{ id: std::ir::operation_key(node), kind: dialects::builtin::r#constant.kind, placement: p, container: h, position: pos, display: d, location: loc }(), ir::Attribute("operation", node, "value", attr), eqsat::eqsat_shift_amount(eqsat::eqsat_attr_int(attr)) == 1) -> OrigConstBit(v, 1);
    pub let const_bit_int_m1<v, ty, ctor, args, node, p, h, pos, d, loc, attr, decl>:
        (ir::Value(std::ir::value_key(v), ty, "result", node, 0, decl), ir::TypeTerm(ty, ctor, args), std::ir::integer_width(args) == 1, ir::Operation{ id: std::ir::operation_key(node), kind: dialects::builtin::r#constant.kind, placement: p, container: h, position: pos, display: d, location: loc }(), ir::Attribute("operation", node, "value", attr), eqsat::eqsat_shift_amount(eqsat::eqsat_attr_int(attr)) == (0 - 1)) -> OrigConstBit(v, 1);
}

pub mod phase_active {
    pub let term_opnd<r, b, term, kind, sl, arg>: (BlockTerm(r, b, term, kind), ir::Operand(std::ir::operation_key(term), sl, std::ir::value_key(arg))) -> TermOperand(r, b, arg);
    pub let sese_active<r, o, e, s, h>: (TargetRegion(r, o, e), analysis::cfg::SeseBranch(r, s, h), !IsTailLatch(r, s, h)) -> ActiveSese(r, s, h);
    pub let hammock_active<r, o, e, s, h>: (TargetRegion(r, o, e), analysis::cfg::TopHammock(r, s, h), !IsTailLatch(r, s, h)) -> ActiveHammock(r, s, h);
}

// ── Phase 2a: First-stage ordering
pub mod phase_ord_seed1 {
    pub let chain<r, o, e, c>: (TargetRegion(r, o, e), analysis::cfg::RegionChain(r, c)) -> OrdItem("chain", r, 0, 0, c, c);
    pub let exit<r, o, e, l, x>: (TargetRegion(r, o, e), analysis::cfg::LoopExit(r, l, x)) -> OrdItem("exit", r, l, 0, x, x);
    pub let gmem_irr<r, o, e, s, m, rep>: (TargetRegion(r, o, e), analysis::cfg::IrredScc(r, s, m, rep)) -> OrdItem("gmem", r, s, rep, m, m);
    pub let gmem_ham<r, s, h, m, rank>:
        (ActiveHammock(r, s, h), analysis::cfg::HammockMember(r, s, h, m), analysis::cfg::DagTopoRank(r, s, m, rank))
        -> OrdItem("gmem", r, s, h, ((rank * 4294967296) + m), m);
    pub let mem_op<r, o, e, b, oid, c, k, pos, d, loc>:
        (TargetRegion(r, o, e), analysis::cfg::UnthreadedMemOp(r, b, oid, c), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }())
        -> (OrdItem("mem", r, b, c, ((pos * 4294967296) + oid), oid), BlockHasMemOp(r, b, c));
    pub let for_chain<outer, blk, for_op, pos, body, entry, c>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), analysis::cfg::UnthreadedMemOp(outer, blk, for_op, c)) -> OrdItem("for_ch", for_op, 0, 0, c, c);
    pub let for_opnd<outer, blk, for_op, pos, body, entry, sl, arg>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), ir::Operand(std::ir::operation_key(for_op), sl, std::ir::value_key(arg))) -> OrdItem("for_opnd", for_op, 0, 0, sl, sl);
}

pub mod ord_next {
    pub let step<t, a, b, c, k1, p1, k2, p2>:
        (OrdItem(t, a, b, c, k1, p1), OrdItem(t, a, b, c, k2, p2), std::int::less(k1, k2) == true) -> OrdNext(t, a, b, c, k1, k2);
}
pub mod ord_links {
    pub let link<t, a, b, c, k1, k2>: OrdNext(t, a, b, c, k1, k2) -> (OrdHasNext(t, a, b, c, k1), OrdHasPrev(t, a, b, c, k2));
}
pub mod ord_index {
    pub let first<t, a, b, c, k, p>: (OrdItem(t, a, b, c, k, p), !OrdHasPrev(t, a, b, c, k)) -> OrdIdx(t, a, b, c, k, p, 0);
    pub let next<t, a, b, c, k1, p1, i, k2, p2>:
        (OrdIdx(t, a, b, c, k1, p1, i), OrdNext(t, a, b, c, k1, k2), OrdItem(t, a, b, c, k2, p2)) -> OrdIdx(t, a, b, c, k2, p2, (i + 1));
}
pub mod ord_count {
    pub let count<t, a, b, c, k, p, i>: (OrdIdx(t, a, b, c, k, p, i), !OrdHasNext(t, a, b, c, k)) -> OrdCount(t, a, b, c, (i + 1));
}

// ── Phase 2b: Branch arms, homes, region depths, linear chains
pub mod phase_arms {
    pub let exit_count<r, l, n>: OrdCount("exit", r, l, 0, n) -> LoopExitCount(r, l, n);
    pub let single_exit<r, l, x>: (OrdCount("exit", r, l, 0, 1), analysis::cfg::LoopExit(r, l, x)) -> LoopSingleExit(r, l, x);
    pub let cond_false<r, s, h, term, dst>:
        (ActiveSese(r, s, h), !IsLoopDagNode(r, s, h), BlockTerm(r, h, term, dialects::cfg::r#cond_br.kind), ir::Successor(std::ir::operation_key(term), 1, dst))
        -> (BranchArm(r, s, h, 0, 1, dst), IsCondBranch(r, s, h));
    pub let cond_true<r, s, h, term, dst>:
        (ActiveSese(r, s, h), !IsLoopDagNode(r, s, h), BlockTerm(r, h, term, dialects::cfg::r#cond_br.kind), ir::Successor(std::ir::operation_key(term), 0, dst)) -> BranchArm(r, s, h, 1, 0, dst);
    pub let sw_arm<r, s, h, term, slot, dst>:
        (ActiveSese(r, s, h), !IsLoopDagNode(r, s, h), BlockTerm(r, h, term, dialects::cfg::r#switch.kind), ir::Successor(std::ir::operation_key(term), slot, dst)) -> BranchArm(r, s, h, slot, slot, dst);
    pub let loop_arm<r, s, l, k, x, idx>:
        (ActiveSese(r, s, l), IsLoopDagNode(r, s, l), OrdIdx("exit", r, l, 0, k, x, idx)) -> BranchArm(r, s, l, idx, x, x);
    pub let loop_cond<r, s, l>: (ActiveSese(r, s, l), IsLoopDagNode(r, s, l), OrdCount("exit", r, l, 0, 2)) -> IsCondBranch(r, s, l);
    pub let non_inner<r, s, b, h1, s1, h2, s2>:
        (ActiveSese(r, s, h1), ActiveSese(r, s, h2), analysis::cfg::ArmBlock(r, s, h1, s1, b), analysis::cfg::ArmBlock(r, s, h2, s2, b), analysis::cfg::DagStrictDom(r, s, h1, h2)) -> NonInnerSese(r, s, b, h1);
    pub let in_hammock<r, s, h, m>: (ActiveHammock(r, s, h), analysis::cfg::HammockMember(r, s, h, m)) -> NodeInHammock(r, s, m);
    pub let base_root<r, owner, entry>: TargetRegion(r, owner, entry) -> ScopeBaseReg(r, r, Reg::Orig(r));
    pub let base_loop<r, o, e, h>: (TargetRegion(r, o, e), analysis::cfg::NatLoopHeader(r, h)) -> ScopeBaseReg(r, h, Reg::LoopBody(r, h));
}

