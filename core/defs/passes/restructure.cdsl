        (TargetRegion(r, o, e), analysis::cfg::NatLoopHeader(r, lh), !IsTailLoop(r, lh), ExitSelWidth(r, lh, w)) -> GenLoopTarget(r, lh, lh, (0 - 2), w, 0);
    pub let glt_ex_rep<r, o, e, lh, x>:
        (TargetRegion(r, o, e), analysis::cfg::NatLoopHeader(r, lh), !IsTailLoop(r, lh), analysis::cfg::LoopExit(r, lh, x)) -> GenLoopTarget(r, lh, x, (0 - 1), 1, 0);
    pub let glt_ex_sel<r, o, e, lh, x, w, k, eidx>:
        (TargetRegion(r, o, e), analysis::cfg::NatLoopHeader(r, lh), !IsTailLoop(r, lh), OrdIdx("exit", r, lh, 0, k, x, eidx), ExitSelWidth(r, lh, w)) -> GenLoopTarget(r, lh, x, (0 - 2), w, eidx);

    pub let gt_member<r, s, o, k, dst, pos>: OrdIdx("gmem", r, s, o, k, dst, pos) -> GuardTarget(r, s, o, dst, pos);
    pub let gt_ham_join<r, s, h, j, n>: (ActiveHammock(r, s, h), analysis::cfg::DagIpdom(r, s, h, j), OrdCount("gmem", r, s, h, n)) -> GuardTarget(r, s, h, j, n);
