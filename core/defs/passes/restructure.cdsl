    pub let lpred_irr<r, s, rep, k, last_m, n>: (analysis::cfg::IrredLoop(r, s, rep), OrdItem("gmem", r, s, rep, k, last_m), !OrdHasNext("gmem", r, s, rep, k), OrdCount("gmem", r, s, rep, n)) -> (LoopPredVal(r, rep, Val::Cmp(Reg::LoopBody(r, rep), dialects::builtin::IntegerPredicate::Slt, Val::GuardRes(r, s, rep, last_m, (0 - 3)), Val::IntConst(Reg::LoopBody(r, rep), 32, n))), HasLoopPredVal(r, rep), SynthOrd(Val::Cmp(Reg::LoopBody(r, rep), dialects::builtin::IntegerPredicate::Slt, Val::GuardRes(r, s, rep, last_m, (0 - 3)), Val::IntConst(Reg::LoopBody(r, rep), 32, n)), 900000000));
