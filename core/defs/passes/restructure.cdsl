    pub let ty_rep<r, o, e, s, d>: (TargetRegion(r, o, e), analysis::cfg::DagEntry(r, s, d)) -> VarTy(r, s, (0 - 1), Ty::I1);
    pub let ty_tgt<r, s>: VarScope(r, s) -> VarTy(r, s, (0 - 3), Ty::I32);
