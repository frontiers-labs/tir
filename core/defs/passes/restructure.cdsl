    pub let lcont_tail_pass<r, h, latch, ex, be, ee, v, val>: (analysis::cfg::TailLoop(r, h, latch, ex, be, ee), LoopPortVar(r, h, v), !analysis::cfg::LoopExitOnly(r, h, v), !BlockEdgeWrites(r, latch, be, v), BlockOutVal(r, latch, v, val)) -> (LoopContVal(r, h, v, val), HasLoopContVal(r, h, v));
    pub let lexit_tail_assign<r, h, latch, ex, be, ee, v, arg, val>: (analysis::cfg::TailLoop(r, h, latch, ex, be, ee), LoopPortVar(r, h, v), LiveEdgeAssign(r, latch, ee, v, arg), TermReadVal(r, latch, arg, val)) -> (LoopExitVal(r, h, v, val), HasLoopExitVal(r, h, v));
    pub let lexit_tail_pass<r, h, latch, ex, be, ee, v, val>: (analysis::cfg::TailLoop(r, h, latch, ex, be, ee), LoopPortVar(r, h, v), !BlockEdgeWrites(r, latch, ee, v), BlockOutVal(r, latch, v, val)) -> (LoopExitVal(r, h, v, val), HasLoopExitVal(r, h, v));
    pub let lpred_gen<r, h, tail, val>: (analysis::cfg::NatLoopHeader(r, h), !IsTailLoop(r, h), ChainTail(Reg::LoopBody(r, h), r, h, tail), NodeOutVal(r, h, tail, (0 - 1), val)) -> (LoopPredVal(r, h, val), HasLoopPredVal(r, h));
