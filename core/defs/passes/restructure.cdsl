    pub let step_gmem_cond<r, s, o, k, m, term>:
        (OrdItem("gmem", r, s, o, k, m), BlockHome(r, m, Reg::GuardArm(r, s, o, m, 1)), BlockTerm(r, m, term, dialects::cfg::r#cond_br.kind))
