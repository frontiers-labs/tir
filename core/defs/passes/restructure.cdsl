        -> (StructStep(r, s, u, j), HasStructNext(r, s, u), HasStructPrev(r, s, j));
    pub let sese_has_body<r, s, h, arm, slot, dst>: (BranchArm(r, s, h, arm, slot, dst), analysis::cfg::ArmBlock(r, s, h, slot, dst)) -> SeseArmHasBody(r, s, h, arm);
}

pub mod phase_reg_tree {
    pub let step_arm_cond_f<r, s, o, src, term, dst>:
        (StepSite(r, s, o, src, 0, term), BlockTerm(r, src, term, dialects::cfg::r#cond_br.kind), ir::Successor(std::ir::operation_key(term), 1, dst)) -> StepSiteArm(r, s, o, src, 0, 1, dst);
