        (ActiveHammock(r, s, h), analysis::cfg::CfgEdge(r, src, slot, dst), !analysis::cfg::HammockMember(r, s, h, dst), !analysis::cfg::DagIpdom(r, s, h, dst), OrdCount("gmem", r, s, h, n))
        -> GuardTarget(r, s, h, dst, (n + 1));
