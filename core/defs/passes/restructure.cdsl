    pub let ty_ret<r, owner, e, s>: (TargetRegion(r, owner, e), VarScope(r, s)) -> VarTy(r, s, r, Ty::RetType(owner));
    pub let ty_ssa<r, s, v, ty, dk, o, sl, decl>: (TrackedVar(r, v), VarScope(r, s), ir::Value(std::ir::value_key(v), ty, dk, o, sl, decl)) -> VarTy(r, s, v, Ty::Exact(ty));

    // Block static write sets & control-variable overwrite flags.
    pub let bw_mem<r, b, c>: BlockHasMemOp(r, b, c) -> BlockWritesVar(r, b, c);
    pub let bw_res<r, o, e, b, v, oid, k, pos, d, loc, ty, sl, decl>:
        (TargetRegion(r, o, e), TrackedVar(r, v), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), ir::Value(std::ir::value_key(v), ty, "result", oid, sl, decl)) -> BlockWritesVar(r, b, v);
    pub let bw_ret<r, o, e, b, term, val>: (TargetRegion(r, o, e), analysis::cfg::CfgReachableExit(r, b, term, dialects::func::r#return.kind), ir::Operand(std::ir::operation_key(term), 0, std::ir::value_key(val))) -> BlockWritesVar(r, b, r);

    pub let ctrl_br_gen<r, lh, b, term, dst, cv, w, cval>: (BlockScope(r, b, lh), BlockTerm(r, b, term, dialects::cfg::r#br.kind), ir::Successor(std::ir::operation_key(term), 0, dst), GenLoopTarget(r, lh, dst, cv, w, cval)) -> BlockTermSetsCtrl(r, b, cv);
    pub let ctrl_ret_gen<r, lh, b, term>: (BlockScope(r, b, lh), analysis::cfg::NatLoopHeader(r, lh), !IsTailLoop(r, lh), BlockTerm(r, b, term, dialects::func::r#return.kind)) -> BlockTermSetsCtrl(r, b, (0 - 1));
    pub let ctrl_br_gmem<r, s, o, k, b, term>: (OrdItem("gmem", r, s, o, k, b), BlockTerm(r, b, term, dialects::cfg::r#br.kind)) -> BlockTermSetsCtrl(r, b, (0 - 3));
    pub let ctrl_ret_gmem<r, s, o, k, b, term>: (OrdItem("gmem", r, s, o, k, b), BlockTerm(r, b, term, dialects::func::r#return.kind)) -> BlockTermSetsCtrl(r, b, (0 - 3));
    pub let loop_outer<r, lh, l, dst, cv, w, cval>: (IsLoopDagNode(r, lh, l), !NodeInHammock(r, lh, l), LoopSingleExit(r, l, dst), GenLoopTarget(r, lh, dst, cv, w, cval)) -> LoopSetsOuterCtrl(r, lh, l, cv);
    pub let sese_arm_irr<r, s, h, arm, slot, dst, rep>: (BranchArm(r, s, h, arm, slot, dst), !SeseArmHasBody(r, s, h, arm), analysis::cfg::IrredScc(r, s, dst, rep)) -> SeseArmSetsCtrl(r, s, h, arm, (0 - 3));
    pub let sese_arm_gen<r, lh, h, arm, slot, dst, cv, w, cval>: (BranchArm(r, lh, h, arm, slot, dst), !SeseArmHasBody(r, lh, h, arm), GenLoopTarget(r, lh, dst, cv, w, cval)) -> SeseArmSetsCtrl(r, lh, h, arm, cv);
    pub let gmem_loop_tgt<r, s, o, k, m, only>: (OrdItem("gmem", r, s, o, k, m), analysis::cfg::NatLoopHeader(r, m), m != s, LoopSingleExit(r, m, only)) -> GuardMemberSetsCtrl(r, s, o, m, (0 - 3));
    pub let gmem_loop_outer<r, lh, h, m, only, cv, w, cval>: (ActiveHammock(r, lh, h), analysis::cfg::HammockMember(r, lh, h, m), IsLoopDagNode(r, lh, m), LoopSingleExit(r, m, only), GenLoopTarget(r, lh, only, cv, w, cval)) -> GuardMemberSetsCtrl(r, lh, h, m, cv);
    pub let sarm_tgt<r, s, o, src, arm, slot, dst>: StepSiteArm(r, s, o, src, arm, slot, dst) -> StepArmSetsCtrl(r, s, o, src, arm, (0 - 3));
    pub let sarm_ham_outer<r, lh, h, src, arm, slot, dst, cv, w, cval>: (StepSiteArm(r, lh, h, src, arm, slot, dst), ActiveHammock(r, lh, h), !analysis::cfg::DagHasIpdom(r, lh, h), GenLoopTarget(r, lh, dst, cv, w, cval)) -> StepArmSetsCtrl(r, lh, h, src, arm, cv);
}

// ── Phase 4: Positive monotonic value & state dataflow ───────────────────────
pub mod phase_flow {
    // Chain entry initialization & region entry environments.
    pub let ch_init_one<r, o, e, c>: (TargetRegion(r, o, e), !IsForBody(r), OrdCount("chain", r, 0, 0, 1), analysis::cfg::RegionChain(r, c)) -> ChainInit(r, c, Val::EntryState(r));
    pub let ch_init_split<r, o, e, n, k, c, idx>:
        (TargetRegion(r, o, e), !IsForBody(r), OrdCount("chain", r, 0, 0, n), std::int::less(1, n) == true, OrdIdx("chain", r, 0, 0, k, c, idx)) -> ChainInit(r, c, Val::SplitState(r, idx));
    pub let ch_init_for<outer, blk, for_op, pos, body, entry, k, c, idx>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), OrdIdx("for_ch", for_op, 0, 0, k, c, idx)) -> ChainInit(body, c, Val::ForPort(for_op, idx));
    pub let reg_in_arg<r, owner, entry, v, ty, sl, decl>:
        (TargetRegion(r, owner, entry), TrackedVar(r, v), ir::Value(std::ir::value_key(v), ty, "block", entry, sl, decl)) -> RegInVal(Reg::Orig(r), r, v, Val::Orig(v));
    pub let reg_in_ch<r, c, val>: ChainInit(r, c, val) -> RegInVal(Reg::Orig(r), r, c, val);
    pub let reg_in_for_outer<outer, blk, for_op, pos, body, entry, v, val>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), TrackedVar(outer, v), !analysis::cfg::RegionChain(outer, v), !analysis::cfg::ValueDefBlock(body, blk, v), BlockInVal(outer, blk, v, val))
        -> RegInVal(Reg::Orig(body), body, v, val);
    pub let reg_in_loop_port<r, l, v>: LoopPortVar(r, l, v) -> RegInVal(Reg::LoopBody(r, l), r, v, Val::LoopPort(r, l, v));
    pub let reg_in_loop_inv_dag<r, ps, l, v, val>:
        (NodeInVal(r, ps, l, v, val), IsLoopDagNode(r, ps, l), !LoopPortVar(r, l, v)) -> RegInVal(Reg::LoopBody(r, l), r, v, val);
    pub let reg_in_nat_inv_irr<r, ps, rep, h, v, val>:
        (analysis::cfg::IrredScc(r, ps, h, rep), analysis::cfg::NatLoopHeader(r, h), RegInVal(Reg::GuardArm(r, ps, rep, h, 1), r, v, val), !LoopPortVar(r, h, v)) -> RegInVal(Reg::LoopBody(r, h), r, v, val);
    pub let reg_in_sese_arm<r, s, h, arm, v, val>: SeseArmInVal(r, s, h, arm, v, val) -> RegInVal(Reg::SeseArm(r, s, h, arm), r, v, val);

    // ChainHead, StructStep, BlockInVal, and sequential block memory-state threading.
    pub let head_in<reg, r, s, head, v, val>: (ChainHead(reg, r, s, head), RegInVal(reg, r, v, val)) -> NodeInVal(r, s, head, v, val);
    pub let step_in<r, s, u, vn, var, val>: (StructStep(r, s, u, vn), NodeOutVal(r, s, u, var, val)) -> NodeInVal(r, s, vn, var, val);
    pub let blk_in_dag<r, s, b, v, val>: (NodeInVal(r, s, b, v, val), !IsLoopDagNode(r, s, b)) -> BlockInVal(r, b, v, val);
    pub let blk_in_irr<r, s, m, rep, v, val>:
        (analysis::cfg::IrredScc(r, s, m, rep), !analysis::cfg::NatLoopHeader(r, m), RegInVal(Reg::GuardArm(r, s, rep, m, 1), r, v, val)) -> BlockInVal(r, m, v, val);
    pub let mem_first<r, b, c, k, oid, val>: (OrdIdx("mem", r, b, c, k, oid, 0), BlockInVal(r, b, c, val)) -> MemOpInState(r, b, oid, c, val);
    pub let mem_next<r, b, c, k1, prev, k2, cur, st>:
        (OrdNext("mem", r, b, c, k1, k2), OrdItem("mem", r, b, c, k1, prev), OrdItem("mem", r, b, c, k2, cur), MemOpOutState(r, b, prev, c, st)) -> MemOpInState(r, b, cur, c, st);
    pub let mem_out_plain<r, b, oid, c, st>: (MemOpInState(r, b, oid, c, st), !IsForOp(oid)) -> MemOpOutState(r, b, oid, c, Val::MemState(oid));
    pub let mem_out_for<r, b, oid, c, st, k, idx>:
        (MemOpInState(r, b, oid, c, st), IsForOp(oid), OrdIdx("for_ch", oid, 0, 0, k, c, idx))
        -> (MemOpOutState(r, b, oid, c, Val::ForState(oid, idx)), ForOpChainIn(oid, idx, st));

    // BlockOutVal + unified TermReadVal (eliminates tracked/untracked rule pairs).
    pub let blk_out_pass<r, b, v, val>: (BlockInVal(r, b, v, val), !BlockWritesVar(r, b, v)) -> BlockOutVal(r, b, v, val);
    pub let blk_out_mem<r, b, c, k, oid, st>: (OrdItem("mem", r, b, c, k, oid), !OrdHasNext("mem", r, b, c, k), MemOpOutState(r, b, oid, c, st)) -> BlockOutVal(r, b, c, st);
    pub let blk_out_res<r, o, e, b, oid, k, pos, d, loc, v, ty, sl, decl>:
        (TargetRegion(r, o, e), TrackedVar(r, v), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !IsForOp(oid), ir::Value(std::ir::value_key(v), ty, "result", oid, sl, decl)) -> BlockOutVal(r, b, v, Val::Orig(v));
    pub let blk_out_for_res<r, b, oid, pos, body, entry, sl, v>: (ForOpInfo(r, b, oid, pos, body, entry), ForOrigRes(r, oid, sl, v)) -> BlockOutVal(r, b, v, Val::ForRes(oid, sl));
    pub let tread_tr<r, b, arg, val>: (TermOperand(r, b, arg), TrackedVar(r, arg), BlockOutVal(r, b, arg, val)) -> TermReadVal(r, b, arg, val);
    pub let tread_un<r, b, arg>: (TermOperand(r, b, arg), !TrackedVar(r, arg)) -> TermReadVal(r, b, arg, Val::Orig(arg));
    pub let blk_out_ret<r, b, term, arg, val>: (BlockTerm(r, b, term, dialects::func::r#return.kind), ir::Operand(std::ir::operation_key(term), 0, std::ir::value_key(arg)), TermReadVal(r, b, arg, val)) -> BlockOutVal(r, b, r, val);
    pub let for_yield<r, b, term, slot, arg, val>: (IsForBody(r), BlockTerm(r, b, term, dialects::scf::r#yield.kind), ir::Operand(std::ir::operation_key(term), slot, std::ir::value_key(arg)), TermReadVal(r, b, arg, val)) -> ForBodyYieldVal(r, slot, val);

    // BlockPostBrVal: cfg.br assigns & terminator control updates.
    pub let br_pass<r, b, v, val>: (BlockIsBr(r, b), BlockOutVal(r, b, v, val), !BlockEdgeWrites(r, b, 0, v), !BlockTermSetsCtrl(r, b, v)) -> BlockPostBrVal(r, b, v, val);
    pub let br_assign<r, b, param, arg, val>: (BlockIsBr(r, b), LiveEdgeAssign(r, b, 0, param, arg), TermReadVal(r, b, arg, val)) -> BlockPostBrVal(r, b, param, val);
    pub let non_br_pass<r, b, v, val>: (!BlockIsBr(r, b), BlockOutVal(r, b, v, val), !BlockTermSetsCtrl(r, b, v)) -> BlockPostBrVal(r, b, v, val);
    pub let br_gen<r, lh, b, term, dst, reg, cv, w, cval>:
        (BlockScope(r, b, lh), BlockHome(r, b, reg), BlockTerm(r, b, term, dialects::cfg::r#br.kind), ir::Successor(std::ir::operation_key(term), 0, dst), GenLoopTarget(r, lh, dst, cv, w, cval)) -> BlockPostBrVal(r, b, cv, Val::IntConst(reg, w, cval));
    pub let ret_gen<r, lh, b, term, reg>: (BlockScope(r, b, lh), BlockHome(r, b, reg), analysis::cfg::NatLoopHeader(r, lh), !IsTailLoop(r, lh), BlockTerm(r, b, term, dialects::func::r#return.kind)) -> BlockPostBrVal(r, b, (0 - 1), Val::IntConst(reg, 1, 0));
    pub let br_gmem<r, s, o, k, b, term, dst, code>: (OrdItem("gmem", r, s, o, k, b), BlockTerm(r, b, term, dialects::cfg::r#br.kind), ir::Successor(std::ir::operation_key(term), 0, dst), GuardTarget(r, s, o, dst, code)) -> BlockPostBrVal(r, b, (0 - 3), Val::IntConst(Reg::GuardArm(r, s, o, b, 1), 32, code));
    pub let ret_ham<r, s, h, b, term, n>: (ActiveHammock(r, s, h), analysis::cfg::HammockMember(r, s, h, b), BlockTerm(r, b, term, dialects::func::r#return.kind), OrdCount("gmem", r, s, h, n)) -> BlockPostBrVal(r, b, (0 - 3), Val::IntConst(Reg::GuardArm(r, s, h, b, 1), 32, n));
    pub let ret_irr<r, s, m, rep, term, n, ne>: (analysis::cfg::IrredScc(r, s, m, rep), !analysis::cfg::NatLoopHeader(r, m), BlockTerm(r, m, term, dialects::func::r#return.kind), OrdCount("gmem", r, s, rep, n), LoopExitCount(r, rep, ne)) -> BlockPostBrVal(r, m, (0 - 3), Val::IntConst(Reg::GuardArm(r, s, rep, m, 1), 32, (n + ne)));
    pub let ret_irr_noex<r, s, m, rep, term, n>: (analysis::cfg::IrredScc(r, s, m, rep), !analysis::cfg::NatLoopHeader(r, m), BlockTerm(r, m, term, dialects::func::r#return.kind), OrdCount("gmem", r, s, rep, n), !LoopHasExit(r, rep)) -> BlockPostBrVal(r, m, (0 - 3), Val::IntConst(Reg::GuardArm(r, s, rep, m, 1), 32, n));

    // PreBranchVal, LoopExitSelVal, NodeOutVal.
    pub let pre_blk<r, s, b, reg, v, val>: (NodeHome(r, s, b, reg), !IsLoopDagNode(r, s, b), BlockPostBrVal(r, b, v, val)) -> PreBranchVal(r, s, b, v, val);
    pub let pre_loop_res<r, s, l, reg, v>: (NodeHome(r, s, l, reg), IsLoopDagNode(r, s, l), LoopWritesPort(r, l, v)) -> PreBranchVal(r, s, l, v, Val::LoopRes(r, l, v));
    pub let pre_loop_pass<r, s, l, v, val>: (NodeInVal(r, s, l, v, val), IsLoopDagNode(r, s, l), !LoopWritesPort(r, l, v), !LoopSetsOuterCtrl(r, s, l, v)) -> PreBranchVal(r, s, l, v, val);
    pub let pre_loop_outer<r, lh, l, dst, reg, cv, w, cval>:
        (NodeHome(r, lh, l, reg), IsLoopDagNode(r, lh, l), !NodeInHammock(r, lh, l), LoopSingleExit(r, l, dst), GenLoopTarget(r, lh, dst, cv, w, cval))
        -> PreBranchVal(r, lh, l, cv, Val::IntConst(reg, w, cval));
    pub let lsel_nat<r, h, reg>: (LoopHome(r, h, reg), analysis::cfg::NatLoopHeader(r, h), !IsTailLoop(r, h), analysis::cfg::LoopMultiExit(r, h)) -> LoopExitSelVal(r, h, 0, Val::LoopRes(r, h, (0 - 2)));
    pub let lsel_irr_2<r, s, rep, reg, p, n>:
        (LoopHome(r, rep, reg), ChainPos(reg, rep, p), analysis::cfg::IrredLoop(r, s, rep), LoopExitCount(r, rep, 2), OrdCount("gmem", r, s, rep, n))
        -> (LoopExitSelVal(r, rep, 0, Val::Cmp(reg, dialects::builtin::IntegerPredicate::Eq, Val::Sub(reg, Val::LoopRes(r, rep, (0 - 3)), Val::IntConst(reg, 32, n)), Val::IntConst(reg, 32, 1))),
            SynthOrd(Val::Sub(reg, Val::LoopRes(r, rep, (0 - 3)), Val::IntConst(reg, 32, n)), ((p * 10000000) + 1000000)),
            SynthOrd(Val::Cmp(reg, dialects::builtin::IntegerPredicate::Eq, Val::Sub(reg, Val::LoopRes(r, rep, (0 - 3)), Val::IntConst(reg, 32, n)), Val::IntConst(reg, 32, 1)), ((p * 10000000) + 2000000)));
    pub let lsel_irr_many<r, s, rep, reg, p, n, ne>:
        (LoopHome(r, rep, reg), ChainPos(reg, rep, p), analysis::cfg::IrredLoop(r, s, rep), LoopExitCount(r, rep, ne), std::int::less(2, ne) == true, OrdCount("gmem", r, s, rep, n))
        -> (LoopExitSelVal(r, rep, 0, Val::Sub(reg, Val::LoopRes(r, rep, (0 - 3)), Val::IntConst(reg, 32, n))),
            SynthOrd(Val::Sub(reg, Val::LoopRes(r, rep, (0 - 3)), Val::IntConst(reg, 32, n)), ((p * 10000000) + 1000000)));
    pub let nout_lin<r, s, u, v, val>: (PreBranchVal(r, s, u, v, val), !ActiveSese(r, s, u), !ActiveHammock(r, s, u)) -> NodeOutVal(r, s, u, v, val);
    pub let nout_sese_out<r, s, h, v>: SeseOutVar(r, s, h, v) -> NodeOutVal(r, s, h, v, Val::SeseRes(r, s, h, v));
    pub let nout_sese_pass<r, s, h, v, val>: (ActiveSese(r, s, h), PreBranchVal(r, s, h, v, val), !SeseOutVar(r, s, h, v)) -> NodeOutVal(r, s, h, v, val);
    pub let nout_ham_out<r, s, h, v, k, last_m>:
        (ActiveHammock(r, s, h), GuardVar(r, s, h, v), OrdItem("gmem", r, s, h, k, last_m), !OrdHasNext("gmem", r, s, h, k))
        -> NodeOutVal(r, s, h, v, Val::GuardRes(r, s, h, last_m, v));
    pub let nout_ham_pass<r, s, h, v, val>: (ActiveHammock(r, s, h), PreBranchVal(r, s, h, v, val), !GuardVar(r, s, h, v)) -> NodeOutVal(r, s, h, v, val);

    // SESE branch predicate & arm entry/exit values.
    pub let sese_pred_loop<r, s, l, val>: (ActiveSese(r, s, l), IsLoopDagNode(r, s, l), LoopExitSelVal(r, l, 0, val)) -> SesePredVal(r, s, l, val);
    pub let sese_pred_blk<r, s, h, term, kind, arg, val>:
        (ActiveSese(r, s, h), !IsLoopDagNode(r, s, h), BlockTerm(r, h, term, kind), ir::Operand(std::ir::operation_key(term), 0, std::ir::value_key(arg)), TermReadVal(r, h, arg, val)) -> SesePredVal(r, s, h, val);
    pub let sarm_in_port<r, s, h, arm, slot, dst, c>: (BranchArm(r, s, h, arm, slot, dst), SeseFwdChain(r, s, h, c)) -> SeseArmInVal(r, s, h, arm, c, Val::SesePort(r, s, h, arm, c));
    pub let sarm_in_edge<r, s, h, arm, slot, dst, param, arg, val>:
        (BranchArm(r, s, h, arm, slot, dst), !IsLoopDagNode(r, s, h), LiveEdgeAssign(r, h, slot, param, arg), TermReadVal(r, h, arg, val)) -> SeseArmInVal(r, s, h, arm, param, val);
    pub let sarm_in_pass_blk<r, s, h, arm, slot, dst, v, val>:
        (BranchArm(r, s, h, arm, slot, dst), !IsLoopDagNode(r, s, h), PreBranchVal(r, s, h, v, val), !SeseFwdChain(r, s, h, v), !BlockEdgeWrites(r, h, slot, v), !SeseArmSetsCtrl(r, s, h, arm, v))
        -> SeseArmInVal(r, s, h, arm, v, val);
    pub let sarm_in_pass_loop<r, s, h, arm, slot, dst, v, val>:
        (BranchArm(r, s, h, arm, slot, dst), IsLoopDagNode(r, s, h), PreBranchVal(r, s, h, v, val), !SeseFwdChain(r, s, h, v), !SeseArmSetsCtrl(r, s, h, arm, v))
        -> SeseArmInVal(r, s, h, arm, v, val);
    pub let sarm_in_irr<r, s, h, arm, slot, dst, rep, k, pos>:
        (BranchArm(r, s, h, arm, slot, dst), !SeseArmHasBody(r, s, h, arm), analysis::cfg::IrredScc(r, s, dst, rep), OrdIdx("gmem", r, s, rep, k, dst, pos))
        -> SeseArmInVal(r, s, h, arm, (0 - 3), Val::IntConst(Reg::SeseArm(r, s, h, arm), 32, pos));
    pub let sarm_in_gen<r, lh, h, arm, slot, dst, cv, w, cval>:
        (BranchArm(r, lh, h, arm, slot, dst), !SeseArmHasBody(r, lh, h, arm), GenLoopTarget(r, lh, dst, cv, w, cval))
        -> SeseArmInVal(r, lh, h, arm, cv, Val::IntConst(Reg::SeseArm(r, lh, h, arm), w, cval));
    pub let sarm_out_empty<r, s, h, arm, v, val>:
        (SeseOutVar(r, s, h, v), !SeseArmHasBody(r, s, h, arm), SeseArmInVal(r, s, h, arm, v, val)) -> (SeseArmOutVal(r, s, h, arm, v, val), HasSeseArmOutVal(r, s, h, arm, v));
    pub let sarm_out_body<r, s, h, arm, tail, v, val>:
        (SeseOutVar(r, s, h, v), ChainTail(Reg::SeseArm(r, s, h, arm), r, s, tail), NodeOutVal(r, s, tail, v, val))
        -> (SeseArmOutVal(r, s, h, arm, v, val), HasSeseArmOutVal(r, s, h, arm, v));

    // Unified Guarded Steps (IrredLoop + ActiveHammock).
    pub let gstep_irr_first<r, s, rep, k, m, v, val>:
        (analysis::cfg::IrredLoop(r, s, rep), OrdIdx("gmem", r, s, rep, k, m, 0), RegInVal(Reg::LoopBody(r, rep), r, v, val)) -> GuardStepInVal(r, s, rep, m, v, val);
    pub let gstep_ham_first_sv<r, s, h, k, m, v>:
        (ActiveHammock(r, s, h), OrdIdx("gmem", r, s, h, k, m, 0), StepVar(r, s, h, h, v)) -> GuardStepInVal(r, s, h, m, v, Val::StepRes(r, s, h, h, v));
    pub let gstep_ham_first_pass<r, s, h, k, m, v, val>: (ActiveHammock(r, s, h), OrdIdx("gmem", r, s, h, k, m, 0), PreBranchVal(r, s, h, v, val), !StepVar(r, s, h, h, v)) -> GuardStepInVal(r, s, h, m, v, val);
    pub let gstep_next_gv<r, s, o, k1, prev, k2, cur, v>: (OrdNext("gmem", r, s, o, k1, k2), OrdItem("gmem", r, s, o, k1, prev), OrdItem("gmem", r, s, o, k2, cur), GuardVar(r, s, o, v)) -> GuardStepInVal(r, s, o, cur, v, Val::GuardRes(r, s, o, prev, v));
    pub let gstep_next_pass<r, s, o, k1, prev, k2, cur, v, val>: (OrdNext("gmem", r, s, o, k1, k2), OrdItem("gmem", r, s, o, k1, prev), OrdItem("gmem", r, s, o, k2, cur), GuardStepInVal(r, s, o, prev, v, val), !GuardVar(r, s, o, v)) -> GuardStepInVal(r, s, o, cur, v, val);
    pub let gfalse_port<r, s, o, m, c>: (GuardMem(r, s, o, c), ChildReg(Reg::GuardArm(r, s, o, m, 0))) -> (GuardFalseOutVal(r, s, o, m, c, Val::GuardPort(r, s, o, m, 0, c)), HasGuardFalseOutVal(r, s, o, m, c));
    pub let gfalse_pass<r, s, o, m, v, val>: (GuardVar(r, s, o, v), !GuardMem(r, s, o, v), GuardStepInVal(r, s, o, m, v, val)) -> (GuardFalseOutVal(r, s, o, m, v, val), HasGuardFalseOutVal(r, s, o, m, v));
    pub let gtrue_in_port<r, s, o, m, c>: (GuardMem(r, s, o, c), ChildReg(Reg::GuardArm(r, s, o, m, 1))) -> RegInVal(Reg::GuardArm(r, s, o, m, 1), r, c, Val::GuardPort(r, s, o, m, 1, c));
    pub let gtrue_in_pass<r, s, o, m, v, val>: (GuardStepInVal(r, s, o, m, v, val), !GuardMem(r, s, o, v)) -> RegInVal(Reg::GuardArm(r, s, o, m, 1), r, v, val);
