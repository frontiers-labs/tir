    pub let step_gmem_sw<r, s, o, k, m, term>:
        (OrdItem("gmem", r, s, o, k, m), BlockHome(r, m, Reg::GuardArm(r, s, o, m, 1)), BlockTerm(r, m, term, dialects::cfg::r#switch.kind))
        -> (StepSite(r, s, o, m, 0, term), StepHome(r, s, o, m, Reg::GuardArm(r, s, o, m, 1)));
    pub let step_gmem_loop<r, s, o, k, m>:
        (OrdItem("gmem", r, s, o, k, m), analysis::cfg::NatLoopHeader(r, m), m != s, analysis::cfg::LoopMultiExit(r, m))
        -> (StepSite(r, s, o, m, 1, (0 - 1)), StepHome(r, s, o, m, Reg::GuardArm(r, s, o, m, 1)));

    pub let step_linear<r, s, u, v, reg>:
        (NodeHome(r, s, u, reg), NodeHome(r, s, v, reg), !ActiveSese(r, s, u), !ActiveHammock(r, s, u), analysis::cfg::DagEdge(r, s, u, v))
        -> (StructStep(r, s, u, v), HasStructNext(r, s, u), HasStructPrev(r, s, v));
    pub let step_sese<r, s, u, j, reg>:
        (NodeHome(r, s, u, reg), NodeHome(r, s, j, reg), ActiveSese(r, s, u), analysis::cfg::DagIpdom(r, s, u, j))
        -> (StructStep(r, s, u, j), HasStructNext(r, s, u), HasStructPrev(r, s, j));
    pub let step_ham<r, s, u, j, reg>:
