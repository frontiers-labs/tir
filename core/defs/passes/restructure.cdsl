    pub let lcont_p<r, l, v>: (LoopPortVar(r, l, v), !HasLoopContVal(r, l, v)) -> LoopContVal(r, l, v, Val::LoopPort(r, l, v));
    pub let lexit_p<r, l, v>: (LoopPortVar(r, l, v), !HasLoopExitVal(r, l, v)) -> LoopExitVal(r, l, v, Val::LoopPort(r, l, v));
    pub let sarm_z<r, s, h, arm, slot, dst, v, ty>:
        (BranchArm(r, s, h, arm, slot, dst), SeseOutVar(r, s, h, v), VarTy(r, s, v, ty), !HasSeseArmOutVal(r, s, h, arm, v))
        -> SeseArmOutVal(r, s, h, arm, v, Val::Zero(Reg::SeseArm(r, s, h, arm), ty));
    pub let gfalse_z<r, s, o, m, v, ty>:
        (ChildReg(Reg::GuardArm(r, s, o, m, 0)), GuardVar(r, s, o, v), VarTy(r, s, v, ty), !HasGuardFalseOutVal(r, s, o, m, v))
        -> GuardFalseOutVal(r, s, o, m, v, Val::Zero(Reg::GuardArm(r, s, o, m, 0), ty));
    pub let gtrue_z<r, s, o, m, v, ty>:
        (ChildReg(Reg::GuardArm(r, s, o, m, 1)), GuardVar(r, s, o, v), VarTy(r, s, v, ty), !HasGuardTrueOutVal(r, s, o, m, v))
        -> GuardTrueOutVal(r, s, o, m, v, Val::Zero(Reg::GuardArm(r, s, o, m, 1), ty));
    pub let step_z<r, s, o, src, arm, slot, dst, v, ty>:
        (StepSiteArm(r, s, o, src, arm, slot, dst), StepVar(r, s, o, src, v), VarTy(r, s, v, ty), !HasStepArmOutVal(r, s, o, src, arm, v))
        -> StepArmOutVal(r, s, o, src, arm, v, Val::Zero(Reg::StepArm(r, s, o, src, arm), ty));
}

// ── Phase 6: SESE switch predicate folding, deduplication & ValAlias resolution
pub mod phase_fold_prep {
    pub let const_c0<reg>: ChildReg(reg) -> IsConstBit(Val::IntConst(reg, 1, 0), 0);
    pub let const_c1<reg>: ChildReg(reg) -> IsConstBit(Val::IntConst(reg, 1, 1), 1);
    pub let const_z0<reg>: ChildReg(reg) -> IsConstBit(Val::Zero(reg, Ty::I1), 0);
    pub let const_orig<v, bit>: OrigConstBit(v, bit) -> IsConstBit(Val::Orig(v), bit);
    pub let var_i1_lit<r, s, v>: VarTy(r, s, v, Ty::I1) -> VarIsI1(r, s, v);
    pub let var_i1_exact<r, s, v, ty, ctor, args>:
        (VarTy(r, s, v, Ty::Exact(ty)), ir::TypeTerm(ty, ctor, args), std::ir::integer_width(args) == 1) -> VarIsI1(r, s, v);
    pub let arm_op_blk<r, s, h, arm, b, oid, k, pos, d, loc>:
        (BlockHome(r, b, Reg::SeseArm(r, s, h, arm)), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !TermOp(oid)) -> SeseArmHasOps(r, s, h);
    pub let arm_op_loop<r, s, h, arm, l>: LoopHome(r, l, Reg::SeseArm(r, s, h, arm)) -> SeseArmHasOps(r, s, h);
    pub let arm_op_sese<r, s, h, arm, h2>: (ActiveSese(r, s, h2), NodeHome(r, s, h2, Reg::SeseArm(r, s, h, arm))) -> SeseArmHasOps(r, s, h);
    pub let arm_op_ham<r, s, h, arm, h2>: (ActiveHammock(r, s, h2), NodeHome(r, s, h2, Reg::SeseArm(r, s, h, arm))) -> SeseArmHasOps(r, s, h);
    pub let agree<r, s, h, arm, k1, v1, i1, k2, v2, i2, val>:
        (OrdIdx("sese_out", r, s, h, k1, v1, i1), OrdIdx("sese_out", r, s, h, k2, v2, i2), std::int::less(i1, i2) == true, SeseArmOutVal(r, s, h, arm, v1, val), SeseArmOutVal(r, s, h, arm, v2, val))
        -> SeseArmAgree(r, s, h, arm, i1, i2);
}
pub mod phase_fold_match {
    pub let fold_id<r, s, h, v, pred, v0, v1>:
        (IsCondBranch(r, s, h), SeseOutVar(r, s, h, v), VarIsI1(r, s, v), SesePredVal(r, s, h, pred),
         SeseArmOutVal(r, s, h, 0, v, v0), SeseArmOutVal(r, s, h, 1, v, v1), IsConstBit(v0, 0), IsConstBit(v1, 1))
        -> (SeseFolded(r, s, h, v, pred), SeseIsFolded(r, s, h, v));
    pub let fold_not<r, s, h, v, pred, home, p, v0, v1>:
        (IsCondBranch(r, s, h), OrdCount("sese_out", r, s, h, 1), !SeseArmHasOps(r, s, h),
         SeseOutVar(r, s, h, v), VarIsI1(r, s, v), SesePredVal(r, s, h, pred), NodeHome(r, s, h, home), ChainPos(home, h, p),
         SeseArmOutVal(r, s, h, 0, v, v0), SeseArmOutVal(r, s, h, 1, v, v1), IsConstBit(v0, 1), IsConstBit(v1, 0))
        -> (SeseFolded(r, s, h, v, Val::Not(home, pred)), SeseIsFolded(r, s, h, v), SynthOrd(Val::Not(home, pred), ((p * 10000000) + 5000000)));
}
pub mod phase_fold_diff {
    pub let diff<r, s, h, arm, slot, dst, k1, v1, i1, k2, v2, i2>:
        (BranchArm(r, s, h, arm, slot, dst), OrdIdx("sese_out", r, s, h, k1, v1, i1), OrdIdx("sese_out", r, s, h, k2, v2, i2), std::int::less(i1, i2) == true, !SeseArmAgree(r, s, h, arm, i1, i2))
        -> SeseArmDiff(r, s, h, i1, i2);
}
pub mod phase_fold_dup {
    pub let dup_min<r, s, h, k1, v1, i1, k2, v2, i2>:
        (OrdIdx("sese_out", r, s, h, k1, v1, i1), OrdIdx("sese_out", r, s, h, k2, v2, i2), std::int::less(i1, i2) == true, !SeseIsFolded(r, s, h, v1), !SeseIsFolded(r, s, h, v2), !SeseArmDiff(r, s, h, i1, i2))
        -> (SeseDupMin(r, s, h, i2, i1), SeseIsDup(r, s, h, v2));
}
pub mod phase_fold_keep {
    pub let kept<r, s, h, k, v, idx>:
        (OrdIdx("sese_out", r, s, h, k, v, idx), !SeseIsFolded(r, s, h, v), !SeseIsDup(r, s, h, v))
        -> (SeseHasKept(r, s, h), OrdItem("sese_kept", r, s, h, k, v));
    pub let alias_fold<r, s, h, v, rep>: SeseFolded(r, s, h, v, rep) -> ValAlias(Val::SeseRes(r, s, h, v), rep);
    pub let alias_dup<r, s, h, i2, i1, k1, v1, k2, v2>:
        (SeseDupMin(r, s, h, i2, i1), OrdIdx("sese_out", r, s, h, k1, v1, i1), OrdIdx("sese_out", r, s, h, k2, v2, i2))
        -> ValAlias(Val::SeseRes(r, s, h, v2), Val::SeseRes(r, s, h, v1));
}
pub mod phase_fold_skip {
    pub let skip<r, s, h>: (ActiveSese(r, s, h), SeseHasOut(r, s, h), !SeseHasKept(r, s, h), !SeseArmHasOps(r, s, h)) -> SeseSkipped(r, s, h);
    pub let skip_reg<r, s, h, arm, slot, dst>: (SeseSkipped(r, s, h), BranchArm(r, s, h, arm, slot, dst)) -> SkippedReg(Reg::SeseArm(r, s, h, arm));
    pub let union_alias<a, b>: ValAlias(a, b) -> a == b;
}

// ── Phase 7: Emit flat output materialization tables ─────────────────────────
pub mod phase_emit_raw {
    pub let orig_fn<r, owner, entry, d>: (TargetRegion(r, owner, entry), !IsForBody(r), RegDepth(Reg::Orig(r), d)) -> OutOrigRegion{ original: r, owner: owner, entry: entry, ordered_for: 0, depth: d }();
    pub let orig_for<r, owner, entry, d>: (TargetRegion(r, owner, entry), IsForBody(r), RegDepth(Reg::Orig(r), d)) -> OutOrigRegion{ original: r, owner: owner, entry: entry, ordered_for: 1, depth: d }();
    pub let ch_cnt<r, o, e, n>: (TargetRegion(r, o, e), !IsForBody(r), OrdCount("chain", r, 0, 0, n)) -> OutChainCount{ region: r, count: n }();
    pub let child_reg<reg, d>: (ChildReg(reg), !SkippedReg(reg), RegDepth(reg, d)) -> OutChildRegion{ region: reg, depth: d }();

    pub let port_loop<r, l, k, v, idx, ty>: (OrdIdx("lp", r, l, 0, k, v, idx), VarTy(r, l, v, ty)) -> OutRegPort{ region: Reg::LoopBody(r, l), slot: idx, ty: ty, value: Val::LoopPort(r, l, v) }();
    pub let port_sese<r, s, h, arm, slot, dst, k, c, idx>:
        (BranchArm(r, s, h, arm, slot, dst), !SeseSkipped(r, s, h), OrdIdx("sese_fwd", r, s, h, k, c, idx)) -> OutRegPort{ region: Reg::SeseArm(r, s, h, arm), slot: idx, ty: Ty::State, value: Val::SesePort(r, s, h, arm, c) }();
    pub let port_guard<r, s, o, m, bit, k, c, idx>:
        (ChildReg(Reg::GuardArm(r, s, o, m, bit)), OrdIdx("gm", r, s, o, k, c, idx)) -> OutRegPort{ region: Reg::GuardArm(r, s, o, m, bit), slot: idx, ty: Ty::State, value: Val::GuardPort(r, s, o, m, bit, c) }();
    pub let port_for<outer, blk, for_op, pos, body, entry, k, c, idx>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), OrdIdx("for_ch", for_op, 0, 0, k, c, idx)) -> OutForPort{ region: body, slot: idx, value: Val::ForPort(for_op, idx) }();

    pub let loop_dag<r, l, home, p, pred>: (LoopHome(r, l, home), ChainPos(home, l, p), LoopPredVal(r, l, pred)) -> (OutLoop{ body: Reg::LoopBody(r, l), region: home, order: (p * 10000000) }(), OutYield{ region: Reg::LoopBody(r, l), slot: 0, value: pred }());
    pub let loop_in_irr<r, s, rep, h, pred>:
        (analysis::cfg::IrredScc(r, s, h, rep), analysis::cfg::NatLoopHeader(r, h), LoopPredVal(r, h, pred)) -> (OutLoop{ body: Reg::LoopBody(r, h), region: Reg::GuardArm(r, s, rep, h, 1), order: 0 }(), OutYield{ region: Reg::LoopBody(r, h), slot: 0, value: pred }());
    pub let loop_slots<r, l, k, v, idx, ty, init_v, cont_v, exit_v>:
        (OrdIdx("lp", r, l, 0, k, v, idx), VarTy(r, l, v, ty), LoopInitVal(r, l, v, init_v), LoopContVal(r, l, v, cont_v), LoopExitVal(r, l, v, exit_v))
        -> (OutLoopInit{ body: Reg::LoopBody(r, l), slot: idx, value: init_v }(), OutLoopRes{ body: Reg::LoopBody(r, l), slot: idx, ty: ty, value: Val::LoopRes(r, l, v) }(), OutYield{ region: Reg::LoopBody(r, l), slot: (1 + idx), value: cont_v }(), OutYield{ region: Reg::LoopBody(r, l), slot: (1000000 + idx), value: exit_v }());

    pub let sw_sese_blk<r, s, h, home, p, term, kind, pred>:
        (ActiveSese(r, s, h), !SeseSkipped(r, s, h), !IsLoopDagNode(r, s, h), BlockTerm(r, h, term, kind), NodeHome(r, s, h, home), ChainPos(home, h, p), SesePredVal(r, s, h, pred))
        -> OutSwitch{ switch: Sw::Sese(r, s, h), region: home, order: ((p * 10000000) + 5000000), terminator: term, selector: pred }();
    pub let sw_sese_loop<r, s, l, home, p, pred>:
        (ActiveSese(r, s, l), !SeseSkipped(r, s, l), IsLoopDagNode(r, s, l), NodeHome(r, s, l, home), ChainPos(home, l, p), SesePredVal(r, s, l, pred))
        -> OutSwitch{ switch: Sw::Sese(r, s, l), region: home, order: ((p * 10000000) + 5000000), terminator: (0 - 1), selector: pred }();
    pub let sw_sese_in<r, s, h, k, c, idx, val>: (!SeseSkipped(r, s, h), OrdIdx("sese_fwd", r, s, h, k, c, idx), PreBranchVal(r, s, h, c, val)) -> OutSwitchInput{ switch: Sw::Sese(r, s, h), slot: idx, value: val }();
    pub let sw_sese_arm<r, s, h, arm, slot, dst>: (BranchArm(r, s, h, arm, slot, dst), !SeseSkipped(r, s, h)) -> OutSwitchArm{ switch: Sw::Sese(r, s, h), slot: arm, arm: Reg::SeseArm(r, s, h, arm) }();
    pub let sw_sese_res<r, s, h, k, v, idx, ty>: (!SeseSkipped(r, s, h), OrdIdx("sese_kept", r, s, h, k, v, idx), VarTy(r, s, v, ty)) -> OutSwitchRes{ switch: Sw::Sese(r, s, h), slot: idx, ty: ty, value: Val::SeseRes(r, s, h, v) }();
    pub let sw_sese_yield<r, s, h, arm, slot, dst, k, v, idx, val>:
        (BranchArm(r, s, h, arm, slot, dst), !SeseSkipped(r, s, h), OrdIdx("sese_kept", r, s, h, k, v, idx), SeseArmOutVal(r, s, h, arm, v, val)) -> OutYield{ region: Reg::SeseArm(r, s, h, arm), slot: idx, value: val }();

    pub let sw_guard_irr<r, s, rep, k, m, idx, tval>:
        (analysis::cfg::IrredLoop(r, s, rep), OrdIdx("gmem", r, s, rep, k, m, idx), GuardStepInVal(r, s, rep, m, (0 - 3), tval))
        -> (OutSwitch{ switch: Sw::Guard(r, s, rep, m), region: Reg::LoopBody(r, rep), order: ((idx * 2) + 1), terminator: (0 - 1), selector: Val::Cmp(Reg::LoopBody(r, rep), dialects::builtin::IntegerPredicate::Eq, tval, Val::IntConst(Reg::LoopBody(r, rep), 32, idx)) }(),
            SynthOrd(Val::Cmp(Reg::LoopBody(r, rep), dialects::builtin::IntegerPredicate::Eq, tval, Val::IntConst(Reg::LoopBody(r, rep), 32, idx)), (idx * 2)),
            OutSwitchArm{ switch: Sw::Guard(r, s, rep, m), slot: 0, arm: Reg::GuardArm(r, s, rep, m, 0) }(), OutSwitchArm{ switch: Sw::Guard(r, s, rep, m), slot: 1, arm: Reg::GuardArm(r, s, rep, m, 1) }());
    pub let sw_guard_ham<r, s, h, home, p, k, m, idx, tval>:
        (ActiveHammock(r, s, h), NodeHome(r, s, h, home), ChainPos(home, h, p), OrdIdx("gmem", r, s, h, k, m, idx), GuardStepInVal(r, s, h, m, (0 - 3), tval))
        -> (OutSwitch{ switch: Sw::Guard(r, s, h, m), region: home, order: (((p * 10000000) + 6000000) + ((idx * 2) + 1)), terminator: (0 - 1), selector: Val::Cmp(home, dialects::builtin::IntegerPredicate::Eq, tval, Val::IntConst(home, 32, idx)) }(),
            SynthOrd(Val::Cmp(home, dialects::builtin::IntegerPredicate::Eq, tval, Val::IntConst(home, 32, idx)), (((p * 10000000) + 6000000) + (idx * 2))),
            OutSwitchArm{ switch: Sw::Guard(r, s, h, m), slot: 0, arm: Reg::GuardArm(r, s, h, m, 0) }(), OutSwitchArm{ switch: Sw::Guard(r, s, h, m), slot: 1, arm: Reg::GuardArm(r, s, h, m, 1) }());
    pub let sw_guard_in<r, s, o, m, k, c, idx, val>:
        (ChildReg(Reg::GuardArm(r, s, o, m, 0)), OrdIdx("gm", r, s, o, k, c, idx), GuardStepInVal(r, s, o, m, c, val)) -> OutSwitchInput{ switch: Sw::Guard(r, s, o, m), slot: idx, value: val }();
    pub let sw_guard_res<r, s, o, m, k, v, idx, ty, fval, tval>:
        (ChildReg(Reg::GuardArm(r, s, o, m, 0)), OrdIdx("gv", r, s, o, k, v, idx), VarTy(r, s, v, ty), GuardFalseOutVal(r, s, o, m, v, fval), GuardTrueOutVal(r, s, o, m, v, tval))
        -> (OutSwitchRes{ switch: Sw::Guard(r, s, o, m), slot: idx, ty: ty, value: Val::GuardRes(r, s, o, m, v) }(), OutYield{ region: Reg::GuardArm(r, s, o, m, 0), slot: idx, value: fval }(), OutYield{ region: Reg::GuardArm(r, s, o, m, 1), slot: idx, value: tval }());

    pub let sw_step_ham<r, s, h, isl, term, home, p, pred>:
        (ActiveHammock(r, s, h), StepSite(r, s, h, h, isl, term), NodeHome(r, s, h, home), ChainPos(home, h, p), StepPredVal(r, s, h, h, pred))
        -> OutSwitch{ switch: Sw::Step(r, s, h, h), region: home, order: ((p * 10000000) + 5000000), terminator: term, selector: pred }();
    pub let sw_step_mem<r, s, o, m, isl, term, pred>:
        (StepSite(r, s, o, m, isl, term), StepHome(r, s, o, m, Reg::GuardArm(r, s, o, m, 1)), StepPredVal(r, s, o, m, pred))
        -> OutSwitch{ switch: Sw::Step(r, s, o, m), region: Reg::GuardArm(r, s, o, m, 1), order: 5000000, terminator: term, selector: pred }();
    pub let sw_step_arm<r, s, o, src, arm, slot, dst>: StepSiteArm(r, s, o, src, arm, slot, dst) -> OutSwitchArm{ switch: Sw::Step(r, s, o, src), slot: arm, arm: Reg::StepArm(r, s, o, src, arm) }();
    pub let sw_step_res<r, s, o, src, isl, t, k, v, idx, ty>:
        (StepSite(r, s, o, src, isl, t), OrdIdx("sv", s, o, src, k, v, idx), VarTy(r, s, v, ty)) -> OutSwitchRes{ switch: Sw::Step(r, s, o, src), slot: idx, ty: ty, value: Val::StepRes(r, s, o, src, v) }();
    pub let sw_step_yield<r, s, o, src, arm, slot, dst, k, v, idx, val>:
        (StepSiteArm(r, s, o, src, arm, slot, dst), OrdIdx("sv", s, o, src, k, v, idx), StepArmOutVal(r, s, o, src, arm, v, val)) -> OutYield{ region: Reg::StepArm(r, s, o, src, arm), slot: idx, value: val }();

    pub let move_op<r, b, reg, base, oid, k, pos, d, loc>:
        (BlockHome(r, b, reg), BlockBaseOrder(r, b, base), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !TermOp(oid), !IsForOp(oid)) -> (OutMovedOp{ operation: oid, region: reg, order: (base + pos) }(), MovedOp(oid));
    pub let rw_op_in<r, o, e, b, oid, k, pos, d, loc, slot, arg, val>:
        (TargetRegion(r, o, e), analysis::cfg::CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !TermOp(oid), !IsForOp(oid), ir::Operand(std::ir::operation_key(oid), slot, std::ir::value_key(arg)), TrackedVar(r, arg), !analysis::cfg::ValueDefBlock(r, b, arg), BlockInVal(r, b, arg, val)) -> OutRewriteOperand{ operation: oid, slot: slot, value: val }();
    pub let rw_op_blkarg<r, o, e, b, oid, k, pos, d, loc, slot, arg, ty, sl, decl, val>:
        (TargetRegion(r, o, e), analysis::cfg::CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !TermOp(oid), !IsForOp(oid), ir::Operand(std::ir::operation_key(oid), slot, std::ir::value_key(arg)), ir::Value(std::ir::value_key(arg), ty, "block", b, sl, decl), BlockInVal(r, b, arg, val)) -> OutRewriteOperand{ operation: oid, slot: slot, value: val }();
    pub let rw_op_forres<r, b, oid, k, pos, d, loc, slot, arg, fop, fsl>:
        (ForOrigRes(r, fop, fsl, arg), analysis::cfg::CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !TermOp(oid), !IsForOp(oid), ir::Operand(std::ir::operation_key(oid), slot, std::ir::value_key(arg)), analysis::cfg::ValueDefBlock(r, b, arg)) -> OutRewriteOperand{ operation: oid, slot: slot, value: Val::ForRes(fop, fsl) }();
    pub let append_st<r, b, oid, c, st>: (MemOpInState(r, b, oid, c, st), !IsForOp(oid)) -> OutAppendState{ operation: oid, input: st, output: Val::MemState(oid) }();

    pub let for_op<outer, blk, for_op, pos, body, entry, reg, base, n, lb, ub, step, iv, iv_ty, iv_d>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), BlockHome(outer, blk, reg), BlockBaseOrder(outer, blk, base), OrdCount("for_opnd", for_op, 0, 0, n),
         ir::Operand(std::ir::operation_key(for_op), 0, std::ir::value_key(lb)), ir::Operand(std::ir::operation_key(for_op), (n - 2), std::ir::value_key(ub)), ir::Operand(std::ir::operation_key(for_op), (n - 1), std::ir::value_key(step)), ir::Value(std::ir::value_key(iv), iv_ty, "block", entry, 0, iv_d))
        -> (OutFor{ loop_op: for_op, region: reg, order: (base + pos), body: body, lower: Val::Orig(lb), upper: Val::Orig(ub), step: Val::Orig(step) }(), OutForBody{ region: Reg::Orig(body), induction: Val::Orig(iv), upper: Val::Orig(ub), step: Val::Orig(step) }());
    pub let for_init_val<outer, blk, for_op, pos, body, entry, n, sl, arg>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), OrdCount("for_opnd", for_op, 0, 0, n), ir::Operand(std::ir::operation_key(for_op), sl, std::ir::value_key(arg)), std::int::less(0, sl) == true, std::int::less(sl, (n - 2)) == true) -> OutForInit{ loop_op: for_op, slot: (sl - 1), value: Val::Orig(arg) }();
    pub let for_res_val<outer, blk, for_op, pos, body, entry, sl, v, ty, decl>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), ir::Value(std::ir::value_key(v), ty, "result", for_op, sl, decl)) -> OutForRes{ loop_op: for_op, slot: sl, ty: Ty::Exact(ty), value: Val::ForRes(for_op, sl) }();
    pub let for_yield_val<body, sl, val>: ForBodyYieldVal(body, sl, val) -> OutYield{ region: Reg::Orig(body), slot: sl, value: val }();
    pub let for_yield_ch<outer, blk, for_op, pos, body, entry, k, c, idx, val>:
        (ForOpInfo(outer, blk, for_op, pos, body, entry), OrdIdx("for_ch", for_op, 0, 0, k, c, idx), RootChainVal(body, c, val)) -> OutYield{ region: Reg::Orig(body), slot: (1000000 + idx), value: val }();
    pub let for_ch_in<for_op, idx, st>:
        ForOpChainIn(for_op, idx, st) -> (OutForInit{ loop_op: for_op, slot: (2000000 + idx), value: st }(), OutForRes{ loop_op: for_op, slot: (2000000 + idx), ty: Ty::State, value: Val::ForState(for_op, idx) }());

    pub let root_y_ret<r, val>: RootRetVal(r, val) -> OutYield{ region: Reg::Orig(r), slot: 0, value: val }();
    pub let root_y_st1<r, c, val>: (!IsForBody(r), OrdCount("chain", r, 0, 0, 1), RootChainVal(r, c, val)) -> OutYield{ region: Reg::Orig(r), slot: 1, value: val }();
    pub let root_y_stn<r, n>: (!IsForBody(r), OrdCount("chain", r, 0, 0, n), std::int::less(1, n) == true) -> OutYield{ region: Reg::Orig(r), slot: 1, value: Val::JoinState(r) }();
    pub let root_join<r, n, k, c, idx, val>:
        (!IsForBody(r), OrdCount("chain", r, 0, 0, n), std::int::less(1, n) == true, OrdIdx("chain", r, 0, 0, k, c, idx), RootChainVal(r, c, val)) -> OutJoinState{ region: r, slot: idx, value: val }();
}

pub mod phase_need_val {
    pub let n_yield<r, s, v>: OutYield{ region: r, slot: s, value: v }() -> NeedVal(v);
    pub let n_linit<r, s, v>: OutLoopInit{ body: r, slot: s, value: v }() -> NeedVal(v);
    pub let n_swp<sw, h, o, t, v>: OutSwitch{ switch: sw, region: h, order: o, terminator: t, selector: v }() -> NeedVal(v);
    pub let n_swin<sw, s, v>: OutSwitchInput{ switch: sw, slot: s, value: v }() -> NeedVal(v);
    pub let n_for<f, h, o, b, lb, ub, st>: OutFor{ loop_op: f, region: h, order: o, body: b, lower: lb, upper: ub, step: st }() -> (NeedVal(lb), NeedVal(ub), NeedVal(st));
    pub let n_finit<f, s, v>: OutForInit{ loop_op: f, slot: s, value: v }() -> NeedVal(v);
    pub let n_rw<o, s, v>: OutRewriteOperand{ operation: o, slot: s, value: v }() -> NeedVal(v);
    pub let n_app<o, s, r>: OutAppendState{ operation: o, input: s, output: r }() -> NeedVal(s);
    pub let n_join<r, i, v>: OutJoinState{ region: r, slot: i, value: v }() -> NeedVal(v);
    pub let n_not<v, reg, c>: (NeedVal(v), v == Val::Not(reg, c)) -> NeedVal(c);
    pub let n_cmp<v, reg, p, a, b>: (NeedVal(v), v == Val::Cmp(reg, p, a, b)) -> (NeedVal(a), NeedVal(b));
    pub let n_sub<v, reg, a, b>: (NeedVal(v), v == Val::Sub(reg, a, b)) -> (NeedVal(a), NeedVal(b));
}

pub mod phase_emit_final {
    pub let s_const<v, reg, w, val>: (NeedVal(v), v == Val::IntConst(reg, w, val)) -> OutSynth{ value: v, region: reg, order: (0 - 100) }();
    pub let s_zero<v, reg, ty>: (NeedVal(v), v == Val::Zero(reg, ty)) -> OutSynth{ value: v, region: reg, order: (0 - 100) }();
    pub let s_not<v, reg, c, ord>: (NeedVal(v), v == Val::Not(reg, c), SynthOrd(v, ord)) -> OutSynth{ value: v, region: reg, order: ord }();
    pub let s_cmp<v, reg, p, a, b, ord>: (NeedVal(v), v == Val::Cmp(reg, p, a, b), SynthOrd(v, ord)) -> OutSynth{ value: v, region: reg, order: ord }();
    pub let s_sub<v, reg, a, b, ord>: (NeedVal(v), v == Val::Sub(reg, a, b), SynthOrd(v, ord)) -> OutSynth{ value: v, region: reg, order: ord }();
    pub let erase_op<r, o, e, b, lay, oid, k, pos, d, loc>:
        (TargetRegion(r, o, e), ir::Block(b, r, lay), ir::Operation{ id: std::ir::operation_key(oid), kind: k, placement: "block", container: b, position: pos, display: d, location: loc }(), !MovedOp(oid)) -> OutEraseOp(oid);
    pub let erase_blk<r, o, e, b, lay>: (TargetRegion(r, o, e), ir::Block(b, r, lay)) -> OutEraseBlock(b);
}


let order = std::schedule::sequence((
    std::schedule::Schedule::Rules(ord_next),
    std::schedule::Schedule::Rules(ord_links),
    std::schedule::saturate(ord_index),
    std::schedule::Schedule::Rules(ord_count),
));

pub let transform = std::schedule::sequence((
    std::schedule::saturate(phase_targets),
    std::schedule::Schedule::Rules(phase_active),
    std::schedule::Schedule::Rules(phase_ord_seed1),
    order,
    std::schedule::Schedule::Rules(phase_arms),
    std::schedule::Schedule::Rules(phase_homes_inner),
    std::schedule::Schedule::Rules(phase_homes),
    std::schedule::saturate(phase_home_derived),
    std::schedule::Schedule::Rules(phase_reg_tree),
    std::schedule::Schedule::Rules(phase_reg_tree2),
    std::schedule::saturate(phase_depths),
    std::schedule::Schedule::Rules(phase_depth_max),
    std::schedule::saturate(phase_vars),
    std::schedule::saturate(phase_static_writes),
    order,
    std::schedule::saturate(phase_flow),
    std::schedule::Schedule::Rules(phase_fill),
    std::schedule::Schedule::Rules(phase_fold_prep),
    std::schedule::Schedule::Rules(phase_fold_match),
    std::schedule::Schedule::Rules(phase_fold_diff),
    std::schedule::Schedule::Rules(phase_fold_dup),
    std::schedule::Schedule::Rules(phase_fold_keep),
    order,
    std::schedule::saturate(phase_fold_skip),
    std::schedule::Schedule::Rules(phase_emit_raw),
    std::schedule::saturate(phase_need_val),
    std::schedule::Schedule::Rules(phase_emit_final),
));
