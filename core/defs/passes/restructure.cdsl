// ── Phase 5: Undefined / missing fallbacks (Zero / LoopPort / IntConst(0)) ───
pub mod phase_fill {
    pub let linit_z<r, l, v, home, ty>: (LoopPortVar(r, l, v), LoopHome(r, l, home), VarTy(r, l, v, ty), !HasLoopInitVal(r, l, v)) -> LoopInitVal(r, l, v, Val::Zero(home, ty));
