        (StepSite(r, s, o, src, 0, term), BlockTerm(r, src, term, dialects::cfg::r#switch.kind), ir::Successor(std::ir::operation_key(term), slot, dst)) -> StepSiteArm(r, s, o, src, slot, slot, dst);
    pub let step_arm_loop<r, s, o, src, t, k, x, idx>:
        (StepSite(r, s, o, src, 1, t), OrdIdx("exit", r, src, 0, k, x, idx)) -> StepSiteArm(r, s, o, src, idx, x, x);
    pub let rp_for<outer, blk, for_op, pos, body, entry, preg>: (ForOpInfo(outer, blk, for_op, pos, body, entry), BlockHome(outer, blk, preg)) -> RegParent(Reg::Orig(body), preg);
    pub let rp_loop<r, l, preg>: LoopHome(r, l, preg) -> (RegParent(Reg::LoopBody(r, l), preg), ChildReg(Reg::LoopBody(r, l)));
    pub let rp_sese<r, s, h, arm, slot, dst, preg>:
        (BranchArm(r, s, h, arm, slot, dst), NodeHome(r, s, h, preg)) -> (RegParent(Reg::SeseArm(r, s, h, arm), preg), ChildReg(Reg::SeseArm(r, s, h, arm)));
    pub let rp_guard<r, s, o, k, m, preg>:
