;; The host publishes only successful existing ConstantFold callbacks whose
;; complete semantic expression is the same integer constant leaf.
(relation EQStaticIntegerFold (i64 BigInt String))
(relation EQStaticLayoutKind (String))
(EQStaticLayoutKind "layout.sizeof")
(EQStaticLayoutKind "layout.alignof")
(EQStaticLayoutKind "layout.offsetof")
(relation EQStaticLayoutExtra (i64))
(relation EQStaticLayoutFold (i64 String))
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQStaticLayoutKind kind)
       (= attr (Attribute op key)) (!= key "ty") (!= key "field") (!= key "operand_segment_sizes"))
      ((EQStaticLayoutExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQStaticLayoutKind kind)
       (= segments (Attribute op "operand_segment_sizes"))
       (!= segments (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))
      ((EQStaticLayoutExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQStaticLayoutKind kind)
       (!= kind "layout.offsetof") (= attr (Attribute op "field")))
      ((EQStaticLayoutExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQStaticLayoutKind kind)
       (EQStaticIntegerFold op width bits)
       (Result op 0 value) (not (Result op 1 extra))
       (not (Operand op slot input)) (not (OwnedRegion op slot region))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))))
      ((EQStaticLayoutFold op bits)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQStaticLayoutFold op bits) (not (EQStaticLayoutExtra op))
       (not (EQScalarManagedOp op)))
      ((let p (EQProposal invocation root scope root))
       (EQScopedAuthorized p) (EQPutOpKind p op "builtin.constant")
       (EQPutAttribute p op "value"
         (IntegerAttr (Ctor "$attr.wide") (eqsat-storage-width bits) (eqsat-storage-bits bits))))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQStaticLayoutFold op bits) (not (EQStaticLayoutExtra op))
       (not (EQScalarManagedOp op)) (= attr (Attribute op key)))
      ((EQEraseAttribute (EQProposal invocation root scope root) op key)) :ruleset EQscoped-edits)
