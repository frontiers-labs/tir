pub let shli<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    exec: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<w>> { bits::shl(lhs, rhs) },
    poison: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> Bool { bits::uge(rhs, bits::width_value<w>()) },

    interfaces: {
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

