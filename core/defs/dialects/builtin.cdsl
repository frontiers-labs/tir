let bitcast_rust = { widened: true };

pub let bitcast<w: Nat> = op {
    signature: (input: El<Bits<w>>) -> El<Bits<w>>,
    exec: |input: El<Bits<w>>| -> El<Bits<w>> { bits::bitcast<w, w>(input) },
    interfaces: {
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

pub let assume = op {
    signature: (condition: El<Bits<1>>) -> (),
    exec: |condition: El<Bits<1>>| -> () { () },
    requires: |condition: El<Bits<1>>| -> Bool { bits::ne(condition, bits::zero<1>()) },
};

pub let freeze<T: Type> = op {
    signature: (input: T) -> T,
    interfaces: {
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

pub let refine<T: Type> = op {
    signature: (input: T, predicate: El<Bits<1>>) -> T,
    exec: |input: T, predicate: El<Bits<1>>| -> T { input },
    interfaces: {
        Congruent: {},
    },
};

pub let module_end = op {
    signature: () -> (),
    interfaces: {
        Terminator: { successors: || -> List<std::ir::BlockId> { List::Nil<std::ir::BlockId> } },
    },
};

pub enum IntegerPredicate {
    Eq, Ne, Slt, Sgt, Sle, Sge, Ult, Ugt, Ule, Uge,
}

let CmpiAttributes: Type = { predicate: IntegerPredicate };

pub let cmpi<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<1>>,
    attributes: CmpiAttributes,
    exec: |self: CmpiAttributes, lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<1>> {
        bits::from_bool(match self.predicate {
            IntegerPredicate::Eq => bits::eq(lhs, rhs),
            IntegerPredicate::Ne => bits::ne(lhs, rhs),
            IntegerPredicate::Slt => bits::slt(lhs, rhs),
            IntegerPredicate::Sgt => bits::sgt(lhs, rhs),
            IntegerPredicate::Sle => bits::sle(lhs, rhs),
            IntegerPredicate::Sge => bits::sge(lhs, rhs),
            IntegerPredicate::Ult => bits::ult(lhs, rhs),
            IntegerPredicate::Ugt => bits::ugt(lhs, rhs),
            IntegerPredicate::Ule => bits::ule(lhs, rhs),
            IntegerPredicate::Uge => bits::uge(lhs, rhs),
        })
    },

    interfaces: {
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

pub let Integer<w: Nat> = Bits<w>;

let ModuleOperation = {
    signature: Type,
    regions: { body: Type },
};

pub let module<Params: Type, Results: Type, Input: Type, Trace: Type>: ModuleOperation = op {
    signature: () -> (),
    regions: { body: Region<Cfg, Params, Results, Input, Trace> },
};

let global_rust = {
    attributes: { sym_name: String },
    format: true,
    interfaces: Global,
};

pub let global<P: IrTy> = op {
    signature: () -> Ptr<P>,
    attributes: {
        sym_name: String,
        sym_visibility: Optional<String>,
        kind: Nat,
        size: Nat,
        storage: GlobalStorage<kind, size>,
        size_bound: Bound<18446744073709551615, 0, size>,
        section: Optional<String>,
        relocations: Optional<List<{ offset: Nat, symbol: String, addend: Int, width: Nat }>>,
        symbol_differences: DifferenceSet<kind, size>,
    },
    interfaces: {
        Symbol: {
                symbol_name: || -> String { self.sym_name },
                symbol_signature: || -> Option<List<IrTy>> { option::none<List<IrTy>> },
                symbol_result_type: || -> Option<IrTy> { option::none<IrTy> },
                symbol_visibility: || -> Visibility {
                    if option::get_or(self.sym_visibility, "") == "private" {
                        Visibility::Private
                    } else {
                        Visibility::Public
                    }
                },
                is_definition: || -> Bool { self.kind != 0 },
            },
    },
};

pub let fn_to_ptr<Args: List<IrTy>, Ret: IrTy, E: EffectSet, P: IrTy> = op {
    signature: (callee: Function<Args, std::list::singleton<IrTy>(Ret), E>) -> Ptr<P>,
    interfaces: {
        Pure: {},
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

pub let ptr_to_fn<Args: List<IrTy>, Ret: IrTy, E: EffectSet, P: IrTy> = op {
    signature: (address: Ptr<P>) -> Function<Args, std::list::singleton<IrTy>(Ret), E>,
    interfaces: {
        Pure: {},
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};



pub let InterpInterface<V: Type, S: Type, R: Type> = {
    evaluate: (List<V>, S) -> (R, S),
};

pub let MemoryState = State<ExclusiveResource<"memory">>;

pub let make_tuple = {
    rust_name: "MakeTupleOp",
    name: "make_tuple",
    dialect: "builtin",
    operands: { elements: "*_" },
    results: { result: "tuple<_>" },
    interfaces: Speculatable,
    state: "none",
};

pub let tuple_get = {
    rust_name: "TupleGetOp",
    name: "tuple_get",
    dialect: "builtin",
    operands: { tuple: "tuple<_>" },
    results: { result: "_" },
    attributes: { index: "UInt" },
    interfaces: Speculatable,
    state: "none",
};
