pub enum Bound<Size: Nat, Offset: Nat, Width: Nat> {
    Within<Offset: Nat, Width: Nat, Rest: Nat>: Bound<Offset + Width + Rest, Offset, Width>,
}
pub let Alignment: Type = {
    log2: Nat,
    bound: Bound<63, log2, 0>,
};

pub enum DifferenceWidth<Width: Nat> {
    W1: DifferenceWidth<1>,
    W2: DifferenceWidth<2>,
    W4: DifferenceWidth<4>,
    W8: DifferenceWidth<8>,
}
pub let SymbolDifference<Size: Nat>: Type = {
    offset: Nat,
    width: Nat,
    width_proof: DifferenceWidth<width>,
    bounds: Bound<Size, offset, width>,
    symbol: String,
    base: String,
};
pub enum GlobalStorage<Kind: Nat, Size: Nat> {
    External: GlobalStorage<0, 0>,
    Bytes<Size: Nat>(Alignment, Vec<El<Bits<8>>, Size>): GlobalStorage<1, Size>,
    Zero<Size: Nat>(Alignment): GlobalStorage<2, Size>,
}
pub enum DifferenceSet<Kind: Nat, Size: Nat> {
    None<Kind: Nat, Size: Nat>: DifferenceSet<Kind, Size>,
    Bytes<Size: Nat>(List<SymbolDifference<Size>>): DifferenceSet<1, Size>,
    Zero<Size: Nat>(List<SymbolDifference<Size>>): DifferenceSet<2, Size>,
}

pub enum Visibility {
    Public,
    Private,
}
pub interface SymbolInterface<Ty: Type> {
    symbol_name: () -> String,
    symbol_signature: () -> Option<List<Ty>>,
    symbol_result_type: () -> Option<Ty>,
    symbol_visibility: () -> Visibility,
    is_definition: () -> Bool,
}

use SymbolInterface as Symbol;
use PureInterface as Pure;

pub interface Terminator<Block: Type> { successors: () -> List<Block> }

pub interface ConstantLike<w: Nat> { constant_value: () -> El<Bits<w>> }

pub interface PureInterface {}

pub interface Additive {}

pub interface Subtractive {}

pub interface IntegerArithmetic {}

pub interface SameOperandAndResultType {}

pub interface Congruent {}

pub interface Commutative { is_commutative: () -> Bool }

pub interface Speculatable { is_speculatable: () -> Bool }

pub interface OpCost { cost: () -> El<Bits<32>> }

let rust_interfaces = {
    Additive: "Additive",
    Commutative: "Commutative",
    Congruent: "Congruent",
    ConstantLike: "ConstantLike",
    IntegerArithmetic: "IntegerArithmetic",
    OpCost: "OpCost",
    PureInterface: "Pure",
    SameOperandAndResultType: "SameOperandAndResultType",
    Speculatable: "Speculatable",
    Subtractive: "Subtractive",
    SymbolInterface: "Symbol",
    Terminator: "Terminator",
};

pub enum StateResource {
    Memory,
}

pub enum AggregateKind {
    Struct,
    Union,
    Variant,
}

let ConstantAttributes: Type = { value: Int };
let constant_rust = { interfaces: { ConstantLike: true } };

let ConstantOperation<w: Nat> = {
    signature: Type,
    attributes: Type,
    exec: (ConstantAttributes) -> El<Bits<w>>,
    interfaces: {
        ConstantLike: ConstantLike<w>,
        Speculatable: Speculatable,
    },
};

pub let constant<w: Nat>: ConstantOperation<w> = op {
    signature: () -> El<Bits<w>>,
    attributes: ConstantAttributes,
    exec: fn (self: ConstantAttributes) -> El<Bits<w>> { bits::from_int<w>(self.value) },

    interfaces: {
        ConstantLike: { constant_value: fn () -> El<Bits<w>> { bits::from_int<w>(self.value) } },
        Speculatable: { is_speculatable: fn () -> Bool { true } },
    },
};

let AddiAttributes: Type = { nsw: Optional<Bool>, nuw: Optional<Bool> };

let AddiOperation<w: Nat> = {
    signature: Type,
    attributes: Type,
    exec: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>,
    poison: (AddiAttributes, El<Bits<w>>, El<Bits<w>>) -> Bool,
    interfaces: {
        Additive: Additive,
        Commutative: Commutative,
        SameOperandAndResultType: SameOperandAndResultType,
        IntegerArithmetic: IntegerArithmetic,
        Speculatable: Speculatable,
    },
};

pub let addi<w: Nat>: AddiOperation<w> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    attributes: AddiAttributes,
    exec: fn (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>> {
        bits::add_wrapping(lhs, rhs)
    },
    poison: fn (self: AddiAttributes, lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> Bool {
        (option::get_or(self.nsw, false) && bits::signed_add_overflows(lhs, rhs)) ||
        (option::get_or(self.nuw, false) && bits::unsigned_add_overflows(lhs, rhs))
    },

    interfaces: {
        Additive: {},
        Commutative: { is_commutative: fn () -> Bool { true } },
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: fn () -> Bool { true } },
    },
};

let SubiAttributes: Type = { nsw: Optional<Bool>, nuw: Optional<Bool> };

let SubiOperation<w: Nat> = {
    signature: Type,
    attributes: Type,
    exec: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>,
    poison: (SubiAttributes, El<Bits<w>>, El<Bits<w>>) -> Bool,
    interfaces: {
        Subtractive: Subtractive,
        SameOperandAndResultType: SameOperandAndResultType,
        IntegerArithmetic: IntegerArithmetic,
        Speculatable: Speculatable,
    },
};

pub let subi<w: Nat>: SubiOperation<w> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    attributes: SubiAttributes,
    exec: fn (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>> { bits::sub_wrapping(lhs, rhs) },
    poison: fn (self: SubiAttributes, lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> Bool {
        (option::get_or(self.nsw, false) && bits::signed_sub_overflows(lhs, rhs)) ||
        (option::get_or(self.nuw, false) && bits::unsigned_sub_overflows(lhs, rhs))
    },

    interfaces: {
        Subtractive: {},
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: fn () -> Bool { true } },
    },
};

let muli_rust = { interfaces: { OpCost: true } };

let MuliOperation<w: Nat> = {
    signature: Type,
    exec: (El<Bits<w>>, El<Bits<w>>) -> El<Bits<w>>,
    interfaces: {
        Commutative: Commutative,
        SameOperandAndResultType: SameOperandAndResultType,
        IntegerArithmetic: IntegerArithmetic,
        Speculatable: Speculatable,
        OpCost: OpCost,
    },
};

pub let muli<w: Nat>: MuliOperation<w> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    exec: fn (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>> { bits::mul_wrapping(lhs, rhs) },

    interfaces: {
        Commutative: { is_commutative: fn () -> Bool { true } },
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: fn () -> Bool { true } },
        OpCost: { cost: fn () -> El<Bits<32>> { bits::literal<32>(4) } },
    },
};

