let AssumeOperation = {
    signature: Type,
    exec: (El<Bits<1>>) -> (),
    requires: (El<Bits<1>>) -> Bool,
};

pub let assume: AssumeOperation = op {
    signature: (condition: El<Bits<1>>) -> (),
    exec: fn (condition: El<Bits<1>>) -> () { () },
    requires: fn (condition: El<Bits<1>>) -> Bool { bits::ne(condition, bits::zero<1>()) },
};

