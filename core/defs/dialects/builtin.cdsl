        Congruent: Congruent,
    },
};

pub let refine<T: Type>: RefineOperation<T> = op {
    signature: (input: T, predicate: El<Bits<1>>) -> T,
    exec: fn (input: T, predicate: El<Bits<1>>) -> T { input },
    interfaces: {
        Congruent: {},
    },
};

let module_end_rust = { interfaces: { Terminator: true } };

pub let module_end<Block: Type> = op {
    signature: () -> (),
