pub enum Bound<Size: Nat, Offset: Nat, Width: Nat> {
    Within<Offset: Nat, Width: Nat, Rest: Nat>: Bound<Offset + Width + Rest, Offset, Width>,
}
pub let Alignment: Type = {
    log2: Nat,
    bound: Bound<63, log2, 0>,
};

pub enum DifferenceWidth<Width: Nat> {
    W1: DifferenceWidth<1>,
    W2: DifferenceWidth<2>,
    W4: DifferenceWidth<4>,
    W8: DifferenceWidth<8>,
}
pub let SymbolDifference<Size: Nat>: Type = {
    offset: Nat,
    width: Nat,
    width_proof: DifferenceWidth<width>,
    bounds: Bound<Size, offset, width>,
    symbol: String,
    base: String,
};
pub enum GlobalStorage<Kind: Nat, Size: Nat> {
    External: GlobalStorage<0, 0>,
    Bytes<Size: Nat>(Alignment, Vec<El<Bits<8>>, Size>): GlobalStorage<1, Size>,
    Zero<Size: Nat>(Alignment): GlobalStorage<2, Size>,
}
pub enum DifferenceSet<Kind: Nat, Size: Nat> {
    None<Kind: Nat, Size: Nat>: DifferenceSet<Kind, Size>,
    Bytes<Size: Nat>(List<SymbolDifference<Size>>): DifferenceSet<1, Size>,
    Zero<Size: Nat>(List<SymbolDifference<Size>>): DifferenceSet<2, Size>,
}

pub use std::ir::interfaces::*;
use PureInterface as Pure;

pub enum StateResource {
    Memory,
}

pub enum AggregateKind {
    Struct,
    Union,
    Variant,
}

let ConstantAttributes: Type = { value: Int };

pub let constant<w: Nat> = op {
    signature: () -> El<Bits<w>>,
    attributes: ConstantAttributes,
    exec: |self: ConstantAttributes| -> El<Bits<w>> { bits::from_int<w>(self.value) },

    interfaces: {
        ConstantLike: { constant_value: || -> El<Bits<w>> { bits::from_int<w>(self.value) } },
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

let AddiAttributes: Type = { nsw: Optional<Bool>, nuw: Optional<Bool> };

pub let addi<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    attributes: AddiAttributes,
    exec: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<w>> {
        bits::add_wrapping(lhs, rhs)
    },
    poison: |self: AddiAttributes, lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> Bool {
        (option::get_or(self.nsw, false) && bits::signed_add_overflows(lhs, rhs)) ||
        (option::get_or(self.nuw, false) && bits::unsigned_add_overflows(lhs, rhs))
    },

    interfaces: {
        Additive: {},
        Commutative: { is_commutative: || -> Bool { true } },
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

let SubiAttributes: Type = { nsw: Optional<Bool>, nuw: Optional<Bool> };

pub let subi<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    attributes: SubiAttributes,
    exec: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<w>> { bits::sub_wrapping(lhs, rhs) },
    poison: |self: SubiAttributes, lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> Bool {
        (option::get_or(self.nsw, false) && bits::signed_sub_overflows(lhs, rhs)) ||
        (option::get_or(self.nuw, false) && bits::unsigned_sub_overflows(lhs, rhs))
    },

    interfaces: {
        Subtractive: {},
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: || -> Bool { true } },
    },
};

pub let muli<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    exec: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<w>> { bits::mul_wrapping(lhs, rhs) },

    interfaces: {
        Commutative: { is_commutative: || -> Bool { true } },
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
        Speculatable: { is_speculatable: || -> Bool { true } },
        OpCost: { cost: || -> El<Bits<32>> { bits::literal<32>(4) } },
    },
};

pub let divsi<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    exec: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<w>> { bits::sdiv(lhs, rhs) },
    requires: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> Bool { bits::signed_div_defined(lhs, rhs) },

    interfaces: {
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
    },
};

pub let divui<w: Nat> = op {
    signature: (lhs: El<Bits<w>>, rhs: El<Bits<w>>) -> El<Bits<w>>,
    exec: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> El<Bits<w>> { bits::udiv(lhs, rhs) },
    requires: |lhs: El<Bits<w>>, rhs: El<Bits<w>>| -> Bool { bits::ne(rhs, bits::zero<w>()) },

    interfaces: {
        SameOperandAndResultType: {},
        IntegerArithmetic: {},
    },
};

