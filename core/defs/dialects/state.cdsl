use std::core::*;
use std::ir::State;

pub let entry_state = op {
    signature: () -> (state: ..State),
    custom_format: true,
    macro_def: true,
};

pub let join = op {
    signature: (states: ..State) -> (state: ..State),
    macro_def: true,
};

pub let split = op {
    signature: (state: ..State) -> (states: ..State),
    macro_def: true,
};
