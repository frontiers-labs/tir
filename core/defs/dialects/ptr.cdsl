use std::core::*;
use std::ir::{Bits, PointerPred, Predicate, Ptr, State, TypeAttr, UInt};

pub let alloca<P> = op {
    signature: () -> (result: Ptr<P>, state: ..State),
    attributes: { size: UInt, align: UInt },
    interfaces: (PromotableAllocation,),
    macro_def: true,
};

pub let null<P> = op {
    signature: () -> (result: Ptr<P>),
    interfaces: (ConstantLike,),
    macro_def: true,
};

pub let cmp<P0, P1> = op {
    signature: (lhs: Ptr<P0>, rhs: Ptr<P1>) -> (result: Bits<1>),
    attributes: { predicate: Predicate<PointerPred> },
    macro_def: true,
};

pub let ptradd<P0, W: Nat, P1> = op {
    rust_name: "PtrAddOp",
    signature: (base: Ptr<P0>, offset: Bits<W>) -> (result: Ptr<P1>),
    interfaces: (Additive,),
    macro_def: true,
};

pub let ptrdiff<P0, P1, W: Nat> = op {
    rust_name: "PtrDiffOp",
    signature: (lhs: Ptr<P0>, rhs: Ptr<P1>) -> (result: Bits<W>),
    interfaces: (Subtractive,),
    macro_def: true,
};

pub let disjoint<P0, W0: Nat, P1, W1: Nat> = op {
    signature: (lhs: Ptr<P0>, lhs_size: Bits<W0>, rhs: Ptr<P1>, rhs_size: Bits<W1>) -> (result: Bits<1>),
    macro_def: true,
};

pub let load<P, T> = op {
    signature: (ptr: Ptr<P>, state: ..State) -> (result: T, out_state: ..State),
    interfaces: (MemoryRead, ResourceEffects),
    macro_def: true,
};

pub let store<T, P> = op {
    signature: (value: T, ptr: Ptr<P>, state: ..State) -> (out_state: ..State),
    interfaces: (MemoryWrite, ResourceEffects),
    macro_def: true,
};

pub let memcpy<P0, P1> = op {
    signature: (destination: Ptr<P0>, source: Ptr<P1>, size: Bits<64>, state: ..State) -> (out_state: ..State),
    interfaces: (ResourceEffects,),
    macro_def: true,
};

pub let memset<P> = op {
    signature: (destination: Ptr<P>, value: Bits<8>, size: Bits<64>, state: ..State) -> (out_state: ..State),
    interfaces: (MemoryWrite, ResourceEffects),
    macro_def: true,
};

pub let field<P0, P1> = op {
    signature: (base: Ptr<P0>) -> (result: Ptr<P1>),
    attributes: { ty: TypeAttr, field: String },
    interfaces: (Speculatable,),
    macro_def: true,
};

pub let copy<P0, P1> = op {
    signature: (destination: Ptr<P0>, source: Ptr<P1>, state: ..State) -> (out_state: ..State),
    attributes: { ty: TypeAttr },
    interfaces: (ResourceEffects, Congruent),
    macro_def: true,
};
