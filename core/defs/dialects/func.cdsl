use std::ir::interfaces::*;

pub let call = {
    rust_name: "CallOp",
    name: "call",
    dialect: "func",
    operands: { callee: "fn<_, _>", args: "*_" },
    results: { result: "_" },
    interfaces: (Apply, ResourceEffects),
    custom_format: true,
    state: "in_out",
};

pub let declare = {
    rust_name: "DeclareOp",
    name: "declare",
    dialect: "func",
    results: { result: "fn<_, _>" },
    attributes: { sym_name: "Str" },
    interfaces: (Symbol, Callable),
    custom_format: true,
    state: "none",
};

pub let func = {
    rust_name: "FuncOp",
    name: "func",
    dialect: "func",
    results: { result: "fn<_, _>" },
    attributes: { sym_name: "Str", ret_type: "Type" },
    interfaces: (Symbol, Callable),
    regions: { body: { kind: "Any", variadic: false } },
    custom_format: true,
    state: "none",
};

pub let r#return = {
    rust_name: "ReturnOp",
    name: "return",
    dialect: "func",
    operands: { value: "?_" },
    interfaces: Terminator,
    state: "in",
};
