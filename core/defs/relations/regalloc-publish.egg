;; Saturate plan, check, ready, delete, install in that order. Never rerun the
;; source indexes between delete and install. The caller stages a cloned engine
;; and rebuilds every structural index before verification or publication.
(ruleset ra-publish-plan)
(ruleset ra-publish-check)
(ruleset ra-publish-ready)
(ruleset ra-publish-delete)
(ruleset ra-publish-install)
(relation RASelectedCandidate (i64 i64 i64))
(relation RAIntegerType (TypeExpr))
(relation RAPublishCandidate (i64 i64 i64))
(relation RAPublishReady (i64 i64 i64))
(relation RAPublished (i64 i64 i64))
(relation RAPublishError (i64 i64 i64 String))
(function RAPublishValues (i64 i64) RAIds :merge (set-union old new))
(function RAPublishOps (i64 i64) RAIds :merge (set-union old new))
(function RAPublishControlValues (i64 i64) RAIds :merge (set-union old new))
(function RAPublishSegmentDirections (i64 i64 i64) RAIds :merge (set-union old new))
(function RAPublishErrors (i64 i64) RAIds :merge (set-union old new))
(function RAPublishedBlock (i64 i64 i64) i64 :no-merge)
(function RAPublishAllocatedBlocks (i64 i64) RAIds :merge (set-union old new))
(function RAPublishEarlierBlocks (i64 i64 i64) RAIds :merge (set-union old new))
(relation RAPublishKind (i64 i64 i64 String))
(relation RAPublishOperand (i64 i64 i64 i64 i64))
(relation RAPublishDefinition (i64 i64 i64 Definition))
(relation RAPublishAttribute (i64 i64 i64 String Attr))
(relation RAPublishSuccessor (i64 i64 i64 i64 i64))
(relation RAPublishParamScan (i64 i64 i64 i64))
(relation RAPublishNativeScan (i64 i64 i64 String i64 i64))
(function RAPublishSegments (i64 i64 i64 String i64) AttrList :no-merge)
(function RAPublishAssignments (i64 i64 i64 i64) AttrList :no-merge)
(relation RAPublishStateKind (String))
(relation RAPublishRetiredOp (i64 i64 i64))
(relation RAPublishRetiredRegion (i64 i64 i64))
(function RAPublishSwitchCases (i64 i64 i64 i64) AttrList :no-merge)
(function RAPublishSwitchDests (i64 i64 i64 i64) AttrList :no-merge)
(function RAPublishSwitchCounts (i64 i64 i64 i64) AttrList :no-merge)
(rule ((RARequest inv root))
      ((RAPublishStateKind "state.entry_state")
       (RAPublishStateKind "state.join")
       (RAPublishStateKind "state.split")) :ruleset ra-publish-plan)
(function RAPublishOperandSlots (i64 i64 i64) RAIds :merge (set-union old new))
(function RAPublishStateSlots (i64 i64 i64) RAIds :merge (set-union old new))

(rule ((RASelectedCandidate inv f candidate) (RACFGFunction inv f) (RAControlComplete inv f candidate)
       (RABindingsComplete inv f) (RAColorComplete inv f candidate)
       (RATransferComplete inv f candidate))
      ((RAPublishCandidate inv f candidate)
       (set (RAPublishErrors inv f) (set-empty))
       (set (RAPublishOps inv f) (set-empty))
       (set (RAPublishValues inv f) (set-empty))
       (set (RAPublishControlValues inv f) (set-empty))
       (RAPublishParamScan inv f 0 0)) :ruleset ra-publish-plan)
(rule ((RASelectedCandidate inv f candidate) (RAGraphFunction inv f)
       (RAControlComplete inv f candidate) (RABindingsComplete inv f))
      ((RAPublishCandidate inv f candidate)
       (set (RAPublishErrors inv f) (set-empty))
       (set (RAPublishOps inv f) (set-empty))
       (set (RAPublishValues inv f) (set-empty))
       (set (RAPublishControlValues inv f) (set-empty))
       (set (RAPublishAllocatedBlocks inv f) (set-empty))
       (set (RAPublishAssignments inv f candidate 0) (ANil))
       (RAPublishParamScan inv f 0 0)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAGraphFunction inv f) (RABlock inv f logical)
       (set-not-contains (RAPublishAllocatedBlocks inv f) logical))
      ((set (RAPublishedBlock inv f logical) (fresh-ir-id))
       (set (RAPublishAllocatedBlocks inv f) (set-of logical))
       (set (RAPublishEarlierBlocks inv f logical) (set-empty))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f) (RABlock inv f logical))
      ((set (RAPublishedBlock inv f logical) logical)
       (set (RAPublishEarlierBlocks inv f logical) (set-empty))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f) (RAEntry inv f block)
       (BlockParam block slot value))
      ((RAPublishDefinition inv f value (BlockParamDef block slot))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RABlock inv f logical)
       (RAEntry inv f entry) (!= logical entry)
       (RABlock inv f earlier) (!= earlier entry) (< earlier logical))
      ((set (RAPublishEarlierBlocks inv f logical) (set-of earlier))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RABlock inv f logical)
       (RAEntry inv f entry) (!= logical entry))
      ((set (RAPublishEarlierBlocks inv f logical) (set-of entry))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAFunction inv f region)
       (RAPublishParamScan inv f old slot) (RegionParam region old value)
       (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((RAPublishParamScan inv f (+ old 1) slot)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAFunction inv f region)
       (RAPublishParamScan inv f old slot) (RegionParam region old value)
       (= ty (ValueType value)) (!= ty (Apply (Ctor "son.control") (TNil)))
       (RAEntry inv f logical) (= block (RAPublishedBlock inv f logical)))
      ((RAPublishDefinition inv f value (BlockParamDef block slot))
       (RAPublishParamScan inv f (+ old 1) (+ slot 1))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RABinding inv f logical slot value)
       (= block (RAPublishedBlock inv f logical)))
      ((RAPublishDefinition inv f value (BlockParamDef block slot))) :ruleset ra-publish-plan)

(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (RAAt inv f candidate logical op point) (TMDLOpcode inv kind local dialect))
      ((RAPublishKind inv f op kind)
       (set (RAPublishSegmentDirections inv f op) (set-empty))
       (RAPublishNativeScan inv f op "in" 0 0)
       (RAPublishNativeScan inv f op "out" 0 0)) :ruleset ra-publish-plan)
(rule ((RAPublishNativeScan inv f op direction old slot)
       (RANativeRead inv f op direction old value)
       (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((RAPublishNativeScan inv f op direction (+ old 1) slot)) :ruleset ra-publish-plan)
(rule ((RAPublishNativeScan inv f op "in" old slot)
       (RANativeRead inv f op "in" old value)
       (= ty (ValueType value)) (!= ty (Apply (Ctor "son.control") (TNil))))
      ((RAPublishOperand inv f op slot value)
       (RAPublishNativeScan inv f op "in" (+ old 1) (+ slot 1))) :ruleset ra-publish-plan)
(rule ((RAPublishNativeScan inv f op "out" old slot)
       (RANativeRead inv f op "out" old value)
       (= ty (ValueType value)) (!= ty (Apply (Ctor "son.control") (TNil))))
      ((RAPublishDefinition inv f value (ResultDef op slot))
       (RAPublishNativeScan inv f op "out" (+ old 1) (+ slot 1))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (RAPublishKind inv f op kind)
       (TMDLOpcode inv kind local dialect) (TMDLInstructionSlotCount inv kind direction count))
      ((set (RAPublishSegments inv f op direction count) (ANil))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic true)
       (= tail (RAPublishSegments inv f op direction (+ field 1))) (RAIntegerType ty))
      ((set (RAPublishSegments inv f op direction field)
            (ACons (IntegerAttr ty 64 (i64-hex 0)) tail))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic false)
       (RANativeSegment inv f op direction field size)
       (= tail (RAPublishSegments inv f op direction (+ field 1))) (RAIntegerType ty))
      ((set (RAPublishSegments inv f op direction field)
            (ACons (IntegerAttr ty 64 (i64-hex size)) tail))) :ruleset ra-publish-plan)
(rule ((= xs (RAPublishSegments inv f op "in" 0)))
      ((RAPublishAttribute inv f op "operand_segment_sizes" (ListAttr xs))
       (set (RAPublishSegmentDirections inv f op) (set-of 0))) :ruleset ra-publish-plan)
(rule ((= xs (RAPublishSegments inv f op "out" 0)))
      ((RAPublishAttribute inv f op "result_segment_sizes" (ListAttr xs))
       (set (RAPublishSegmentDirections inv f op) (set-of 1))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate)
       (RAHardwareSlot inv f op direction name slot value required)
       (RACFGFunction inv f) (RAPublishKind inv f op kind) (RAChosenRegister inv f candidate value class index) (TMDLClassDialect inv class dialect))
      ((RAPublishAttribute inv f op name (PhysicalRegisterAttr dialect class index))) :ruleset ra-publish-plan)

(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (RAAt inv f candidate logical op point) (RAPublishStateKind kind))
      ((RAPublishKind inv f op kind)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (RAPublishStateKind kind) (RAPublishKind inv f op kind)
       (= value (Operand op slot)))
      ((RAPublishOperand inv f op slot value)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (RAPublishStateKind kind) (RAPublishKind inv f op kind) (Result op slot value))
      ((RAPublishDefinition inv f value (ResultDef op slot))) :ruleset ra-publish-plan)

(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f)
       (RACFGSource inv f op block point) (RATerminator inv f op block)
       (RASource inv f op kind))
      ((RAPublishKind inv f op kind)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f)
       (RATerminator inv f op block) (= value (Operand op slot)))
      ((RAPublishOperand inv f op slot value)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAGraphFunction inv f) (RAJump inv f op logical dest)
       (= block (RAPublishedBlock inv f dest)))
      ((RAPublishKind inv f op "cfg.br")
       (RAPublishAttribute inv f op "dest" (BlockAttr block))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAGraphFunction inv f) (RAIncoming inv f op dest slot joined incoming))
      ((RAPublishOperand inv f op slot incoming)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAGraphFunction inv f)
       (RABranch inv f op logical predicate taken fallthrough)
       (= trueBlock (RAPublishedBlock inv f taken))
       (= falseBlock (RAPublishedBlock inv f fallthrough)) (RAIntegerType ty))
      ((RAPublishKind inv f op "cfg.cond_br") (RAPublishOperand inv f op 0 predicate)
       (RAPublishAttribute inv f op "true_dest" (BlockAttr trueBlock))
       (RAPublishAttribute inv f op "false_dest" (BlockAttr falseBlock))
       (RAPublishAttribute inv f op "operand_segment_sizes"
        (ListAttr (ACons (IntegerAttr ty 64 (i64-hex 1))
                  (ACons (IntegerAttr ty 64 (i64-hex 0))
                         (ACons (IntegerAttr ty 64 (i64-hex 0)) (ANil))))))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAReturn inv f op logical))
      ((RAPublishKind inv f op "func.return")) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAReturnValue inv f op slot value))
      ((RAPublishOperand inv f op slot value)) :ruleset ra-publish-plan)

(rule ((RAPublishCandidate inv f candidate) (RASwitch inv f op logical predicate default)
       (RASwitchOwner inv f op owner) (= region (GammaDefaultArm owner))
       (= count (RegionSlot region)) (= block (RAPublishedBlock inv f default)) (RAIntegerType ty))
      ((RAPublishKind inv f op "cfg.switch") (RAPublishOperand inv f op 0 predicate)
       (RAPublishSuccessor inv f op count block)
       (set (RAPublishSwitchCases inv f op count) (ANil))
       (set (RAPublishSwitchDests inv f op count) (ACons (BlockAttr block) (ANil)))
       (set (RAPublishSwitchCounts inv f op count)
            (ACons (IntegerAttr ty 64 (i64-hex 0)) (ANil)))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASwitchCase inv f op slot case dest)
       (= cases (RAPublishSwitchCases inv f op (+ slot 1)))
       (= dests (RAPublishSwitchDests inv f op (+ slot 1)))
       (= counts (RAPublishSwitchCounts inv f op (+ slot 1)))
       (= block (RAPublishedBlock inv f dest)) (RAIntegerType ty)
       (= low (nat-i64 (& case (bigint 9223372036854775807))))
       (= high (nat-i64 (>> case 63))) (= bits (| low (* high -9223372036854775808))))
      ((set (RAPublishSwitchCases inv f op slot) (ACons (IntegerAttr ty 64 (i64-hex bits)) cases))
       (RAPublishSuccessor inv f op slot block)
       (set (RAPublishSwitchDests inv f op slot) (ACons (BlockAttr block) dests))
       (set (RAPublishSwitchCounts inv f op slot) (ACons (IntegerAttr ty 64 (i64-hex 0)) counts)))
      :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASwitch inv f op logical predicate default)
       (= cases (RAPublishSwitchCases inv f op 0)) (= dests (RAPublishSwitchDests inv f op 0))
       (= counts (RAPublishSwitchCounts inv f op 0)) (RAIntegerType ty))
      ((RAPublishAttribute inv f op "cases" (ListAttr cases))
       (RAPublishAttribute inv f op "dests" (ListAttr dests))
       (RAPublishAttribute inv f op "arg_counts" (ListAttr counts))
       (RAPublishAttribute inv f op "operand_segment_sizes"
         (ListAttr (ACons (IntegerAttr ty 64 (i64-hex 1))
                   (ACons (IntegerAttr ty 64 (i64-hex 0)) (ANil)))))) :ruleset ra-publish-plan)

(rule ((RAPublishKind inv f op kind))
      ((set (RAPublishOperandSlots inv f op) (set-empty))
       (set (RAPublishStateSlots inv f op) (set-empty))) :ruleset ra-publish-plan)
(rule ((RAPublishOperand inv f op slot value))
      ((set (RAPublishOperandSlots inv f op) (set-of slot))) :ruleset ra-publish-plan)
(rule ((RAPublishOperand inv f op slot value)
       (= (ValueType value) (Apply (Ctor "builtin.state") args)))
      ((set (RAPublishStateSlots inv f op) (set-of slot))) :ruleset ra-publish-plan)
(rule ((RAPublishKind inv f op "cfg.br") (RAIntegerType ty)
       (= count (set-length (RAPublishOperandSlots inv f op))))
      ((RAPublishAttribute inv f op "operand_segment_sizes"
        (ListAttr (ACons (IntegerAttr ty 64 (i64-hex count)) (ANil))))) :ruleset ra-publish-check)
(rule ((RAPublishKind inv f op "func.return") (RAIntegerType ty)
       (= count (set-length (RAPublishOperandSlots inv f op)))
       (= states (set-length (RAPublishStateSlots inv f op))))
      ((RAPublishAttribute inv f op "operand_segment_sizes"
        (ListAttr (ACons (IntegerAttr ty 64 (i64-hex (- count states)))
                  (ACons (IntegerAttr ty 64 (i64-hex states)) (ANil)))))) :ruleset ra-publish-check)

(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f) (= values (RAColorValues inv f candidate)))
      ((set (RAPublishAssignments inv f candidate (set-length values)) (ANil))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f) (= values (RAColorValues inv f candidate))
       (= tail (RAPublishAssignments inv f candidate next)) (> next 0) (= slot (- next 1))
       (< slot (set-length values)) (>= slot 0) (= value (set-get values slot))
       (RAChosenRegister inv f candidate value class index) (TMDLClassDialect inv class dialect))
      ((set (RAPublishAssignments inv f candidate slot)
            (ACons (AssignedRegisterAttr value dialect class index) tail))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RACFGFunction inv f) (= xs (RAPublishAssignments inv f candidate 0)))
      ((RAPublishAttribute inv f f "assignment" (ListAttr xs))) :ruleset ra-publish-plan)

(rule ((RAPublishDefinition inv f value def))
      ((set (RAPublishValues inv f) (set-of value))) :ruleset ra-publish-plan)
(rule ((RAPublishKind inv f op kind))
      ((set (RAPublishOps inv f) (set-of op))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate)
       (!= (RAPublishOps inv f) (RAScheduledOps inv f candidate)))
      ((RAPublishError inv f f "scheduled operations lack native publication descriptors")) :ruleset ra-publish-check)
(rule ((RAPublishCandidate inv f candidate) (RANode inv f op kind)
       (set-contains (RAScheduledOps inv f candidate) op)
       (set-not-contains (RAPublishOps inv f) op))
      ((RAPublishError inv f op (+ "scheduled operation lacks publication descriptor: " kind)))
      :ruleset ra-publish-check)
(rule ((RAPublishCandidate inv f candidate) (RAFunction inv f region)
       (RegionParam region slot value)
       (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((set (RAPublishControlValues inv f) (set-of value))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (Result op slot value) (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((set (RAPublishControlValues inv f) (set-of value))) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RASource inv f op kind)
       (RAPublishKind inv f op kind) (TMDLOpcode inv kind local dialect)
       (!= (set-length (RAPublishSegmentDirections inv f op)) 2))
      ((RAPublishError inv f op "native segment publication is incomplete")) :ruleset ra-publish-check)
(rule ((RAPublishCandidate inv f candidate) (RAGraphFunction inv f) (RAFunction inv f root)
       (RegionUnder region root) (!= region root))
      ((RAPublishRetiredRegion inv f region)) :ruleset ra-publish-plan)
(rule ((RAPublishCandidate inv f candidate) (RAGraphFunction inv f) (RAFunction inv f root)
       (OpUnderRegion root op) (set-not-contains (RAScheduledOps inv f candidate) op))
      ((RAPublishRetiredOp inv f op)) :ruleset ra-publish-plan)
(rule ((RAPublishAttribute inv f op name first) (RAPublishAttribute inv f op name second)
       (!= first second))
      ((RAPublishError inv f op "conflicting published attributes")) :ruleset ra-publish-check)
(rule ((RAPublishError inv f entity message))
      ((set (RAPublishErrors inv f) (set-of entity))) :ruleset ra-publish-check)
(rule ((RAPublishCandidate inv f candidate) (= (set-length (RAPublishErrors inv f)) 0)
       (= assignment (RAPublishAssignments inv f candidate 0)))
      ((RAPublishReady inv f candidate)) :ruleset ra-publish-ready)

(rule ((RAPublishReady inv f candidate) (RAFunction inv f region))
      ((delete (Mode region))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op kind))
      ((delete (OpPlacement op)) (delete (GraphLayout op)) (delete (OpKind op))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op kind) (= value (Operand op slot)))
      ((delete (Operand op slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op kind) (Result op slot value)
       (= def (ValueDefinition value)))
      ((delete (ValueDefinition value)) (delete (DefinedValue def)) (delete (Result op slot value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op kind) (Result op slot value)
       (set-not-contains (RAPublishValues inv f) value))
      ((delete (ValueType value)) (delete (DeclaredType value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op kind)
       (set-not-contains (RAPublishOps inv f) op) (= attr (Attribute op name)))
      ((delete (Attribute op name))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op kind)
       (set-not-contains (RAPublishOps inv f) op))
      ((delete (OpLocation op))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAFunction inv f region) (RegionParam region slot value)
       (= def (ValueDefinition value)))
      ((delete (ValueDefinition value)) (delete (DefinedValue def)) (delete (RegionParam region slot value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (= (ValueType control) (Apply (Ctor "son.control") (TNil)))
       (set-contains (RAPublishControlValues inv f) control))
      ((delete (ValueType control)) (delete (DeclaredType control))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAFunction inv f region) (= value (Yield region slot)))
      ((delete (Yield region slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region))
      ((delete (Mode region)) (delete (RegionOwner region)) (delete (RegionSlot region))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region) (= value (Yield region slot)))
      ((delete (Yield region slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region) (RegionParam region slot value))
      ((delete (ValueDefinition value)) (delete (DeclaredType value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region) (RegionParam region slot value)
       (set-not-contains (RAPublishValues inv f) value))
      ((delete (ValueType value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region)
       (= operand (EntryBinding region slot)))
      ((delete (EntryBinding region slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region)
       (= yielded (ExitBinding region slot)))
      ((delete (ExitBinding region slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredRegion inv f region)
       (= yielded (FeedbackBinding region slot)))
      ((delete (FeedbackBinding region slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op))
      ((delete (OpKind op)) (delete (OpPlacement op)) (delete (GraphLayout op)) (delete (OpLocation op)))
      :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op) (= value (Operand op slot)))
      ((delete (Operand op slot))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op) (= attr (Attribute op name)))
      ((delete (Attribute op name))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op) (Result op slot value))
      ((delete (ValueDefinition value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op) (Result op slot value)
       (set-not-contains (RAPublishValues inv f) value))
      ((delete (ValueType value)) (delete (DeclaredType value))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op))
      ((delete (Gamma op)) (delete (Theta op)) (delete (GammaPredicate op))
       (delete (GammaDefaultArm op)) (delete (ThetaBody op))
       (delete (ThetaPredicate op)) (delete (ThetaContinueOn op))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishRetiredOp inv f op) (= region (GammaArm op case)))
      ((delete (GammaArm op case))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op "son.branch"))
      ((delete (Attribute op "operand_segment_sizes"))
       (delete (Attribute op "result_segment_sizes"))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op "son.edge"))
      ((delete (Attribute op "operand_segment_sizes"))
       (delete (Attribute op "result_segment_sizes"))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RAPublishAttribute inv f op name attr))
      ((delete (Attribute op name))) :ruleset ra-publish-delete)
(rule ((RAPublishReady inv f candidate) (RASource inv f op "son.merge") (= attr (Attribute op name)))
      ((delete (Attribute op name)) (delete (OpLocation op))) :ruleset ra-publish-delete)

(rule ((RAPublishReady inv f candidate) (RAFunction inv f region))
      ((set (Mode region) (CFG)) (RAPublished inv f candidate)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAGraphFunction inv f) (RAFunction inv f region)
       (= block (RAPublishedBlock inv f logical))
       (= earlier (RAPublishEarlierBlocks inv f logical)))
      ((set (BlockRegion block) region) (set (BlockLayout block) (set-length earlier))) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAFunction inv f region) (RAEntry inv f logical)
       (= block (RAPublishedBlock inv f logical)))
      ((set (Entry region) block)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAAt inv f candidate logical op point)
       (= block (RAPublishedBlock inv f logical)))
      ((set (OpPlacement op) (InBlock block point))) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAPublishKind inv f op kind))
      ((set (OpKind op) kind)
       (set (KindBoundary kind) (OrdinaryBoundary))) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAPublishOperand inv f op slot value))
      ((set (Operand op slot) value)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAPublishDefinition inv f value def))
      ((set (ValueDefinition value) def)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAPublishDefinition inv f value (BlockParamDef block slot))
       (= ty (ValueType value)))
      ((set (DeclaredType value) ty)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAPublishAttribute inv f op name attr))
      ((set (Attribute op name) attr)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAGraphFunction inv f) (RAJump inv f op logical dest)
       (= block (RAPublishedBlock inv f dest)))
      ((set (Successor op 0) block)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAGraphFunction inv f) (RAIncoming inv f op dest slot joined incoming))
      ((set (SuccessorArg op 0 slot) slot)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAGraphFunction inv f) (RABranch inv f op logical predicate taken fallthrough)
       (= trueBlock (RAPublishedBlock inv f taken)) (= falseBlock (RAPublishedBlock inv f fallthrough)))
      ((set (Successor op 0) trueBlock) (set (Successor op 1) falseBlock)) :ruleset ra-publish-install)
(rule ((RAPublishReady inv f candidate) (RAPublishSuccessor inv f op slot block))
      ((set (Successor op slot) block)) :ruleset ra-publish-install)
