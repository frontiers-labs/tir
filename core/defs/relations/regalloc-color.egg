;; Each phase consumes the saturated output of its predecessor:
;; ra-color-import, ra-color-live, ra-color-interfere, ra-color-reject,
;; ra-color-domain, ra-color-seed,
;; saturate(seq(saturate ra-color-blocked, saturate ra-color-priority,
;;              saturate ra-color-saturation, saturate ra-color-degree,
;;              saturate ra-color-ready, run ra-color-step)),
;; ra-color-finish, ra-color-check, ra-color-complete.
;; An invocation's input facts must remain frozen across these phases.
(ruleset ra-color-import)
(ruleset ra-color-live)
(ruleset ra-color-interfere)
(ruleset ra-color-reject)
(ruleset ra-color-domain)
(ruleset ra-color-seed)
(ruleset ra-color-blocked)
(ruleset ra-color-priority)
(ruleset ra-color-saturation)
(ruleset ra-color-degree)
(ruleset ra-color-ready)
(ruleset ra-color-step)
(ruleset ra-color-finish)
(ruleset ra-color-check)
(ruleset ra-color-complete)

;; Only hardware values have a class. State and control never enter this table.
(relation RAValueClass (i64 i64 i64 String))
(relation RAInputPin (i64 i64 i64 i64 i64 String i64))
(relation RAOutputPin (i64 i64 i64 i64 String i64))
(relation RATiedOperands (i64 i64 i64 i64 i64))
(relation RAReservedRegister (i64 String i64))
(relation RAForcedRegister (i64 i64 i64 String i64))
(relation RANoSpill (i64 i64 i64))
(function RAColorUnspillable (i64 i64) RAIds :merge (set-union old new))

(datatype RASpillDescriptor (RASlot i64 String i64))
(datatype RAColorLocation (RAInRegister String i64) (RAOnStack RASpillDescriptor))
(sort RAColorMap (Map i64 RAColorLocation))
(datatype RAColoring (RAC i64 i64 i64 RAColorMap RAIds))
(relation RAColorState (RAColoring))
(relation RAColorValue (i64 i64 i64 i64 String))
(function RAColorValues (i64 i64 i64) RAIds :merge (set-union old new))
(relation RAChosenRegister (i64 i64 i64 i64 String i64))
(relation RASpill (i64 i64 i64 i64 RASpillDescriptor))
(relation RAColorComplete (i64 i64 i64))
(relation RARepairRequest (i64 i64 i64 i64 i64 i64 String))
(relation RAColorError (i64 i64 i64 i64 String))
(function RAColorErrors (i64 i64 i64) RAIds :merge (set-union old new))
(function RAColorRepairs (i64 i64 i64) RAIds :merge (set-union old new))
(function RAColorDecided (i64 i64 i64) RAIds :merge (set-union old new))

(datatype RARegisterRef (RARegRef String i64))
(datatype RAPinRef (RAReadPin i64 i64 i64 String i64) (RAWritePin i64 i64 String i64))
(sort RAPinRefs (Set RAPinRef))
(relation RAColorPin (i64 i64 RAPinRef))
(relation RAKnownResourceRef (i64 RARegisterRef))
(function RAVerifiedPins (i64 i64 i64) RAPinRefs :merge (set-union old new))
(sort RARegisterRefs (Set RARegisterRef))
(relation RAColorResource (i64 String i64))
(relation RAResourceWrite (i64 i64 i64 String i64))
(function RAResourceKills (i64 i64 i64) RARegisterRefs :merge (set-union old new))
(function RAResourceOwners (i64 i64 String i64) RAIds :merge (set-union old new))
(relation RAResourceLive (i64 i64 i64 i64 i64 String i64))
(relation RAResourceConflict (i64 i64 i64 i64 String i64))

;; Program points are instruction boundaries. Bindings kill propagation across
;; incoming edges; their source values are uses at predecessor terminators.
(relation RAColorPoint (i64 i64 i64 i64 i64))
(relation RAColorNext (i64 i64 i64 i64 i64 i64))
(function RAColorBlockEnd (i64 i64 i64 i64) i64 :merge (max old new))
(function RAColorDefs (i64 i64 i64 i64) RAIds :merge (set-union old new))
(function RAColorBindings (i64 i64 i64) RAIds :merge (set-union old new))
(relation RALiveAt (i64 i64 i64 i64 i64 i64))
(relation RALiveBefore (i64 i64 i64 i64 i64))
(relation RALiveAfter (i64 i64 i64 i64 i64))
(relation RAInterference (i64 i64 i64 i64 i64))
(relation RACopyAffinity (i64 i64 i64 i64 i64))
(function RAClassIndices (i64 String) RAIds :merge (set-union old new))
(function RAColorNeighbors (i64 i64 i64 i64) RAIds :merge (set-union old new))
(function RASavedIndices (i64 String) RAIds :merge (set-union old new))
(relation RASavedRegister (i64 String i64))

(rule ((RAControlComplete inv f candidate) (RABlock inv f block))
      ((RAColorPoint inv f candidate block 0)
       (set (RAColorBlockEnd inv f candidate block) 0)
       (set (RAColorBindings inv f block) (set-empty))
       (set (RAColorValues inv f candidate) (set-empty))
       (set (RAColorErrors inv f candidate) (set-empty))
       (set (RAColorRepairs inv f candidate) (set-empty))
       (set (RAColorDecided inv f candidate) (set-empty))
       (set (RAColorUnspillable inv f) (set-empty))
       (set (RAVerifiedPins inv f candidate) (set-empty))) :ruleset ra-color-import)
(rule ((RAAt inv f candidate block op index) (RAControlComplete inv f candidate))
      ((RAColorPoint inv f candidate block index)
       (RAColorPoint inv f candidate block (+ index 1))
       (RAColorNext inv f candidate block index op)
       (set (RAColorBlockEnd inv f candidate block) (+ index 1))
       (set (RAColorDefs inv f candidate op) (set-empty))
       (set (RAResourceKills inv f op) (set-empty))) :ruleset ra-color-import)
(rule ((RAAt inv f candidate block op index) (RADef inv f op value))
      ((set (RAColorDefs inv f candidate op) (set-of value))) :ruleset ra-color-import)
(rule ((RABinding inv f block slot value))
      ((set (RAColorBindings inv f block) (set-of value))) :ruleset ra-color-import)
(rule ((RAControlComplete inv f candidate) (RAValueClass inv f value class))
      ((RAColorValue inv f candidate value class)
       (set (RAColorValues inv f candidate) (set-of value))
       (set (RAColorNeighbors inv f candidate value) (set-empty))) :ruleset ra-color-import)
(rule ((RANoSpill inv f value))
      ((set (RAColorUnspillable inv f) (set-of value))) :ruleset ra-color-import)
(rule ((TMDLClass inv class file width offset merge))
      ((set (RAClassIndices inv class) (set-empty))
       (set (RASavedIndices inv class) (set-empty))) :ruleset ra-color-import)
(rule ((TMDLAbiRegister inv "callee-saved" class index))
      ((RASavedRegister inv class index)) :ruleset ra-color-import)
(rule ((TMDLAbiRegister inv "ra" class index))
      ((RASavedRegister inv class index)) :ruleset ra-color-import)
(rule ((TMDLRegister inv class index) (TMDLClass inv class file width offset merge)
       (RASavedRegister inv saved savedIndex)
       (TMDLClass inv saved file savedWidth savedOffset savedMerge)
       (< index (+ savedIndex savedWidth)) (< savedIndex (+ index width)))
      ((set (RASavedIndices inv class) (set-of index))) :ruleset ra-color-import)
(rule ((TMDLRegister inv class index))
      ((set (RAClassIndices inv class) (set-of index))) :ruleset ra-color-import)
(rule ((TMDLAbiRegister inv "reserved" class index))
      ((RAReservedRegister inv class index)) :ruleset ra-color-import)
(rule ((TMDLAbiRegister inv "sp" class index))
      ((RAReservedRegister inv class index)) :ruleset ra-color-import)
(rule ((TMDLHardwiredZero inv class index))
      ((RAReservedRegister inv class index)) :ruleset ra-color-import)

(rule ((TMDLFixedWrite inv kind class index))
      ((RAColorResource inv class index)) :ruleset ra-color-import)
(rule ((RAOutputPin inv f op value class index))
      ((RAColorResource inv class index)) :ruleset ra-color-import)
(rule ((TMDLFixedRead inv kind class index))
      ((RAColorResource inv class index)) :ruleset ra-color-import)
(rule ((TMDLImplicitOrUpdate inv kind class index))
      ((RAColorResource inv class index)) :ruleset ra-color-import)
;; Constructor keys must exist before negative container lookups in later phases.
(rule ((RAColorResource inv class index))
      ((RAKnownResourceRef inv (RARegRef class index))) :ruleset ra-color-import)
(rule ((RAInputPin inv f op slot value class index))
      ((RAColorPin inv f (RAReadPin op slot value class index))) :ruleset ra-color-import)
(rule ((RAOutputPin inv f op value class index))
      ((RAColorPin inv f (RAWritePin op value class index))) :ruleset ra-color-import)
(rule ((RAControlComplete inv f candidate) (RAColorResource inv class index))
      ((set (RAResourceOwners inv f class index) (set-empty))) :ruleset ra-color-import)
(rule ((RAForcedRegister inv f value owner index) (RAColorResource inv resource index)
       (TMDLClass inv owner file width offset ownerMerge)
       (TMDLClass inv resource file width offset resourceMerge))
      ((set (RAResourceOwners inv f resource index) (set-of value))) :ruleset ra-color-import)
(rule ((RAInputPin inv f op slot value owner index) (RAColorResource inv resource index)
       (TMDLClass inv owner file width offset ownerMerge)
       (TMDLClass inv resource file width offset resourceMerge))
      ((set (RAResourceOwners inv f resource index) (set-of value))) :ruleset ra-color-import)
(rule ((RAOutputPin inv f op value owner index) (RAColorResource inv resource index)
       (TMDLClass inv owner file width offset ownerMerge)
       (TMDLClass inv resource file width offset resourceMerge))
      ((set (RAResourceOwners inv f resource index) (set-of value))) :ruleset ra-color-import)
(rule ((RANode inv f op kind) (TMDLFixedWrite inv kind class index))
      ((RAResourceWrite inv f op class index)) :ruleset ra-color-import)
(rule ((RANode inv f op kind) (TMDLImplicitOrUpdate inv kind class index))
      ((RAResourceWrite inv f op class index)) :ruleset ra-color-import)
(rule ((RAOutputPin inv f op value class index))
      ((RAResourceWrite inv f op class index)) :ruleset ra-color-import)
(rule ((RAResourceWrite inv f op written writtenIndex) (RAColorResource inv resource resourceIndex)
       (TMDLClass inv written file writtenWidth writtenOffset false)
       (TMDLClass inv resource file resourceWidth resourceOffset resourceMerge)
       (<= writtenIndex resourceIndex) (>= (+ writtenIndex writtenWidth) (+ resourceIndex resourceWidth)))
      ((set (RAResourceKills inv f op) (set-of (RARegRef resource resourceIndex))))
      :ruleset ra-color-import)

(rule ((RAAt inv f candidate block op index) (RAResourceWrite inv f op class register)
       (TMDLClass inv class file width offset true))
      ((RAResourceLive inv f candidate block index class register)) :ruleset ra-color-live)
(rule ((RAAt inv f candidate block op index) (RANode inv f op kind)
       (TMDLFixedRead inv kind class register))
      ((RAResourceLive inv f candidate block index class register)) :ruleset ra-color-live)
(rule ((RAAt inv f candidate block op index) (RANode inv f op kind)
       (TMDLImplicitOrUpdate inv kind class register))
      ((RAResourceLive inv f candidate block index class register)) :ruleset ra-color-live)
(rule ((RAColorNext inv f candidate block point op)
       (RAResourceLive inv f candidate block (+ point 1) class register)
       (set-not-contains (RAResourceKills inv f op) (RARegRef class register)))
      ((RAResourceLive inv f candidate block point class register)) :ruleset ra-color-live)
(rule ((RAControlEdge inv f from dest) (RAResourceLive inv f candidate dest 0 class register)
       (= end (RAColorBlockEnd inv f candidate from)))
      ((RAResourceLive inv f candidate from end class register)) :ruleset ra-color-live)

(rule ((RAAt inv f candidate block op index) (RAUse inv f op slot value)
       (RAColorValue inv f candidate value class))
      ((RALiveAt inv f candidate block index value)) :ruleset ra-color-live)
(rule ((RAAt inv f candidate block edge index) (RAIncoming inv f edge dest slot joined value)
       (RAColorValue inv f candidate value class))
      ((RALiveAt inv f candidate block index value)) :ruleset ra-color-live)
(rule ((RAColorNext inv f candidate block index op)
       (RALiveAt inv f candidate block (+ index 1) value)
       (set-not-contains (RAColorDefs inv f candidate op) value))
      ((RALiveAt inv f candidate block index value)) :ruleset ra-color-live)
(rule ((RAControlEdge inv f from dest) (RALiveAt inv f candidate dest 0 value)
       (= end (RAColorBlockEnd inv f candidate from))
       (set-not-contains (RAColorBindings inv f dest) value))
      ((RALiveAt inv f candidate from end value)) :ruleset ra-color-live)
(rule ((RAAt inv f candidate block op index) (RALiveAt inv f candidate block index value))
      ((RALiveBefore inv f candidate op value)) :ruleset ra-color-live)
(rule ((RAAt inv f candidate block op index) (RALiveAt inv f candidate block (+ index 1) value))
      ((RALiveAfter inv f candidate op value)) :ruleset ra-color-live)

(rule ((RALiveAt inv f candidate block point first)
       (RALiveAt inv f candidate block point second) (!= first second))
      ((RAInterference inv f candidate first second)) :ruleset ra-color-interfere)
(rule ((RAAt inv f candidate block op index) (RADef inv f op first)
       (RAColorValue inv f candidate first class)
       (RALiveAfter inv f candidate op second) (!= first second))
      ((RAInterference inv f candidate first second)
       (RAInterference inv f candidate second first)) :ruleset ra-color-interfere)
(rule ((RAAt inv f candidate block op index) (RADef inv f op first) (RADef inv f op second)
       (RAColorValue inv f candidate first firstClass)
       (RAColorValue inv f candidate second secondClass) (!= first second))
      ((RAInterference inv f candidate first second)) :ruleset ra-color-interfere)

(rule ((RAControlComplete inv f candidate) (RABinding inv f block slot first)
       (RALiveAt inv f candidate block 0 second)
       (RAColorValue inv f candidate first class) (!= first second))
      ((RAInterference inv f candidate first second)
       (RAInterference inv f candidate second first)) :ruleset ra-color-interfere)
(rule ((RAControlComplete inv f candidate) (RABinding inv f block firstSlot first)
       (RABinding inv f block secondSlot second)
       (RAColorValue inv f candidate first firstClass)
       (RAColorValue inv f candidate second secondClass) (!= first second))
      ((RAInterference inv f candidate first second)) :ruleset ra-color-interfere)
(rule ((RAControlComplete inv f candidate) (RAIncoming inv f edge dest slot joined input))
      ((RACopyAffinity inv f candidate joined input)
       (RACopyAffinity inv f candidate input joined)) :ruleset ra-color-interfere)
(rule ((RAControlComplete inv f candidate) (RATiedOperands inv f op slot result)
       (RAUse inv f op slot input))
      ((RACopyAffinity inv f candidate input result)
       (RACopyAffinity inv f candidate result input)) :ruleset ra-color-interfere)

(rule ((RALiveAt inv f candidate block point value)
       (RAResourceLive inv f candidate block point resource index))
      ((RAResourceConflict inv f candidate value resource index)) :ruleset ra-color-interfere)
(rule ((RAAt inv f candidate block op point) (RADef inv f op value)
       (RAResourceLive inv f candidate block (+ point 1) resource index))
      ((RAResourceConflict inv f candidate value resource index)) :ruleset ra-color-interfere)
(rule ((RAAt inv f candidate block op point) (RADef inv f op value)
       (RAResourceWrite inv f op resource index))
      ((RAResourceConflict inv f candidate value resource index)) :ruleset ra-color-interfere)
(rule ((RAControlComplete inv f candidate) (RABinding inv f block slot value)
       (RAResourceLive inv f candidate block 0 resource index))
      ((RAResourceConflict inv f candidate value resource index)) :ruleset ra-color-interfere)

;; All register exclusions are frozen before constructing domains. A physical
;; group overlaps every covered file index, including aliases in other classes.
(function RARejectedRegisters (i64 i64 i64 i64) RAIds :merge (set-union old new))
(function RARegisterDomain (i64 i64 i64 i64) RAIds :merge (set-union old new))
(rule ((RAColorValue inv f candidate value class))
      ((set (RARejectedRegisters inv f candidate value) (set-empty))
       (set (RARegisterDomain inv f candidate value) (set-empty))) :ruleset ra-color-reject)
(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (TMDLClass inv class file width offset merge)
       (RAReservedRegister inv reserved reservedIndex)
       (TMDLClass inv reserved file reservedWidth reservedOffset reservedMerge)
       (< index (+ reservedIndex reservedWidth)) (< reservedIndex (+ index width)))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)
(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (RAForcedRegister inv f value forced forcedIndex) (!= index forcedIndex))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)
(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (RAForcedRegister inv f value forced forcedIndex)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv forced forcedFile forcedWidth forcedOffset forcedMerge) (!= file forcedFile))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)
(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (RAForcedRegister inv f value forced forcedIndex)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv forced file forcedWidth forcedOffset forcedMerge) (!= offset forcedOffset))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)
(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (RAForcedRegister inv f value forced forcedIndex)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv forced file forcedWidth forcedOffset forcedMerge) (!= width forcedWidth))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)

(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (RAForcedRegister inv f value forced forcedIndex)
       (set-not-contains (RAClassIndices inv forced) index))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)

(rule ((RAResourceConflict inv f candidate value resource resourceIndex)
       (RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv resource file resourceWidth resourceOffset resourceMerge)
       (< index (+ resourceIndex resourceWidth)) (< resourceIndex (+ index width))
       (set-not-contains (RAResourceOwners inv f resource resourceIndex) value))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)

(rule ((RAAt inv f candidate block op point) (RAResourceWrite inv f op fixed fixedIndex)
       (RALiveBefore inv f candidate op value) (RALiveAfter inv f candidate op value)
       (RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv fixed file fixedWidth fixedOffset fixedMerge)
       (< index (+ fixedIndex fixedWidth)) (< fixedIndex (+ index width)))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)
(rule ((RAColorValue inv f candidate value class) (TMDLRegister inv class index)
       (set-not-contains (RARejectedRegisters inv f candidate value) index))
      ((set (RARegisterDomain inv f candidate value) (set-of index))) :ruleset ra-color-domain)

(rule ((RAInterference inv f candidate value other)
       (RAColorValue inv f candidate value class)
       (RAColorValue inv f candidate other otherClass)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv otherClass file otherWidth otherOffset otherMerge))
      ((set (RAColorNeighbors inv f candidate value) (set-of other))) :ruleset ra-color-interfere)

;; States contain the complete immutable assignment prefix. Each iteration
;; freezes conflicts, then prioritizes urgent values and narrow domains. Ties
;; prefer more blocked legal indices, then more uncolored same-file neighbors,
;; then the smallest value ID. No register is kept as scratch.
(function RAColorBlocked (RAColoring i64) RAIds :merge (set-union old new))
(function RAColorDomainSize (RAColoring) i64 :merge (min old new))
(function RAColorUrgent (RAColoring) RAIds :merge (set-union old new))
(relation RAColorEligible (RAColoring i64))
(relation RAColorConstrained (RAColoring i64))
(relation RAColorSaturated (RAColoring i64))
(function RAColorSaturation (RAColoring) i64 :merge (max old new))
(function RAColorDegree (RAColoring) i64 :merge (max old new))
(function RAColorNextValue (RAColoring) i64 :merge (min old new))
(function RAColorAvailable (RAColoring i64) RAIds :merge (set-union old new))
(function RAColorRegisterMin (RAColoring i64) i64 :merge (min old new))
(function RAColorRegisterMax (RAColoring i64) i64 :merge (max old new))
(function RAColorCheapAvailable (RAColoring i64) RAIds :merge (set-union old new))
(function RAColorCheapMax (RAColoring i64) i64 :merge (max old new))
(function RAColorPreferred (RAColoring i64) RAIds :merge (set-union old new))
(function RAColorPreferredMin (RAColoring i64) i64 :merge (min old new))
(function RAColorPreferredMax (RAColoring i64) i64 :merge (max old new))
(rule ((RAControlComplete inv f candidate))
      ((RAColorState (RAC inv f candidate (map-empty) (set-empty)))) :ruleset ra-color-seed)
(rule ((RAColorState state))
      ((set (RAColorUrgent state) (set-empty))) :ruleset ra-color-blocked)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RANoSpill inv f value) (set-not-contains seen value))
      ((set (RAColorUrgent state) (set-of value))) :ruleset ra-color-blocked)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorValue inv f candidate value class) (set-not-contains seen value))
      ((set (RAColorBlocked state value) (set-empty))
       (set (RAColorAvailable state value) (set-empty))
       (set (RAColorCheapAvailable state value) (set-empty))
       (set (RAColorPreferred state value) (set-empty))) :ruleset ra-color-blocked)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorValue inv f candidate value class) (set-not-contains seen value)
       (RAInterference inv f candidate value other)
       (= (map-get assignments other) (RAInRegister otherClass otherIndex))
       (TMDLRegister inv class index) (TMDLClass inv class file width offset merge)
       (TMDLClass inv otherClass file otherWidth otherOffset otherMerge)
       (< index (+ otherIndex otherWidth)) (< otherIndex (+ index width)))
      ((set (RAColorBlocked state value) (set-of index))) :ruleset ra-color-blocked)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorValue inv f candidate value class) (set-not-contains seen value)
       (= (set-length (RAColorUrgent state)) 0))
      ((RAColorEligible state value)) :ruleset ra-color-priority)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorValue inv f candidate value class)
       (set-contains (RAColorUrgent state) value))
      ((RAColorEligible state value)) :ruleset ra-color-priority)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorEligible state value) (= domain (RARegisterDomain inv f candidate value)))
      ((set (RAColorDomainSize state) (set-length domain))) :ruleset ra-color-priority)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorEligible state value) (= domain (RARegisterDomain inv f candidate value))
       (= (set-length domain) (RAColorDomainSize state)))
      ((RAColorConstrained state value)
       (set (RAColorSaturation state)
            (set-length (set-intersect (RAColorBlocked state value) domain))))
      :ruleset ra-color-saturation)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorConstrained state value) (= domain (RARegisterDomain inv f candidate value))
       (= (RAColorSaturation state)
          (set-length (set-intersect (RAColorBlocked state value) domain))))
      ((RAColorSaturated state value)
       (set (RAColorDegree state)
            (set-length (set-diff (RAColorNeighbors inv f candidate value) seen))))
      :ruleset ra-color-degree)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (RAColorSaturated state value)
       (= (RAColorDegree state)
          (set-length (set-diff (RAColorNeighbors inv f candidate value) seen))))
      ((set (RAColorNextValue state) value)) :ruleset ra-color-ready)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (TMDLRegister inv class index) (set-contains (RARegisterDomain inv f candidate value) index)
       (set-not-contains (RAColorBlocked state value) index))
      ((set (RAColorAvailable state value) (set-of index))
       (set (RAColorRegisterMin state value) index)
       (set (RAColorRegisterMax state value) index)) :ruleset ra-color-ready)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (TMDLRegister inv class index) (set-contains (RAColorAvailable state value) index)
       (set-not-contains (RASavedIndices inv class) index))
      ((set (RAColorCheapAvailable state value) (set-of index))
       (set (RAColorCheapMax state value) index)) :ruleset ra-color-ready)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (RACopyAffinity inv f candidate value partner)
       (= (map-get assignments partner) (RAInRegister partnerClass index))
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv partnerClass file width offset partnerMerge)
       (set-contains (RAColorAvailable state value) index))
      ((set (RAColorPreferred state value) (set-of index))
       (set (RAColorPreferredMin state value) index)
       (set (RAColorPreferredMax state value) index)) :ruleset ra-color-ready)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (RAInputPin inv f op slot value required index)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv required file width offset requiredMerge)
       (set-contains (RAColorAvailable state value) index))
      ((set (RAColorPreferred state value) (set-of index))
       (set (RAColorPreferredMin state value) index)
       (set (RAColorPreferredMax state value) index)) :ruleset ra-color-ready)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (RAOutputPin inv f op value required index)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv required file width offset requiredMerge)
       (set-contains (RAColorAvailable state value) index))
      ((set (RAColorPreferred state value) (set-of index))
       (set (RAColorPreferredMin state value) index)
       (set (RAColorPreferredMax state value) index)) :ruleset ra-color-ready)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (= index (RAColorPreferredMin state value)) (= candidate 0))
      ((RAColorState (RAC inv f candidate
                         (map-insert assignments value (RAInRegister class index))
                         (set-insert seen value)))) :ruleset ra-color-step)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (= index (RAColorPreferredMax state value)) (!= candidate 0))
      ((RAColorState (RAC inv f candidate
                         (map-insert assignments value (RAInRegister class index))
                         (set-insert seen value)))) :ruleset ra-color-step)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (= (set-length (RAColorPreferred state value)) 0)
       (= index (RAColorRegisterMin state value)) (= candidate 0))
      ((RAColorState (RAC inv f candidate
                         (map-insert assignments value (RAInRegister class index))
                         (set-insert seen value)))) :ruleset ra-color-step)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (= (set-length (RAColorPreferred state value)) 0)
       (= index (RAColorCheapMax state value)) (!= candidate 0))
      ((RAColorState (RAC inv f candidate
                         (map-insert assignments value (RAInRegister class index))
                         (set-insert seen value)))) :ruleset ra-color-step)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (= (set-length (RAColorPreferred state value)) 0)
       (= (set-length (RAColorCheapAvailable state value)) 0)
       (= index (RAColorRegisterMax state value)) (!= candidate 0))
      ((RAColorState (RAC inv f candidate
                         (map-insert assignments value (RAInRegister class index))
                         (set-insert seen value)))) :ruleset ra-color-step)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RAColorValue inv f candidate value class)
       (= (set-length (RAColorAvailable state value)) 0)
       (set-not-contains (RAColorUnspillable inv f) value)
       (= bits (RAValueBits inv f value)) (> bits 0))
      ((RAColorState (RAC inv f candidate
                         (map-insert assignments value (RAOnStack (RASlot value class (/ (+ bits 7) 8))))
                         (set-insert seen value)))) :ruleset ra-color-step)

(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= seen (RAColorValues inv f candidate)) (RAColorValue inv f candidate value class)
       (= (map-get assignments value) (RAInRegister class index)))
      ((RAChosenRegister inv f candidate value class index)
       (set (RAColorDecided inv f candidate) (set-of value))) :ruleset ra-color-finish)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= seen (RAColorValues inv f candidate)) (RAColorValue inv f candidate value class)
       (= (map-get assignments value) (RAOnStack slot)))
      ((RASpill inv f candidate value slot)
       (set (RAColorDecided inv f candidate) (set-of value))) :ruleset ra-color-finish)

(rule ((RAChosenRegister inv f candidate value actual index)
       (RAInputPin inv f op slot value required index)
       (TMDLClass inv actual file width offset actualMerge)
       (TMDLClass inv required file width offset requiredMerge)
       (set-contains (RAClassIndices inv required) index))
      ((set (RAVerifiedPins inv f candidate)
            (set-of (RAReadPin op slot value required index)))) :ruleset ra-color-finish)
(rule ((RAChosenRegister inv f candidate value actual index)
       (RAOutputPin inv f op value required index)
       (TMDLClass inv actual file width offset actualMerge)
       (TMDLClass inv required file width offset requiredMerge)
       (set-contains (RAClassIndices inv required) index))
      ((set (RAVerifiedPins inv f candidate)
            (set-of (RAWritePin op value required index)))) :ruleset ra-color-finish)

(rule ((RAControlComplete inv f candidate) (RAValueClass inv f value first)
       (RAValueClass inv f value second) (!= first second))
      ((RAColorError inv f candidate value "value has conflicting register classes")) :ruleset ra-color-check)
(rule ((RAControlComplete inv f candidate) (RAColorValue inv f candidate value class)
       (set-not-contains (RAColorDecided inv f candidate) value))
      ((RAColorError inv f candidate value "value has no allocation")) :ruleset ra-color-check)
(rule ((RAChosenRegister inv f candidate value class index)
       (set-not-contains (RARegisterDomain inv f candidate value) index))
      ((RAColorError inv f candidate value "register violates target or fixed constraints")) :ruleset ra-color-check)
(rule ((RAChosenRegister inv f candidate first firstClass firstIndex)
       (RAChosenRegister inv f candidate second secondClass secondIndex)
       (RAInterference inv f candidate first second)
       (TMDLClass inv firstClass file firstWidth firstOffset firstMerge)
       (TMDLClass inv secondClass file secondWidth secondOffset secondMerge)
       (< firstIndex (+ secondIndex secondWidth)) (< secondIndex (+ firstIndex firstWidth)))
      ((RAColorError inv f candidate first "interfering register spans overlap")) :ruleset ra-color-check)
(rule ((RAChosenRegister inv f candidate value class first)
       (RAChosenRegister inv f candidate value class second) (!= first second))
      ((RAColorError inv f candidate value "value has multiple registers")) :ruleset ra-color-check)
(rule ((RAChosenRegister inv f candidate value class index) (RASpill inv f candidate value slot))
      ((RAColorError inv f candidate value "value has register and stack assignments")) :ruleset ra-color-check)
(rule ((RAColorState state) (= state (RAC inv f candidate assignments seen))
       (= value (RAColorNextValue state)) (RANoSpill inv f value)
       (= (set-length (RAColorAvailable state value)) 0))
      ((RAColorError inv f candidate value "repair temporary has no legal register")) :ruleset ra-color-check)
(rule ((RASpill inv f candidate value slot))
      ((RARepairRequest inv f candidate value -1 value "insert spill transfers")) :ruleset ra-color-check)
(rule ((RAControlComplete inv f candidate) (RAInputPin inv f op slot value class index)
       (set-not-contains (RAVerifiedPins inv f candidate) (RAReadPin op slot value class index)))
      ((RARepairRequest inv f candidate op slot value "split fixed operand")) :ruleset ra-color-check)
(rule ((RAControlComplete inv f candidate) (RAOutputPin inv f op value class index)
       (set-not-contains (RAVerifiedPins inv f candidate) (RAWritePin op value class index)))
      ((RARepairRequest inv f candidate op -1 value "split fixed result")) :ruleset ra-color-check)

;; A tied result may reuse its input only when the input dies at the operation.
;; Otherwise a copy/split is required even when their global choices agree.
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RAChosenRegister inv f candidate input inputClass inputIndex)
       (RAChosenRegister inv f candidate result resultClass resultIndex) (!= inputIndex resultIndex))
      ((RARepairRequest inv f candidate op slot input "copy tied operand")) :ruleset ra-color-check)
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RAChosenRegister inv f candidate input inputClass inputIndex)
       (RAChosenRegister inv f candidate result resultClass resultIndex)
       (TMDLClass inv inputClass inputFile inputWidth inputOffset inputMerge)
       (TMDLClass inv resultClass resultFile resultWidth resultOffset resultMerge) (!= inputFile resultFile))
      ((RARepairRequest inv f candidate op slot input "copy tied operand")) :ruleset ra-color-check)
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RAChosenRegister inv f candidate input inputClass inputIndex)
       (RAChosenRegister inv f candidate result resultClass resultIndex)
       (TMDLClass inv inputClass inputFile inputWidth inputOffset inputMerge)
       (TMDLClass inv resultClass resultFile resultWidth resultOffset resultMerge) (!= inputWidth resultWidth))
      ((RARepairRequest inv f candidate op slot input "copy tied operand")) :ruleset ra-color-check)
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RAChosenRegister inv f candidate input inputClass inputIndex)
       (RAChosenRegister inv f candidate result resultClass resultIndex)
       (TMDLClass inv inputClass inputFile inputWidth inputOffset inputMerge)
       (TMDLClass inv resultClass resultFile resultWidth resultOffset resultMerge) (!= inputOffset resultOffset))
      ((RARepairRequest inv f candidate op slot input "copy tied operand")) :ruleset ra-color-check)
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RALiveAfter inv f candidate op input) (!= input result))
      ((RARepairRequest inv f candidate op slot input "split live tied operand")) :ruleset ra-color-check)
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RASpill inv f candidate input descriptor))
      ((RARepairRequest inv f candidate op slot input "reload tied operand")) :ruleset ra-color-check)
(rule ((RATiedOperands inv f op slot result) (RAUse inv f op slot input)
       (RASpill inv f candidate result descriptor))
      ((RARepairRequest inv f candidate op slot result "store tied result")) :ruleset ra-color-check)

(rule ((RAColorError inv f candidate value message))
      ((set (RAColorErrors inv f candidate) (set-of value))) :ruleset ra-color-check)
(rule ((RARepairRequest inv f candidate op slot value message))
      ((set (RAColorRepairs inv f candidate) (set-of value))) :ruleset ra-color-check)
(rule ((RAControlComplete inv f candidate)
       (= (RAColorDecided inv f candidate) (RAColorValues inv f candidate))
       (= (set-length (RAColorErrors inv f candidate)) 0)
       (= (set-length (RAColorRepairs inv f candidate)) 0))
      ((RAColorComplete inv f candidate)) :ruleset ra-color-complete)

;; Native declarations can restrict an otherwise shared physical-file view.
(rule ((RAControlComplete inv f candidate) (RAValueClass inv f value class)
       (TMDLRegisterWidth inv class bits))
      ((set (RAValueBits inv f value) bits)) :ruleset ra-color-import)
(rule ((RAColorValue inv f candidate value class) (RAValueExcluded inv f value class index))
      ((set (RARejectedRegisters inv f candidate value) (set-of index))) :ruleset ra-color-reject)
(rule ((RANativePhysicalRead inv f op class index))
      ((RAColorResource inv class index) (RAKnownResourceRef inv (RARegRef class index))) :ruleset ra-color-import)
(rule ((RANativePhysicalWrite inv f op class index))
      ((RAColorResource inv class index) (RAKnownResourceRef inv (RARegRef class index))
       (RAResourceWrite inv f op class index)) :ruleset ra-color-import)
(rule ((RAAt inv f candidate block op point) (RANativePhysicalRead inv f op class index))
      ((RAResourceLive inv f candidate block point class index)) :ruleset ra-color-live)

;; Opaque transfers can invoke code that clobbers the ABI's caller-saved registers.
(rule ((RASource inv f op kind) (TMDLOpaqueTransferKind inv kind))
      ((RANativeCall inv f op)) :ruleset ra-color-import)
(rule ((RANativeCall inv f op) (TMDLAbiRegister inv "caller-saved" class index))
      ((RAColorResource inv class index) (RAKnownResourceRef inv (RARegRef class index))
       (RAResourceWrite inv f op class index)) :ruleset ra-color-import)
