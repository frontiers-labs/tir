;; Structured graph import precedes control placement. Saturate index, lanes,
;; plan, then repeat blocked/ready/one step to saturation, and finally emit.
;; The prefix chooses only dependency-ready owners. Source order is irrelevant.
(ruleset ra-structured-index)
(ruleset ra-structured-lanes)
(ruleset ra-structured-plan)
(ruleset ra-structured-blocked)
(ruleset ra-structured-ready)
(ruleset ra-structured-step)
(ruleset ra-structured-emit)
(relation RAStructuredFunction (i64 i64))
(relation RAStructuredRegion (i64 i64 i64))
(relation RAStructuredOwner (i64 i64 i64))
(relation RAStructuredActive (i64 i64 i64))
(relation RAStructuredDemand (i64 i64 i64 i64 i64))
(relation RAStructuredLane (i64 i64 i64 i64 i64))
(relation RAStructuredBefore (i64 i64 i64 i64))
(function RAStructuredAllocated (i64 i64 String) RAIds :merge (set-union old new))
(function RAStructuredNeeds (i64 i64 i64) RAIds :merge (set-union old new))
(function RAStructuredOwners (i64 i64 i64 i64) RAIds :merge (set-union old new))
(function RAStructuredEntry (i64 i64 i64 i64) i64 :no-merge)
(function RAStructuredExit (i64 i64 i64 i64) i64 :no-merge)
(function RAStructuredOwnerEntry (i64 i64 i64) i64 :no-merge)
(function RAStructuredOwnerExit (i64 i64 i64) i64 :no-merge)
(function RAStructuredArm (i64 i64 i64) i64 :no-merge)
(function RAStructuredJump (i64 i64 i64 i64) i64 :no-merge)
(function RAStructuredGate (i64 i64 i64) i64 :no-merge)
(relation RAStructuredLink (i64 i64 i64 i64))
;; Switch arms have forwarding stubs, so their terminator carries no arguments.
(relation RASwitch (i64 i64 i64 i64 i64 i64))
(relation RASwitchCase (i64 i64 i64 i64 BigInt i64))
(relation RASwitchOwner (i64 i64 i64 i64))
(function RASwitchDestinations (i64 i64 i64) RAIds :merge (set-union old new))
(function RASwitchDemands (i64 i64 i64 i64) RAIds :merge (set-union old new))
(datatype RAStructuredPrefix (RASP i64 i64 i64 i64 i64 RAIds))
(relation RAStructuredState (RAStructuredPrefix))
(function RAStructuredBlocked (RAStructuredPrefix) RAIds :merge (set-union old new))
(function RAStructuredReady (RAStructuredPrefix) i64 :merge (min old new))

(rule ((RAFunction inv f region) (RAGraphFunction inv f)
       (OpUnderRegion region op) (Gamma op))
      ((RAStructuredFunction inv f)) :ruleset ra-structured-index)
(rule ((RAFunction inv f region) (RAGraphFunction inv f)
       (OpUnderRegion region op) (Theta op))
      ((RAStructuredFunction inv f)) :ruleset ra-structured-index)
(rule ((RAStructuredFunction inv f) (RAFunction inv f region))
      ((RAStructuredRegion inv f region)
       (set (RAStructuredFlag inv f) true)
       (set (RAStructuredAllocated inv f "region") (set-empty))
       (set (RAStructuredAllocated inv f "theta") (set-empty))
       (set (RAStructuredAllocated inv f "owner") (set-empty))
       (set (RAStructuredAllocated inv f "arm") (set-empty))
       (set (RAStructuredAllocated inv f "jump") (set-empty))
       (set (RAStructuredAllocated inv f "return") (set-empty))) :ruleset ra-structured-index)
(rule ((RAStructuredRegion inv f region) (GraphMember region op) (Gamma op))
      ((RAStructuredOwner inv f op)) :ruleset ra-structured-index)
(rule ((RAStructuredRegion inv f region) (GraphMember region op) (Theta op))
      ((RAStructuredOwner inv f op)) :ruleset ra-structured-index)
(rule ((RAStructuredRegion inv f region) (GraphMember region op) (= kind (OpKind op)))
      ((RASource inv f op kind) (set (RASourceOps inv f) (set-of op))
       (set (RAStructuredNeeds inv f op) (set-empty))) :ruleset ra-structured-index)
(rule ((RAStructuredOwner inv f op))
      ((set (RARecognizedOps inv f) (set-of op))
       (set (RAStructuredOwnerSet inv f) (set-of op))) :ruleset ra-structured-index)
(rule ((RAStructuredDemand inv f region lane op) (RAStructuredOwner inv f op))
      ((RAStructuredActive inv f op)) :ruleset ra-structured-index)
(rule ((RAStructuredActive inv f op) (= region (OwnedRegion op slot)))
      ((RAStructuredRegion inv f region)) :ruleset ra-structured-index)

;; Demand is projected onto siblings, including free reads in nested regions.
(rule ((RAStructuredRegion inv f region) (RAFunction inv f region)
       (= value (Yield region slot)) (= (ValueDefinition value) (ResultDef op resultSlot))
       (GraphMember region op))
      ((RAStructuredDemand inv f region 0 op)) :ruleset ra-structured-index)
(rule ((RAStructuredRegion inv f region) (= owner (RegionOwner region)) (Gamma owner)
       (ExitValue region slot value) (= (ValueDefinition value) (ResultDef op resultSlot))
       (GraphMember region op))
      ((RAStructuredDemand inv f region 0 op)) :ruleset ra-structured-index)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= slot (ThetaPredicate owner)) (= value (Yield region slot))
       (= (ValueDefinition value) (ResultDef op resultSlot)) (GraphMember region op))
      ((RAStructuredDemand inv f region 0 op)) :ruleset ra-structured-index)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (FeedbackValue region slot value) (= (ValueDefinition value) (ResultDef op resultSlot))
       (GraphMember region op))
      ((RAStructuredDemand inv f region 1 op)) :ruleset ra-structured-index)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (ExitValue region slot value) (= (ValueDefinition value) (ResultDef op resultSlot))
       (GraphMember region op))
      ((RAStructuredDemand inv f region 2 op)) :ruleset ra-structured-index)
(rule ((RAStructuredDemand inv f region lane user)
       (SiblingRead reader value user producer) (GraphMember region producer))
      ((RAStructuredDemand inv f region lane producer)) :ruleset ra-structured-index)
(rule ((RAStructuredDemand inv f region lane op))
      ((set (RAStructuredNeeds inv f op) (set-of lane))) :ruleset ra-structured-index)
(rule ((RAStructuredRegion inv f region) (SiblingRead reader value later earlier)
       (GraphMember region later) (GraphMember region earlier) (!= later earlier))
      ((RAStructuredBefore inv f later earlier)) :ruleset ra-structured-index)
(rule ((RAStructuredBefore inv f later middle) (RAStructuredBefore inv f middle earlier))
      ((RAStructuredBefore inv f later earlier)) :ruleset ra-structured-index)

;; A shared cone runs once before the test. Exclusive cones remain after it,
;; including total arithmetic: the region entry bounds its legal placements.
(rule ((RAStructuredDemand inv f region 0 op))
      ((RAStructuredLane inv f region 0 op)) :ruleset ra-structured-lanes)
(rule ((RAStructuredDemand inv f region 1 op) (RAStructuredDemand inv f region 2 op))
      ((RAStructuredLane inv f region 0 op)) :ruleset ra-structured-lanes)
(rule ((RAStructuredDemand inv f region 1 op)
       (set-not-contains (RAStructuredNeeds inv f op) 0)
       (set-not-contains (RAStructuredNeeds inv f op) 2))
      ((RAStructuredLane inv f region 1 op)) :ruleset ra-structured-lanes)
(rule ((RAStructuredDemand inv f region 2 op)
       (set-not-contains (RAStructuredNeeds inv f op) 0)
       (set-not-contains (RAStructuredNeeds inv f op) 1))
      ((RAStructuredLane inv f region 2 op)) :ruleset ra-structured-lanes)

(rule ((RAStructuredRegion inv f region)
       (set-not-contains (RAStructuredAllocated inv f "region") region))
      ((set (RAStructuredAllocated inv f "region") (set-of region))
       (set (RAStructuredEntry inv f region 0) (fresh-ir-id))
       (set (RAStructuredExit inv f region 0) (fresh-ir-id))
       (set (RAStructuredOwners inv f region 0) (set-empty))) :ruleset ra-structured-plan)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (set-not-contains (RAStructuredAllocated inv f "theta") owner))
      ((set (RAStructuredAllocated inv f "theta") (set-of owner))
       (set (RAStructuredEntry inv f region 1) (fresh-ir-id))
       (set (RAStructuredExit inv f region 1) (fresh-ir-id))
       (set (RAStructuredEntry inv f region 2) (fresh-ir-id))
       (set (RAStructuredExit inv f region 2) (fresh-ir-id))
       (set (RAStructuredOwners inv f region 1) (set-empty))
       (set (RAStructuredOwners inv f region 2) (set-empty))) :ruleset ra-structured-plan)
(rule ((RAStructuredActive inv f owner)
       (set-not-contains (RAStructuredAllocated inv f "owner") owner))
      ((set (RAStructuredAllocated inv f "owner") (set-of owner))
       (set (RAStructuredOwnerEntry inv f owner) (fresh-ir-id))
       (set (RAStructuredOwnerExit inv f owner) (fresh-ir-id))
       (set (RAStructuredGate inv f owner) (fresh-ir-id))) :ruleset ra-structured-plan)
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= region (OwnedRegion owner slot))
       (set-not-contains (RAStructuredAllocated inv f "arm") region))
      ((set (RAStructuredAllocated inv f "arm") (set-of region))
       (set (RAStructuredArm inv f region) (fresh-ir-id))) :ruleset ra-structured-plan)
(rule ((RAStructuredLane inv f region lane op) (RAStructuredOwner inv f op))
      ((set (RAStructuredOwners inv f region lane) (set-of op))) :ruleset ra-structured-plan)
(rule ((= entry (RAStructuredEntry inv f region lane))
       (= exit (RAStructuredExit inv f region lane)))
      ((RABlock inv f entry) (RABlock inv f exit)
       (RAStructuredState (RASP inv f region lane entry (set-empty)))) :ruleset ra-structured-plan)
(rule ((= entry (RAStructuredOwnerEntry inv f owner)) (= exit (RAStructuredOwnerExit inv f owner)))
      ((RABlock inv f entry) (RABlock inv f exit)) :ruleset ra-structured-plan)
(rule ((RAStructuredLane inv f region lane op) (= entry (RAStructuredEntry inv f region lane)))
      ((RARequired inv f op entry)) :ruleset ra-structured-plan)

(rule ((RAStructuredState state))
      ((set (RAStructuredBlocked state) (set-empty))) :ruleset ra-structured-blocked)
(rule ((RAStructuredState state) (= state (RASP inv f region lane block seen))
       (RAStructuredLane inv f region lane owner) (RAStructuredOwner inv f owner)
       (RAStructuredBefore inv f owner pred) (RAStructuredOwner inv f pred)
       (RAStructuredLane inv f region lane pred) (set-not-contains seen pred))
      ((set (RAStructuredBlocked state) (set-of owner))) :ruleset ra-structured-blocked)
(rule ((RAStructuredState state) (= state (RASP inv f region lane block seen))
       (RAStructuredLane inv f region lane owner) (RAStructuredOwner inv f owner)
       (set-not-contains seen owner) (set-not-contains (RAStructuredBlocked state) owner))
      ((set (RAStructuredReady state) owner)) :ruleset ra-structured-ready)
(rule ((RAStructuredState state) (= state (RASP inv f region lane block seen))
       (= owner (RAStructuredReady state)) (= entry (RAStructuredOwnerEntry inv f owner))
       (= exit (RAStructuredOwnerExit inv f owner)))
      ((RAStructuredLink inv f block entry)
       (RAStructuredState (RASP inv f region lane exit (set-insert seen owner))))
      :ruleset ra-structured-step)
(rule ((RAStructuredState state) (= state (RASP inv f region lane block seen))
       (= seen (RAStructuredOwners inv f region lane)) (= exit (RAStructuredExit inv f region lane)))
      ((RAStructuredLink inv f block exit)) :ruleset ra-structured-emit)
(rule ((RAStructuredLink inv f from dest)
       (set-not-contains (RAStructuredAllocated inv f "jump") from))
      ((set (RAStructuredAllocated inv f "jump") (set-of from))
       (set (RAStructuredJump inv f from dest) (fresh-ir-id))) :ruleset ra-structured-emit)
(rule ((= op (RAStructuredJump inv f from dest)))
      ((RAJump inv f op from dest) (RAControlEdge inv f from dest)
       (RANode inv f op "cfg.br") (RAPin inv f op from)
       (RATerminator inv f op from)) :ruleset ra-structured-emit)
(rule ((RAStructuredFunction inv f) (RAFunction inv f region)
       (= entry (RAStructuredEntry inv f region 0)) (= exit (RAStructuredExit inv f region 0))
       (set-not-contains (RAStructuredAllocated inv f "return") f))
      ((set (RAStructuredAllocated inv f "return") (set-of f))
       (RAEntry inv f entry) (RAExit inv f exit)
       (set (RAReturnNode inv f) (fresh-ir-id))) :ruleset ra-structured-emit)
(rule ((RAStructuredFunction inv f) (= op (RAReturnNode inv f)) (RAExit inv f exit))
      ((RAReturn inv f op exit) (RANode inv f op "func.return")
       (RAPin inv f op exit) (RATerminator inv f op exit)) :ruleset ra-structured-emit)
(rule ((RAStructuredFunction inv f) (RAFunction inv f region)
       (= op (RAReturnNode inv f)) (= value (Yield region slot)))
      ((RAReturnValue inv f op slot value) (RAUse inv f op slot value)) :ruleset ra-structured-emit)

;; Gamma joins reuse the owner's result IDs as destination block parameters.
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= region (OwnedRegion owner slot))
       (= stub (RAStructuredArm inv f region)) (= entry (RAStructuredEntry inv f region 0))
       (= exit (RAStructuredExit inv f region 0)) (= joined (RAStructuredOwnerExit inv f owner)))
      ((RABlock inv f stub) (RAStructuredLink inv f stub entry)
       (RAStructuredLink inv f exit joined)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= op (RAStructuredGate inv f owner))
       (= block (RAStructuredOwnerEntry inv f owner)) (GammaSelector owner predicate)
       (= region (GammaDefaultArm owner)) (= dest (RAStructuredArm inv f region)))
      ((RASwitch inv f op block predicate dest) (RASwitchOwner inv f op owner)
       (RAControlEdge inv f block dest)
       (RANode inv f op "cfg.switch") (RAPin inv f op block)
       (RATerminator inv f op block) (RAUse inv f op 0 predicate)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= op (RAStructuredGate inv f owner))
       (= block (RAStructuredOwnerEntry inv f owner)) (= region (GammaArm owner case))
       (= dest (RAStructuredArm inv f region)) (= ordinal (RegionSlot region)))
      ((RASwitchCase inv f op ordinal case dest) (RAControlEdge inv f block dest)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= block (RAStructuredOwnerExit inv f owner))
       (Result owner slot value))
      ((RABinding inv f block slot value)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= region (OwnedRegion owner arm))
       (= stub (RAStructuredArm inv f region)) (= entry (RAStructuredEntry inv f region 0))
       (= edge (RAStructuredJump inv f stub entry)) (RegionParam region slot joined)
       (EntryValue region slot incoming))
      ((RABinding inv f entry slot joined) (RAIncoming inv f edge entry slot joined incoming)
       (RAUse inv f edge slot incoming)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (Gamma owner) (= region (OwnedRegion owner arm))
       (= exit (RAStructuredExit inv f region 0)) (= block (RAStructuredOwnerExit inv f owner))
       (= edge (RAStructuredJump inv f exit block)) (Result owner slot joined)
       (ExitValue region slot incoming))
      ((RAIncoming inv f edge block slot joined incoming) (RAUse inv f edge slot incoming))
      :ruleset ra-structured-emit)

;; Theta's test precedes both selective cones. The backedge and final edge own
;; their corresponding uses, so feedback never demands the exit computation.
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= before (RAStructuredOwnerEntry inv f owner)) (= after (RAStructuredOwnerExit inv f owner))
       (= header (RAStructuredEntry inv f region 0))
       (= feedback (RAStructuredExit inv f region 1)) (= exit (RAStructuredExit inv f region 2)))
      ((RAStructuredLink inv f before header) (RAStructuredLink inv f feedback header)
       (RAStructuredLink inv f exit after)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= op (RAStructuredGate inv f owner)) (= block (RAStructuredExit inv f region 0))
       (= slot (ThetaPredicate owner)) (= predicate (Yield region slot))
       (= taken (RAStructuredEntry inv f region 1)) (= fallthrough (RAStructuredEntry inv f region 2))
       (= (ThetaContinueOn owner) true))
      ((RABranch inv f op block predicate taken fallthrough)
       (RAUse inv f op 0 predicate) (RANode inv f op "cfg.cond_br")
       (RAPin inv f op block) (RATerminator inv f op block)
       (RAControlEdge inv f block taken) (RAControlEdge inv f block fallthrough)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= op (RAStructuredGate inv f owner)) (= block (RAStructuredExit inv f region 0))
       (= slot (ThetaPredicate owner)) (= predicate (Yield region slot))
       (= taken (RAStructuredEntry inv f region 2)) (= fallthrough (RAStructuredEntry inv f region 1))
       (= (ThetaContinueOn owner) false))
      ((RABranch inv f op block predicate taken fallthrough)
       (RAUse inv f op 0 predicate) (RANode inv f op "cfg.cond_br")
       (RAPin inv f op block) (RATerminator inv f op block)
       (RAControlEdge inv f block taken) (RAControlEdge inv f block fallthrough)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= before (RAStructuredOwnerEntry inv f owner)) (= header (RAStructuredEntry inv f region 0))
       (= edge (RAStructuredJump inv f before header)) (RegionParam region slot joined)
       (EntryValue region slot incoming))
      ((RABinding inv f header slot joined) (RAIncoming inv f edge header slot joined incoming)
       (RAUse inv f edge slot incoming)) :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= feedback (RAStructuredExit inv f region 1)) (= header (RAStructuredEntry inv f region 0))
       (= edge (RAStructuredJump inv f feedback header)) (RegionParam region slot joined)
       (FeedbackValue region slot incoming))
      ((RAIncoming inv f edge header slot joined incoming) (RAUse inv f edge slot incoming))
      :ruleset ra-structured-emit)
(rule ((RAStructuredActive inv f owner) (= region (ThetaBody owner))
       (= exit (RAStructuredExit inv f region 2)) (= after (RAStructuredOwnerExit inv f owner))
       (= edge (RAStructuredJump inv f exit after)) (Result owner slot joined)
       (ExitValue region slot incoming))
      ((RABinding inv f after slot joined) (RAIncoming inv f edge after slot joined incoming)
       (RAUse inv f edge slot incoming)) :ruleset ra-structured-emit)

;; All switch destinations are frozen before mandatory placement. Equality of
;; their demanded destination sets proves the operation runs on every arm.
(rule ((RASwitch inv f switch block predicate default))
      ((set (RASwitchDestinations inv f switch) (set-of default))) :ruleset ra-structured-emit)
(rule ((RASwitchCase inv f switch ordinal case dest))
      ((set (RASwitchDestinations inv f switch) (set-of dest))) :ruleset ra-structured-emit)
(rule ((RASwitch inv f switch block predicate default) (RANode inv f op kind))
      ((set (RASwitchDemands inv f switch op) (set-empty))) :ruleset ra-control-mandatory)
(rule ((RASwitch inv f switch block predicate default) (RAControlEdge inv f block dest)
       (RAAllPathsDemand inv f op dest))
      ((set (RASwitchDemands inv f switch op) (set-of dest))) :ruleset ra-control-mandatory)
(rule ((RASwitch inv f switch block predicate default) (RANode inv f op kind)
       (= (RASwitchDemands inv f switch op) (RASwitchDestinations inv f switch)))
      ((RAAllPathsDemand inv f op block)) :ruleset ra-control-mandatory)
