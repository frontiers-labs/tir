;; Generic guard and field evaluation over canonical TMDL encoding metadata.

(ruleset ra-target-shapes)

(ruleset ra-target-fields)

(relation RATransferPatternRequest (i64 i64 i64 i64 String i64))

(relation RATransferPattern (i64 i64 i64 i64 String i64 BigInt BigInt))

(function RATransferGuardYes (i64 i64 i64 i64 i64) RAIds :merge (set-union old new))

(function RATransferGuardNo (i64 i64 i64 i64 i64) RAIds :merge (set-union old new))

(function RATransferEncodingFields (i64 String i64) RAIds :merge (set-union old new))

(function RATransferRangedFields (i64 String i64) RAIds :merge (set-union old new))

(function RATransferValidFields (i64 i64 i64 i64 i64) RAIds :merge (set-union old new))

(relation RATransferFieldAligned (i64 i64 i64 i64 i64 i64))

(relation RATransferFieldRange (i64 i64 i64 i64 i64 i64))

(relation RATransferCompare (i64 i64 i64 i64 i64 String BigInt BigInt BigInt BigInt))

(relation RATransferSignRequest (BigInt i64))

(relation RATransferSigned (BigInt i64 BigInt))

(rule ((TMDLEncodingShape inv kind shape guard width bits))
      ((set (RATransferEncodingFields inv kind shape) (set-empty))
       (set (RATransferRangedFields inv kind shape) (set-empty))) :ruleset ra-transfer-verify-index)

(rule ((TMDLEncodingField inv kind shape field name mask nonzero))
      ((set (RATransferEncodingFields inv kind shape) (set-of field))) :ruleset ra-transfer-verify-index)

(rule ((TMDLEncodingRange inv kind shape field lower upper unsigned))
      ((set (RATransferRangedFields inv kind shape) (set-of field))) :ruleset ra-transfer-verify-index)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLEncodingShape inv kind shape guard width bits))
      ((set (RATransferValidFields inv f candidate op shape) (set-empty))) :ruleset ra-transfer-verify-index)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard tag a b x y z bits comparison))
      ((set (RATransferGuardYes inv f candidate op guard) (set-empty))
       (set (RATransferGuardNo inv f candidate op guard) (set-empty))) :ruleset ra-transfer-verify-index)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "true" a b x y z bits comparison))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferGuard inv f candidate op child true) (RATransferNative f op kind recipe)
       (TMDLGuardChild inv kind parent slot child))
      ((set (RATransferGuardYes inv f candidate op parent) (set-of slot))) :ruleset ra-target-shapes)

(rule ((RATransferGuard inv f candidate op child false) (RATransferNative f op kind recipe)
       (TMDLGuardChild inv kind parent slot child))
      ((set (RATransferGuardNo inv f candidate op parent) (set-of slot))) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLGuard inv kind guard "and" a b count y z bits comparison)
       (= count (set-length (RATransferGuardYes inv f candidate op guard))))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLGuard inv kind guard "and" a b count y z bits comparison)
       (> (set-length (RATransferGuardNo inv f candidate op guard)) 0))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLGuard inv kind guard "or" a b count y z bits comparison)
       (> (set-length (RATransferGuardYes inv f candidate op guard)) 0))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLGuard inv kind guard "or" a b count y z bits comparison)
       (= count (set-length (RATransferGuardNo inv f candidate op guard))))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLGuard inv kind guard "not" a b 1 y z bits comparison)
       (TMDLGuardChild inv kind guard 0 child) (RATransferGuard inv f candidate op child true))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLGuard inv kind guard "not" a b 1 y z bits comparison)
       (TMDLGuardChild inv kind guard 0 child) (RATransferGuard inv f candidate op child false))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLEncodingShape inv kind shape guard width bits)
       (RATransferGuard inv f candidate op guard true))
      ((set (RATransferFirstShape inv f candidate op) shape)) :ruleset ra-target-shapes)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLEncodingField inv kind shape field name mask false)
       (= align (hex-big mask)) (RATransferNumber inv f candidate op name value) (= (& (bigint value) align) (bigint 0)))
      ((RATransferFieldAligned inv f candidate op shape field)) :ruleset ra-target-fields)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLEncodingField inv kind shape field name mask true)
       (= align (hex-big mask)) (RATransferNumber inv f candidate op name value) (= (& (bigint value) align) (bigint 0)) (!= value 0))
      ((RATransferFieldAligned inv f candidate op shape field)) :ruleset ra-target-fields)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLEncodingField inv kind shape field name mask nonzero)
       (set-not-contains (RATransferRangedFields inv kind shape) field))
      ((RATransferFieldRange inv f candidate op shape field)) :ruleset ra-target-fields)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLEncodingField inv kind shape field name mask nonzero)
       (TMDLEncodingRange inv kind shape field lower upper unsigned)
       (RATransferNumber inv f candidate op name value) (>= value lower) (< value upper))
      ((RATransferFieldRange inv f candidate op shape field)) :ruleset ra-target-fields)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLEncodingField inv kind shape field name mask nonzero)
       (TMDLEncodingRange inv kind shape field lower upper unsigned) (= maximum (hex-big unsigned))
       (RATransferNumber inv f candidate op name value) (>= value 0)
       (< (bigint value) maximum))
      ((RATransferFieldRange inv f candidate op shape field)) :ruleset ra-target-fields)

(rule ((RATransferFieldAligned inv f candidate op shape field)
       (RATransferFieldRange inv f candidate op shape field))
      ((set (RATransferValidFields inv f candidate op shape) (set-of field))) :ruleset ra-target-fields)

(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (= shape (RATransferFirstShape inv f candidate op))
       (= (RATransferValidFields inv f candidate op shape) (RATransferEncodingFields inv kind shape))
       (RARecipeProfileEligible inv kind recipe))
      ((set (RATransferVerifiedOps inv f candidate) (set-of op))) :ruleset ra-target-fields)

(rule ((RATransferSignRequest pattern width) (> width 0) (<= width 128)
       (= (& pattern (<< (bigint 1) (- width 1))) (bigint 0)))
      ((RATransferSigned pattern width pattern)) :ruleset ra-target-shapes)

(rule ((RATransferSignRequest pattern width) (> width 0) (<= width 128)
       (!= (& pattern (<< (bigint 1) (- width 1))) (bigint 0)))
      ((RATransferSigned pattern width (- pattern (<< (bigint 1) width)))) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard tag a b width y z bits comparison)
       (RATransferNumber inv f candidate op a value) (> width 0) (<= width 128))
      ((RATransferPatternRequest inv f candidate op a width)) :ruleset ra-transfer-verify-index)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "same" a b width y z bits comparison)
       (RATransferNumber inv f candidate op b value) (> width 0) (<= width 128))
      ((RATransferPatternRequest inv f candidate op b width)) :ruleset ra-transfer-verify-index)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "slice-eq" a b lo hi z bits comparison))
      ((RATransferPatternRequest inv f candidate op a (+ hi 1))) :ruleset ra-transfer-verify-index)

(rule ((RATransferPatternRequest inv f candidate op name width) (> width 0) (<= width 128)
       (RATransferNumber inv f candidate op name value)
       (= unsigned (& (bigint value) (- (<< (bigint 1) width) (bigint 1)))))
      ((RATransferSignRequest unsigned width)) :ruleset ra-target-shapes)

(rule ((RATransferPatternRequest inv f candidate op name width) (> width 0) (<= width 128)
       (RATransferNumber inv f candidate op name value)
       (= unsigned (& (bigint value) (- (<< (bigint 1) width) (bigint 1))))
       (RATransferSigned unsigned width signed))
      ((RATransferPattern inv f candidate op name width unsigned signed)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "bit" a b x y z bits comparison)
       (RATransferNumber inv f candidate op a value)
       (>= x 0)
       (< x 128)
       (!= (& (>> (bigint value) x) (bigint 1)) (bigint 0)))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "bit" a b x y z bits comparison)
       (RATransferNumber inv f candidate op a value)
       (>= x 0)
       (< x 128)
       (= (& (>> (bigint value) x) (bigint 1)) (bigint 0)))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "slice-eq" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a (+ y 1) unsigned signed)
       (= expected (hex-big bits))
       (>= x 0)
       (< y 128)
       (= (>> unsigned x) expected))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "slice-eq" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a (+ y 1) unsigned signed)
       (= expected (hex-big bits))
       (>= x 0)
       (< y 128)
       (!= (>> unsigned x) expected))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "same" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x first firstSigned)
       (RATransferPattern inv f candidate op b x second secondSigned)
       (= first second))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "same" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x first firstSigned)
       (RATransferPattern inv f candidate op b x second secondSigned)
       (!= first second))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "signed-fits" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x unsigned signed)
       (> y 0)
       (< y 128)
       (= limit (<< (bigint 1) (- y 1)))
       (>= signed (- (bigint 0) limit))
       (< signed limit))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "signed-fits" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x unsigned signed)
       (> y 0)
       (< y 128)
       (= limit (<< (bigint 1) (- y 1)))
       (>= signed limit))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "signed-fits" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x unsigned signed)
       (> y 0)
       (< y 128)
       (= limit (<< (bigint 1) (- y 1)))
       (< signed (- (bigint 0) limit)))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "unsigned-fits" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x unsigned signed)
       (>= y 0)
       (< y 128)
       (< unsigned (<< (bigint 1) y)))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate)
       (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "unsigned-fits" a b x y z bits comparison)
       (RATransferPattern inv f candidate op a x unsigned signed)
       (>= y 0)
       (< y 128)
       (>= unsigned (<< (bigint 1) y)))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "cmp" a b width cmpWidth z bits comparison)
       (RATransferPattern inv f candidate op a width unsigned sourceSigned)
       (> cmpWidth 0) (<= cmpWidth 128)
       (= expected (& (hex-big bits) (- (<< (bigint 1) cmpWidth) (bigint 1)))))
      ((RATransferSignRequest unsigned cmpWidth)
       (RATransferSignRequest expected cmpWidth)) :ruleset ra-target-shapes)

(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (TMDLGuard inv kind guard "cmp" a b width cmpWidth z bits comparison)
       (RATransferPattern inv f candidate op a width unsigned sourceSigned)
       (> cmpWidth 0) (<= cmpWidth 128)
       (= expected (& (hex-big bits) (- (<< (bigint 1) cmpWidth) (bigint 1))))
       (RATransferSigned unsigned cmpWidth signed) (RATransferSigned expected cmpWidth expectedSigned))
      ((RATransferCompare inv f candidate op guard comparison unsigned expected signed expectedSigned)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "eq" unsigned expectedUnsigned signed expectedSigned)
       (= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "eq" unsigned expectedUnsigned signed expectedSigned)
       (!= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ne" unsigned expectedUnsigned signed expectedSigned)
       (!= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ne" unsigned expectedUnsigned signed expectedSigned)
       (= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "lt" unsigned expectedUnsigned signed expectedSigned)
       (< signed expectedSigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "lt" unsigned expectedUnsigned signed expectedSigned)
       (>= signed expectedSigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "le" unsigned expectedUnsigned signed expectedSigned)
       (<= signed expectedSigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "le" unsigned expectedUnsigned signed expectedSigned)
       (> signed expectedSigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "gt" unsigned expectedUnsigned signed expectedSigned)
       (> signed expectedSigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "gt" unsigned expectedUnsigned signed expectedSigned)
       (<= signed expectedSigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ge" unsigned expectedUnsigned signed expectedSigned)
       (>= signed expectedSigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ge" unsigned expectedUnsigned signed expectedSigned)
       (< signed expectedSigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ult" unsigned expectedUnsigned signed expectedSigned)
       (< unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ult" unsigned expectedUnsigned signed expectedSigned)
       (>= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ule" unsigned expectedUnsigned signed expectedSigned)
       (<= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ule" unsigned expectedUnsigned signed expectedSigned)
       (> unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ugt" unsigned expectedUnsigned signed expectedSigned)
       (> unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "ugt" unsigned expectedUnsigned signed expectedSigned)
       (<= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "uge" unsigned expectedUnsigned signed expectedSigned)
       (>= unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard true)) :ruleset ra-target-shapes)

(rule ((RATransferCompare inv f candidate op guard "uge" unsigned expectedUnsigned signed expectedSigned)
       (< unsigned expectedUnsigned))
      ((RATransferGuard inv f candidate op guard false)) :ruleset ra-target-shapes)
