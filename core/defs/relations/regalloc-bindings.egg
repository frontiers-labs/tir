;; Install after regalloc-control and regalloc-color. Saturate each phase in order:
;; ra-bind-index, ra-bind-count, ra-bind-slots, ra-bind-require, ra-bind-domain, ra-bind-check, ra-bind-complete.
;; Target rows and the imported source revision remain frozen throughout.
(ruleset ra-bind-index)
(ruleset ra-bind-count)
(ruleset ra-bind-slots)
(ruleset ra-bind-require)
(ruleset ra-bind-domain)
(ruleset ra-bind-check)
(ruleset ra-bind-complete)
;; direction, schema index, field name, optional, variadic, control
(relation RAFixedSlot (i64 String String String String i64))
;; guard kind, operand names, numeric parameters, exact 128-bit pattern, comparison

(function RANativePhysicalFields (i64 i64 i64 String) RAIds :merge (set-union old new))
(function RANativeControlled (i64 i64) RAIds :merge (set-union old new))
(function RAHardwiredIndices (i64 String) RAIds :merge (set-union old new))
(relation RANativeControlType (TypeExpr))
(function RANativeCount (i64 i64 i64 String) i64 :merge (max old new))
(function RASegmentedOps (i64 i64 String) RAIds :merge (set-union old new))
(function RASegmentCount (i64 i64 i64 String) i64 :merge (max old new))
(function RANativeStateValues (i64 i64) RAIds :merge (set-union old new))
(relation RANativeRead (i64 i64 i64 String i64 i64))
(function RANativeValidShape (i64 i64 i64) RAIds :merge (set-union old new))
(function RANativeBoundSlots (i64 i64 i64 String) RAIds :merge (set-union old new))
(relation RANativeSegment (i64 i64 i64 String i64 i64))
(relation RAFieldStart (i64 i64 i64 String i64 i64))
;; The slot's final index addresses the actual compressed Operand/Result table.
(relation RANativeSlot (i64 i64 i64 String String i64 i64))
(relation RAHardwareSlot (i64 i64 i64 String String i64 i64 String))
(relation RAValueRequirement (i64 i64 i64 String))
(function RAValueClassOrder (i64 i64 i64) i64 :merge (min old new))
(function RARequirementIndices (i64 String) RAIds :merge (set-union old new))
(function RABindingErrors (i64 i64) RAIds :merge (set-union old new))
(relation RABindingError (i64 i64 i64 String))
(relation RABindingsComplete (i64 i64))

(rule ((RAFunction inv f region))
      ((RANativeControlType (Apply (Ctor "son.control") (TNil)))
       (set (RASegmentedOps inv f "in") (set-empty))
       (set (RASegmentedOps inv f "out") (set-empty))
       (set (RANativeStateValues inv f) (set-empty))
       (set (RANativeControlled inv f) (set-empty))
       (set (RABindingErrors inv f) (set-empty))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect))
      ((set (RANativeCount inv f op "in") 0)
       (set (RANativeCount inv f op "out") 0)
       (set (RASegmentCount inv f op "in") 0)
       (set (RASegmentCount inv f op "out") 0)
       (set (RANativeValidShape inv f op) (set-empty))
       (set (RANativeBoundSlots inv f op "in") (set-empty))
       (set (RANativeBoundSlots inv f op "out") (set-empty))
       (set (RANativePhysicalFields inv f op "in") (set-empty))
       (set (RANativePhysicalFields inv f op "out") (set-empty))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= value (Operand op slot)))
      ((RANativeRead inv f op "in" slot value)) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (Result op slot value))
      ((RANativeRead inv f op "out" slot value)) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= (Attribute op "operand_segment_sizes") (ListAttr xs)))
      ((set (RASegmentedOps inv f "in") (set-of op))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= (Attribute op "result_segment_sizes") (ListAttr xs)))
      ((set (RASegmentedOps inv f "out") (set-of op))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= (Attribute op "operand_segment_sizes") (ListAttr xs))
       (AttrItem xs slot (IntegerAttr ty bits hex)) (= size (hex-i64 hex)))
      ((RANativeSegment inv f op "in" slot size)
       (set (RASegmentCount inv f op "in") (+ slot 1))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= (Attribute op "result_segment_sizes") (ListAttr xs))
       (AttrItem xs slot (IntegerAttr ty bits hex)) (= size (hex-i64 hex)))
      ((RANativeSegment inv f op "out" slot size)
       (set (RASegmentCount inv f op "out") (+ slot 1))) :ruleset ra-bind-index)
;; Fixed SSA roles use the generator's canonical read name and write _def suffix.
(rule ((TMDLFixedRead inv kind class index) (TMDLRegisterName inv class name index)
       (TMDLInstructionSlot inv kind "in" slot name optional variadic false))
      ((RAFixedSlot inv kind "in" name class index)
       (TMDLSlotClass inv kind name class)) :ruleset ra-bind-index)
(rule ((TMDLFixedWrite inv kind class index) (TMDLRegisterName inv class name index)
       (= field (+ name "_def"))
       (TMDLInstructionSlot inv kind "out" slot field optional variadic false))
      ((RAFixedSlot inv kind "out" field class index)
       (TMDLSlotClass inv kind field class)) :ruleset ra-bind-index)
(rule ((TMDLClass inv class file group offset merge))
      ((set (RARequirementIndices inv class) (set-empty))
       (set (RAHardwiredIndices inv class) (set-empty))) :ruleset ra-bind-index)
(rule ((TMDLRegister inv class index))
      ((set (RARequirementIndices inv class) (set-of index))) :ruleset ra-bind-index)

(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (TMDLInstructionSlotCount inv kind direction count))
      ((RAFieldStart inv f op direction 0 0)) :ruleset ra-bind-slots)
(rule ((RAFunction inv f region) (= (ValueType value) (Apply (Ctor "builtin.state") args)))
      ((set (RANativeStateValues inv f) (set-of value))) :ruleset ra-bind-index)
(rule ((RANativeRead inv f op direction actual value))
      ((set (RANativeCount inv f op direction) (+ actual 1))) :ruleset ra-bind-count)
(rule ((RAFieldStart inv f op direction field start)
       (RANativeSegment inv f op direction field size) (>= size 0)
       (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic control))
      ((RAFieldStart inv f op direction (+ field 1) (+ start size))) :ruleset ra-bind-slots)
;; Without segments native optional slots use the existing prefix convention.
(rule ((RAFieldStart inv f op direction field start)
       (set-not-contains (RASegmentedOps inv f direction) op)
       (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional false control)
       (RANativeRead inv f op direction start value)
       (set-not-contains (RANativeStateValues inv f) value))
      ((RANativeSegment inv f op direction field 1)) :ruleset ra-bind-slots)
(rule ((RAFieldStart inv f op direction field start)
       (set-not-contains (RASegmentedOps inv f direction) op)
       (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name true false control)
       (>= start (RANativeCount inv f op direction)))
      ((RANativeSegment inv f op direction field 0)) :ruleset ra-bind-slots)
(rule ((RAFieldStart inv f op direction field start)
       (set-not-contains (RASegmentedOps inv f direction) op)
       (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name true false control)
       (RANativeRead inv f op direction start value)
       (set-contains (RANativeStateValues inv f) value))
      ((RANativeSegment inv f op direction field 0)) :ruleset ra-bind-slots)
(rule ((RAFieldStart inv f op direction field start)
       (set-not-contains (RASegmentedOps inv f direction) op)
       (RASource inv f op kind) (TMDLInstructionStateSlot inv kind direction field)
       (= count (RANativeCount inv f op direction)) (>= count start))
      ((RANativeSegment inv f op direction field (- count start))) :ruleset ra-bind-slots)
(rule ((RAFieldStart inv f op "in" field start)
       (RANativeSegment inv f op "in" field size)
       (RASource inv f op kind)
       (TMDLInstructionSlot inv kind "in" field name optional variadic control)
       (RANativeRead inv f op "in" actual value)
       (>= actual start) (< actual (+ start size)))
      ((RANativeSlot inv f op "in" name actual value)) :ruleset ra-bind-slots)
(rule ((RAFieldStart inv f op "out" field start)
       (RANativeSegment inv f op "out" field size)
       (RASource inv f op kind)
       (TMDLInstructionSlot inv kind "out" field name optional variadic control)
       (RANativeRead inv f op "out" actual value)
       (>= actual start) (< actual (+ start size)))
      ((RANativeSlot inv f op "out" name actual value)) :ruleset ra-bind-slots)
(rule ((RANativeSlot inv f op direction name slot value) (RASource inv f op kind)
       (TMDLSlotClass inv kind name class) (= ty (ValueType value))
       (set-not-contains (RANativeStateValues inv f) value)
       (!= ty (Apply (Ctor "son.control") (TNil))))
      ((RAHardwareSlot inv f op direction name slot value class)
       (RAValueRequirement inv f value class)) :ruleset ra-bind-require)
(rule ((RAIncoming inv f edge block slot joined incoming)
       (RAValueRequirement inv f joined class))
      ((RAValueRequirement inv f incoming class)) :ruleset ra-bind-require)
(rule ((RAIncoming inv f edge block slot joined incoming)
       (RAValueRequirement inv f incoming class))
      ((RAValueRequirement inv f joined class)) :ruleset ra-bind-require)
(rule ((RAValueRequirement inv f value class) (TMDLRegisterWidth inv class bits))
      ((set (RAValueBits inv f value) bits)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op "in" name slot input class)
       (RAHardwareSlot inv f op "out" name resultSlot result outClass))
      ((RATiedOperands inv f op slot result)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op "in" name slot value class)
       (= (Attribute op "pins") (DictAttr pins))
       (DictItem pins name (PhysicalRegisterAttr target pinned index)))
      ((RAInputPin inv f op slot value pinned index)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op "out" name slot value class)
       (= (Attribute op "pins") (DictAttr pins))
       (DictItem pins name (PhysicalRegisterAttr target pinned index)))
      ((RAOutputPin inv f op value pinned index)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op "in" name slot value class) (RASource inv f op kind)
       (RAFixedSlot inv kind "in" name fixed index))
      ((RAInputPin inv f op slot value fixed index)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op "out" name slot value class) (RASource inv f op kind)
       (RAFixedSlot inv kind "out" name fixed index))
      ((RAOutputPin inv f op value fixed index)) :ruleset ra-bind-require)
(rule ((RAFunction inv f region) (= (Attribute f "assignment") (ListAttr entries))
       (AttrItem entries slot (AssignedRegisterAttr value target class index)))
      ((RAForcedRegister inv f value class index)) :ruleset ra-bind-require)
(rule ((RAValueRequirement inv f value class) (= (RAValueBits inv f value) bits)
       (TMDLRegisterWidth inv class bits) (TMDLClassOrder inv class order))
      ((set (RAValueClassOrder inv f value) order)) :ruleset ra-bind-domain)
(rule ((RAValueRequirement inv f value class) (TMDLClassOrder inv class order)
       (= (RAValueClassOrder inv f value) order))
      ((RAValueClass inv f value class)) :ruleset ra-bind-domain)
(rule ((RAValueClass inv f value class) (TMDLRegister inv class index)
       (RAValueRequirement inv f value required)
       (set-not-contains (RARequirementIndices inv required) index))
      ((RAValueExcluded inv f value class index)) :ruleset ra-bind-domain)

(rule ((RABindingError inv f entity message))
      ((set (RABindingErrors inv f) (set-of entity))) :ruleset ra-bind-check)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (TMDLInstructionSlotCount inv kind direction count)
       (set-contains (RASegmentedOps inv f direction) op)
       (!= count (RASegmentCount inv f op direction)))
      ((RABindingError inv f op "malformed native segment list")) :ruleset ra-bind-check)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (TMDLInstructionSlotCount inv kind direction count)
       (RAFieldStart inv f op direction count total)
       (!= total (RANativeCount inv f op direction)))
      ((RABindingError inv f op "native segment total differs from actual slots")) :ruleset ra-bind-check)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional false control)
       (RANativeSegment inv f op direction field size) (!= size 1)
       (!= size 0))
      ((RABindingError inv f op "native scalar segment has multiple values")) :ruleset ra-bind-check)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name false false control)
       (RANativeSegment inv f op direction field 0))
      ((RABindingError inv f op "missing required native slot")) :ruleset ra-bind-check)
(rule ((RAValueRequirement inv f value first) (RAValueRequirement inv f value second)
       (TMDLClass inv first firstFile firstGroup firstOffset firstMerge)
       (TMDLClass inv second secondFile secondGroup secondOffset secondMerge)
       (!= firstFile secondFile))
      ((RABindingError inv f value "value requires different physical register files")) :ruleset ra-bind-check)
(rule ((RAValueRequirement inv f value first) (RAValueRequirement inv f value second)
       (TMDLClass inv first file firstGroup firstOffset firstMerge)
       (TMDLClass inv second file secondGroup secondOffset secondMerge)
       (!= firstOffset secondOffset))
      ((RABindingError inv f value "value requires different register view offsets")) :ruleset ra-bind-check)
(rule ((RAValueRequirement inv f value first) (RAValueRequirement inv f value second)
       (TMDLClass inv first file firstGroup offset firstMerge)
       (TMDLClass inv second file secondGroup offset secondMerge)
       (!= firstGroup secondGroup))
      ((RABindingError inv f value "value requires different register group widths")) :ruleset ra-bind-check)
(rule ((RANativeSlot inv f op direction name slot value) (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic control)
       (TMDLInstructionStateSlot inv kind direction field)
       (set-not-contains (RANativeStateValues inv f) value))
      ((RABindingError inv f op "native state slot contains a non-state value")) :ruleset ra-bind-check)
(rule ((RAHardwareSlot inv f op direction name slot value class)
       (= (Attribute op "pins") (DictAttr pins))
       (DictItem pins name (PhysicalRegisterAttr target pinned index))
       (TMDLClassDialect inv pinned expected) (!= target expected))
      ((RABindingError inv f op "slot pin names a different target")) :ruleset ra-bind-check)

(rule ((RAHardwareSlot inv f op direction name slot value class))
      ((set (RANativeBoundSlots inv f op direction) (set-of slot))) :ruleset ra-bind-require)
(rule ((RANativeSlot inv f op direction name slot value) (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic true)
       (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((set (RANativeBoundSlots inv f op direction) (set-of slot))) :ruleset ra-bind-require)
(rule ((RANativeSlot inv f op direction name slot value) (RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic control)
       (TMDLInstructionStateSlot inv kind direction field)
       (set-contains (RANativeStateValues inv f) value))
      ((set (RANativeBoundSlots inv f op direction) (set-of slot))) :ruleset ra-bind-require)
(rule ((RANativeRead inv f op direction actual value)
       (RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (set-not-contains (RANativeBoundSlots inv f op direction) actual))
      ((RABindingError inv f op "native slot has no matching control, state, or register class"))
      :ruleset ra-bind-check)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (TMDLInstructionSlotCount inv kind "in" count)
       (RAFieldStart inv f op "in" count total)
       (= total (RANativeCount inv f op "in")))
      ((set (RANativeValidShape inv f op) (set-of 0))) :ruleset ra-bind-require)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (TMDLInstructionSlotCount inv kind "out" count)
       (RAFieldStart inv f op "out" count total)
       (= total (RANativeCount inv f op "out")))
      ((set (RANativeValidShape inv f op) (set-of 1))) :ruleset ra-bind-require)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (!= (set-length (RANativeValidShape inv f op)) 2))
      ((RABindingError inv f op "native operand or result grouping is incomplete"))
      :ruleset ra-bind-check)
(rule ((RAFunction inv f region) (= (set-length (RABindingErrors inv f)) 0))
      ((RABindingsComplete inv f)) :ruleset ra-bind-complete)

(rule ((TMDLHardwiredZero inv class index))
      ((set (RAHardwiredIndices inv class) (set-of index))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= control (Operand op slot))
       (= (ValueType control) (Apply (Ctor "son.control") (TNil))))
      ((set (RANativeControlled inv f) (set-of op))) :ruleset ra-bind-index)
(rule ((RACFGSource inv f op block point))
      ((set (RANativeControlled inv f) (set-of op))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic false)
       (RANativeSegment inv f op direction field 0)
       (TMDLSlotClass inv kind name required)
       (= (Attribute op name) (PhysicalRegisterAttr target class index)))
      ((set (RANativePhysicalFields inv f op direction) (set-of field))) :ruleset ra-bind-require)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic false)
       (RANativeSegment inv f op direction field 0)
       (RAFixedSlot inv kind direction name class index))
      ((set (RANativePhysicalFields inv f op direction) (set-of field))) :ruleset ra-bind-require)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind direction field name optional variadic false)
       (RANativeSegment inv f op direction field 0) (TMDLSlotClass inv kind name class)
       (set-not-contains (RANativePhysicalFields inv f op direction) field))
      ((RABindingError inv f op "omitted native register slot has no physical binding")) :ruleset ra-bind-check)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind "in" field name optional variadic false)
       (RANativeSegment inv f op "in" field 0)
       (= (Attribute op name) (PhysicalRegisterAttr target class index)))
      ((RANativePhysicalRead inv f op class index)) :ruleset ra-bind-require)
(rule ((RASource inv f op kind)
       (TMDLInstructionSlot inv kind "out" field name optional variadic false)
       (RANativeSegment inv f op "out" field 0)
       (= (Attribute op name) (PhysicalRegisterAttr target class index)))
      ((RANativePhysicalWrite inv f op class index)) :ruleset ra-bind-require)
(rule ((RANativePhysicalRead inv f op class index)
       (set-not-contains (RAHardwiredIndices inv class) index)
       (set-not-contains (RANativeControlled inv f) op))
      ((RABindingError inv f op "physical register read requires explicit control")) :ruleset ra-bind-check)
(rule ((RANativePhysicalWrite inv f op class index)
       (set-not-contains (RAHardwiredIndices inv class) index)
       (set-not-contains (RANativeControlled inv f) op))
      ((RABindingError inv f op "physical register write requires explicit control")) :ruleset ra-bind-check)

;; Native physical attributes constrain the named SSA slot as well as pins.
(rule ((RAHardwareSlot inv f op "in" name slot value required)
       (= (Attribute op name) (PhysicalRegisterAttr target class index)))
      ((RAInputPin inv f op slot value class index)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op "out" name slot value required)
       (= (Attribute op name) (PhysicalRegisterAttr target class index)))
      ((RAOutputPin inv f op value class index)) :ruleset ra-bind-require)
(rule ((RAValueRequirement inv f value required)
       (= (ValueType value) (Apply (Ctor "backend.reg")
          (TCons (SymbolParam target) (TCons (SymbolParam name) (TNil)))))
       (= dialect (SymbolName target)) (= class (SymbolName name))
       (TMDLClassDialect inv class dialect))
      ((RAValueRequirement inv f value class)) :ruleset ra-bind-require)
(rule ((RAHardwareSlot inv f op direction name slot value required)
       (= (Attribute op name) (PhysicalRegisterAttr target class index))
       (TMDLClassDialect inv class expected) (!= target expected))
      ((RABindingError inv f op "native physical attribute names a different target")) :ruleset ra-bind-check)

(sort RAFeatureNames (Set String))
(function RARecipeMatchedParameters (i64 String i64) RAFeatureNames :merge (set-union old new))
(relation RARecipeFeatureEligible (i64 String i64))
(relation RARecipeProfileEligible (i64 String i64))
(rule ((TMDLRecipe inv kind recipe transfer width address align features parameters))
      ((set (RARecipeMatchedParameters inv kind recipe) (set-empty))) :ruleset ra-bind-index)
(rule ((TMDLRecipe inv kind recipe transfer width address align 0 parameters))
      ((RARecipeFeatureEligible inv kind recipe)) :ruleset ra-bind-index)
(rule ((TMDLRecipeFeature inv kind recipe feature) (TMDLFeature inv feature))
      ((RARecipeFeatureEligible inv kind recipe)) :ruleset ra-bind-index)
(rule ((TMDLRecipeParameter inv kind recipe parameter value) (TMDLParameter inv parameter value))
      ((set (RARecipeMatchedParameters inv kind recipe) (set-of parameter))) :ruleset ra-bind-index)
(rule ((TMDLRecipe inv kind recipe transfer width address align features parameters)
       (RARecipeFeatureEligible inv kind recipe)
       (= parameters (set-length (RARecipeMatchedParameters inv kind recipe))))
      ((RARecipeProfileEligible inv kind recipe)) :ruleset ra-bind-slots)

(function RANativeClassifiedValues (i64 i64) RAIds :merge (set-union old new))
(rule ((RAFunction inv f region))
      ((set (RANativeClassifiedValues inv f) (set-empty))) :ruleset ra-bind-index)
(rule ((RAValueClass inv f value class))
      ((set (RANativeClassifiedValues inv f) (set-of value))) :ruleset ra-bind-domain)
(rule ((RAUse inv f op slot value) (set-not-contains (RANativeStateValues inv f) value)
       (= ty (ValueType value)) (!= ty (Apply (Ctor "son.control") (TNil)))
       (set-not-contains (RANativeClassifiedValues inv f) value))
      ((RABindingError inv f value "hardware value has no target register domain")) :ruleset ra-bind-check)
(rule ((RADef inv f op value) (set-not-contains (RANativeStateValues inv f) value)
       (= ty (ValueType value)) (!= ty (Apply (Ctor "son.control") (TNil)))
       (set-not-contains (RANativeClassifiedValues inv f) value))
      ((RABindingError inv f value "hardware definition has no target register domain")) :ruleset ra-bind-check)

(sort RANativeNames (Set String))
(function RANativeKnownClasses (i64) RANativeNames :merge (set-union old new))
(function RANativeKnownPinNames (i64 i64 i64) RANativeNames :merge (set-union old new))
(function RANativeValidPinNames (i64 i64 i64) RANativeNames :merge (set-union old new))
(function RANativePinDictionaries (i64 i64) RAIds :merge (set-union old new))
(function RANativeAssignmentLists (i64 i64) RAIds :merge (set-union old new))
(function RANativeAssignmentEntries (i64 i64) RAIds :merge (set-union old new))
(rule ((RAFunction inv f region))
      ((set (RANativeKnownClasses inv) (set-empty))
       (set (RANativePinDictionaries inv f) (set-empty))
       (set (RANativeAssignmentLists inv f) (set-empty))
       (set (RANativeAssignmentEntries inv f) (set-empty))) :ruleset ra-bind-index)
(rule ((TMDLClass inv class file width offset merge))
      ((set (RANativeKnownClasses inv) (set-of class))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind))
      ((set (RANativeKnownPinNames inv f op) (set-empty))
       (set (RANativeValidPinNames inv f op) (set-empty))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (= (Attribute op "pins") (DictAttr pins)))
      ((set (RANativePinDictionaries inv f) (set-of op))) :ruleset ra-bind-index)
(rule ((RAFunction inv f region) (= (Attribute f "assignment") (ListAttr entries)))
      ((set (RANativeAssignmentLists inv f) (set-of f))) :ruleset ra-bind-index)
(rule ((RAHardwareSlot inv f op direction name slot value class))
      ((set (RANativeKnownPinNames inv f op) (set-of name))) :ruleset ra-bind-require)
(rule ((RASource inv f op kind) (= (Attribute op "pins") (DictAttr pins))
       (DictItem pins name (PhysicalRegisterAttr target class index))
       (TMDLClassDialect inv class target) (TMDLRegister inv class index))
      ((set (RANativeValidPinNames inv f op) (set-of name))) :ruleset ra-bind-require)
(rule ((RASource inv f op kind) (= pins (Attribute op "pins"))
       (set-not-contains (RANativePinDictionaries inv f) op))
      ((RABindingError inv f op "pins attribute is not a dictionary")) :ruleset ra-bind-check)
(rule ((RASource inv f op kind) (= (Attribute op "pins") (DictAttr pins))
       (DictItem pins name attr) (set-not-contains (RANativeKnownPinNames inv f op) name))
      ((RABindingError inv f op "pin does not name a present hardware slot")) :ruleset ra-bind-check)
(rule ((RASource inv f op kind) (= (Attribute op "pins") (DictAttr pins))
       (DictItem pins name attr) (set-not-contains (RANativeValidPinNames inv f op) name))
      ((RABindingError inv f op "pin does not name a selected-target register")) :ruleset ra-bind-check)
(rule ((RAFunction inv f region) (= assignment (Attribute f "assignment"))
       (set-not-contains (RANativeAssignmentLists inv f) f))
      ((RABindingError inv f f "assignment attribute is not a list")) :ruleset ra-bind-check)
(rule ((RAFunction inv f region) (= (Attribute f "assignment") (ListAttr entries))
       (AttrItem entries slot (AssignedRegisterAttr value target class index))
       (TMDLClassDialect inv class target) (TMDLRegister inv class index))
      ((set (RANativeAssignmentEntries inv f) (set-of slot))) :ruleset ra-bind-require)
(rule ((RAFunction inv f region) (= (Attribute f "assignment") (ListAttr entries))
       (AttrItem entries slot attr) (set-not-contains (RANativeAssignmentEntries inv f) slot))
      ((RABindingError inv f f "assignment entry does not name a selected-target register")) :ruleset ra-bind-check)
(rule ((RAValueRequirement inv f value class) (set-not-contains (RANativeKnownClasses inv) class))
      ((RABindingError inv f value "unknown selected-target register class")) :ruleset ra-bind-check)
(rule ((RANativePhysicalRead inv f op class index) (set-not-contains (RANativeKnownClasses inv) class))
      ((RABindingError inv f op "physical read names a different target class")) :ruleset ra-bind-check)
(rule ((RANativePhysicalWrite inv f op class index) (set-not-contains (RANativeKnownClasses inv) class))
      ((RABindingError inv f op "physical write names a different target class")) :ruleset ra-bind-check)

(function RAEligibleOpcodes (i64) RANativeNames :merge (set-union old new))
(rule ((RAFunction inv f region))
      ((set (RAEligibleOpcodes inv) (set-empty))) :ruleset ra-bind-index)
(rule ((TMDLOpcodeFeatureCount inv kind 0))
      ((set (RAEligibleOpcodes inv) (set-of kind))) :ruleset ra-bind-index)
(rule ((TMDLOpcodeFeature inv kind feature) (TMDLFeature inv feature))
      ((set (RAEligibleOpcodes inv) (set-of kind))) :ruleset ra-bind-index)
(rule ((RASource inv f op kind) (TMDLOpcode inv kind local dialect)
       (set-not-contains (RAEligibleOpcodes inv) kind))
      ((RABindingError inv f op "operation is not selected for the target profile")) :ruleset ra-bind-check)
(rule ((RACFGSource inv f op block point) (RASource inv f op kind)
       (!= kind "cfg.br") (!= kind "cfg.cond_br") (!= kind "cfg.switch")
       (!= kind "son.branch") (!= kind "son.edge") (!= kind "son.merge")
       (!= kind "func.return") (!= kind "state.entry_state")
       (!= kind "state.join") (!= kind "state.split")
       (set-not-contains (RAEligibleOpcodes inv) kind))
      ((RABindingError inv f op "operation is not selected for the target profile")) :ruleset ra-bind-check)

;; A branch or a passthrough return can have no native register slot to impose
;; a class. Resolve those values only after native view propagation completes.
(ruleset ra-bind-fallback-index)
(ruleset ra-bind-fallback)
(function RARequiredValues (i64 i64) RAIds :merge (set-union old new))
(relation RALogicalValue (i64 i64 i64))
(rule ((RAFunction inv f region))
      ((set (RARequiredValues inv f) (set-empty))) :ruleset ra-bind-fallback-index)
(rule ((RAValueRequirement inv f value class))
      ((set (RARequiredValues inv f) (set-of value))) :ruleset ra-bind-fallback-index)
(rule ((RAUse inv f op slot value)) ((RALogicalValue inv f value)) :ruleset ra-bind-fallback-index)
(rule ((RADef inv f op value)) ((RALogicalValue inv f value)) :ruleset ra-bind-fallback-index)
(rule ((RALogicalValue inv f value) (set-not-contains (RARequiredValues inv f) value)
       (= (ValueType value) (Apply (Ctor "builtin.i") args))
       (TMDLAbiPin inv "arg" "int" 0 class index))
      ((RAValueRequirement inv f value class)) :ruleset ra-bind-fallback)
(rule ((RALogicalValue inv f value) (set-not-contains (RARequiredValues inv f) value)
       (= (ValueType value) (Apply (Ctor "ptr.p") args))
       (TMDLAbiPin inv "arg" "int" 0 class index))
      ((RAValueRequirement inv f value class)) :ruleset ra-bind-fallback)
(rule ((RALogicalValue inv f value) (set-not-contains (RARequiredValues inv f) value)
       (= (ValueType value) (Apply (Ctor "builtin.f") args))
       (TMDLAbiPin inv "arg" "float" 0 class index))
      ((RAValueRequirement inv f value class)) :ruleset ra-bind-fallback)
(rule ((RALogicalValue inv f value) (set-not-contains (RARequiredValues inv f) value)
       (= (ValueType value) (Apply (Ctor "backend.reg")
           (TCons (SymbolParam dialect) (TCons (SymbolParam name) (TNil)))))
       (= class (SymbolName name)) (TMDLClassDialect inv class target))
      ((RAValueRequirement inv f value class)) :ruleset ra-bind-fallback)

(rule ((RANativePhysicalRead inv f op class index)
       (set-not-contains (RARequirementIndices inv class) index))
      ((RABindingError inv f op "physical read register index is outside its class")) :ruleset ra-bind-check)
(rule ((RANativePhysicalWrite inv f op class index)
       (set-not-contains (RARequirementIndices inv class) index))
      ((RABindingError inv f op "physical write register index is outside its class")) :ruleset ra-bind-check)

(rule ((RACFGSource inv f op block point) (RANativePhysicalRead inv f op class index)
       (set-not-contains (RAHardwiredIndices inv class) index))
      ((RAPin inv f op block) (set (RAExplicitlyPinned inv f) (set-of op))) :ruleset ra-control-pin)
(rule ((RACFGSource inv f op block point) (RANativePhysicalWrite inv f op class index))
      ((RAPin inv f op block) (set (RAExplicitlyPinned inv f) (set-of op))) :ruleset ra-control-pin)
(rule ((RACFGSource inv f op block point) (RAOutputPin inv f op value class index))
      ((RAPin inv f op block) (set (RAExplicitlyPinned inv f) (set-of op))) :ruleset ra-control-pin)

(rule ((RAControlComplete inv f candidate) (RATiedOperands inv f op slot result)
       (RAUse inv f op slot tied) (RAUse inv f op otherSlot other) (!= slot otherSlot) (!= tied other)
       (RAColorValue inv f candidate result resultClass) (RAColorValue inv f candidate other otherClass))
      ((RAInterference inv f candidate result other)
       (RAInterference inv f candidate other result)) :ruleset ra-color-interfere)
