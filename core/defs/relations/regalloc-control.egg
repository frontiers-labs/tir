;; Control tokens name logical blocks. Publication allocates the real CFG
;; entities after a complete candidate has passed validation.
;;
;; Run each phase to saturation in this order:
;;   ra-control-import, ra-control-normalize, ra-control-entry, ra-control-reach,
;;   ra-control-dom, ra-control-demand, ra-control-mandatory,
;;   ra-control-mandatory-bad, ra-control-mandatory-legal,
;;   ra-control-mandatory-extrema, ra-control-pin,
;;   ra-control-demand, ra-control-bad,
;;   ra-control-legal, ra-control-extrema, ra-control-place,
;;   ra-control-pred, ra-control-seed,
;;   saturate(seq(saturate ra-control-blocked,
;;                saturate ra-control-priority,
;;                saturate ra-control-ready, run ra-control-step)),
;;   ra-control-finish, ra-control-check, ra-control-complete.
;; All reductions consumed by a later phase are frozen for this invocation.
(sort RAIds (Set i64))
(sort RASequence (Vec i64))
(ruleset ra-control-functions)
(ruleset ra-control-inputs)
(ruleset ra-control-import)
(ruleset ra-control-normalize)
(ruleset ra-control-entry)
(ruleset ra-control-reach)
(ruleset ra-control-dom)
(ruleset ra-control-demand)
(ruleset ra-control-mandatory)
(ruleset ra-control-mandatory-bad)
(ruleset ra-control-mandatory-legal)
(ruleset ra-control-mandatory-extrema)
(ruleset ra-control-pin)
(ruleset ra-control-bad)
(ruleset ra-control-legal)
(ruleset ra-control-extrema)
(ruleset ra-control-place)
(ruleset ra-control-pred)
(ruleset ra-control-seed)
(ruleset ra-control-blocked)
(ruleset ra-control-priority)
(ruleset ra-control-ready)
(ruleset ra-control-step)
(ruleset ra-control-finish)
(ruleset ra-control-check)
(ruleset ra-control-complete)

;; The importer only marks kinds with proven total, effect-free semantics.
;; A dynamic Speculatable interface's presence alone does not prove safety.
(relation RAMovable (i64 i64 i64))
(function RAPureOps (i64 i64) RAIds :merge (set-union old new))
(function RAExplicitlyPinned (i64 i64) RAIds :merge (set-union old new))
(relation RAControlYield (i64 i64 i64 i64))
(relation RAFunction (i64 i64 i64))
(function RAAlreadyAllocated (i64 i64) bool :merge (or old new))
(relation RAAllocatedFunction (i64 i64))
(relation RARequestedFunction (i64 i64))
(relation RASource (i64 i64 i64 String))
(relation RABlock (i64 i64 i64))
(relation RAEntry (i64 i64 i64))
(relation RAExit (i64 i64 i64))
(relation RAControlEdge (i64 i64 i64 i64))
(relation RANode (i64 i64 i64 String))
(relation RAPin (i64 i64 i64 i64))
(relation RADef (i64 i64 i64 i64))
(relation RAUse (i64 i64 i64 i64 i64))
(relation RAArgument (i64 i64 i64 i64))
(relation RABinding (i64 i64 i64 i64 i64))
(relation RAIncoming (i64 i64 i64 i64 i64 i64 i64))
(relation RABranch (i64 i64 i64 i64 i64 i64 i64))
(relation RAJump (i64 i64 i64 i64 i64))
(relation RAReturn (i64 i64 i64 i64))
(relation RAReturnValue (i64 i64 i64 i64 i64))
(function RAReturnNode (i64 i64) i64 :no-merge)
(function RADirectJump (i64 i64 i64 i64) i64 :no-merge)
(function RAIncomingControls (i64 i64 i64) RAIds :merge (set-union old new))
(function RASourceOps (i64 i64) RAIds :merge (set-union old new))
(function RAControlTokens (i64 i64) RAIds :merge (set-union old new))
(function RAImplicitControl (i64 i64) i64 :no-merge)
(function RARecognizedOps (i64 i64) RAIds :merge (set-union old new))
(relation RACFGFunction (i64 i64))
(relation RAGraphFunction (i64 i64))
(function RAStructuredFlag (i64 i64) bool :merge (or old new))
(function RAStructuredOwnerSet (i64 i64) RAIds :merge (set-union old new))
(relation RACFGSource (i64 i64 i64 i64 i64))
(relation RATerminator (i64 i64 i64 i64))

(rule ((RARequestedFunction inv f) (= (RAAlreadyAllocated inv f) false)
       (= region (OwnedRegion f 0)))
      ((RAFunction inv f region)
       (set (RASourceOps inv f) (set-empty))
       (set (RAControlTokens inv f) (set-empty))
       (set (RARecognizedOps inv f) (set-empty))
       (set (RAPureOps inv f) (set-empty))
       (set (RAExplicitlyPinned inv f) (set-empty))
       (set (RAStructuredFlag inv f) false)
       (set (RAStructuredOwnerSet inv f) (set-empty))) :ruleset ra-control-inputs)
(rule ((RAFunction inv f region) (= (OpPlacement op) (InGraph region))
       (= kind (OpKind op)))
      ((RASource inv f op kind) (set (RASourceOps inv f) (set-of op)))
      :ruleset ra-control-import)
(rule ((RAFunction inv f region) (= (Mode region) (CFG)))
      ((RACFGFunction inv f)) :ruleset ra-control-inputs)
(rule ((RAFunction inv f region) (= (Mode region) (Graph)))
      ((RAGraphFunction inv f)) :ruleset ra-control-inputs)
(rule ((RAFunction inv f region) (= region (BlockRegion block)))
      ((RABlock inv f block)) :ruleset ra-control-import)
(rule ((RACFGFunction inv f) (RAFunction inv f region) (= block (Entry region)))
      ((RAEntry inv f block)) :ruleset ra-control-import)
(rule ((RAFunction inv f region) (= region (BlockRegion block))
       (= (OpPlacement op) (InBlock block point)) (= kind (OpKind op)))
      ((RACFGSource inv f op block point) (RASource inv f op kind)
       (set (RASourceOps inv f) (set-of op))) :ruleset ra-control-import)
(rule ((RACFGSource inv f op block point) (RASource inv f op kind)
       (set-not-contains (RAPureOps inv f) op))
      ((RAPin inv f op block) (RANode inv f op kind)
       (set (RAExplicitlyPinned inv f) (set-of op))
       (set (RARecognizedOps inv f) (set-of op))) :ruleset ra-control-normalize)
(rule ((RAEntry inv f block) (BlockParam block slot value))
      ((RAArgument inv f slot value)) :ruleset ra-control-import)
(rule ((RACFGFunction inv f) (RAFunction inv f region) (= entry (Entry region))
       (= region (BlockRegion block)) (!= block entry) (BlockParam block slot value))
      ((RABinding inv f block slot value)) :ruleset ra-control-import)
(rule ((RACFGSource inv f op block point) (= dest (Successor op edge)))
      ((RAControlEdge inv f block dest) (RATerminator inv f op block)) :ruleset ra-control-import)
(rule ((RACFGSource inv f op block point) (= (OpKind op) "cfg.br")
       (= dest (Successor op 0)))
      ((RAJump inv f op block dest)) :ruleset ra-control-import)
(rule ((RACFGSource inv f op block point) (= (OpKind op) "cfg.cond_br")
       (= predicate (Operand op 0)) (= taken (Successor op 0)) (= fallthrough (Successor op 1)))
      ((RABranch inv f op block predicate taken fallthrough)) :ruleset ra-control-import)
(rule ((RACFGSource inv f op block point) (= dest (Successor op edge))
       (= inputSlot (SuccessorArg op edge slot)) (= value (Operand op inputSlot))
       (BlockParam dest slot joined))
      ((RAIncoming inv f op dest slot joined value)) :ruleset ra-control-import)
(rule ((RACFGSource inv f op block point) (= (OpKind op) "func.return"))
      ((RAReturn inv f op block) (RAExit inv f block)) :ruleset ra-control-import)
(rule ((RAReturn inv f op block) (RACFGSource inv f op block point)
       (= value (Operand op slot)))
      ((RAReturnValue inv f op slot value)) :ruleset ra-control-import)
(rule ((RAFunction inv f region) (RegionParam region slot value)
       (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((set (RAControlTokens inv f) (set-of value))) :ruleset ra-control-import)
(rule ((RASource inv f op kind) (Result op slot value)
       (= (ValueType value) (Apply (Ctor "son.control") (TNil))))
      ((set (RAControlTokens inv f) (set-of value))) :ruleset ra-control-import)
;; A control-free graph executes its demanded operations in one implicit block.
(rule ((RAFunction inv f region) (= (Mode region) (Graph))
       (= (RAStructuredFlag inv f) false)
       (= (set-length (RAControlTokens inv f)) 0))
      ((set (RAImplicitControl inv f) (fresh-ir-id))
       (set (RAReturnNode inv f) (fresh-ir-id))) :ruleset ra-control-normalize)
(rule ((= block (RAImplicitControl inv f)))
      ((RABlock inv f block) (RAEntry inv f block) (RAExit inv f block)) :ruleset ra-control-normalize)
(rule ((= block (RAImplicitControl inv f)) (= op (RAReturnNode inv f)))
      ((RAReturn inv f op block) (RANode inv f op "func.return")
       (RAPin inv f op block)) :ruleset ra-control-normalize)
(rule ((= block (RAImplicitControl inv f)) (RAFunction inv f region)
       (= op (RAReturnNode inv f)) (= value (Yield region slot)))
      ((RAReturnValue inv f op slot value) (RAUse inv f op slot value)) :ruleset ra-control-normalize)
(rule ((RASource inv f merge "son.merge") (Result merge 0 control))
      ((RABlock inv f control)
       (set (RAIncomingControls inv f merge) (set-empty))
       (set (RARecognizedOps inv f) (set-of merge))) :ruleset ra-control-import)
(rule ((RASource inv f merge "son.merge") (= incoming (Operand merge slot)))
      ((set (RAIncomingControls inv f merge) (set-of incoming))) :ruleset ra-control-import)
(rule ((RASource inv f branch "son.branch") (= control (Operand branch 0))
       (= predicate (Operand branch 1)) (Result branch 0 taken) (Result branch 1 fallthrough))
      ((RABlock inv f control) (RABlock inv f taken) (RABlock inv f fallthrough)
       (RAControlEdge inv f control taken) (RAControlEdge inv f control fallthrough)
       (RABranch inv f branch control predicate taken fallthrough)
       (RANode inv f branch "son.branch") (RAPin inv f branch control)
       (RAUse inv f branch 1 predicate)
       (set (RARecognizedOps inv f) (set-of branch))) :ruleset ra-control-import)

;; A source edge already is the predecessor terminator. Its result names the
;; arrival, while the merge result names the destination block.
(rule ((RASource inv f edge "son.edge") (= control (Operand edge 0))
       (Result edge 0 arrival) (RASource inv f merge "son.merge")
       (= arrival (Operand merge edgeSlot)) (Result merge 0 dest))
      ((RABlock inv f control) (RAControlEdge inv f control dest)
       (RAJump inv f edge control dest) (RANode inv f edge "son.edge")
       (RAPin inv f edge control) (set (RARecognizedOps inv f) (set-of edge)))
      :ruleset ra-control-import)

;; Control-only merges also admit bare branch projections and region controls.
;; Those transitions have no source edge operation, so keep a pending jump ID.
(rule ((RASource inv f merge "son.merge") (Result merge 0 dest)
       (= incoming (Operand merge slot))
       (= (ValueDefinition incoming) (ResultDef producer resultSlot))
       (= kind (OpKind producer)) (!= kind "son.edge"))
      ((set (RADirectJump inv f merge slot) (fresh-ir-id))) :ruleset ra-control-import)
(rule ((RASource inv f merge "son.merge") (= incoming (Operand merge slot))
       (= (ValueDefinition incoming) (RegionParamDef region paramSlot)))
      ((set (RADirectJump inv f merge slot) (fresh-ir-id))) :ruleset ra-control-import)
(rule ((= jump (RADirectJump inv f merge slot)) (Result merge 0 dest)
       (= incoming (Operand merge slot)))
      ((RABlock inv f incoming) (RAControlEdge inv f incoming dest)
       (RAJump inv f jump incoming dest) (RANode inv f jump "cfg.br")
       (RAPin inv f jump incoming)) :ruleset ra-control-import)

;; An edge may feed a branch, another edge, or the function exit directly.
;; Such an edge result needs its own block rather than a merge binding.
(rule ((RASource inv f consumer kind) (!= kind "son.merge")
       (= control (Operand consumer slot))
       (= (ValueType control) (Apply (Ctor "son.control") (TNil)))
       (= (ValueDefinition control) (ResultDef edge 0))
       (RASource inv f edge "son.edge") (= from (Operand edge 0)))
      ((RABlock inv f control) (RABlock inv f from)
       (RAControlEdge inv f from control) (RAJump inv f edge from control)
       (RANode inv f edge "son.edge") (RAPin inv f edge from)
       (set (RARecognizedOps inv f) (set-of edge))) :ruleset ra-control-import)
(rule ((RAFunction inv f region) (= control (Yield region controlSlot))
       (= (ValueType control) (Apply (Ctor "son.control") (TNil))))
      ((RABlock inv f control) (RAExit inv f control)
       (RAControlYield inv f controlSlot control)
       (set (RAReturnNode inv f) (fresh-ir-id))) :ruleset ra-control-import)
(rule ((RAExit inv f control) (= (ValueDefinition control) (ResultDef edge 0))
       (RASource inv f edge "son.edge") (= from (Operand edge 0)))
      ((RABlock inv f from) (RAControlEdge inv f from control)
       (RAJump inv f edge from control) (RANode inv f edge "son.edge")
       (RAPin inv f edge from) (set (RARecognizedOps inv f) (set-of edge)))
      :ruleset ra-control-import)
(rule ((= op (RAReturnNode inv f)) (RAExit inv f control))
      ((RAReturn inv f op control) (RANode inv f op "func.return")
       (RAPin inv f op control)) :ruleset ra-control-import)
(rule ((RAFunction inv f region) (= op (RAReturnNode inv f))
       (RAControlYield inv f controlSlot control) (= value (Yield region slot))
       (< slot controlSlot))
      ((RAReturnValue inv f op slot value) (RAUse inv f op slot value))
      :ruleset ra-control-import)
(rule ((RAFunction inv f region) (= op (RAReturnNode inv f))
       (RAControlYield inv f controlSlot control) (= value (Yield region slot))
       (> slot controlSlot))
      ((RAReturnValue inv f op (- slot 1) value) (RAUse inv f op (- slot 1) value))
      :ruleset ra-control-import)
(rule ((RAFunction inv f region) (RegionParam region slot value)
       (= ty (ValueType value)) (!= ty (Apply (Ctor "son.control") (TNil))))
      ((RAArgument inv f slot value)) :ruleset ra-control-import)
(rule ((RAFunction inv f region) (RegionParam region slot control)
       (= (ValueType control) (Apply (Ctor "son.control") (TNil))))
      ((RABlock inv f control) (RAEntry inv f control)) :ruleset ra-control-import)

(function RAContinuationJump (i64 i64 i64) i64 :no-merge)
;; A native control result is the continuation after the instruction executes.
(rule ((RASource inv f op kind) (!= kind "son.merge")
       (!= kind "son.branch") (!= kind "son.edge")
       (= input (Operand op inputSlot))
       (= (ValueType input) (Apply (Ctor "son.control") (TNil)))
       (Result op resultSlot output)
       (= (ValueType output) (Apply (Ctor "son.control") (TNil))))
      ((set (RAContinuationJump inv f op) (fresh-ir-id))
       (RABlock inv f output) (RAControlEdge inv f input output))
      :ruleset ra-control-import)
(rule ((= jump (RAContinuationJump inv f op)) (RAPin inv f op input)
       (Result op resultSlot output)
       (= (ValueType output) (Apply (Ctor "son.control") (TNil))))
      ((RAJump inv f jump input output) (RANode inv f jump "cfg.br")
       (RAPin inv f jump input)) :ruleset ra-control-import)

;; All explicit control operands pin their operation. State dependencies remain
;; ordinary typed uses and definitions, including joined state values.
(rule ((RASource inv f op kind) (!= kind "son.merge")
       (!= kind "son.branch") (!= kind "son.edge")
       (= control (Operand op slot))
       (= (ValueType control) (Apply (Ctor "son.control") (TNil))))
      ((RABlock inv f control) (RAPin inv f op control) (RANode inv f op kind)
       (set (RARecognizedOps inv f) (set-of op))) :ruleset ra-control-import)
(rule ((RASource inv f op kind) (TMDLPureKind inv kind))
      ((RAMovable inv f op) (set (RAPureOps inv f) (set-of op))
       (set (RARecognizedOps inv f) (set-of op))) :ruleset ra-control-import)
(rule ((RAPin inv f op block))
      ((set (RAExplicitlyPinned inv f) (set-of op))) :ruleset ra-control-import)
(rule ((RASource inv f op kind) (!= kind "son.merge")
       (set-not-contains (RAStructuredOwnerSet inv f) op)
       (= value (Operand op slot)) (= ty (ValueType value))
       (!= ty (Apply (Ctor "son.control") (TNil))))
      ((RAUse inv f op slot value)) :ruleset ra-control-import)
(rule ((RASource inv f op kind) (!= kind "son.merge")
       (set-not-contains (RAStructuredOwnerSet inv f) op)
       (Result op slot value) (= ty (ValueType value))
       (!= ty (Apply (Ctor "son.control") (TNil))))
      ((RADef inv f op value)) :ruleset ra-control-import)
(rule ((RASource inv f merge "son.merge") (Result merge 0 control)
       (= 0 (set-length (RAIncomingControls inv f merge))))
      ((RAEntry inv f control)) :ruleset ra-control-entry)

(relation RAReach (i64 i64 i64 i64))
(relation RAAvoid (i64 i64 i64 i64))
(relation RADom (i64 i64 i64 i64))
(function RAAvoided (i64 i64 i64) RAIds :merge (set-union old new))
(rule ((RABlock inv f block))
      ((RAReach inv f block block) (set (RAAvoided inv f block) (set-empty)))
      :ruleset ra-control-reach)
(rule ((RAControlEdge inv f from dest)) ((RAReach inv f from dest)) :ruleset ra-control-reach)
(rule ((RAReach inv f from middle) (RAControlEdge inv f middle dest))
      ((RAReach inv f from dest)) :ruleset ra-control-reach)
(rule ((RABlock inv f avoided) (RAEntry inv f entry) (!= avoided entry))
      ((RAAvoid inv f avoided entry)) :ruleset ra-control-reach)
(rule ((RAAvoid inv f avoided from) (RAControlEdge inv f from dest) (!= avoided dest))
      ((RAAvoid inv f avoided dest)) :ruleset ra-control-reach)
(rule ((RAAvoid inv f avoided block))
      ((set (RAAvoided inv f avoided) (set-of block))) :ruleset ra-control-reach)
(rule ((RABlock inv f dom) (RABlock inv f block) (RAEntry inv f entry)
       (RAReach inv f entry block) (set-not-contains (RAAvoided inv f dom) block))
      ((RADom inv f dom block)) :ruleset ra-control-dom)

;; Demand walks back through actual data/state definitions but stops at merge
;; results. The incoming edge owns the use of the preceding iteration's value.
(relation RADemand (i64 i64 i64 i64))
(relation RARequired (i64 i64 i64 i64))
(relation RAValueHome (i64 i64 i64 i64))
(function RALiveOps (i64 i64) RAIds :merge (set-union old new))
(rule ((RAFunction inv f region)) ((set (RALiveOps inv f) (set-empty))) :ruleset ra-control-demand)
(rule ((RAPin inv f op block)) ((RADemand inv f op block)) :ruleset ra-control-demand)
(rule ((RADemand inv f user block) (RAUse inv f user slot value) (RADef inv f op value))
      ((RADemand inv f op block)) :ruleset ra-control-demand)
(rule ((RADemand inv f op block) (RASource inv f op kind)
       (!= kind "son.merge") (!= kind "son.branch") (!= kind "son.edge"))
      ((RANode inv f op kind)) :ruleset ra-control-demand)
(relation RAAllPathsDemand (i64 i64 i64 i64))
(function RAMandatoryBad (i64 i64 i64) RAIds :merge (set-union old new))
(function RAMandatoryEarlier (i64 i64 i64) RAIds :merge (set-union old new))
(relation RAMandatoryPlacement (i64 i64 i64 i64))
;; Least fixed point proves a demand is reached on every path, including both
;; branch arms. A loop that can avoid the demand never acquires this fact.
(rule ((RADemand inv f op block))
      ((RAAllPathsDemand inv f op block)) :ruleset ra-control-mandatory)
(rule ((RAJump inv f jump block dest) (RAAllPathsDemand inv f op dest))
      ((RAAllPathsDemand inv f op block)) :ruleset ra-control-mandatory)
(rule ((RABranch inv f branch block predicate taken fallthrough)
       (RAAllPathsDemand inv f op taken) (RAAllPathsDemand inv f op fallthrough))
      ((RAAllPathsDemand inv f op block)) :ruleset ra-control-mandatory)
(rule ((RANode inv f op kind))
      ((set (RAMandatoryBad inv f op) (set-empty))
       (set (RAMandatoryEarlier inv f op) (set-empty))) :ruleset ra-control-mandatory-bad)
(rule ((RADemand inv f op demand) (RABlock inv f block) (RAAvoid inv f block demand))
      ((set (RAMandatoryBad inv f op) (set-of block))) :ruleset ra-control-mandatory-bad)
(rule ((RAAllPathsDemand inv f op block)
       (set-not-contains (RAMandatoryBad inv f op) block)
       (RAEntry inv f entry) (RAReach inv f entry block))
      ((RAMandatoryPlacement inv f op block)) :ruleset ra-control-mandatory-legal)
(rule ((RAMandatoryPlacement inv f op earlier) (RAMandatoryPlacement inv f op later)
       (!= earlier later) (RADom inv f earlier later))
      ((set (RAMandatoryEarlier inv f op) (set-of earlier))) :ruleset ra-control-mandatory-extrema)
(rule ((RAMandatoryPlacement inv f op block) (RASource inv f op kind)
       (set-not-contains (RAPureOps inv f) op)
       (set-not-contains (RAExplicitlyPinned inv f) op)
       (set-not-contains (RAMandatoryEarlier inv f op) block))
      ((RAPin inv f op block) (set (RARecognizedOps inv f) (set-of op)))
      :ruleset ra-control-pin)
(rule ((RANode inv f op kind)) ((set (RALiveOps inv f) (set-of op))) :ruleset ra-control-demand)
(rule ((RABinding inv f block slot value)) ((RAValueHome inv f value block)) :ruleset ra-control-demand)
(rule ((RAArgument inv f slot value) (RAEntry inv f entry))
      ((RAValueHome inv f value entry)) :ruleset ra-control-demand)
(rule ((RADef inv f op value) (RAPin inv f op block))
      ((RAValueHome inv f value block)) :ruleset ra-control-demand)
(rule ((RAUse inv f op slot value) (RAValueHome inv f value block))
      ((RARequired inv f op block)) :ruleset ra-control-demand)
(rule ((RAUse inv f user slot value) (RADef inv f producer value)
       (RARequired inv f producer block))
      ((RARequired inv f user block)) :ruleset ra-control-demand)

;; Legal placements dominate every demand and follow every operand binding.
;; This availability bound keeps loop-carried data inside its loop header.
(function RABadPlacement (i64 i64 i64) RAIds :merge (set-union old new))
(function RAEarlierPlacement (i64 i64 i64) RAIds :merge (set-union old new))
(function RALaterPlacement (i64 i64 i64) RAIds :merge (set-union old new))
(relation RALegalPlacement (i64 i64 i64 i64))
(relation RAPlace (i64 i64 i64 i64 i64))
(rule ((RANode inv f op kind))
      ((set (RABadPlacement inv f op) (set-empty))
       (set (RAEarlierPlacement inv f op) (set-empty))
       (set (RALaterPlacement inv f op) (set-empty))) :ruleset ra-control-bad)
(rule ((RANode inv f op kind) (RABlock inv f block) (RADemand inv f op demand)
       (RAAvoid inv f block demand))
      ((set (RABadPlacement inv f op) (set-of block))) :ruleset ra-control-bad)
(rule ((RANode inv f op kind) (RABlock inv f block) (RARequired inv f op required)
       (RAAvoid inv f required block))
      ((set (RABadPlacement inv f op) (set-of block))) :ruleset ra-control-bad)
(rule ((RANode inv f op kind) (RAMovable inv f op) (RABlock inv f block)
       (set-not-contains (RAExplicitlyPinned inv f) op)
       (RAEntry inv f entry) (RAReach inv f entry block)
       (set-not-contains (RABadPlacement inv f op) block))
      ((RALegalPlacement inv f op block)) :ruleset ra-control-legal)
(rule ((RALegalPlacement inv f op earlier) (RALegalPlacement inv f op later)
       (RADom inv f earlier later) (!= earlier later))
      ((set (RAEarlierPlacement inv f op) (set-of later))
       (set (RALaterPlacement inv f op) (set-of earlier))) :ruleset ra-control-extrema)
(rule ((RALegalPlacement inv f op block)
       (set-not-contains (RAEarlierPlacement inv f op) block))
      ((RAPlace inv f 0 op block)) :ruleset ra-control-place)
(rule ((RALegalPlacement inv f op block)
       (set-not-contains (RALaterPlacement inv f op) block))
      ((RAPlace inv f 1 op block)) :ruleset ra-control-place)
(rule ((RAPin inv f op block))
      ((RAPlace inv f 0 op block) (RAPlace inv f 1 op block)) :ruleset ra-control-place)

;; Each immutable prefix freezes blockers and pressure deltas before choosing
;; one ready operation. Candidate zero keeps source ID order; candidate one
;; minimizes new hardware definitions minus last uses, then source ID.
(datatype RASchedule (RAS i64 i64 i64 i64 RASequence RAIds))
(relation RAScheduleState (RASchedule))
(relation RAPred (i64 i64 i64 i64 i64))
(function RABlockOps (i64 i64 i64 i64) RAIds :merge (set-union old new))
(function RABlocked (RASchedule) RAIds :merge (set-union old new))
(function RAReadyMin (RASchedule) i64 :merge (min old new))
(relation RAScheduleHardware (i64))
(function RAScheduleDefs (i64 i64 i64) RAIds :merge (set-union old new))
(function RAScheduleUsers (i64 i64 i64 i64) RAIds :merge (set-union old new))
(function RAScheduleKills (RASchedule i64) RAIds :merge (set-union old new))
(function RAReadyPressure (RASchedule) i64 :merge (min old new))
(relation RAAt (i64 i64 i64 i64 i64 i64))
(relation RABlockScheduled (i64 i64 i64 i64))
(relation RAEnumerate (RASchedule i64))
(rule ((= (ValueType value) (Apply (Ctor name) args))
       (!= name "son.control") (!= name "builtin.state"))
      ((RAScheduleHardware value)) :ruleset ra-control-pred)
(rule ((RAPlace inv f candidate op block))
      ((set (RAScheduleDefs inv f op) (set-empty))) :ruleset ra-control-pred)
(rule ((RAPlace inv f candidate op block) (RADef inv f op value)
       (RAScheduleHardware value))
      ((set (RAScheduleDefs inv f op) (set-of value))) :ruleset ra-control-pred)
;; A user in another block remains outside this prefix and prevents a kill.
(rule ((RAPlace inv f candidate op block) (RAUse inv f op slot value)
       (RAScheduleHardware value))
      ((set (RAScheduleUsers inv f candidate value) (set-of op))) :ruleset ra-control-pred)
(rule ((RABlock inv f block))
      ((set (RABlockOps inv f 0 block) (set-empty))
       (set (RABlockOps inv f 1 block) (set-empty))) :ruleset ra-control-pred)
(rule ((RAPlace inv f candidate op block))
      ((set (RABlockOps inv f candidate block) (set-of op))) :ruleset ra-control-pred)
(rule ((RAPlace inv f candidate user block) (RAPlace inv f candidate producer block)
       (RAUse inv f user slot value) (RADef inv f producer value))
      ((RAPred inv f candidate user producer)) :ruleset ra-control-pred)
(rule ((RAPlace inv f candidate term block) (RAPlace inv f candidate op block)
       (RATerminator inv f term block) (!= term op))
      ((RAPred inv f candidate term op)) :ruleset ra-control-pred)
(rule ((RACFGSource inv f later block laterPoint) (RACFGSource inv f earlier block earlierPoint)
       (> laterPoint earlierPoint) (RAPin inv f later block) (RAPin inv f earlier block)
       (RAPlace inv f candidate later block) (RAPlace inv f candidate earlier block))
      ((RAPred inv f candidate later earlier)) :ruleset ra-control-pred)
(rule ((RABlock inv f block))
      ((RAScheduleState (RAS inv f 0 block (vec-empty) (set-empty)))
       (RAScheduleState (RAS inv f 1 block (vec-empty) (set-empty)))) :ruleset ra-control-seed)
(rule ((RAScheduleState state))
      ((set (RABlocked state) (set-empty))) :ruleset ra-control-blocked)
(rule ((RAScheduleState state) (= state (RAS inv f candidate block sequence seen))
       (RAPlace inv f candidate op block) (RAPred inv f candidate op pred)
       (set-not-contains seen pred))
      ((set (RABlocked state) (set-of op))) :ruleset ra-control-blocked)
(rule ((RAScheduleState state) (= state (RAS inv f 1 block sequence seen))
       (RAPlace inv f 1 op block) (set-not-contains seen op))
      ((set (RAScheduleKills state op) (set-empty))) :ruleset ra-control-blocked)
(rule ((RAScheduleState state) (= state (RAS inv f 1 block sequence seen))
       (RAPlace inv f 1 op block) (set-not-contains seen op)
       (RAUse inv f op slot value) (RAScheduleHardware value)
       (= (set-diff (RAScheduleUsers inv f 1 value) seen) (set-of op)))
      ((set (RAScheduleKills state op) (set-of value))) :ruleset ra-control-blocked)
(rule ((RAScheduleState state) (= state (RAS inv f 1 block sequence seen))
       (RAPlace inv f 1 op block) (set-not-contains seen op)
       (set-not-contains (RABlocked state) op))
      ((set (RAReadyPressure state)
            (- (set-length (RAScheduleDefs inv f op))
               (set-length (RAScheduleKills state op))))) :ruleset ra-control-priority)
(rule ((RAScheduleState state) (= state (RAS inv f 0 block sequence seen))
       (RAPlace inv f 0 op block) (set-not-contains seen op)
       (set-not-contains (RABlocked state) op))
      ((set (RAReadyMin state) op)) :ruleset ra-control-ready)
(rule ((RAScheduleState state) (= state (RAS inv f 1 block sequence seen))
       (RAPlace inv f 1 op block) (set-not-contains seen op)
       (set-not-contains (RABlocked state) op)
       (= (RAReadyPressure state)
          (- (set-length (RAScheduleDefs inv f op))
             (set-length (RAScheduleKills state op)))))
      ((set (RAReadyMin state) op)) :ruleset ra-control-ready)
(rule ((RAScheduleState state) (= state (RAS inv f candidate block sequence seen))
       (= op (RAReadyMin state)))
      ((RAScheduleState (RAS inv f candidate block (vec-push sequence op) (set-insert seen op))))
      :ruleset ra-control-step)
(rule ((RAScheduleState state) (= state (RAS inv f candidate block sequence seen))
       (= seen (RABlockOps inv f candidate block)))
      ((RABlockScheduled inv f candidate block) (RAEnumerate state 0)) :ruleset ra-control-finish)
(rule ((RAEnumerate state index) (= state (RAS inv f candidate block sequence seen))
       (< index (vec-length sequence)) (= op (vec-get sequence index)))
      ((RAAt inv f candidate block op index) (RAEnumerate state (+ index 1)))
      :ruleset ra-control-finish)

;; These completeness facts are publication gates, not substitutes for the
;; parent's allocation and descriptor validation.
(function RAPlacedOps (i64 i64 i64) RAIds :merge (set-union old new))
(function RAScheduledOps (i64 i64 i64) RAIds :merge (set-union old new))
(function RABlocks (i64 i64) RAIds :merge (set-union old new))
(function RAScheduledBlocks (i64 i64 i64) RAIds :merge (set-union old new))
(function RAControlErrors (i64 i64) RAIds :merge (set-union old new))
(function RAEntries (i64 i64) RAIds :merge (set-union old new))
(function RAReachableBlocks (i64 i64) RAIds :merge (set-union old new))
(function RATerminators (i64 i64 i64) RAIds :merge (set-union old new))
(relation RAControlComplete (i64 i64 i64))
(relation RAControlError (i64 i64 String i64))
(rule ((RAFunction inv f region))
      ((set (RAPlacedOps inv f 0) (set-empty)) (set (RAPlacedOps inv f 1) (set-empty))
       (set (RAScheduledOps inv f 0) (set-empty)) (set (RAScheduledOps inv f 1) (set-empty))
       (set (RABlocks inv f) (set-empty))
       (set (RAControlErrors inv f) (set-empty))
       (set (RAEntries inv f) (set-empty))
       (set (RAReachableBlocks inv f) (set-empty))
       (set (RAScheduledBlocks inv f 0) (set-empty))
       (set (RAScheduledBlocks inv f 1) (set-empty))) :ruleset ra-control-finish)
(rule ((RABlock inv f block))
      ((set (RABlocks inv f) (set-of block))
       (set (RATerminators inv f block) (set-empty))) :ruleset ra-control-finish)
(rule ((RAEntry inv f block)) ((set (RAEntries inv f) (set-of block))) :ruleset ra-control-finish)
(rule ((RAEntry inv f entry) (RAReach inv f entry block))
      ((set (RAReachableBlocks inv f) (set-of block))) :ruleset ra-control-finish)
(rule ((RAJump inv f op block dest))
      ((RATerminator inv f op block)) :ruleset ra-control-import)
(rule ((RABranch inv f op block predicate taken fallthrough))
      ((RATerminator inv f op block)) :ruleset ra-control-import)
(rule ((RAReturn inv f op block))
      ((RATerminator inv f op block)) :ruleset ra-control-normalize)
(rule ((RATerminator inv f op block))
      ((set (RATerminators inv f block) (set-of op))) :ruleset ra-control-finish)
(rule ((RAPlace inv f candidate op block))
      ((set (RAPlacedOps inv f candidate) (set-of op))) :ruleset ra-control-finish)
(rule ((RAAt inv f candidate block op index))
      ((set (RAScheduledOps inv f candidate) (set-of op))) :ruleset ra-control-finish)
(rule ((RABlockScheduled inv f candidate block))
      ((set (RAScheduledBlocks inv f candidate) (set-of block))) :ruleset ra-control-finish)
(rule ((RAFunction inv f region) (= (set-length (RAControlErrors inv f)) 0)
       (= (set-length (RAEntries inv f)) 1)
       (= (RASourceOps inv f) (RARecognizedOps inv f))
       (= (RALiveOps inv f) (RAPlacedOps inv f 0))
       (= (RALiveOps inv f) (RAScheduledOps inv f 0))
       (= (RABlocks inv f) (RAScheduledBlocks inv f 0)))
      ((RAControlComplete inv f 0)) :ruleset ra-control-complete)
(rule ((RAFunction inv f region) (= (set-length (RAControlErrors inv f)) 0)
       (= (set-length (RAEntries inv f)) 1)
       (= (RASourceOps inv f) (RARecognizedOps inv f))
       (= (RALiveOps inv f) (RAPlacedOps inv f 1))
       (= (RALiveOps inv f) (RAScheduledOps inv f 1))
       (= (RABlocks inv f) (RAScheduledBlocks inv f 1)))
      ((RAControlComplete inv f 1)) :ruleset ra-control-complete)
(rule ((RAEntry inv f first) (RAEntry inv f second) (!= first second))
      ((RAControlError inv f "multiple entries" f)) :ruleset ra-control-check)
(rule ((RAPlace inv f candidate op first) (RAPlace inv f candidate op second) (!= first second))
      ((RAControlError inv f "ambiguous placement" op)) :ruleset ra-control-check)
(rule ((RAPin inv f op block) (RARequired inv f op required)
       (RAAvoid inv f required block))
      ((RAControlError inv f "operand binding does not dominate pinned use" op))
      :ruleset ra-control-check)
(rule ((RAPlace inv f candidate user userBlock) (RAPlace inv f candidate producer producerBlock)
       (RAUse inv f user slot value) (RADef inv f producer value)
       (RAAvoid inv f producerBlock userBlock))
      ((RAControlError inv f "definition does not dominate use" user)) :ruleset ra-control-check)

(rule ((RAControlError inv f message entity))
      ((set (RAControlErrors inv f) (set-of entity))) :ruleset ra-control-check)
(rule ((RASource inv f op kind) (set-not-contains (RARecognizedOps inv f) op))
      ((RAControlError inv f "operation has no safe execution placement" op)) :ruleset ra-control-check)
(rule ((RABlock inv f block) (set-not-contains (RAReachableBlocks inv f) block))
      ((RAControlError inv f "unreachable control block" block)) :ruleset ra-control-check)
(rule ((RABlock inv f block) (!= (set-length (RATerminators inv f block)) 1))
      ((RAControlError inv f "control block requires one terminator" block)) :ruleset ra-control-check)
(rule ((RANode inv f op kind) (set-not-contains (RAScheduledOps inv f 0) op))
      ((RAControlError inv f "earliest candidate contains an unscheduled operation" op)) :ruleset ra-control-check)
(rule ((RANode inv f op kind) (set-not-contains (RAScheduledOps inv f 1) op))
      ((RAControlError inv f "latest candidate contains an unscheduled operation" op)) :ruleset ra-control-check)

(rule ((RARequest inv root) (Within root f) (Function f))
      ((RARequestedFunction inv f) (set (RAAlreadyAllocated inv f) false)) :ruleset ra-control-functions)
(rule ((RARequest inv root) (Within root f) (Function f)
       (= region (OwnedRegion f 0))
       (= (Mode region) (CFG)) (= (Attribute f "assignment") (ListAttr assignments)))
      ((RAAllocatedFunction inv f) (set (RAAlreadyAllocated inv f) true)) :ruleset ra-control-functions)
