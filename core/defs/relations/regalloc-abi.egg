;; Install after regalloc-bindings. Saturate ra-abi-index, then ra-abi-bind
;; after ra-bind-domain and before ra-bind-check. Source slots and target ABI
;; sequences remain frozen. Each boundary has independent kind counters.
(ruleset ra-abi-index)
(ruleset ra-abi-bind)
(sort RAAbiCounters (Map String i64))
(sort RAAbiKinds (Set String))
(relation RAAbiValue (i64 i64 i64 String i64 i64))
(relation RAAbiKind (i64 i64 i64 String))
(relation RAAbiSkip (i64 i64 i64))
(relation RAAbiCursor (i64 i64 i64 String i64 RAAbiCounters))
(relation RAAbiTry (i64 i64 i64 String i64 i64 String RAAbiCounters))
(relation RAAbiBound (i64 i64 i64 String i64 i64 String i64))
(relation RAAbiSpan (i64 String String i64 String i64 i64 i64))
(relation RAAbiFit (i64 String String String i64 i64 i64))
(function RAAbiChoice (i64 String String String i64) i64 :merge (min old new))
(function RAAbiFittingStarts (i64 String String String) RAIds :merge (set-union old new))
(function RAAbiClassKinds (i64 String) RAAbiKinds :merge (set-union old new))
(function RAAbiExactKinds (i64 String) RAAbiKinds :merge (set-union old new))
(function RAAbiFallbackWidth (i64 i64 i64) i64 :no-merge)
(function RAAbiFallbackOrder (i64 i64 i64) i64 :merge (min old new))
(relation RAAbiFallbackClass (i64 i64 i64 String))
(function RAAbiLength (i64 String String) i64 :merge (max old new))

(rule ((RAArgument inv f slot value))
      ((RAAbiValue inv f f "arg" slot value)) :ruleset ra-abi-index)
(rule ((RAReturnValue inv f op slot value))
      ((RAAbiValue inv f op "ret" slot value)) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value))
      ((RAAbiCursor inv f boundary direction 0
          (map-insert (map-insert (map-insert (map-empty) "int" 0) "float" 0) "vector" 0)))
      :ruleset ra-abi-index)
(rule ((TMDLAbiOverflow inv direction kind overflow))
      ((set (RAAbiLength inv direction kind) 0)) :ruleset ra-abi-index)
(rule ((TMDLAbiPin inv direction kind slot class index))
      ((set (RAAbiLength inv direction kind) (+ slot 1))) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "builtin.f") args)))
      ((RAAbiKind inv f value "float")) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "vector.v") args)))
      ((RAAbiKind inv f value "vector")) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor name) args))
       (!= name "builtin.f") (!= name "vector.v")
       (!= name "builtin.state") (!= name "son.control") (!= name "backend.reg"))
      ((RAAbiKind inv f value "int")) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "builtin.state") args)))
      ((RAAbiSkip inv f value)) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "son.control") args)))
      ((RAAbiSkip inv f value)) :ruleset ra-abi-index)

(rule ((RAAbiCursor inv f boundary direction slot counters)
       (RAAbiValue inv f boundary direction slot value) (RAAbiSkip inv f value))
      ((RAAbiCursor inv f boundary direction (+ slot 1) counters)) :ruleset ra-abi-bind)
(rule ((RAAbiCursor inv f boundary direction slot counters)
       (RAAbiValue inv f boundary direction slot value) (RAAbiKind inv f value kind))
      ((RAAbiTry inv f boundary direction slot value kind counters)) :ruleset ra-abi-bind)
(rule ((RAAbiTry inv f boundary direction slot value kind counters)
       (RAValueClass inv f value class)
       (= ordinal (RAAbiChoice inv direction kind class (map-get counters kind)))
       (RAAbiFit inv direction kind class ordinal index consumed))
      ((RAAbiBound inv f boundary direction slot value class index)
       (RAAbiCursor inv f boundary direction (+ slot 1)
           (map-insert counters kind (+ ordinal consumed)))) :ruleset ra-abi-bind)
(rule ((RAAbiTry inv f boundary direction slot value kind counters)
       (RAValueClass inv f value class)
       (set-not-contains (RAAbiFittingStarts inv direction kind class) (map-get counters kind))
       (TMDLAbiOverflow inv direction kind next) (!= next "stack"))
      ((RAAbiTry inv f boundary direction slot value next counters)) :ruleset ra-abi-bind)
(rule ((RAAbiTry inv f boundary direction slot value kind counters)
       (RAValueClass inv f value class)
       (set-not-contains (RAAbiFittingStarts inv direction kind class) (map-get counters kind))
       (TMDLAbiOverflow inv direction kind "stack"))
      ((RABindingError inv f value "ABI boundary requires stack passing")) :ruleset ra-abi-bind)
(rule ((RAAbiBound inv f boundary "arg" slot value class index))
      ((RAForcedRegister inv f value class index)) :ruleset ra-abi-bind)
(rule ((RAAbiBound inv f op "ret" slot value class index))
      ((RAInputPin inv f op slot value class index)) :ruleset ra-abi-bind)

(function RAAbiKnownKinds (i64 String) RAAbiKinds :merge (set-union old new))
(rule ((RAFunction inv f region))
      ((set (RAAbiKnownKinds inv "arg") (set-empty))
       (set (RAAbiKnownKinds inv "ret") (set-empty))) :ruleset ra-abi-index)
(rule ((TMDLAbiOverflow inv direction kind overflow))
      ((set (RAAbiKnownKinds inv direction) (set-of kind))) :ruleset ra-abi-index)
(rule ((RAAbiTry inv f boundary direction slot value kind counters)
       (set-not-contains (RAAbiKnownKinds inv direction) kind))
      ((RABindingError inv f value "ABI has no sequence for boundary value kind")) :ruleset ra-abi-bind)

;; ABI slots name a physical file. The value retains its native register view.
(rule ((TMDLAbiPin inv direction kind ordinal class index)
       (TMDLClass inv class file width offset merge))
      ((RAAbiSpan inv direction kind ordinal file index 1 width)) :ruleset ra-abi-index)
(rule ((RAAbiSpan inv direction kind ordinal file index consumed span)
       (TMDLAbiPin inv direction kind (+ ordinal consumed) class (+ index span))
       (TMDLClass inv class file width offset merge))
      ((RAAbiSpan inv direction kind ordinal file index (+ consumed 1) (+ span width)))
      :ruleset ra-abi-index)
(rule ((RAAbiSpan inv direction kind ordinal file index consumed span)
       (TMDLAbiPin inv direction kind ordinal abi index)
       (TMDLClass inv abi file abiWidth offset abiMerge)
       (TMDLClass inv class file span offset merge) (TMDLRegister inv class index))
      ((RAAbiFit inv direction kind class ordinal index consumed)) :ruleset ra-abi-index)
(rule ((TMDLAbiOverflow inv direction kind overflow) (TMDLClass inv class file width offset merge))
      ((set (RAAbiFittingStarts inv direction kind class) (set-empty))) :ruleset ra-abi-index)
(rule ((TMDLAbiPin inv direction kind start abi startIndex)
       (RAAbiFit inv direction kind class ordinal index consumed) (>= ordinal start))
      ((set (RAAbiChoice inv direction kind class start) ordinal)
       (set (RAAbiFittingStarts inv direction kind class) (set-of start))) :ruleset ra-abi-index)

;; A backend.reg type loses the logical scalar/vector distinction. Use only
;; unambiguous sequence metadata, never register-class spelling heuristics.
(rule ((TMDLClass inv class file width offset merge))
      ((set (RAAbiClassKinds inv class) (set-empty))
       (set (RAAbiExactKinds inv class) (set-empty))) :ruleset ra-abi-index)
(rule ((TMDLAbiPin inv "arg" kind 0 abi index)
       (TMDLClass inv abi file abiWidth abiOffset abiMerge)
       (TMDLClass inv class file width offset merge))
      ((set (RAAbiClassKinds inv class) (set-of kind))) :ruleset ra-abi-index)
(rule ((TMDLAbiPin inv "arg" kind 0 class index))
      ((set (RAAbiExactKinds inv class) (set-of kind))) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "backend.reg")
           (TCons (SymbolParam dialect) (TCons (SymbolParam name) (TNil)))))
       (= class (SymbolName name)) (TMDLAbiOverflow inv direction kind overflow)
       (= (set-length (RAAbiExactKinds inv class)) 1)
       (set-contains (RAAbiExactKinds inv class) kind))
      ((RAAbiKind inv f value kind)) :ruleset ra-abi-bind)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "backend.reg")
           (TCons (SymbolParam dialect) (TCons (SymbolParam name) (TNil)))))
       (= class (SymbolName name)) (TMDLAbiOverflow inv direction kind overflow)
       (= (set-length (RAAbiExactKinds inv class)) 0)
       (= (set-length (RAAbiClassKinds inv class)) 1)
       (set-contains (RAAbiClassKinds inv class) kind))
      ((RAAbiKind inv f value kind)) :ruleset ra-abi-bind)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "backend.reg")
           (TCons (SymbolParam dialect) (TCons (SymbolParam name) (TNil)))))
       (= class (SymbolName name))
       (> (set-length (RAAbiExactKinds inv class)) 1))
      ((RABindingError inv f value "ABI register class has ambiguous value kind")) :ruleset ra-abi-bind)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "backend.reg")
           (TCons (SymbolParam dialect) (TCons (SymbolParam name) (TNil)))))
       (= class (SymbolName name)) (= (set-length (RAAbiExactKinds inv class)) 0)
       (!= (set-length (RAAbiClassKinds inv class)) 1))
      ((RABindingError inv f value "ABI register file has no unique value kind")) :ruleset ra-abi-bind)

;; Unused parameters still consume ABI slots, and passthrough values need a
;; domain even when no native instruction imposes one.
(rule ((RAAbiValue inv f boundary direction slot value) (RAAbiKind inv f value "int")
       (TMDLAbiPin inv "arg" "int" 0 class index) (TMDLRegisterWidth inv class bits))
      ((set (RAAbiFallbackWidth inv f value) bits)) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "builtin.f") (TCons (NatLit bits) (TNil)))))
      ((set (RAAbiFallbackWidth inv f value) (nat-i64 bits))) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (= (ValueType value) (Apply (Ctor "vector.v")
           (TCons (NatLit lanes) (TCons (Apply (Ctor element) (TCons (NatLit bits) (TNil))) (TNil))))))
      ((set (RAAbiFallbackWidth inv f value) (nat-i64 (* lanes bits)))) :ruleset ra-abi-index)
(rule ((RAAbiValue inv f boundary direction slot value)
       (set-not-contains (RARequiredValues inv f) value) (RAAbiKind inv f value kind)
       (TMDLAbiPin inv "arg" kind 0 abi index) (TMDLClass inv abi file abiWidth offset abiMerge)
       (= bits (RAAbiFallbackWidth inv f value))
       (TMDLClass inv class file width offset merge) (TMDLRegisterWidth inv class bits)
       (TMDLClassOrder inv class order))
      ((RAAbiFallbackClass inv f value class)
       (set (RAAbiFallbackOrder inv f value) order)) :ruleset ra-abi-index)
(rule ((RAAbiFallbackClass inv f value class) (TMDLClassOrder inv class order)
       (= (RAAbiFallbackOrder inv f value) order) (TMDLRegisterWidth inv class bits))
      ((RAValueClass inv f value class) (set (RAValueBits inv f value) bits)
       (set (RANativeClassifiedValues inv f) (set-of value))) :ruleset ra-abi-bind)

(rule ((RAAbiValue inv f boundary direction slot value)
       (set-not-contains (RARequiredValues inv f) value)
       (= (ValueType value) (Apply (Ctor "backend.reg")
           (TCons (SymbolParam dialect) (TCons (SymbolParam name) (TNil)))))
       (= class (SymbolName name)) (TMDLClassDialect inv class target)
       (TMDLRegisterWidth inv class bits))
      ((RAValueClass inv f value class) (set (RAValueBits inv f value) bits)
       (set (RANativeClassifiedValues inv f) (set-of value))) :ruleset ra-abi-bind)
