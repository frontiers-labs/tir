;; Repair the selected canonical CFG and restart allocation after a transaction.
;; Retain RATransferNative, RAGeneratedTemporary, RAAllocationPin,
;; RAAllocationOrder, RAFrameSlot, RAFrameEntryState, RAFrameJoinedState,
;; RAFrameMemory, RAFrameSaveInstalled and RAFrameInstalled across retries.
(ruleset ra-transfer-index)
(ruleset ra-transfer-persist)
(ruleset ra-transfer-recipe-index)
(ruleset ra-transfer-recipe)
(ruleset ra-transfer-choose)
(ruleset ra-transfer-emit)
(ruleset ra-transfer-check)
(ruleset ra-transfer-ready)
(ruleset ra-transfer-delete)
(ruleset ra-transfer-install)
(ruleset ra-transfer-verify-index)
(ruleset ra-transfer-verify)
(ruleset ra-transfer-verify-check)
(ruleset ra-transfer-verify-complete)
(ruleset ra-transfer-plan)
(ruleset ra-transfer-frame-index)
(ruleset ra-transfer-split-index)
(ruleset ra-transfer-split)
(ruleset ra-transfer-layout)
(ruleset ra-transfer-memory-index)
(ruleset ra-transfer-memory-order)
(ruleset ra-transfer-memory)
(ruleset ra-transfer-memory-finish)
(ruleset ra-transfer-save-plan)
(ruleset ra-transfer-adjust-index)
(ruleset ra-transfer-adjust-plan)
(ruleset ra-transfer-adjust)
(ruleset ra-transfer-frame-complete)
(ruleset ra-transfer-edge-index)
(ruleset ra-transfer-edge-moves)
(ruleset ra-transfer-edge-cycle)
(ruleset ra-transfer-edge-plan)
(ruleset ra-transfer-edge-blocked)
(ruleset ra-transfer-edge-ready)
(ruleset ra-transfer-edge-step)
(ruleset ra-transfer-cycle-layout)
(ruleset ra-transfer-cycle-store)
(ruleset ra-transfer-address-index)
(ruleset ra-transfer-address-plan)
(ruleset ra-transfer-address-step)
(ruleset ra-transfer-address-finish)
(datatype RATransferOperand
  (RATransferValue i64) (RATransferPhysical String i64) (RATransferAbsent))
(datatype RATransferRecipe (RATR String i64))
(datatype RATransferCopyIds (RATCopy i64 i64))
(datatype RACFGPosition (RACFGPos i64 i64 i64 i64 i64))
(datatype RAFrameSlotInfo (RAFS i64 i64 i64))
(datatype RAFrameSaveIds (RAFSaved i64 i64 i64 i64))
(datatype RAFrameAdjustState (RAFAS i64 i64 i64 i64 i64 i64 i64 i64))
(datatype RAEdgeCopyState (RAECS i64 i64 i64 i64 RAIds i64))
(datatype RAAddressState (RAAS i64 i64 i64 i64 String RATransferOperand i64 i64 i64))
(sort RATransferRecipes (Set RATransferRecipe))
(relation RASignedIntegerType (TypeExpr))
(relation RATransferRequest (i64 i64 i64 String i64 RATransferOperand RATransferOperand RATransferOperand i64 i64 i64 i64))
(relation RATransferRole (i64 i64 i64 String RATransferOperand))
(relation RATransferCompatible (i64 String String))
(function RATransferExcludedIndices (i64 String i64 String) RAIds :merge (set-union old new))
(relation RATransferCandidate (i64 i64 i64 String i64))
(function RATransferCandidates (i64 i64 i64) RATransferRecipes :merge (set-union old new))
(function RATransferRecipeFields (i64 String i64) RANativeNames :merge (set-union old new))
(function RATransferMatchedFields (i64 i64 i64 String i64) RANativeNames :merge (set-union old new))
(relation RATransferOffset (i64 i64 i64 String i64 i64))
(relation RATransferChosen (i64 i64 i64 String i64))
(relation RATransferField (i64 i64 i64 String i64 String i64))
(relation RATransferFieldValue (i64 i64 i64 String i64 i64))
(relation RATransferScan (i64 i64 i64 String i64 i64))
(function RATransferSegments (i64 i64 i64 String i64) AttrList :no-merge)
(relation RATransferEmitOperand (i64 i64 i64 i64 i64))
(relation RATransferEmitDefinition (i64 i64 i64 Definition TypeExpr))
(relation RATransferEmitAttribute (i64 i64 i64 String Attr))
(relation RATransferEraseOperand (i64 i64 i64 i64))
(relation RATransferEraseDefinition (i64 i64 i64 Definition))
(relation RATransferEraseAttribute (i64 i64 i64 String))
