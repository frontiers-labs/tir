       (< targetIndex (+ sourceIndex sourceWidth)) (< sourceIndex (+ targetIndex targetWidth)))
      ((RAEdgeDependency inv f edge joined other) (RAEdgeMoveReach inv f edge joined other)) :ruleset ra-transfer-edge-cycle)
(rule ((RAEdgeMoveReach inv f edge first middle) (RAEdgeDependency inv f edge middle last))
      ((RAEdgeMoveReach inv f edge first last)) :ruleset ra-transfer-edge-cycle)
(rule ((RAEdgeMoveReach inv f edge joined joined))
      ((set (RAEdgeCyclicValues inv f) (set-of edge)) (set (RAEdgeCycleValue inv f edge) joined)) :ruleset ra-transfer-edge-cycle)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate) (= (set-length (RAEdgePending inv f)) 0))
      ((RAEdgeCopiesComplete inv f candidate)) :ruleset ra-transfer-edge-plan)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate)
       (= moves (RAEdgeMovingValues inv f edge)) (> (set-length moves) 0)
       (set-not-contains (RAEdgeCyclicValues inv f) edge) (= (set-length (RACFGSuccessors inv f edge)) 1))
      ((RAEdgeCopyStateRow (RAECS inv f candidate edge moves 0)) (RATransferTransaction inv f candidate)) :ruleset ra-transfer-edge-plan)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate)
       (= edge (set-get (RAEdgeCyclicValues inv f) 0)) (= (set-length (RACFGSuccessors inv f edge)) 1))
      ((set (RAEdgeCycleRemaining inv f edge) (set-empty))) :ruleset ra-transfer-edge-plan)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate)
       (= edge (set-get (RAEdgeCyclicValues inv f) 0)) (= saved (RAEdgeCycleValue inv f edge))
       (RAEdgeMove inv f candidate edge savedSlot saved incoming savedClass savedIndex)
       (RAEdgeMove inv f candidate edge slot joined other class index) (!= incoming other))
      ((set (RAEdgeCycleRemaining inv f edge) (set-of joined))) :ruleset ra-transfer-edge-plan)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate)
       (= edge (set-get (RAEdgeCyclicValues inv f) 0)) (= remaining (RAEdgeCycleRemaining inv f edge)))
      ((RAEdgeCopyStateRow (RAECS inv f candidate edge remaining 0))
       (RATransferTransaction inv f candidate)) :ruleset ra-transfer-edge-blocked)
(rule ((RAEdgeCopyStateRow state) (= state (RAECS inv f candidate edge remaining ordinal)))
      ((set (RAEdgeBlockedMoves state) (set-empty))) :ruleset ra-transfer-edge-blocked)
(rule ((RAEdgeCopyStateRow state) (= state (RAECS inv f candidate edge remaining ordinal))
       (RAEdgeDependency inv f edge joined other) (set-contains remaining joined) (set-contains remaining other))
      ((set (RAEdgeBlockedMoves state) (set-of joined))) :ruleset ra-transfer-edge-blocked)
(rule ((RAEdgeCopyStateRow state) (= state (RAECS inv f candidate edge remaining ordinal))
       (RAEdgeMove inv f candidate edge slot joined incoming class index)
       (set-contains remaining joined) (set-not-contains (RAEdgeBlockedMoves state) joined))
      ((set (RAEdgeNextMove state) joined)) :ruleset ra-transfer-edge-ready)
(rule ((RAEdgeCopyStateRow state) (= joined (RAEdgeNextMove state)))
      ((set (RAFreshId (RAFreshEdge state) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshEdge state) 1) (fresh-ir-id))) :ruleset ra-transfer-edge-step)
(rule ((RAEdgeCopyStateRow state) (= joined (RAEdgeNextMove state))
       (= fresh0 (RAFreshId (RAFreshEdge state) 0)) (= fresh1 (RAFreshId (RAFreshEdge state) 1)))
      ((set (RAEdgeStepIds state) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-edge-step)
(rule ((RAEdgeCopyStateRow state) (= state (RAECS inv f candidate edge remaining ordinal))
       (= joined (RAEdgeNextMove state)) (RAEdgeMove inv f candidate edge slot joined incoming class index)
       (= (RATCopy copy temp) (RAEdgeStepIds state)) (= ty (ValueType incoming)) (= width (RAValueBits inv f incoming))
       (RAAt inv f candidate block edge point) (= dest (Successor edge 0)) (= operand (SuccessorArg edge 0 slot)))
      ((set (ValueType temp) ty) (RAValueClass inv f temp class) (RAGeneratedTemporary f temp) (RANoSpill inv f temp)
       (RATransferRequest inv f copy "copy" width (RATransferValue incoming) (RATransferValue temp) (RATransferAbsent) 0 -1 -1 -1)
       (RATransferRequestedPin inv f copy "destination" class index) (RATransferNewPin inv f temp class index)
       (RATransferNewPin inv f joined class index)
       (RATransferEraseOperand inv f edge operand) (RATransferReplaceOperand inv f edge operand temp)
       (RATransferPlacement inv f copy block (RACFGPos point -1 0 ordinal 0))
       (RATransferOrder inv f copy edge)
       (RAEdgeCopyStateRow (RAECS inv f candidate edge (set-remove remaining joined) (+ ordinal 1)))) :ruleset ra-transfer-edge-step)
(rule ((RAAllocationOrder f before edge)
       (RAEdgeCopyStateRow state) (= state (RAECS inv f candidate edge remaining ordinal))
       (= (RATCopy copy temp) (RAEdgeStepIds state)))
      ((RATransferOrder inv f before copy)) :ruleset ra-transfer-edge-step)
(rule ((RAEdgeCopyStateRow first) (= first (RAECS inv f candidate edge remaining ordinal))
       (= (RATCopy before unused) (RAEdgeStepIds first))
       (RAEdgeCopyStateRow second) (= second (RAECS inv f candidate edge rest (+ ordinal 1)))
       (= (RATCopy after temp) (RAEdgeStepIds second)))
      ((RATransferOrder inv f before after)) :ruleset ra-transfer-edge-step)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate)
       (= edge (set-get (RAEdgeCyclicValues inv f) 0)) (= (set-length (RACFGSuccessors inv f edge)) 1))
      ((set (RAFreshId (RAFreshNumbers "RAEdgeCycleCopy" "" (vec-of inv f edge)) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshNumbers "RAEdgeCycleCopy" "" (vec-of inv f edge)) 1) (fresh-ir-id))) :ruleset ra-transfer-cycle-layout)
(rule ((RASelectedCandidate inv f candidate) (RAColorComplete inv f candidate)
       (= edge (set-get (RAEdgeCyclicValues inv f) 0)) (= (set-length (RACFGSuccessors inv f edge)) 1)
       (= fresh0 (RAFreshId (RAFreshNumbers "RAEdgeCycleCopy" "" (vec-of inv f edge)) 0))
       (= fresh1 (RAFreshId (RAFreshNumbers "RAEdgeCycleCopy" "" (vec-of inv f edge)) 1)))
      ((set (RAEdgeCycleCopy inv f edge) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-cycle-layout)
(rule ((= (RATCopy copy temp) (RAEdgeCycleCopy inv f edge))
       (= joined (RAEdgeCycleValue inv f edge))
       (RAEdgeMove inv f candidate edge slot joined incoming class index)
       (= width (RAValueBits inv f incoming)) (= ty (ValueType incoming))
       (RAValueClass inv f incoming sourceClass) (RAAt inv f candidate block edge point))
      ((RATransferTransaction inv f candidate) (set (ValueType temp) ty) (RAValueClass inv f temp sourceClass)
       (RATransferRequest inv f copy "copy" width (RATransferValue incoming) (RATransferValue temp) (RATransferAbsent) 0 -1 -1 -1)
       (RATransferPlacement inv f copy block (RACFGPos point -2 0 0 0))
       (RATransferOrder inv f copy edge)) :ruleset ra-transfer-cycle-store)
(rule ((= (RATCopy copy temp) (RAEdgeCycleCopy inv f edge))
       (= joined (RAEdgeCycleValue inv f edge))
       (RAEdgeMove inv f candidate edge slot joined incoming class index)
       (= incoming (Operand edge operand)))
      ((RATransferEraseOperand inv f edge operand) (RATransferReplaceOperand inv f edge operand temp)) :ruleset ra-transfer-cycle-store)
(rule ((= (RATCopy save saved) (RAEdgeCycleCopy inv f edge))
       (RAEdgeCopyStateRow state) (= state (RAECS inv f candidate edge remaining ordinal))
       (= (RATCopy copy temp) (RAEdgeStepIds state)))
      ((RATransferOrder inv f save copy)) :ruleset ra-transfer-cycle-store)
(rule ((RASelectedCandidate inv f candidate))
      ((set (RAAddressKnownWidths inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate)
       (= handle (TypeHandleOf (Apply (Ctor "builtin.i") (TCons (NatLit bits) (TNil)))))
       (= width (nat-i64 bits)))
      ((set (RAAddressKnownWidths inv f) (set-of width))) :ruleset ra-transfer-index)
(rule ((RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut))
      ((set (RAAddressRepairRecipes inv f op) (set-empty))) :ruleset ra-transfer-address-index)
(rule ((RATransferCandidate inv f op kind recipe) (TMDLRecipeZeroOffset inv kind recipe)
       (= (RATransferMatchedFields inv f op kind recipe) (RATransferRecipeFields inv kind recipe)))
      ((set (RAAddressRepairRecipes inv f op) (set-of (RATR kind recipe)))) :ruleset ra-transfer-address-index)
(rule ((RATransferCandidate inv f op kind recipe)
       (TMDLRecipeOffset inv kind recipe name bits signed align false)
       (= (RATransferMatchedFields inv f op kind recipe) (RATransferRecipeFields inv kind recipe)))
      ((set (RAAddressRepairRecipes inv f op) (set-of (RATR kind recipe)))) :ruleset ra-transfer-address-index)
(rule ((RATransferRequest inv f op "spill" width source destination base offset control stateIn stateOut)
       (= (set-length (RATransferCandidates inv f op)) 0) (!= offset 0)
       (= recipes (RAAddressRepairRecipes inv f op)) (> (set-length recipes) 0)
       (= (RATR kind recipe) (set-get recipes 0))
       (TMDLRecipe inv kind recipe transfer width address align features parameters)
       (TMDLRecipeRegister inv kind recipe name class input output "base"))
      ((RAAddressRepair inv f op address class) (RAAddressNeededType inv f address)
       (RAAddressStateRow (RAAS inv f op address class base offset 0 control))) :ruleset ra-transfer-address-plan)
(rule ((RATransferRequest inv f op "reload" width source destination base offset control stateIn stateOut)
       (= (set-length (RATransferCandidates inv f op)) 0) (!= offset 0)
       (= recipes (RAAddressRepairRecipes inv f op)) (> (set-length recipes) 0)
       (= (RATR kind recipe) (set-get recipes 0))
       (TMDLRecipe inv kind recipe transfer width address align features parameters)
       (TMDLRecipeRegister inv kind recipe name class input output "base"))
      ((RAAddressRepair inv f op address class) (RAAddressNeededType inv f address)
       (RAAddressStateRow (RAAS inv f op address class base offset 0 control))) :ruleset ra-transfer-address-plan)
(rule ((RAAddressNeededType inv f width) (set-not-contains (RAAddressKnownWidths inv f) width))
      ((set (RAFreshId (RAFreshNumbers "RAAddressTypeId" "" (vec-of inv f width)) 0) (fresh-ir-type-id))) :ruleset ra-transfer-address-plan)
(rule ((RAAddressNeededType inv f width) (set-not-contains (RAAddressKnownWidths inv f) width)
       (= fresh0 (RAFreshId (RAFreshNumbers "RAAddressTypeId" "" (vec-of inv f width)) 0)))
      ((set (RAAddressTypeId inv f width) fresh0)) :ruleset ra-transfer-address-plan)
(rule ((= id (RAAddressTypeId inv f width)))
      ((set (TypeHandle id) (Apply (Ctor "builtin.i") (TCons (NatLit (bigint width)) (TNil))))
       (set (TypeHandleOf (Apply (Ctor "builtin.i") (TCons (NatLit (bigint width)) (TNil)))) id)) :ruleset ra-transfer-address-plan)
(rule ((RAAddressStateRow state) (= state (RAAS inv f owner width class base remaining ordinal control)) (!= remaining 0))
      ((set (RAFreshId (RAFreshAddress state) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshAddress state) 1) (fresh-ir-id))) :ruleset ra-transfer-address-step)
(rule ((RAAddressStateRow state) (= state (RAAS inv f owner width class base remaining ordinal control)) (!= remaining 0)
       (= fresh0 (RAFreshId (RAFreshAddress state) 0)) (= fresh1 (RAFreshId (RAFreshAddress state) 1)))
      ((set (RAAddressIds state) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-address-step)
(rule ((RAAddressStateRow state) (= state (RAAS inv f owner width class base remaining ordinal control))
       (> remaining 0) (= limit (RAFrameAddressLimit inv 1)) (= amount (min remaining limit))
       (= (RATCopy op temp) (RAAddressIds state)))
      ((set (ValueType temp) (Apply (Ctor "builtin.i") (TCons (NatLit (bigint width)) (TNil))))
       (RAValueClass inv f temp class) (RAGeneratedTemporary f temp) (RANoSpill inv f temp)
       (RATransferRequest inv f op "address-add" width (RATransferAbsent) (RATransferValue temp) base amount control -1 -1)
       (RAAddressStateRow (RAAS inv f owner width class (RATransferValue temp) (- remaining amount) (+ ordinal 1) control))) :ruleset ra-transfer-address-step)
(rule ((RAAddressStateRow state) (= state (RAAS inv f owner width class base remaining ordinal control))
       (< remaining 0) (= limit (RAFrameAddressLimit inv -1)) (= amount (max remaining (- 0 limit)))
       (= (RATCopy op temp) (RAAddressIds state)))
      ((set (ValueType temp) (Apply (Ctor "builtin.i") (TCons (NatLit (bigint width)) (TNil))))
       (RAValueClass inv f temp class) (RAGeneratedTemporary f temp) (RANoSpill inv f temp)
       (RATransferRequest inv f op "address-add" width (RATransferAbsent) (RATransferValue temp) base amount control -1 -1)
       (RAAddressStateRow (RAAS inv f owner width class (RATransferValue temp) (- remaining amount) (+ ordinal 1) control))) :ruleset ra-transfer-address-step)
(rule ((RAAddressStateRow (RAAS inv f owner address class (RATransferValue temp) 0 ordinal control))
       (RATransferRequest inv f owner transfer width source destination base offset control stateIn stateOut) (!= offset 0))
      ((delete (RATransferRequest inv f owner transfer width source destination base offset control stateIn stateOut))
       (delete (RATransferRole inv f owner "base" base))
       (RATransferRequest inv f owner transfer width source destination (RATransferValue temp) 0 control stateIn stateOut)) :ruleset ra-transfer-address-finish)
(rule ((RASelectedCandidate inv f candidate))
      ((set (RATransferGeneratedOps inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe))
      ((set (RATransferGeneratedOps inv f) (set-of op))) :ruleset ra-transfer-index)
(rule ((RAFrameNeeded inv f candidate) (RANativePhysicalRead inv f op class index)
       (set-not-contains (RATransferGeneratedOps inv f) op)
       (set-not-contains (RAHardwiredIndices inv class) index)
       (TMDLAbiRegister inv "sp" spClass spIndex)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv spClass file spWidth spOffset spMerge)
       (< index (+ spIndex spWidth)) (< spIndex (+ index width)))
      ((RATransferError inv f op "source stack-pointer reads require frame-index lowering before allocating a frame"))
      :ruleset ra-transfer-check)
(rule ((RAFrameNeeded inv f candidate) (RANativePhysicalWrite inv f op class index)
       (set-not-contains (RATransferGeneratedOps inv f) op)
       (set-not-contains (RAHardwiredIndices inv class) index)
       (TMDLAbiRegister inv "sp" spClass spIndex)
       (TMDLClass inv class file width offset merge)
       (TMDLClass inv spClass file spWidth spOffset spMerge)
       (< index (+ spIndex spWidth)) (< spIndex (+ index width)))
      ((RATransferError inv f op "source stack-pointer writes require frame-index lowering before allocating a frame"))
      :ruleset ra-transfer-check)
(rule ((TMDLStackLayout inv align slot redZone true style)) ((RAFrameDirection inv -1)) :ruleset ra-transfer-adjust-index)
(rule ((TMDLStackLayout inv align slot redZone false style)) ((RAFrameDirection inv 1)) :ruleset ra-transfer-adjust-index)
(rule ((RAAddressStateRow state) (= state (RAAS inv f owner width class base remaining ordinal control))
       (> remaining 0) (= (RATCopy op temp) (RAAddressIds state))
       (RATransferPlacement inv f owner block (RACFGPos p lane group index sub)))
      ((RATransferPlacement inv f op block (RACFGPos p lane group index (- 0 remaining)))) :ruleset ra-transfer-address-step)
(rule ((RAAddressStateRow state) (= state (RAAS inv f owner width class base remaining ordinal control))
       (< remaining 0) (= (RATCopy op temp) (RAAddressIds state))
       (RATransferPlacement inv f owner block (RACFGPos p lane group index sub)))
      ((RATransferPlacement inv f op block (RACFGPos p lane group index remaining))) :ruleset ra-transfer-address-step)
(rule ((RATransferPlacement inv f first block (RACFGPos p lane group index a))
       (RATransferPlacement inv f second block (RACFGPos p lane group index b)) (< a b))
      ((RATransferBefore inv f first second)) :ruleset ra-transfer-layout)
(rule ((RASelectedCandidate inv f candidate) (= ids (RAFrameEntryState f block)))
      ((set (RAFrameKnownEntries inv f) (set-of block))) :ruleset ra-transfer-index)
(rule ((RAFrameActive inv f candidate) (RAEntry inv f block) (= (RATCopy entry state) (RAFrameEntryState f block)))
      ((RAFrameBlockInput inv f block state)) :ruleset ra-transfer-memory-index)
(rule ((RATransferSplitEdge inv f term edge dest) (= (RATCopy block jump) (RACFGSplitIds inv f term edge))
       (= (OpKind term) "cfg.cond_br") (= edge 0))
      ((RATransferEraseAttribute inv f term "true_dest")
       (RATransferEmitAttribute inv f term "true_dest" (BlockAttr block))) :ruleset ra-transfer-split)
(rule ((RATransferSplitEdge inv f term edge dest) (= (RATCopy block jump) (RACFGSplitIds inv f term edge))
       (= (OpKind term) "cfg.cond_br") (= edge 1))
      ((RATransferEraseAttribute inv f term "false_dest")
       (RATransferEmitAttribute inv f term "false_dest" (BlockAttr block))) :ruleset ra-transfer-split)
(rule ((RATransferReady inv f candidate) (RATransferOrder inv f before after))
      ((RAAllocationOrder f before after)) :ruleset ra-transfer-install)

(rule ((RAFrameSpillValue inv f value class size) (RASelectedCandidate inv f candidate))
      ((RAFrameNeeded inv f candidate)) :ruleset ra-transfer-plan)

(rule ((RASource inv f term "cfg.switch") (= dest (Successor term edge))
       (> (set-length (RACFGSplitEdges inv f term)) 0)
       (set-not-contains (RACFGSplitEdges inv f term) edge))
      ((RACFGSplitDestination inv f term edge dest)) :ruleset ra-transfer-split)
(rule ((RASource inv f term "cfg.switch") (RATransferSplitEdge inv f term edge dest)
       (= (RATCopy block jump) (RACFGSplitIds inv f term edge)))
      ((RACFGSplitDestination inv f term edge block)) :ruleset ra-transfer-split)
(rule ((RASource inv f term "cfg.switch") (> (set-length (RACFGSplitEdges inv f term)) 0)
       (= count (set-length (RACFGSuccessors inv f term))))
      ((set (RACFGSwitchDests inv f term count) (ANil))) :ruleset ra-transfer-split)
(rule ((RACFGSplitDestination inv f term edge dest) (= tail (RACFGSwitchDests inv f term (+ edge 1))))
      ((set (RACFGSwitchDests inv f term edge) (ACons (BlockAttr dest) tail))) :ruleset ra-transfer-split)
(rule ((= dests (RACFGSwitchDests inv f term 0)))
      ((RATransferEraseAttribute inv f term "dests")
       (RATransferEmitAttribute inv f term "dests" (ListAttr dests))) :ruleset ra-transfer-split)

(rule ((RAFrameActive inv f candidate) (RASource inv f term "cfg.switch")
       (= count (set-length (RACFGSuccessors inv f term))))
      ((set (RACFGSwitchCounts inv f term count) (ANil))) :ruleset ra-transfer-memory-finish)
(rule ((RAFrameActive inv f candidate) (RASource inv f term "cfg.switch")
       (= count (RACFGEdgeCount inv f term edge))
       (= tail (RACFGSwitchCounts inv f term (+ edge 1))) (RAIntegerType ty))
      ((set (RACFGSwitchCounts inv f term edge) (ACons (IntegerAttr ty 64 (i64-hex count)) tail)))
      :ruleset ra-transfer-memory-finish)
(rule ((RAFrameActive inv f candidate) (RASource inv f term "cfg.switch")
       (= counts (RACFGSwitchCounts inv f term 0)) (= edges (set-length (RACFGSuccessors inv f term)))
       (= end (RACFGEdgeStart inv f term edges)) (RAIntegerType ty))
      ((RATransferEraseAttribute inv f term "arg_counts")
       (RATransferEraseAttribute inv f term "operand_segment_sizes")
       (RATransferEmitAttribute inv f term "arg_counts" (ListAttr counts))
       (RATransferEmitAttribute inv f term "operand_segment_sizes"
        (ListAttr (ACons (IntegerAttr ty 64 (i64-hex 1))
                  (ACons (IntegerAttr ty 64 (i64-hex (- end 1))) (ANil))))))
      :ruleset ra-transfer-memory-finish)

(rule ((RASelectedCandidate inv f candidate))
      ((set (RATransferRebuiltBranches inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((RAFrameActive inv f candidate) (RASource inv f term kind) (= dest (Successor term edge)))
      ((set (RATransferRebuiltBranches inv f) (set-of term))) :ruleset ra-transfer-memory-index)
(rule ((RATransferReplaceOperand inv f op slot value)
       (set-not-contains (RATransferRebuiltBranches inv f) op))
      ((RATransferEmitOperand inv f op slot value)) :ruleset ra-transfer-emit)

(rule ((RASource inv f op kind) (RAAllocationPin f value class index)
       (= (ValueDefinition value) (ResultDef op slot)))
      ((RAOutputPin inv f op value class index)) :ruleset ra-bind-require)
