(function RATransferChanges (i64 i64) RAIds :merge (set-union old new))
(relation RATransferReady (i64 i64 i64))
(relation RATransferProgress (i64 i64 i64))
(relation RATransferError (i64 i64 i64 String))
(function RATransferErrors (i64 i64) RAIds :merge (set-union old new))
(function RATransferRequests (i64 i64) RAIds :merge (set-union old new))
(function RATransferConstructed (i64 i64) RAIds :merge (set-union old new))
(function RATransferSegmented (i64 i64 i64) RAIds :merge (set-union old new))
(relation RATransferNative (i64 i64 String i64))
(relation RAGeneratedTemporary (i64 i64))
(relation RATransferNumber (i64 i64 i64 i64 String i64))
(relation RATransferGuard (i64 i64 i64 i64 i64 bool))
(function RATransferFirstShape (i64 i64 i64 i64) i64 :merge (min old new))
(function RATransferVerifyOps (i64 i64 i64) RAIds :merge (set-union old new))
(function RATransferVerifiedOps (i64 i64 i64) RAIds :merge (set-union old new))
(function RATransferVerifyErrors (i64 i64 i64) RAIds :merge (set-union old new))
