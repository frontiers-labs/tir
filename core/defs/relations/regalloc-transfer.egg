(datatype RAFreshKey
  (RAFreshNumbers String String RASequence)
  (RAFreshAdjustment RAFrameAdjustState)
  (RAFreshEdge RAEdgeCopyState)
  (RAFreshAddress RAAddressState))
(function RAFreshId (RAFreshKey i64) i64 :merge (min old new))

(rule ((RASelectedCandidate inv f candidate))
      ((set (RATransferErrors inv f) (set-empty))
       (set (RATransferRequests inv f) (set-empty))
       (set (RATransferConstructed inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((RAFunction inv f region) (RAGeneratedTemporary f value))
      ((RANoSpill inv f value)) :ruleset ra-transfer-persist)
(rule ((TMDLClass inv first file group offset firstMerge)
       (TMDLClass inv second file group offset secondMerge))
      ((RATransferCompatible inv first second)) :ruleset ra-transfer-index)
(rule ((RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut))
      ((RATransferRole inv f op "source" source)
       (RATransferRole inv f op "destination" destination)
       (RATransferRole inv f op "base" base)
       (set (RATransferCandidates inv f op) (set-empty))
       (set (RATransferRequests inv f) (set-of op))
       (set (RATransferSegmented inv f op) (set-empty))) :ruleset ra-transfer-recipe-index)
(rule ((TMDLRecipe inv kind recipe transfer width address align features parameters))
      ((set (RATransferRecipeFields inv kind recipe) (set-empty))) :ruleset ra-transfer-recipe-index)
(rule ((TMDLRecipeRegister inv kind recipe name class input output role))
      ((set (RATransferRecipeFields inv kind recipe) (set-of name))) :ruleset ra-transfer-recipe-index)
(rule ((RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLRecipe inv kind recipe transfer width address align features parameters)
       (RARecipeProfileEligible inv kind recipe) (= (% offset align) 0))
      ((RATransferCandidate inv f op kind recipe)
       (set (RATransferMatchedFields inv f op kind recipe) (set-empty))) :ruleset ra-transfer-recipe-index)
(rule ((RATransferCandidate inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base 0 control stateIn stateOut)
       (TMDLRecipeZeroOffset inv kind recipe))
      ((RATransferOffset inv f op kind recipe 0)) :ruleset ra-transfer-recipe)
(rule ((RATransferCandidate inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLRecipeOffset inv kind recipe name bits true align nonzero) (< bits 64) (> bits 0)
       (TMDLRecipeOffsetFactor inv kind recipe factor) (= raw (* offset factor))
       (= (% raw align) 0) (= (>> (<< raw (- 64 bits)) (- 64 bits)) raw))
      ((RATransferOffset inv f op kind recipe raw)) :ruleset ra-transfer-recipe)
(rule ((RATransferCandidate inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLRecipeOffset inv kind recipe name 64 true align nonzero)
       (TMDLRecipeOffsetFactor inv kind recipe factor) (= raw (* offset factor)) (= (% raw align) 0))
      ((RATransferOffset inv f op kind recipe raw)) :ruleset ra-transfer-recipe)
(rule ((RATransferCandidate inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLRecipeOffset inv kind recipe name bits false align nonzero) (< bits 63) (> bits 0)
       (TMDLRecipeOffsetFactor inv kind recipe factor) (= raw (* offset factor))
       (= (% raw align) 0) (>= raw 0) (< raw (<< 1 bits)))
      ((RATransferOffset inv f op kind recipe raw)) :ruleset ra-transfer-recipe)
(rule ((RATransferOffset inv f op kind recipe raw)
       (TMDLRecipeOffset inv kind recipe name bits signed align true) (!= raw 0)
       (= (RATransferMatchedFields inv f op kind recipe) (RATransferRecipeFields inv kind recipe)))
      ((set (RATransferCandidates inv f op) (set-of (RATR kind recipe)))) :ruleset ra-transfer-recipe)
(rule ((RATransferOffset inv f op kind recipe raw)
       (TMDLRecipeOffset inv kind recipe name bits signed align false)
       (= (RATransferMatchedFields inv f op kind recipe) (RATransferRecipeFields inv kind recipe)))
      ((set (RATransferCandidates inv f op) (set-of (RATR kind recipe)))) :ruleset ra-transfer-recipe)
(rule ((RATransferOffset inv f op kind recipe 0) (TMDLRecipeZeroOffset inv kind recipe)
       (= (RATransferMatchedFields inv f op kind recipe) (RATransferRecipeFields inv kind recipe)))
      ((set (RATransferCandidates inv f op) (set-of (RATR kind recipe)))) :ruleset ra-transfer-recipe)
(rule ((= choices (RATransferCandidates inv f op)) (> (set-length choices) 0)
       (= (RATR kind recipe) (set-get choices 0)))
      ((RATransferChosen inv f op kind recipe)
       (RATransferScan inv f op "in" 0 0)
       (RATransferScan inv f op "out" 0 0)) :ruleset ra-transfer-choose)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLRecipeRegister inv kind recipe name class input output role) (>= input 0)
       (TMDLInstructionSlot inv kind "in" field name optional false false)
       (RATransferRole inv f op role (RATransferValue value)))
      ((RATransferField inv f op "in" field name 1)
       (RATransferFieldValue inv f op "in" field value)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLRecipeRegister inv kind recipe name class input output role) (>= input 0)
       (TMDLInstructionSlot inv kind "in" field name true false false)
       (RATransferRole inv f op role (RATransferPhysical actual index))
       (TMDLClassDialect inv class dialect))
      ((RATransferField inv f op "in" field name 0)
       (RATransferEmitAttribute inv f op name (PhysicalRegisterAttr dialect class index))) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLRecipeRegister inv kind recipe name class input output role) (>= output 0)
       (TMDLInstructionSlot inv kind "out" field name optional false false)
       (RATransferRole inv f op role (RATransferValue value)))
      ((RATransferField inv f op "out" field name 1)
       (RATransferFieldValue inv f op "out" field value)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLRecipeRegister inv kind recipe name class input output role) (>= output 0)
       (TMDLInstructionSlot inv kind "out" field name true false false)
       (RATransferRole inv f op role (RATransferPhysical actual index))
       (TMDLClassDialect inv class dialect))
      ((RATransferField inv f op "out" field name 0)
       (RATransferEmitAttribute inv f op name (PhysicalRegisterAttr dialect class index))) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLInstructionSlot inv kind "in" field name true false true) (>= control 0))
      ((RATransferField inv f op "in" field name 1)
       (RATransferFieldValue inv f op "in" field control)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset -1 stateIn stateOut)
       (TMDLInstructionSlot inv kind "in" field name true false true))
      ((RATransferField inv f op "in" field name 0)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLInstructionSlot inv kind "out" field name true false true))
      ((RATransferField inv f op "out" field name 0)) :ruleset ra-transfer-emit)
(rule ((RATransferScan inv f op direction field actual)
       (RATransferField inv f op direction field name size))
      ((RATransferScan inv f op direction (+ field 1) (+ actual size))) :ruleset ra-transfer-emit)
(rule ((RATransferScan inv f op "in" field actual)
       (RATransferFieldValue inv f op "in" field value))
      ((RATransferEmitOperand inv f op actual value)) :ruleset ra-transfer-emit)
(rule ((RATransferScan inv f op "out" field actual)
       (RATransferFieldValue inv f op "out" field value) (= ty (ValueType value)))
      ((RATransferEmitDefinition inv f value (ResultDef op actual) ty)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe) (TMDLInstructionSlotCount inv kind direction count))
      ((set (RATransferSegments inv f op direction count) (ANil))) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferField inv f op direction field name size) (RAIntegerType ty)
       (= tail (RATransferSegments inv f op direction (+ field 1))))
      ((set (RATransferSegments inv f op direction field)
        (ACons (IntegerAttr ty 64 (i64-hex size)) tail))) :ruleset ra-transfer-emit)
(rule ((= xs (RATransferSegments inv f op "in" 0)))
      ((RATransferEmitAttribute inv f op "operand_segment_sizes" (ListAttr xs))
       (set (RATransferSegmented inv f op) (set-of 0))) :ruleset ra-transfer-emit)
(rule ((= xs (RATransferSegments inv f op "out" 0)))
      ((RATransferEmitAttribute inv f op "result_segment_sizes" (ListAttr xs))
       (set (RATransferSegmented inv f op) (set-of 1))) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLRecipeAttribute inv kind recipe name "constant" value) (RASignedIntegerType ty))
      ((RATransferEmitAttribute inv f op name (IntegerAttr ty 64 (i64-hex value)))) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLRecipeAttribute inv kind recipe name "offset" ignored)
       (RATransferOffset inv f op kind recipe raw) (RASignedIntegerType ty))
      ((RATransferEmitAttribute inv f op name (IntegerAttr ty 64 (i64-hex raw)))) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (TMDLInstructionSlotCount inv kind "in" inputs) (RATransferScan inv f op "in" inputs actualInputs)
       (TMDLInstructionSlotCount inv kind "out" outputs) (RATransferScan inv f op "out" outputs actualOutputs)
       (= (set-length (RATransferSegmented inv f op)) 2))
      ((set (RATransferConstructed inv f) (set-of op))) :ruleset ra-transfer-emit)
(rule ((RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (= (set-length (RATransferCandidates inv f op)) 0))
      ((RATransferError inv f op "no profile/class/offset eligible proved transfer recipe")) :ruleset ra-transfer-check)
(rule ((RASelectedCandidate inv f candidate)
       (!= (RATransferConstructed inv f) (RATransferRequests inv f)))
      ((RATransferError inv f f "transfer construction is incomplete")) :ruleset ra-transfer-check)
(rule ((RATransferError inv f entity message))
      ((set (RATransferErrors inv f) (set-of entity))) :ruleset ra-transfer-check)
(rule ((RATransferTransaction inv f candidate) (> (set-length (RATransferChanges inv f)) 0)
       (= (set-length (RATransferErrors inv f)) 0)
       (= (RATransferConstructed inv f) (RATransferRequests inv f)))
      ((RATransferReady inv f candidate)) :ruleset ra-transfer-ready)
(rule ((RATransferReady inv f candidate) (RATransferEraseOperand inv f op slot))
      ((delete (Operand op slot))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferEraseDefinition inv f value def))
      ((delete (ValueDefinition value)) (delete (DefinedValue def))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferEraseDefinition inv f value (ResultDef op slot)))
      ((delete (Result op slot value))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferEraseAttribute inv f op name))
      ((delete (Attribute op name))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferChosen inv f op kind recipe)
       (RAFunction inv f region))
      ((set (OpKind op) kind)
       (set (KindBoundary kind) (OrdinaryBoundary))
       (RATransferNative f op kind recipe)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitOperand inv f op slot value))
      ((set (Operand op slot) value)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitDefinition inv f value def ty))
      ((set (ValueType value) ty) (set (ValueDefinition value) def)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitAttribute inv f op name attr))
      ((set (Attribute op name) attr)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate))
      ((RATransferProgress inv f candidate)) :ruleset ra-transfer-install)
(rule ((RASelectedCandidate inv f candidate))
      ((set (RATransferVerifyOps inv f candidate) (set-empty))
       (set (RATransferVerifiedOps inv f candidate) (set-empty))
       (set (RATransferVerifyErrors inv f candidate) (set-empty))) :ruleset ra-transfer-verify-index)
(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe))
      ((set (RATransferVerifyOps inv f candidate) (set-of op))) :ruleset ra-transfer-verify-index)
(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (= (Attribute op name) (IntegerAttr ty bits hex)) (= value (hex-i64 hex)))
      ((RATransferNumber inv f candidate op name value)) :ruleset ra-transfer-verify-index)
(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (= (Attribute op name) (PhysicalRegisterAttr dialect class index)))
      ((RATransferNumber inv f candidate op name index)) :ruleset ra-transfer-verify-index)
(rule ((RASelectedCandidate inv f candidate) (RATransferNative f op kind recipe)
       (RANativeSlot inv f op direction name slot value)
       (RAChosenRegister inv f candidate value class index))
      ((RATransferNumber inv f candidate op name index)) :ruleset ra-transfer-verify-index)
(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (TMDLRecipeExcluded inv kind recipe name excluded)
       (RATransferNumber inv f candidate op name excluded))
      ((RATransferVerifyError inv f candidate op "transfer writes a discarded register")) :ruleset ra-transfer-verify-check)
(rule ((RATransferNative f op kind recipe) (RASelectedCandidate inv f candidate)
       (set-not-contains (RATransferVerifiedOps inv f candidate) op))
      ((RATransferVerifyError inv f candidate op "allocated transfer has no legal native encoding")) :ruleset ra-transfer-verify-check)
(rule ((RATransferVerifyError inv f candidate op message))
      ((set (RATransferVerifyErrors inv f candidate) (set-of op))) :ruleset ra-transfer-verify-check)
(rule ((RASelectedCandidate inv f candidate)
       (= (RATransferVerifiedOps inv f candidate) (RATransferVerifyOps inv f candidate))
       (= (set-length (RATransferVerifyErrors inv f candidate)) 0))
      ((RATransfersVerified inv f candidate)) :ruleset ra-transfer-verify-complete)
(rule ((RASelectedCandidate inv f candidate))
      ((set (RATransferSpilledValues inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate) (RASpill inv f candidate value descriptor))
      ((set (RATransferSpilledValues inv f) (set-of value))) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate)
       (RARepairRequest inv f candidate op slot value "split fixed operand") (>= slot 0)
       (set-not-contains (RATransferSpilledValues inv f) value))
      ((RATransferCopyInputRequest inv f op slot value)) :ruleset ra-transfer-plan)
(rule ((RASelectedCandidate inv f candidate)
       (RARepairRequest inv f candidate op slot value "copy tied operand") (>= slot 0)
       (set-not-contains (RATransferSpilledValues inv f) value))
      ((RATransferCopyInputRequest inv f op slot value)) :ruleset ra-transfer-plan)
(rule ((RASelectedCandidate inv f candidate)
       (RARepairRequest inv f candidate op slot value "split live tied operand") (>= slot 0)
       (set-not-contains (RATransferSpilledValues inv f) value))
      ((RATransferCopyInputRequest inv f op slot value)) :ruleset ra-transfer-plan)
(rule ((RASelectedCandidate inv f candidate)
       (RARepairRequest inv f candidate op -1 value "split fixed result")
       (set-not-contains (RATransferSpilledValues inv f) value))
      ((RATransferCopyOutputRequest inv f op value)) :ruleset ra-transfer-plan)
(rule ((RATransferCopyInputRequest inv f op slot value))
      ((set (RAFreshId (RAFreshNumbers "RATransferInputCopy" "" (vec-of inv f op slot value)) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshNumbers "RATransferInputCopy" "" (vec-of inv f op slot value)) 1) (fresh-ir-id))) :ruleset ra-transfer-plan)
(rule ((RATransferCopyInputRequest inv f op slot value)
       (= fresh0 (RAFreshId (RAFreshNumbers "RATransferInputCopy" "" (vec-of inv f op slot value)) 0)) (= fresh1 (RAFreshId (RAFreshNumbers "RATransferInputCopy" "" (vec-of inv f op slot value)) 1)))
      ((set (RATransferInputCopy inv f op slot value) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-plan)
(rule ((RATransferCopyOutputRequest inv f op value))
      ((set (RAFreshId (RAFreshNumbers "RATransferOutputCopy" "" (vec-of inv f op value)) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshNumbers "RATransferOutputCopy" "" (vec-of inv f op value)) 1) (fresh-ir-id))) :ruleset ra-transfer-plan)
(rule ((RATransferCopyOutputRequest inv f op value)
       (= fresh0 (RAFreshId (RAFreshNumbers "RATransferOutputCopy" "" (vec-of inv f op value)) 0)) (= fresh1 (RAFreshId (RAFreshNumbers "RATransferOutputCopy" "" (vec-of inv f op value)) 1)))
      ((set (RATransferOutputCopy inv f op value) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-plan)
(rule ((= (RATCopy copy temp) (RATransferInputCopy inv f op slot value))
       (RASelectedCandidate inv f candidate) (RAValueClass inv f value class)
       (= width (RAValueBits inv f value)) (= ty (ValueType value)))
      ((RATransferTransaction inv f candidate)
       (set (ValueType temp) ty) (RAValueClass inv f temp class)
       (RAGeneratedTemporary f temp) (RANoSpill inv f temp)
       (RATransferRequest inv f copy "copy" width (RATransferValue value)
        (RATransferValue temp) (RATransferAbsent) 0 -1 -1 -1)) :ruleset ra-transfer-plan)
(rule ((= (RATCopy copy temp) (RATransferOutputCopy inv f op value))
       (RASelectedCandidate inv f candidate) (RAValueClass inv f value class)
       (= width (RAValueBits inv f value)) (= ty (ValueType value))
       (= def (ValueDefinition value)) (= def (ResultDef op slot)))
      ((RATransferTransaction inv f candidate)
       (set (ValueType temp) ty) (RAValueClass inv f temp class)
       (RAGeneratedTemporary f temp) (RANoSpill inv f temp)
       (RATransferRequest inv f copy "copy" width (RATransferValue temp)
        (RATransferValue value) (RATransferAbsent) 0 -1 -1 -1)
       (RATransferEraseDefinition inv f value def)
       (RATransferEmitDefinition inv f temp def ty)) :ruleset ra-transfer-plan)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLInstructionStateSlot inv kind "in" field) (>= stateIn 0))
      ((RATransferField inv f op "in" field "state" 1)
       (RATransferFieldValue inv f op "in" field stateIn)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLInstructionStateSlot inv kind "in" field) (= stateIn -1))
      ((RATransferField inv f op "in" field "state" 0)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLInstructionStateSlot inv kind "out" field) (>= stateOut 0))
      ((RATransferField inv f op "out" field "state" 1)
       (RATransferFieldValue inv f op "out" field stateOut)) :ruleset ra-transfer-emit)
(rule ((RATransferChosen inv f op kind recipe)
       (RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut)
       (TMDLInstructionStateSlot inv kind "out" field) (= stateOut -1))
      ((RATransferField inv f op "out" field "state" 0)) :ruleset ra-transfer-emit)
(rule ((TMDLRecipeRegister inv kind recipe name class input output role))
      ((set (RATransferExcludedIndices inv kind recipe name) (set-empty))) :ruleset ra-transfer-index)
(rule ((TMDLRecipeExcluded inv kind recipe name index))
      ((set (RATransferExcludedIndices inv kind recipe name) (set-of index))) :ruleset ra-transfer-index)
(rule ((RATransferCandidate inv f op kind recipe)
       (TMDLRecipeRegister inv kind recipe name required input output role)
       (RATransferRole inv f op role (RATransferValue value))
       (RAValueClass inv f value actual) (RATransferCompatible inv required actual))
      ((set (RATransferMatchedFields inv f op kind recipe) (set-of name))) :ruleset ra-transfer-recipe)
(rule ((RATransferCandidate inv f op kind recipe)
       (TMDLRecipeRegister inv kind recipe name required input output role)
       (RATransferRole inv f op role (RATransferPhysical actual index))
       (RATransferCompatible inv required actual) (TMDLRegister inv required index)
       (set-not-contains (RATransferExcludedIndices inv kind recipe name) index))
      ((set (RATransferMatchedFields inv f op kind recipe) (set-of name))) :ruleset ra-transfer-recipe)
(rule ((RASelectedCandidate inv f candidate)
       (RARepairRequest inv f candidate op slot value reason)
       (RAInputPin inv f op slot value class index))
      ((set (RATransferCopyTargetRank inv f op slot) 0)) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate)
       (RARepairRequest inv f candidate op slot value reason)
       (RATiedOperands inv f op slot result))
      ((set (RATransferCopyTargetRank inv f op slot) 1)) :ruleset ra-transfer-index)
(rule ((RATransferCopyInputRequest inv f op slot value)
       (= (RATransferCopyTargetRank inv f op slot) 0)
       (RAInputPin inv f op slot value class index))
      ((RATransferCopyTarget inv f op slot class index)) :ruleset ra-transfer-plan)
(rule ((RATransferCopyInputRequest inv f op slot value)
       (= (RATransferCopyTargetRank inv f op slot) 1)
       (RATiedOperands inv f op slot result) (RASelectedCandidate inv f candidate)
       (RAChosenRegister inv f candidate result class index))
      ((RATransferCopyTarget inv f op slot class index)) :ruleset ra-transfer-plan)
(rule ((RATransferCopyTarget inv f op slot class index)
       (= (RATCopy copy temp) (RATransferInputCopy inv f op slot value)))
      ((RATransferRequestedPin inv f copy "destination" class index)
       (RATransferNewPin inv f temp class index)) :ruleset ra-transfer-plan)
(rule ((RATransferCopyTarget inv f op slot class index)
       (RATiedOperands inv f op slot result))
      ((RATransferNewPin inv f result class index)) :ruleset ra-transfer-plan)
(rule ((TMDLAbiRegister inv "callee-saved" class index)
       (TMDLClass inv class file width offset merge)
       (TMDLAbiRegister inv "sp" spClass spIndex)
       (TMDLClass inv spClass spFile spWidth spOffset spMerge) (!= file spFile))
      ((RAFrameNonStackCallee inv class index)) :ruleset ra-transfer-frame-index)
(rule ((TMDLAbiRegister inv "ra" class index))
      ((RAFrameNonStackCallee inv class index)) :ruleset ra-transfer-frame-index)
(rule ((RASelectedCandidate inv f candidate) (RAChosenRegister inv f candidate value actual index)
       (RAFrameNonStackCallee inv saved savedIndex)
       (TMDLClass inv actual file actualWidth actualOffset actualMerge)
       (TMDLClass inv saved file savedWidth savedOffset savedMerge)
       (< index (+ savedIndex savedWidth)) (< savedIndex (+ index actualWidth)))
      ((RAFrameCalleeRegister inv f saved savedIndex)) :ruleset ra-transfer-frame-index)
(rule ((TMDLAbiRegister inv "callee-saved" class index)
       (TMDLClass inv class file width offset merge)
       (TMDLAbiRegister inv "sp" spClass spIndex)
       (TMDLClass inv spClass file spWidth spOffset spMerge) (<= (+ index width) spIndex))
      ((RAFrameNonStackCallee inv class index)) :ruleset ra-transfer-frame-index)
(rule ((TMDLAbiRegister inv "callee-saved" class index)
       (TMDLClass inv class file width offset merge)
       (TMDLAbiRegister inv "sp" spClass spIndex)
       (TMDLClass inv spClass file spWidth spOffset spMerge) (>= index (+ spIndex spWidth)))
      ((RAFrameNonStackCallee inv class index)) :ruleset ra-transfer-frame-index)
(rule ((RASelectedCandidate inv f candidate) (RAResourceWrite inv f op actual index)
       (RAFrameNonStackCallee inv saved savedIndex)
       (TMDLClass inv actual file actualWidth actualOffset actualMerge)
       (TMDLClass inv saved file savedWidth savedOffset savedMerge)
       (< index (+ savedIndex savedWidth)) (< savedIndex (+ index actualWidth)))
      ((RAFrameCalleeRegister inv f saved savedIndex)) :ruleset ra-transfer-frame-index)
(rule ((RAFunction inv f region) (RAAllocationPin f value class index))
      ((RAForcedRegister inv f value class index)) :ruleset ra-transfer-persist)
(rule ((RAAllocationOrder f before after) (RAPlace inv f candidate before block)
       (RAPlace inv f candidate after block))
      ((RAPred inv f candidate after before)) :ruleset ra-control-pred)
;; Edge-transfer saves must not execute before the edge is taken.
(rule ((RAAllocationOrder f op edge) (RATransferNative f op kind recipe)
       (RAJump inv f edge block dest))
      ((RAPin inv f op block)) :ruleset ra-control-import)
(rule ((RASelectedCandidate inv f candidate))
      ((set (RATransferChanges inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate) (RAAt inv f candidate block op point))
      ((RATransferPlacement inv f op block (RACFGPos point 0 0 0 0))) :ruleset ra-transfer-index)
(rule ((RABlock inv f block))
      ((set (RACFGParamCount inv f block) 0)) :ruleset ra-transfer-index)
(rule ((RABlock inv f block) (BlockParam block slot value))
      ((set (RACFGParamCount inv f block) (+ slot 1))) :ruleset ra-transfer-index)
(rule ((RASource inv f op kind))
      ((set (RACFGSuccessors inv f op) (set-empty))
       (set (RACFGSplitEdges inv f op) (set-empty))) :ruleset ra-transfer-index)
(rule ((RASource inv f op kind) (= dest (Successor op edge)))
      ((set (RACFGSuccessors inv f op) (set-of edge))) :ruleset ra-transfer-index)
(rule ((= (RATCopy copy temp) (RATransferInputCopy inv f op slot value))
       (RASelectedCandidate inv f candidate) (RAAt inv f candidate block op point))
      ((RATransferPlacement inv f copy block (RACFGPos point -1 copy 0 0))
       (RATransferEraseOperand inv f op slot) (RATransferReplaceOperand inv f op slot temp)) :ruleset ra-transfer-plan)
(rule ((= (RATCopy copy temp) (RATransferOutputCopy inv f op value))
       (RASelectedCandidate inv f candidate) (RAAt inv f candidate block op point))
      ((RATransferPlacement inv f copy block (RACFGPos point 1 copy 0 0))) :ruleset ra-transfer-plan)
(rule ((RATransferChosen inv f op kind recipe) (RATransferRequestedPin inv f op role pinned index)
       (TMDLRecipeRegister inv kind recipe name class input output role) (TMDLClassDialect inv class dialect))
      ((RATransferEmitAttribute inv f op name (PhysicalRegisterAttr dialect class index))) :ruleset ra-transfer-emit)
(rule ((RATransferReady inv f candidate) (RATransferNewPin inv f value class index))
      ((RAAllocationPin f value class index)) :ruleset ra-transfer-install)
(rule ((RASelectedCandidate inv f candidate) (RAIncoming inv f term dest slot joined incoming)
       (RAChosenRegister inv f candidate joined target targetIndex)
       (RAChosenRegister inv f candidate incoming source sourceIndex)
       (> (set-length (RACFGSuccessors inv f term)) 1) (= dest (Successor term edge))
       (!= targetIndex sourceIndex))
      ((RATransferSplitEdge inv f term edge dest)) :ruleset ra-transfer-split-index)
(rule ((RATransferSplitEdge inv f term edge dest))
      ((set (RACFGSplitEdges inv f term) (set-of edge))) :ruleset ra-transfer-split-index)
(rule ((RATransferSplitEdge inv f term edge dest))
      ((set (RAFreshId (RAFreshNumbers "RACFGSplitIds" "" (vec-of inv f term edge)) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshNumbers "RACFGSplitIds" "" (vec-of inv f term edge)) 1) (fresh-ir-id))) :ruleset ra-transfer-split-index)
(rule ((RATransferSplitEdge inv f term edge dest)
       (= fresh0 (RAFreshId (RAFreshNumbers "RACFGSplitIds" "" (vec-of inv f term edge)) 0)) (= fresh1 (RAFreshId (RAFreshNumbers "RACFGSplitIds" "" (vec-of inv f term edge)) 1)))
      ((set (RACFGSplitIds inv f term edge) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-split-index)
(rule ((RATransferSplitEdge inv f term edge dest) (BlockParam dest slot value))
      ((set (RAFreshId (RAFreshNumbers "RACFGSplitParam" "" (vec-of inv f term edge slot)) 0) (fresh-ir-id))) :ruleset ra-transfer-split-index)
(rule ((RATransferSplitEdge inv f term edge dest) (BlockParam dest slot value)
       (= fresh0 (RAFreshId (RAFreshNumbers "RACFGSplitParam" "" (vec-of inv f term edge slot)) 0)))
      ((set (RACFGSplitParam inv f term edge slot) fresh0)) :ruleset ra-transfer-split-index)
(rule ((RATransferSplitEdge inv f term edge dest) (= (RATCopy block jump) (RACFGSplitIds inv f term edge))
       (RASelectedCandidate inv f candidate) (RAFunction inv f region) (RAIntegerType ty)
       (= count (RACFGParamCount inv f dest)))
      ((RATransferTransaction inv f candidate) (RATransferEmitBlock inv f block region)
       (RATransferEmitKind inv f jump "cfg.br")
       (RATransferPlacement inv f jump block (RACFGPos 0 0 0 0 0))
       (RATransferEraseSuccessor inv f term edge) (RATransferEmitSuccessor inv f term edge block)
       (RATransferEmitSuccessor inv f jump 0 dest)
       (RATransferEmitAttribute inv f jump "dest" (BlockAttr dest))
       (RATransferEmitAttribute inv f jump "operand_segment_sizes"
        (ListAttr (ACons (IntegerAttr ty 64 (i64-hex count)) (ANil))))) :ruleset ra-transfer-split)
(rule ((RATransferSplitEdge inv f term edge dest) (= (RATCopy block jump) (RACFGSplitIds inv f term edge))
       (BlockParam dest slot value) (= ty (ValueType value)) (= temp (RACFGSplitParam inv f term edge slot)))
      ((RATransferEmitDefinition inv f temp (BlockParamDef block slot) ty)
       (RATransferEmitOperand inv f jump slot temp)
       (RATransferEmitSuccessorArg inv f jump 0 slot slot)) :ruleset ra-transfer-split)
(rule ((RATransferPlacement inv f first block (RACFGPos p a owner i sub))
       (RATransferPlacement inv f second block (RACFGPos q b other j otherSub)) (< p q))
      ((RATransferBefore inv f first second)) :ruleset ra-transfer-layout)
(rule ((RATransferPlacement inv f first block (RACFGPos p a owner i sub))
       (RATransferPlacement inv f second block (RACFGPos p b other j otherSub)) (< a b))
      ((RATransferBefore inv f first second)) :ruleset ra-transfer-layout)
(rule ((RATransferPlacement inv f first block (RACFGPos p a owner i sub))
       (RATransferPlacement inv f second block (RACFGPos p a other j otherSub)) (< owner other))
      ((RATransferBefore inv f first second)) :ruleset ra-transfer-layout)
(rule ((RATransferPlacement inv f first block (RACFGPos p a owner i sub))
       (RATransferPlacement inv f second block (RACFGPos p a owner j otherSub)) (< i j))
      ((RATransferBefore inv f first second)) :ruleset ra-transfer-layout)
(rule ((RATransferPlacement inv f op block position))
      ((set (RATransferPreceding inv f op) (set-empty))) :ruleset ra-transfer-layout)
(rule ((RATransferBefore inv f first second))
      ((set (RATransferPreceding inv f second) (set-of first))) :ruleset ra-transfer-layout)
(rule ((RATransferEmitKind inv f op kind))
      ((set (RATransferChanges inv f) (set-of op))) :ruleset ra-transfer-emit)
(rule ((RATransferRequest inv f op transfer width source destination base offset control stateIn stateOut))
      ((set (RATransferChanges inv f) (set-of op))) :ruleset ra-transfer-emit)
(rule ((RATransferReady inv f candidate) (RATransferPlacement inv f op block position))
      ((delete (OpPlacement op))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferEraseSuccessor inv f op edge))
      ((delete (Successor op edge))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferEraseSuccessorArg inv f op edge slot))
      ((delete (SuccessorArg op edge slot))) :ruleset ra-transfer-delete)
(rule ((RATransferReady inv f candidate) (RATransferEmitKind inv f op kind))
      ((set (OpKind op) kind) (set (KindBoundary kind) (OrdinaryBoundary))) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferPlacement inv f op block position)
       (= order (set-length (RATransferPreceding inv f op))))
      ((set (OpPlacement op) (InBlock block order))) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitBlock inv f block region))
      ((set (BlockRegion block) region) (set (BlockLayout block) block)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitDefinition inv f value (BlockParamDef block slot) ty))
      ((set (DeclaredType value) ty)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitSuccessor inv f op edge dest))
      ((set (Successor op edge) dest)) :ruleset ra-transfer-install)
(rule ((RATransferReady inv f candidate) (RATransferEmitSuccessorArg inv f op edge slot operand))
      ((set (SuccessorArg op edge slot) operand)) :ruleset ra-transfer-install)
(rule ((RASelectedCandidate inv f candidate))
      ((set (RAFrameExtent inv f) 0) (set (RAFrameRequiredBytes inv f) 0)
       (set (RAFrameAllocatedValues inv f) (set-empty))
       (set (RAFrameKnownStates inv f) (set-empty)) (set (RAFrameKnownEntries inv f) (set-empty))) :ruleset ra-transfer-index)
(rule ((TMDLStackLinkBytes inv bytes))
      ((set (RAFrameEntryBias inv) bytes)) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate) (= (RAFrameSlot f value) (RAFS offset size align)))
      ((set (RAFrameAllocatedValues inv f) (set-of value)) (set (RAFrameExtent inv f) (+ offset size))) :ruleset ra-transfer-index)
(rule ((RASelectedCandidate inv f candidate) (= state (RAFrameJoinedState f block)))
      ((set (RAFrameKnownStates inv f) (set-of block))) :ruleset ra-transfer-index)
(rule ((RABlock inv f block) (set-not-contains (RAFrameKnownEntries inv f) block))
      ((RAFramePrefix inv f block 0)) :ruleset ra-transfer-frame-index)
(rule ((RASelectedCandidate inv f candidate) (set-contains (RAFrameKnownEntries inv f) block)
       (= (RATCopy entry state) (RAFrameEntryState f block)) (RAAt inv f candidate block entry point))
      ((RAFramePrefix inv f block (+ point 1))) :ruleset ra-transfer-frame-index)
(rule ((= (RATCopy entry state) (RAFrameEntryState f block))
       (RAPlace inv f candidate entry block) (RAPlace inv f candidate op block) (!= entry op))
      ((RAPred inv f candidate op entry)) :ruleset ra-control-pred)
(rule ((RASelectedCandidate inv f candidate) (= values (RATransferSpilledValues inv f))
       (> (set-length values) 0) (= value (set-get values 0))
       (RASpill inv f candidate value (RASlot key class size)))
      ((RAFrameSpillValue inv f value class size) (RAFrameActive inv f candidate)
       (RATransferTransaction inv f candidate)) :ruleset ra-transfer-plan)
(rule ((RAFrameSpillValue inv f value class size) (TMDLStackLayout inv stackAlign slotSize redZone down style)
       (set-not-contains (RAFrameAllocatedValues inv f) value)
       (= align (max size slotSize)) (= extent (RAFrameExtent inv f))
       (= offset (* (/ (+ extent (- align 1)) align) align)))
      ((RAFramePlannedSlot inv f value offset size align)) :ruleset ra-transfer-plan)
(rule ((RAFrameSpillValue inv f value class size) (= (RAFrameSlot f value) (RAFS offset allocated align)))
      ((RAFramePlannedSlot inv f value offset allocated align)) :ruleset ra-transfer-plan)
(rule ((RAFrameSpillValue inv f value class size))
      ((set (RAFreshId (RAFreshNumbers "RAFrameSpillIds" "" (vec-of inv f value)) 0) (fresh-ir-id))
       (set (RAFreshId (RAFreshNumbers "RAFrameSpillIds" "" (vec-of inv f value)) 1) (fresh-ir-id))) :ruleset ra-transfer-plan)
(rule ((RAFrameSpillValue inv f value class size)
       (= fresh0 (RAFreshId (RAFreshNumbers "RAFrameSpillIds" "" (vec-of inv f value)) 0)) (= fresh1 (RAFreshId (RAFreshNumbers "RAFrameSpillIds" "" (vec-of inv f value)) 1)))
      ((set (RAFrameSpillIds inv f value) (RATCopy fresh0 fresh1))) :ruleset ra-transfer-plan)
(rule ((RAFrameSpillValue inv f value class size) (= (ValueDefinition value) (ResultDef op slot))
       (RASelectedCandidate inv f candidate) (RAAt inv f candidate block op point))
      ((RAFrameStoreAt inv f value block point 1)) :ruleset ra-transfer-plan)
(rule ((RAFrameSpillValue inv f value class size) (= (ValueDefinition value) (BlockParamDef block slot))
       (RAFramePrefix inv f block point))
      ((RAFrameStoreAt inv f value block point -3)) :ruleset ra-transfer-plan)
(rule ((RAFrameStoreAt inv f value block point lane) (= (RATCopy store state) (RAFrameSpillIds inv f value))
       (RAMemoryType memory) (RAFramePlannedSlot inv f value offset size align) (= width (RAValueBits inv f value)))
      ((set (ValueType state) memory) (RAGeneratedTemporary f value) (RANoSpill inv f value)
