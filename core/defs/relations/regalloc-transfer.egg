(relation RATransfersVerified (i64 i64 i64))
(function RATransferInputCopy (i64 i64 i64 i64 i64) RATransferCopyIds :no-merge)
(function RATransferOutputCopy (i64 i64 i64 i64) RATransferCopyIds :no-merge)
(function RATransferSpilledValues (i64 i64) RAIds :merge (set-union old new))
(relation RATransferCopyInputRequest (i64 i64 i64 i64 i64))
(relation RATransferCopyOutputRequest (i64 i64 i64 i64))
(function RATransferCopyTargetRank (i64 i64 i64 i64) i64 :merge (min old new))
(relation RATransferCopyTarget (i64 i64 i64 i64 String i64))
(relation RAFrameNonStackCallee (i64 String i64))
(relation RAAllocationPin (i64 i64 String i64))
(relation RAAllocationOrder (i64 i64 i64))
(relation RATransferOrder (i64 i64 i64 i64))
(relation RATransferRequestedPin (i64 i64 i64 String String i64))
(relation RATransferNewPin (i64 i64 i64 String i64))
(relation RATransferEmitKind (i64 i64 i64 String))
(relation RATransferPlacement (i64 i64 i64 i64 RACFGPosition))
(relation RATransferBefore (i64 i64 i64 i64))
(function RATransferPreceding (i64 i64 i64) RAIds :merge (set-union old new))
(relation RATransferEmitSuccessor (i64 i64 i64 i64 i64))
(relation RATransferEraseSuccessor (i64 i64 i64 i64))
(relation RATransferEmitSuccessorArg (i64 i64 i64 i64 i64 i64))
(relation RATransferEraseSuccessorArg (i64 i64 i64 i64 i64))
(relation RATransferEmitBlock (i64 i64 i64 i64))
(function RACFGParamCount (i64 i64 i64) i64 :merge (max old new))
(function RACFGSuccessors (i64 i64 i64) RAIds :merge (set-union old new))
(function RACFGSplitEdges (i64 i64 i64) RAIds :merge (set-union old new))
(relation RACFGSplitDestination (i64 i64 i64 i64 i64))
(function RACFGSwitchDests (i64 i64 i64 i64) AttrList :no-merge)
(function RACFGSwitchCounts (i64 i64 i64 i64) AttrList :no-merge)
(relation RATransferSplitEdge (i64 i64 i64 i64 i64))
(function RACFGSplitIds (i64 i64 i64 i64) RATransferCopyIds :no-merge)
(function RACFGSplitParam (i64 i64 i64 i64 i64) i64 :no-merge)
(relation RAMemoryType (TypeExpr))
(function RAFrameSlot (i64 i64) RAFrameSlotInfo :no-merge)
(function RAFrameExtent (i64 i64) i64 :merge (max old new))
(function RAFrameEntryBias (i64) i64 :no-merge)
(function RAFrameRequiredBytes (i64 i64) i64 :merge (max old new))
(function RAFrameAllocatedValues (i64 i64) RAIds :merge (set-union old new))
(relation RAFramePlannedSlot (i64 i64 i64 i64 i64 i64))
(relation RAFrameActive (i64 i64 i64))
(function RAFrameEntryState (i64 i64) RATransferCopyIds :no-merge)
(function RAFrameJoinedState (i64 i64) i64 :no-merge)
(function RAFrameKnownStates (i64 i64) RAIds :merge (set-union old new))
(relation RAFrameBlockInput (i64 i64 i64 i64))
(relation RAFramePrefix (i64 i64 i64 i64))
(relation RAFrameBlockTail (i64 i64 i64 i64))
(relation RAFrameMemory (i64 i64 i64))
(relation RAFramePending (i64 i64 i64 String i64 RATransferOperand RATransferOperand i64 i64))
(relation RAFrameEvent (i64 i64 i64 i64 i64))
(function RAFrameEarlier (i64 i64 i64) RAIds :merge (set-union old new))
(function RAFrameLast (i64 i64 i64) RAIds :merge (set-union old new))
(relation RAFrameEventInput (i64 i64 i64 i64))
(function RAFrameEvents (i64 i64 i64) RAIds :merge (set-union old new))
(function RAFrameSpillIds (i64 i64 i64) RATransferCopyIds :no-merge)
(function RAFrameReloadIds (i64 i64 i64 i64) RAFrameSaveIds :no-merge)
(relation RAFrameReloadValue (i64 i64 i64 i64 i64))
(relation RAFrameReloadNeeded (i64 i64 i64 i64))
(relation RAFrameSpillValue (i64 i64 i64 String i64))
(relation RAFrameStoreAt (i64 i64 i64 i64 i64 i64))
(relation RAFrameStateParam (i64 i64 i64 i64 i64))
(relation RACFGEdgeOperand (i64 i64 i64 i64 i64 i64))
(function RACFGEdgeCount (i64 i64 i64 i64) i64 :no-merge)
(function RACFGEdgeStart (i64 i64 i64 i64) i64 :no-merge)
(function RATransferReplacedSlots (i64 i64 i64) RAIds :merge (set-union old new))
(function RATransferRebuiltBranches (i64 i64) RAIds :merge (set-union old new))
(relation RATransferReplaceOperand (i64 i64 i64 i64 i64))
(relation RAFrameCalleeRegister (i64 i64 String i64))
(relation RAFrameSaveInstalled (i64 String i64))
(relation RAFrameNeeded (i64 i64 i64))
(function RAFrameMissingSaves (i64 i64) RARegisterRefs :merge (set-union old new))
(function RAFrameSavedRegisters (i64 i64) RARegisterRefs :merge (set-union old new))
(function RAFrameNewSave (i64 i64 String i64) RAFrameSaveIds :no-merge)
(function RAFrameNewRestore (i64 i64 i64 String i64) RATransferCopyIds :no-merge)
(relation RAFrameSaveOffset (i64 i64 String i64 i64 i64 i64 i64))
(relation RAFrameInstalled (i64 i64))
(function RAFrameInstalledFunctions (i64) RAIds :merge (set-union old new))
(function RAFrameAddressLimit (i64 i64) i64 :merge (max old new))
(function RAFrameAddressDirections (i64) RAIds :merge (set-union old new))
(relation RAFrameAddressDomain (i64 String i64 i64 i64 i64))
(relation RAFrameAdjustPlan (i64 i64 i64 i64 i64))
(relation RAFrameAdjustment (RAFrameAdjustState))
(function RAFrameAdjustmentIds (RAFrameAdjustState) RATransferCopyIds :no-merge)
(function RAFrameExpectedExits (i64 i64) RAIds :merge (set-union old new))
(function RAFrameAdjustedExits (i64 i64) RAIds :merge (set-union old new))
(relation RAFrameComplete (i64 i64 i64))
(function RAEdgeMatchingValues (i64 i64 i64) RAIds :merge (set-union old new))
(function RAEdgeMovingValues (i64 i64 i64) RAIds :merge (set-union old new))
(function RAEdgeCyclicValues (i64 i64) RAIds :merge (set-union old new))
(relation RAEdgeMove (i64 i64 i64 i64 i64 i64 i64 String i64))
(relation RAEdgeDependency (i64 i64 i64 i64 i64))
(relation RAEdgeMoveReach (i64 i64 i64 i64 i64))
(relation RAEdgeCopiesComplete (i64 i64 i64))
(relation RAEdgeCopyStateRow (RAEdgeCopyState))
(function RAEdgeBlockedMoves (RAEdgeCopyState) RAIds :merge (set-union old new))
(function RAEdgeNextMove (RAEdgeCopyState) i64 :merge (min old new))
(function RAEdgeStepIds (RAEdgeCopyState) RATransferCopyIds :no-merge)
(function RAEdgePending (i64 i64) RAIds :merge (set-union old new))
