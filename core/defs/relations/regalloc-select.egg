;; Rank repairs by the extra loads, stores, copies and preserved registers.
;; This is a deterministic local estimate, not a global runtime optimum.
(ruleset ra-select-index)
(ruleset ra-select-cost)
(ruleset ra-select-best)
(ruleset ra-select-choice)
(ruleset ra-select-abi)
(datatype RAExtraCost
  (RAStoreCost i64) (RAPhiStoreCost i64 i64) (RALoadCost i64 i64)
  (RAMoveCost i64 i64 i64) (RASaveCost String i64 bool)
  (RASpeculationCost i64))
(sort RAExtraCosts (Set RAExtraCost))
(function RACandidateExtra (i64 i64 i64) RAExtraCosts :merge (set-union old new))
(function RALoopBlocks (i64 i64) RAIds :merge (set-union old new))
(function RABestCost (i64 i64) i64 :merge (min old new))
(function RABestCandidate (i64 i64) i64 :merge (min old new))
(relation RACandidateScore (i64 i64 i64 i64))
(rule ((RAFunction inv f region))
      ((set (RALoopBlocks inv f) (set-empty))) :ruleset ra-select-index)
(rule ((RAControlComplete inv f candidate))
      ((set (RACandidateExtra inv f candidate) (set-empty))) :ruleset ra-select-index)
(rule ((RAControlEdge inv f from dest) (RAReach inv f dest from)
       (RAReach inv f dest block) (RAReach inv f block dest))
      ((set (RALoopBlocks inv f) (set-of block))) :ruleset ra-select-index)
(rule ((RASpill inv f candidate value slot) (RADef inv f op value))
      ((set (RACandidateExtra inv f candidate) (set-of (RAStoreCost value)))) :ruleset ra-select-cost)
(rule ((RASpill inv f candidate value slot) (RAArgument inv f argument value))
      ((set (RACandidateExtra inv f candidate) (set-of (RAStoreCost value)))) :ruleset ra-select-cost)
(rule ((RASpill inv f candidate value slot) (RAIncoming inv f edge dest param value incoming))
      ((set (RACandidateExtra inv f candidate) (set-of (RAPhiStoreCost edge value)))) :ruleset ra-select-cost)
(rule ((RASpill inv f candidate value slot) (RAUse inv f op use value))
      ((set (RACandidateExtra inv f candidate) (set-of (RALoadCost op value)))) :ruleset ra-select-cost)
(rule ((RARepairRequest inv f candidate op slot value reason) (!= reason "spill value"))
      ((set (RACandidateExtra inv f candidate) (set-of (RAMoveCost op slot value)))) :ruleset ra-select-cost)
(rule ((RAChosenRegister inv f candidate value class index)
       (TMDLAbiRegister inv "callee-saved" saved savedIndex)
       (TMDLClass inv class file width offset merging)
       (TMDLClass inv saved file savedWidth savedOffset savedMerging)
       (< index (+ savedIndex savedWidth)) (< savedIndex (+ index width)))
      ((set (RACandidateExtra inv f candidate) (set-of (RASaveCost saved savedIndex false)))
       (set (RACandidateExtra inv f candidate) (set-of (RASaveCost saved savedIndex true)))) :ruleset ra-select-cost)
(rule ((RAMovable inv f op) (RAPlace inv f candidate op block) (RAPlace inv f 1 op latest)
       (!= block latest) (set-not-contains (RALoopBlocks inv f) latest))
      ((set (RACandidateExtra inv f candidate) (set-of (RASpeculationCost op)))) :ruleset ra-select-cost)
(rule ((RAControlComplete inv f candidate) (RABindingsComplete inv f)
       (= (set-length (RAColorErrors inv f candidate)) 0)
       (= cost (set-length (RACandidateExtra inv f candidate))))
      ((RACandidateScore inv f candidate cost) (set (RABestCost inv f) cost)) :ruleset ra-select-best)
(rule ((RACandidateScore inv f candidate cost) (= cost (RABestCost inv f)))
      ((set (RABestCandidate inv f) candidate)) :ruleset ra-select-choice)
(rule ((RAFunction inv f region) (= candidate (RABestCandidate inv f)))
      ((RASelectedCandidate inv f candidate)) :ruleset ra-select-choice)
;; Generic returns still observe the ABI return link even before final encoding.
(rule ((RAReturn inv f op control) (TMDLAbiRegister inv "ra" class index))
      ((RANativePhysicalRead inv f op class index)) :ruleset ra-select-abi)
(rule ((RAReturn inv f op control) (RAFrameSaveInstalled f class index))
      ((RANativePhysicalRead inv f op class index)) :ruleset ra-select-abi)
