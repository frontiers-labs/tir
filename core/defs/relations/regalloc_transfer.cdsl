// Repair the selected canonical CFG and restart allocation after a transaction.
// Retain RATransferNative, RAGeneratedTemporary, RAAllocationPin,
// RAAllocationOrder, RAFrameSlot, RAFrameEntryState, RAFrameJoinedState,
// RAFrameMemory, RAFrameSaveInstalled and RAFrameInstalled across retries.
pub enum RATransferOperand {
    RATransferValue(Integer),
    RATransferPhysical(String, Integer),
    RATransferAbsent,
};
let make_RATransferValue = constructor(RATransferOperand::RATransferValue);
let make_RATransferPhysical = constructor(RATransferOperand::RATransferPhysical);
let make_RATransferAbsent = constructor(RATransferOperand::RATransferAbsent);

pub enum RATransferRecipe {
    RATR(String, Integer),
};
let make_RATR = constructor(RATransferRecipe::RATR);

pub enum RATransferCopyIds {
    RATCopy(Integer, Integer),
};
let make_RATCopy = constructor(RATransferCopyIds::RATCopy);

pub enum RACFGPosition {
    RACFGPos(Integer, Integer, Integer, Integer, Integer),
};
let make_RACFGPos = constructor(RACFGPosition::RACFGPos);

pub enum RAFrameSlotInfo {
    RAFS(Integer, Integer, Integer),
};
let make_RAFS = constructor(RAFrameSlotInfo::RAFS);

pub enum RAFrameSaveIds {
    RAFSaved(Integer, Integer, Integer, Integer),
};
let make_RAFSaved = constructor(RAFrameSaveIds::RAFSaved);

pub enum RAFrameAdjustState {
    RAFAS(Integer, Integer, Integer, Integer, Integer, Integer, Integer, Integer),
};
let make_RAFAS = constructor(RAFrameAdjustState::RAFAS);

pub enum RAEdgeCopyState {
    RAECS(Integer, Integer, Integer, Integer, RAIds, Integer),
};
let make_RAECS = constructor(RAEdgeCopyState::RAECS);

pub enum RAAddressState {
    RAAS(Integer, Integer, Integer, Integer, String, RATransferOperand, Integer, Integer, Integer),
};
let make_RAAS = constructor(RAAddressState::RAAS);

