pub let TMDLRecipeOffsetFactor = relation<(Integer, String, Integer, Integer)>("TMDLRecipeOffsetFactor");
pub let TMDLRecipeOffset = relation<(Integer, String, Integer, String, Integer, Bool, Integer, Bool)>("TMDLRecipeOffset");
pub let TMDLRecipeZeroOffset = relation<(Integer, String, Integer)>("TMDLRecipeZeroOffset");
pub let TMDLRecipeFeature = relation<(Integer, String, Integer, String)>("TMDLRecipeFeature");
pub let TMDLRecipeParameter = relation<(Integer, String, Integer, String, Integer)>("TMDLRecipeParameter");
pub let TMDLEncodingShape = relation<(Integer, String, Integer, Integer, Integer, String)>("TMDLEncodingShape");
