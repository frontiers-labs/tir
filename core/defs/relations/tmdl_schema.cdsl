pub let TMDLAbiPin = relation<(Integer, String, String, Integer, String, Integer)>("TMDLAbiPin");
pub let TMDLAbiOverflow = relation<(Integer, String, String, String)>("TMDLAbiOverflow");
pub let TMDLStackLayout = relation<(Integer, Integer, Integer, Integer, Bool, String)>("TMDLStackLayout");
pub let TMDLStackLinkBytes = relation<(Integer, Integer)>("TMDLStackLinkBytes");
pub let TMDLFixedRead = relation<(Integer, String, String, Integer)>("TMDLFixedRead");
pub let TMDLFixedWrite = relation<(Integer, String, String, Integer)>("TMDLFixedWrite");
pub let TMDLImplicitOrUpdate = relation<(Integer, String, String, Integer)>("TMDLImplicitOrUpdate");
pub let TMDLFeature = relation<(Integer, String)>("TMDLFeature");
pub let TMDLParameter = relation<(Integer, String, Integer)>("TMDLParameter");
pub let TMDLClassDialect = relation<(Integer, String, String)>("TMDLClassDialect");
pub let TMDLClassOrder = relation<(Integer, String, Integer)>("TMDLClassOrder");
pub let TMDLRegisterName = relation<(Integer, String, String, Integer)>("TMDLRegisterName");
pub let TMDLOpcode = relation<(Integer, String, String, String)>("TMDLOpcode");
pub let TMDLOpcodeFeatureCount = relation<(Integer, String, Integer)>("TMDLOpcodeFeatureCount");
pub let TMDLOpaqueTransferKind = relation<(Integer, String)>("TMDLOpaqueTransferKind");
pub let TMDLOpcodeFeature = relation<(Integer, String, String)>("TMDLOpcodeFeature");
pub let TMDLPureKind = relation<(Integer, String)>("TMDLPureKind");
pub let TMDLInstructionSlot = relation<(Integer, String, String, Integer, String, Bool, Bool, Bool)>("TMDLInstructionSlot");
pub let TMDLInstructionStateSlot = relation<(Integer, String, String, Integer)>("TMDLInstructionStateSlot");
pub let TMDLInstructionSlotCount = relation<(Integer, String, String, Integer)>("TMDLInstructionSlotCount");
pub let TMDLSlotClass = relation<(Integer, String, String, String)>("TMDLSlotClass");
pub let TMDLRecipe = relation<(Integer, String, Integer, String, Integer, Integer, Integer, Integer, Integer)>("TMDLRecipe");
