;; One private integer cell around a single-block ordered loop. Existing result IDs
;; become the new block parameter and owner result, retaining demanded producers.
(relation EQOAccess (i64 i64 i64 i64 i64 String))
(relation EQOLoop (i64 i64 i64 i64))
(relation EQOInit (i64 i64 i64))
(relation EQOBody (i64 i64 i64 i64 i64))
(relation EQOFinal (i64 i64 i64))
(relation EQOAllowed (i64 i64 UseSite))
(relation EQOBlocked (i64))
(relation EQOReady (i64 i64 i64 i64))
(relation EQOElide (i64 i64))
(relation EQOKeepValue (i64 i64))
(relation EQOInvariantBody (i64 i64 i64))
(relation EQOInvariant (i64 i64 i64))

(rule ((EQPrivateCell a pointer parent region ty)
       (OpUnderRegion region op) (= (OpPlacement op) (InBlock block order))
       (= (OpKind op) "ptr.load") (= pointer (Operand op 0)) (not (Operand op 1 extra))
       (Result op 0 value) (not (Result op 1 extra)) (= ty (ValueType value))
       (not (OwnedRegion op slot child))
       (= (Attribute op "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil))))))
      ((EQOAccess a op block order value "load")) :ruleset EQscalar-scope)
(rule ((EQPrivateCell a pointer parent region ty)
       (OpUnderRegion region op) (= (OpPlacement op) (InBlock block order))
       (= (OpKind op) "ptr.store") (= value (Operand op 0)) (= pointer (Operand op 1))
       (not (Operand op 2 extra)) (not (Result op slot extra)) (= ty (ValueType value))
       (not (OwnedRegion op slot child))
       (= (Attribute op "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))))
      ((EQOAccess a op block order value "store")) :ruleset EQscalar-scope)
(rule ((EQPrivateCell a pointer parent region ty)
       (= (OpPlacement a) (InBlock parent start))
       (Result a 0 pointer)
       (BlockMember parent order owner) (> order start) (= (OpKind owner) "scf.ordered_for")
       (= body (OwnedRegion owner 0)) (not (OwnedRegion owner 1 extra))
       (= (Mode body) (CFG)) (= block (Entry body))
       (Result owner 0 counter) (BlockParam block 0 iv))
      ((EQOLoop a owner body block)) :ruleset EQscalar-scope)
(rule ((EQOLoop a owner body block) (EQPrivateCell a pointer parent region ty)
       (= (OpPlacement a) (InBlock parent start)) (= (OpPlacement owner) (InBlock parent end))
       (EQOAccess a store parent order value "store") (> order start) (< order end))
      ((EQOInit a store value) (EQOAllowed a store (OperandUse 1))) :ruleset EQscalar-scope)
(rule ((EQOLoop a owner body block) (EQOAccess a load block before local "load")
       (EQOAccess a store block after next "store") (< before after)
       (BlockMember block end latch) (> end after) (= (OpKind latch) "scf.yield")
       (not (Operand latch 0 extra)))
      ((EQOBody a load local store next) (EQOAllowed a load (OperandUse 0))
       (EQOAllowed a store (OperandUse 1))) :ruleset EQscalar-scope)
(rule ((EQOLoop a owner body block) (EQPrivateCell a pointer parent region ty)
       (= (OpPlacement owner) (InBlock parent start))
       (EQOAccess a load parent order value "load") (> order start))
      ((EQOFinal a load value) (EQOAllowed a load (OperandUse 0))) :ruleset EQscalar-scope)

(rule ((EQPrivateCell a pointer parent region ty) (EQOLoop a owner body block)
       (Uses pointer op site) (not (EQOAllowed a op site))) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQPrivateCell a pointer parent region ty)
       (EQScalarAttrRef attr pointer)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (= attr (Attribute a key)) (!= key "size") (!= key "align"))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOAllowed a op site) (= attr (Attribute op key)) (!= key "operand_segment_sizes"))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (= attr (Attribute owner key)) (!= key "operand_segment_sizes"))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (= child (OwnedRegion op slot)) (OpUnderRegion body op))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQOrderedCarrierBlocked owner)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (BlockMember block order op)
       (HasInterface op "dyn tir::interfaces::Terminator") (!= (OpKind op) "scf.yield"))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOInit a first x) (EQOInit a last y) (!= first last)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOBody a first x store y) (EQOBody a last z other w) (!= first last)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOBody a load x first y) (EQOBody a other z last w) (!= first last)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOFinal a first x) (EQOFinal a last y) (!= first last)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a first body block) (EQOLoop a last other entry) (!= first last)) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (= region (BlockRegion other)) (= region body) (!= block other))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (= function (OwningFunction a))
       (= function (OwningFunction op)) (= (OpKind op) "ptr.alloca") (!= a op))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (= function (OwningFunction a))
       (= function (OwningFunction op)) (HasInterface op "dyn tir::interfaces::ResourceEffects")
       (not (EQOAllowed a op site))) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (not (EQOrdinaryLayout a)))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQOAllowed a op site) (not (EQOrdinaryLayout op)))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQMalformedLayout a))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQOAllowed a op site) (EQMalformedLayout op))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQOAccess a op place order value "load") (EQScalarAttrRef attr value))
      ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQOBody a load local store next) (Uses local reader site)
       (not (OpRegion reader body))) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQOLoop a owner body block) (EQOFinal a load value) (EQPrivateCell a pointer parent region ty)
       (Uses value reader site) (not (OpRegion reader region))) ((EQOBlocked a)) :ruleset EQscopes)

(rule ((EQSeed scope) (EQPrivateCell a pointer parent scope ty)
       (EQOLoop a owner body block) (EQOInit a store init) (EQOBody a load local update next)
       (EQOFinal a final result) (not (Result owner 1 extra)) (not (BlockParam block 1 extra))
       (not (EQOBlocked a)))
      ((EQOReady scope a owner block) (EQOElide scope a) (EQOElide scope store)
       (EQOElide scope load) (EQOElide scope update) (EQOElide scope final)
       (EQOKeepValue scope local) (EQOKeepValue scope result)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQInvocation invocation root) (EQOReady scope a owner block)
       (EQOLoop a owner body block) (EQOInit a store init) (EQOBody a load local update next)
       (EQOFinal a final result) (= ty (ValueType local)) (= ub (Operand owner 1)) (= step (Operand owner 2))
       (BlockMember block order latch) (= (OpKind latch) "scf.yield"))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQPutValueDefinition p local (BlockParamDef block 1)) (EQPutDeclaredType p local ty)
       (EQPutValueDefinition p result (ResultDef owner 1))
       (EQPutOperand p owner 1 init) (EQPutOperand p owner 2 ub) (EQPutOperand p owner 3 step)
       (EQPutOperand p latch 0 next)
       (EQPutEntryBinding p body 1 1) (EQPutFeedbackBinding p body 1 0)
       (EQPutExitBinding p body 1 0) (EQPutYield p body 0 next)
       (EQPutAttribute p owner "operand_segment_sizes"
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil)))))))
       (EQPutAttribute p latch "operand_segment_sizes"
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil)))))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQOElide scope op))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQOElide scope op) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQOElide scope op) (= attr (Attribute op key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p op key)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQOElide scope op) (Result op slot value)
       (not (EQOKeepValue scope value)))
      ((let p (EQProposal invocation root scope root))
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)) :ruleset EQscoped-edits)

;; With no body write, the original initializer is available in the body.
(rule ((EQOLoop a owner body block) (EQOAccess a load block order value "load"))
      ((EQOInvariantBody a load value) (EQOAllowed a load (OperandUse 0))) :ruleset EQscalar-scope)
(rule ((EQOLoop a owner body block) (EQOInvariantBody a load local) (Uses local reader site)
       (not (OpRegion reader body))) ((EQOBlocked a)) :ruleset EQscopes)
(rule ((EQSeed scope) (EQPrivateCell a pointer parent scope ty) (EQOLoop a owner body block)
       (EQOInit a store init) (EQOInvariantBody a load local)
       (not (EQOAccess a update block order next "store"))
       (not (EQOFinal a final result)) (not (EQOBlocked a)))
      ((EQOInvariant scope a owner) (EQOElide scope a) (EQOElide scope store)) :ruleset EQassumptions)
(rule ((EQOInvariant scope a owner) (EQOLoop a owner body block)
       (EQOInit a store init) (EQOInvariantBody a load local))
      ((EQOElide scope load) (EQExactReplacement body local init)) :ruleset EQassumptions)
(rule ((EQOLoop a owner body block) (EQOAccess a first block before x kind)
       (EQOAccess a last block after y kind) (!= first last))
      ((EQOBlocked a)) :ruleset EQscopes)

;; Reuse an unused total integer constant result as the existing carry slot.
(rule ((EQOLoop a owner body block) (EQPrivateCell a pointer parent region ty)
       (EQScalarSupported block slot local) (= (OpKind slot) "builtin.constant")
       (= (ValueType local) ty) (EQCanSpeculate slot)
       (not (HasInterface slot "dyn tir::interfaces::ResourceEffects"))
       (not (OwnedRegion slot index child))
       (not (Uses local reader site))
       (not (EQOAccess a load block order value "load"))
       (BlockMember block before slot) (EQOAccess a store block after next "store") (< before after)
       (BlockMember block end latch) (> end after) (= (OpKind latch) "scf.yield")
       (not (Operand latch 0 extra)))
      ((EQOBody a slot local store next) (EQOAllowed a store (OperandUse 1))) :ruleset EQscalar-check)
(rule ((EQOBody a slot local store next) (= (OpKind slot) "builtin.constant")
       (= attr (Attribute slot key)) (!= key "value"))
      ((EQOBlocked a)) :ruleset EQscopes)

(rule ((EQOBody a slot local store next) (= (OpKind slot) "builtin.constant")
       (EQScalarAttrRef attr local))
      ((EQOBlocked a)) :ruleset EQscopes)
