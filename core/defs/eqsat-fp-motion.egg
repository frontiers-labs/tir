;; Share a speculatable integer or ignored-exception FP evaluation in an entry diamond.
;; The law preserves the result choice set without asserting congruence of FP terms.
(relation EQFPMotionKind (String))
(EQFPMotionKind "fp.add")
(EQFPMotionKind "fp.cmp")
(EQFPMotionKind "fp.convert")
(EQFPMotionKind "fp.to_si")
(EQFPMotionKind "builtin.addi")
(relation EQFPMotionOp (i64 i64))
(relation EQFPMotionExtra (i64))
(relation EQFPMotionAvailable (i64 i64))
(relation EQFPMotionArm (i64 i64 i64 i64 i64))
(relation EQFPMotionArmBad (i64))
(relation EQFPMotionPair (i64 i64 i64 i64 i64 i64 i64 i64))
(relation EQFPMotionMismatch (i64 i64))
(function EQFPMotionFirst (i64) i64 :merge (min old new))
(function EQFPMotionSecond (i64 i64) i64 :merge (min old new))

(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQFPMotionKind kind)
       (= attr (Attribute op key)) (!= key "semantics") (!= key "operand_segment_sizes") (!= key "predicate"))
      ((EQFPMotionExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQFPMotionKind kind)
       (EQCanSpeculate op) (EQEffectFree op)
       (Result op 0 value) (not (Result op 1 extra)) (not (OwnedRegion op slot region)))
      ((EQFPMotionOp op value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.addi") (EQCanSpeculate op)
       (not (Attribute op key))
       (Result op 0 value) (not (Result op 1 extra)) (not (OwnedRegion op slot region))
       (= x (Operand op 0)) (= y (Operand op 1)) (not (Operand op 2 extra))
       (= ty (ValueType value)) (= ty (ValueType x)) (= ty (ValueType y))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))))
      ((EQFPMotionOp op value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (= region (OwnedRegion root 0)) (= (OpKind root) "func.func") (= (Mode region) (CFG))
       (= entry (Entry region)) (BlockParam entry slot value))
      ((EQFPMotionAvailable entry value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (= region (OwnedRegion root 0)) (= (OpKind root) "func.func") (= (Mode region) (CFG))
       (= entry (Entry region)) (BlockMember entry limit branch) (= (OpKind branch) "cfg.cond_br")
       (BlockMember entry order producer) (< order limit) (Result producer slot value))
      ((EQFPMotionAvailable entry value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (EQFPMotionOp op value)
       (BlockMember block 0 op) (BlockMember block order branch) (> order 0) (= (OpKind branch) "cfg.br")
       (= join (Successor branch 0)) (= value (Operand branch 0)))
      ((EQFPMotionArm block op value branch join)) :ruleset EQscalar-scope)
(rule ((EQFPMotionArm block op value branch join) (Uses value reader site) (!= reader branch))
      ((EQFPMotionArmBad op)) :ruleset EQscalar-check)
(rule ((EQRoot root) (= region (OwnedRegion root 0)) (= (OpKind root) "func.func") (= (Mode region) (CFG))
       (= entry (Entry region)) (BlockMember entry limit branch) (= (OpKind branch) "cfg.cond_br")
       (= left (Successor branch 0)) (= right (Successor branch 1)) (!= left right) (!= left entry) (!= right entry)
       (= region (BlockRegion left)) (= region (BlockRegion right))
       (EQFPMotionArm left first witness lbr join) (EQFPMotionArm right second value rbr join)
       (= kind (OpKind first)) (= kind (OpKind second))
       (= ty (ValueType witness)) (= ty (ValueType value)))
      ((EQFPMotionPair region entry branch limit first second witness value)) :ruleset EQscalar-scope)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (EQScalarAttrRef attr witness))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value)
       (= (OpPlacement first) (InBlock arm order)) (= arm (Successor predecessor edge)) (!= predecessor branch))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value)
       (= (OpPlacement second) (InBlock arm order)) (= arm (Successor predecessor edge)) (!= predecessor branch))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (EQScalarAttrRef attr value))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (= input (Operand first slot))
       (not (Operand second slot input)))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (= input (Operand second slot))
       (not (Operand first slot input)))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (= input (Operand first slot))
       (not (EQFPMotionAvailable entry input)))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (= attr (Attribute first key))
       (not (Attribute second key attr)))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
(rule ((EQFPMotionPair region entry branch limit first second witness value) (= attr (Attribute second key))
       (not (Attribute first key attr)))
      ((EQFPMotionMismatch first second)) :ruleset EQscalar-check)
;; Let diamond motion own these arm operations before scalar extraction.
(rule ((EQFPMotionPair region entry branch limit first second witness value)
       (not (EQFPMotionMismatch first second)) (not (EQFPMotionExtra first)) (not (EQFPMotionExtra second))
       (not (EQFPMotionArmBad first)) (not (EQFPMotionArmBad second))
       (= (OpPlacement first) (InBlock left first_order)) (= (OpPlacement second) (InBlock right second_order)))
      ((EQScalarBad left) (EQScalarBad right)) :ruleset EQscalar-validate)
(rule ((EQFPMotionPair region entry branch limit first second witness value)
       (not (EQFPMotionMismatch first second)) (not (EQFPMotionExtra first)) (not (EQFPMotionExtra second))
       (not (EQFPMotionArmBad first)) (not (EQFPMotionArmBad second))
       (not (EQScalarManagedOp first)) (not (EQScalarManagedOp second)))
      ((set (EQFPMotionFirst region) first) (set (EQFPMotionSecond region first) second)) :ruleset EQscopes)
(rule ((EQSeed region) (EQFPMotionPair region entry branch limit first second witness value)
       (= first (EQFPMotionFirst region)) (= second (EQFPMotionSecond region first)))
      ((EQExactReplacement region value witness)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed region)
       (EQFPMotionPair region entry branch limit first second witness value)
       (= first (EQFPMotionFirst region)) (= second (EQFPMotionSecond region first)))
      ((let p (EQProposal invocation root region root)) (EQScopedAuthorized p)
       (EQPutOpPlacement p first (InBlock entry limit)) (EQPutOpPlacement p branch (InBlock entry (+ limit 1)))
       (EQEraseOpKind p second) (EQEraseOpPlacement p second) (EQEraseOpLocation p second) (EQEraseGraphLayout p second)
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed region)
       (EQFPMotionPair region entry branch limit first second witness value)
       (= first (EQFPMotionFirst region)) (= second (EQFPMotionSecond region first)) (= input (Operand second slot)))
      ((EQEraseOperand (EQProposal invocation root region root) second slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed region)
       (EQFPMotionPair region entry branch limit first second witness value)
       (= first (EQFPMotionFirst region)) (= second (EQFPMotionSecond region first)) (= attr (Attribute second key)))
      ((EQEraseAttribute (EQProposal invocation root region root) second key)) :ruleset EQscoped-edits)

;; CFG joins may use an existing entry-produced witness after exact rewrites.
(rule ((EQSeed region) (EQCFGParam region block slot local) (EQAvailable old local)
       (= entry (Entry region)) (BlockMember entry order producer) (Result producer 0 witness)
       (EQCanSpeculate producer) (EQEffectFree producer)
       (= (EQInput local) (EQInput witness)))
      ((EQAvailable old witness)) :ruleset EQoutput)
