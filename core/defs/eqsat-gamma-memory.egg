(relation EQGStoreDemanded (i64 i64))
(relation EQGDropArgument (i64 i64))
(relation EQGDropParam (i64 i64 i64))
(relation EQGCell (i64 i64 i64 TypeExpr))
(relation EQGScope (i64 i64))
(relation EQGEntry (i64 i64))
(relation EQGStore (i64 i64 i64 i64 i64))
(relation EQGLoad (i64 i64 i64 i64 i64))
(relation EQGGamma (i64 i64 i64 i64))
(relation EQGArm (i64 i64 i64 i64))
(relation EQGFlow (i64 i64))
(relation EQGScalar (i64 i64 i64))
(relation EQGAddressUse (i64 i64 UseSite))
(relation EQGStateUse (i64 i64 i64 UseSite))
(relation EQGBlocked (i64))
(relation EQGElide (i64 i64))
(relation EQGRetype (i64 i64 TypeExpr))
(relation EQGOperand (i64 i64 i64 i64))
(relation EQGYield (i64 i64 i64 i64))
(relation EQGDataDemand (i64 i64))
(relation EQGPair (i64 i64 i64))
(relation EQGPort (i64 i64 i64 i64))
(relation EQGFinalReach (i64 i64 i64))
(relation EQGKeepValue (i64 i64))
(relation EQGGroupAccess (i64 i64))
;; Closed ordinary cells use existing gamma or final-load IDs as scalar ports.

(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= (OpPlacement allocation) (InGraph region)) (= root (RegionOwner region)) (Function root)
       (Result allocation 0 pointer) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (= (ValueType pointer) (Apply (Ctor "ptr.p") (TCons ty (TNil))))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (EQCellWidth width bytes)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 bytes))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment))
      ((EQGCell allocation pointer region ty) (EQGScope allocation region)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= (OpPlacement allocation) (InGraph region)) (= root (RegionOwner region)) (Function root)
       (Result allocation 0 pointer) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (EQPointerCellType pointer ty)
       (EQExplicitCellLayout allocation)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000008"))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment))
      ((EQGCell allocation pointer region ty) (EQGScope allocation region)) :ruleset EQscalar-scope)

(rule ((EQGCell a pointer region ty) (= (OpKind op) "state.entry_state")
       (= (OpPlacement op) (InGraph region)) (Result op 0 state)
       (= (ValueType state) (Apply (Ctor "builtin.state") (TCons (SymbolParam resource) (TNil))))
       (= (SymbolName resource) "memory"))
      ((EQGEntry a state) (EQGFlow a state)) :ruleset EQscalar-check)
(rule ((EQGCell a pointer outer ty) (EQGScope a region)
       (= (OpPlacement store) (InGraph region)) (= (OpKind store) "ptr.store")
       (= value (Operand store 0)) (= pointer (Operand store 1)) (= before (Operand store 2))
       (not (Operand store 3 extra)) (Result store 0 after) (not (Result store 1 extra))
       (= ty (ValueType value)) (not (OwnedRegion store slot child))
       (= (Attribute store "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil)))))))
      ((EQGStore a store before after value) (EQGAddressUse a store (OperandUse 1))
       (EQGStateUse a before store (OperandUse 2))) :ruleset EQscalar-check)
(rule ((EQGCell a pointer outer ty) (EQGScope a region)
       (= (OpPlacement load) (InGraph region)) (= (OpKind load) "ptr.load")
       (= pointer (Operand load 0)) (= before (Operand load 1)) (not (Operand load 2 extra))
       (Result load 0 value) (Result load 1 after) (not (Result load 2 extra))
       (= ty (ValueType value)) (not (OwnedRegion load slot child))
       (= (Attribute load "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil))))))
      ((EQGLoad a load before after value) (EQGAddressUse a load (OperandUse 0))
       (EQGStateUse a before load (OperandUse 1))) :ruleset EQscalar-check)
(rule ((EQGCell a pointer outer ty) (EQGScope a region)
       (= (OpPlacement gamma) (InGraph region)) (Gamma gamma) (= (OpKind gamma) "scf.switch")
       (= before (Operand gamma 1)) (not (Operand gamma 2 extra))
       (Result gamma 0 after) (not (Result gamma 1 extra)))
      ((EQGGamma a gamma before after) (EQGStateUse a before gamma (OperandUse 1))) :ruleset EQscalar-check)
(rule ((EQGGamma a gamma before after) (= arm (OwnedRegion gamma slot))
       (= (Mode arm) (Graph)) (RegionParam arm 0 local) (not (RegionParam arm 1 extra))
       (= (EntryBinding arm 0) 1) (= (ExitBinding arm 0) 0)
       (EntryValue arm 0 before) (ExitValue arm 0 exit) (not (Yield arm 1 extra))
       (not (FeedbackBinding arm slot2 feedback)))
      ((EQGArm a gamma arm local) (EQGScope a arm)
       (EQGStateUse a exit gamma (YieldUse arm 0))) :ruleset EQscalar-check)
(rule ((EQGStore a store before after value) (EQGFlow a before))
      ((EQGFlow a after) (EQGScalar a after value)) :ruleset EQscalar-check)
(rule ((EQGGamma a gamma before after) (EQGScalar a before scalar) (EQGPort a gamma carrier slot))
      ((EQGFlow a after) (EQGScalar a after carrier)) :ruleset EQscalar-check)
(rule ((EQGArm a gamma arm local) (EQGGamma a gamma before after) (EQGScalar a before scalar))
      ((EQGFlow a local) (EQGScalar a local scalar)) :ruleset EQscalar-check)
(rule ((EQGLoad a load before after value) (EQGScalar a before scalar))
      ((EQGFlow a after) (EQGScalar a after scalar)) :ruleset EQscalar-check)
(rule ((EQGCell a pointer region ty) (= root (RegionOwner region))
       (= state (Yield region slot)) (EQGFlow a state))
      ((EQGStateUse a state root (YieldUse region slot))) :ruleset EQscalar-check)

(rule ((EQGCell a pointer region ty) (Uses pointer op site) (not (EQGAddressUse a op site)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (EQScalarAttrRef attr pointer)) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (= attr (Attribute a key)) (!= key "size") (!= key "align"))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGAddressUse a access site) (= attr (Attribute access key)) (!= key "operand_segment_sizes"))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (= root (RegionOwner region)) (= root (OwningFunction op))
       (= (OpKind op) "ptr.alloca") (not (EQGCell op other region ty2))) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (= root (RegionOwner region)) (= root (OwningFunction op))
       (HasInterface op "dyn tir::interfaces::ResourceEffects") (not (EQGGroupAccess region op)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (not (EQOrdinaryLayout a)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGAddressUse a access site) (not (EQOrdinaryLayout access)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (EQMalformedLayout a))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGAddressUse a access site) (EQMalformedLayout access))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGStore a store before after value) (not (EQGFlow a before))) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGLoad a load before after value) (not (EQGScalar a before scalar))) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGGamma a gamma before after) (not (EQGScalar a before scalar))) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGGamma a gamma before after) (= arm (OwnedRegion gamma slot)) (not (EQGArm a gamma arm local)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGArm a gamma arm local) (ExitValue arm 0 exit) (not (EQGScalar a exit scalar)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGFlow a state) (Uses state op site) (not (EQGStateUse a state op site)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGFlow a state) (EQScalarAttrRef attr state)) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGLoad a load before after value) (EQScalarAttrRef attr value)) ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a pointer region ty) (EQGEntry a first) (EQGEntry a second) (!= first second))
      ((EQGBlocked a)) :ruleset EQscopes)

(rule ((EQGCell a pointer region first) (EQGCell a pointer region second)
       (!= first second)) ((EQGBlocked a)) :ruleset EQscopes)

(rule ((EQGCell a pointer region ty) (EQSeed region) (EQGGamma a gamma before after) (not (EQGBlocked a)))
      ((EQGElide region a)) :ruleset EQassumptions)
(rule ((EQGElide region a) (EQGStore a store before after value))
      ((EQGElide region store)) :ruleset EQassumptions)
(rule ((EQGElide region a) (EQGLoad a load before after value) (EQGScalar a before scalar) (EQGEntry a entry))
      ((EQGElide region load) (EQExactReplacement region after entry)) :ruleset EQassumptions)
(rule ((EQGElide region a) (EQGCell a pointer region ty) (EQGGamma a gamma before after)
       (EQGScalar a before scalar) (EQGPort a gamma after slot))
      ((EQGRetype region after ty) (EQGDropArgument region gamma)) :ruleset EQassumptions)
(rule ((EQGElide region a) (EQGCell a pointer region ty) (EQGArm a gamma arm local)
       (ExitValue arm 0 exit) (EQGScalar a exit scalar) (EQGPort a gamma carrier port))
      ((EQGDropParam region arm local) (EQGYield region arm port scalar)) :ruleset EQassumptions)
(rule ((EQGGamma a gamma before after) (= attr (Attribute gamma key)) (!= key "operand_segment_sizes"))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGElide region a) (EQGEntry a entry) (= state (Yield region slot)) (EQGFlow a state))
      ((EQGYield region region slot entry)) :ruleset EQassumptions)

(rule ((EQRoot root) (EQInvocation invocation root) (EQGElide scope op))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGElide scope op) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGElide scope op) (= attr (Attribute op key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p op key)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGElide scope op) (Result op slot value)
       (not (EQGKeepValue scope value)))
      ((let p (EQProposal invocation root scope root))
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGRetype scope value ty))
      ((let p (EQProposal invocation root scope root)) (EQPutValueType p value ty)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGRetype scope value ty) (= old (DeclaredType value)))
      ((let p (EQProposal invocation root scope root)) (EQPutDeclaredType p value ty)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGOperand scope op slot value))
      ((let p (EQProposal invocation root scope root)) (EQPutOperand p op slot value)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGYield scope region slot value))
      ((let p (EQProposal invocation root scope root)) (EQPutYield p region slot value)) :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQGDropArgument scope gamma))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p gamma 1)
       (EQPutAttribute p gamma "operand_segment_sizes"
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGDropParam scope arm local))
      ((let p (EQProposal invocation root scope root)) (EQEraseEntryBinding p arm 0)
       (EQEraseValueDefinition p local) (EQEraseValueType p local) (EQEraseDeclaredType p local)) :ruleset EQscoped-edits)

;; Every removed conditional state dependency must remain demanded as data.

(rule ((EQGCell a pointer region ty) (EQGPair region first second) (= value (Yield region slot)))
      ((EQGDataDemand a value)) :ruleset EQscalar-check)
(rule ((EQGDataDemand a value) (Result op 0 value) (= (OpKind op) "builtin.addi")
       (not (OwnedRegion op slot child)) (= input (Operand op input_slot)))
      ((EQGDataDemand a input)) :ruleset EQscalar-check)
(rule ((EQGDataDemand a value) (EQGLoad a load before after value) (EQGScalar a before scalar))
      ((EQGDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQGDataDemand a carrier) (EQGPort a gamma carrier slot) (EQGArm a gamma arm local)
       (ExitValue arm 0 exit) (EQGScalar a exit scalar))
      ((EQGDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQGGamma a gamma before after) (EQGPort a gamma carrier slot) (not (EQGDataDemand a carrier)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGStore a store before after value) (not (EQTotalValue value)) (not (EQGStoreDemanded a store)))
      ((EQGBlocked a)) :ruleset EQscopes)

(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= (OpPlacement allocation) (InGraph region)) (= root (RegionOwner region)) (Function root)
       (Result allocation 0 pointer) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (= (ValueType pointer) (Apply (Ctor "ptr.p") (TNil)))
       (Within root load) (= (OpKind load) "ptr.load") (= pointer (Operand load 0))
       (Result load 0 value) (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (EQCellWidth width bytes)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 bytes))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment))
      ((EQGCell allocation pointer region ty) (EQGScope allocation region)) :ruleset EQscalar-scope)
(rule ((EQGCell a p region ty) (EQGCell b q region other) (< a b))
      ((EQGPair region a b)) :ruleset EQscalar-scope)
(rule ((EQGCell a p region ty) (not (EQGPair region first second))
       (EQGGamma a gamma before after))
      ((EQGPort a gamma after 0)) :ruleset EQscalar-check)
(rule ((EQGGamma a gamma before after))
      ((EQGFinalReach a gamma after)) :ruleset EQscalar-check)
(rule ((EQGFinalReach a gamma before) (EQGLoad b load before after value))
      ((EQGFinalReach a gamma after)) :ruleset EQscalar-check)
(rule ((EQGFinalReach a gamma before) (EQGStore b store before after value) (!= a b))
      ((EQGFinalReach a gamma after)) :ruleset EQscalar-check)
(rule ((EQGPair region a b) (EQGFinalReach a gamma before) (EQGLoad a load before after value)
       (= (OpPlacement gamma) (InGraph region)) (= (OpPlacement load) (InGraph region)))
      ((EQGPort a gamma value 0)) :ruleset EQscalar-check)
(rule ((EQGPair region a b) (EQGFinalReach b gamma before) (EQGLoad b load before after value)
       (= (OpPlacement gamma) (InGraph region)) (= (OpPlacement load) (InGraph region)))
      ((EQGPort b gamma value 1)) :ruleset EQscalar-check)
(rule ((EQGCell a pointer region ty) (EQGAddressUse a op site))
      ((EQGGroupAccess region op)) :ruleset EQscalar-check)
(rule ((EQGCell a p region ty) (EQGCell b q region other) (EQGBlocked b))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGPair region a b) (EQGCell c pointer region ty) (!= c a) (!= c b))
      ((EQGBlocked a) (EQGBlocked b)) :ruleset EQscopes)
(rule ((EQGGamma a gamma before after) (not (EQGPort a gamma value slot)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGPort a gamma first slot) (EQGPort a gamma second other) (!= first second))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGPair region a b) (EQGGamma a gamma before after) (!= (OpPlacement gamma) (InGraph region)))
      ((EQGBlocked a)) :ruleset EQscopes)
(rule ((EQGCell a p region ty) (EQGCell b q region other) (!= a b)
       (EQGLoad b load before after value) (EQGFlow a before))
      ((EQGFlow a after) (EQGStateUse a before load (OperandUse 1))) :ruleset EQscalar-check)
(rule ((EQGCell a p region ty) (EQGCell b q region other) (!= a b)
       (EQGLoad b load before after value) (EQGScalar a before scalar))
      ((EQGScalar a after scalar)) :ruleset EQscalar-check)
(rule ((EQGCell a p region ty) (EQGCell b q region other) (!= a b)
       (EQGStore b store before after value) (EQGFlow a before))
      ((EQGFlow a after) (EQGStateUse a before store (OperandUse 2))) :ruleset EQscalar-check)
(rule ((EQGCell a p region ty) (EQGCell b q region other) (!= a b)
       (EQGStore b store before after value) (EQGScalar a before scalar))
      ((EQGScalar a after scalar)) :ruleset EQscalar-check)

(rule ((EQGElide region a) (EQGLoad a load before after value) (EQGScalar a before scalar)
       (!= value scalar) (= (OpPlacement load) (InGraph local)))
      ((EQExactReplacement local value scalar)) :ruleset EQassumptions)
(rule ((EQGElide region a) (EQGPort a gamma carrier slot) (EQGGamma a gamma before after)
       (!= carrier after))
      ((EQGKeepValue region carrier) (EQGDropArgument region gamma)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQInvocation invocation root) (EQGElide scope a)
       (EQGPort a gamma carrier slot) (EQGGamma a gamma before after) (!= carrier after))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseValueDefinition p after) (EQEraseValueType p after) (EQEraseDeclaredType p after)
       (EQPutValueDefinition p carrier (ResultDef gamma slot))) :ruleset EQscoped-edits)

(rule ((EQGCell a pointer region ty) (EQGPair region first second)
       (EQGArm a gamma arm local) (EQGStore a store before after value)
       (= (OpPlacement store) (InGraph arm)) (ExitValue arm 0 exit) (EQGScalar a exit value)
       (EQGPort a gamma carrier slot) (EQGDataDemand a carrier))
      ((EQGStoreDemanded a store)) :ruleset EQscalar-check)

(rule ((EQGCell a pointer region ty) (EQGLoad a load before after value)
       (= value (Yield region slot)) (EQGScalar a before scalar))
      ((EQGDataDemand a scalar)) :ruleset EQscalar-check)
(rule ((EQGCell a pointer region ty) (EQGLoad a load before after value)
       (= (OpPlacement load) (InGraph local)) (!= local region)
       (not (EQGPair region first second))) ((EQGBlocked a)) :ruleset EQscopes)
