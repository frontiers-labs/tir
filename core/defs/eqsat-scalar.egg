(relation EQCanSpeculate (i64))
(relation EQEffectFree (i64))
;; Each placement scope owns a scalar collection and its existing reusable slots.
(datatype EQOutputs (EQONil :cost 0) (EQOCons EQTerm EQOutputs :cost 0))
(relation EQScalarFrame (i64 i64 i64))
(relation EQScalarBody (i64 i64 i64))
(relation EQScalarParam (i64 i64))
(relation EQScalarOrderedConsumer (i64 i64))
(relation EQScalarOrderedResult (i64 i64))
(relation EQOrderedCarrier (i64 i64 i64))
(relation EQScalarUsed (i64 i64))
(relation EQScalarTerminator (i64))
(relation EQScalarNumericType (TypeExpr))
(relation EQScalarType (i64 TypeExpr))
(relation EQScalarSupported (i64 i64 i64))
(relation EQScalarLeaf (i64 i64 i64))
(relation EQScalarInputWitness (i64 i64 i64))
(relation EQScalarTuple (i64 i64 i64))
(relation EQScalarBad (i64))
(relation EQScalarMultipleOps (i64))
(relation EQScalarPure (i64 i64 TypeExpr))
(relation EQScalarAttrRef (Attr i64))
(relation EQScalarPort (i64 i64 i64 i64 i64))
(relation EQScalarPortRank (i64 i64 i64 i64 i64 i64))
(relation EQScalarPortCount (i64 i64))
(relation EQScalarYieldPort (i64 i64 i64 i64))
(relation EQScalarPool (i64 i64 i64 i64))
(relation EQScalarBadSlot (i64 i64))
(relation EQScalarSafePool (i64 i64 i64 i64))
(relation EQScalarPoolRank (i64 i64 i64 i64 i64))
(relation EQScalarPoolCount (i64 i64))
(relation EQScalarSourceRank (i64 i64 i64 i64 i64))
(relation EQScalarSourceCount (i64 i64))
(relation EQScalarNodeRank (i64 i64 i64 i64))
(relation EQScalarNodeCount (i64 i64))
(relation EQScalarCostRequest (String String))
(relation EQScalarWeight (String i64))
(relation EQScalarCtorCost (String i64))
(function EQScalarPoolCost (i64 i64) i64 :no-merge)
;; These immutable lists retain their first finite source construction as children rebuild.
(function EQScalarTail (i64 i64) EQOutputs :merge old)
(function EQScalarBundle (i64) EQOutputs :merge old)
(relation EQScalarWitness (i64 i64 i64 i64))
(relation EQScalarWitnessCtor (i64 i64 String))
(relation EQScalarWitnessChild (i64 i64 i64 i64))
(relation EQScalarWitnessInt (i64 i64 i64))
(relation EQScalarWitnessString (i64 i64 String))
(relation EQScalarChosenTail (i64 i64 i64))
(relation EQScalarChosenOutput (i64 i64 i64))
(relation EQScalarChosenOp (i64 i64 i64))
(relation EQScalarDecoded (i64 i64 String))
(relation EQScalarMaterial (i64 i64 i64))
(relation EQScalarAssigned (i64 i64 i64 i64))
(relation EQScalarInvalid (i64))
(relation EQScalarReady (i64))
(relation EQScalarAuthorized (EQPlan))
(ruleset EQscalar-scope)
(ruleset EQscalar-check)
(ruleset EQscalar-validate)
(ruleset EQscalar-complete)
(ruleset EQscalar-ports)
(ruleset EQscalar-bundle)
(ruleset EQscalar-slots)
(ruleset EQscalar-pool)
(ruleset EQscalar-witness)
(ruleset EQscalar-assignment)
(ruleset EQscalar-legality)
(ruleset EQscalar-edits)

(rule ((EQInvocation invocation entry) (Within entry owner) (= owner (RegionOwner region)))
      ((EQInvocation invocation owner)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation owner) (= owner (RegionOwner region)) (= (Mode region) (Graph)))
      ((EQScalarFrame region owner region)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation owner) (= owner (RegionOwner region)) (= (Mode region) (CFG))
       (= region (BlockRegion block)))
      ((EQScalarFrame block owner region)) :ruleset EQscalar-scope)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph)) (OpRegion op region))
      ((EQScalarBody root region op)) :ruleset EQscalar-scope)
(rule ((EQScalarFrame root owner region) (= (Mode region) (CFG)) (BlockMember root order op))
      ((EQScalarBody root region op)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (EQScalarSupported root op value) (= input (Operand op slot)))
      ((EQScalarUsed root input)) :ruleset EQscalar-scope)
(rule ((EQScalarTuple root op tuple) (= input (Operand op slot)))
      ((EQScalarUsed root input)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (= (Mode region) (CFG)) (= (OpKind op) "scf.ordered_for"))
      ((EQScalarOrderedConsumer root op)) :ruleset EQscalar-scope)
(rule ((EQScalarOrderedConsumer root op) (Result op slot value))
      ((EQScalarOrderedResult root value)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (HasInterface op "dyn tir::interfaces::Terminator"))
      ((EQScalarTerminator op)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (EQScalarTerminator op) (= input (Operand op slot))
       (EQScalarNumericType (ValueType input)))
      ((EQScalarUsed root input)) :ruleset EQscalar-scope)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph)) (= input (Yield region slot)))
      ((EQScalarUsed root input)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (> width (from-string "0")))
      ((EQScalarNumericType ty)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.f") (TCons (NatLit exponent) (TCons (NatLit mantissa) (TNil))))))
      ((EQScalarNumericType ty)) :ruleset EQscalar-scope)
(rule ((EQScalarFrame root owner region) (= (Mode region) (CFG))
       (EQScalarUsed root value) (EQScalarNumericType (ValueType value))
       (not (EQScalarSupported root op value)) (not (EQScalarLeaf root op value))
       (not (EQScalarTuple root op value)))
      ((EQScalarParam root value)) :ruleset EQscalar-check)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph))
       (RegionParam region slot value) (EQScalarUsed root value) (EQScalarNumericType (ValueType value)))
      ((EQScalarParam root value)) :ruleset EQscalar-check)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph)) (= region (BlockRegion block))
       (BlockParam block slot value) (EQScalarUsed root value) (EQScalarNumericType (ValueType value)))
      ((EQScalarParam root value)) :ruleset EQscalar-check)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph))
       (EQScalarUsed root value) (RegionParam outer slot value) (OpUnderRegion outer owner)
       (EQScalarNumericType (ValueType value)))
      ((EQScalarParam root value)) :ruleset EQscalar-check)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph))
       (OpRegion op outer) (= (Mode outer) (Graph)) (OpUnderRegion outer owner)
       (= (OpKind op) "builtin.constant") (EQCanSpeculate op)
       (not (HasInterface op "dyn tir::interfaces::ResourceEffects"))
       (not (OwnedRegion op slot nested))
       (Result op 0 value) (not (Result op 1 extra)) (not (Operand op slot input))
       (= (Attribute op "value") (IntegerAttr (Ctor meaning) storage bits))
       (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (= normalized (eqsat-int-bits width meaning bits)) (EQScalarType root ty))
      ((EQScalarParam root value)) :ruleset EQscalar-check)
(rule ((EQScalarBody root region op) (= kind (OpKind op)) (EQConstructor name kind 1)
       (Implements kind "dyn tir::interfaces::SameOperandAndResultType")
       (Implements kind "dyn tir::interfaces::Speculatable")
       (Result op 0 value) (not (Result op 1 extra)) (EQScalarNumericType (ValueType value))
       (= x (Operand op 0)) (not (Operand op 1 extra))
       (= (ValueType x) (ValueType value)) (not (Attribute op key)))
      ((EQScalarSupported root op value)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (= kind (OpKind op)) (EQConstructor name kind 2)
       (Implements kind "dyn tir::interfaces::Speculatable")
       (Result op 0 value) (not (Result op 1 extra)) (EQScalarNumericType (ValueType value))
       (= x (Operand op 0)) (= y (Operand op 1)) (not (Operand op 2 extra))
       (EQScalarNumericType (ValueType x)) (EQScalarNumericType (ValueType y)) (not (Attribute op key)))
      ((EQScalarSupported root op value)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (= (OpKind op) "builtin.constant")
       (Result op 0 value) (not (Result op 1 extra)) (EQScalarNumericType (ValueType value))
       (not (Operand op slot extra))
       (= (Attribute op "value") (IntegerAttr (Ctor meaning) storage bits))
       (= ty (ValueType value)) (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (= normalized (eqsat-int-bits width meaning bits)))
      ((EQScalarSupported root op value)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (= kind (OpKind op)) (!= kind "builtin.constant")
       (Implements kind "dyn tir::interfaces::ConstantLike")
       (Implements kind "dyn tir::interfaces::Speculatable")
       (Result op 0 value) (not (Result op 1 extra)) (EQScalarNumericType (ValueType value))
       (not (Operand op slot input)))
      ((EQScalarLeaf root op value)) :ruleset EQscalar-scope)
(rule ((EQScalarBody root region op) (= (OpKind op) "builtin.make_tuple")
       (Result op 0 value) (not (Result op 1 extra)))
      ((EQScalarTuple root op value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (ValueAttr value))) ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (AssignedRegisterAttr value name bank index)))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (ListAttr items)) (AttrItem items slot child) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (DictAttr items)) (DictItem items key child) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (FpSemanticsAttr child)) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (EvaluationContractAttr child)) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (LayoutOptionAttr key child)) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (LayoutSpecAttr first second)) (AttrItem first slot child) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (LayoutSpecAttr first second)) (AttrItem second slot child) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (LayoutEntryAttr a first b c second)) (AttrItem first slot child) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)
(rule ((EQInvocation invocation root) (= attr (LayoutEntryAttr a first b c second)) (AttrItem second slot child) (EQScalarAttrRef child value))
      ((EQScalarAttrRef attr value)) :ruleset EQscalar-scope)

(rule ((EQScalarSupported root op value) (= ty (ValueType value)))
      ((EQScalarType root ty)) :ruleset EQscalar-check)
(rule ((EQScalarLeaf root op value) (= ty (ValueType value)))
      ((EQScalarType root ty)) :ruleset EQscalar-check)
(rule ((EQScalarParam root value) (= ty (ValueType value)))
      ((EQScalarType root ty)) :ruleset EQscalar-check)
(rule ((EQScalarType root first) (EQScalarType root second) (!= first second))
      ((EQScalarBad root)) :ruleset EQscalar-validate)

(rule ((EQScalarSupported root op value) (= attr (Attribute reader key)) (EQScalarAttrRef attr value))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarSupported root op value) (= attr (BlockAttribute reader key)) (EQScalarAttrRef attr value))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarTuple root op value) (= attr (Attribute op key)) (!= key "operand_segment_sizes"))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarBody root region op) (= (OpKind op) "builtin.constant")
       (= attr (Attribute op key)) (!= key "value"))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarBody root region op) (not (EQScalarOrderedConsumer root op)) (not (EQScalarSupported root op value))
       (!= (OpKind op) "ptr.store")
       (!= (OpKind op) "state.entry_state")
       (not (EQScalarLeaf root op value))
       (not (EQScalarTuple root op tuple)) (not (EQScalarTerminator op)))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarBody root region op) (= (Mode region) (Graph)) (EQScalarTerminator op)
       (= attr (Attribute op key)) (!= key "operand_segment_sizes"))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarFrame root owner region) (= (OpKind owner) "func.func") (= attr (Attribute owner key)) (!= key "sym_name") (!= key "ret_type"))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarBody root region op) (not (EQScalarOrderedConsumer root op)) (= op (RegionOwner nested)))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarSupported root first value) (EQScalarSupported root second other) (!= first second))
      ((EQScalarMultipleOps root)) :ruleset EQscalar-check)
;; Single-operation arms retain equal-cost per-operation constant materialization.
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph))
       (= owner (RegionOwner other)) (!= other region) (not (EQScalarMultipleOps root)))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarOrderedConsumer root owner) (Result owner slot value)
       (EQScalarParam root value) (not (EQOrderedCarrier owner value outer)))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarUsed root value) (= ty (ValueType value)) (not (EQScalarNumericType ty))
       (not (EQScalarTuple root consumer value)))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
(rule ((EQScalarFrame root owner region) (= (Mode region) (Graph)) (EQScalarUsed root value)
       (not (EQScalarSupported root def value)) (not (EQScalarLeaf root def value))
       (not (EQScalarParam root value)) (not (EQScalarTuple root consumer value)))
      ((EQScalarBad root)) :ruleset EQscalar-validate)
;; Reject malformed source availability before reusing any slots.
(rule ((EQScalarBody root region op) (= input (Operand op slot)) (Result producer index input)
       (= (OpPlacement producer) (InBlock block before)) (= (OpPlacement op) (InBlock block after)) (>= before after))
      ((EQScalarBad root)) :ruleset EQscalar-validate)

(rule ((EQScalarFrame root owner region) (EQScalarSupported root op value)
       (not (EQScalarBad root)) (EQScalarType root ty))
      ((EQScalarPure root region ty) (EQScopeRecord root)) :ruleset EQscalar-complete)
;; Explicit collection inputs retain their SSA identity across block boundaries.
(rule ((EQSeed root) (EQScalarPure root region ty) (EQScalarParam root value)
       (not (EQScalarOrderedResult root value)))
      ((union (EQInput value) (EQArg ty value)) (EQNeeded value)) :ruleset EQscalar-complete)
(rule ((EQSeed root) (EQScalarPure root region ty) (EQScalarLeaf root op value))
      ((union (EQInput value) (EQArg ty value))) :ruleset EQscalar-complete)
(rule ((EQSeed root) (EQScalarPure root region ty) (EQScalarSupported root op value))
      ((EQUse root op)) :ruleset EQscalar-complete)
(rule ((EQSeed root) (EQScalarPure root region ty) (= root region) (= (Mode region) (Graph)))
      ((EQYieldUse root region)) :ruleset EQscalar-complete)
(rule ((EQSeed root) (EQScalarPure root region ty) (EQScalarSupported root op value) (= (OpPlacement op) (InBlock block order)))
      ((EQScalarPool root op value order)) :ruleset EQscalar-complete)
(rule ((EQSeed root) (EQScalarPure root region ty) (EQScalarSupported root op value) (= (OpPlacement op) (InGraph region)))
      ((EQScalarPool root op value op)) :ruleset EQscalar-complete)
(rule ((EQScalarPure root region ty) (EQScalarSupported root op value)
       (= value (Operand consumer slot)) (not (EQScalarSupported root consumer result)))
      ((EQScalarPort root consumer slot value consumer)) :ruleset EQscalar-ports)
(rule ((EQScalarPure root region ty) (EQScalarTuple root consumer tuple)
       (= value (Operand consumer slot)))
      ((EQScalarPort root consumer slot value consumer)) :ruleset EQscalar-ports)
(rule ((EQScalarPure root region ty) (EQScalarBody root region consumer)
       (EQScalarTerminator consumer) (= value (Operand consumer slot)) (EQScalarNumericType (ValueType value)))
      ((EQScalarPort root consumer slot value consumer)) :ruleset EQscalar-ports)
(rule ((EQScalarPure root region ty) (= root region) (= (Mode region) (Graph))
       (= value (Yield region slot)) (EQScalarNumericType (ValueType value)))
      ((EQScalarYieldPort root region slot value) (EQScalarPort root region slot value region)) :ruleset EQscalar-ports)
(rule ((EQScalarPure root region ty) (EQScalarSupported root op value)
       (= value (Yield consumer slot)) (!= consumer root))
      ((EQScalarPort root consumer slot value consumer)) :ruleset EQscalar-ports)
(rule ((EQScalarPortCount root count)) ((set (EQScalarTail root count) (EQONil))) :ruleset EQscalar-bundle)
(rule ((EQScalarPortRank root consumer slot value rank count)
       (= term (EQInput value)) (= tail (EQScalarTail root (+ rank 1))))
      ((set (EQScalarTail root rank) (EQOCons term tail))) :ruleset EQscalar-bundle)
(rule ((= tail (EQScalarTail root 0))) ((set (EQScalarBundle root) tail)) :ruleset EQscalar-bundle)
(rule ((EQScalarPool root op value key) (EQScalarPort root consumer slot old portkey)
       (= (OpPlacement op) (InBlock block order)) (= (OpPlacement consumer) (InBlock block limit)) (>= order limit))
      ((EQScalarBadSlot root op)) :ruleset EQscalar-slots)
(rule ((EQScalarPool root op value key) (not (EQScalarBadSlot root op)))
      ((EQScalarSafePool root op value key)) :ruleset EQscalar-pool)

(rule ((EQSeed root) (EQScalarPure root region ty) (EQConstructor name kind arity)) ((EQScalarCostRequest name kind)) :ruleset EQscalar-complete)
(rule ((EQSeed root) (EQScalarPure root region ty))
      ((EQScalarCostRequest "EQConstant" "builtin.constant")
       (EQScalarCtorCost "EQOpaque" 9223372036854775807)) :ruleset EQscalar-complete)
(rule ((EQScalarCostRequest name kind) (EQScalarWeight kind weight))
      ((EQScalarCtorCost name weight)) :ruleset EQscalar-witness)
(rule ((EQScalarPoolCount root count)) ((set (EQScalarPoolCost root 0) 0)) :ruleset EQscalar-witness)
(rule ((EQScalarPoolRank root op value rank count) (= kind (OpKind op)) (EQScalarWeight kind weight)
       (= previous (EQScalarPoolCost root rank)))
      ((set (EQScalarPoolCost root (+ rank 1)) (+ previous weight))) :ruleset EQscalar-witness)

(rule ((EQScalarWitness root top expected cost)) ((EQScalarChosenTail root 0 top)) :ruleset EQscalar-witness)
(rule ((EQScalarChosenTail root slot node) (EQScalarWitnessCtor root node "EQOCons")
       (EQScalarWitnessChild root node 0 value) (EQScalarWitnessChild root node 1 next))
      ((EQScalarChosenOutput root slot value) (EQScalarChosenTail root (+ slot 1) next)) :ruleset EQscalar-witness)
(rule ((EQScalarWitnessCtor root node name) (EQConstructor name kind arity)
       (>= arity 1) (<= arity 2))
      ((EQScalarChosenOp root node node) (EQScalarDecoded root node kind)) :ruleset EQscalar-witness)
(rule ((EQScalarWitnessCtor root node "EQConstant"))
      ((EQScalarChosenOp root node node) (EQScalarDecoded root node "builtin.constant")) :ruleset EQscalar-witness)
(rule ((EQScalarWitness root top expected cost) (EQScalarChosenOp root node key)
       (EQScalarWitnessChild root node 0 actual) (!= actual expected))
      ((EQScalarInvalid root)) :ruleset EQscalar-witness)
(rule ((EQScalarWitnessCtor root node "EQOpaque")) ((EQScalarInvalid root)) :ruleset EQscalar-witness)
(rule ((EQScalarWitness root top expected cost) (EQScalarWitnessCtor root node "EQArg")
       (EQScalarWitnessChild root node 0 expected) (EQScalarWitnessChild root node 1 lit)
       (EQScalarWitnessInt root lit value) (EQScalarParam root value))
      ((EQScalarInputWitness root node value)) :ruleset EQscalar-witness)
(rule ((EQScalarWitness root top expected cost) (EQScalarWitnessCtor root node "EQArg")
       (EQScalarWitnessChild root node 0 expected) (EQScalarWitnessChild root node 1 lit)
       (EQScalarWitnessInt root lit value) (EQScalarLeaf root op value)
       (EQScalarPure root region ty) (= ty (ValueType value)))
      ((EQScalarInputWitness root node value)) :ruleset EQscalar-witness)
(rule ((EQScalarInputWitness root node value))
      ((EQScalarMaterial root node value)) :ruleset EQscalar-assignment)
(rule ((EQScalarWitnessCtor root node "EQArg") (not (EQScalarInputWitness root node value)))
      ((EQScalarInvalid root)) :ruleset EQscalar-assignment)
(rule ((EQScalarSourceRank root op value slot slots) (EQScalarNodeRank root node rank nodes)
       (<= nodes slots) (= slot rank))
      ((EQScalarAssigned root node op value) (EQScalarMaterial root node value)) :ruleset EQscalar-assignment)
(rule ((EQScalarAssigned root node op value) (EQScalarWitnessChild root node slot child)
       (> slot 0) (EQScalarMaterial root child input) (Result producer index input)
       (= (OpPlacement producer) (InBlock block before)) (= (OpPlacement op) (InBlock block after)) (>= before after))
      ((EQScalarInvalid root)) :ruleset EQscalar-assignment)
(rule ((EQScalarChosenOutput root rank node) (EQScalarMaterial root node value) (Result producer index value)
       (EQScalarPortRank root consumer slot old rank count) (= (OpPlacement producer) (InBlock block before))
       (= (OpPlacement consumer) (InBlock block after)) (>= before after))
      ((EQScalarInvalid root)) :ruleset EQscalar-assignment)
(rule ((EQScalarChosenOutput root rank node) (EQScalarMaterial root node value)
       (EQScalarPortRank root consumer slot old rank count) (!= old value)
       (not (EQScalarBody root region consumer)) (not (EQScalarYieldPort root consumer slot old)))
      ((EQScalarInvalid root)) :ruleset EQscalar-assignment)
(rule ((EQScalarWitness root top expected cost) (EQScalarPoolCount root count) (= physical (EQScalarPoolCost root count))
       (< cost physical) (EQScalarNodeCount root nodes) (EQScalarSourceCount root slots) (<= nodes slots)
       (not (EQScalarInvalid root)))
      ((EQScalarReady root)) :ruleset EQscalar-legality)

(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty))
      ((EQScalarAuthorized (EQProposal invocation owner root owner))) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarPool root op value key) (not (EQScalarAssigned root node op value)))
      ((let p (EQProposal invocation owner root owner))
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op)
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarPool root op value key) (= child (Operand op slot)))
      ((EQEraseOperand (EQProposal invocation owner root owner) op slot)) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarPool root op value key) (= attr (Attribute op name)))
      ((EQEraseAttribute (EQProposal invocation owner root owner) op name)) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarAssigned root node op value) (EQScalarDecoded root node kind))
      ((EQPutOpKind (EQProposal invocation owner root owner) op kind)) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarAssigned root node op value) (EQScalarWitnessCtor root node "EQConstant")
       (EQScalarWitnessChild root node 1 literal) (EQScalarWitnessString root literal normalized)
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (<= width (from-string "64")))
      ((EQPutAttribute (EQProposal invocation owner root owner) op "value"
         (IntegerAttr (Ctor "$attr.signed") 64 (eqsat-storage-bits normalized)))) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarAssigned root node op value) (EQScalarWitnessCtor root node "EQConstant")
       (EQScalarWitnessChild root node 1 literal) (EQScalarWitnessString root literal normalized)
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (> width (from-string "64")))
      ((EQPutAttribute (EQProposal invocation owner root owner) op "value"
         (IntegerAttr (Ctor "$attr.wide") (eqsat-storage-width normalized) (eqsat-storage-bits normalized)))) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarAssigned root node op value) (EQScalarWitnessCtor root node name) (EQConstructor name kind arity)
       (>= arity 1) (<= arity 2)
       (EQScalarWitnessChild root node slot child) (> slot 0) (EQScalarMaterial root child input))
      ((EQPutOperand (EQProposal invocation owner root owner) op (- slot 1) input)) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarChosenOutput root rank node) (EQScalarMaterial root node value) (EQScalarPortRank root consumer slot old rank count)
       (EQScalarBody root region consumer))
      ((EQPutOperand (EQProposal invocation owner root owner) consumer slot value)) :ruleset EQscalar-edits)
(rule ((EQScalarReady root) (EQScalarFrame root owner region) (EQInvocation invocation owner) (EQScalarPure root region ty)
       (EQScalarChosenOutput root rank node) (EQScalarMaterial root node value) (EQScalarPortRank root region slot old rank count)
       (EQScalarYieldPort root region slot old))
      ((EQPutYield (EQProposal invocation owner root owner) region slot value)) :ruleset EQscalar-edits)

;; A rejected region can still reuse one operation's slot for a cheaper term.
(rule ((EQRoot entry) (Within entry op) (EQScalarFrame region owner region)
       (= (Mode region) (Graph)) (EQScalarBad region) (OpRegion op region)
       (EQScalarSupported region op value) (Implements (OpKind op) "dyn tir::interfaces::SameOperandAndResultType")
       (not (EQScalarAttrRef attr value)) (= ty (ValueType value)))
      ((EQScalarFrame op owner region) (EQScalarBody op region op)
       (EQScalarSupported op op value) (EQScalarPure op region ty)
       (EQScopeRecord op)) :ruleset EQscalar-complete)
(rule ((EQScalarFrame op owner region) (!= op region) (EQScalarSupported op op value)
       (= input (Operand op slot)) (= ty (ValueType value)) (= ty (ValueType input)))
      ((EQScalarParam op input)) :ruleset EQscalar-complete)
