pub use std::ir::integer_width;
pub use std::ir::type_argument;
pub use std::ir::fp_format;

// IR entity IDs are nonnegative. A missing optional ID or slot is encoded as -1.
pub let Operation: { id: std::ir::OperationId, kind: std::ir::OperationKind, placement: String, container: Int, position: Int, display: Int, location: Int } -> Prop;
pub let Region: (Int, String, std::ir::OperationId, Int, Int) -> Prop; // id, mode, owner, slot, entry
pub let Block: (Int, Int, Int) -> Prop; // id, region, layout
pub let Value: (std::ir::ValueId, Int, String, Int, Int, Int) -> Prop; // id, type, definition kind, owner, slot, declared type
pub let Operand: std::Table<(std::ir::OperationId, Int), std::ir::ValueId, std::Merge::Unique>;
pub let Yield: std::Table<(Int, Int), std::ir::ValueId, std::Merge::Unique>;
pub let Successor: std::Table<(std::ir::OperationId, Int), Int, std::Merge::Unique>;
pub let SuccessorArgument: std::Table<(std::ir::OperationId, Int, Int), Int, std::Merge::Unique>;
pub let Attribute: std::Table<(String, Int, String), Int, std::Merge::Unique>; // owner kind, owner, name, typed attribute handle
pub let Binding: std::Table<(Int, String, Int), Int, std::Merge::Unique>; // region, role, from slot, to slot
pub let Control: (std::ir::OperationId, Bool, Int, Bool, Int, Int, String) -> Prop; // operation, gamma present, selector slot, theta present, body, predicate slot, continuation polarity
pub let Arm: std::Table<(std::ir::OperationId, Bool, String), Int, std::Merge::Unique>; // operation, default flag, canonical case integer, region
// Payload handles identify immutable values interned by this engine.
pub let TypeTerm: (Int, Int, Int) -> Prop; // type ID, constructor ID, interned arguments
pub let TypeCtor: (Int, String, String, Int, Int) -> Prop; // constructor ID, dialect, name, declaration, default
pub let Symbol: (Int, String, Int, Int) -> Prop; // symbol ID, spelling, optional type-name entity, kind
// The -1 key identifies the declaration. Other keys identify Rust interface types.
pub let OpSpec: std::Table<(std::ir::OperationKind, Int), Int, std::Merge::Unique>;

pub let result = fn (value: std::ir::ValueId, ty: Int, owner: std::ir::OperationId, slot: Int, declared: Int) -> Prop {
    Value(value, ty, "result", std::ir::raw_operation_id(owner), slot, declared)
};
pub let operation_attribute = fn (owner: std::ir::OperationId, name: String, attr: Int) -> Prop {
    Attribute("operation", std::ir::raw_operation_id(owner), name, attr)
};


pub let CyclePath: (Int, std::ir::OperationId, std::ir::OperationId) -> Prop; // graph, candidate start, reachable operation
pub let ReaderAt: (std::ir::OperationId, Int, std::ir::OperationId) -> Prop; // reader, enclosing region, immediate member
pub let DependsOn: (Int, std::ir::OperationId, std::ir::OperationId) -> Prop; // graph, consumer, immediate producer
pub let Bypass: (Int, Int, Int) -> Prop; // CFG region, avoided defining block, reachable block
pub mod structure {
    pub let graph<operation, kind, region, position, display, location>:
        Operation{ id: operation, kind: kind, placement: "graph", container: region, position: position, display: display, location: location }() -> ReaderAt(operation, region, operation);
    pub let cfg<operation, kind, block, position, display, location, region, layout>:
        (
            Operation{ id: operation, kind: kind, placement: "block", container: block, position: position, display: display, location: location }(),
            Block(block, region, layout)
        ) -> ReaderAt(operation, region, operation);
    pub let lift<reader, region, member, mode, parent, region_slot, entry, outer, representative>:
        (
            ReaderAt(reader, region, member),
            Region(region, mode, parent, region_slot, entry),
            ReaderAt(parent, outer, representative)
        ) -> ReaderAt(reader, outer, representative);
    pub let operand_dep<operation, slot, value, ty, producer, result_slot, declared, region, sibling, kind, position, display, location>:
        (
            Operand(operation, slot, value),
            result(value, ty, producer, result_slot, declared),
            ReaderAt(operation, region, sibling),
            Operation{ id: producer, kind: kind, placement: "graph", container: region, position: position, display: display, location: location }()
        ) -> DependsOn(region, sibling, producer);
    pub let yield_dep<inner, slot, value, mode, operation, region_slot, entry, ty, producer, result_slot, declared, region, sibling, kind, position, display, location>:
        (
            Yield(inner, slot, value),
            Region(inner, mode, operation, region_slot, entry),
            result(value, ty, producer, result_slot, declared),
            ReaderAt(operation, region, sibling),
            Operation{ id: producer, kind: kind, placement: "graph", container: region, position: position, display: display, location: location }()
        ) -> DependsOn(region, sibling, producer);
}
pub mod flow {
    pub let start<region, start_op, next_op>:
        (
            DependsOn(region, start_op, next_op),
            std::ir::operation_ids::less(next_op, start_op) == false
        ) -> CyclePath(region, start_op, next_op);
    pub let path<region, start_op, next_op, end_op>:
        (
            CyclePath(region, start_op, next_op),
            DependsOn(region, next_op, end_op)
        ) -> CyclePath(region, start_op, end_op);
    pub let avoid_param<operation, kind, use_block, position, display, location, slot, value, ty, definition, result_slot, declared, region, layout, other_layout, mode, owner, region_slot, entry>:
        (
            Operation{ id: operation, kind: kind, placement: "block", container: use_block, position: position, display: display, location: location }(),
            Operand(operation, slot, value),
            Value(value, ty, "block", definition, result_slot, declared),
            Block(use_block, region, layout),
            Block(definition, region, other_layout),
            Region(region, mode, owner, region_slot, entry),
            use_block != definition,
            definition != entry,
            std::int::less(entry, 0) == false
        ) -> Bypass(region, definition, entry);
    pub let avoid_result<operation, kind, use_block, position, display, location, slot, value, ty, producer, result_slot, declared, producer_kind, definition, producer_pos, producer_display, producer_location, region, layout, other_layout, mode, owner, region_slot, entry>:
        (
            Operation{ id: operation, kind: kind, placement: "block", container: use_block, position: position, display: display, location: location }(),
            Operand(operation, slot, value),
            result(value, ty, producer, result_slot, declared),
            Operation{ id: producer, kind: producer_kind, placement: "block", container: definition, position: producer_pos, display: producer_display, location: producer_location }(),
            Block(use_block, region, layout),
            Block(definition, region, other_layout),
            Region(region, mode, owner, region_slot, entry),
            use_block != definition,
            definition != entry,
            std::int::less(entry, 0) == false
        ) -> Bypass(region, definition, entry);
    pub let bypass<region, definition, current, terminator, kind, position, display, location, layout, slot, target, other_layout>:
        (
            Bypass(region, definition, current),
            Block(current, region, layout),
            Operation{ id: terminator, kind: kind, placement: "block", container: current, position: position, display: display, location: location }(),
            Successor(terminator, slot, target),
            Block(target, region, other_layout),
            target != definition
        ) -> Bypass(region, definition, target);
}


pub let index = std::schedule::Schedule::Rules((structure, flow));

pub let derive_structure = std::schedule::saturate(structure);
pub let derive_flow = std::schedule::saturate(flow);
