(relation EQCFGBlock (i64 i64))
(relation EQCFGEdge (i64 i64 i64 i64 i64))
(relation EQCFGReachable (i64 i64))
(relation EQCFGMultipleIncoming (i64))
(relation EQCFGContextConsumer (i64 i64))
(relation EQCFGCondition (i64 i64 String))
(relation EQCFGComparison (i64 i64 i64 String))
(relation EQCFGRewriteBlocked (i64 i64))
(relation EQCFGBranchExtra (i64))
(relation EQCFGBranchBlocked (i64))
(relation EQCFGDecision (i64 i64 i64 i64))
;; The library defines scopes, bindings and consumers. The driver sees only
;; ScopeRecord, ParentRecord and Seed; it does not inspect operation kinds.
(relation EQBaseNeeded (i64))
(relation EQConstantFact (i64 TypeExpr String String))
(relation EQTotalValue (i64))
(relation EQScopedAuthorized (EQPlan))
(relation EQComparisonExtraShape (i64))
(relation EQOrderedCarrierBlocked (i64))
(relation EQScalarManagedOp (i64))
(relation EQExactReplacement (i64 i64 i64))
(relation EQFinalReplacement (i64 i64 i64))
(rule ((EQExactReplacement scope old new) (not (EQExactReplacement scope new next)))
      ((EQFinalReplacement scope old new)) :ruleset EQproject)
(rule ((EQExactReplacement scope old middle) (EQFinalReplacement scope middle new))
      ((EQFinalReplacement scope old new)) :ruleset EQproject)
(rule ((EQScalarPure scope region ty) (EQScalarSupported scope op value) (!= scope op))
      ((EQScalarManagedOp op)) :ruleset EQscalar-ports)
;; Keep reusable constant slots while ordered carrier proofs are pending.
(rule ((EQScalarFrame root owner region) (= (Mode region) (CFG))
       (EQScalarOrderedConsumer root consumer) (EQScalarSupported root op value)
       (= (OpKind op) "builtin.constant"))
      ((EQScalarManagedOp op) (EQScopeRecord region) (EQUse region op)) :ruleset EQscalar-ports)
(rule ((EQScalarPort root consumer slot old key)
       (EQScopedAuthorized plan) (EQEraseOpKind plan consumer))
      ((EQScalarInvalid root)) :ruleset EQscalar-assignment)
(ruleset EQclearfacts)
(ruleset EQbase-needed)
(ruleset EQfacts)
(ruleset EQscopes)
(ruleset EQassumptions)
(ruleset EQscoped-edits)
(ruleset EQexact-edits)
(ruleset EQplanned-erases)
(relation EQErasedOp (i64))
(rule ((EQScopedAuthorized p) (EQEraseOpKind p op)) ((EQErasedOp op)) :ruleset EQplanned-erases)
(rule ((EQScalarAuthorized p) (EQEraseOpKind p op)) ((EQErasedOp op)) :ruleset EQplanned-erases)

(rule ((EQBaseNeeded value)) ((delete (EQBaseNeeded value))) :ruleset EQclearfacts)
(rule ((EQConstantFact value ty ones zeros))
      ((delete (EQConstantFact value ty ones zeros))) :ruleset EQclearfacts)
(rule ((EQRoot root) (Within root op) (Result op slot value))
      ((EQBaseNeeded value)) :ruleset EQbase-needed)
(rule ((EQRoot root) (Within root op) (= value (Operand op slot)))
      ((EQBaseNeeded value)) :ruleset EQbase-needed)
(rule ((EQBaseNeeded value) (Result op slot value) (= child (Operand op input)))
      ((EQBaseNeeded child)) :ruleset EQbase-needed)
(rule ((EQBaseNeeded value) (RegionParam region slot value) (EntryValue region slot outer))
      ((EQBaseNeeded outer)) :ruleset EQbase-needed)

(rule ((EQBaseNeeded value) (Result op 0 value) (= (OpKind op) "builtin.constant")
       (= (Attribute op "value") (IntegerAttr (Ctor meaning) storage bits))
       (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (= normalized (eqsat-int-bits width meaning bits)))
      ((EQConstantFact value ty normalized (eqsat-bits-not width normalized))) :ruleset EQfacts)
;; Graph rewrites may discard a value only when evaluating it cannot fault.
;; Region and block parameters have already been materialized by their callers.
(rule ((EQRoot root) (Within root owner) (= owner (RegionOwner region))
       (RegionParam region slot value))
      ((EQTotalValue value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root owner) (= owner (RegionOwner region))
       (= region (BlockRegion block)) (BlockParam block slot value))
      ((EQTotalValue value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (EQConstantFact value ty ones zeros))
      ((EQTotalValue value)) :ruleset EQscalar-scope)
(rule ((EQScalarSupported scope op value) (EQCanSpeculate op)
       (= input (Operand op 0)) (not (Operand op 1 extra)) (EQTotalValue input))
      ((EQTotalValue value)) :ruleset EQscalar-scope)
(rule ((EQScalarSupported scope op value) (EQCanSpeculate op)
       (= first (Operand op 0)) (= last (Operand op 1)) (not (Operand op 2 extra))
       (EQTotalValue first) (EQTotalValue last))
      ((EQTotalValue value)) :ruleset EQscalar-scope)

(rule ((EQSeed scope) (EQConstantFact value ty ones zeros))
      ((set (EQKnownOnes (EQInput value)) ones)
       (set (EQKnownZeros (EQInput value)) zeros)
       (EQDefined (EQInput value))) :ruleset EQproject)

(rule ((EQSeed scope) (EQNeeded value) (Result op 0 value)
       (= (OpKind op) "fp.constant"))
      ((EQDefined (EQInput value))) :ruleset EQproject)

(rule ((EQRoot root) (Within root op) (OpRegion op region)
       (= owner (RegionOwner region)) (not (EQScalarPure region region ty)) (not (EQScalarManagedOp op)))
      ((EQScopeRecord region) (EQUse region op)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root owner) (= owner (RegionOwner region))
       (not (EQScalarPure region region ty)))
      ((EQScopeRecord region) (EQYieldUse region region)) :ruleset EQscopes)
(rule ((EQScalarPure block region ty) (!= block region))
      ((EQScopeRecord region) (EQParentRecord block region)) :ruleset EQscopes)
(rule ((EQRoot root) (= owner (RegionOwner region)) (EQScopeRecord region)
       (OpRegion owner parent) (EQScopeRecord parent))
      ((EQParentRecord region parent)) :ruleset EQscopes)
;; Entry values of carried ports describe only the first iteration.
(rule ((EQScopeRecord region) (EntryValue region slot outer) (RegionParam region slot local)
       (not (FeedbackBinding region slot)))
      ((EQBind region local outer)) :ruleset EQscopes)

;; Exact port identity proves the inductive step independently of EQInput
;; equalities. Definedness still comes only from the entry value's facts.
(rule ((EQScopeRecord region) (Theta owner) (= region (ThetaBody owner))
       (EntryValue region slot outer) (RegionParam region slot local)
       (FeedbackValue region slot local)
       (= ty (ValueType local)) (= ty (ValueType outer))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))))
      ((EQBind region local outer)) :ruleset EQscopes)

;; Equal direct constants establish both the initial and feedback values.
(rule ((EQRoot root) (Within root owner) (Theta owner)
       (= region (ThetaBody owner)) (EQScopeRecord region)
       (EntryValue region slot outer) (RegionParam region slot local)
       (FeedbackValue region slot feedback)
       (= ty (ValueType local))
       (EQConstantFact outer ty bits zeros) (EQConstantFact feedback ty bits zeros))
      ((EQBind region local outer)) :ruleset EQscopes)

;; A carried literal may be assumed only after its structural feedback proof.
(relation EQStableFeedback (i64 i64 i64))
(rule ((EQRoot root) (Within root owner) (Theta owner)
       (= body (ThetaBody owner)) (EQScopeRecord body)
       (EntryValue body port outer) (RegionParam body port local)
       (= ty (ValueType local)) (EQConstantFact outer ty bits zeros))
      ((EQStableFeedback body local local)) :ruleset EQscopes)
(rule ((EQRoot root) (EQStableFeedback body local local)
       (RegionParam body port local) (EntryValue body port outer)
       (= ty (ValueType local))
       (EQConstantFact outer ty bits zeros) (EQConstantFact value ty bits zeros))
      ((EQStableFeedback body local value)) :ruleset EQscopes)
(rule ((EQRoot root) (EQStableFeedback body local local)
       (Within root gamma) (OpUnderRegion body gamma) (Gamma gamma)
       (= (OpKind gamma) "scf.switch")
       (= first (GammaArm gamma (from-string "0"))) (= last (GammaDefaultArm gamma))
       (= first (OwnedRegion gamma 0)) (= last (OwnedRegion gamma 1))
       (not (OwnedRegion gamma 2 extra))
       (= (Mode first) (Graph)) (= (Mode last) (Graph))
       (Result gamma result value) (= (ValueType value) (ValueType local))
       (ExitValue first result a) (ExitValue last result b)
       (EQStableFeedback body local a) (EQStableFeedback body local b))
      ((EQStableFeedback body local value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root owner) (Theta owner)
       (= body (ThetaBody owner)) (EQScopeRecord body)
       (EntryValue body port outer) (RegionParam body port local)
       (FeedbackValue body port value) (EQStableFeedback body local value))
      ((EQBind body local outer)) :ruleset EQscopes)

;; Keep every selector on the loop's demanded controller path.
(relation EQFeedbackControl (i64 i64))
(rule ((EQRoot root) (Within root owner) (Theta owner)
       (= body (ThetaBody owner)) (= slot (ThetaPredicate owner))
       (= control (Yield body slot)))
      ((EQFeedbackControl body control)) :ruleset EQscopes)
(rule ((EQRoot root) (EQFeedbackControl body control) (Within root gamma)
       (Gamma gamma) (Result gamma result control) (= arm (OwnedRegion gamma index))
       (ExitValue arm result inner))
      ((EQFeedbackControl body inner)) :ruleset EQscopes)
(rule ((EQRoot root) (EQSeed scope) (EQBind body local outer) (EQStableFeedback body local local)
       (RegionParam body port local) (FeedbackValue body port feedback)
       (Result feedback_owner feedback_slot feedback) (Gamma feedback_owner))
      ((EQExactReplacement scope local outer)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQSeed scope) (EQBind body local outer)
       (RegionParam body port local) (FeedbackValue body port feedback)
       (Result feedback_owner feedback_slot feedback) (Gamma feedback_owner)
       (EQStableFeedback body local value) (!= value outer)
       (Result gamma result value) (Gamma gamma)
       (Result gamma controller control) (!= result controller)
       (EQFeedbackControl body control) (not (EQStableFeedback body local control)))
      ((EQExactReplacement scope value outer)) :ruleset EQassumptions)

;; Ordered loops carry the entry block's ports through scf.yield. Extra
;; blocks or nonlocal exits can supply a different result binding.
(rule ((EQRoot root) (Within root owner) (= (OpKind owner) "scf.ordered_for")
       (= region (OwnedRegion owner 0)) (= entry (Entry region))
       (= region (BlockRegion other)) (!= entry other))
      ((EQOrderedCarrierBlocked owner)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root owner) (= (OpKind owner) "scf.ordered_for")
       (= region (OwnedRegion owner 0)) (OpUnderRegion region exit)
       (HasInterface exit "dyn tir::interfaces::NonLocalExit"))
      ((EQOrderedCarrierBlocked owner)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root owner) (= (OpKind owner) "scf.ordered_for")
       (= region (OwnedRegion owner 0))
       (= region (BlockRegion block)) (BlockMember block order term)
       (HasInterface term "dyn tir::interfaces::Terminator")
       (BlockMember block later next) (< order later))
      ((EQOrderedCarrierBlocked owner)) :ruleset EQscalar-scope)
;; Ordered parents keep evaluating the loop after a result is redirected.
(rule ((EQRoot root) (Within root owner) (= (OpKind owner) "scf.ordered_for")
       (not (EQOrderedCarrierBlocked owner))
       (= region (OwnedRegion owner 0)) (= block (Entry region))
       (Result owner slot value) (> slot 0) (= outer (Operand owner slot))
       (BlockParam block slot local) (BlockMember block order latch)
       (= (OpKind latch) "scf.yield") (= local (Operand latch (- slot 1)))
       (= ty (ValueType local)) (= ty (ValueType outer)) (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))))
      ((EQOrderedCarrier owner value outer)) :ruleset EQscalar-check)
(rule ((EQSeed scope) (EQUse scope owner) (= (Mode scope) (CFG))
       (EQOrderedCarrier owner value outer))
      ((union (EQInput value) (EQInput outer))) :ruleset EQassumptions)

;; Project collects every incoming edge before rewrite tests the complete set.
;; Entry parameters also receive implicit function inputs and cannot be inferred.
(sort EQCFGInputs (Set EQTerm))
(function EQCFGIncoming (i64) EQCFGInputs :merge (set-union old new))
(relation EQCFGParam (i64 i64 i64 i64))
(relation EQCFGBadIncoming (i64))
(rule ((EQSeed region) (= (Mode region) (CFG)) (= region (BlockRegion block))
       (= entry (Entry region)) (!= entry block) (BlockParam block slot local))
      ((EQCFGParam region block slot local) (EQNeeded local)) :ruleset EQproject)
(rule ((EQSeed region) (EQCFGParam region block slot local)
       (= block (Successor term edge)) (EdgeArgument term edge slot input))
      ((set (EQCFGIncoming local) (set-of (EQInput input))) (EQNeeded input)) :ruleset EQproject)
(rule ((EQSeed region) (EQCFGParam region block slot local)
       (= block (Successor term edge)) (not (EdgeArgument term edge slot input)))
      ((EQCFGBadIncoming local)) :ruleset EQproject)
(rule ((EQSeed region) (EQCFGParam region block slot local)
       (= block (Successor term edge)) (EdgeArgument term edge slot input)
       (= ty (ValueType local)) (not (ValueType input ty)))
      ((EQCFGBadIncoming local)) :ruleset EQproject)
(rule ((EQSeed region) (EQCFGParam region block slot local) (not (EQCFGBadIncoming local))
       (= inputs (EQCFGIncoming local)) (= (set-length inputs) 1) (= term (set-get inputs 0)))
      ((union (EQInput local) term)) :ruleset EQrewrite)
(rule ((EQSeed region) (EQCFGParam region block slot local))
      ((EQOutput local (EQInput local))) :ruleset EQoutput)
;; Equality does not make predecessor parameters available at the join.
;; A retained entry constant dominates the join and can witness its class.
(rule ((EQSeed region) (EQCFGParam region block slot local) (EQAvailable old local)
       (= entry (Entry region)) (BlockMember entry order constant)
       (= (OpKind constant) "builtin.constant") (Result constant 0 witness)
       (= (EQInput local) (EQInput witness)))
      ((EQAvailable old witness)) :ruleset EQoutput)

(relation EQBooleanArm (i64 i64 String))
(rule ((EQRoot root) (Within root gamma) (Gamma gamma) (= region (GammaArm gamma (from-string "1"))))
      ((EQBooleanArm gamma region "1")) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (Gamma gamma) (= region (GammaArm gamma (from-string "0"))))
      ((EQBooleanArm gamma region "0")) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (Gamma gamma) (= other (GammaArm gamma (from-string "0")))
       (= one (from-string "1")) (not (GammaArm gamma one)) (= region (GammaDefaultArm gamma)))
      ((EQBooleanArm gamma region "1")) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (Gamma gamma) (= other (GammaArm gamma (from-string "1")))
       (= zero (from-string "0")) (not (GammaArm gamma zero)) (= region (GammaDefaultArm gamma)))
      ((EQBooleanArm gamma region "0")) :ruleset EQscopes)

;; Reaching an equality arm defines its operands and identifies their values.
(rule ((EQRoot root) (Within root gamma) (Gamma gamma) (GammaSelector gamma predicate)
       (Result comparison 0 predicate) (= (OpKind comparison) "builtin.cmpi")
       (= (Attribute comparison "predicate") (PredicateAttr "eq"))
       (= x (Operand comparison 0)) (= y (Operand comparison 1))
       (EQBooleanArm gamma region "1")
       (= (ValueType predicate) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((EQAssume region x y)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (Gamma gamma) (GammaSelector gamma predicate)
       (Result comparison 0 predicate) (= (OpKind comparison) "builtin.cmpi")
       (= (Attribute comparison "predicate") (PredicateAttr "ne"))
       (= x (Operand comparison 0)) (= y (Operand comparison 1))
       (EQBooleanArm gamma region "0")
       (= (ValueType predicate) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((EQAssume region x y)) :ruleset EQscopes)
(rule ((EQSeed region) (EQBooleanArm gamma region bits) (GammaSelector gamma selector)
       (= ty (ValueType selector))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((union (EQInput selector) (EQConstant ty bits)) (EQDefined (EQInput selector))) :ruleset EQassumptions)

(rule ((EQSeed scope) (EQBind scope local outer))
      ((union (EQInput local) (EQInput outer))) :ruleset EQassumptions)
(rule ((EQSeed scope) (EQAssume scope x y))
      ((union (EQInput x) (EQInput y)) (EQDefined (EQInput x)) (EQDefined (EQInput y))) :ruleset EQassumptions)

;; Numeric information does not imply definedness. Poison propagation has a
;; separate conjunctive rule, and the guarded PDL rule requires definedness.
(rule ((EQNeeded value) (Result op 0 value) (= (OpKind op) "builtin.ori")
       (not (Attribute op key)) (= x (Operand op 0)) (= y (Operand op 1))
       (= a (EQKnownOnes (EQInput x))) (= b (EQKnownOnes (EQInput y))))
      ((set (EQKnownOnes (EQInput value)) (eqsat-bits-or a b))) :ruleset EQrewrite)
(rule ((EQNeeded value) (Result op 0 value) (= (OpKind op) "builtin.ori")
       (not (Attribute op key)) (= x (Operand op 0)) (= y (Operand op 1))
       (= a (EQKnownZeros (EQInput x))) (= b (EQKnownZeros (EQInput y))))
      ((set (EQKnownZeros (EQInput value)) (eqsat-bits-and a b))) :ruleset EQrewrite)
(rule ((EQNeeded value) (Result op 0 value) (= (OpKind op) "builtin.ori")
       (not (Attribute op key)) (= x (Operand op 0)) (= y (Operand op 1))
       (EQDefined (EQInput x)) (EQDefined (EQInput y)))
      ((EQDefined (EQInput value))) :ruleset EQrewrite)

;; popcount of the all-ones value encodes the integer width at that width.
(rule ((EQRoot root) (Within root op) (EQSeed scope) (EQUse scope op)
       (= (OpKind op) "builtin.shrsi") (EQCanSpeculate op)
       (EQScalarSupported scope op value)
       (= x (Operand op 0)) (= y (Operand op 1))
       (= (EQInput x) (EQConstant ty a)) (= (EQInput y) (EQConstant ty b))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (= zero (eqsat-int-bits width "$attr.signed" "0000000000000000"))
       (= width_bits (eqsat-int-eval "popcount" width (eqsat-bits-not width zero)))
       (= "1" (eqsat-int-eval "ult" width b width_bits))
       (= bits (eqsat-int-eval "ashr" width a b)))
      ((union (EQInput value) (EQConstant ty bits))) :ruleset EQrewrite)

;; Keep replacements as data until all semantic scope colors are discarded.
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.cmpi")
       (= attr (Attribute op key)) (!= key "predicate"))
      ((EQComparisonExtraShape op)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.cmpi")
       (Result op slot value) (!= slot 0))
      ((EQComparisonExtraShape op)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.cmpi")
       (= value (Operand op slot)) (!= slot 0) (!= slot 1))
      ((EQComparisonExtraShape op)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.cmpi")
       (= region (OwnedRegion op slot)))
      ((EQComparisonExtraShape op)) :ruleset EQscopes)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope)
       (EQUse scope op) (= (OpKind op) "builtin.cmpi") (not (EQComparisonExtraShape op))
       (Result op 0 value) (= (Attribute op "predicate") (PredicateAttr "slt"))
       (= lhs (Operand op 0)) (= rhs (Operand op 1))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil))))
       (> width (from-string "0"))
       (EQConstantFact lhs ty a az) (EQConstantFact rhs ty b bz)
       (= bits (eqsat-int-eval "lt" width a b)))
      ((let plan (EQProposal invocation root scope root))
       (EQScopedAuthorized plan) (EQPutOpKind plan op "builtin.constant")
       (EQEraseOperand plan op 0) (EQEraseOperand plan op 1)
       (EQEraseAttribute plan op "predicate")
       (EQPutAttribute plan op "value" (IntegerAttr (Ctor "$attr.signed") 64 (eqsat-storage-bits bits))))
      :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope)
       (EQUse scope owner) (= new (EQSelected old)) (= old (Operand owner slot)) (!= old new)
       (not (EQScalarPort frame owner slot old key)) (not (EQScalarManagedOp owner))
       (not (EQExactReplacement scope old input))
       (not (EQCFGContextConsumer scope owner))
       (not (EQCFGDecision scope owner edge dest))
       (not (EQCFGRewriteBlocked scope owner)))
      ((let plan (EQProposal invocation root scope root))
       (EQScopedAuthorized plan) (EQPutOperand plan owner slot new)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope)
       (EQYieldUse scope owner) (= new (EQSelected old)) (= old (Yield owner slot)) (!= old new)
       (not (EQScalarYieldPort frame owner slot old)) (not (EQExactReplacement scope old input)))
      ((let plan (EQProposal invocation root scope root))
       (EQScopedAuthorized plan) (EQPutYield plan owner slot new)) :ruleset EQscoped-edits)

;; A reached boolean arm defines the complementary comparison over the same
;; typed operands. The selector remains in place, including its poison behavior.
(relation EQComplementPredicate (String String))
(EQComplementPredicate "slt" "sge")
(EQComplementPredicate "sge" "slt")
(EQComplementPredicate "eq" "ne")
(EQComplementPredicate "ne" "eq")
(relation EQComplementArm (i64 i64 String))
(relation EQTypedComparison (i64 i64 String i64 i64))
(relation EQComplementValue (i64 i64 String))
(relation EQOutsideUse (i64))
(relation EQComplementConsumed (i64))
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.xori")
       (Result op 0 value) (= value (Operand reader slot)))
      ((EQComplementConsumed value)) :ruleset EQscopes)
(relation EQComplementOtherUse (i64 i64))
(relation EQComplementXor (i64 i64 i64 i64 i64))
(relation EQComplementElide (i64 i64 i64 i64 i64))
(relation EQBooleanNot (String String))
(EQBooleanNot "0" "1")
(EQBooleanNot "1" "0")
(rule ((EQBooleanArm gamma region bits) (EQBooleanNot bits opposite))
      ((EQComplementArm gamma region opposite)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (Result op 0 value) (OpRegion op scope)
       (= value (Operand reader slot)) (not (OpRegion reader scope)))
      ((EQOutsideUse value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (Result op 0 value) (OpRegion op scope)
       (= value (Yield region slot)) (!= region scope))
      ((EQOutsideUse value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (Result op 0 value)
       (= attr (Attribute reader key)) (EQScalarAttrRef attr value))
      ((EQOutsideUse value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (Result op 0 value)
       (= attr (BlockAttribute reader key)) (EQScalarAttrRef attr value))
      ((EQOutsideUse value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root comparison) (Result comparison 0 value)
       (= (OpKind comparison) "builtin.cmpi") (= value (Operand xor 0))
       (= value (Operand reader slot)) (!= reader xor))
      ((EQComplementOtherUse comparison xor)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root comparison) (Result comparison 0 value)
       (= (OpKind comparison) "builtin.cmpi") (= value (Operand xor 0)) (= value (Yield region slot)))
      ((EQComplementOtherUse comparison xor)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.cmpi")
       (not (EQComparisonExtraShape op)) (Result op 0 value)
       (= (Attribute op "predicate") (PredicateAttr predicate))
       (= lhs (Operand op 0)) (= rhs (Operand op 1))
       (= ty (ValueType lhs)) (= ty (ValueType rhs))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (> width (from-string "0"))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((EQTypedComparison op value predicate lhs rhs)) :ruleset EQproject)
(rule ((EQSeed scope) (EQComplementArm gamma scope bits) (GammaSelector gamma selector)
       (EQTypedComparison comparison selector predicate a b)
       (EQUse scope op) (EQTypedComparison op value opposite lhs rhs)
       (EQComplementPredicate predicate opposite) (not (EQOutsideUse value))
       (= (EQInput lhs) (EQInput a)) (= (EQInput rhs) (EQInput b))
       (= ty (ValueType value)))
      ((EQComplementValue op value bits)
       (union (EQInput value) (EQConstant ty bits)) (EQDefined (EQInput value))) :ruleset EQrewrite)

;; Erase only the covered zero-xor pair. Other comparison users and metadata
;; retain their source definitions; there is no general dead-code sweep here.
(rule ((EQSeed scope) (EQUse scope comparison) (EQUse scope xor)
       (EQTypedComparison comparison value predicate lhs rhs)
       (= (OpKind xor) "builtin.xori") (= value (Operand xor 0)) (= other (Operand xor 1))
       (not (Operand xor 2 extra)) (Result xor 0 out) (not (Result xor 1 extra))
       (not (Attribute xor key)) (not (OwnedRegion xor slot region))
       (= ty (ValueType value)) (= ty (ValueType other)) (= ty (ValueType out))
       (not (EQOutsideUse value)) (not (EQOutsideUse out))
       (not (EQComplementConsumed out)) (not (EQComplementOtherUse comparison xor)))
      ((EQComplementXor comparison value xor out other)) :ruleset EQproject)
(rule ((EQComplementValue comparison value "0") (EQComplementXor comparison value xor out other)
       (= (EQInput out) (EQInput other)))
      ((EQComplementElide comparison value xor out other)) :ruleset EQrewrite)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQComplementValue op value bits) (not (EQComplementElide op value xor out other)))
      ((let p (EQProposal invocation root scope root))
       (EQScopedAuthorized p) (EQPutOpKind p op "builtin.constant")
       (EQEraseOperand p op 0) (EQEraseOperand p op 1) (EQEraseAttribute p op "predicate")
       (EQPutAttribute p op "value" (IntegerAttr (Ctor "$attr.signed") 64 (eqsat-storage-bits bits))))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope comparison)
       (EQComplementElide comparison value xor out other) (= other (EQSelected out)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p comparison) (EQEraseOpPlacement p comparison)
       (EQEraseOpLocation p comparison) (EQEraseGraphLayout p comparison)
       (EQEraseOperand p comparison 0) (EQEraseOperand p comparison 1) (EQEraseAttribute p comparison "predicate")
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)
       (EQEraseOpKind p xor) (EQEraseOpPlacement p xor) (EQEraseOpLocation p xor) (EQEraseGraphLayout p xor)
       (EQEraseOperand p xor 0) (EQEraseOperand p xor 1)
       (EQEraseValueDefinition p out) (EQEraseValueType p out) (EQEraseDeclaredType p out))
      :ruleset EQscoped-edits)

;; Partial arithmetic cannot enter the speculative scalar pool. Only an
;; admitted equality may remove its covered root or materialize its result.
(relation EQUnitPartialKind (String String))
(EQUnitPartialKind "builtin.divui" "quotient")
(EQUnitPartialKind "builtin.divsi" "quotient")
(EQUnitPartialKind "builtin.remui" "remainder")
(EQUnitPartialKind "builtin.remsi" "remainder")
(relation EQUnitPartial (i64 i64 String))
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQUnitPartialKind kind mode)
       (Result op 0 value) (not (Result op 1 extra))
       (= x (Operand op 0)) (= y (Operand op 1)) (not (Operand op 2 extra))
       (not (Attribute op key)) (not (OwnedRegion op slot region))
       (= ty (ValueType value)) (= ty (ValueType x)) (= ty (ValueType y))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))))
      ((EQUnitPartial op value mode)) :ruleset EQscopes)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQUnitPartial op value "quotient") (!= op root) (not (EQOutsideUse value))
       (= new (EQSelected value)) (!= value new))
      ((let p (EQProposal invocation root scope root))
       (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op)
       (EQEraseOperand p op 0) (EQEraseOperand p op 1)
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQUnitPartial op value "remainder") (= ty (ValueType value)) (= (EQInput value) (EQConstant ty "0")))
      ((let p (EQProposal invocation root scope root))
       (EQScopedAuthorized p) (EQPutOpKind p op "builtin.constant")
       (EQEraseOperand p op 0) (EQEraseOperand p op 1)
       (EQPutAttribute p op "value" (IntegerAttr (Ctor "$attr.signed") 64 "0000000000000000")))
      :ruleset EQscoped-edits)

(relation EQDroppableScalar (i64 i64))
(rule ((EQScalarSupported frame op value) (EQCanSpeculate op)
       (not (HasInterface op "dyn tir::interfaces::ResourceEffects"))
       (not (Attribute op key)) (not (OwnedRegion op slot region)))
      ((EQDroppableScalar op value)) :ruleset EQscopes)
(relation EQDceExtra (i64))
(rule ((EQRoot root) (Within root op) (= attr (Attribute op key))
       (!= key "operand_segment_sizes") (!= key "semantics") (!= key "value"))
      ((EQDceExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= attr (Attribute op "value"))
       (!= (OpKind op) "builtin.constant"))
      ((EQDceExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= attr (Attribute op "semantics"))
       (not (FpSemanticsAttr inner attr)))
      ((EQDceExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op)
       (= (OpKind op) "builtin.trunci") (!= op root)
       (Result op 0 value) (not (Result op 1 extra))
       (= input (Operand op 0)) (not (Operand op 1 extra))
       (not (Attribute op key)) (not (OwnedRegion op slot region))
       (= (ValueType input) (Apply (Ctor "builtin.i") (TCons (NatLit from) (TNil))))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit to) (TNil))))
       (> to (from-string "0")) (< to from))
      ((EQDroppableScalar op value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (EQCanSpeculate op) (EQEffectFree op)
       (Result op 0 value) (not (Result op 1 extra)) (not (OwnedRegion op slot region))
       (not (EQDceExtra op)))
      ((EQDroppableScalar op value)) :ruleset EQscopes)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQDroppableScalar op value) (!= op root) (not (EQScalarManagedOp op))
       (not (Uses value reader site)) (not (EQScalarAttrRef attr value)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op)
       (EQEraseAttribute p op "operand_segment_sizes") (EQEraseAttribute p op "semantics") (EQEraseAttribute p op "value")
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope op)
       (EQDroppableScalar op value) (!= op root) (not (EQScalarManagedOp op))
       (not (Uses value reader site)) (not (EQScalarAttrRef attr value)) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)

;; Reuse yielded scalar roots in gamma arms. Selected source definitions
;; remain live when a redundant root disappears.
(relation EQPureOp (i64 i64))
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQConstructor name kind arity)
       (Implements kind "dyn tir::interfaces::Speculatable")
       (Result op 0 value) (not (Result op 1 extra))
       (not (Operand op arity extra)) (not (Attribute op key)) (not (OwnedRegion op slot region))
       (not (EQOutsideUse value)) (not (EQScalarManagedOp op)))
      ((EQPureOp op value)) :ruleset EQproject)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op) (EQBooleanArm gamma scope arm-bits)
       (EQPureOp op value) (= value (Yield scope slot)) (EQPickConstant value ty bits)
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (<= width (from-string "64"))
       (not (EQSelected value replacement)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQPutOpKind p op "builtin.constant")
       (EQPutAttribute p op "value" (IntegerAttr (Ctor "$attr.signed") 64 (eqsat-storage-bits bits))))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op) (EQBooleanArm gamma scope arm-bits)
       (EQPureOp op value) (= value (Yield scope slot)) (EQPickConstant value ty bits)
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (> width (from-string "64"))
       (not (EQSelected value replacement)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQPutOpKind p op "builtin.constant")
       (EQPutAttribute p op "value" (IntegerAttr (Ctor "$attr.wide") (eqsat-storage-width bits) (eqsat-storage-bits bits))))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op) (EQBooleanArm gamma scope arm-bits)
       (EQPureOp op value) (= value (Yield scope result)) (EQPickConstant value ty bits)
       (not (EQSelected value replacement)) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op) (EQBooleanArm gamma scope arm-bits)
       (EQPureOp op value) (= value (Yield scope result))
       (= new (EQSelected value)) (!= value new) (not (EQSelected witness value)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op)
       (EQEraseOpLocation p op) (EQEraseGraphLayout p op)
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op) (EQBooleanArm gamma scope arm-bits)
       (EQPureOp op value) (= value (Yield scope result))
       (= new (EQSelected value)) (!= value new) (not (EQSelected witness value)) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)

;; A known decision can discard flat pure integer arms and unused entry ports.
;; Unknown selectors retain their control-poison behavior.
(relation EQEmptyGamma (i64 i64 i64 i64 i64))
(relation EQChosenEmptyGamma (i64 i64 i64 i64))
(relation EQParentInput (i64 i64))
(relation EQGammaMovable (i64 i64))
(relation EQGammaArmBlocked (i64))
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.constant")
       (Result op 0 value) (not (Result op 1 extra))
       (= (Attribute op "value") (IntegerAttr meaning storage bits))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (not (Operand op slot input)) (not (OwnedRegion op slot region)))
      ((EQGammaMovable op value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= kind (OpKind op)) (EQConstructor name kind arity)
       (EQCanSpeculate op) (not (HasInterface op "dyn tir::interfaces::ResourceEffects"))
       (Result op 0 value) (not (Result op 1 extra))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (not (Operand op arity extra)) (not (Attribute op key)) (not (OwnedRegion op slot region)))
      ((EQGammaMovable op value)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "builtin.constant")
       (EQGammaMovable op value) (EQCanSpeculate op)
       (not (HasInterface op "dyn tir::interfaces::ResourceEffects")) (not (EQDceExtra op)))
      ((EQDroppableScalar op value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (= region (OwnedRegion gamma slot))
       (OpUnderRegion region child) (not (EQGammaMovable child value)))
      ((EQGammaArmBlocked region)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (= region (OwnedRegion gamma slot))
       (OpUnderRegion region child) (= attr (Attribute child key)) (!= key "value"))
      ((EQGammaArmBlocked region)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (= region (OwnedRegion gamma slot))
       (RegionParam region port value) (Uses value reader site))
      ((EQGammaArmBlocked region)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (= region (OwnedRegion gamma slot))
       (RegionParam region port value) (EQScalarAttrRef attr value))
      ((EQGammaArmBlocked region)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root gamma) (= region (OwnedRegion gamma slot))
       (OpUnderRegion region child) (EQGammaMovable child value) (EQOutsideUse value))
      ((EQGammaArmBlocked region)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "scf.switch")
       (= attr (Attribute op key)) (!= key "operand_segment_sizes"))
      ((EQGammaArmBlocked op)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root owner) (= owner (RegionOwner scope)) (RegionParam scope slot value))
      ((EQParentInput scope value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root owner) (= owner (RegionOwner scope))
       (= scope (BlockRegion block)) (BlockParam block slot value))
      ((EQParentInput scope value)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "scf.switch") (Gamma op)
       (= first (OwnedRegion op 0)) (= last (OwnedRegion op 1)) (not (OwnedRegion op 2 extra))
       (= first (GammaArm op (from-string "0"))) (= last (GammaDefaultArm op))
       (= (Mode first) (Graph)) (= (Mode last) (Graph))
       (not (EQGammaArmBlocked op)) (not (EQGammaArmBlocked first)) (not (EQGammaArmBlocked last))
       (not (Yield first 1 extra)) (not (Yield last 1 extra))
       (Result op 0 value) (not (Result op 1 extra))
       (GammaSelector op selector) (not (EQOutsideUse value)))
      ((EQEmptyGamma op first last selector value)) :ruleset EQassumptions)
(rule ((EQEmptyGamma op first last selector value) (EQConstantFact selector ty "0" zeros))
      ((EQChosenEmptyGamma op first selector value)) :ruleset EQassumptions)
(rule ((EQEmptyGamma op first last selector value) (EQConstantFact selector ty bits zeros) (!= bits "0"))
      ((EQChosenEmptyGamma op last selector value)) :ruleset EQassumptions)
(rule ((EQEmptyGamma op first last selector value) (= (OpPlacement op) (InGraph scope))
       (EQBooleanArm parent scope "0") (GammaSelector parent selector)
       (not (EQConstantFact selector ty bits zeros))
       (= (ValueType selector) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((EQChosenEmptyGamma op first selector value)) :ruleset EQassumptions)
(rule ((EQEmptyGamma op first last selector value) (= (OpPlacement op) (InGraph scope))
       (EQBooleanArm parent scope "1") (GammaSelector parent selector)
       (not (EQConstantFact selector ty bits zeros))
       (= (ValueType selector) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((EQChosenEmptyGamma op last selector value)) :ruleset EQassumptions)
(rule ((EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op region selector value) (ExitValue region 0 input)
       (EQParentInput scope input) (= (ValueType value) (ValueType input)))
      ((EQExactReplacement scope value input)) :ruleset EQassumptions)
(rule ((EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (= (OpPlacement op) (InGraph scope))
       (EQChosenEmptyGamma op region selector value) (ExitValue region 0 input)
       (EQGammaMovable producer input) (= (OpPlacement producer) (InGraph region))
       (= (ValueType value) (ValueType input)))
      ((EQExactReplacement scope value input)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op region selector value) (ExitValue region 0 input)
       (EQFinalReplacement scope value input))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op)
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)
       (EQEraseGamma p op) (EQEraseGammaPredicate p op) (EQEraseGammaDefaultArm p op)
       (EQEraseGammaArm p op (from-string "0"))) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op selected selector value) (ExitValue selected 0 input)
       (EQFinalReplacement scope value input) (= region (OwnedRegion op slot)))
      ((let p (EQProposal invocation root scope root))
       (EQEraseMode p region) (EQEraseRegionOwner p region) (EQEraseRegionSlot p region) (EQEraseEntry p region)
       (EQEraseYield p region 0) (EQEraseExitBinding p region 0)) :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op region selector value) (ExitValue region 0 input)
       (EQFinalReplacement scope value input) (= attr (Attribute op key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p op key)) :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op region selector value) (ExitValue region 0 input)
       (EQFinalReplacement scope value input) (= old (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op selected selector value) (ExitValue selected 0 input)
       (EQFinalReplacement scope value input) (= region (OwnedRegion op slot))
       (RegionParam region port param))
      ((let p (EQProposal invocation root scope root))
       (EQEraseEntryBinding p region port)
       (EQEraseValueDefinition p param) (EQEraseValueType p param) (EQEraseDeclaredType p param))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed selected) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op selected selector value) (ExitValue selected 0 input)
       (EQFinalReplacement scope value input) (GraphMember selected producer) (not (EQErasedOp producer))
       (= (OpPlacement producer) (InGraph selected)) (= (OpPlacement op) (InGraph scope)))
      ((let p (EQProposal invocation root selected root)) (EQScopedAuthorized p) (EQPutOpPlacement p producer (InGraph scope)))
      :ruleset EQexact-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op selected selector value) (ExitValue selected 0 input)
       (EQFinalReplacement scope value input) (= region (OwnedRegion op slot))
       (!= region selected) (GraphMember region child) (EQGammaMovable child result))
      ((let p (EQProposal invocation root scope root))
       (EQEraseOpKind p child) (EQEraseOpPlacement p child) (EQEraseOpLocation p child) (EQEraseGraphLayout p child)
       (EQEraseAttribute p child "value")
       (EQEraseValueDefinition p result) (EQEraseValueType p result) (EQEraseDeclaredType p result))
      :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope) (EQUse scope op)
       (EQChosenEmptyGamma op selected selector value) (ExitValue selected 0 input)
       (EQFinalReplacement scope value input) (= region (OwnedRegion op slot)) (!= region selected)
       (GraphMember region child) (= old (Operand child port)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p child port)) :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope)
       (EQFinalReplacement scope value input) (EQUse scope reader)
       (= value (Operand reader port)) (not (EQScalarManagedOp reader)) (not (EQErasedOp reader)))
      ((let p (EQProposal invocation root scope root))
       (EQScopedAuthorized p) (EQPutOperand p reader port input)) :ruleset EQexact-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQScopeRecord scope)
       (EQFinalReplacement scope value input) (EQYieldUse scope region)
       (= value (Yield region port)))
      ((let p (EQProposal invocation root scope root))
       (EQScopedAuthorized p) (EQPutYield p region port input)) :ruleset EQexact-edits)

;; An unobserved ordinary write is overwritten by the next equal-extent write.
;; CFG adjacency also retains the write before any independently trapping op.
(relation EQStoreType (TypeExpr))
(relation EQStoreWidth (BigInt))
(EQStoreWidth (from-string "8"))
(EQStoreWidth (from-string "16"))
(EQStoreWidth (from-string "32"))
(EQStoreWidth (from-string "64"))
(relation EQStoreExtra (i64))
(relation EQStoreOverwrite (i64 i64 i64 i64 i64))
(relation EQStoreHead (i64 i64))
(relation EQPlainStore (i64 i64 i64 i64 i64))
(relation EQStorePair (i64 i64 i64 i64 i64))
(relation EQStoreBlocked (i64 i64))
(rule ((EQRoot root) (= ty (ValueType value))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (EQStoreWidth width))
      ((EQStoreType ty)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (= ty (ValueType value)) (= ty (Apply (Ctor "ptr.p") args)))
      ((EQStoreType ty)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "ptr.store")
       (= attr (Attribute op key)) (!= key "operand_segment_sizes"))
      ((EQStoreExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root op) (= (OpKind op) "ptr.store")
       (= value (Operand op 0)) (= pointer (Operand op 1)) (= input (Operand op 2))
       (not (Operand op 3 extra)) (Result op 0 output) (not (Result op 1 extra))
       (EQStoreType (ValueType value)) (not (OwnedRegion op slot region))
       (not (EQStoreExtra op)))
      ((EQPlainStore op value pointer input output)) :ruleset EQscopes)
(rule ((EQPlainStore first x pointer input middle) (EQPlainStore last y pointer middle output)
       (= (ValueType x) (ValueType y))
       (= (OpPlacement first) (InBlock block before)) (= (OpPlacement last) (InBlock block after)) (< before after))
      ((EQStorePair first last input middle block)) :ruleset EQscopes)
(rule ((EQPlainStore first x pointer input middle) (EQPlainStore last y pointer middle output)
       (= (ValueType x) (ValueType y)) (EQTotalValue x)
       (= (OpPlacement first) (InGraph region)) (= (OpPlacement last) (InGraph region)))
      ((EQStorePair first last input middle region)) :ruleset EQscopes)
(rule ((EQStorePair first last input middle placement) (Uses middle reader site) (!= reader last))
      ((EQStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQStorePair first last input middle placement) (EQScalarAttrRef attr middle))
      ((EQStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQStorePair first last input middle placement)
       (= (OpPlacement first) (InBlock block before)) (= (OpPlacement last) (InBlock block after))
       (= (OpPlacement between) (InBlock block order)) (> order before) (< order after))
      ((EQStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQStorePair first last input middle placement) (not (EQStoreBlocked first last)))
      ((EQStoreOverwrite first last input middle placement)) :ruleset EQassumptions)
(rule ((EQPlainStore op value pointer input output) (not (EQStoreOverwrite previous op before middle placement)))
      ((EQStoreHead op input)) :ruleset EQproject)
(rule ((EQStoreOverwrite first last input middle placement) (EQStoreHead first entry))
      ((EQStoreHead last entry)) :ruleset EQproject)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope last)
       (EQStoreOverwrite first last input middle placement) (EQStoreHead last entry)
       (not (EQStoreOverwrite last next after state where)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQPutOperand p last 2 entry)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope first) (EQUse scope last)
       (EQStorePair first last input middle placement) (not (EQStoreBlocked first last)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p first) (EQEraseOpPlacement p first) (EQEraseOpLocation p first) (EQEraseGraphLayout p first)
       (EQEraseOperand p first 0) (EQEraseOperand p first 1) (EQEraseOperand p first 2)
       (EQEraseValueDefinition p middle) (EQEraseValueType p middle) (EQEraseDeclaredType p middle)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope first) (EQUse scope last)
       (EQStorePair first last input middle placement) (not (EQStoreBlocked first last)) (= attr (Attribute first key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p first key)) :ruleset EQscoped-edits)

;; Only reachable blocks with one physical incoming edge inherit a predecessor.
(rule ((EQRoot root) (Within root owner) (= owner (RegionOwner region))
       (= (Mode region) (CFG)) (= region (BlockRegion block)))
      ((EQCFGBlock block region)) :ruleset EQscalar-scope)
(rule ((EQCFGBlock block region) (BlockMember block order term)
       (= dest (Successor term edge)) (= region (BlockRegion dest)))
      ((EQCFGEdge region block term edge dest)) :ruleset EQscalar-scope)
(rule ((EQCFGBlock block region) (= block (Entry region)))
      ((EQCFGReachable region block)) :ruleset EQscalar-scope)
(rule ((EQCFGReachable region block) (EQCFGEdge region block term edge dest))
      ((EQCFGReachable region dest)) :ruleset EQscalar-scope)
(rule ((EQCFGEdge region first a edge block) (EQCFGEdge region second b other block) (!= a b))
      ((EQCFGMultipleIncoming block)) :ruleset EQscalar-scope)
(rule ((EQCFGEdge region first a edge block) (EQCFGEdge region second a other block) (!= edge other))
      ((EQCFGMultipleIncoming block)) :ruleset EQscalar-scope)
(rule ((EQCFGBlock block region) (BlockMember block order op))
      ((EQCFGContextConsumer region op)) :ruleset EQscalar-scope)
(rule ((EQCFGBlock block region))
      ((EQScopeRecord region) (EQScopeRecord block) (EQParentRecord block region)) :ruleset EQscopes)
(rule ((EQCFGEdge region parent term edge block) (EQCFGReachable region block)
       (= entry (Entry region)) (!= entry block) (not (EQCFGMultipleIncoming block)))
      ((EQParentRecord block parent)) :ruleset EQscopes)
(rule ((EQCFGEdge region parent term 0 block) (EQCFGReachable region block)
       (= entry (Entry region)) (!= entry block) (not (EQCFGMultipleIncoming block))
       (= (OpKind term) "cfg.cond_br") (= selector (Operand term 0)))
      ((EQCFGCondition block selector "1")) :ruleset EQscopes)
(rule ((EQCFGEdge region parent term 1 block) (EQCFGReachable region block)
       (= entry (Entry region)) (!= entry block) (not (EQCFGMultipleIncoming block))
       (= (OpKind term) "cfg.cond_br") (= selector (Operand term 0)))
      ((EQCFGCondition block selector "0")) :ruleset EQscopes)
(rule ((EQCFGBlock block region) (BlockMember block order op) (not (EQScalarManagedOp op)))
      ((EQUse block op)) :ruleset EQscopes)
(rule ((EQSeed block) (EQCFGBlock block region) (BlockMember block order op)
       (= old (Operand op slot)) (EQFinalReplacement region old new))
      ((EQCFGRewriteBlocked block op)) :ruleset EQproject)
(rule ((EQSeed block) (EQCFGCondition block selector bits)
       (= ty (ValueType selector))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil)))))
      ((union (EQInput selector) (EQConstant ty bits)) (EQDefined (EQInput selector))) :ruleset EQassumptions)
(rule ((EQSeed block) (EQCFGBlock block region) (EQUse block op)
       (EQCanSpeculate op) (not (EQCFGRewriteBlocked block op))
       (EQTypedComparison op value predicate lhs rhs)
       (EQTypedComparison comparison selector predicate a b)
       (= ty (ValueType selector)) (= (EQInput selector) (EQConstant ty bits))
       (EQDefined (EQInput selector))
       (= (EQInput lhs) (EQInput a)) (= (EQInput rhs) (EQInput b)))
      ((EQCFGComparison block op value bits)
       (union (EQInput value) (EQConstant ty bits)) (EQDefined (EQInput value))) :ruleset EQrewrite)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGComparison block op value bits))
      ((let p (EQProposal invocation root block root)) (EQScopedAuthorized p)
       (EQPutOpKind p op "builtin.constant")
       (EQEraseOperand p op 0) (EQEraseOperand p op 1) (EQEraseAttribute p op "predicate")
       (EQPutAttribute p op "value" (IntegerAttr (Ctor "$attr.signed") 64 (eqsat-storage-bits bits))))
      :ruleset EQscoped-edits)

(rule ((EQCFGBlock block region) (BlockMember block order op) (= (OpKind op) "cfg.cond_br")
       (= attr (Attribute op key)) (!= key "true_dest") (!= key "false_dest") (!= key "operand_segment_sizes"))
      ((EQCFGBranchExtra op)) :ruleset EQscalar-scope)
(rule ((EQCFGBlock block region) (BlockMember block order op) (= (OpKind op) "cfg.cond_br")
       (Result op slot value))
      ((EQCFGBranchExtra op)) :ruleset EQscalar-scope)
(rule ((EQCFGBlock block region) (BlockMember block order op) (= (OpKind op) "cfg.cond_br")
       (= nested (OwnedRegion op slot)))
      ((EQCFGBranchExtra op)) :ruleset EQscalar-scope)
(rule ((EQSeed block) (EQCFGBlock block region) (BlockMember block order op)
       (EQScalarPort frame op slot old key))
      ((EQCFGBranchBlocked op)) :ruleset EQproject)
(rule ((EQSeed block) (EQCFGBlock block region) (EQUse block op)
       (= (OpKind op) "cfg.cond_br") (not (EQCFGBranchExtra op)) (not (EQCFGBranchBlocked op)) (not (EQCFGRewriteBlocked block op))
       (= selector (Operand op 0)) (= ty (ValueType selector))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil))))
       (= (EQInput selector) (EQConstant ty "1")) (EQDefined (EQInput selector))
       (= dest (Successor op 0)) (= other (Successor op 1)) (not (Successor op 2 extra)))
      ((EQCFGDecision block op 0 dest)) :ruleset EQrewrite)
(rule ((EQSeed block) (EQCFGBlock block region) (EQUse block op)
       (= (OpKind op) "cfg.cond_br") (not (EQCFGBranchExtra op)) (not (EQCFGBranchBlocked op)) (not (EQCFGRewriteBlocked block op))
       (= selector (Operand op 0)) (= ty (ValueType selector))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "1")) (TNil))))
       (= (EQInput selector) (EQConstant ty "0")) (EQDefined (EQInput selector))
       (= dest (Successor op 1)) (= other (Successor op 0)) (not (Successor op 2 extra)))
      ((EQCFGDecision block op 1 dest)) :ruleset EQrewrite)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGDecision block op edge dest))
      ((let p (EQProposal invocation root block root)) (EQScopedAuthorized p)
       (EQPutOpKind p op "cfg.br")
       (EQEraseAttribute p op "true_dest") (EQEraseAttribute p op "false_dest")
       (EQPutAttribute p op "dest" (BlockAttr dest))
       (EQEraseSuccessor p op 0) (EQEraseSuccessor p op 1)
       (EQPutSuccessor p op 0 dest)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGDecision block op edge dest) (= old (Operand op slot)))
      ((EQEraseOperand (EQProposal invocation root block root) op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGDecision block op edge dest) (= operand (SuccessorArg op old-edge slot)))
      ((EQEraseSuccessorArg (EQProposal invocation root block root) op old-edge slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGDecision block op edge dest) (EdgeArgument op edge slot value))
      ((let p (EQProposal invocation root block root))
       (EQPutOperand p op slot value) (EQPutSuccessorArg p op 0 slot slot)) :ruleset EQscoped-edits)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGDecision block op 0 dest)
       (= (Attribute op "operand_segment_sizes")
          (ListAttr (ACons condition (ACons first (ACons last (ANil)))))))
      ((EQPutAttribute (EQProposal invocation root block root) op "operand_segment_sizes"
          (ListAttr (ACons first (ANil))))) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed block)
       (EQCFGDecision block op 1 dest)
       (= (Attribute op "operand_segment_sizes")
          (ListAttr (ACons condition (ACons first (ACons last (ANil)))))))
      ((EQPutAttribute (EQProposal invocation root block root) op "operand_segment_sizes"
          (ListAttr (ACons last (ANil))))) :ruleset EQscoped-edits)
