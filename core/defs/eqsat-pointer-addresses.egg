;; Pointer addition is total wrapping arithmetic. Restrict normalization to
;; exact pointer types and default or explicitly declared 64-bit layouts.
(relation EQPointerLayout (i64 Attr))
(relation EQPointerLayout64 (Attr))
(relation EQPointerBadLayout (i64))
(relation EQPointerAdd (i64 i64 i64 i64 i64 TypeExpr))
(relation EQPointerAddress (i64 i64 i64 TypeExpr String))
(function EQPointerRepresentative (i64 i64) i64 :merge (min old new))
(rule ((EQRoot root) (Within root op) (= region (OwnedRegion owner slot))
       (OpUnderRegion region op) (= spec (Attribute owner "layout.spec")))
      ((EQPointerLayout op spec)) :ruleset EQscalar-scope)
(rule ((EQPointerLayout op spec) (= spec (LayoutSpecAttr options entries))
       (AttrItem entries slot (LayoutEntryAttr (Apply (Ctor "ptr.p") (TNil)) names
                  (NatLit (from-string "64")) alignment extra)))
      ((EQPointerLayout64 spec)) :ruleset EQscalar-scope)
(rule ((EQPointerLayout op spec) (not (EQPointerLayout64 spec)))
      ((EQPointerBadLayout op)) :ruleset EQscopes)
(rule ((EQRoot root) (Within root op) (OpRegion op scope) (= (OpKind op) "ptr.ptradd")
       (Result op 0 value) (not (Result op 1 extra))
       (= base (Operand op 0)) (= offset (Operand op 1)) (not (Operand op 2 extra))
       (not (OwnedRegion op slot child)) (not (Attribute op key))
       (= ty (ValueType value)) (= ty (ValueType base)) (= ty (Apply (Ctor "ptr.p") args))
       (= (ValueType offset) (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "64")) (TNil)))))
      ((EQPointerAdd scope op value base offset ty)) :ruleset EQscalar-scope)
(rule ((EQPointerAdd scope op value base offset ty))
      ((EQPointerAddress scope base base ty "0")) :ruleset EQscalar-scope)
(rule ((EQPointerAdd scope op value base offset ty)
       (EQPointerAddress scope base origin ty accumulated)
       (EQConstantFact offset (Apply (Ctor "builtin.i") (TCons (NatLit (from-string "64")) (TNil))) bits zeros)
       (= total (eqsat-int-eval "add" (from-string "64") accumulated bits)))
      ((EQPointerAddress scope value origin ty total)) :ruleset EQscalar-scope)
(rule ((EQPointerAddress scope value base ty "0") (!= value base))
      ((set (EQPointerRepresentative scope value) base)) :ruleset EQscopes)
(rule ((EQPointerAdd scope op value source offset ty)
       (EQPointerAddress scope value base ty bits) (!= bits "0")
       (EQPointerAdd scope earlier representative previous constant ty)
       (EQPointerAddress scope representative base ty bits)
       (= (OpPlacement op) (InBlock block after))
       (= (OpPlacement earlier) (InBlock block before)) (< before after))
      ((set (EQPointerRepresentative scope value) representative)) :ruleset EQscopes)
;; In a graph, choose only a direct spelling from the shared base. Its two
;; operands cannot depend on the chain being replaced.
(rule ((EQPointerAdd scope op value source offset ty)
       (EQPointerAddress scope value base ty bits) (!= bits "0")
       (EQPointerAdd scope earlier representative base constant ty)
       (EQPointerAddress scope representative base ty bits)
       (= (OpPlacement op) (InGraph scope)) (= (OpPlacement earlier) (InGraph scope))
       (< earlier op))
      ((set (EQPointerRepresentative scope value) representative)) :ruleset EQscopes)
(rule ((EQPointerAdd scope op value source offset ty) (!= source base)
       (EQPointerAddress scope value base ty bits) (!= bits "0")
       (EQPointerAdd scope direct representative base constant ty)
       (EQPointerAddress scope representative base ty bits)
       (= (OpPlacement op) (InGraph scope)) (= (OpPlacement direct) (InGraph scope)))
      ((set (EQPointerRepresentative scope value) representative)) :ruleset EQscopes)
(rule ((EQSeed scope) (EQPointerAdd scope op value base offset ty)
       (not (EQPointerBadLayout op)) (= input (EQPointerRepresentative scope value)))
      ((EQExactReplacement scope value input)) :ruleset EQassumptions)
(rule ((EQSeed scope) (EQPointerAdd scope op value base offset ty) (not (EQPointerBadLayout op)))
      ((EQDroppableScalar op value)) :ruleset EQassumptions)

(rule ((EQPointerAdd scope op value base offset ty))
      ((EQImplicitStoreTransparent op)) :ruleset EQscalar-scope)
(relation EQPrivateRangeBlocked (i64))
(rule ((EQPrivateCell a pointer block scope ty) (= attr (Attribute a key))
       (!= key "size") (!= key "align"))
      ((EQPrivateRangeBlocked a)) :ruleset EQscalar-scope)
;; The read cannot fault between the writes, and cannot observe overwritten bytes.
(rule ((EQImplicitStore first old pointer)
       (EQPrivateCell a pointer block scope (Apply (Ctor "builtin.i") (TCons (NatLit extent_width) (TNil)))) (Result a 0 pointer)
       (not (EQPrivateRangeBlocked a)) (EQOrdinaryLayout a) (EQCellWidth extent_width extent)
       (BlockMember block start a) (BlockMember block before first) (> before start)
       (BlockMember block order load) (> order before) (= (OpKind load) "ptr.load")
       (= address (Operand load 0)) (not (Operand load 1 extra))
       (Result load 0 value) (not (Result load 1 extra)) (not (OwnedRegion load slot child))
       (not (EQReadExtra load)) (EQOrdinaryLayout load)
       (= (Attribute load "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))
       (EQPointerAddress scope address pointer pointer_type offset)
       (= (ValueType old) (Apply (Ctor "builtin.i") (TCons (NatLit store_width) (TNil))))
       (EQCellWidth store_width store_bytes)
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit load_width) (TNil))))
       (EQCellWidth load_width load_bytes)
       (= end (eqsat-int-eval "add" (from-string "64") offset load_bytes))
       (= "0" (eqsat-int-eval "ult" (from-string "64") offset store_bytes))
       (= "0" (eqsat-int-eval "ult" (from-string "64") end offset))
       (= "0" (eqsat-int-eval "ult" (from-string "64") extent end)))
      ((EQImplicitStoreDisjointRead first load)) :ruleset EQscalar-check)
(rule ((EQImplicitStorePair first last) (EQImplicitStoreDisjointRead first load) (EQMalformedLayout load))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last) (EQImplicitStore first value pointer)
       (EQPrivateCell a pointer block scope ty) (EQMalformedLayout a))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)

;; A single in-bounds interior scalar is a cell only when all allocation
;; addresses are closed over constant additions and that exact scalar.
(relation EQInteriorCell (i64 i64 i64 i64 i64 TypeExpr))
(relation EQInteriorAddress (i64 i64))
(relation EQInteriorAdd (i64 i64))
(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= (OpPlacement allocation) (InBlock block start)) (= region (BlockRegion block))
       (Result allocation 0 base) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (= pointer_type (ValueType base)) (= pointer_type (Apply (Ctor "ptr.p") (TCons ty (TNil))))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (EQCellWidth width bytes)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 size))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment)
       (EQPointerAddress region pointer base pointer_type offset) (!= offset "0")
       (EQPointerAdd region op pointer source amount pointer_type)
       (EQImplicitStore store input pointer) (= ty (ValueType input))
       (= (OpPlacement op) (InBlock block order)) (> order start)
       (= end (eqsat-int-eval "add" (from-string "64") offset bytes))
       (= "0" (eqsat-int-eval "ult" (from-string "64") end offset))
       (= "0" (eqsat-int-eval "ult" (from-string "64") size end)))
      ((EQInteriorCell allocation base pointer block region ty)
       (EQPrivateCell allocation pointer block region ty)
       (EQInteriorAddress allocation base)) :ruleset EQscalar-scope)
(rule ((EQInteriorCell allocation base pointer block region ty)
       (= (OpPlacement allocation) (InBlock block start))
       (EQPointerAddress region value base pointer_type offset)
       (EQPointerAdd region op value source amount pointer_type)
       (= (OpPlacement op) (InBlock block order)) (> order start))
      ((EQInteriorAddress allocation value) (EQInteriorAdd allocation op)
       (EQCellAddressUse allocation op (OperandUse 0)) (EQOrdinaryLayout op)) :ruleset EQscalar-scope)
(rule ((EQInteriorAddress allocation value) (Uses value reader site)
       (not (EQCellAddressUse allocation reader site)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQInteriorAddress allocation value) (EQScalarAttrRef attr value))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQInteriorAdd allocation op) (EQPointerBadLayout op))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQInteriorCell allocation base pointer block region ty)
       (EQPrivateCell allocation other block region other_type) (!= pointer other))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellElide region allocation) (EQInteriorAdd allocation op))
      ((EQCellElide region op)) :ruleset EQassumptions)
