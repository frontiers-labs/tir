// Reusable CFG, dominance, post-dominance, loop nesting, and memory-chain analyses.

pub let ScopeOp: Int -> Prop;
pub let ModuleOp: Int -> Prop;
pub let CfgRegion: (Int, Int, Int) -> Prop; // region, owner, entry block
pub let FuncOfRegion: (Int, Int) -> Prop; // cfg region -> enclosing func.func op
pub let OrderedForInRegion: (Int, Int, Int) -> Prop; // outer region, op, body region

pub let CfgEdge: (Int, Int, Int, Int) -> Prop; // region, src, edge slot, dst
pub let CfgEdgeTarget: (Int, Int, Int) -> Prop;
pub let CfgExitKind: std::ir::OperationKind -> Prop;
pub let CfgExitBlock: (Int, Int, Int, std::ir::OperationKind) -> Prop;
pub let CfgReachable: (Int, Int) -> Prop;
pub let CfgPath: (Int, Int, Int) -> Prop;
pub let CfgReachableExit: (Int, Int, Int, std::ir::OperationKind) -> Prop;
pub let CfgBranchBlock: (Int, Int) -> Prop;

pub let CfgNotDom: (Int, Int, Int) -> Prop;
pub let CfgDom: (Int, Int, Int) -> Prop;
pub let CfgStrictDom: (Int, Int, Int) -> Prop;
pub let CfgNonIdom: (Int, Int, Int) -> Prop;
pub let CfgIdom: (Int, Int, Int) -> Prop;
pub let CfgNotPostDom: (Int, Int, Int) -> Prop;
pub let CfgPostDom: (Int, Int, Int) -> Prop;
pub let CfgStrictPostDom: (Int, Int, Int) -> Prop;
pub let CfgNonIpdom: (Int, Int, Int) -> Prop;
pub let CfgIpdom: (Int, Int, Int) -> Prop;

pub let NatLoop: (Int, Int, Int) -> Prop; // region, header, member block
pub let NatLoopHeader: (Int, Int) -> Prop;
pub let NatLoopContains: (Int, Int, Int) -> Prop;
pub let NatLoopNonParent: (Int, Int, Int) -> Prop;
pub let NatLoopParent: (Int, Int, Int) -> Prop;
pub let NatLoopTop: (Int, Int) -> Prop;
pub let BlockHasNatLoop: (Int, Int) -> Prop;
pub let BlockNonInnerLoop: (Int, Int, Int) -> Prop;
pub let BlockNatLoop: (Int, Int, Int) -> Prop;

pub let ScopeNode: (Int, Int, Int) -> Prop;
pub let ScopeOwner: (Int, Int, Int) -> Prop;
pub let ScopeRawEdge: (Int, Int, Int, Int) -> Prop;
pub let ScopePath: (Int, Int, Int, Int) -> Prop;
pub let ScopeInCycle: (Int, Int, Int) -> Prop;
pub let IrredScc: std::Table<(Int, Int, Int), Int, std::Merge::Min>;
pub let IrredLoop: (Int, Int, Int) -> Prop;

pub let StateTypeId: Int -> Prop;
pub let MemOpKind: std::ir::OperationKind -> Prop;
pub let DirectMemSlot: (std::ir::OperationKind, Int) -> Prop;
pub let LocalAlloc: Int -> Prop;
pub let AllocOp: (Int, Int) -> Prop;
pub let HasStateOperand: Int -> Prop;
pub let AllocEscapes: Int -> Prop;
pub let PrivateAlloc: (Int, Int) -> Prop;
pub let UnthreadedMemOp: (Int, Int, Int, Int) -> Prop;
pub let RegionChain: (Int, Int) -> Prop;



let scope = |root: std::ir::OperationId| {
    let seed: ScopeOp(std::ir::raw_operation_id(root));
    let nested<region, mode, slot, entry, node, rep>:
        (ir::Region(region, mode, root, slot, entry),
         ir::ReaderAt(std::ir::operation_key(node), region, std::ir::operation_key(rep)))
        -> ScopeOp(node);

    let module_op<node, place, home, pos, disp, loc>:
        (ScopeOp(node),
         ir::Operation{ id: std::ir::operation_key(node), kind: dialects::builtin::r#module.kind, placement: place, container: home, position: pos, display: disp, location: loc }())
        -> ModuleOp(node);

    std::schedule::saturate((seed, nested, module_op))
};

let cfg_regions = || {
    let region<owner, r, slot, entry>:
        (ScopeOp(owner), !ModuleOp(owner), ir::Region(r, "cfg", std::ir::operation_key(owner), slot, entry), std::int::less(entry, 0) == false)
        -> CfgRegion(r, owner, entry);
    let ordered_for<outer, block, layout, node, pos, disp, loc, body, entry>:
        (ScopeOp(node), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::scf::r#ordered_for.kind, placement: "block", container: block, position: pos, display: disp, location: loc }(),
         ir::Block(block, outer, layout), ir::Region(body, "cfg", std::ir::operation_key(node), 0, entry), std::int::less(entry, 0) == false)
        -> OrderedForInRegion(outer, node, body);
    std::schedule::saturate((region, ordered_for))
};

let cfg_func_owner = || {
    let direct<r, owner, entry, place, home, pos, disp, loc>:
        (CfgRegion(r, owner, entry), ir::Operation{ id: std::ir::operation_key(owner), kind: dialects::func::r#func.kind, placement: place, container: home, position: pos, display: disp, location: loc }())
        -> FuncOfRegion(r, owner);
    let nested_for<outer, for_op, body, func_op>:
        (OrderedForInRegion(outer, for_op, body), FuncOfRegion(outer, func_op))
        -> FuncOfRegion(body, func_op);
    std::schedule::saturate((direct, nested_for))
};

let cfg_graph = || {
    let ret_exit: CfgExitKind(dialects::func::r#return.kind);
    let yield_exit: CfgExitKind(dialects::scf::r#yield.kind);
    let edge<r, owner, entry, src, l1, term, kind, pos, disp, loc, slot, dst, l2>:
        (CfgRegion(r, owner, entry), ir::Block(src, r, l1), ir::Operation{ id: std::ir::operation_key(term), kind: kind, placement: "block", container: src, position: pos, display: disp, location: loc }(),
         ir::Successor(std::ir::operation_key(term), slot, dst), ir::Block(dst, r, l2))
        -> (CfgEdge(r, src, slot, dst), CfgEdgeTarget(r, src, dst));
    let exit_block<r, owner, entry, block, layout, term, kind, pos, disp, loc>:
        (CfgRegion(r, owner, entry), ir::Block(block, r, layout), ir::Operation{ id: std::ir::operation_key(term), kind: kind, placement: "block", container: block, position: pos, display: disp, location: loc }(), CfgExitKind(kind))
        -> CfgExitBlock(r, block, term, kind);
    std::schedule::saturate((ret_exit, yield_exit, edge, exit_block))
};

let cfg_reach = || {
    let start<r, owner, entry>: CfgRegion(r, owner, entry) -> CfgReachable(r, entry);
    let step<r, u, v>: (CfgReachable(r, u), CfgEdgeTarget(r, u, v)) -> CfgReachable(r, v);
    let path_base<r, u, v>: (CfgReachable(r, u), CfgEdgeTarget(r, u, v)) -> CfgPath(r, u, v);
    let path_step<r, u, m, v>: (CfgPath(r, u, m), CfgEdgeTarget(r, m, v)) -> CfgPath(r, u, v);
    std::schedule::saturate((start, step, path_base, path_step))
};

let cfg_derived = || {
    let live_exit<r, b, term, kind>: (CfgExitBlock(r, b, term, kind), CfgReachable(r, b)) -> CfgReachableExit(r, b, term, kind);
    let branch<r, b, e1, d1, e2, d2>:
        (CfgReachable(r, b), CfgEdge(r, b, e1, d1), CfgEdge(r, b, e2, d2), e1 != e2) -> CfgBranchBlock(r, b);
    std::schedule::saturate((live_exit, branch))
};

let cfg_not_dom_producer = || {
    let entry_other<r, owner, entry, z>: (CfgRegion(r, owner, entry), CfgReachable(r, z), z != entry) -> CfgNotDom(r, entry, z);
    let prop<r, prev, here, z>: (CfgNotDom(r, prev, z), CfgEdgeTarget(r, prev, here), z != here) -> CfgNotDom(r, here, z);
    let exit_other<r, ex, term, kind, z>: (CfgReachableExit(r, ex, term, kind), CfgReachable(r, z), z != ex) -> CfgNotPostDom(r, ex, z);
    let post_prop<r, here, next, z>: (CfgNotPostDom(r, next, z), CfgEdgeTarget(r, here, next), z != here) -> CfgNotPostDom(r, here, z);
    std::schedule::saturate((entry_other, prop, exit_other, post_prop))
};

let cfg_dom_producer = || {
    let dom<r, d, b>: (CfgReachable(r, d), CfgReachable(r, b), !CfgNotDom(r, b, d)) -> CfgDom(r, d, b);
    let sdom<r, d, b>: (CfgReachable(r, d), CfgReachable(r, b), !CfgNotDom(r, b, d), d != b) -> CfgStrictDom(r, d, b);
    let pdom<r, p, b>: (CfgReachable(r, p), CfgReachable(r, b), !CfgNotPostDom(r, b, p)) -> CfgPostDom(r, p, b);
    let spdom<r, p, b>: (CfgReachable(r, p), CfgReachable(r, b), !CfgNotPostDom(r, b, p), p != b) -> CfgStrictPostDom(r, p, b);
    std::schedule::saturate((dom, sdom, pdom, spdom))
};

let cfg_non_idom_producer = || {
    let dom<r, d, m, b>: (CfgStrictDom(r, d, m), CfgStrictDom(r, m, b)) -> CfgNonIdom(r, d, b);
    let pdom<r, p, m, b>: (CfgStrictPostDom(r, p, m), CfgStrictPostDom(r, m, b)) -> CfgNonIpdom(r, p, b);
    std::schedule::saturate((dom, pdom))
};

let cfg_idom_producer = || {
    let idom<r, d, b>: (CfgStrictDom(r, d, b), !CfgNonIdom(r, d, b)) -> CfgIdom(r, b, d);
    let ipdom<r, p, b>: (CfgStrictPostDom(r, p, b), !CfgNonIpdom(r, p, b)) -> CfgIpdom(r, b, p);
    std::schedule::saturate((idom, ipdom))
};

let cfg_nat_loops = || {
    let header<r, h, t>: (CfgDom(r, h, t), CfgEdgeTarget(r, t, h)) -> (NatLoop(r, h, h), NatLoop(r, h, t), NatLoopHeader(r, h));
    let step<r, h, p, b>: (NatLoop(r, h, b), CfgEdgeTarget(r, p, b), b != h, CfgDom(r, h, p)) -> NatLoop(r, h, p);
    std::schedule::saturate((header, step))
};

let cfg_nat_nesting = || {
    let contains<r, outer, inner>: (NatLoop(r, outer, inner), NatLoopHeader(r, inner), outer != inner) -> NatLoopContains(r, outer, inner);
    let has_loop<r, h, b>: NatLoop(r, h, b) -> BlockHasNatLoop(r, b);
    let non_inner<r, b, outer, inner>: (NatLoop(r, outer, b), NatLoop(r, inner, b), NatLoop(r, outer, inner), outer != inner) -> BlockNonInnerLoop(r, b, outer);
    std::schedule::saturate((contains, has_loop, non_inner))
};

let cfg_nat_non_parent = || {
    let skip<r, outer, mid, inner>: (NatLoopContains(r, outer, mid), NatLoopContains(r, mid, inner)) -> NatLoopNonParent(r, outer, inner);
    std::schedule::saturate((skip,))
};

let cfg_nat_tree = || {
    let parent<r, outer, inner>: (NatLoopContains(r, outer, inner), !NatLoopNonParent(r, outer, inner)) -> NatLoopParent(r, inner, outer);
    let inner_block<r, b, h>: (NatLoop(r, h, b), !BlockNonInnerLoop(r, b, h)) -> BlockNatLoop(r, b, h);
    std::schedule::saturate((parent, inner_block))
};

let cfg_nat_top = || {
    let has_parent<r, inner, outer>: NatLoopParent(r, inner, outer) -> NatLoopTop(r, inner);
    std::schedule::saturate((has_parent,))
};

let cfg_scope_nodes = || {
    let top_block<r, b>: (CfgReachable(r, b), !BlockHasNatLoop(r, b)) -> (ScopeNode(r, r, b), ScopeOwner(r, b, b));
    let top_loop<r, h>: (NatLoopHeader(r, h), !NatLoopTop(r, h)) -> ScopeNode(r, r, h);
    let loop_block<r, b, h>: (BlockNatLoop(r, b, h), !NatLoopHeader(r, b)) -> (ScopeNode(r, h, b), ScopeOwner(r, b, b));
    let loop_header_self<r, h>: NatLoopHeader(r, h) -> (ScopeNode(r, h, h), ScopeOwner(r, h, h));
    let child_loop<r, child, parent>: NatLoopParent(r, child, parent) -> ScopeNode(r, parent, child);
    std::schedule::saturate((
        top_block, top_loop, loop_block, loop_header_self, child_loop,
    ))
};

let cfg_scope_edges = || {
    let direct<r, s, u, v>:
        (ScopeNode(r, s, u), ScopeNode(r, s, v), CfgEdgeTarget(r, u, v), v != s, u != v) -> ScopeRawEdge(r, s, u, v);
    let from_child_loop<r, s, child, u, v>:
        (ScopeNode(r, s, child), NatLoopHeader(r, child), child != s, NatLoop(r, child, u),
         CfgEdgeTarget(r, u, v), !NatLoop(r, child, v), ScopeNode(r, s, v), v != s)
        -> ScopeRawEdge(r, s, child, v);
    let child_to_child<r, s, c1, u, c2>:
        (ScopeNode(r, s, c1), NatLoopHeader(r, c1), c1 != s, NatLoop(r, c1, u),
         CfgEdgeTarget(r, u, c2), !NatLoop(r, c1, c2), ScopeNode(r, s, c2), NatLoopHeader(r, c2), c2 != s)
        -> ScopeRawEdge(r, s, c1, c2);
    std::schedule::saturate((direct, from_child_loop, child_to_child))
};

let cfg_irred_paths = || {
    let base<r, s, u, v>: ScopeRawEdge(r, s, u, v) -> ScopePath(r, s, u, v);
    let step<r, s, u, m, v>: (ScopePath(r, s, u, m), ScopeRawEdge(r, s, m, v)) -> ScopePath(r, s, u, v);
    std::schedule::saturate((base, step))
};

let cfg_irred_scc = || {
    let cyclic<r, s, u>: ScopePath(r, s, u, u) -> ScopeInCycle(r, s, u);
    let scc<r, s, u, v>: (ScopePath(r, s, u, v), ScopePath(r, s, v, u)) -> IrredScc(r, s, u, v);
    std::schedule::saturate((cyclic, scc))
};

let cfg_irred_loops = || {
    let rep<r, s, rep>: IrredScc(r, s, rep, rep) -> IrredLoop(r, s, rep);
    std::schedule::saturate((rep,))
};

pub let state_types = || {
    let state_ty<ctor, decl, def, ty, args>: (ir::TypeCtor(ctor, "builtin", "state", decl, def), ir::TypeTerm(ty, ctor, args)) -> StateTypeId(ty);
    std::schedule::saturate((state_ty,))
};

let cfg_mem_types = || {
    let k_memcpy: MemOpKind(dialects::ptr::r#memcpy.kind);
    let k_memset: MemOpKind(dialects::ptr::r#memset.kind);
    let k_copy: MemOpKind(dialects::ptr::r#copy.kind);
    let k_call: MemOpKind(dialects::func::r#call.kind);
    let slot_load: DirectMemSlot(dialects::ptr::r#load.kind, 0);
    let slot_store: DirectMemSlot(dialects::ptr::r#store.kind, 1);
    let alloc<node, place, home, pos, disp, loc, addr, ty, decl>:
        (ScopeOp(node), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#alloca.kind, placement: place, container: home, position: pos, display: disp, location: loc }(), ir::Value(std::ir::value_key(addr), ty, "result", node, 0, decl))
        -> (LocalAlloc(addr), AllocOp(addr, node));
    std::schedule::saturate((
        k_memcpy, k_memset, k_copy, k_call, slot_load, slot_store, alloc,
    ))
};

let cfg_mem_state = || {
    let threaded<node, slot, v, ty, dk, owner, vslot, decl>:
        (ScopeOp(node), ir::Operand(std::ir::operation_key(node), slot, std::ir::value_key(v)), ir::Value(std::ir::value_key(v), ty, dk, owner, vslot, decl), StateTypeId(ty)) -> HasStateOperand(node);
    let escape_op<addr, user, slot, kind, place, home, pos, disp, loc>:
        (LocalAlloc(addr), ir::Operand(std::ir::operation_key(user), slot, std::ir::value_key(addr)), ir::Operation{ id: std::ir::operation_key(user), kind: kind, placement: place, container: home, position: pos, display: disp, location: loc }(), !DirectMemSlot(kind, slot))
        -> AllocEscapes(addr);
    let escape_yield<addr, reg, slot>: (LocalAlloc(addr), ir::Yield(reg, slot, std::ir::value_key(addr))) -> AllocEscapes(addr);
    std::schedule::saturate((threaded, escape_op, escape_yield))
};

let cfg_mem_private = || {
    let private<addr, op_id>: (AllocOp(addr, op_id), !AllocEscapes(addr)) -> PrivateAlloc(addr, op_id);
    std::schedule::saturate((private,))
};

let cfg_mem_ops = || {
    let load_priv<r, b, node, pos, disp, loc, addr, chain>:
        (CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#load.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(std::ir::operation_key(node), 0, std::ir::value_key(addr)), PrivateAlloc(addr, chain))
        -> (UnthreadedMemOp(r, b, node, chain), RegionChain(r, chain));
    let load_world<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#load.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(std::ir::operation_key(node), 0, std::ir::value_key(addr)), !LocalAlloc(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    let load_escaped<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#load.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(std::ir::operation_key(node), 0, std::ir::value_key(addr)), AllocEscapes(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    let store_priv<r, b, node, pos, disp, loc, addr, chain>:
        (CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#store.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(std::ir::operation_key(node), 1, std::ir::value_key(addr)), PrivateAlloc(addr, chain))
        -> (UnthreadedMemOp(r, b, node, chain), RegionChain(r, chain));
    let store_world<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#store.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(std::ir::operation_key(node), 1, std::ir::value_key(addr)), !LocalAlloc(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    let store_escaped<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::ptr::r#store.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(std::ir::operation_key(node), 1, std::ir::value_key(addr)), AllocEscapes(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    let world_op<fn_id, r, b, node, kind, pos, disp, loc>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), MemOpKind(kind), !HasStateOperand(node))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    let ordered_for_chain<r, b, node, pos, disp, loc, sub, entry, sb, sop, chain>:
        (CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: dialects::scf::r#ordered_for.kind, placement: "block", container: b, position: pos, display: disp, location: loc }(), ir::Region(sub, "cfg", std::ir::operation_key(node), 0, entry), UnthreadedMemOp(sub, sb, sop, chain))
        -> (UnthreadedMemOp(r, b, node, chain), RegionChain(r, chain));
    std::schedule::saturate((
        load_priv, load_world, load_escaped, store_priv, store_world, store_escaped, world_op,
        ordered_for_chain,
    ))
};

// Reissmann §5.1.2 Structural Analysis (Control Tree) & Demand Annotation.
pub let DagMap: (Int, Int, Int, Int) -> Prop;
pub let DagNode: (Int, Int, Int) -> Prop;
pub let DagEntry: (Int, Int, Int) -> Prop;
pub let DagEdge: (Int, Int, Int, Int) -> Prop;
pub let DagHasExit: (Int, Int, Int) -> Prop;
pub let DagDepthStep: (Int, Int, Int, Int) -> Prop;
pub let DagTopoRank: std::Table<(Int, Int, Int), Int, std::Merge::Max>;
pub let DagNotDom: (Int, Int, Int, Int) -> Prop;
pub let DagDom: (Int, Int, Int, Int) -> Prop;
pub let DagStrictDom: (Int, Int, Int, Int) -> Prop;
pub let DagNotPostDom: (Int, Int, Int, Int) -> Prop;
pub let DagPostDom: (Int, Int, Int, Int) -> Prop;
pub let DagStrictPostDom: (Int, Int, Int, Int) -> Prop;
pub let DagNonIpdom: (Int, Int, Int, Int) -> Prop;
pub let DagIpdom: (Int, Int, Int, Int) -> Prop;
pub let DagHasIpdom: (Int, Int, Int) -> Prop;
pub let LoopMember: (Int, Int, Int) -> Prop;
pub let LoopExit: (Int, Int, Int) -> Prop;
pub let LoopMultiExit: (Int, Int) -> Prop;
pub let NatBackedge: (Int, Int, Int, Int) -> Prop;
pub let NatExitEdge: (Int, Int, Int, Int, Int) -> Prop;
pub let NatMultiBack: (Int, Int) -> Prop;
pub let NatMultiExitEdge: (Int, Int) -> Prop;
pub let TailLoop: (Int, Int, Int, Int, Int, Int) -> Prop;
pub let DagOutEdge: (Int, Int, Int, Int, Int) -> Prop;
pub let DagBranch: (Int, Int, Int) -> Prop;
pub let ArmReach: (Int, Int, Int, Int, Int) -> Prop;
pub let ArmNotDom: (Int, Int, Int, Int, Int) -> Prop;
pub let ArmBlock: (Int, Int, Int, Int, Int) -> Prop;
pub let BranchUnstructured: (Int, Int, Int) -> Prop;
pub let SeseBranch: (Int, Int, Int) -> Prop;
pub let TopoHammock: (Int, Int, Int) -> Prop;
pub let HammockMember: (Int, Int, Int, Int) -> Prop;
pub let HammockNested: (Int, Int, Int) -> Prop;
pub let TopHammock: (Int, Int, Int) -> Prop;
pub let ValueDefBlock: (Int, Int, Int) -> Prop;
pub let OpUseInBlock: (Int, Int, Int) -> Prop;
pub let NestedUse: (Int, Int, Int) -> Prop;
pub let ValueUsed: (Int, Int) -> Prop;
pub let DeadBlockArg: (Int, Int, Int, Int) -> Prop;
pub let DeadEdgeUse: (Int, Int, Int) -> Prop;
pub let EdgeAssign: (Int, Int, Int, Int, Int) -> Prop;
pub let BlockVarWrite: (Int, Int, Int) -> Prop;
pub let BlockVarRead: (Int, Int, Int) -> Prop;
pub let BlockLiveIn: (Int, Int, Int) -> Prop;
pub let BlockLiveOut: (Int, Int, Int) -> Prop;
pub let LoopWrites: (Int, Int, Int) -> Prop;
pub let LoopReads: (Int, Int, Int) -> Prop;
pub let LoopDemandOut: (Int, Int, Int) -> Prop;
pub let LoopCarried: (Int, Int, Int) -> Prop;
pub let LoopExitOnly: (Int, Int, Int) -> Prop;
pub let BranchWrites: (Int, Int, Int, Int) -> Prop;
pub let BranchReadsMem: (Int, Int, Int, Int) -> Prop;
pub let BranchDemandOut: (Int, Int, Int, Int) -> Prop;
pub let BranchOutput: (Int, Int, Int, Int) -> Prop;

let dag_contract = || {
    let plain<r, s, m>: (ScopeNode(r, s, m), !ScopeInCycle(r, s, m)) -> (DagMap(r, s, m, m), DagNode(r, s, m));
    let irred<r, s, m, rep>: IrredScc(r, s, m, rep) -> (DagMap(r, s, m, rep), DagNode(r, s, rep));
    std::schedule::saturate((plain, irred))
};

let dag_edges = || {
    let root_entry<r, owner, entry, dn>: (CfgRegion(r, owner, entry), DagMap(r, r, entry, dn)) -> DagEntry(r, r, dn);
    let loop_entry<r, h, dn>: (NatLoopHeader(r, h), DagMap(r, h, h, dn)) -> DagEntry(r, h, dn);
    let edge<r, s, u_raw, v_raw, u, v>:
        (ScopeRawEdge(r, s, u_raw, v_raw), DagMap(r, s, u_raw, u), DagMap(r, s, v_raw, v), u != v)
        -> DagEdge(r, s, u, v);
    let exit_ret<r, s, b, term, kind, u>: (CfgReachableExit(r, b, term, kind), DagMap(r, s, b, u)) -> DagHasExit(r, s, u);
    let exit_back<r, h, b, u>: (NatLoop(r, h, b), CfgEdgeTarget(r, b, h), DagMap(r, h, b, u)) -> DagHasExit(r, h, u);
    let exit_loop_out<r, h, b, w, u>:
        (NatLoop(r, h, b), CfgEdgeTarget(r, b, w), !NatLoop(r, h, w), DagMap(r, h, b, u)) -> DagHasExit(r, h, u);
    let exit_child_out<r, h, child, b, w, u>:
        (NatLoopParent(r, child, h), NatLoop(r, child, b), CfgEdgeTarget(r, b, w), !NatLoop(r, h, w), DagMap(r, h, child, u))
        -> DagHasExit(r, h, u);
    let exit_child_back<r, h, child, b, u>:
        (NatLoopParent(r, child, h), NatLoop(r, child, b), CfgEdgeTarget(r, b, h), DagMap(r, h, child, u))
        -> DagHasExit(r, h, u);
    let exit_child_ret<r, s, child, b, term, kind, u>:
        (ScopeNode(r, s, child), NatLoopHeader(r, child), child != s, NatLoop(r, child, b), CfgReachableExit(r, b, term, kind), DagMap(r, s, child, u))
        -> DagHasExit(r, s, u);
    let exit_irred_ret<r, s, m, rep, b, term, kind>:
        (IrredScc(r, s, m, rep), CfgReachableExit(r, b, term, kind), m == b) -> DagHasExit(r, s, rep);
    let exit_irred_out<r, h, m, rep, w>:
        (IrredScc(r, h, m, rep), CfgEdgeTarget(r, m, w), !NatLoop(r, h, w)) -> DagHasExit(r, h, rep);
    let exit_irred_back<r, h, m, rep>: (IrredScc(r, h, m, rep), CfgEdgeTarget(r, m, h)) -> DagHasExit(r, h, rep);
    std::schedule::saturate((
        root_entry, loop_entry, edge, exit_ret, exit_back, exit_loop_out, exit_child_out,
        exit_child_back, exit_child_ret, exit_irred_ret, exit_irred_out, exit_irred_back,
    ))
};

let dag_topo_steps = || {
    let start<r, s, e>: DagEntry(r, s, e) -> DagDepthStep(r, s, e, 0);
    let step<r, s, u, v, d>: (DagDepthStep(r, s, u, d), DagEdge(r, s, u, v)) -> DagDepthStep(r, s, v, d + 1);
    std::schedule::saturate((start, step))
};

let dag_topo_rank_producer = || {
    let max_rank<r, s, b, d>: DagDepthStep(r, s, b, d) -> DagTopoRank(r, s, b, d);
    std::schedule::saturate((max_rank,))
};

let dag_not_dom_producer = || {
    let dom_start<r, s, e, z>: (DagEntry(r, s, e), DagNode(r, s, z), z != e) -> DagNotDom(r, s, e, z);
    let dom_prop<r, s, p, h, z>: (DagNotDom(r, s, p, z), DagEdge(r, s, p, h), z != h) -> DagNotDom(r, s, h, z);
    let pdom_start<r, s, ex, z>: (DagHasExit(r, s, ex), DagNode(r, s, z), z != ex) -> DagNotPostDom(r, s, ex, z);
    let pdom_prop<r, s, h, n, z>: (DagNotPostDom(r, s, n, z), DagEdge(r, s, h, n), z != h) -> DagNotPostDom(r, s, h, z);
    std::schedule::saturate((dom_start, dom_prop, pdom_start, pdom_prop))
};

let dag_dom_producer = || {
    let dom<r, s, d, b>: (DagNode(r, s, d), DagNode(r, s, b), !DagNotDom(r, s, b, d)) -> DagDom(r, s, d, b);
    let sdom<r, s, d, b>: (DagNode(r, s, d), DagNode(r, s, b), !DagNotDom(r, s, b, d), d != b) -> DagStrictDom(r, s, d, b);
    let pdom<r, s, p, b>: (DagNode(r, s, p), DagNode(r, s, b), !DagNotPostDom(r, s, b, p)) -> DagPostDom(r, s, p, b);
    let spdom<r, s, p, b>: (DagNode(r, s, p), DagNode(r, s, b), !DagNotPostDom(r, s, b, p), p != b) -> DagStrictPostDom(r, s, p, b);
    std::schedule::saturate((dom, sdom, pdom, spdom))
};

let dag_non_ipdom_producer = || {
    let skip<r, s, p, m, b>: (DagStrictPostDom(r, s, p, m), DagStrictPostDom(r, s, m, b)) -> DagNonIpdom(r, s, p, b);
    std::schedule::saturate((skip,))
};

let dag_ipdom_producer = || {
    let ipdom<r, s, p, b>: (DagStrictPostDom(r, s, p, b), !DagNonIpdom(r, s, p, b)) -> (DagIpdom(r, s, b, p), DagHasIpdom(r, s, b));
    std::schedule::saturate((ipdom,))
};

let loop_info = || {
    let nat_member<r, h, b>: NatLoop(r, h, b) -> LoopMember(r, h, b);
    let irred_block<r, s, m, rep>: (IrredScc(r, s, m, rep), !NatLoopHeader(r, m)) -> LoopMember(r, rep, m);
    let irred_child_nat<r, s, m, rep, b>: (IrredScc(r, s, m, rep), NatLoop(r, m, b)) -> LoopMember(r, rep, b);
    let nat_back<r, h, latch, slot>: (NatLoop(r, h, latch), CfgEdge(r, latch, slot, h)) -> NatBackedge(r, h, latch, slot);
    let nat_exit<r, h, src, slot, dst>: (NatLoop(r, h, src), CfgEdge(r, src, slot, dst), !NatLoop(r, h, dst)) -> NatExitEdge(r, h, src, slot, dst);
    std::schedule::saturate((
        nat_member, irred_block, irred_child_nat, nat_back, nat_exit,
    ))
};

let loop_exits = || {
    let nat_exit<r, h, src, slot, dst>: NatExitEdge(r, h, src, slot, dst) -> LoopExit(r, h, dst);
    let irred_exit<r, s, rep, src, dst>:
        (IrredLoop(r, s, rep), LoopMember(r, rep, src), CfgEdgeTarget(r, src, dst), !LoopMember(r, rep, dst))
        -> LoopExit(r, rep, dst);
    std::schedule::saturate((nat_exit, irred_exit))
};

let loop_shape = || {
    let multi_exit<r, l, a, b>: (LoopExit(r, l, a), LoopExit(r, l, b), a != b) -> LoopMultiExit(r, l);
    let multi_back_src<r, h, s1, e1, s2, e2>: (NatBackedge(r, h, s1, e1), NatBackedge(r, h, s2, e2), s1 != s2) -> NatMultiBack(r, h);
    let multi_back_slot<r, h, s, e1, e2>: (NatBackedge(r, h, s, e1), NatBackedge(r, h, s, e2), e1 != e2) -> NatMultiBack(r, h);
    let multi_exit_src<r, h, s1, e1, d1, s2, e2, d2>: (NatExitEdge(r, h, s1, e1, d1), NatExitEdge(r, h, s2, e2, d2), s1 != s2) -> NatMultiExitEdge(r, h);
    let multi_exit_slot<r, h, s, e1, d1, e2, d2>: (NatExitEdge(r, h, s, e1, d1), NatExitEdge(r, h, s, e2, d2), e1 != e2) -> NatMultiExitEdge(r, h);
    std::schedule::saturate((
        multi_exit, multi_back_src, multi_back_slot, multi_exit_src, multi_exit_slot,
    ))
};

let loop_tail = || {
    let tail<r, h, latch, exit, be, ee, term, pos, disp, loc>:
        (NatLoopHeader(r, h), !LoopMultiExit(r, h), !NatMultiBack(r, h), !NatMultiExitEdge(r, h),
         NatBackedge(r, h, latch, be), NatExitEdge(r, h, latch, ee, exit),
         ir::Operation{ id: std::ir::operation_key(term), kind: dialects::cfg::r#cond_br.kind, placement: "block", container: latch, position: pos, display: disp, location: loc }())
        -> TailLoop(r, h, latch, exit, be, ee);
    std::schedule::saturate((tail,))
};

let dag_out_edges = || {
    let block_internal<r, s, b, slot, dst_raw, dst>:
        (DagNode(r, s, b), !NatLoopHeader(r, b), !IrredLoop(r, s, b), CfgEdge(r, b, slot, dst_raw), DagMap(r, s, dst_raw, dst), dst_raw != s)
        -> DagOutEdge(r, s, b, slot, dst);
    let header_internal<r, h, slot, dst_raw, dst>:
        (NatLoopHeader(r, h), DagNode(r, h, h), CfgEdge(r, h, slot, dst_raw), DagMap(r, h, dst_raw, dst), dst_raw != h)
        -> DagOutEdge(r, h, h, slot, dst);
    let block_exit_back<r, h, b, slot>: (DagNode(r, h, b), CfgEdge(r, b, slot, h)) -> DagOutEdge(r, h, b, slot, h);
    let block_exit_out<r, h, b, slot, w>: (DagNode(r, h, b), CfgEdge(r, b, slot, w), !NatLoop(r, h, w)) -> DagOutEdge(r, h, b, slot, h);
    let loop_exit_internal<r, s, l, w, dst>:
        (DagNode(r, s, l), LoopMultiExit(r, l), LoopExit(r, l, w), DagMap(r, s, w, dst), w != s)
        -> DagOutEdge(r, s, l, w, dst);
    std::schedule::saturate((
        block_internal, header_internal, block_exit_back, block_exit_out, loop_exit_internal,
    ))
};

let dag_branches = || {
    let plain<r, s, b>: (DagNode(r, s, b), CfgBranchBlock(r, b), !NatLoopHeader(r, b), !IrredLoop(r, s, b)) -> DagBranch(r, s, b);
    let header<r, h>: (NatLoopHeader(r, h), CfgBranchBlock(r, h)) -> DagBranch(r, h, h);
    let multi_exit_loop<r, s, l>: (DagNode(r, s, l), LoopMultiExit(r, l), l != s) -> DagBranch(r, s, l);
    std::schedule::saturate((plain, header, multi_exit_loop))
};

let branch_reach = || {
    let base<r, s, h, slot, dst>:
        (DagBranch(r, s, h), DagOutEdge(r, s, h, slot, dst), dst != s, !DagIpdom(r, s, h, dst))
        -> ArmReach(r, s, h, slot, dst);
    let step<r, s, h, slot, u, v>: (ArmReach(r, s, h, slot, u), DagEdge(r, s, u, v), !DagIpdom(r, s, h, v)) -> ArmReach(r, s, h, slot, v);
    let other_base<r, s, h, slot, d1, slot2, d2>:
        (DagBranch(r, s, h), DagOutEdge(r, s, h, slot, d1), DagOutEdge(r, s, h, slot2, d2), slot != slot2, d2 != s, !DagIpdom(r, s, h, d2))
        -> ArmNotDom(r, s, h, slot, d2);
    let other_step<r, s, h, slot, u, v>: (ArmNotDom(r, s, h, slot, u), DagEdge(r, s, u, v), !DagIpdom(r, s, h, v)) -> ArmNotDom(r, s, h, slot, v);
    std::schedule::saturate((base, step, other_base, other_step))
};

let branch_arms = || {
    let exclusive<r, s, h, slot, b>: (DagDom(r, s, h, b), ArmReach(r, s, h, slot, b), !ArmNotDom(r, s, h, slot, b)) -> ArmBlock(r, s, h, slot, b);
    std::schedule::saturate((exclusive,))
};

let branch_classify = || {
    let unstruct_direct<r, s, h, slot, w>:
        (DagBranch(r, s, h), DagOutEdge(r, s, h, slot, w), w != s, !DagIpdom(r, s, h, w), !ArmBlock(r, s, h, slot, w))
        -> BranchUnstructured(r, s, h);
    let unstruct_arm<r, s, h, slot, u, w>:
        (ArmBlock(r, s, h, slot, u), DagEdge(r, s, u, w), !DagIpdom(r, s, h, w), !ArmBlock(r, s, h, slot, w))
        -> BranchUnstructured(r, s, h);
    std::schedule::saturate((unstruct_direct, unstruct_arm))
};

let control_tree = || {
    let sese<r, s, h>: (DagBranch(r, s, h), !BranchUnstructured(r, s, h)) -> SeseBranch(r, s, h);
    let hammock<r, s, h>: (DagBranch(r, s, h), BranchUnstructured(r, s, h)) -> TopoHammock(r, s, h);
    let member_joined<r, s, h, j, b>:
        (DagBranch(r, s, h), BranchUnstructured(r, s, h), DagIpdom(r, s, h, j), DagStrictDom(r, s, h, b), DagStrictPostDom(r, s, j, b))
        -> HammockMember(r, s, h, b);
    let member_open<r, s, h, b>:
        (DagBranch(r, s, h), BranchUnstructured(r, s, h), !DagHasIpdom(r, s, h), DagStrictDom(r, s, h, b))
        -> HammockMember(r, s, h, b);
    std::schedule::saturate((sese, hammock, member_joined, member_open))
};

let hammock_outer = || {
    let nested<r, s, h1, h2>: (TopoHammock(r, s, h1), TopoHammock(r, s, h2), HammockMember(r, s, h1, h2)) -> HammockNested(r, s, h2);
    std::schedule::saturate((nested,))
};

let hammock_top = || {
    let top<r, s, h>: (TopoHammock(r, s, h), !HammockNested(r, s, h)) -> TopHammock(r, s, h);
    std::schedule::saturate((top,))
};

let ssa_defs = || {
    let block_arg<r, owner, entry, b, l, v, ty, slot, decl>:
        (CfgRegion(r, owner, entry), ir::Block(b, r, l), ir::Value(std::ir::value_key(v), ty, "block", b, slot, decl)) -> ValueDefBlock(r, b, v);
    let op_res<r, owner, entry, b, l, node, k, p, d, loc, v, ty, slot, decl>:
        (CfgRegion(r, owner, entry), ir::Block(b, r, l), ir::Operation{ id: std::ir::operation_key(node), kind: k, placement: "block", container: b, position: p, display: d, location: loc }(), ir::Value(std::ir::value_key(v), ty, "result", node, slot, decl))
        -> ValueDefBlock(r, b, v);
    let use_direct<r, b, node, k, p, d, loc, slot, v>:
        (CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(node), kind: k, placement: "block", container: b, position: p, display: d, location: loc }(), ir::Operand(std::ir::operation_key(node), slot, std::ir::value_key(v))) -> OpUseInBlock(r, b, v);
    let use_nested<r, b, outer, k, p, d, loc, sub, m, rs, en, inner, rep, slot, v>:
        (CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(outer), kind: k, placement: "block", container: b, position: p, display: d, location: loc }(), ir::Region(sub, m, std::ir::operation_key(outer), rs, en), ir::ReaderAt(std::ir::operation_key(inner), sub, std::ir::operation_key(rep)), ir::Operand(std::ir::operation_key(inner), slot, std::ir::value_key(v)))
        -> (OpUseInBlock(r, b, v), NestedUse(r, b, v));
    let use_yield<r, b, outer, k, p, d, loc, sub, m, rs, en, slot, v>:
        (CfgReachable(r, b), ir::Operation{ id: std::ir::operation_key(outer), kind: k, placement: "block", container: b, position: p, display: d, location: loc }(), ir::Region(sub, m, std::ir::operation_key(outer), rs, en), ir::Yield(sub, slot, std::ir::value_key(v)))
        -> (OpUseInBlock(r, b, v), NestedUse(r, b, v));
    let edge_assign<r, src, term, k, p, d, loc, edge, dst, pslot, oslot, arg, param, ty, decl>:
        (CfgReachable(r, src), ir::Operation{ id: std::ir::operation_key(term), kind: k, placement: "block", container: src, position: p, display: d, location: loc }(), ir::Successor(std::ir::operation_key(term), edge, dst),
         ir::SuccessorArgument(std::ir::operation_key(term), edge, pslot, oslot), ir::Operand(std::ir::operation_key(term), oslot, std::ir::value_key(arg)), ir::Value(std::ir::value_key(param), ty, "block", dst, pslot, decl))
        -> EdgeAssign(r, src, edge, param, arg);
    std::schedule::saturate((
        block_arg, op_res, use_direct, use_nested, use_yield, edge_assign,
    ))
};

let ssa_used = || {
    let used<r, b, v>: OpUseInBlock(r, b, v) -> ValueUsed(r, v);
    std::schedule::saturate((used,))
};

let ssa_dead_args = || {
    let dead<r, owner, entry, b, v, ty, slot, decl>:
        (CfgRegion(r, owner, entry), CfgReachable(r, b), b != entry, ir::Value(std::ir::value_key(v), ty, "block", b, slot, decl), !ValueUsed(r, v))
        -> DeadBlockArg(r, b, slot, v);
    std::schedule::saturate((dead,))
};

let ssa_dead_edge_uses = || {
    let dead_use<r, term, edge, dst, pslot, oslot, v>:
        (DeadBlockArg(r, dst, pslot, v), ir::Successor(std::ir::operation_key(term), edge, dst), ir::SuccessorArgument(std::ir::operation_key(term), edge, pslot, oslot))
        -> DeadEdgeUse(r, term, oslot);
    std::schedule::saturate((dead_use,))
};

let demand_block = || {
    let cross_res_direct<r, def_b, v, use_b, node, k, p, d, loc, slot>:
        (ValueDefBlock(r, def_b, v), CfgReachable(r, use_b), def_b != use_b,
         ir::Operation{ id: std::ir::operation_key(node), kind: k, placement: "block", container: use_b, position: p, display: d, location: loc }(), ir::Operand(std::ir::operation_key(node), slot, std::ir::value_key(v)), !DeadEdgeUse(r, node, slot))
        -> (BlockVarWrite(r, def_b, v), BlockVarRead(r, use_b, v));
    let cross_res_nested<r, def_b, v, use_b>:
        (ValueDefBlock(r, def_b, v), NestedUse(r, use_b, v), def_b != use_b)
        -> (BlockVarWrite(r, def_b, v), BlockVarRead(r, use_b, v));
    let edge_param<r, src, edge, param, arg, dst, ty, slot, decl>:
        (EdgeAssign(r, src, edge, param, arg), ir::Value(std::ir::value_key(param), ty, "block", dst, slot, decl), !DeadBlockArg(r, dst, slot, param))
        -> (BlockVarWrite(r, src, param), BlockVarRead(r, dst, param));
    let mem_op<r, b, node, chain>: UnthreadedMemOp(r, b, node, chain) -> (BlockVarWrite(r, b, chain), BlockVarRead(r, b, chain));
    let mem_exit<r, b, term, kind, chain>: (CfgReachableExit(r, b, term, kind), RegionChain(r, chain)) -> BlockVarRead(r, b, chain);
    let ret_val<r, owner, entry, b, term, val>:
        (CfgRegion(r, owner, entry), CfgReachableExit(r, b, term, dialects::func::r#return.kind), ir::Operand(std::ir::operation_key(term), 0, std::ir::value_key(val))) -> BlockVarWrite(r, b, r);
    std::schedule::saturate((
        cross_res_direct, cross_res_nested, edge_param, mem_op, mem_exit, ret_val,
    ))
};

let demand_liveness = || {
    let read<r, b, v>: BlockVarRead(r, b, v) -> BlockLiveIn(r, b, v);
    let edge<r, src, dst, v>: (CfgEdgeTarget(r, src, dst), BlockLiveIn(r, dst, v)) -> BlockLiveOut(r, src, v);
    let pass<r, b, v>: (BlockLiveOut(r, b, v), !BlockVarWrite(r, b, v)) -> BlockLiveIn(r, b, v);
    std::schedule::saturate((read, edge, pass))
};

let demand_loops = || {
    let write<r, l, b, v>: (LoopMember(r, l, b), BlockVarWrite(r, b, v)) -> LoopWrites(r, l, v);
    let read<r, l, b, v>: (LoopMember(r, l, b), BlockVarRead(r, b, v)) -> LoopReads(r, l, v);
    let demand_out<r, l, x, v>: (LoopExit(r, l, x), BlockLiveIn(r, x, v)) -> LoopDemandOut(r, l, v);
    let demand_ret<r, owner, entry, l, b, term, val>:
        (CfgRegion(r, owner, entry), LoopMember(r, l, b), CfgReachableExit(r, b, term, dialects::func::r#return.kind), ir::Operand(std::ir::operation_key(term), 0, std::ir::value_key(val)))
        -> LoopDemandOut(r, l, r);
    let demand_mem_ret<r, l, b, term, kind, c>:
        (LoopMember(r, l, b), CfgReachableExit(r, b, term, kind), RegionChain(r, c)) -> LoopDemandOut(r, l, c);
    std::schedule::saturate((
        write, read, demand_out, demand_ret, demand_mem_ret,
    ))
};

let demand_loop_ports = || {
    let carried_read<r, l, v>: (LoopWrites(r, l, v), LoopReads(r, l, v)) -> LoopCarried(r, l, v);
    let carried_out<r, l, v>: (LoopWrites(r, l, v), LoopDemandOut(r, l, v)) -> LoopCarried(r, l, v);
    let exit_only<r, l, v>: (LoopWrites(r, l, v), LoopDemandOut(r, l, v), !LoopReads(r, l, v)) -> LoopExitOnly(r, l, v);
    std::schedule::saturate((carried_read, carried_out, exit_only))
};

let demand_branches = || {
    let write_arm_block<r, s, h, slot, b, v>: (ArmBlock(r, s, h, slot, b), BlockVarWrite(r, b, v)) -> BranchWrites(r, s, h, v);
    let write_arm_loop<r, s, h, slot, l, v>: (ArmBlock(r, s, h, slot, l), LoopWrites(r, l, v)) -> BranchWrites(r, s, h, v);
    let write_direct_edge<r, s, h, slot, param, arg, dst, ty, pslot, decl>:
        (SeseBranch(r, s, h), EdgeAssign(r, h, slot, param, arg), ir::Value(std::ir::value_key(param), ty, "block", dst, pslot, decl), !DeadBlockArg(r, dst, pslot, param))
        -> BranchWrites(r, s, h, param);
    let write_hammock_block<r, s, h, b, v>: (TopHammock(r, s, h), HammockMember(r, s, h, b), BlockVarWrite(r, b, v)) -> BranchWrites(r, s, h, v);
    let write_hammock_loop<r, s, h, l, v>: (TopHammock(r, s, h), HammockMember(r, s, h, l), LoopWrites(r, l, v)) -> BranchWrites(r, s, h, v);
    let mem_arm_block<r, s, h, slot, b, c>: (ArmBlock(r, s, h, slot, b), RegionChain(r, c), BlockVarRead(r, b, c)) -> BranchReadsMem(r, s, h, c);
    let mem_arm_loop<r, s, h, slot, l, c>: (ArmBlock(r, s, h, slot, l), RegionChain(r, c), LoopReads(r, l, c)) -> BranchReadsMem(r, s, h, c);
    let mem_hammock_block<r, s, h, b, c>: (TopHammock(r, s, h), HammockMember(r, s, h, b), RegionChain(r, c), BlockVarRead(r, b, c)) -> BranchReadsMem(r, s, h, c);
    let mem_hammock_loop<r, s, h, l, c>: (TopHammock(r, s, h), HammockMember(r, s, h, l), RegionChain(r, c), LoopReads(r, l, c)) -> BranchReadsMem(r, s, h, c);
    let demand_join<r, s, h, j, v>: (DagBranch(r, s, h), DagIpdom(r, s, h, j), BlockLiveIn(r, j, v)) -> BranchDemandOut(r, s, h, v);
    let demand_join_loop<r, s, h, j, v>: (DagBranch(r, s, h), DagIpdom(r, s, h, j), LoopReads(r, j, v)) -> BranchDemandOut(r, s, h, v);
    let demand_root_ret<r, owner, entry, h>: (CfgRegion(r, owner, entry), DagBranch(r, r, h), !DagHasIpdom(r, r, h)) -> BranchDemandOut(r, r, h, r);
    let demand_root_mem<r, h, c>: (DagBranch(r, r, h), !DagHasIpdom(r, r, h), RegionChain(r, c)) -> BranchDemandOut(r, r, h, c);
    let demand_loop_body<r, lh, h, v>: (DagBranch(r, lh, h), !DagHasIpdom(r, lh, h), NatLoopHeader(r, lh), LoopCarried(r, lh, v)) -> BranchDemandOut(r, lh, h, v);
    std::schedule::saturate((
        write_arm_block, write_arm_loop, write_direct_edge, write_hammock_block, write_hammock_loop,
        mem_arm_block, mem_arm_loop, mem_hammock_block, mem_hammock_loop, demand_join,
        demand_join_loop, demand_root_ret, demand_root_mem, demand_loop_body,
    ))
};

let demand_branch_outputs = || {
    let output<r, s, h, v>: (BranchWrites(r, s, h, v), BranchDemandOut(r, s, h, v)) -> BranchOutput(r, s, h, v);
    std::schedule::saturate((output,))
};

pub let analyze = memo |root: std::ir::OperationId| {
    std::schedule::sequence((
        scope(root),
        cfg_regions(),
        cfg_func_owner(),
        cfg_graph(),
        cfg_reach(),
        cfg_derived(),
        cfg_not_dom_producer(),
        cfg_dom_producer(),
        cfg_non_idom_producer(),
        cfg_idom_producer(),
        cfg_nat_loops(),
        cfg_nat_nesting(),
        cfg_nat_non_parent(),
        cfg_nat_tree(),
        cfg_nat_top(),
        cfg_scope_nodes(),
        cfg_scope_edges(),
        cfg_irred_paths(),
        cfg_irred_scc(),
        cfg_irred_loops(),
        state_types(),
        cfg_mem_types(),
        cfg_mem_state(),
        cfg_mem_private(),
        cfg_mem_ops(),
        dag_contract(),
        dag_edges(),
        dag_topo_steps(),
        dag_topo_rank_producer(),
        dag_not_dom_producer(),
        dag_dom_producer(),
        dag_non_ipdom_producer(),
        dag_ipdom_producer(),
        loop_info(),
        loop_exits(),
        loop_shape(),
        loop_tail(),
        dag_out_edges(),
        dag_branches(),
        branch_reach(),
        branch_arms(),
        branch_classify(),
        control_tree(),
        hammock_outer(),
        hammock_top(),
        ssa_defs(),
        ssa_used(),
        ssa_dead_args(),
        ssa_dead_edge_uses(),
        demand_block(),
        demand_liveness(),
        demand_loops(),
        demand_loop_ports(),
        demand_branches(),
        demand_branch_outputs(),
    ))?;
    {
        ops: ScopeOp,
        modules: ModuleOp,
        ArmBlock: ArmBlock,
        BlockLiveIn: BlockLiveIn,
        BlockVarWrite: BlockVarWrite,
        BranchOutput: BranchOutput,
        BranchReadsMem: BranchReadsMem,
        CfgEdge: CfgEdge,
        CfgReachable: CfgReachable,
        CfgReachableExit: CfgReachableExit,
        CfgRegion: CfgRegion,
        DagEdge: DagEdge,
        DagEntry: DagEntry,
        DagHasIpdom: DagHasIpdom,
        DagIpdom: DagIpdom,
        DagNode: DagNode,
        DagStrictDom: DagStrictDom,
        DagTopoRank: DagTopoRank,
        DeadBlockArg: DeadBlockArg,
        EdgeAssign: EdgeAssign,
        HammockMember: HammockMember,
        IrredLoop: IrredLoop,
        IrredScc: IrredScc,
        LoopCarried: LoopCarried,
        LoopExit: LoopExit,
        LoopExitOnly: LoopExitOnly,
        LoopMultiExit: LoopMultiExit,
        NatLoopHeader: NatLoopHeader,
        OrderedForInRegion: OrderedForInRegion,
        RegionChain: RegionChain,
        SeseBranch: SeseBranch,
        TailLoop: TailLoop,
        TopHammock: TopHammock,
        UnthreadedMemOp: UnthreadedMemOp,
        ValueDefBlock: ValueDefBlock,
    }
};
