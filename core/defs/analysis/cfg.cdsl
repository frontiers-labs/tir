// Reusable CFG, dominance, post-dominance, loop nesting, and memory-chain analyses.

pub use analysis::root::AnalysisRoot;
pub let ScopeOp: Int -> Prop as "ScopeOp";
pub let ModuleOp: Int -> Prop as "ModuleOp";
pub let CfgRegion: (Int, Int, Int) -> Prop as "CfgRegion"; // region, owner, entry block
pub let FuncOfRegion: (Int, Int) -> Prop as "FuncOfRegion"; // cfg region -> enclosing func.func op
pub let OrderedForInRegion: (Int, Int, Int) -> Prop as "OrderedForInRegion"; // outer region, op, body region

pub let CfgEdge: (Int, Int, Int, Int) -> Prop as "CfgEdge"; // region, src, edge slot, dst
pub let CfgEdgeTarget: (Int, Int, Int) -> Prop as "CfgEdgeTarget";
pub let CfgExitKind: String -> Prop as "CfgExitKind";
pub let CfgExitBlock: (Int, Int, Int, String) -> Prop as "CfgExitBlock";
pub let CfgReachable: (Int, Int) -> Prop as "CfgReachable";
pub let CfgPath: (Int, Int, Int) -> Prop as "CfgPath";
pub let CfgReachableExit: (Int, Int, Int, String) -> Prop as "CfgReachableExit";
pub let CfgBranchBlock: (Int, Int) -> Prop as "CfgBranchBlock";

pub let CfgNotDom: (Int, Int, Int) -> Prop as "CfgNotDom";
pub let CfgDom: (Int, Int, Int) -> Prop as "CfgDom";
pub let CfgStrictDom: (Int, Int, Int) -> Prop as "CfgStrictDom";
pub let CfgNonIdom: (Int, Int, Int) -> Prop as "CfgNonIdom";
pub let CfgIdom: (Int, Int, Int) -> Prop as "CfgIdom";
pub let CfgNotPostDom: (Int, Int, Int) -> Prop as "CfgNotPostDom";
pub let CfgPostDom: (Int, Int, Int) -> Prop as "CfgPostDom";
pub let CfgStrictPostDom: (Int, Int, Int) -> Prop as "CfgStrictPostDom";
pub let CfgNonIpdom: (Int, Int, Int) -> Prop as "CfgNonIpdom";
pub let CfgIpdom: (Int, Int, Int) -> Prop as "CfgIpdom";

pub let NatLoop: (Int, Int, Int) -> Prop as "NatLoop"; // region, header, member block
pub let NatLoopHeader: (Int, Int) -> Prop as "NatLoopHeader";
pub let NatLoopContains: (Int, Int, Int) -> Prop as "NatLoopContains";
pub let NatLoopNonParent: (Int, Int, Int) -> Prop as "NatLoopNonParent";
pub let NatLoopParent: (Int, Int, Int) -> Prop as "NatLoopParent";
pub let NatLoopTop: (Int, Int) -> Prop as "NatLoopTop";
pub let BlockHasNatLoop: (Int, Int) -> Prop as "BlockHasNatLoop";
pub let BlockNonInnerLoop: (Int, Int, Int) -> Prop as "BlockNonInnerLoop";
pub let BlockNatLoop: (Int, Int, Int) -> Prop as "BlockNatLoop";

pub let ScopeNode: (Int, Int, Int) -> Prop as "ScopeNode";
pub let ScopeOwner: (Int, Int, Int) -> Prop as "ScopeOwner";
pub let ScopeRawEdge: (Int, Int, Int, Int) -> Prop as "ScopeRawEdge";
pub let ScopePath: (Int, Int, Int, Int) -> Prop as "ScopePath";
pub let ScopeInCycle: (Int, Int, Int) -> Prop as "ScopeInCycle";
pub let IrredScc: (Int, Int, Int, Int) -> Prop as tables::IrredScc;
pub let IrredLoop: (Int, Int, Int) -> Prop as "IrredLoop";

pub let StateTypeId: Int -> Prop as "StateTypeId";
pub let MemOpKind: String -> Prop as "MemOpKind";
pub let DirectMemSlot: (String, Int) -> Prop as "DirectMemSlot";
pub let LocalAlloc: Int -> Prop as "LocalAlloc";
pub let AllocOp: (Int, Int) -> Prop as "AllocOp";
pub let HasStateOperand: Int -> Prop as "HasStateOperand";
pub let AllocEscapes: Int -> Prop as "AllocEscapes";
pub let PrivateAlloc: (Int, Int) -> Prop as "PrivateAlloc";
pub let UnthreadedMemOp: (Int, Int, Int, Int) -> Prop as "UnthreadedMemOp";
pub let RegionChain: (Int, Int) -> Prop as "RegionChain";

pub mod tables {
    pub let IrredScc: std::Table<(Int, Int, Int), Int, std::Merge::Min> as "IrredScc";
    pub let DagTopoRank: std::Table<(Int, Int, Int), Int, std::Merge::Max> as "DagTopoRank";
}

pub mod cfg_scope {
    pub let root<node>: analysis::root::AnalysisRoot(node) -> ScopeOp(node);
    pub let nested<root, region, mode, slot, entry, node, rep>:
        (analysis::root::AnalysisRoot(root), ir::Region(region, mode, root, slot, entry), ir::ReaderAt(node, region, rep))
        -> ScopeOp(node);
    pub let module_op<node, place, home, pos, disp, loc>:
        ir::Operation{ id: node, kind: std::ir::operation_named("builtin.module"), placement: place, container: home, position: pos, display: disp, location: loc }() -> ModuleOp(node);
}

pub mod cfg_regions {
    pub let region<owner, r, slot, entry>:
        (ScopeOp(owner), !ModuleOp(owner), ir::Region(r, "cfg", owner, slot, entry), ir::less_id(entry, 0) == false)
        -> CfgRegion(r, owner, entry);
    pub let ordered_for<outer, block, layout, node, pos, disp, loc, body, entry>:
        (ScopeOp(node), ir::Operation{ id: node, kind: std::ir::operation_named("scf.ordered_for"), placement: "block", container: block, position: pos, display: disp, location: loc }(),
         ir::Block(block, outer, layout), ir::Region(body, "cfg", node, 0, entry), ir::less_id(entry, 0) == false)
        -> OrderedForInRegion(outer, node, body);
}

pub mod cfg_func_owner {
    pub let direct<r, owner, entry, place, home, pos, disp, loc>:
        (CfgRegion(r, owner, entry), ir::Operation{ id: owner, kind: std::ir::operation_named("func.func"), placement: place, container: home, position: pos, display: disp, location: loc }())
        -> FuncOfRegion(r, owner);
    pub let nested_for<outer, for_op, body, func_op>:
        (OrderedForInRegion(outer, for_op, body), FuncOfRegion(outer, func_op))
        -> FuncOfRegion(body, func_op);
}

pub mod cfg_graph {
    pub let ret_exit: CfgExitKind("func.return");
    pub let yield_exit: CfgExitKind("scf.yield");
    pub let edge<r, owner, entry, src, l1, term, kind, pos, disp, loc, slot, dst, l2>:
        (CfgRegion(r, owner, entry), ir::Block(src, r, l1), ir::Operation{ id: term, kind: std::ir::operation_named(kind), placement: "block", container: src, position: pos, display: disp, location: loc }(),
         ir::Successor(term, slot, dst), ir::Block(dst, r, l2))
        -> (CfgEdge(r, src, slot, dst), CfgEdgeTarget(r, src, dst));
    pub let exit_block<r, owner, entry, block, layout, term, kind, pos, disp, loc>:
        (CfgRegion(r, owner, entry), ir::Block(block, r, layout), ir::Operation{ id: term, kind: std::ir::operation_named(kind), placement: "block", container: block, position: pos, display: disp, location: loc }(), CfgExitKind(kind))
        -> CfgExitBlock(r, block, term, kind);
}

pub mod cfg_reach {
    pub let start<r, owner, entry>: CfgRegion(r, owner, entry) -> CfgReachable(r, entry);
    pub let step<r, u, v>: (CfgReachable(r, u), CfgEdgeTarget(r, u, v)) -> CfgReachable(r, v);
    pub let path_base<r, u, v>: (CfgReachable(r, u), CfgEdgeTarget(r, u, v)) -> CfgPath(r, u, v);
    pub let path_step<r, u, m, v>: (CfgPath(r, u, m), CfgEdgeTarget(r, m, v)) -> CfgPath(r, u, v);
}

pub mod cfg_derived {
    pub let live_exit<r, b, term, kind>: (CfgExitBlock(r, b, term, kind), CfgReachable(r, b)) -> CfgReachableExit(r, b, term, kind);
    pub let branch<r, b, e1, d1, e2, d2>:
        (CfgReachable(r, b), CfgEdge(r, b, e1, d1), CfgEdge(r, b, e2, d2), ir::equal_id(e1, e2) == false) -> CfgBranchBlock(r, b);
}

pub mod cfg_not_dom {
    pub let entry_other<r, owner, entry, z>: (CfgRegion(r, owner, entry), CfgReachable(r, z), ir::equal_id(z, entry) == false) -> CfgNotDom(r, entry, z);
    pub let prop<r, prev, here, z>: (CfgNotDom(r, prev, z), CfgEdgeTarget(r, prev, here), ir::equal_id(z, here) == false) -> CfgNotDom(r, here, z);
    pub let exit_other<r, ex, term, kind, z>: (CfgReachableExit(r, ex, term, kind), CfgReachable(r, z), ir::equal_id(z, ex) == false) -> CfgNotPostDom(r, ex, z);
    pub let post_prop<r, here, next, z>: (CfgNotPostDom(r, next, z), CfgEdgeTarget(r, here, next), ir::equal_id(z, here) == false) -> CfgNotPostDom(r, here, z);
}

pub mod cfg_dom {
    pub let dom<r, d, b>: (CfgReachable(r, d), CfgReachable(r, b), !CfgNotDom(r, b, d)) -> CfgDom(r, d, b);
    pub let sdom<r, d, b>: (CfgReachable(r, d), CfgReachable(r, b), !CfgNotDom(r, b, d), ir::equal_id(d, b) == false) -> CfgStrictDom(r, d, b);
    pub let pdom<r, p, b>: (CfgReachable(r, p), CfgReachable(r, b), !CfgNotPostDom(r, b, p)) -> CfgPostDom(r, p, b);
    pub let spdom<r, p, b>: (CfgReachable(r, p), CfgReachable(r, b), !CfgNotPostDom(r, b, p), ir::equal_id(p, b) == false) -> CfgStrictPostDom(r, p, b);
}

pub mod cfg_non_idom {
    pub let dom<r, d, m, b>: (CfgStrictDom(r, d, m), CfgStrictDom(r, m, b)) -> CfgNonIdom(r, d, b);
    pub let pdom<r, p, m, b>: (CfgStrictPostDom(r, p, m), CfgStrictPostDom(r, m, b)) -> CfgNonIpdom(r, p, b);
}

pub mod cfg_idom {
    pub let idom<r, d, b>: (CfgStrictDom(r, d, b), !CfgNonIdom(r, d, b)) -> CfgIdom(r, b, d);
    pub let ipdom<r, p, b>: (CfgStrictPostDom(r, p, b), !CfgNonIpdom(r, p, b)) -> CfgIpdom(r, b, p);
}

pub mod cfg_nat_loops {
    pub let header<r, h, t>: (CfgDom(r, h, t), CfgEdgeTarget(r, t, h)) -> (NatLoop(r, h, h), NatLoop(r, h, t), NatLoopHeader(r, h));
    pub let step<r, h, p, b>: (NatLoop(r, h, b), CfgEdgeTarget(r, p, b), ir::equal_id(b, h) == false, CfgDom(r, h, p)) -> NatLoop(r, h, p);
}

pub mod cfg_nat_nesting {
    pub let contains<r, outer, inner>: (NatLoop(r, outer, inner), NatLoopHeader(r, inner), ir::equal_id(outer, inner) == false) -> NatLoopContains(r, outer, inner);
    pub let has_loop<r, h, b>: NatLoop(r, h, b) -> BlockHasNatLoop(r, b);
    pub let non_inner<r, b, outer, inner>: (NatLoop(r, outer, b), NatLoop(r, inner, b), NatLoop(r, outer, inner), ir::equal_id(outer, inner) == false) -> BlockNonInnerLoop(r, b, outer);
}

pub mod cfg_nat_non_parent {
    pub let skip<r, outer, mid, inner>: (NatLoopContains(r, outer, mid), NatLoopContains(r, mid, inner)) -> NatLoopNonParent(r, outer, inner);
}

pub mod cfg_nat_tree {
    pub let parent<r, outer, inner>: (NatLoopContains(r, outer, inner), !NatLoopNonParent(r, outer, inner)) -> NatLoopParent(r, inner, outer);
    pub let inner_block<r, b, h>: (NatLoop(r, h, b), !BlockNonInnerLoop(r, b, h)) -> BlockNatLoop(r, b, h);
}

pub mod cfg_nat_top {
    pub let has_parent<r, inner, outer>: NatLoopParent(r, inner, outer) -> NatLoopTop(r, inner);
}

pub mod cfg_scope_nodes {
    pub let top_block<r, b>: (CfgReachable(r, b), !BlockHasNatLoop(r, b)) -> (ScopeNode(r, r, b), ScopeOwner(r, b, b));
    pub let top_loop<r, h>: (NatLoopHeader(r, h), !NatLoopTop(r, h)) -> ScopeNode(r, r, h);
    pub let loop_block<r, b, h>: (BlockNatLoop(r, b, h), !NatLoopHeader(r, b)) -> (ScopeNode(r, h, b), ScopeOwner(r, b, b));
    pub let loop_header_self<r, h>: NatLoopHeader(r, h) -> (ScopeNode(r, h, h), ScopeOwner(r, h, h));
    pub let child_loop<r, child, parent>: NatLoopParent(r, child, parent) -> ScopeNode(r, parent, child);
}

pub mod cfg_scope_edges {
    pub let direct<r, s, u, v>:
        (ScopeNode(r, s, u), ScopeNode(r, s, v), CfgEdgeTarget(r, u, v), ir::equal_id(v, s) == false, ir::equal_id(u, v) == false) -> ScopeRawEdge(r, s, u, v);
    pub let from_child_loop<r, s, child, u, v>:
        (ScopeNode(r, s, child), NatLoopHeader(r, child), ir::equal_id(child, s) == false, NatLoop(r, child, u),
         CfgEdgeTarget(r, u, v), !NatLoop(r, child, v), ScopeNode(r, s, v), ir::equal_id(v, s) == false)
        -> ScopeRawEdge(r, s, child, v);
    pub let child_to_child<r, s, c1, u, c2>:
        (ScopeNode(r, s, c1), NatLoopHeader(r, c1), ir::equal_id(c1, s) == false, NatLoop(r, c1, u),
         CfgEdgeTarget(r, u, c2), !NatLoop(r, c1, c2), ScopeNode(r, s, c2), NatLoopHeader(r, c2), ir::equal_id(c2, s) == false)
        -> ScopeRawEdge(r, s, c1, c2);
}

pub mod cfg_irred_paths {
    pub let base<r, s, u, v>: ScopeRawEdge(r, s, u, v) -> ScopePath(r, s, u, v);
    pub let step<r, s, u, m, v>: (ScopePath(r, s, u, m), ScopeRawEdge(r, s, m, v)) -> ScopePath(r, s, u, v);
}

pub mod cfg_irred_scc {
    pub let cyclic<r, s, u>: ScopePath(r, s, u, u) -> ScopeInCycle(r, s, u);
    pub let scc<r, s, u, v>: (ScopePath(r, s, u, v), ScopePath(r, s, v, u)) -> IrredScc(r, s, u, v);
}

pub mod cfg_irred_loops {
    pub let rep<r, s, rep>: IrredScc(r, s, rep, rep) -> IrredLoop(r, s, rep);
}

pub mod cfg_mem_types {
    pub let state_ty<ctor, decl, def, ty, args>: (ir::TypeCtor(ctor, "builtin", "state", decl, def), ir::TypeTerm(ty, ctor, args)) -> StateTypeId(ty);
    pub let k_memcpy: MemOpKind("ptr.memcpy");
    pub let k_memset: MemOpKind("ptr.memset");
    pub let k_copy: MemOpKind("ptr.copy");
    pub let k_call: MemOpKind("func.call");
    pub let k_call_ind: MemOpKind("func.call_indirect");
    pub let slot_load: DirectMemSlot("ptr.load", 0);
    pub let slot_store: DirectMemSlot("ptr.store", 1);
    pub let alloc<node, place, home, pos, disp, loc, addr, ty, decl>:
        (ScopeOp(node), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.alloca"), placement: place, container: home, position: pos, display: disp, location: loc }(), ir::Value(addr, ty, "result", node, 0, decl))
        -> (LocalAlloc(addr), AllocOp(addr, node));
}

pub mod cfg_mem_state {
    pub let threaded<node, slot, v, ty, dk, owner, vslot, decl>:
        (ir::Operand(node, slot, v), ir::Value(v, ty, dk, owner, vslot, decl), StateTypeId(ty)) -> HasStateOperand(node);
    pub let escape_op<addr, user, slot, kind, place, home, pos, disp, loc>:
        (LocalAlloc(addr), ir::Operand(user, slot, addr), ir::Operation{ id: user, kind: std::ir::operation_named(kind), placement: place, container: home, position: pos, display: disp, location: loc }(), !DirectMemSlot(kind, slot))
        -> AllocEscapes(addr);
    pub let escape_yield<addr, reg, slot>: (LocalAlloc(addr), ir::Yield(reg, slot, addr)) -> AllocEscapes(addr);
}

pub mod cfg_mem_private {
    pub let private<addr, op_id>: (AllocOp(addr, op_id), !AllocEscapes(addr)) -> PrivateAlloc(addr, op_id);
}

pub mod cfg_mem_ops {
    pub let load_priv<r, b, node, pos, disp, loc, addr, chain>:
        (CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.load"), placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(node, 0, addr), PrivateAlloc(addr, chain))
        -> (UnthreadedMemOp(r, b, node, chain), RegionChain(r, chain));
    pub let load_world<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.load"), placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(node, 0, addr), !LocalAlloc(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    pub let load_escaped<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.load"), placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(node, 0, addr), AllocEscapes(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    pub let store_priv<r, b, node, pos, disp, loc, addr, chain>:
        (CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.store"), placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(node, 1, addr), PrivateAlloc(addr, chain))
        -> (UnthreadedMemOp(r, b, node, chain), RegionChain(r, chain));
    pub let store_world<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.store"), placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(node, 1, addr), !LocalAlloc(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    pub let store_escaped<fn_id, r, b, node, pos, disp, loc, addr>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("ptr.store"), placement: "block", container: b, position: pos, display: disp, location: loc }(), !HasStateOperand(node), ir::Operand(node, 1, addr), AllocEscapes(addr))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    pub let world_op<fn_id, r, b, node, kind, pos, disp, loc>:
        (FuncOfRegion(r, fn_id), CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named(kind), placement: "block", container: b, position: pos, display: disp, location: loc }(), MemOpKind(kind), !HasStateOperand(node))
        -> (UnthreadedMemOp(r, b, node, fn_id), RegionChain(r, fn_id));
    pub let ordered_for_chain<r, b, node, pos, disp, loc, sub, entry, sb, sop, chain>:
        (CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named("scf.ordered_for"), placement: "block", container: b, position: pos, display: disp, location: loc }(), ir::Region(sub, "cfg", node, 0, entry), UnthreadedMemOp(sub, sb, sop, chain))
        -> (UnthreadedMemOp(r, b, node, chain), RegionChain(r, chain));
}

// Reissmann §5.1.2 Structural Analysis (Control Tree) & Demand Annotation.
pub let DagMap: (Int, Int, Int, Int) -> Prop as "DagMap";
pub let DagNode: (Int, Int, Int) -> Prop as "DagNode";
pub let DagEntry: (Int, Int, Int) -> Prop as "DagEntry";
pub let DagEdge: (Int, Int, Int, Int) -> Prop as "DagEdge";
pub let DagHasExit: (Int, Int, Int) -> Prop as "DagHasExit";
pub let DagDepthStep: (Int, Int, Int, Int) -> Prop as "DagDepthStep";
pub let DagTopoRank: (Int, Int, Int, Int) -> Prop as tables::DagTopoRank;
pub let DagNotDom: (Int, Int, Int, Int) -> Prop as "DagNotDom";
pub let DagDom: (Int, Int, Int, Int) -> Prop as "DagDom";
pub let DagStrictDom: (Int, Int, Int, Int) -> Prop as "DagStrictDom";
pub let DagNotPostDom: (Int, Int, Int, Int) -> Prop as "DagNotPostDom";
pub let DagPostDom: (Int, Int, Int, Int) -> Prop as "DagPostDom";
pub let DagStrictPostDom: (Int, Int, Int, Int) -> Prop as "DagStrictPostDom";
pub let DagNonIpdom: (Int, Int, Int, Int) -> Prop as "DagNonIpdom";
pub let DagIpdom: (Int, Int, Int, Int) -> Prop as "DagIpdom";
pub let DagHasIpdom: (Int, Int, Int) -> Prop as "DagHasIpdom";
pub let LoopMember: (Int, Int, Int) -> Prop as "LoopMember";
pub let LoopExit: (Int, Int, Int) -> Prop as "LoopExit";
pub let LoopMultiExit: (Int, Int) -> Prop as "LoopMultiExit";
pub let NatBackedge: (Int, Int, Int, Int) -> Prop as "NatBackedge";
pub let NatExitEdge: (Int, Int, Int, Int, Int) -> Prop as "NatExitEdge";
pub let NatMultiBack: (Int, Int) -> Prop as "NatMultiBack";
pub let NatMultiExitEdge: (Int, Int) -> Prop as "NatMultiExitEdge";
pub let TailLoop: (Int, Int, Int, Int, Int, Int) -> Prop as "TailLoop";
pub let DagOutEdge: (Int, Int, Int, Int, Int) -> Prop as "DagOutEdge";
pub let DagBranch: (Int, Int, Int) -> Prop as "DagBranch";
pub let ArmReach: (Int, Int, Int, Int, Int) -> Prop as "ArmReach";
pub let ArmNotDom: (Int, Int, Int, Int, Int) -> Prop as "ArmNotDom";
pub let ArmBlock: (Int, Int, Int, Int, Int) -> Prop as "ArmBlock";
pub let BranchUnstructured: (Int, Int, Int) -> Prop as "BranchUnstructured";
pub let SeseBranch: (Int, Int, Int) -> Prop as "SeseBranch";
pub let TopoHammock: (Int, Int, Int) -> Prop as "TopoHammock";
pub let HammockMember: (Int, Int, Int, Int) -> Prop as "HammockMember";
pub let HammockNested: (Int, Int, Int) -> Prop as "HammockNested";
pub let TopHammock: (Int, Int, Int) -> Prop as "TopHammock";
pub let ValueDefBlock: (Int, Int, Int) -> Prop as "ValueDefBlock";
pub let OpUseInBlock: (Int, Int, Int) -> Prop as "OpUseInBlock";
pub let NestedUse: (Int, Int, Int) -> Prop as "NestedUse";
pub let ValueUsed: (Int, Int) -> Prop as "ValueUsed";
pub let DeadBlockArg: (Int, Int, Int, Int) -> Prop as "DeadBlockArg";
pub let DeadEdgeUse: (Int, Int, Int) -> Prop as "DeadEdgeUse";
pub let EdgeAssign: (Int, Int, Int, Int, Int) -> Prop as "EdgeAssign";
pub let BlockVarWrite: (Int, Int, Int) -> Prop as "BlockVarWrite";
pub let BlockVarRead: (Int, Int, Int) -> Prop as "BlockVarRead";
pub let BlockLiveIn: (Int, Int, Int) -> Prop as "BlockLiveIn";
pub let BlockLiveOut: (Int, Int, Int) -> Prop as "BlockLiveOut";
pub let LoopWrites: (Int, Int, Int) -> Prop as "LoopWrites";
pub let LoopReads: (Int, Int, Int) -> Prop as "LoopReads";
pub let LoopDemandOut: (Int, Int, Int) -> Prop as "LoopDemandOut";
pub let LoopCarried: (Int, Int, Int) -> Prop as "LoopCarried";
pub let LoopExitOnly: (Int, Int, Int) -> Prop as "LoopExitOnly";
pub let BranchWrites: (Int, Int, Int, Int) -> Prop as "BranchWrites";
pub let BranchReadsMem: (Int, Int, Int, Int) -> Prop as "BranchReadsMem";
pub let BranchDemandOut: (Int, Int, Int, Int) -> Prop as "BranchDemandOut";
