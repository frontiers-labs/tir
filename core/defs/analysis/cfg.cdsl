pub mod dag_contract {
    pub let plain<r, s, m>: (ScopeNode(r, s, m), !ScopeInCycle(r, s, m)) -> (DagMap(r, s, m, m), DagNode(r, s, m));
    pub let irred<r, s, m, rep>: IrredScc(r, s, m, rep) -> (DagMap(r, s, m, rep), DagNode(r, s, rep));
}

pub mod dag_edges {
    pub let root_entry<r, owner, entry, dn>: (CfgRegion(r, owner, entry), DagMap(r, r, entry, dn)) -> DagEntry(r, r, dn);
    pub let loop_entry<r, h, dn>: (NatLoopHeader(r, h), DagMap(r, h, h, dn)) -> DagEntry(r, h, dn);
    pub let edge<r, s, u_raw, v_raw, u, v>:
        (ScopeRawEdge(r, s, u_raw, v_raw), DagMap(r, s, u_raw, u), DagMap(r, s, v_raw, v), ir::equal_id(u, v) == false)
        -> DagEdge(r, s, u, v);
    pub let exit_ret<r, s, b, term, kind, u>: (CfgReachableExit(r, b, term, kind), DagMap(r, s, b, u)) -> DagHasExit(r, s, u);
    pub let exit_back<r, h, b, u>: (NatLoop(r, h, b), CfgEdgeTarget(r, b, h), DagMap(r, h, b, u)) -> DagHasExit(r, h, u);
    pub let exit_loop_out<r, h, b, w, u>:
        (NatLoop(r, h, b), CfgEdgeTarget(r, b, w), !NatLoop(r, h, w), DagMap(r, h, b, u)) -> DagHasExit(r, h, u);
    pub let exit_child_out<r, h, child, b, w, u>:
        (NatLoopParent(r, child, h), NatLoop(r, child, b), CfgEdgeTarget(r, b, w), !NatLoop(r, h, w), DagMap(r, h, child, u))
        -> DagHasExit(r, h, u);
    pub let exit_child_back<r, h, child, b, u>:
        (NatLoopParent(r, child, h), NatLoop(r, child, b), CfgEdgeTarget(r, b, h), DagMap(r, h, child, u))
        -> DagHasExit(r, h, u);
    pub let exit_child_ret<r, s, child, b, term, kind, u>:
        (ScopeNode(r, s, child), NatLoopHeader(r, child), ir::equal_id(child, s) == false, NatLoop(r, child, b), CfgReachableExit(r, b, term, kind), DagMap(r, s, child, u))
        -> DagHasExit(r, s, u);
    pub let exit_irred_ret<r, s, m, rep, b, term, kind>:
        (IrredScc(r, s, m, rep), CfgReachableExit(r, b, term, kind), ir::equal_id(m, b) == true) -> DagHasExit(r, s, rep);
    pub let exit_irred_out<r, h, m, rep, w>:
        (IrredScc(r, h, m, rep), CfgEdgeTarget(r, m, w), !NatLoop(r, h, w)) -> DagHasExit(r, h, rep);
    pub let exit_irred_back<r, h, m, rep>: (IrredScc(r, h, m, rep), CfgEdgeTarget(r, m, h)) -> DagHasExit(r, h, rep);
}

pub mod dag_topo_steps {
    pub let start<r, s, e>: DagEntry(r, s, e) -> DagDepthStep(r, s, e, 0);
    pub let step<r, s, u, v, d>: (DagDepthStep(r, s, u, d), DagEdge(r, s, u, v)) -> DagDepthStep(r, s, v, d + 1);
}

pub mod dag_topo_rank {
    pub let max_rank<r, s, b, d>: DagDepthStep(r, s, b, d) -> DagTopoRank(r, s, b, d);
}

pub mod dag_not_dom {
    pub let dom_start<r, s, e, z>: (DagEntry(r, s, e), DagNode(r, s, z), ir::equal_id(z, e) == false) -> DagNotDom(r, s, e, z);
    pub let dom_prop<r, s, p, h, z>: (DagNotDom(r, s, p, z), DagEdge(r, s, p, h), ir::equal_id(z, h) == false) -> DagNotDom(r, s, h, z);
    pub let pdom_start<r, s, ex, z>: (DagHasExit(r, s, ex), DagNode(r, s, z), ir::equal_id(z, ex) == false) -> DagNotPostDom(r, s, ex, z);
    pub let pdom_prop<r, s, h, n, z>: (DagNotPostDom(r, s, n, z), DagEdge(r, s, h, n), ir::equal_id(z, h) == false) -> DagNotPostDom(r, s, h, z);
}

pub mod dag_dom {
    pub let dom<r, s, d, b>: (DagNode(r, s, d), DagNode(r, s, b), !DagNotDom(r, s, b, d)) -> DagDom(r, s, d, b);
    pub let sdom<r, s, d, b>: (DagNode(r, s, d), DagNode(r, s, b), !DagNotDom(r, s, b, d), ir::equal_id(d, b) == false) -> DagStrictDom(r, s, d, b);
    pub let pdom<r, s, p, b>: (DagNode(r, s, p), DagNode(r, s, b), !DagNotPostDom(r, s, b, p)) -> DagPostDom(r, s, p, b);
    pub let spdom<r, s, p, b>: (DagNode(r, s, p), DagNode(r, s, b), !DagNotPostDom(r, s, b, p), ir::equal_id(p, b) == false) -> DagStrictPostDom(r, s, p, b);
}

pub mod dag_non_ipdom {
    pub let skip<r, s, p, m, b>: (DagStrictPostDom(r, s, p, m), DagStrictPostDom(r, s, m, b)) -> DagNonIpdom(r, s, p, b);
}

pub mod dag_ipdom {
    pub let ipdom<r, s, p, b>: (DagStrictPostDom(r, s, p, b), !DagNonIpdom(r, s, p, b)) -> (DagIpdom(r, s, b, p), DagHasIpdom(r, s, b));
}

pub mod loop_info {
    pub let nat_member<r, h, b>: NatLoop(r, h, b) -> LoopMember(r, h, b);
    pub let irred_block<r, s, m, rep>: (IrredScc(r, s, m, rep), !NatLoopHeader(r, m)) -> LoopMember(r, rep, m);
    pub let irred_child_nat<r, s, m, rep, b>: (IrredScc(r, s, m, rep), NatLoop(r, m, b)) -> LoopMember(r, rep, b);
    pub let nat_back<r, h, latch, slot>: (NatLoop(r, h, latch), CfgEdge(r, latch, slot, h)) -> NatBackedge(r, h, latch, slot);
    pub let nat_exit<r, h, src, slot, dst>: (NatLoop(r, h, src), CfgEdge(r, src, slot, dst), !NatLoop(r, h, dst)) -> NatExitEdge(r, h, src, slot, dst);
}

pub mod loop_exits {
    pub let nat_exit<r, h, src, slot, dst>: NatExitEdge(r, h, src, slot, dst) -> LoopExit(r, h, dst);
    pub let irred_exit<r, s, rep, src, dst>:
        (IrredLoop(r, s, rep), LoopMember(r, rep, src), CfgEdgeTarget(r, src, dst), !LoopMember(r, rep, dst))
        -> LoopExit(r, rep, dst);
}

pub mod loop_shape {
    pub let multi_exit<r, l, a, b>: (LoopExit(r, l, a), LoopExit(r, l, b), ir::equal_id(a, b) == false) -> LoopMultiExit(r, l);
    pub let multi_back_src<r, h, s1, e1, s2, e2>: (NatBackedge(r, h, s1, e1), NatBackedge(r, h, s2, e2), ir::equal_id(s1, s2) == false) -> NatMultiBack(r, h);
    pub let multi_back_slot<r, h, s, e1, e2>: (NatBackedge(r, h, s, e1), NatBackedge(r, h, s, e2), ir::equal_id(e1, e2) == false) -> NatMultiBack(r, h);
    pub let multi_exit_src<r, h, s1, e1, d1, s2, e2, d2>: (NatExitEdge(r, h, s1, e1, d1), NatExitEdge(r, h, s2, e2, d2), ir::equal_id(s1, s2) == false) -> NatMultiExitEdge(r, h);
    pub let multi_exit_slot<r, h, s, e1, d1, e2, d2>: (NatExitEdge(r, h, s, e1, d1), NatExitEdge(r, h, s, e2, d2), ir::equal_id(e1, e2) == false) -> NatMultiExitEdge(r, h);
}

pub mod loop_tail {
    pub let tail<r, h, latch, exit, be, ee, term, pos, disp, loc>:
        (NatLoopHeader(r, h), !LoopMultiExit(r, h), !NatMultiBack(r, h), !NatMultiExitEdge(r, h),
         NatBackedge(r, h, latch, be), NatExitEdge(r, h, latch, ee, exit),
         ir::Operation{ id: term, kind: std::ir::operation_named("cfg.cond_br"), placement: "block", container: latch, position: pos, display: disp, location: loc }())
        -> TailLoop(r, h, latch, exit, be, ee);
}

pub mod dag_out_edges {
    pub let block_internal<r, s, b, slot, dst_raw, dst>:
        (DagNode(r, s, b), !NatLoopHeader(r, b), !IrredLoop(r, s, b), CfgEdge(r, b, slot, dst_raw), DagMap(r, s, dst_raw, dst), ir::equal_id(dst_raw, s) == false)
        -> DagOutEdge(r, s, b, slot, dst);
    pub let header_internal<r, h, slot, dst_raw, dst>:
        (NatLoopHeader(r, h), DagNode(r, h, h), CfgEdge(r, h, slot, dst_raw), DagMap(r, h, dst_raw, dst), ir::equal_id(dst_raw, h) == false)
        -> DagOutEdge(r, h, h, slot, dst);
    pub let block_exit_back<r, h, b, slot>: (DagNode(r, h, b), CfgEdge(r, b, slot, h)) -> DagOutEdge(r, h, b, slot, h);
    pub let block_exit_out<r, h, b, slot, w>: (DagNode(r, h, b), CfgEdge(r, b, slot, w), !NatLoop(r, h, w)) -> DagOutEdge(r, h, b, slot, h);
    pub let loop_exit_internal<r, s, l, w, dst>:
        (DagNode(r, s, l), LoopMultiExit(r, l), LoopExit(r, l, w), DagMap(r, s, w, dst), ir::equal_id(w, s) == false)
        -> DagOutEdge(r, s, l, w, dst);
}

pub mod dag_branches {
    pub let plain<r, s, b>: (DagNode(r, s, b), CfgBranchBlock(r, b), !NatLoopHeader(r, b), !IrredLoop(r, s, b)) -> DagBranch(r, s, b);
    pub let header<r, h>: (NatLoopHeader(r, h), CfgBranchBlock(r, h)) -> DagBranch(r, h, h);
    pub let multi_exit_loop<r, s, l>: (DagNode(r, s, l), LoopMultiExit(r, l), ir::equal_id(l, s) == false) -> DagBranch(r, s, l);
}

pub mod branch_reach {
    pub let base<r, s, h, slot, dst>:
        (DagBranch(r, s, h), DagOutEdge(r, s, h, slot, dst), ir::equal_id(dst, s) == false, !DagIpdom(r, s, h, dst))
        -> ArmReach(r, s, h, slot, dst);
    pub let step<r, s, h, slot, u, v>: (ArmReach(r, s, h, slot, u), DagEdge(r, s, u, v), !DagIpdom(r, s, h, v)) -> ArmReach(r, s, h, slot, v);
    pub let other_base<r, s, h, slot, d1, slot2, d2>:
        (DagBranch(r, s, h), DagOutEdge(r, s, h, slot, d1), DagOutEdge(r, s, h, slot2, d2), ir::equal_id(slot, slot2) == false, ir::equal_id(d2, s) == false, !DagIpdom(r, s, h, d2))
        -> ArmNotDom(r, s, h, slot, d2);
    pub let other_step<r, s, h, slot, u, v>: (ArmNotDom(r, s, h, slot, u), DagEdge(r, s, u, v), !DagIpdom(r, s, h, v)) -> ArmNotDom(r, s, h, slot, v);
}

pub mod branch_arms {
    pub let exclusive<r, s, h, slot, b>: (DagDom(r, s, h, b), ArmReach(r, s, h, slot, b), !ArmNotDom(r, s, h, slot, b)) -> ArmBlock(r, s, h, slot, b);
}

pub mod branch_classify {
    pub let unstruct_direct<r, s, h, slot, w>:
        (DagBranch(r, s, h), DagOutEdge(r, s, h, slot, w), ir::equal_id(w, s) == false, !DagIpdom(r, s, h, w), !ArmBlock(r, s, h, slot, w))
        -> BranchUnstructured(r, s, h);
    pub let unstruct_arm<r, s, h, slot, u, w>:
        (ArmBlock(r, s, h, slot, u), DagEdge(r, s, u, w), !DagIpdom(r, s, h, w), !ArmBlock(r, s, h, slot, w))
        -> BranchUnstructured(r, s, h);
}

pub mod control_tree {
    pub let sese<r, s, h>: (DagBranch(r, s, h), !BranchUnstructured(r, s, h)) -> SeseBranch(r, s, h);
    pub let hammock<r, s, h>: (DagBranch(r, s, h), BranchUnstructured(r, s, h)) -> TopoHammock(r, s, h);
    pub let member_joined<r, s, h, j, b>:
        (DagBranch(r, s, h), BranchUnstructured(r, s, h), DagIpdom(r, s, h, j), DagStrictDom(r, s, h, b), DagStrictPostDom(r, s, j, b))
        -> HammockMember(r, s, h, b);
    pub let member_open<r, s, h, b>:
        (DagBranch(r, s, h), BranchUnstructured(r, s, h), !DagHasIpdom(r, s, h), DagStrictDom(r, s, h, b))
        -> HammockMember(r, s, h, b);
}

pub mod hammock_outer {
    pub let nested<r, s, h1, h2>: (TopoHammock(r, s, h1), TopoHammock(r, s, h2), HammockMember(r, s, h1, h2)) -> HammockNested(r, s, h2);
}

pub mod hammock_top {
    pub let top<r, s, h>: (TopoHammock(r, s, h), !HammockNested(r, s, h)) -> TopHammock(r, s, h);
}

pub mod ssa_defs {
    pub let block_arg<r, owner, entry, b, l, v, ty, slot, decl>:
        (CfgRegion(r, owner, entry), ir::Block(b, r, l), ir::Value(v, ty, "block", b, slot, decl)) -> ValueDefBlock(r, b, v);
    pub let op_res<r, owner, entry, b, l, node, k, p, d, loc, v, ty, slot, decl>:
        (CfgRegion(r, owner, entry), ir::Block(b, r, l), ir::Operation{ id: node, kind: std::ir::operation_named(k), placement: "block", container: b, position: p, display: d, location: loc }(), ir::Value(v, ty, "result", node, slot, decl))
        -> ValueDefBlock(r, b, v);
    pub let use_direct<r, b, node, k, p, d, loc, slot, v>:
        (CfgReachable(r, b), ir::Operation{ id: node, kind: std::ir::operation_named(k), placement: "block", container: b, position: p, display: d, location: loc }(), ir::Operand(node, slot, v)) -> OpUseInBlock(r, b, v);
    pub let use_nested<r, b, outer, k, p, d, loc, sub, m, rs, en, inner, rep, slot, v>:
        (CfgReachable(r, b), ir::Operation{ id: outer, kind: std::ir::operation_named(k), placement: "block", container: b, position: p, display: d, location: loc }(), ir::Region(sub, m, outer, rs, en), ir::ReaderAt(inner, sub, rep), ir::Operand(inner, slot, v))
        -> (OpUseInBlock(r, b, v), NestedUse(r, b, v));
    pub let use_yield<r, b, outer, k, p, d, loc, sub, m, rs, en, slot, v>:
        (CfgReachable(r, b), ir::Operation{ id: outer, kind: std::ir::operation_named(k), placement: "block", container: b, position: p, display: d, location: loc }(), ir::Region(sub, m, outer, rs, en), ir::Yield(sub, slot, v))
        -> (OpUseInBlock(r, b, v), NestedUse(r, b, v));
    pub let edge_assign<r, src, term, k, p, d, loc, edge, dst, pslot, oslot, arg, param, ty, decl>:
        (CfgReachable(r, src), ir::Operation{ id: term, kind: std::ir::operation_named(k), placement: "block", container: src, position: p, display: d, location: loc }(), ir::Successor(term, edge, dst),
         ir::SuccessorArgument(term, edge, pslot, oslot), ir::Operand(term, oslot, arg), ir::Value(param, ty, "block", dst, pslot, decl))
        -> EdgeAssign(r, src, edge, param, arg);
}

pub mod ssa_used {
    pub let used<r, b, v>: OpUseInBlock(r, b, v) -> ValueUsed(r, v);
}

pub mod ssa_dead_args {
    pub let dead<r, owner, entry, b, v, ty, slot, decl>:
        (CfgRegion(r, owner, entry), CfgReachable(r, b), ir::equal_id(b, entry) == false, ir::Value(v, ty, "block", b, slot, decl), !ValueUsed(r, v))
        -> DeadBlockArg(r, b, slot, v);
}

pub mod ssa_dead_edge_uses {
    pub let dead_use<r, term, edge, dst, pslot, oslot, v>:
        (DeadBlockArg(r, dst, pslot, v), ir::Successor(term, edge, dst), ir::SuccessorArgument(term, edge, pslot, oslot))
        -> DeadEdgeUse(r, term, oslot);
}

pub mod demand_block {
    pub let cross_res_direct<r, def_b, v, use_b, node, k, p, d, loc, slot>:
        (ValueDefBlock(r, def_b, v), CfgReachable(r, use_b), ir::equal_id(def_b, use_b) == false,
         ir::Operation{ id: node, kind: std::ir::operation_named(k), placement: "block", container: use_b, position: p, display: d, location: loc }(), ir::Operand(node, slot, v), !DeadEdgeUse(r, node, slot))
        -> (BlockVarWrite(r, def_b, v), BlockVarRead(r, use_b, v));
    pub let cross_res_nested<r, def_b, v, use_b>:
        (ValueDefBlock(r, def_b, v), NestedUse(r, use_b, v), ir::equal_id(def_b, use_b) == false)
        -> (BlockVarWrite(r, def_b, v), BlockVarRead(r, use_b, v));
    pub let edge_param<r, src, edge, param, arg, dst, ty, slot, decl>:
        (EdgeAssign(r, src, edge, param, arg), ir::Value(param, ty, "block", dst, slot, decl), !DeadBlockArg(r, dst, slot, param))
        -> (BlockVarWrite(r, src, param), BlockVarRead(r, dst, param));
    pub let mem_op<r, b, node, chain>: UnthreadedMemOp(r, b, node, chain) -> (BlockVarWrite(r, b, chain), BlockVarRead(r, b, chain));
    pub let mem_exit<r, b, term, kind, chain>: (CfgReachableExit(r, b, term, kind), RegionChain(r, chain)) -> BlockVarRead(r, b, chain);
    pub let ret_val<r, owner, entry, b, term, val>:
        (CfgRegion(r, owner, entry), CfgReachableExit(r, b, term, "func.return"), ir::Operand(term, 0, val)) -> BlockVarWrite(r, b, r);
}

pub mod demand_liveness {
    pub let read<r, b, v>: BlockVarRead(r, b, v) -> BlockLiveIn(r, b, v);
    pub let edge<r, src, dst, v>: (CfgEdgeTarget(r, src, dst), BlockLiveIn(r, dst, v)) -> BlockLiveOut(r, src, v);
    pub let pass<r, b, v>: (BlockLiveOut(r, b, v), !BlockVarWrite(r, b, v)) -> BlockLiveIn(r, b, v);
}

pub mod demand_loops {
    pub let write<r, l, b, v>: (LoopMember(r, l, b), BlockVarWrite(r, b, v)) -> LoopWrites(r, l, v);
    pub let read<r, l, b, v>: (LoopMember(r, l, b), BlockVarRead(r, b, v)) -> LoopReads(r, l, v);
    pub let demand_out<r, l, x, v>: (LoopExit(r, l, x), BlockLiveIn(r, x, v)) -> LoopDemandOut(r, l, v);
    pub let demand_ret<r, owner, entry, l, b, term, val>:
        (CfgRegion(r, owner, entry), LoopMember(r, l, b), CfgReachableExit(r, b, term, "func.return"), ir::Operand(term, 0, val))
        -> LoopDemandOut(r, l, r);
    pub let demand_mem_ret<r, l, b, term, kind, c>:
        (LoopMember(r, l, b), CfgReachableExit(r, b, term, kind), RegionChain(r, c)) -> LoopDemandOut(r, l, c);
}

pub mod demand_loop_ports {
    pub let carried_read<r, l, v>: (LoopWrites(r, l, v), LoopReads(r, l, v)) -> LoopCarried(r, l, v);
    pub let carried_out<r, l, v>: (LoopWrites(r, l, v), LoopDemandOut(r, l, v)) -> LoopCarried(r, l, v);
    pub let exit_only<r, l, v>: (LoopWrites(r, l, v), LoopDemandOut(r, l, v), !LoopReads(r, l, v)) -> LoopExitOnly(r, l, v);
}

pub mod demand_branches {
    pub let write_arm_block<r, s, h, slot, b, v>: (ArmBlock(r, s, h, slot, b), BlockVarWrite(r, b, v)) -> BranchWrites(r, s, h, v);
    pub let write_arm_loop<r, s, h, slot, l, v>: (ArmBlock(r, s, h, slot, l), LoopWrites(r, l, v)) -> BranchWrites(r, s, h, v);
    pub let write_direct_edge<r, s, h, slot, param, arg, dst, ty, pslot, decl>:
        (SeseBranch(r, s, h), EdgeAssign(r, h, slot, param, arg), ir::Value(param, ty, "block", dst, pslot, decl), !DeadBlockArg(r, dst, pslot, param))
        -> BranchWrites(r, s, h, param);
    pub let write_hammock_block<r, s, h, b, v>: (TopHammock(r, s, h), HammockMember(r, s, h, b), BlockVarWrite(r, b, v)) -> BranchWrites(r, s, h, v);
    pub let write_hammock_loop<r, s, h, l, v>: (TopHammock(r, s, h), HammockMember(r, s, h, l), LoopWrites(r, l, v)) -> BranchWrites(r, s, h, v);
    pub let mem_arm_block<r, s, h, slot, b, c>: (ArmBlock(r, s, h, slot, b), RegionChain(r, c), BlockVarRead(r, b, c)) -> BranchReadsMem(r, s, h, c);
    pub let mem_arm_loop<r, s, h, slot, l, c>: (ArmBlock(r, s, h, slot, l), RegionChain(r, c), LoopReads(r, l, c)) -> BranchReadsMem(r, s, h, c);
    pub let mem_hammock_block<r, s, h, b, c>: (TopHammock(r, s, h), HammockMember(r, s, h, b), RegionChain(r, c), BlockVarRead(r, b, c)) -> BranchReadsMem(r, s, h, c);
    pub let mem_hammock_loop<r, s, h, l, c>: (TopHammock(r, s, h), HammockMember(r, s, h, l), RegionChain(r, c), LoopReads(r, l, c)) -> BranchReadsMem(r, s, h, c);
    pub let demand_join<r, s, h, j, v>: (DagBranch(r, s, h), DagIpdom(r, s, h, j), BlockLiveIn(r, j, v)) -> BranchDemandOut(r, s, h, v);
    pub let demand_join_loop<r, s, h, j, v>: (DagBranch(r, s, h), DagIpdom(r, s, h, j), LoopReads(r, j, v)) -> BranchDemandOut(r, s, h, v);
    pub let demand_root_ret<r, owner, entry, h>: (CfgRegion(r, owner, entry), DagBranch(r, r, h), !DagHasIpdom(r, r, h)) -> BranchDemandOut(r, r, h, r);
    pub let demand_root_mem<r, h, c>: (DagBranch(r, r, h), !DagHasIpdom(r, r, h), RegionChain(r, c)) -> BranchDemandOut(r, r, h, c);
    pub let demand_loop_body<r, lh, h, v>: (DagBranch(r, lh, h), !DagHasIpdom(r, lh, h), NatLoopHeader(r, lh), LoopCarried(r, lh, v)) -> BranchDemandOut(r, lh, h, v);
}

pub mod demand_branch_outputs {
    pub let output<r, s, h, v>: (BranchWrites(r, s, h, v), BranchDemandOut(r, s, h, v)) -> BranchOutput(r, s, h, v);
}
