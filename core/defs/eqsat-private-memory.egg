(relation EQImplicitStore (i64 i64 i64))
(rule ((EQRoot root) (Within root store) (= (OpKind store) "ptr.store")
       (= value (Operand store 0)) (= pointer (Operand store 1)) (not (Operand store 2 extra))
       (not (Result store slot extra)) (not (OwnedRegion store slot child))
       (= (Attribute store "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))))
      ((EQImplicitStore store value pointer)) :ruleset EQscalar-scope)
(relation EQOrdinaryLayout (i64))
(relation EQLayoutSpec (Attr))
(relation EQMalformedLayout (i64))
(rule ((EQRoot root) (= spec (LayoutSpecAttr entries options)))
      ((EQLayoutSpec spec)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (= owned (OwnedRegion owner slot)) (OpUnderRegion owned op)
       (= spec (Attribute owner "layout.spec")) (not (EQLayoutSpec spec)))
      ((EQMalformedLayout op)) :ruleset EQscopes)
(relation EQExplicitCellLayout (i64))
(rule ((EQRoot root) (Within root op) (= region (OwnedRegion owner slot))
       (OpUnderRegion region op) (= spec (Attribute owner "layout.spec")) (EQLayoutSpec spec))
      ((EQExplicitCellLayout op)) :ruleset EQscalar-scope)
(relation EQPointerCellType (i64 TypeExpr))
(rule ((EQRoot root) (Within root load) (= (OpKind load) "ptr.load")
       (= pointer (Operand load 0)) (Result load 0 value)
       (= ty (ValueType value)) (= ty (Apply (Ctor "ptr.p") args))
       (= (ValueType pointer) (Apply (Ctor "ptr.p") (TNil))))
      ((EQPointerCellType pointer ty)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root load) (= (OpKind load) "ptr.load")
       (= pointer (Operand load 0)) (Result load 0 value)
       (= ty (ValueType value)) (= ty (Apply (Ctor "ptr.p") args))
       (= (ValueType pointer) (Apply (Ctor "ptr.p") (TCons ty (TNil)))))
      ((EQPointerCellType pointer ty)) :ruleset EQscalar-scope)

;; A fresh ordinary scalar cell is private only when every address use is a
;; complete access. Loads and every write of a read cell must share its block.
(relation EQCellWidth (BigInt String))
(EQCellWidth (from-string "8") "0000000000000001")
(EQCellWidth (from-string "16") "0000000000000002")
(EQCellWidth (from-string "32") "0000000000000004")
(EQCellWidth (from-string "64") "0000000000000008")
(relation EQCellAlignment (String))
(EQCellAlignment "0000000000000001")
(EQCellAlignment "0000000000000002")
(EQCellAlignment "0000000000000004")
(EQCellAlignment "0000000000000008")
(relation EQPrivateCell (i64 i64 i64 i64 TypeExpr))
(relation EQCellRead (i64 i64 i64 i64))
(relation EQCellWrite (i64 i64 i64 i64))
(relation EQCellScopedWrite (i64 i64 i64))
(relation EQCellAddressUse (i64 i64 UseSite))
(relation EQCellBefore (i64 i64 i64 i64))
(relation EQCellIntervening (i64 i64))
(relation EQCellBlocked (i64))
(relation EQCellElide (i64 i64))

(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= function (OwningFunction allocation))
       (= (OpPlacement allocation) (InBlock block order)) (= region (BlockRegion block))
       (Result allocation 0 pointer) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (= (ValueType pointer) (Apply (Ctor "ptr.p") (TCons ty (TNil))))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (EQCellWidth width bytes)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 bytes))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment))
      ((EQPrivateCell allocation pointer block region ty)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root allocation) (= (OpKind allocation) "ptr.alloca")
       (HasInterface allocation "dyn tir::interfaces::PromotableAllocation")
       (= (OpPlacement allocation) (InBlock block order)) (= region (BlockRegion block))
       (Result allocation 0 pointer) (not (Result allocation 1 extra))
       (not (Operand allocation slot input)) (not (OwnedRegion allocation slot child))
       (EQPointerCellType pointer ty)
       (EQExplicitCellLayout allocation)
       (= (Attribute allocation "size") (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000008"))
       (= (Attribute allocation "align") (IntegerAttr (Ctor "$attr.unsigned") 64 alignment))
       (EQCellAlignment alignment))
      ((EQPrivateCell allocation pointer block region ty)) :ruleset EQscalar-scope)

(rule ((EQPrivateCell allocation pointer block region ty)
       (= (OpPlacement allocation) (InBlock block start))
       (BlockMember block order load) (> order start) (= (OpKind load) "ptr.load")
       (= pointer (Operand load 0)) (not (Operand load 1 extra))
       (Result load 0 value) (not (Result load 1 extra)) (= ty (ValueType value))
       (not (OwnedRegion load slot child))
       (= (Attribute load "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil))))))
      ((EQCellRead allocation load order value)
       (EQCellAddressUse allocation load (OperandUse 0))) :ruleset EQscalar-scope)
(rule ((EQPrivateCell allocation pointer block region ty)
       (OpUnderRegion region store) (EQImplicitStore store value pointer) (= ty (ValueType value)))
      ((EQCellScopedWrite allocation store value)
       (EQCellAddressUse allocation store (OperandUse 1))) :ruleset EQscalar-scope)
(rule ((EQPrivateCell allocation pointer block region ty)
       (EQCellScopedWrite allocation store value)
       (= (OpPlacement allocation) (InBlock block start))
       (BlockMember block order store) (> order start))
      ((EQCellWrite allocation store order value)) :ruleset EQscalar-scope)
(rule ((EQCellRead allocation load after result) (EQCellWrite allocation store before input) (< before after))
      ((EQCellBefore allocation load store input)) :ruleset EQscalar-scope)
(rule ((EQCellRead allocation load after result) (EQCellWrite allocation first before input)
       (EQCellWrite allocation second middle other) (< before middle) (< middle after))
      ((EQCellIntervening load first)) :ruleset EQscalar-scope)

;; An immediately read pointer holder provides an existing private-cell address.
(relation EQCellAlias (i64 i64 i64))
(rule ((EQPrivateCell allocation pointer block region ty)
       (EQPrivateCell holder address block region pointer_type)
       (EQCellWrite holder store before pointer) (EQCellRead holder load after alias)
       (= after (+ before 1)) (= (ValueType pointer) (ValueType alias)))
      ((EQCellAlias allocation alias store)) :ruleset EQscalar-scope)
(rule ((EQCellAlias allocation alias store))
      ((EQCellAddressUse allocation store (OperandUse 0))) :ruleset EQscalar-scope)
(rule ((EQPrivateCell allocation pointer block region ty) (EQCellAlias allocation alias origin)
       (OpUnderRegion region store) (EQImplicitStore store value alias) (= ty (ValueType value)))
      ((EQCellScopedWrite allocation store value)
       (EQCellAddressUse allocation store (OperandUse 1))) :ruleset EQscalar-scope)
(rule ((EQCellAlias allocation alias origin) (Uses alias reader site)
       (not (EQCellAddressUse allocation reader site)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellAlias allocation alias origin) (EQScalarAttrRef attr alias))
      ((EQCellBlocked allocation)) :ruleset EQscopes)

;; A read keeps the same-block reaching-store proof closed over every write.
(rule ((EQCellRead allocation load order value) (EQCellScopedWrite allocation store input)
       (not (EQCellWrite allocation store position input)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (Uses pointer reader site)
       (not (EQCellAddressUse allocation reader site)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (EQScalarAttrRef attr pointer))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (= attr (Attribute allocation key))
       (!= key "size") (!= key "align"))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellAddressUse allocation access site) (= attr (Attribute access key)) (!= key "operand_segment_sizes"))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellRead allocation load order value) (not (EQCellBefore allocation load store input)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellRead allocation load order value) (EQPrivateCell allocation pointer block region ty)
       (Uses value reader site) (not (OpRegion reader region)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellRead allocation load order value) (EQPrivateCell allocation pointer block region ty)
       (Uses value reader site) (= (OpPlacement reader) (InBlock other position)) (!= block other))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellRead allocation load order value) (EQScalarAttrRef attr value))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (not (EQOrdinaryLayout allocation)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellAddressUse allocation access site) (not (EQOrdinaryLayout access)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (EQMalformedLayout allocation))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQCellAddressUse allocation access site) (EQMalformedLayout access))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
;; The flat memory model permits another access to observe these allocation
;; bytes. Admit a closed group only, including every allocation and memory op.
(rule ((EQPrivateCell allocation pointer block region ty) (= function (OwningFunction allocation))
       (= function (OwningFunction other)) (= (OpKind other) "ptr.alloca")
       (not (EQPrivateCell other address place scope value_type)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (= function (OwningFunction allocation))
       (= function (OwningFunction other)) (HasInterface other "dyn tir::interfaces::ResourceEffects")
       (!= (OpKind other) "fp.div")
       (not (EQCellAddressUse candidate other site)))
      ((EQCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQPrivateCell allocation pointer block region ty) (= function (OwningFunction allocation))
       (= function (OwningFunction other)) (EQCellBlocked other))
      ((EQCellBlocked allocation)) :ruleset EQscopes)

(rule ((EQPrivateCell a pointer block region first) (EQPrivateCell a pointer block region second)
       (!= first second)) ((EQCellBlocked a)) :ruleset EQscopes)

(rule ((EQSeed region) (EQPrivateCell allocation pointer block region ty) (not (EQCellBlocked allocation)))
      ((EQCellElide region allocation)) :ruleset EQassumptions)
(rule ((EQCellElide region allocation) (EQCellRead allocation load order value)
       (EQCellBefore allocation load store input) (not (EQCellIntervening load store)))
      ((EQExactReplacement region value input)) :ruleset EQassumptions)
(rule ((EQCellElide region allocation) (EQCellRead allocation load order value))
      ((EQCellElide region load)) :ruleset EQassumptions)
(rule ((EQCellElide region allocation) (EQCellScopedWrite allocation store value))
      ((EQCellElide region store)) :ruleset EQassumptions)

(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQCellElide scope op))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p op) (EQEraseOpPlacement p op) (EQEraseOpLocation p op) (EQEraseGraphLayout p op))
      :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQCellElide scope op) (= input (Operand op slot)))
      ((let p (EQProposal invocation root scope root)) (EQEraseOperand p op slot)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQCellElide scope op) (= attr (Attribute op key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p op key)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQCellElide scope op) (Result op slot value))
      ((let p (EQProposal invocation root scope root))
       (EQEraseValueDefinition p value) (EQEraseValueType p value) (EQEraseDeclaredType p value)) :ruleset EQscoped-edits)

;; Full-width CFG writes may cross total integer scalars that retain their placement.
;; Value producers remain in the ordered block, including producers that fault.
(relation EQImplicitStoreTransparent (i64))
(rule ((EQScalarSupported block op value) (EQCanSpeculate op)
       (not (HasInterface op "dyn tir::interfaces::ResourceEffects"))
       (= (ValueType value) (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil))))
       (not (OwnedRegion op slot region)))
      ((EQImplicitStoreTransparent op)) :ruleset EQscalar-scope)
(relation EQImplicitStoreDisjointRead (i64 i64))
(relation EQImplicitStorePair (i64 i64))
(relation EQImplicitStoreBlocked (i64 i64))
(rule ((EQImplicitStore first x pointer) (EQImplicitStore last y pointer)
       (= ty (ValueType x)) (= ty (ValueType y))
       (= ty (Apply (Ctor "builtin.i") (TCons (NatLit width) (TNil)))) (EQStoreWidth width)
       (EQOrdinaryLayout first) (EQOrdinaryLayout last)
       (BlockMember block before first) (BlockMember block after last) (< before after))
      ((EQImplicitStorePair first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last) (EQMalformedLayout first))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last) (EQMalformedLayout last))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last) (EQStoreExtra first))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last) (EQStoreExtra last))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last)
       (= (OpPlacement first) (InBlock block before)) (= (OpPlacement last) (InBlock block after))
       (BlockMember block order between) (> order before) (< order after)
       (not (EQImplicitStoreTransparent between)) (not (EQImplicitStoreDisjointRead first between)))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQImplicitStorePair first last)
       (= (OpPlacement first) (InBlock block before)) (= (OpPlacement last) (InBlock block after))
       (BlockMember block order between) (> order before) (< order after)
       (= attr (Attribute between key)) (!= key "value") (not (EQImplicitStoreDisjointRead first between)))
      ((EQImplicitStoreBlocked first last)) :ruleset EQscopes)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope first) (EQUse scope last)
       (EQImplicitStorePair first last) (not (EQImplicitStoreBlocked first last)))
      ((let p (EQProposal invocation root scope root)) (EQScopedAuthorized p)
       (EQEraseOpKind p first) (EQEraseOpPlacement p first) (EQEraseOpLocation p first) (EQEraseGraphLayout p first)
       (EQEraseOperand p first 0) (EQEraseOperand p first 1)) :ruleset EQscoped-edits)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed scope) (EQUse scope first) (EQUse scope last)
       (EQImplicitStorePair first last) (not (EQImplicitStoreBlocked first last)) (= attr (Attribute first key)))
      ((let p (EQProposal invocation root scope root)) (EQEraseAttribute p first key)) :ruleset EQscoped-edits)

;; Adjacent ordinary CFG reads retain the first read, including its faults.
(relation EQReadPair (i64 i64 i64 i64 i64 i64))
(relation EQReadExtra (i64))
(relation EQReadBlocked (i64))
(rule ((EQRoot root) (Within root op) (= (OpKind op) "ptr.load")
       (= attr (Attribute op key)) (!= key "operand_segment_sizes"))
      ((EQReadExtra op)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root first) (Within root last)
       (BlockMember block before first) (BlockMember block after last) (= after (+ before 1))
       (= region (BlockRegion block)) (= (OpKind first) "ptr.load") (= (OpKind last) "ptr.load")
       (= pointer (Operand first 0)) (= pointer (Operand last 0))
       (not (Operand first 1 extra)) (not (Operand last 1 extra))
       (Result first 0 old) (not (Result first 1 extra))
       (Result last 0 new) (not (Result last 1 extra))
       (= ty (ValueType old)) (= ty (ValueType new)) (EQStoreType ty)
       (not (OwnedRegion first slot child)) (not (OwnedRegion last slot child))
       (= (Attribute first "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil)))))
       (= (Attribute last "operand_segment_sizes") (Attribute first "operand_segment_sizes")))
      ((EQReadPair first last block region old new)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (Within root first) (Within root last)
       (BlockMember block before first) (BlockMember block after last) (= after (+ before 1))
       (= region (BlockRegion block)) (= (OpKind first) "ptr.load") (= (OpKind last) "ptr.load")
       (= pointer (Operand first 0)) (= pointer (Operand last 0))
       (= input (Operand first 1)) (not (Operand first 2 extra))
       (Result first 0 old) (Result first 1 state) (not (Result first 2 extra))
       (= state (Operand last 1)) (not (Operand last 2 extra))
       (Result last 0 new) (not (Result last 1 extra))
       (= ty (ValueType old)) (= ty (ValueType new)) (EQStoreType ty)
       (not (OwnedRegion first slot child)) (not (OwnedRegion last slot child))
       (= (Attribute first "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001") (ANil)))))
       (= (Attribute last "operand_segment_sizes") (Attribute first "operand_segment_sizes")))
      ((EQReadPair first last block region old new)) :ruleset EQscalar-scope)
(rule ((EQReadPair first last block region old new) (EQReadExtra first))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (EQReadExtra last))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (not (EQOrdinaryLayout first)))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (not (EQOrdinaryLayout last)))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (EQMalformedLayout first))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (EQMalformedLayout last))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (Uses new reader site) (not (OpRegion reader region)))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (Uses new reader site)
       (= (OpPlacement reader) (InBlock other order)) (!= other block))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQReadPair first last block region old new) (EQScalarAttrRef attr new))
      ((EQReadBlocked last)) :ruleset EQscopes)
(rule ((EQSeed region) (EQReadPair first last block region old new) (not (EQReadBlocked last)))
      ((EQExactReplacement region new old) (EQCellElide region last)) :ruleset EQassumptions)

;; A successful ordinary store supplies an immediately following equal-width read.
(rule ((EQImplicitStore first old pointer) (not (EQStoreExtra first))
       (BlockMember block before first) (BlockMember block after last) (= after (+ before 1))
       (= region (BlockRegion block)) (= (OpKind last) "ptr.load")
       (= pointer (Operand last 0)) (not (Operand last 1 extra))
       (Result last 0 new) (not (Result last 1 extra))
       (= ty (ValueType old)) (= ty (ValueType new)) (EQStoreType ty)
       (not (OwnedRegion last slot child))
       (= (Attribute last "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil))))))
      ((EQReadPair first last block region old new)) :ruleset EQscalar-check)

;; One complete integer cell starts constant and every later write is an
;; adjacent same-cell readback. Closed effects preserve both bytes and init bits.
(relation EQConstCell (i64 i64 i64 TypeExpr i64 String))
(relation EQConstCellRead (i64 i64 i64 i64 i64))
(relation EQConstCellUse (i64 i64 UseSite))
(relation EQConstCellWriteback (i64 i64))
(relation EQConstCellBetween (i64 i64))
(relation EQConstCellBlocked (i64))

(rule ((EQRoot root) (EQPrivateCell allocation pointer entry region ty) (Result allocation 0 pointer)
       (= entry (Entry region)) (= function (RegionOwner region))
       (= (OpKind function) "func.func")
       (EQCellWrite allocation initial order value) (EQConstantFact value ty bits zeros))
      ((EQConstCell allocation pointer region ty initial bits)
       (EQConstCellUse allocation initial (OperandUse 1))) :ruleset EQscalar-scope)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (BlockMember block order load) (= region (BlockRegion block))
       (= (OpKind load) "ptr.load") (= pointer (Operand load 0))
       (not (Operand load 1 extra)) (Result load 0 value) (not (Result load 1 extra))
       (= ty (ValueType value)) (not (OwnedRegion load slot child))
       (= (Attribute load "operand_segment_sizes")
          (ListAttr (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000001")
                    (ACons (IntegerAttr (Ctor "$attr.unsigned") 64 "0000000000000000") (ANil))))))
      ((EQConstCellRead allocation load block order value)
       (EQConstCellUse allocation load (OperandUse 0))) :ruleset EQscalar-scope)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (EQConstCellRead allocation load block before value) (EQImplicitStore store value pointer)
       (BlockMember block after store) (BlockMember block middle between)
       (< before middle) (< middle after))
      ((EQConstCellBetween load store)) :ruleset EQscalar-scope)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (EQConstCellRead allocation load block before value)
       (EQImplicitStore store value pointer) (BlockMember block after store) (> after before)
       (not (EQConstCellBetween load store)))
      ((EQConstCellWriteback allocation store)
       (EQConstCellUse allocation store (OperandUse 1))) :ruleset EQscalar-check)

(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (Uses pointer user site) (not (EQConstCellUse allocation user site)))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (EQScalarAttrRef attr pointer))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (= attr (Attribute allocation key)) (!= key "size") (!= key "align"))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (EQCellScopedWrite allocation store value) (!= store initial)
       (not (EQConstCellWriteback allocation store)))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (EQConstCellRead allocation load entry before value) (= entry (Entry region))
       (BlockMember entry after initial) (<= before after))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCellUse allocation access site)
       (= attr (Attribute access key)) (!= key "operand_segment_sizes"))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (not (EQOrdinaryLayout allocation)))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (EQMalformedLayout allocation))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCellUse allocation access site) (not (EQOrdinaryLayout access)))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCellUse allocation access site) (EQMalformedLayout access))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (= function (OwningFunction allocation)) (= function (OwningFunction other))
       (= (OpKind other) "ptr.alloca") (!= allocation other))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)
(rule ((EQRoot root) (EQConstCell allocation pointer region ty initial bits)
       (= function (OwningFunction allocation)) (= function (OwningFunction other))
       (HasInterface other "dyn tir::interfaces::ResourceEffects")
       (not (EQConstCellUse allocation other site)))
      ((EQConstCellBlocked allocation)) :ruleset EQscopes)

(rule ((EQRoot root) (EQSeed region) (EQConstCell allocation pointer region ty initial bits)
       (not (EQConstCellBlocked allocation)))
      ((EQCellElide region allocation) (EQCellElide region initial)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQSeed region) (EQConstCell allocation pointer region ty initial bits)
       (not (EQConstCellBlocked allocation)) (EQConstCellWriteback allocation store))
      ((EQCellElide region store)) :ruleset EQassumptions)
(rule ((EQRoot root) (EQInvocation invocation root) (EQSeed region)
       (EQConstCell allocation pointer region ty initial bits) (not (EQConstCellBlocked allocation))
       (EQConstCellRead allocation load block order value))
      ((let p (EQProposal invocation root region root)) (EQScopedAuthorized p)
       (EQPutOpKind p load "builtin.constant") (EQEraseOperand p load 0)
       (EQEraseAttribute p load "operand_segment_sizes")
       (EQPutAttribute p load "value" (IntegerAttr (Ctor "$attr.wide")
                              (eqsat-storage-width bits) (eqsat-storage-bits bits)))) :ruleset EQscoped-edits)
