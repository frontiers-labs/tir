/// preceding PTX levels and does not imply complete version support.
///
/// See [PTX ISA 2.2 release notes](https://docs.nvidia.com/cuda/parallel-thread-execution/#changes-in-ptx-isa-version-2-2).
isa PTX_2_2 requires PTX_2_1 {}
/// PTX 2.3 feature level for instruction availability. This cumulative TIR feature includes
/// preceding PTX levels and does not imply complete version support.
///
/// See [PTX ISA 2.3 release notes](https://docs.nvidia.com/cuda/parallel-thread-execution/#changes-in-ptx-isa-version-2-3).
isa PTX_2_3 requires PTX_2_2 {}
