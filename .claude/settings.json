{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "env -u __MISE_SHIM -u LD_LIBRARY_PATH node \"$CLAUDE_PROJECT_DIR/.agents/hooks/no-scripts.js\"",
            "onFailure": "block",
            "statusMessage": "Checking script policy"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u __MISE_SHIM -u LD_LIBRARY_PATH node \"$CLAUDE_PROJECT_DIR/.agents/hooks/no-scripts.js\"",
            "statusMessage": "Checking script policy"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "env -u __MISE_SHIM -u LD_LIBRARY_PATH node \"$CLAUDE_PROJECT_DIR/.agents/hooks/no-scripts.js\"",
            "statusMessage": "Checking script policy"
          }
        ]
      }
    ]
  }
}
