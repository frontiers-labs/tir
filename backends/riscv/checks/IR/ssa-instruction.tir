// RUN: tir mc --march=riscv64 --stage=isel %s | filecheck %s
// RUN: tir mc --march=riscv64 --stage=isel %s | tir mc --march=riscv64 --stage=isel - | filecheck %s
module {
  %f = func.func @data(%x: !riscv.GPR, %y: !riscv.GPR) -> !riscv.GPR {
    %sum = riscv.add %x, %y : !riscv.GPR
    %result = riscv.add %sum, %x : !riscv.GPR
    func.return %result
  }
  module_end
}
// CHECK-LABEL: func.func @data(%[[X:[0-9]+]]: !riscv.GPR, %[[Y:[0-9]+]]: !riscv.GPR) -> !riscv.GPR
// CHECK: %[[SUM:[0-9]+]] = riscv.add %[[X]], %[[Y]] : !riscv.GPR
// CHECK-NEXT: %[[RESULT:[0-9]+]] = riscv.add %[[SUM]], %[[X]] : !riscv.GPR
// CHECK-NEXT: func.return %[[RESULT]]
