// RUN: tir mc --march=riscv64 --stage=isel %s | filecheck %s
// RUN: tir mc --march=riscv64 --stage=isel %s | tir mc --march=riscv64 --stage=isel - | filecheck %s
module {
  %f = func.func @data(%x: !i64, %y: !i64) -> !i64 {
    %sum = riscv.add %x, %y : !i64
    %result = riscv.add %sum, %x : !i64
    func.return %result
  }
  module_end
}
// CHECK-LABEL: func.func @data(%[[X:[0-9]+]]: !i64, %[[Y:[0-9]+]]: !i64) -> !i64
// CHECK: %[[SUM:[0-9]+]] = riscv.add %[[X]], %[[Y]] : !i64
// CHECK-NEXT: %[[RESULT:[0-9]+]] = riscv.add %[[SUM]], %[[X]] : !i64
// CHECK-NEXT: func.return %[[RESULT]]
