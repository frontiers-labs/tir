// RUN: tir mc --march=rv64im --stage=regalloc %s | filecheck %s
// RUN: tir mc --march=rv64im --filetype=obj-ascii %s | filecheck %s --check-prefix=OBJ

// An indirect call holds the callee address in a scratch register
// distinct from the a0 argument, and finalizes to a linking `jalr ra`.

module {
  %fn_caller = func.func @caller(%0: !ptr.p, %1: !i32) -> !i32 {
    %3 = ptr_to_fn %0 : !fn<(!i32) -> !i32>
    %2 = func.call %3(%1 : !i32) -> !i32
    func.return %2
  }
  module_end
}

// CHECK: asm.symbol {name = "caller"
// CHECK: riscv.addi {rd = %{{[0-9]+}}:x5, rs1 = %{{[0-9]+}}:x10, imm = 0}
// CHECK: asm.vcall_indirect %{{[0-9]+}}{{.*}} state(%{{[0-9]+}}, %{{[0-9]+}}) {

// jalr x1, 0(x5): the call goes through the scratch register and links ra.
// OBJ: caller:
// OBJ: [0xE7, 0x80, 0x02, 0x00]
