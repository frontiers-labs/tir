// RUN: tir mc --march=rv64i --filetype=obj-ascii %s | filecheck %s

module {
  %fn_select = func.func @select(%0: !i1) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %1 = constant {value = 1} : !i32
    func.return %1
  ^bb2:
    %2 = constant {value = 0} : !i32
    func.return %2
  }
  module_end
}

// The false arm follows the conditional branch. Each arm materializes its
// result locally and returns directly; the bytes check the branch fixup.
// CHECK: .section .text
// CHECK-NEXT: select:
// CHECK-NEXT: [0x93, 0x72, 0x15, 0x00]
// CHECK-NEXT: [0x63, 0x98, 0x02, 0x00]
// CHECK-NEXT: [0x6F, 0x00, 0x40, 0x00]
// CHECK-NEXT: [0x13, 0x05, 0x00, 0x00]
// CHECK-NEXT: [0x67, 0x80, 0x00, 0x00]
// CHECK-NEXT: [0x13, 0x05, 0x10, 0x00]
// CHECK-NEXT: [0x67, 0x80, 0x00, 0x00]
