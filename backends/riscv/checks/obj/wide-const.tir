// RUN: tir mc --march=rv64i --filetype=obj-ascii %s | filecheck %s

module {
  %fn_big = func.func @big() -> !i32 {
    %0 = constant {value = 74565} : !i32
    func.return %0
  }
  module_end
}

// 0x12345 does not fit 12 bits: matching splits it at its own 32-bit width
// into (18 << 12) + 0x345, the upper part a lui and the rest an addiw, which
// keeps 32-bit sign-extension semantics:
//   lui x5, 18; addiw a0, x5, 0x345
// CHECK: big:
// CHECK-NEXT: [0xB7, 0x22, 0x01, 0x00]
// CHECK-NEXT: [0x1B, 0x85, 0x52, 0x34]
// CHECK-NEXT: [0x67, 0x80, 0x00, 0x00]
