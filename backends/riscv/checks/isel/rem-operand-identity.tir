// RUN: tir mc --march=riscv64 --stage=isel %s | filecheck %s

// `remw` is defined as `rs1 - (rs1 / rs2) * rs2`, which reads both operands
// twice. Two occurrences of one operand name one value, so an expression
// subtracting a different dividend than the one it divides is not that
// remainder and selects the arithmetic it spells.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = constant {value = 7} : !i32
    %2 = constant {value = 61} : !i32
    %3 = divsi %2, %0 : !i32
    %4 = muli %3, %3 : !i32
    %5 = subi %1, %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: name = "f"
// CHECK: riscv.divw
// CHECK-NEXT: riscv.mulw
// CHECK-NEXT: riscv.subw
// CHECK-NOT: riscv.rem
