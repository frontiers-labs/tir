// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s --check-prefixes=CHECK,RV64
// RUN: tir mc --march=rv32i --stage=isel %s | filecheck %s --check-prefixes=CHECK,RV32

module {
  %fn_chain = func.func @chain(%0: !i32, %1: !i32) -> !i32 {
    %2 = addi %0, %1 : !i32
    %3 = subi %2, %1 : !i32
    %4 = andi %3, %0 : !i32
    %5 = ori %4, %1 : !i32
    func.return %5
  }
  module_end
}

// CHECK: asm.symbol {name = "chain", arg_regs = [%[[V0:[0-9]+]]:GPR, %[[V1:[0-9]+]]:GPR]
// RV64: riscv.addw {rd = %[[V2:[0-9]+]]:GPR, rs1 = %[[V0]]:GPR, rs2 = %[[V1]]:GPR}
// RV64: riscv.subw {rd = %[[V3:[0-9]+]]:GPR, rs1 = %[[V2]]:GPR, rs2 = %[[V1]]:GPR}
// RV32: riscv.add {rd = %[[V2:[0-9]+]]:GPR, rs1 = %[[V0]]:GPR, rs2 = %[[V1]]:GPR}
// RV32: riscv.sub {rd = %[[V3:[0-9]+]]:GPR, rs1 = %[[V2]]:GPR, rs2 = %[[V1]]:GPR}
// CHECK: riscv.and {rd = %[[V4:[0-9]+]]:GPR, rs1 = %[[V0]]:GPR, rs2 = %[[V3]]:GPR}
// CHECK: riscv.or {rd = %[[V5:[0-9]+]]:GPR, rs1 = %[[V1]]:GPR, rs2 = %[[V4]]:GPR}
// CHECK: asm.vret
