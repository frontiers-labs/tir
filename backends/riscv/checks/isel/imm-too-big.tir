// RUN: tir mc --march=rv64i --filetype=asm %s | filecheck %s

// 2048 does not fit `addi`'s signed 12-bit immediate field: the encoding
// would truncate to -2048. The immediate rule refuses the offset whole, and
// matching splits it into the field's extreme and the rest, 2047 + 1, two
// additions whose immediates fit. Never a truncated encoding.

module {
  %fn_big = func.func @big(%0: !i64) -> !i64 {
    %1 = constant {value = 2048} : !i64
    %2 = addi %0, %1 : !i64
    func.return %2
  }
  module_end
}

// CHECK: addi x5, x10, 1
// CHECK-NEXT: addi x10, x5, 2047
