// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// A guard fact is inherited two levels down: the entry's true edge reaches the
// jump-only block, and through it the block re-computing the identical compare.
// Restructuring makes that compare the test of a gate nested in the first gate's
// arm, and the arm's fact decides that test, so nothing is re-selected.

module {
  func.func @nested(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    cfg.br ^bb3
  ^bb2:
    %3 = constant {value = 0} : !i64
    func.return %3
  ^bb3:
    %4 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %4, ^bb4, ^bb5
  ^bb4:
    %5 = constant {value = 1} : !i64
    func.return %5
  ^bb5:
    %6 = constant {value = 2} : !i64
    func.return %6
  }
  module_end
}

// The entry fuses the compare-and-branch; the jump-only block is gone, and the
// arm decides its own gate without testing anything.
// CHECK: riscv.blt {rs1 = %virt{{[0-9]+}}:GPR, rs2 = %virt{{[0-9]+}}:GPR, imm = ^[[ARM:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^bb{{[0-9]+}}
// CHECK: ^[[ARM]]:
// CHECK-NEXT: asm.vbr ^bb{{[0-9]+}}
// CHECK-NOT: riscv.blt
