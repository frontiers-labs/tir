// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64ifd --stage=isel %s | filecheck %s

module {
  %fn_two_divisions = func.func @two_divisions(%0: !f64, %1: !f64) -> !f64 {
    %env0 = state.entry_state : !state<fp.env>
    %first, %env1 = fp.div %0, %1 state(%env0) {semantics = {exceptions = "flags", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %second, %env2 = fp.div %0, %1 state(%env1) {semantics = {exceptions = "flags", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %second state(%env2)
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "two_divisions"
// CHECK-COUNT-2: riscv.fdiv.d.rne
