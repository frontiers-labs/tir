// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: not tir mc --march=rv64ifd --filetype=asm %s 2>&1 | filecheck %s

module {
  %fn = func.func @quiet_olt(%lhs: !f64, %rhs: !f64) -> !i1 {
    %env0 = state.entry_state : !state<fp.env>
    %result, %env1 = fp.cmp %lhs, %rhs state(%env0) {predicate = "olt", semantics = {behavior = "quiet", exceptions = "flags"}} : !i1
    func.return %result state(%env1)
  }
  module_end
}

// CHECK: invalid rule set: fp.cmp has no instruction: %{{[0-9]+}}, %{{[0-9]+}} = fp.cmp %{{[0-9]+}}, %{{[0-9]+}} state(%{{[0-9]+}}) {predicate = \"olt\", semantics = {exceptions = \"flags\"}} : !i1
