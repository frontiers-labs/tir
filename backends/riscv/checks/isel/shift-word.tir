// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// An i32 shift by a register amount selects the register word shift (sllw);
// a shift by a constant folds it and selects the immediate word shift (slliw).

module {
  %fn_reg = func.func @reg(%0: !i32, %1: !i32) -> !i32 {
    %2 = shli %0, %1 : !i32
    func.return %2
  }
  // CHECK: asm.symbol {name = "reg"
  // CHECK: riscv.sllw {rd = %virt2:GPR, rs1 = %virt0:GPR, rs2 = %virt1:GPR}
  // CHECK: asm.vret

  %fn_imm = func.func @imm(%0: !i32) -> !i32 {
    %1 = constant {value = 3} : !i32
    %2 = shli %0, %1 : !i32
    func.return %2
  }
  // CHECK: asm.symbol {name = "imm"
  // CHECK-NOT: constant
  // CHECK: riscv.slliw {rd = %virt{{[0-9]+}}:GPR, rs1 = %virt{{[0-9]+}}:GPR, imm = 3}
  // CHECK: asm.vret
  module_end
}
