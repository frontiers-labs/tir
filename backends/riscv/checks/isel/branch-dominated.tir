// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// A block entered through exactly one guarded edge inherits the guard's fact,
// asserted in an e-graph assumption scope while the block solves. Restructuring
// makes the second guard the test of a gate nested in the first gate's arm, and
// the arm's fact decides that test: no compare and no branch are emitted, the
// destruction jumps straight to the arm the decision picks and never emits the
// arm the decision excludes.

module {
  %fn_dominated = func.func @dominated(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %3, ^bb3, ^bb4
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  ^bb3:
    %5 = constant {value = 1} : !i64
    func.return %5
  ^bb4:
    %6 = constant {value = 2} : !i64
    func.return %6
  }
  module_end
}

// The entry selects the fused compare-and-branch; the dominated block tests
// nothing, and the arm returning 2 is never emitted.
// CHECK: riscv.blt {rs1 = %virt{{[0-9]+}}:GPR, rs2 = %virt{{[0-9]+}}:GPR, imm = ^[[ARM:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^bb{{[0-9]+}}
// CHECK: ^[[ARM]]:
// CHECK-NEXT: asm.vbr ^bb{{[0-9]+}}
// CHECK-NOT: riscv.blt
// CHECK-NOT: imm = 2
