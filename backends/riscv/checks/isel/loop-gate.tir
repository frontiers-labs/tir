// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// Selection preserves the loop-header parameter through the merge and back
// edge while selecting the latch computation and loop condition normally.

module {
  %fn_count = func.func @count(%limit: !i64) -> !i64 {
    %zero = constant {value = 0} : !i64
    cfg.br ^bb1(%zero : !i64)
  ^bb1(%iv: !i64):
    %keep_going = cmpi %iv, %limit {predicate = "slt"} : !i1
    cfg.cond_br %keep_going, ^bb2, ^bb3
  ^bb2:
    %one = constant {value = 1} : !i64
    %next = addi %iv, %one : !i64
    cfg.br ^bb1(%next : !i64)
  ^bb3:
    func.return %iv
  }
  module_end
}

// CHECK:      asm.symbol {name = "count"
// CHECK:      asm.vbr %{{[0-9]+}} ^[[HDR:bb[0-9]+]]
// CHECK:      ^[[HDR]](%[[IV:[0-9]+]]: !riscv.GPR):
// CHECK:      riscv.blt {rs1 = %[[IV]]:GPR
// CHECK:      riscv.addi {rd = %[[NEXT:[0-9]+]]:GPR, rs1 = %[[IV]]:GPR, imm = 1}
// The latch value reaches the merge block, whose repeated condition carries it
// back into the header parameter.
// CHECK:      asm.vbr %[[NEXT]] ^[[MERGE:bb[0-9]+]]
// CHECK:      ^[[MERGE]](%[[CARRY:[0-9]+]]: !riscv.GPR):
// CHECK-NEXT: riscv.blt {rs1 = %[[IV]]:GPR
// CHECK:      asm.vbr %[[CARRY]] ^[[HDR]]
