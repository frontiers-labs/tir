// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv32im --stage=isel %s | filecheck %s

module {
  %fn_mul32 = func.func @mul32(%0: !i32, %1: !i32) -> !i32 {
    %2 = muli %0, %1 : !i32
    func.return %2
  }
  module_end
}

// RV32 has no word multiply instruction; plain mul is the 32-bit operation.
// CHECK: asm.symbol {name = "mul32", arg_regs = [%[[V0:[0-9]+]]:GPR, %[[V1:[0-9]+]]:GPR]
// CHECK: riscv.mul {rd = %[[V2:[0-9]+]]:GPR, rs1 = %[[V0]]:GPR, rs2 = %[[V1]]:GPR}
