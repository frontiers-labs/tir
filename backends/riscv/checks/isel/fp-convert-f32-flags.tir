// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir interp %s | filecheck %s --check-prefix=INTERP
// RUN: tir mc --march=rv64ifd --filetype=asm -o /tmp/tir-riscv-fp-convert-f32-flags.s %s
// RUN: isasim --march=rv64ifd --entry=main --until-pc=0 --trace-registers-end /tmp/tir-riscv-fp-convert-f32-flags.s | filecheck %s --check-prefix=EXEC
// RUN: tir mc --march=rv64ifd --filetype=asm --shuffle-machine-order -o /tmp/tir-riscv-fp-convert-f32-flags.s %s
// RUN: isasim --march=rv64ifd --entry=main --until-pc=0 --trace-registers-end /tmp/tir-riscv-fp-convert-f32-flags.s | filecheck %s --check-prefix=EXEC

module {
  %fn_main = func.func @main() -> !i64 {
    %env0 = state.entry_state : !state<fp.env>
    %all_flags = constant {value = 31} : !i5
    %env1 = fp.clear_flags %all_flags state(%env0)
    %value = fp.constant {bits = 4607182419068452864} : !f64
    %converted, %env2 = fp.convert %value state(%env1) {semantics = {kind = "arithmetic", rounding = "nearest_even", exceptions = "flags", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    %bits = bitcast %converted : !i32
    %wide_bits = extui %bits : !i64
    %shift = constant {value = 8} : !i64
    %shifted = shli %wide_bits, %shift : !i64
    %wide_flags = extui %flags : !i64
    %observed = ori %shifted, %wide_flags : !i64
    func.return %observed state(%env3)
  }
  module_end
}

