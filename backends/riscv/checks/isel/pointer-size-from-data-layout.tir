// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// Loading a pointer needs the pointer's width, which is a data layout fact: an
// rv64 target loads eight bytes (`ld`), but the layout this module declares
// makes its pointers 32 bits wide, so the same load becomes an `lw`.

#layout_spec = #layout.spec<endianness = "little", stack_align = 128, !ptr.p = {size = 32, abi = 32}>

module {layout.spec = #layout_spec} {
  %fn_deref = func.func @deref(%0: !ptr.p<!ptr.p>) -> !ptr.p {
    %1 = ptr.load %0 : !ptr.p
    func.return %1
  }
  module_end
}

// CHECK: riscv.lw {rd = %[[V1:[0-9]+]]:GPR, rs1 = %[[V0:[0-9]+]]:GPR, imm = 0}
