// RUN: tir mc --march=rv64if --stage=isel %s | filecheck %s --check-prefix=RV64
// RUN: tir mc --march=rv32if --stage=isel %s | filecheck %s --check-prefix=RV32

module {
  %fn_scale = func.func @scale(%0: !f32) -> !f32 {
    %1 = fp.constant {bits = 1075838976} : !f32
    %2 = fp.mul %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %2
  }
  module_end
}

// RV64: riscv.lui {rd = %{{[0-9]+}}:GPR, imm = 262656}
// RV64: riscv.fmv.w.x {fd = %{{[0-9]+}}:FPR32, rs1 = %{{[0-9]+}}:GPR}
// RV64: riscv.fmul.s
// RV64-NOT: fp.constant

// RV32: riscv.lui {rd = %{{[0-9]+}}:GPR, imm = 262656}
// RV32: riscv.fmv.w.x {fd = %{{[0-9]+}}:FPR32, rs1 = %{{[0-9]+}}:GPR}
// RV32: riscv.fmul.s
// RV32-NOT: fp.constant
