// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// A builtin i32 add lowers to the RISC-V word add, wrapped in an asm.symbol
// carrying the function's argument registers and terminated by a vret.

module {
  %fn_demo = func.func @demo(%0: !i32, %1: !i32) -> !i32 {
    %2 = addi %0, %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK:      module {
// CHECK-NEXT:   asm.symbol {name = "demo", arg_regs = [%[[V0:[0-9]+]]:GPR
// CHECK-NEXT:     riscv.addw {rd = %[[V2:[0-9]+]]:GPR, rs1 = %[[V0]]:GPR, rs2 = %[[V1:[0-9]+]]:GPR}
// CHECK-NEXT:     asm.vret %[[V2]]
// CHECK-NEXT:     asm.symbol_end
// CHECK-NEXT:   }
// CHECK-NEXT:   module_end
// CHECK-NEXT: }
