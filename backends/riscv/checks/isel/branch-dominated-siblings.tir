// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// Two sibling blocks under one assumption scope both read the class the
// assumption changed. The entry guard proves `%0 < %1`; both arms of the
// dominated decision recompute that same comparison, so the fact has to reach
// the second sibling as well as the first. A per-block re-search answers each
// separately, a per-scope match index answers the first and reuses it for the
// second; the selection must not depend on which.

module {
  %fn_siblings = func.func @siblings(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %3, ^bb3, ^bb4
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  ^bb3:
    %5 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %5, ^bb5, ^bb6
  ^bb4:
    %6 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %6, ^bb7, ^bb8
  ^bb5:
    %7 = constant {value = 1} : !i64
    func.return %7
  ^bb6:
    %8 = constant {value = 2} : !i64
    func.return %8
  ^bb7:
    %9 = constant {value = 3} : !i64
    func.return %9
  ^bb8:
    %10 = constant {value = 4} : !i64
    func.return %10
  }
  module_end
}

// The entry's compare-and-branch is the only branch emitted: the assumption
// decides both siblings' tests, so neither re-emits a compare, and the arms
// their decisions exclude (2, 3 and 4) are never materialized.

// CHECK: riscv.blt {rs1 = %{{[0-9]+}}:GPR, rs2 = %{{[0-9]+}}:GPR, imm = ^[[ARM:bb[0-9]+]]}
// CHECK: ^[[ARM]]:
// CHECK-NOT: riscv.blt
// CHECK-NOT: imm = 2
// CHECK-NOT: imm = 3
// CHECK-NOT: imm = 4
