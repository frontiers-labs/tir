// RUN: tir mc --march=rv64ifd --stage=isel %s | filecheck %s
// RUN: tir mc --march=rv32ifd --stage=isel %s | filecheck %s
// RUN: not tir mc --march=rv64i --stage=isel %s

// Builtin float arithmetic selects the F/D instructions: f32 values live in
// FPR32 and pick the .s forms, f64 values in FPR64 and pick the .d forms,
// identically on rv32 and rv64. Without the F extension selection fails
// loudly instead of miscompiling through integer rules.

module {
  %fn_fp32 = func.func @fp32(%0: !f32, %1: !f32) -> !f32 {
    %2 = addf %0, %1 : !f32
    %3 = subf %2, %1 : !f32
    %4 = mulf %3, %0 : !f32
    %5 = divf %4, %1 : !f32
    func.return %5
  }
  %fn_fp64 = func.func @fp64(%0: !f64, %1: !f64) -> !f64 {
    %2 = addf %0, %1 : !f64
    %3 = subf %2, %1 : !f64
    %4 = mulf %3, %0 : !f64
    %5 = divf %4, %1 : !f64
    func.return %5
  }
  %fn_convert = func.func @convert(%0: !i32) -> !f64 {
    %1 = sitofp %0 : !f64
    func.return %1
  }
  %fn_convert_unsigned = func.func @convert_unsigned(%0: !i32) -> !f64 {
    %1 = uitofp %0 : !f64
    func.return %1
  }
  %fn_convert_to_signed = func.func @convert_to_signed(%0: !f64) -> !i32 {
    %1 = fptosi %0 : !i32
    func.return %1
  }
  %fn_convert_to_unsigned = func.func @convert_to_unsigned(%0: !f64) -> !i32 {
    %1 = fptoui %0 : !i32
    func.return %1
  }
  %fn_less = func.func @less(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "olt"} : !i1
    func.return %2
  }
  %fn_less_equal = func.func @less_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "ole"} : !i1
    func.return %2
  }
  %fn_greater = func.func @greater(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "ogt"} : !i1
    func.return %2
  }
  %fn_greater_equal = func.func @greater_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "oge"} : !i1
    func.return %2
  }
  %fn_equal = func.func @equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "oeq"} : !i1
    func.return %2
  }
  %fn_not_equal = func.func @not_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "une"} : !i1
    func.return %2
  }
  module_end
}

// CHECK: asm.symbol {name = "fp32", arg_regs = [%[[V0:[0-9]+]]:FPR32, %[[V1:[0-9]+]]:FPR32]
// CHECK: riscv.fadd.s.rne {fd = %[[V2:[0-9]+]]:FPR32, fs1 = %[[V0]]:FPR32, fs2 = %[[V1]]:FPR32}
// CHECK: riscv.fsub.s.rne {fd = %[[V3:[0-9]+]]:FPR32, fs1 = %[[V2]]:FPR32, fs2 = %[[V1]]:FPR32}
// CHECK: riscv.fmul.s.rne {fd = %[[V4:[0-9]+]]:FPR32, fs1 = %[[V0]]:FPR32, fs2 = %[[V3]]:FPR32}
// CHECK: riscv.fdiv.s.rne {fd = %[[V5:[0-9]+]]:FPR32, fs1 = %[[V4]]:FPR32, fs2 = %[[V1]]:FPR32}
// CHECK: asm.vret

// CHECK: asm.symbol {name = "fp64", arg_regs = [%{{[0-9]+}}:FPR64, %{{[0-9]+}}:FPR64]
// CHECK: riscv.fadd.d.rne {fd = %{{[0-9]+}}:FPR64, fs1 = %{{[0-9]+}}:FPR64, fs2 = %{{[0-9]+}}:FPR64}
// CHECK: riscv.fsub.d.rne
// CHECK: riscv.fmul.d.rne
// CHECK: riscv.fdiv.d.rne
// CHECK: asm.vret

// CHECK: asm.symbol {name = "convert", arg_regs = [%{{[0-9]+}}:GPR]
// CHECK: riscv.fcvt.d.w.rne {fd = %{{[0-9]+}}:FPR64, rs1 = %{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_unsigned", arg_regs = [%{{[0-9]+}}:GPR]
// CHECK: riscv.fcvt.d.wu.rne {fd = %{{[0-9]+}}:FPR64, rs1 = %{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed", arg_regs = [%{{[0-9]+}}:FPR64]
// CHECK: riscv.fcvt.w.d.rtz {rd = %{{[0-9]+}}:GPR, fs1 = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_unsigned"
// CHECK: riscv.fcvt.wu.d.rtz {rd = %{{[0-9]+}}:GPR, fs1 = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK-LABEL: asm.symbol {name = "less"
// CHECK: riscv.flt.d
// CHECK-LABEL: asm.symbol {name = "less_equal"
// CHECK: riscv.f{{le|lt}}.d
// CHECK-LABEL: asm.symbol {name = "greater"
// CHECK: riscv.flt.d
// CHECK-LABEL: asm.symbol {name = "greater_equal"
// CHECK: riscv.f{{le|lt}}.d
// CHECK-LABEL: asm.symbol {name = "equal"
// CHECK: riscv.feq.d
// CHECK-LABEL: asm.symbol {name = "not_equal"
// CHECK: riscv.f{{eq|le}}.d
// CHECK: riscv.xori
