// RUN: tir mc --march=rv64id --stage=isel %s | filecheck %s

// Reading a gate's and a loop's regions puts their operations in the function's
// own e-graph, so a constant defined outside is the same class inside and folds
// into the region's instruction as an immediate.

module {
  func.func @choose(%0: !i1, %1: !i64) -> !i64 {
    %c = constant {value = 7} : !i64
    %r = scf.if %0 -> !i64 {
      %a = addi %1, %c : !i64
      scf.yield %a
    } else {
      %b = subi %1, %c : !i64
      scf.yield %b
    }
    func.return %r
  }

  func.func @accumulate(%0: !i1, %1: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %r = scf.while iter_args(%acc = %1) -> !i64 {
      scf.condition %0, %acc
    } do scope(%tok)(%cur) {
      %n = addi %cur, %c : !i64
      scf.yield %n
    }
    func.return %r
  }
  module_end
}

// CHECK: asm.symbol {name = "choose"
// CHECK: riscv.addi {rd = %virt{{[0-9]+}}:GPR, rs1 = %virt1:GPR, imm = 7}
// CHECK: riscv.addi {rd = %virt{{[0-9]+}}:GPR, rs1 = %virt1:GPR, imm = -7}
// CHECK: asm.symbol {name = "accumulate"
// CHECK: riscv.addi {rd = %virt{{[0-9]+}}:GPR, rs1 = %virt{{[0-9]+}}:GPR, imm = 5}
