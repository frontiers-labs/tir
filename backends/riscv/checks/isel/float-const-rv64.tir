// RUN: tir mc --march=rv64ifd --stage=isel %s | filecheck %s
// RUN: not tir mc --march=rv32ifd --stage=isel %s

module {
  %fn_scale = func.func @scale(%0: !f64) -> !f64 {
    %1 = fp.constant {bits = 4612811918334230528} : !f64
    %2 = fp.mul %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %2
  }
  module_end
}

// CHECK: riscv.lui {rd = %{{[0-9]+}}:GPR, imm = 1}
// CHECK: riscv.addi {rd = %{{[0-9]+}}:GPR, rs1 = %{{[0-9]+}}:GPR, imm = 1}
// CHECK: riscv.slli {rd = %{{[0-9]+}}:GPR, rs1 = %{{[0-9]+}}:GPR, imm = 50}
// CHECK: riscv.fmv.d.x {fd = %{{[0-9]+}}:FPR64, rs1 = %{{[0-9]+}}:GPR}
// CHECK: riscv.fmul.d.rne
// CHECK-NOT: fp.constant
