// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// A bare integer constant that fits addi's 12-bit signed immediate is selected
// by the e-graph cover as `addi rd, x0, imm` (the canonical `li`), not left
// for the pre-RA materialization hook.

module {
  %fn_five = func.func @five() -> !i64 {
    %0 = constant {value = 5} : !i64
    func.return %0
  }
  // CHECK: asm.symbol {name = "five"
  // CHECK-NOT: constant
  // CHECK: riscv.addi {rd = %[[V0:[0-9]+]]:GPR, rs1 = x0, imm = 5}
  // CHECK: asm.vret

  %fn_neg_one = func.func @neg_one() -> !i64 {
    %0 = constant {value = -1} : !i64
    func.return %0
  }
  // CHECK: asm.symbol {name = "neg_one"
  // CHECK-NOT: constant
  // CHECK: riscv.addi {rd = %[[V2:[0-9]+]]:GPR, rs1 = x0, imm = -1}

  %fn_imm_max = func.func @imm_max() -> !i64 {
    %0 = constant {value = 2047} : !i64
    func.return %0
  }
  // CHECK: asm.symbol {name = "imm_max"
  // CHECK-NOT: constant
  // CHECK: riscv.addi {rd = %[[V4:[0-9]+]]:GPR, rs1 = x0, imm = 2047}

  %fn_imm_min = func.func @imm_min() -> !i64 {
    %0 = constant {value = -2048} : !i64
    func.return %0
  }
  // CHECK: asm.symbol {name = "imm_min"
  // CHECK-NOT: constant
  // CHECK: riscv.addi {rd = %[[V6:[0-9]+]]:GPR, rs1 = x0, imm = -2048}

  // A constant consumed only as another instruction's immediate keeps folding:
  // no li is materialized for it.
  %fn_fold_only = func.func @fold_only(%0: !i64) -> !i64 {
    %1 = constant {value = 7} : !i64
    %2 = addi %0, %1 : !i64
    func.return %2
  }
  // CHECK: asm.symbol {name = "fold_only"
  // CHECK-NOT: constant
  // CHECK-NOT: rs1 = x0
  // CHECK: riscv.addi {rd = %[[V10:[0-9]+]]:GPR, rs1 = %[[V8:[0-9]+]]:GPR, imm = 7}

  // A constant both folded into a live consumer and returned by value: the
  // consumer keeps the folded immediate while one li materializes the
  // escaping use.
  %fn_fold_and_escape = func.func @fold_and_escape(%0: !i64) -> !i64 {
    %1 = constant {value = 9} : !i64
    %2 = addi %0, %1 : !i64
    %3 = ptr.alloca {size = 8, align = 8} : !ptr.p<!i64>
    ptr.store %2, %3
    func.return %1
  }
  // CHECK: asm.symbol {name = "fold_and_escape"
  // CHECK-NOT: constant
  // CHECK: riscv.addi {rd = %[[V14:[0-9]+]]:GPR, rs1 = %[[V12:[0-9]+]]:GPR, imm = 9}
  // CHECK: riscv.addi {rd = %[[V13:[0-9]+]]:GPR, rs1 = x0, imm = 9}
  // CHECK: riscv.sd
  module_end
}
