// RUN: tir mc --march=rv32i --stage=isel %s | filecheck %s

module {
  %fn_count = func.func @count() -> !i32 {
    %0 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %1 = constant {value = 0} : !i32
    ptr.store %1, %0
    cfg.br ^bb1
  ^bb1:
    %3 = ptr.load %0 : !i32
    %4 = constant {value = 3} : !i32
    %5 = cmpi %3, %4 {predicate = "slt"} : !i1
    cfg.cond_br %5, ^bb2, ^bb3
  ^bb2:
    %6 = ptr.load %0 : !i32
    %7 = constant {value = 1} : !i32
    %8 = addi %6, %7 : !i32
    ptr.store %8, %0
    cfg.br ^bb1
  ^bb3:
    %9 = ptr.load %0 : !i32
    func.return %9
  }
  module_end
}

// The slot is stored before the loop and reloaded by the test. The body's own
// reload is on the state the test's reload published — nothing writes the slot
// between them — so the two are one term and the body steps the register the
// test already loaded. What is left is the store, the test's reload, the store
// the body writes back, and the exit's own reload.
// CHECK: riscv.sw
// CHECK: riscv.lw
// CHECK-NOT: riscv.lw
// CHECK: riscv.sw
// CHECK: riscv.lw
// CHECK-NOT: riscv.lw
