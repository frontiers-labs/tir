// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64ifd --stage=isel %s | filecheck %s

module {
  %fn_dynamic = func.func @dynamic(%lhs: !f64, %rhs: !f64, %mode: !fp.rounding) -> !f64 {
    %env0 = state.entry_state : !state<fp.env>
    %env1 = fp.set_round %mode state(%env0)
    %sum, %env2 = fp.add %lhs, %rhs state(%env1) {semantics = {kind = "arithmetic", rounding = "dynamic", exceptions = "flags", nan = "any_quiet", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %flags, %env3 = fp.get_flags state(%env2) : !i5
    %bits = bitcast %sum : !i64
    %wide_flags = extui %flags : !i64
    %observed = xori %bits, %wide_flags : !i64
    %result = bitcast %observed : !f64
    func.return %result state(%env3)
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "dynamic"
// CHECK: %[[SET:[0-9]+]] = riscv.set_fround {{.*}} state(%[[ENTRY:[0-9]+]])
// CHECK-NEXT: %[[ADD:[0-9]+]] = riscv.fadd.d {{.*}} state(%[[SET]])
// CHECK-NEXT: %[[GET:[0-9]+]] = riscv.read_fflags {rd = %{{[0-9]+}}:GPR} state(%[[ADD]])
// CHECK: asm.vret
