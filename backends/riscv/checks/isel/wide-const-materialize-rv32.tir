// RUN: tir mc --march=rv32i --filetype=asm %s | filecheck %s

// The same splits run at the constant's i32 width on RV32, including both
// signed boundaries.

module {
  %fn_min = func.func @min() -> !i32 {
    %0 = constant {value = -2147483648} : !i32
    func.return %0
  }
  // CHECK-LABEL: min:
  // CHECK-NEXT: lui x10, -524288
  // CHECK-NEXT: jalr x0, 0(x1)

  %fn_max = func.func @max() -> !i32 {
    %0 = constant {value = 2147483647} : !i32
    func.return %0
  }
  // CHECK-LABEL: max:
  // CHECK-NEXT: lui x5, -524288
  // CHECK-NEXT: addi x10, x5, -1
  // CHECK-NEXT: jalr x0, 0(x1)
  module_end
}
