// RUN: tir mc --march=rv64id --mabi=lp64 --stage=isel %s | filecheck %s --check-prefix=LP64
// RUN: tir mc --march=rv64id --mabi=lp64d --stage=isel %s | filecheck %s --check-prefix=LP64D

module {
  %fn_sink = func.declare @sink(!f64) -> !f64
  %fn_caller = func.func @caller(%0: !f64) -> !f64 {
    %1 = func.call %fn_sink(%0 : !f64) -> !f64
    func.return %1
  }
  module_end
}

// LP64: arg_regs = [%[[V1:[0-9]+]]:GPR]
// LP64: asm.vcall %[[V1]] state(
// LP64-SAME: passed_in = [GPR[10]], returned_in = [GPR[10]]
// LP64D: arg_regs = [%[[V1:[0-9]+]]:FPR64]
// LP64D: asm.vcall %[[V1]] state(
// LP64D-SAME: passed_in = [FPR64[10]], returned_in = [FPR64[10]]
