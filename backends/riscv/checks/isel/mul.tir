// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64im --stage=isel %s | filecheck %s --check-prefixes=CHECK,RV64

module {
  %fn_mul32 = func.func @mul32(%0: !i32, %1: !i32) -> !i32 {
    %2 = muli %0, %1 : !i32
    func.return %2
  }
  %fn_mul64 = func.func @mul64(%0: !i64, %1: !i64) -> !i64 {
    %2 = muli %0, %1 : !i64
    func.return %2
  }
  module_end
}

// On RV64 an i32 multiply selects the word op and an i64 multiply the full mul.
// CHECK: asm.symbol {name = "mul32", arg_regs = [%[[V0:[0-9]+]]:GPR, %[[V1:[0-9]+]]:GPR]
// RV64: riscv.mulw {rd = %[[V2:[0-9]+]]:GPR, rs1 = %[[V0]]:GPR, rs2 = %[[V1]]:GPR}
// CHECK: asm.symbol {name = "mul64", arg_regs = [%[[V4:[0-9]+]]:GPR, %[[V5:[0-9]+]]:GPR]
// CHECK: riscv.mul {rd = %[[V6:[0-9]+]]:GPR, rs1 = %[[V4]]:GPR, rs2 = %[[V5]]:GPR}
