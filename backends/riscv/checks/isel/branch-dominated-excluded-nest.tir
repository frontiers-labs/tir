// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// The arm a decided test excludes is not emitted, and neither is the gate
// nested inside it: the excluded arm stays in the operation's own region, so
// erasing the operation takes its whole subtree away.

module {
  func @excluded_nest(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %3, ^bb3, ^bb4
  ^bb2:
    %4 = constant {value = 0} : !i64
    return %4
  ^bb3:
    %5 = constant {value = 1} : !i64
    return %5
  ^bb4:
    %6 = cmpi %1, %0 {predicate = "slt"} : !i1
    cfg.cond_br %6, ^bb5, ^bb6
  ^bb5:
    %7 = constant {value = 2} : !i64
    return %7
  ^bb6:
    %8 = constant {value = 3} : !i64
    return %8
  }
  module_end
}

// CHECK: riscv.blt {rs1 = %virt{{[0-9]+}}:GPR, rs2 = %virt{{[0-9]+}}:GPR, imm = ^[[ARM:bb[0-9]+]]}
// CHECK: ^[[ARM]]:
// CHECK-NEXT: asm.vbr ^bb{{[0-9]+}}
// CHECK-NOT: riscv.blt
// CHECK-NOT: imm = 2
// CHECK-NOT: imm = 3
