// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// Three assumption scopes nested inside one another, each re-testing what the
// one above it already proved. The match index keeps one frame per open scope
// and answers a class from the innermost frame that changed it, so this pins the
// layering: the innermost decision must still be folded, which only happens if
// the outermost fact is still visible three frames down.

module {
  %fn_three_deep = func.func @three_deep(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %3, ^bb3, ^bb4
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  ^bb3:
    %5 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %5, ^bb5, ^bb6
  ^bb4:
    %6 = constant {value = 1} : !i64
    func.return %6
  ^bb5:
    %7 = constant {value = 2} : !i64
    func.return %7
  ^bb6:
    %8 = constant {value = 3} : !i64
    func.return %8
  }
  module_end
}

// One compare-and-branch for the outermost test, none for the two nested ones,
// and neither excluded arm (1 and 3) is materialized.

// CHECK: riscv.blt {rs1 = %{{[0-9]+}}:GPR, rs2 = %{{[0-9]+}}:GPR, imm = ^[[ARM:bb[0-9]+]]}
// CHECK: ^[[ARM]]:
// CHECK-NOT: riscv.blt
// CHECK-NOT: imm = 1
// CHECK-NOT: imm = 3
