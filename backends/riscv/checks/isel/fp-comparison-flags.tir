// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64ifd --stage=isel %s | filecheck %s

module {
  %fn_quiet = func.func @quiet(%lhs: !f64, %rhs: !f64) -> !i1 {
    %env0 = state.entry_state : !state<fp.env>
    %result, %env1 = fp.cmp %lhs, %rhs state(%env0) {predicate = "oeq", semantics = {kind = "comparison", behavior = "quiet", exceptions = "flags", subnormals = "gradual"}} : !i1
    func.return %result state(%env1)
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "quiet"
// CHECK: riscv.feq.d
