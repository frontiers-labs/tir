// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// Conditional branches select through the TMDL-derived branch rules: the
// comparison fuses into the branch instruction (beq/bne/blt/bge/bltu/bgeu)
// and the compare op is consumed unless its value is needed elsewhere.

module {
  %fn_slt_branch = func.func @slt_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // The compare fuses into blt; no slt is materialized.
  // CHECK: asm.symbol {name = "slt_branch"
  // CHECK-NOT: riscv.slt
  // CHECK: riscv.blt {rs1 = %[[V51:[0-9]+]]:GPR, rs2 = %[[V52:[0-9]+]]:GPR, imm = ^bb2}
  // CHECK-NEXT: asm.vbr ^bb1

  %fn_sle_branch = func.func @sle_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "sle"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // a <= b canonicalizes to b >= a, selecting bge with swapped operands.
  // CHECK: asm.symbol {name = "sle_branch"
  // CHECK: riscv.bge {rs1 = %[[V55:[0-9]+]]:GPR, rs2 = %[[V54:[0-9]+]]:GPR, imm = ^bb2}
  // CHECK-NEXT: asm.vbr ^bb1

  %fn_ult_branch = func.func @ult_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "ult"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "ult_branch"
  // CHECK: riscv.bltu {rs1 = %[[V57:[0-9]+]]:GPR, rs2 = %[[V58:[0-9]+]]:GPR, imm = ^bb2}

  %fn_eq_branch = func.func @eq_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "eq"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "eq_branch"
  // CHECK: riscv.beq {rs1 = %[[V60:[0-9]+]]:GPR, rs2 = %[[V61:[0-9]+]]:GPR, imm = ^bb2}

  %fn_materialized = func.func @materialized(%0: !i64, %1: !i64) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    func.return %2
  ^bb2:
    %3 = cmpi %1, %0 {predicate = "slt"} : !i1
    func.return %3
  }
  // The compare value escapes to other blocks, so it is materialized (slt via
  // the boolean-materialization bridge) *and* still fused into the branch.
  // CHECK: asm.symbol {name = "materialized"
  // CHECK: riscv.slt {rd = %[[V26:[0-9]+]]:GPR, rs1 = %[[V63:[0-9]+]]:GPR, rs2 = %[[V64:[0-9]+]]:GPR}
  // CHECK: riscv.blt {rs1 = %[[V63]]:GPR, rs2 = %[[V64]]:GPR, imm = ^bb{{[0-9]+}}}

  %fn_fallback = func.func @fallback(%0: !i1) -> !i64 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %1 = constant {value = 1} : !i64
    func.return %1
  ^bb2:
    %2 = constant {value = 0} : !i64
    func.return %2
  }
  // A bare i1 condition has no comparison to fuse, and a width-1 value only
  // defines the low bit of its register, so the branch must read that bit
  // alone: `andi` the bit out, then compare that against the hardwired zero.
  // CHECK: asm.symbol {name = "fallback"
  // CHECK: riscv.andi {rd = %{{[0-9]+}}:GPR, rs1 = %[[V66:[0-9]+]]:GPR, imm = 1}
  // CHECK-NEXT: riscv.bne {rs1 = %{{[0-9]+}}:GPR, rs2 = x0, imm = ^bb2}
  // CHECK-NEXT: asm.vbr ^bb1

  %fn_eq_zero = func.func @eq_zero(%0: !i64) -> !i64 {
    %1 = constant {value = 0} : !i64
    %2 = cmpi %0, %1 {predicate = "eq"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // `cmpi %x, 0 {eq}` fuses into `beq %x, x0`: the zero operand wires to the
  // hardwired zero register instead of materializing the constant. No `li` of 0.
  // CHECK: asm.symbol {name = "eq_zero"
  // CHECK-NOT: riscv.slt
  // CHECK: riscv.beq {rs1 = %[[V69:[0-9]+]]:GPR, rs2 = x0, imm = ^bb2}
  // CHECK-NEXT: asm.vbr ^bb1

  %fn_ne_zero = func.func @ne_zero(%0: !i64) -> !i64 {
    %1 = constant {value = 0} : !i64
    %2 = cmpi %0, %1 {predicate = "ne"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "ne_zero"
  // CHECK: riscv.bne {rs1 = %[[V71:[0-9]+]]:GPR, rs2 = x0, imm = ^bb2}

  %fn_sgt_zero = func.func @sgt_zero(%0: !i64) -> !i64 {
    %1 = constant {value = 0} : !i64
    %2 = cmpi %0, %1 {predicate = "sgt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // `%x > 0` canonicalizes to `0 < %x`, selecting the other zero-form slot:
  // `blt x0, %x` (zero wired into rs1).
  // CHECK: asm.symbol {name = "sgt_zero"
  // CHECK: riscv.blt {rs1 = x0, rs2 = %[[V73:[0-9]+]]:GPR, imm = ^bb2}

  module_end
}
