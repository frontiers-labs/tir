// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// On rv64 an i32 (word-width) logical/arithmetic right shift selects to the
// word form: the instruction holds its low-32 result sign-extended in the
// register (the register form), so canonicalization sees the narrow shift, the
// same way `sllw` covers the word left shift.

module {
  %fn_srl = func.func @srl(%0: !i32, %1: !i32) -> !i32 {
    %2 = shrui %0, %1 : !i32
    func.return %2
  }
  %fn_sra = func.func @sra(%0: !i32, %1: !i32) -> !i32 {
    %2 = shrsi %0, %1 : !i32
    func.return %2
  }
  module_end
}

// CHECK: riscv.srlw {rd = %[[V2:[0-9]+]]:GPR, rs1 = %[[V0:[0-9]+]]:GPR, rs2 = %[[V1:[0-9]+]]:GPR}
// CHECK: riscv.sraw {rd = %[[V6:[0-9]+]]:GPR, rs1 = %[[V4:[0-9]+]]:GPR, rs2 = %[[V5:[0-9]+]]:GPR}
