// RUN: tir mc --march=rv64i --filetype=asm %s | filecheck %s

// 0x80000000 needs bit 31 set with a zero upper half, so RV64 must build it in
// pieces rather than sign-extending a single LUI/ADDIW pair. Matching takes the
// constant's trailing zeros into a shift: 1 << 31 == 0x80000000.

module {
  %fn_too_big = func.func @too_big() -> !i64 {
    %0 = constant {value = 2147483648} : !i64
    func.return %0
  }
  module_end
}

// CHECK: addi x5, x0, 1
// CHECK-NEXT: slli x10, x5, 31
