// RUN: tir mc --march=rv64id --stage=regalloc %s | filecheck %s

module {
  %fn_ext = func.declare @ext(!i64,!i64,!i64,!i64,!i64,!i64,!i64,!i64,!i64,!f64,!f64,!f64,!f64,!f64,!f64,!f64,!f64,!f64) -> !i64
  %fn_caller = func.func @caller(%i: !i64, %f: !f64) -> !i64 {
    %r = func.call %fn_ext(%i,%i,%i,%i,%i,%i,%i,%i,%i,%f,%f,%f,%f,%f,%f,%f,%f,%f : !i64,!i64,!i64,!i64,!i64,!i64,!i64,!i64,!i64,!f64,!f64,!f64,!f64,!f64,!f64,!f64,!f64,!f64) -> !i64
    func.return %r
  }
  module_end
}

// CHECK: riscv.addi {rd = x2, rs1 = x2, imm = -32}
// CHECK: riscv.sd {rs1 = x2, rs2 = %{{[0-9]+}}:{{.*}}, imm = 0}
// CHECK: riscv.fsd {rs1 = x2, fs2 = %{{[0-9]+}}:f{{[0-9]+}}, imm = 8}
// CHECK: asm.vcall | %{{[0-9]+}} {callee = "ext"
// CHECK: riscv.addi {rd = x2, rs1 = x2, imm = 32}
