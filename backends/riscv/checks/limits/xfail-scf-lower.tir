// RUN: not tir mc --march=rv64i --filetype=asm %s 2>&1 | filecheck %s

// A counted loop whose bounds are `!index` has no machine width to count in:
// the converter that structures functions for selection refuses it instead of
// picking one, so the frontend must have resolved `!index` before codegen.

module {
  %fn_a = func.func @a(%lo: !index, %hi: !index, %st: !index) {
    scf.for %lo, %hi, %st {
      scf.yield
    }
    func.return
  }
  module_end
}

// CHECK: pass 'restructure-nodes' produced invalid IR
// CHECK-SAME: for2 operand 'lb' expected constraint crate::builtin::IntegerType, got !index
