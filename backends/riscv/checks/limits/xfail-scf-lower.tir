// RUN: not tir mc --march=rv64i --filetype=asm %s 2>&1 | filecheck %s

// A counted loop whose bounds are `!index` has no machine width to count in:
// the converter builds the counter's comparison and increment, and those are
// integer operations, so it refuses the loop instead of picking a width. The
// frontend must have resolved `!index` before codegen.

module {
  %fn_a = func.func @a(%lo: !index, %hi: !index, %st: !index) {
    %0 = scf.ordered_for %1 = %lo to %hi step %st {
      scf.yield
    }
    func.return
  }
  module_end
}

// CHECK: pass 'restructure-nodes' produced invalid IR
// CHECK-SAME: cmpi operand 'lhs' expected constraint crate::builtin::IntegerType, got !index
