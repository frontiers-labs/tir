// RUN: tir mc --march=rv64i --filetype=asm %s | filecheck %s

// A private function is not visible outside its module, so it lowers to a local
// object symbol rather than a `.global` one.
module {
  func.func private @helper(%0: !i32) -> !i32 {
    func.return %0
  }
  module_end
}

// CHECK-NOT: .global helper
// CHECK: helper:
