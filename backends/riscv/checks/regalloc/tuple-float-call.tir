// RUN: tir mc --march=rv64id --stage=regalloc %s | filecheck %s

module {
  %fn_make_pair = func.declare @make_pair() -> !tuple<!f64, !f64>
  %fn_right = func.func @right() -> !f64 {
    %0 = func.call %fn_make_pair() -> !tuple<!f64, !f64>
    %1 = tuple_get %0 {index = 1} : !f64
    func.return %1
  }
  module_end
}

// CHECK: asm.vcall | %{{[0-9]+}} {callee = "make_pair"
// CHECK: riscv.fsgnj.d {fd = %{{[0-9]+}}:f10, fs = f11}
// CHECK: asm.vret
