// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64ifd --stage=regalloc %s | filecheck %s
// RUN: tir mc --march=rv64ifd --stage=regalloc %s | filecheck %s --check-prefix=ABSENT

// Forty simultaneously-live f32 values overflow the FPR32 file: FP values
// spill through the FP file (fsw stores, flw reloads), never through the
// integer sd/ld path, behind an sp frame prologue.

module {
  %fn_fspill = func.func @fspill(%0: !f32, %1: !f32) -> !f32 {
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %3 = fp.add %2, %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %4 = fp.add %3, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
