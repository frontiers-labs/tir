// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64ifd --stage=regalloc %s | filecheck %s
// RUN: not tir mc --march=rv32ifd --stage=regalloc %s

// An f64 constant needs the whole binary64 pattern in one integer register
// (fmv.d.x), so materialization is rv64-only; rv32 fails loudly.

module {
  %fn_zero = func.func @zero(%0: !f64) -> !f64 {
    %1 = fp.constant {bits = 0} : !f64
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %2
  }
  module_end
}

// CHECK: riscv.lui {rd = %{{[0-9]+}}:{{x[0-9]+}}, imm = 0}
// CHECK: riscv.fmv.d.x {fd = %{{[0-9]+}}:{{f[0-9]+}}, rs1 = %{{[0-9]+}}:{{x[0-9]+}}}
// CHECK: riscv.fadd.d.rne {fd = %{{[0-9]+}}:f10,
// CHECK: asm.vret
