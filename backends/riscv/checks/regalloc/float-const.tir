// RUN: tir mc --march=rv64ifd --stage=regalloc %s | filecheck %s --check-prefixes=CHECK,RV64
// RUN: tir mc --march=rv32if --stage=regalloc %s | filecheck %s --check-prefixes=CHECK,RV32

// A float constant is selected as integer arithmetic over its bit pattern,
// followed by a bit-pattern move into the float file.

module {
  %fn_scale = func.func @scale(%0: !f32) -> !f32 {
    %1 = fp.constant {bits = 1075838976} : !f32
    %2 = fp.mul %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %2
  }
  module_end
}

// CHECK: riscv.lui {rd = %{{[0-9]+}}:{{x[0-9]+}}, imm = 262656}
// CHECK: riscv.fmv.w.x {fd = %{{[0-9]+}}:{{f[0-9]+}}, rs1 = %{{[0-9]+}}:{{x[0-9]+}}}
// CHECK: riscv.fmul.s.rne {fd = %{{[0-9]+}}:{{f[0-9]+}}, fs1 = %{{[0-9]+}}:{{f[0-9]+}}, fs2 = %{{[0-9]+}}:f10}
// CHECK: asm.vret
