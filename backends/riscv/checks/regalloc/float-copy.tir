// RUN: tir mc --march=rv64id --stage=regalloc %s | filecheck %s --check-prefix=COPY
// RUN: tir mc --march=rv64id --filetype=obj-ascii %s | filecheck %s --check-prefix=ENC

// The value one edge forwards stays live past the join, so its copy into the
// block parameter cannot be coalesced away and has to be a real f64 move.

module {
  %fn_forward = func.func @forward(%c: !i1, %0: !f64, %1: !f64) -> !f64 {
    cfg.cond_br %c, ^bb1(%0 : !f64), ^bb2
    ^bb2:
    cfg.br ^bb1(%1 : !f64)
    ^bb1(%2: !f64):
    %3 = addf %2, %0 : !f64
    func.return %3
  }
  module_end
}

// COPY: riscv.fsgnj.d
// ENC: forward:
// ENC: [0xD3, 0x05, 0xA5, 0x22]
