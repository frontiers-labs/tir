// RUN: tir mc --march=rv64i --stage=isel %s | filecheck %s

// The register a value was allocated is an annotation on the function, not a
// rewrite of the instructions naming it: it is written, printed and parsed back
// as one map from value to register.

module {
  builtin.symbol {name = "placed", assignment = [%3:GPR[1], %7:GPR[2]]} {
    builtin.symbol_end
  }
  module_end
}

// CHECK: symbol {name = "placed", assignment = [%3:GPR[1], %7:GPR[2]]}
