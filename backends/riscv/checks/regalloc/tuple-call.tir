// RUN: tir mc --march=rv64i --stage=regalloc %s | filecheck %s

module {
  func.declare @make_pair() -> !tuple<!i64, !i64>
  func.func @right() -> !i64 {
    %0 = func.call @make_pair() -> !tuple<!i64, !i64>
    %1 = tuple_get %0 {index = 1} : !i64
    func.return %1
  }
  module_end
}

// CHECK: asm.vcall {callee = "make_pair"
// CHECK: riscv.addi {rd = x10, rs1 = x11, imm = 0}
// CHECK: asm.vret
