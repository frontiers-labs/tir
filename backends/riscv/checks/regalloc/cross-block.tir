// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=rv64i --stage=regalloc %s | filecheck %s

// %v is defined in the entry block but only read in ^bb1, so it is live across
// the conditional branch. The allocator must keep its register reserved through
// the branch and the ^bb1 temporary: without real CFG successors in liveness it
// looked dead at its def and could be clobbered before the cross-block use.
module {
  %fn_f = func.func @f(%a: !i64, %b: !i64, %c: !i64) -> !i64 {
    %v = addi %a, %b : !i64
    %cond = cmpi %a, %c {predicate = "slt"} : !i1
    cfg.cond_br %cond, ^bb1, ^bb2
  ^bb1:
    %t = addi %c, %c : !i64
    %r = addi %v, %t : !i64
    func.return %r
  ^bb2:
    %s = addi %c, %b : !i64
    func.return %s
  }
  module_end
}

// CHECK: riscv.add {rd = %{{[0-9]+}}:[[V:x[0-9]+]], rs1 = %{{[0-9]+}}:x10, rs2 = %{{[0-9]+}}:x11}
// CHECK: riscv.blt
// The ^bb1 temporary must not reuse %v's register, and the cross-block add still
// reads %v — proof it survived the branch. (The add reads its operands in the
// order the IR names them, %v first.)
// CHECK: riscv.add {rd = %{{[0-9]+}}:{{x[0-9]+}}, rs1 = %{{[0-9]+}}:x12, rs2 = %{{[0-9]+}}:x12}
// CHECK: riscv.add {rd = %{{[0-9]+}}:x10, rs1 = %{{[0-9]+}}:[[V]], rs2 = %{{[0-9]+}}:{{x[0-9]+}}}
// CHECK: asm.vret
