// RUN: tir mc --march=riscv64 --mabi=lp64d --stage=regalloc %s | filecheck %s

module {
  %fn_make_large = func.func @make_large(%0: !ptr.p, %1: !i64) result_address {
    ptr.store %1, %0
    func.return
  }
  %fn_caller = func.func @caller(%0: !ptr.p, %1: !i64) {
    func.call %fn_make_large(%0, %1 : !ptr.p, !i64) result_address
    func.return
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "make_large"
// CHECK: riscv.sd {rs1 = %{{[0-9]+}}:x10, rs2 = %{{[0-9]+}}:x11, imm = 0}
// CHECK-LABEL: asm.symbol {name = "caller"
// CHECK-NOT: riscv.addi {rd = x10
// CHECK-NOT: riscv.addi {rd = x11
// CHECK: asm.vcall {{.*}}state(%{{[0-9]+}}, %{{[0-9]+}}) {callee = "make_large"
// CHECK-SAME: uses = [GPR[2]], passed_in = [GPR[11], GPR[10]]
