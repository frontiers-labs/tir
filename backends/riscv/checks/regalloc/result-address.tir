// RUN: tir mc --march=riscv64 --mabi=lp64d --stage=regalloc %s | filecheck %s

module {
  func.func @make_large(%0: !ptr.p, %1: !i64) result_address {
    ptr.store %1, %0
    func.return
  }
  func.func @caller(%0: !ptr.p, %1: !i64) {
    func.call @make_large(%0, %1 : !ptr.p, !i64) result_address
    func.return
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "make_large"
// CHECK: riscv.sd {rs1 = x10, rs2 = x11, imm = 0}
// CHECK-LABEL: asm.symbol {name = "caller"
// CHECK-DAG: riscv.addi {rd = x10, rs1 = {{x[0-9]+}}, imm = 0}
// CHECK-DAG: riscv.addi {rd = x11, rs1 = {{x[0-9]+}}, imm = 0}
// CHECK: asm.vcall {callee = "make_large"
