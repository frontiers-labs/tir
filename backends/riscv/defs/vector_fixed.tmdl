    vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| sat_signed(sext(a, (VCFG::sew + zext(0b1, self.XLEN))) - sext(b, (VCFG::sew + zext(0b1, self.XLEN))), (VCFG::sew + zext(0b1, self.XLEN)))));
