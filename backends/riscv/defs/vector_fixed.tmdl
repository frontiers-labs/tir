vector_pair!(VSsubuVV, VSsubuVVM, RVV, VArithVV, VArithVVM, "vssubu.vv", 0b100010, {
    vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if a ~< b { zext(0b0, VCFG::sew) } else { a - b }));
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    sat = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b0, 1) } else { reduce(map(zip(split(vs2, n, VCFG::sew), split(vs1, n, VCFG::sew)), |a, b| if a ~< b { zext(0b1, 1) } else { zext(0b0, 1) }), |acc, x| acc | x) };
    VCSR::vxsat = VCSR::vxsat | zext(sat, self.XLEN);
}, {
    vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { if a ~< b { zext(0b0, VCFG::sew) } else { a - b } } else { old }));
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    sat = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b0, 1) } else { reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew), split(vs1, n, VCFG::sew)), |m, a, b| if m { if a ~< b { zext(0b1, 1) } else { zext(0b0, 1) } } else { zext(0b0, 1) }), |acc, x| acc | x) };
    VCSR::vxsat = VCSR::vxsat | zext(sat, self.XLEN);
})

