    vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| sat_unsigned(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew + zext(0b1, self.XLEN))), (VCFG::sew + zext(0b1, self.XLEN)))));
