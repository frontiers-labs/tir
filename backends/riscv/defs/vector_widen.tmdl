    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| sext(a, (VCFG::sew * zext(0b10, self.XLEN))) + sext(b, (VCFG::sew * zext(0b10, self.XLEN))))); },
