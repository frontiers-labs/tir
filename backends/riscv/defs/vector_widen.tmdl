//! Widening and narrowing vector integer arithmetic from the RISC-V Vector
//! extension: widening add/subtract/multiply and multiply-accumulate (with
//! their double-width-source .wv/.wx forms), narrowing shifts, and the
//! vzext/vsext integer extension ops.
//!
//! Widening results are 2*SEW-bit lanes (the destination register group
//! doubles); narrowing shifts take a 2*SEW source down to SEW lanes.

// Widening forms: OPMVV (010) / OPMVX (110). Narrowing shifts are OPI:
// wv (000), wx (100), wi (011).
template OpWideVV for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b010;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpWideVVM for [RVV] : OpWideVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template OpWideVX for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b110;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        rs1: GPR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpWideVXM for [RVV] : OpWideVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

template OpWMaccVV for [RVV] : OpWideVV {
    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}"
    }
}

template OpWMaccVVM for [RVV] : OpWideVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}, v0.t"
    }
}

template OpWMaccVX for [RVV] : OpWideVX {
    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}"
    }
}

template OpWMaccVXM for [RVV] : OpWideVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}, v0.t"
    }
}

template OpNarrowWV for [RVV] : OpWideVV {
    param FUNCT3: bits<3> = 0b000;
}

template OpNarrowWVM for [RVV] : OpNarrowWV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template OpNarrowWX for [RVV] : OpWideVX {
    param FUNCT3: bits<3> = 0b100;
}

template OpNarrowWXM for [RVV] : OpNarrowWX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

template OpNarrowWI for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b011;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        imm: bits<5>,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        imm,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}"
    }

    schedule { units = [WriteIALU]; }
}

template OpNarrowWIM for [RVV] : OpNarrowWI {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0.t"
    }
}

// vzext/vsext: the vs1 field selects the packing factor.
template OpVext for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010010;
    param VS1: bits<5>;
    param FUNCT3: bits<3> = 0b010;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        VS1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}"
    }

    schedule { units = [WriteIALU]; }
}

template OpVextM for [RVV] : OpVext {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, v0.t"
    }
}


instruction VWadduVV for [RVV] : OpWideVV {
    param MNEMONIC: String = "vwaddu.vv";
    param FUNCT6: bits<6> = 0b110000;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| zext(a, (VCFG::sew * zext(0b10, self.XLEN))) + zext(b, (VCFG::sew * zext(0b10, self.XLEN)))));
    }
}

instruction VWadduVVM for [RVV] : OpWideVVM {
    param OPNAME: String = "vwaddu.vv.m";
    param MNEMONIC: String = "vwaddu.vv";
    param FUNCT6: bits<6> = 0b110000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, (VCFG::sew * zext(0b10, self.XLEN)))), |m, a, b, old| if m { zext(a, (VCFG::sew * zext(0b10, self.XLEN))) + zext(b, (VCFG::sew * zext(0b10, self.XLEN))) } else { old }));
    }
}

instruction VWadduVX for [RVV] : OpWideVX {
    param MNEMONIC: String = "vwaddu.vx";
    param FUNCT6: bits<6> = 0b110000;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| zext(a, (VCFG::sew * zext(0b10, self.XLEN))) + zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew * zext(0b10, self.XLEN)))));
    }
}

instruction VWadduVXM for [RVV] : OpWideVXM {
    param OPNAME: String = "vwaddu.vx.m";
    param MNEMONIC: String = "vwaddu.vx";
    param FUNCT6: bits<6> = 0b110000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, (VCFG::sew * zext(0b10, self.XLEN)))), |m, a, old| if m { zext(a, (VCFG::sew * zext(0b10, self.XLEN))) + zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew * zext(0b10, self.XLEN))) } else { old }));
    }
}

