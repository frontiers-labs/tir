//! Vector memory instructions from the RISC-V Vector extension: unit-stride,
//! strided, and indexed loads and stores; fault-only-first, whole-register,
//! and mask (vlm/vsm) forms.
//!
//! Unit-stride forms are a single wide access of `vl * (EEW/8)` bytes — the
//! executor's memory interface accepts accesses wider than a word. Strided and
//! indexed forms access per lane with the map-as-effect idiom (the store is
//! the mapped value). Masked forms keep the old destination lane where the
//! mask bit is clear.
//!
//! Two deliberate simplifications, both only observable at access granularity,
//! never in architectural data:
//!
//! - The executor evaluates both arms of a select, so a masked-off lane's
//!   access still happens (masked stores rewrite the lane's current content,
//!   which is invisible in a RAM model). Fault suppression by the mask is not
//!   modeled.
//! - Fault-only-first loads share the unit-stride behavior: the no-fault path.
//!   The truncate-vl-at-fault response needs page-fault plumbing the simulator
//!   memory model does not have.
//!
//! Ordered and unordered indexed forms share a behavior: the distinction is a
//! memory-ordering property, invisible to this per-hart model.

// The byte count of one element at the current SEW.
fn elem_bytes() {
    VCFG::sew >> zext(0b11, self.XLEN)
}


template VLeMem for [RVV] {
    param MNEMONIC: String;
    param WIDTH3: bits<3>;
    param OPCODE: bits<7>;

    operands {
        vd: VR,
        rs1: GPR,
    }

    encoding {
        0b000000,
        0b1,
        0b00000,
        rs1,
        WIDTH3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, ({rs1})"
    }

    schedule { units = [WriteIALU]; }
}

template VSeMem for [RVV] {
    param MNEMONIC: String;
    param WIDTH3: bits<3>;
    param OPCODE: bits<7>;

    operands {
        vs3: VR,
        rs1: GPR,
    }

    encoding {
        0b000000,
        0b1,
        0b00000,
        rs1,
        WIDTH3,
        vs3,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vs3}, ({rs1})"
    }

    schedule { units = [WriteIALU]; }
}

