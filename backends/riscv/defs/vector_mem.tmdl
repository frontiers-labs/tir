    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, 8), split(vd, VCSR::vl, VCFG::sew)), |m, idx, o| if m { load(rs1 + zext(idx, self.XLEN), elem_bytes(), 0b0) } else { o }));
    }
}

instruction VVloxei8M for [RVV] : VVloxeiMMem {
