instruction VLe16M for [RVV] : VLeMMem {
    param MNEMONIC: String = "vle16.v";
    param OPNAME: String = "vle16.v.m";
    param WIDTH3: bits<3> = 0b101;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
