instruction VLmV for [RVV] {
    param MNEMONIC: String = "vlm.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    operands {
        vd: VR,
        rs1: GPR,
    }

    encoding {
        0b000000,
        0b1,
        0b01011,
        rs1,
        WIDTH3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, ({rs1})"
    }

    behavior {
        vd = load(rs1, (VCSR::vl + zext(0b111, self.XLEN)) >> zext(0b11, self.XLEN), 0b0);
    }

    schedule { units = [WriteIALU]; }
}

