    }
}

instruction VLe8M for [RVV] : VLeMMem {
    param MNEMONIC: String = "vle8.v";
    param OPNAME: String = "vle8.v.m";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        loaded = load(rs1, VCSR::vl, 0b0);
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(loaded, VCSR::vl, 8), split(vd, VCSR::vl, 8)), |m, n, o| if m { n } else { o }));
    }
}

instruction VSe8M for [RVV] : VSeMMem {
    param MNEMONIC: String = "vse8.v";
    param OPNAME: String = "vse8.v.m";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0100111;

    behavior {
        current = load(rs1, VCSR::vl, 0b0);
        merged = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs3, VCSR::vl, 8), split(current, VCSR::vl, 8)), |m, v, o| if m { v } else { o }));
        store(rs1, VCSR::vl, merged);
    }
}

instruction VLe8FFM for [RVV] : VLeFFMMem {
    param MNEMONIC: String = "vle8ff.v";
    param OPNAME: String = "vle8ff.v.m";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        loaded = load(rs1, VCSR::vl, 0b0);
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(loaded, VCSR::vl, 8), split(vd, VCSR::vl, 8)), |m, n, o| if m { n } else { o }));
    }
}

instruction VLse8M for [RVV] : VLseMMem {
    param MNEMONIC: String = "vlse8.v";
    param OPNAME: String = "vlse8.v.m";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), iota(VCSR::vl, self.XLEN), split(vd, VCSR::vl, 8)), |m, i, o| if m { load(rs1 + i * rs2, 1, 0b0) } else { o }));
    }
}

instruction VSse8M for [RVV] : VSseMMem {
    param MNEMONIC: String = "vsse8.v";
    param OPNAME: String = "vsse8.v.m";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0100111;

    behavior {
        concat(map(zip(split(VR::v0, VCSR::vl, 1), iota(VCSR::vl, self.XLEN), split(vs3, VCSR::vl, 8)), |m, i, v| store(rs1 + i * rs2, 1, if m { v } else { extract(load(rs1 + i * rs2, 1, 0b0), 7, 0) })));
    }
}

instruction VVluxei8M for [RVV] : VVluxeiMMem {
    param MNEMONIC: String = "vluxei8.v";
    param OPNAME: String = "vluxei8.v.m";
    param WIDTH3: bits<3> = 0b000;
