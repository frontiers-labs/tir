instruction VLe8 for [RVV] : VLeMem {
    param MNEMONIC: String = "vle8.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        vd = load(rs1, VCSR::vl, 0b0);
    }
}

instruction VSe8 for [RVV] : VSeMem {
    param MNEMONIC: String = "vse8.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0100111;

    behavior {
        store(rs1, VCSR::vl, vs3);
    }
}

instruction VLe8FF for [RVV] : VLeFFMem {
    param MNEMONIC: String = "vle8ff.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        vd = load(rs1, VCSR::vl, 0b0);
    }
}

instruction VLse8 for [RVV] : VLseMem {
    param MNEMONIC: String = "vlse8.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        vd = concat(map(iota(VCSR::vl, self.XLEN), |i| load(rs1 + i * rs2, 1, 0b0)));
    }
}

instruction VSse8 for [RVV] : VSseMem {
    param MNEMONIC: String = "vsse8.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0100111;

    behavior {
        concat(map(zip(iota(VCSR::vl, self.XLEN), split(vs3, VCSR::vl, 8)), |i, v| store(rs1 + i * rs2, 1, v)));
    }
}

instruction VVluxei8 for [RVV] : VVluxeiMem {
    param MNEMONIC: String = "vluxei8.v";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0000111;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, 8), |idx| load(rs1 + zext(idx, self.XLEN), elem_bytes(), 0b0)));
    }
}

instruction VVloxei8 for [RVV] : VVloxeiMem {
    param MNEMONIC: String = "vloxei8.v";
