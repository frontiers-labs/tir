    }
}

instruction VVsuxei8M for [RVV] : VVsuxeiMMem {
    param MNEMONIC: String = "vsuxei8.v";
    param OPNAME: String = "vsuxei8.v.m";
    param WIDTH3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b0100111;

    behavior {
        concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, 8), split(vs3, VCSR::vl, VCFG::sew)), |m, idx, v| store(rs1 + zext(idx, self.XLEN), elem_bytes(), if m { v } else { extract(load(rs1 + zext(idx, self.XLEN), elem_bytes(), 0b0), (VCFG::sew - zext(0b1, self.XLEN)), 0) })));
    }
}

instruction VVsoxei8M for [RVV] : VVsoxeiMMem {
    param MNEMONIC: String = "vsoxei8.v";
    param OPNAME: String = "vsoxei8.v.m";
