        OPCODE,
    }

    asm { "{self.MNEMONIC} {vd}, ({rs1})" }
    schedule { units = [WriteIALU]; }
}

template VSeWholeMem for [RVV] {
    param MNEMONIC: String;
    param WIDTH3: bits<3>;
    param OPCODE: bits<7>;
    param NF: bits<3> = 0b000;

    encoding {
        NF,
        0b000,
        0b1,
        0b01000,
        rs1,
        WIDTH3,
        vs3,
        OPCODE,
    }

    asm { "{self.MNEMONIC} {vs3}, ({rs1})" }
    schedule { units = [WriteIALU]; }
}

