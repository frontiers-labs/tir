    behavior {
        concat(map(zip(split(vs2, VCSR::vl, 8), split(vs3, VCSR::vl, VCFG::sew)), |idx, v| store(rs1 + zext(idx, self.XLEN), elem_bytes(), v)));
    }
}

instruction VVsoxei8 for [RVV] : VVsoxeiMem {
    param MNEMONIC: String = "vsoxei8.v";
