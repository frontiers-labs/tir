//! Vector configuration and arithmetic instructions from the RISC-V Vector extension.

// A slice of the RISC-V Vector extension (RVV). The vector unit's shape is
// architectural state, not spec-time constants: `vtype` holds the selected
// element width (SEW) and register-group multiplier (LMUL), `vl` holds the
// active element count, and `vlenb` exposes the implementation's VLEN (the
// physical width of a vector register, in bytes). Instruction behavior reads
// these control registers rather than baking VLEN/SEW in, so an OPIVV op is
// genuinely parametric over the configured element width and length.

isa RVV requires [RV32I | RV64I] {
    // The physical vector register width in bits. Implementations may differ;
    // this model fixes it at the Zvl128b minimum, the same assumption the
    // riscv-insert-vsetvli pass makes when sizing register groups.
    param VLEN: Integer = 128;
}

// Vector control and status registers (addressed by their architectural CSR
// numbers). `vlenb` is read-only and reports VLEN/8; `vtype`/`vl`/`vstart` are
// written by `vsetvl{i}` and the vector unit. `vxsat`/`vxrm` are the
// fixed-point saturation flag and rounding mode (also aliased by `vcsr`);
// fixed-point behaviors read `vxrm` and accumulate into `vxsat`.
register_class VCSR for [RVV] {
    param ENCODING_LEN: Integer = 12;
    param WIDTH: Integer = self.XLEN;

    registers {
        vstart => { index = 0x008 },
        vxsat  => { index = 0x009 },
        vxrm   => { index = 0x00A },
        vcsr   => { index = 0x00F },
        vl     => { index = 0xC20 },
        vtype  => { index = 0xC21 },
        vlenb  => { index = 0xC22 },
    }
}

// Decomposed `vtype` fields. Architecturally `vtype` is one packed CSR, but
// instruction behaviors must never decode packed bitfields: a structural
// pattern over bit-slicing would not match the dialect ops' clean semantic
// shape. Instead each field the behaviors consume is its own register —
// `vset{i}vl{i}` writes both the packed CSR (what the architecture shows) and
// these fields (what the semantics read), and the simulator carries them like
// any other register. Reads of `VCFG::sew` surface as `sew` demand attributes
// on selected instructions, exactly like `VCSR::vl` reads surface as `vl`.
// `lmul` is the signed LMUL exponent (vlmul interpreted as two's complement:
// 0..3 = m1/m2/m4/m8, 111/110/101 = mf2/mf4/mf8).
register_class VCFG for [RVV] {
    param ENCODING_LEN: Integer = 3;
    param WIDTH: Integer = self.XLEN;

    registers {
        sew => { index = 0 },
        lmul => { index = 1 },
    }
}

// The 32 architectural vector registers v0..v31. Their physical width is the
// implementation's VLEN, the same fixed quantity `vlenb` reports; how those bits
// are partitioned into elements is governed dynamically by `vtype`.
register_class VR for [RVV] {
    param ENCODING_LEN: Integer = 5;
    // Dynamically sized: a vector register's width is the implementation's VLEN,
    // not a compile-time constant. It is reported at runtime by `vlenb`, so the
    // operand type is `bits<?>` — bits of unknown width. How those bits split
    // into elements is decided by each instruction's behavior (via `vtype`), not
    // by the register, the same way one physical file is reused across SEWs.
    param WIDTH: Integer = VCSR::vlenb;

    // The standard calling convention preserves no vector state: every vector
    // register is caller-saved, so all 32 are allocatable scratch registers.
    // Vector arguments are passed in v8..v23 and results returned in v8..v9
    // (RISC-V psABI, vector register calling convention).
    registers {
        v0..v7 => {},
        v8..v9 => {},
        v10..v23 => {},
        v24..v31 => {},
    }
}


// LMUL>1 register groups: allocation views of the same physical file. A group
// register names its base (the architecturally encoded register number) and
// covers GROUP_SIZE consecutive VR indices, which the allocator honors as a
// span (`RegisterInfo::phys_overlap`): v8m2 conflicts with v8, v9, and v8m4.
// Only aligned bases exist, so alignment falls out of the register list.
// Instruction operands stay declared `VR` -- the LMUL legalization step in the
// riscv-insert-vsetvli pass rewrites a vector op's register attributes to the
// group class its demanded configuration implies, the way virtual registers
// await allocation. Argument/return traits follow the psABI: vector arguments
// in v8..v23 (aligned groups), return values from v8.

register_class VRM2 for [RVV] {
    file = VR;
    param GROUP_SIZE: Integer = 2;
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = VCSR::vlenb;

    registers {
        v0 => { index = 0 },
        v2 => { index = 2 },
        v4 => { index = 4 },
        v6 => { index = 6 },
        v8 => { index = 8 },
        v10 => { index = 10 },
        v12 => { index = 12 },
        v14 => { index = 14 },
        v16 => { index = 16 },
        v18 => { index = 18 },
        v20 => { index = 20 },
        v22 => { index = 22 },
        v24 => { index = 24 },
        v26 => { index = 26 },
        v28 => { index = 28 },
        v30 => { index = 30 },
    }
}

register_class VRM4 for [RVV] {
    file = VR;
    param GROUP_SIZE: Integer = 4;
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = VCSR::vlenb;

    registers {
        v0 => { index = 0 },
        v4 => { index = 4 },
        v8 => { index = 8 },
        v12 => { index = 12 },
        v16 => { index = 16 },
        v20 => { index = 20 },
        v24 => { index = 24 },
        v28 => { index = 28 },
    }
}

register_class VRM8 for [RVV] {
    file = VR;
    param GROUP_SIZE: Integer = 8;
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = VCSR::vlenb;

    registers {
        v0 => { index = 0 },
        v8 => { index = 8 },
        v16 => { index = 16 },
        v24 => { index = 24 },
    }
}

// `vset{i}vl{i}` configure the vector unit. They compute VLMAX =
// VLEN * LMUL / SEW from the requested vtype, grant `vl = min(AVL, VLMAX)`
// (a legal choice for the spec's `ceil(AVL/2) <= vl <= VLMAX` freedom), and
// write the packed `vtype` CSR, the decomposed `VCFG` fields behaviors read,
// and the grant to `vl` and `rd`. An illegal vtype (reserved vsew/vlmul
// encodings, nonzero reserved bits, or SEW > LMUL * ELEN with ELEN = 64) sets
// `vtype.vill` and clears `vl` instead. The rs1 = x0, rd = x0 form keeps the
// current `vl` and requires the LMUL/SEW ratio to be unchanged.
//
// Instruction selection never introduces these by value matching. The OPIVV
// ops' implicit `VCSR::vl`/`VCFG::sew` reads surface as `vl`/`sew` demand
// attributes on each selected op, and the riscv-insert-vsetvli machine pass
// materializes a `vsetivli` (constant AVL) or `vsetvli` (register AVL) exactly
// where the configured state changes. A `vector.vector_len` op lowers directly
// to `vsetvli` with a live `rd`, both granting the count and establishing the
// configuration.

// The shared vset{i}vl{i} logic, as inlined helper functions. `vt` is the
// requested vtype value (the vtypei immediate, or the rs2 register for
// vsetvl).

// SEW = 2^(vsew + 3): the element width the vsew field encodes.
fn sew_pow(vt) {
    zext(extract(vt, 5, 3), self.XLEN) + zext(0b011, self.XLEN)
}

// LMUL = 2^vlmul with vlmul a signed field (mf8/mf4/mf2 are negative).
fn lmul_pow(vt) {
    sext(extract(vt, 2, 0), self.XLEN)
}

// VLMAX = VLEN * LMUL / SEW: every quantity is a power of two, so this is a
// shift in each direction.
fn vlmax(vt) {
    group_bits = if lmul_pow(vt) < zext(0b0, self.XLEN) {
        zext(self.VLEN, self.XLEN) >> (zext(0b0, self.XLEN) - lmul_pow(vt))
    } else {
        zext(self.VLEN, self.XLEN) << lmul_pow(vt)
    };
    group_bits >> sew_pow(vt)
}

// Reserved encodings: vsew 1xx is reserved, vlmul = 0b100 is reserved, and
// SEW must not exceed LMUL * ELEN (ELEN = 64), i.e. vsew + 3 <= vlmul + 6.
fn vtype_fields_illegal(vt) {
    (extract(vt, 5, 5) != zext(0b0, 1))
        | (extract(vt, 2, 0) == zext(0b100, 3))
        | (sew_pow(vt) > lmul_pow(vt) + zext(0b110, self.XLEN))
}

// The keep-vl form (rs1 = rd = x0) additionally requires a valid previous
// vtype and an unchanged LMUL/SEW ratio. Reads the OLD configuration, so call
// before `apply_vtype`.
fn keep_vl_illegal(vt) {
    old_ratio = VCFG::lmul - log2Ceil(VCFG::sew);
    (extract(VCSR::vtype, self.XLEN - 1, self.XLEN - 1) != zext(0b0, 1))
        | (old_ratio != lmul_pow(vt) - sew_pow(vt))
}

// An illegal request sets vtype.vill and clears vl; the grant is zero.
fn set_vill() {
    VCSR::vtype = zext(0b1, self.XLEN) << (self.XLEN - 1);
    VCSR::vl = zext(0b0, self.XLEN);
    VCSR::vstart = zext(0b0, self.XLEN);
    rd = zext(0b0, self.XLEN);
}

// A legal request publishes the packed vtype (given as `packed`), the
// decomposed VCFG fields, and clears vstart.
fn apply_vtype(vt, packed) {
    VCFG::sew = zext(0b1, self.XLEN) << sew_pow(vt);
    VCFG::lmul = lmul_pow(vt);
    VCSR::vtype = packed;
    VCSR::vstart = zext(0b0, self.XLEN);
}

// The grant: the request when it fits, VLMAX otherwise.
fn grant(vlmax, requested) {
    if requested ~< vlmax { requested } else { vlmax }
}

// VLMAX of the *current* configuration (reads VCFG, unlike `vlmax` which
// evaluates a requested vtype). Used by slides and gathers.
fn current_vlmax() {
    group_bits = if VCFG::lmul < zext(0b0, self.XLEN) {
        zext(self.VLEN, self.XLEN) >> (zext(0b0, self.XLEN) - VCFG::lmul)
    } else {
        zext(self.VLEN, self.XLEN) << VCFG::lmul
    };
    group_bits / VCFG::sew
}

instruction VSetVli for [RVV] {
    param MNEMONIC: String = "vsetvli";
    param OPCODE: bits<7> = 0b1010111;
    param FUNCT3: bits<3> = 0b111;

    operands {
        rd: GPR,
        avl: GPR,
        vtypei: bits<11>,
    }

    encoding {
        0b0,
        vtypei,
        avl,
        FUNCT3,
        rd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {rd}, {avl}, {vtypei}"
    }

    behavior {
        keep_vl = (regnum(avl) == zext(0b0, 5)) & (regnum(rd) == zext(0b0, 5));
        illegal = (extract(vtypei, 10, 8) != zext(0b0, 3))
            | vtype_fields_illegal(vtypei)
            | (keep_vl & keep_vl_illegal(vtypei));

        if illegal == zext(0b1, 1) {
            set_vill()
        } else {
            apply_vtype(vtypei, zext(vtypei, self.XLEN));
            requested = if keep_vl == zext(0b1, 1) {
                VCSR::vl
            } else if regnum(avl) == zext(0b0, 5) {
                vlmax(vtypei)
            } else {
                avl
            };
            VCSR::vl = grant(vlmax(vtypei), requested);
            rd = VCSR::vl;
        }
    }

    schedule { units = [WriteIALU]; }
}

instruction VSetIVli for [RVV] {
    param MNEMONIC: String = "vsetivli";
    param OPCODE: bits<7> = 0b1010111;
    param FUNCT3: bits<3> = 0b111;

    operands {
        rd: GPR,
        avl: bits<5>,
        vtypei: bits<10>,
    }

    encoding {
        0b11,
        vtypei,
        avl,
        FUNCT3,
        rd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {rd}, {avl}, {vtypei}"
    }

    behavior {
        illegal = (extract(vtypei, 9, 8) != zext(0b0, 2)) | vtype_fields_illegal(vtypei);

        if illegal == zext(0b1, 1) {
            set_vill()
        } else {
            apply_vtype(vtypei, zext(vtypei, self.XLEN));
            VCSR::vl = grant(vlmax(vtypei), zext(avl, self.XLEN));
            rd = VCSR::vl;
        }
    }

    schedule { units = [WriteIALU]; }
}

// `vsetvl` takes the vtype from a register: the whole XLEN value is
// interpreted as a vtype, so any bit above vma (including a set vill) makes
// the request illegal.
instruction VSetVL for [RVV] {
    param MNEMONIC: String = "vsetvl";
    param OPCODE: bits<7> = 0b1010111;
    param FUNCT3: bits<3> = 0b111;

    operands {
        rd: GPR,
        avl: GPR,
        vt: GPR,
    }

    encoding {
        0b1000000,
        vt,
        avl,
        FUNCT3,
        rd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {rd}, {avl}, {vt}"
    }

    behavior {
        keep_vl = (regnum(avl) == zext(0b0, 5)) & (regnum(rd) == zext(0b0, 5));
        illegal = (extract(vt, self.XLEN - 1, 8) != zext(0b0, self.XLEN - 8))
            | vtype_fields_illegal(vt)
            | (keep_vl & keep_vl_illegal(vt));

        if illegal == zext(0b1, 1) {
            set_vill()
        } else {
            apply_vtype(vt, zext(extract(vt, 7, 0), self.XLEN));
            requested = if keep_vl == zext(0b1, 1) {
                VCSR::vl
            } else if regnum(avl) == zext(0b0, 5) {
                vlmax(vt)
            } else {
                avl
            };
            VCSR::vl = grant(vlmax(vt), requested);
            rd = VCSR::vl;
        }
    }

    schedule { units = [WriteIALU]; }
}

macro whole_register_moves {
    ( $( ( $name:ident, $mnemonic:literal, $class:ident, $nfields:literal ) ),* ) => {
        $( instruction $name for [RVV] {
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<7> = 0b1010111;
            param FUNCT3: bits<3> = 0b011;
            param NFIELDS: bits<5> = $nfields;
            param FUNCT6: bits<6> = 0b100111;

            operands {
                vd: $class,
                vs: $class,
            }

            encoding {
                FUNCT6,
                0b1,
                vs[4..0],
                NFIELDS,
                FUNCT3,
                vd[4..0],
                OPCODE,
            }

            asm {
                "{self.MNEMONIC} {vd}, {vs}"
            }

            behavior {
                vd = vs;
            }

            schedule { units = [WriteIALU]; }
        } )*
    };
}

whole_register_moves!(
    (VMove1R, "vmv1r.v", VR, 0),
    (VMove2R, "vmv2r.v", VRM2, 1),
    (VMove4R, "vmv4r.v", VRM4, 3),
    (VMove8R, "vmv8r.v", VRM8, 7)
)

