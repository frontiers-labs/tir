//! Vector reduction instructions from the RISC-V Vector extension: the
//! single-width integer reductions (OPMVV) and the widening sums (OPIVV).
//!
//! A reduction folds the active lanes of vs2 into element 0 of vs1 and writes
//! the sew-bit (2*SEW-bit for the widening forms) total to element 0 of vd;
//! the remaining destination lanes read as zero, a legal tail-agnostic choice.
//! With vl = 0 the destination register is left unchanged. In the masked forms
//! the inactive lanes contribute the operation's identity, so they drop out of
//! the fold. The fold count is clamped to one lane so the dead select arm
//! never reduces an empty iterator.

template OpRedVV for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b010;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpRedVVM for [RVV] : OpRedVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template OpWRedVV for [RVV] : OpRedVV {
    param FUNCT3: bits<3> = 0b000;
}

template OpWRedVVM for [RVV] : OpWRedVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

vector_pair!(VRedsumVS, VRedsumVSM, RVV, OpRedVV, OpRedVVM, "vredsum.vs", 0b000000, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) + reduce(split(vs2, n, VCFG::sew), |acc, x| acc + x) };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) + reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { zext(0b0, VCFG::sew) }), |acc, x| acc + x) };
})

vector_pair!(VRedandVS, VRedandVSM, RVV, OpRedVV, OpRedVVM, "vredand.vs", 0b000001, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) & reduce(split(vs2, n, VCFG::sew), |acc, x| acc & x) };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) & reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { sext(0b1, VCFG::sew) }), |acc, x| acc & x) };
})

vector_pair!(VRedorVS, VRedorVSM, RVV, OpRedVV, OpRedVVM, "vredor.vs", 0b000010, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) | reduce(split(vs2, n, VCFG::sew), |acc, x| acc | x) };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) | reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { zext(0b0, VCFG::sew) }), |acc, x| acc | x) };
})

vector_pair!(VRedxorVS, VRedxorVSM, RVV, OpRedVV, OpRedVVM, "vredxor.vs", 0b000011, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) ^ reduce(split(vs2, n, VCFG::sew), |acc, x| acc ^ x) };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) ^ reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { zext(0b0, VCFG::sew) }), |acc, x| acc ^ x) };
})

vector_pair!(VRedminuVS, VRedminuVSM, RVV, OpRedVV, OpRedVVM, "vredminu.vs", 0b000100, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(split(vs2, n, VCFG::sew), |acc, x| if acc ~< x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r ~< extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { sext(0b1, VCFG::sew) }), |acc, x| if acc ~< x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r ~< extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
})

vector_pair!(VRedminVS, VRedminVSM, RVV, OpRedVV, OpRedVVM, "vredmin.vs", 0b000101, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(split(vs2, n, VCFG::sew), |acc, x| if acc < x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r < extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { sext(0b01, VCFG::sew) }), |acc, x| if acc < x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r < extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
})

vector_pair!(VRedmaxuVS, VRedmaxuVSM, RVV, OpRedVV, OpRedVVM, "vredmaxu.vs", 0b000110, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(split(vs2, n, VCFG::sew), |acc, x| if acc ~> x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r ~> extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { zext(0b0, VCFG::sew) }), |acc, x| if acc ~> x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r ~> extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
})

vector_pair!(VRedmaxVS, VRedmaxVSM, RVV, OpRedVV, OpRedVVM, "vredmax.vs", 0b000111, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(split(vs2, n, VCFG::sew), |acc, x| if acc > x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r > extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    r = reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { x } else { zext(0b1, VCFG::sew) << (VCFG::sew - zext(0b1, self.XLEN)) }), |acc, x| if acc > x { acc } else { x });
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { if r > extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { r } else { extract(vs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } };
})

// Widening sums: the lanes are extended to 2*SEW before the fold, and element
// 0 of vs1 is read at the wide width.
vector_pair!(VWredsumuVS, VWredsumuVSM, RVV, OpWRedVV, OpWRedVVM, "vwredsumu.vs", 0b110000, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, ((VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN)), 0) + reduce(map(split(vs2, n, VCFG::sew), |x| zext(x, VCFG::sew * zext(0b10, self.XLEN))), |acc, x| acc + x) };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, ((VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN)), 0) + reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { zext(x, VCFG::sew * zext(0b10, self.XLEN)) } else { zext(0b0, VCFG::sew * zext(0b10, self.XLEN)) }), |acc, x| acc + x) };
})

vector_pair!(VWredsumVS, VWredsumVSM, RVV, OpWRedVV, OpWRedVVM, "vwredsum.vs", 0b110001, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, ((VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN)), 0) + reduce(map(split(vs2, n, VCFG::sew), |x| sext(x, VCFG::sew * zext(0b10, self.XLEN))), |acc, x| acc + x) };
}, {
    n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
    vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { extract(vs1, ((VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN)), 0) + reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, VCFG::sew)), |m, x| if m { sext(x, VCFG::sew * zext(0b10, self.XLEN)) } else { zext(0b0, VCFG::sew * zext(0b10, self.XLEN)) }), |acc, x| acc + x) };
})
