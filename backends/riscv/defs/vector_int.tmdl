    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| extract(a * b, ((VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN)), VCFG::sew) + (sext(extract(a, (VCFG::sew - zext(0b1, self.XLEN)), (VCFG::sew - zext(0b1, self.XLEN))), VCFG::sew) & b) + (sext(extract(b, (VCFG::sew - zext(0b1, self.XLEN)), (VCFG::sew - zext(0b1, self.XLEN))), VCFG::sew) & a)));
