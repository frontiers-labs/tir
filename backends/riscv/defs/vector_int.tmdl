//! Vector integer arithmetic instructions from the RISC-V Vector extension:
//! the OPIVV/OPIVX/OPIVI and OPMVV/OPMVX forms — add/subtract, logical,
//! shifts, min/max, compares, add/subtract with carry/borrow, merge and move,
//! multiply, divide, and multiply-accumulate.
//!
//! Lane semantics follow the functional idiom: sources are split into `vl`
//! lanes of `sew` bits, combined with `map`/`zip`, and concatenated back.
//! Unmasked forms (vm = 1) compute every lane below `vl`; masked forms
//! (vm = 0, the ", v0.t" assembly suffix) keep the old destination lane where
//! the mask bit in v0 is clear (mask-undisturbed, a legal choice for
//! mask-agnostic). Tail lanes above `vl` read as zero (tail-agnostic).
//!
//! The scalar source of a .vx form is truncated to SEW, and the immediate of
//! a .vi form is sign-extended to SEW (zero-extended for shifts), per the
//! spec's operand rules.

template VArithVV for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b000;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template VArithVVM for [RVV] : VArithVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template VArithVX for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b100;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        rs1: GPR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}"
    }

    schedule { units = [WriteIALU]; }
}

template VArithVXM for [RVV] : VArithVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

template VArithVI for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b011;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        imm: bits<5>,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        imm,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}"
    }

    schedule { units = [WriteIALU]; }
}

template VArithVIM for [RVV] : VArithVI {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0.t"
    }
}

template OpMVV for [RVV] : VArithVV {
    param FUNCT3: bits<3> = 0b010;
}

template OpMVVM for [RVV] : OpMVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template OpMVX for [RVV] : VArithVX {
    param FUNCT3: bits<3> = 0b110;
}

template OpMVXM for [RVV] : OpMVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

// Multiply-accumulates print the vector sources in vs1-then-vs2 order.
template OpMAccVV for [RVV] : OpMVV {
    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}"
    }
}

template OpMAccVVM for [RVV] : OpMVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}, v0.t"
    }
}

template OpMAccVX for [RVV] : OpMVX {
    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}"
    }
}

template OpMAccVXM for [RVV] : OpMVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}, v0.t"
    }
}

// Carry/borrow instructions take the carry-in from v0, printed without the
// ".t" suffix, and exist only in the masked (vm = 0) encoding.
template OpCarryVV for [RVV] : VArithVVM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0"
    }
}

template OpCarryVX for [RVV] : VArithVXM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0"
    }
}

template OpCarryVI for [RVV] : VArithVIM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0"
    }
}

// `vmv.v.{v,x,i}` are the vm = 1 encodings of the vmerge funct6 with the vs2
// field tied to zero.
template OpMergeVV for [RVV] : VArithVVM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0"
    }
}

template OpMergeVX for [RVV] : VArithVXM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0"
    }
}

template OpMergeVI for [RVV] : VArithVIM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0"
    }
}

template OpMvV for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpMvX for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b100;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        rs1: GPR,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {rs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpMvI for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b011;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        imm: bits<5>,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        imm,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {imm}"
    }

    schedule { units = [WriteIALU]; }
}


// Integer add and subtract.

instruction VAddVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vadd.vv";
    param FUNCT6: bits<6> = 0b000000;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a + b));
    }
}

instruction VAddVVM for [RVV] : VArithVVM {
    param OPNAME: String = "vadd.vv.m";
    param MNEMONIC: String = "vadd.vv";
    param FUNCT6: bits<6> = 0b000000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a + b } else { old }));
    }
}

instruction VAddVX for [RVV] : VArithVX {
    param MNEMONIC: String = "vadd.vx";
    param FUNCT6: bits<6> = 0b000000;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a + extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0)));
    }
}

instruction VAddVXM for [RVV] : VArithVXM {
    param OPNAME: String = "vadd.vx.m";
    param MNEMONIC: String = "vadd.vx";
    param FUNCT6: bits<6> = 0b000000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a + extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old }));
    }
}

instruction VAddVI for [RVV] : VArithVI {
    param MNEMONIC: String = "vadd.vi";
    param FUNCT6: bits<6> = 0b000000;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a + sext(imm, VCFG::sew)));
    }
}

instruction VAddVIM for [RVV] : VArithVIM {
    param OPNAME: String = "vadd.vi.m";
    param MNEMONIC: String = "vadd.vi";
    param FUNCT6: bits<6> = 0b000000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a + sext(imm, VCFG::sew) } else { old }));
    }
}

instruction VSubVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vsub.vv";
    param FUNCT6: bits<6> = 0b000010;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a - b));
    }
}

instruction VSubVVM for [RVV] : VArithVVM {
    param OPNAME: String = "vsub.vv.m";
    param MNEMONIC: String = "vsub.vv";
    param FUNCT6: bits<6> = 0b000010;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a - b } else { old }));
    }
}

instruction VSubVX for [RVV] : VArithVX {
    param MNEMONIC: String = "vsub.vx";
    param FUNCT6: bits<6> = 0b000010;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a - extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0)));
    }
}

instruction VSubVXM for [RVV] : VArithVXM {
    param OPNAME: String = "vsub.vx.m";
    param MNEMONIC: String = "vsub.vx";
    param FUNCT6: bits<6> = 0b000010;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a - extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old }));
    }
