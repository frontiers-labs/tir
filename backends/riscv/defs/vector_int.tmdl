// Multiply and divide (OPM forms). Division by zero yields all-ones for the
// quotient and the dividend for the remainder; the MIN/-1 overflow falls out of
// two's-complement wrapping. The mulh forms use the extract-of-product idiom
// (a signed high half) plus the unsigned-bias corrections.

instruction VDivuVV for [RVV] : OpMVV {
    param MNEMONIC: String = "vdivu.vv";
    param FUNCT6: bits<6> = 0b100000;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if b == zext(0b0, VCFG::sew) { sext(0b1, VCFG::sew) } else { a ~/ b }));
    }
}

instruction VDivuVVM for [RVV] : OpMVVM {
    param OPNAME: String = "vdivu.vv.m";
    param MNEMONIC: String = "vdivu.vv";
