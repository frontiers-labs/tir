//! Vector integer arithmetic instructions from the RISC-V Vector extension:
//! the OPIVV/OPIVX/OPIVI and OPMVV/OPMVX forms — add/subtract, logical,
//! shifts, min/max, compares, add/subtract with carry/borrow, merge and move,
//! multiply, divide, and multiply-accumulate.
//!
//! Lane semantics follow the functional idiom: sources are split into `vl`
//! lanes of `sew` bits, combined with `map`/`zip`, and concatenated back.
//! Unmasked forms (vm = 1) compute every lane below `vl`; masked forms
//! (vm = 0, the ", v0.t" assembly suffix) keep the old destination lane where
//! the mask bit in v0 is clear (mask-undisturbed, a legal choice for
//! mask-agnostic). Tail lanes above `vl` read as zero (tail-agnostic).
//!
//! The scalar source of a .vx form is truncated to SEW, and the immediate of
//! a .vi form is sign-extended to SEW (zero-extended for shifts), per the
//! spec's operand rules.

template VArithVV for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b000;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template VArithVVM for [RVV] : VArithVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template VArithVX for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b100;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        rs1: GPR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}"
    }

    schedule { units = [WriteIALU]; }
}

template VArithVXM for [RVV] : VArithVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

template VArithVI for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b011;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        imm: bits<5>,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        imm,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}"
    }

    schedule { units = [WriteIALU]; }
}

template VArithVIM for [RVV] : VArithVI {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0.t"
    }
}

template OpMVV for [RVV] : VArithVV {
    param FUNCT3: bits<3> = 0b010;
}

template OpMVVM for [RVV] : OpMVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

template OpMVX for [RVV] : VArithVX {
    param FUNCT3: bits<3> = 0b110;
}

template OpMVXM for [RVV] : OpMVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

// Multiply-accumulates print the vector sources in vs1-then-vs2 order.
template OpMAccVV for [RVV] : OpMVV {
    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}"
    }
}

template OpMAccVVM for [RVV] : OpMVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}, v0.t"
    }
}

template OpMAccVX for [RVV] : OpMVX {
    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}"
    }
}

template OpMAccVXM for [RVV] : OpMVX {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}, v0.t"
    }
}

// Carry/borrow instructions take the carry-in from v0, printed without the
// ".t" suffix, and exist only in the masked (vm = 0) encoding.
template OpCarryVV for [RVV] : VArithVVM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0"
    }
}

template OpCarryVX for [RVV] : VArithVXM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0"
    }
}

template OpCarryVI for [RVV] : VArithVIM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0"
    }
}

// `vmv.v.{v,x,i}` are the vm = 1 encodings of the vmerge funct6 with the vs2
// field tied to zero.
template OpMergeVV for [RVV] : VArithVVM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0"
    }
}

template OpMergeVX for [RVV] : VArithVXM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0"
    }
}

template OpMergeVI for [RVV] : VArithVIM {
    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {imm}, v0"
    }
}

template OpMvV for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b000;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpMvX for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b100;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        rs1: GPR,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {rs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpMvI for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b011;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        imm: bits<5>,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        imm,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {imm}"
    }

    schedule { units = [WriteIALU]; }
}


// Integer add and subtract.

vector_pair!(VAddVV, VAddVVM, RVV, VArithVV, VArithVVM, "vadd.vv", 0b000000,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a + b)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a + b } else { old })); })

vector_pair!(VAddVX, VAddVXM, RVV, VArithVX, VArithVXM, "vadd.vx", 0b000000,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a + extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a + extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old })); })

vector_pair!(VAddVI, VAddVIM, RVV, VArithVI, VArithVIM, "vadd.vi", 0b000000,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a + sext(imm, VCFG::sew))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a + sext(imm, VCFG::sew) } else { old })); })

vector_pair!(VSubVV, VSubVVM, RVV, VArithVV, VArithVVM, "vsub.vv", 0b000010,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a - b)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a - b } else { old })); })

vector_pair!(VSubVX, VSubVXM, RVV, VArithVX, VArithVXM, "vsub.vx", 0b000010,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a - extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a - extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old })); })

vector_pair!(VRsubVX, VRsubVXM, RVV, VArithVX, VArithVXM, "vrsub.vx", 0b000011,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) - a)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) - a } else { old })); })

vector_pair!(VRsubVI, VRsubVIM, RVV, VArithVI, VArithVIM, "vrsub.vi", 0b000011,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| sext(imm, VCFG::sew) - a)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { sext(imm, VCFG::sew) - a } else { old })); })

// Lane-wise minimum and maximum, unsigned and signed.

vector_pair!(VMinuVV, VMinuVVM, RVV, VArithVV, VArithVVM, "vminu.vv", 0b000100,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if a ~< b { a } else { b })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { if a ~< b { a } else { b } } else { old })); })

vector_pair!(VMinuVX, VMinuVXM, RVV, VArithVX, VArithVXM, "vminu.vx", 0b000100,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| if a ~< extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { if a ~< extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } } else { old })); })

vector_pair!(VMinVV, VMinVVM, RVV, VArithVV, VArithVVM, "vmin.vv", 0b000101,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if a < b { a } else { b })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { if a < b { a } else { b } } else { old })); })

vector_pair!(VMinVX, VMinVXM, RVV, VArithVX, VArithVXM, "vmin.vx", 0b000101,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| if a < extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { if a < extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } } else { old })); })

vector_pair!(VMaxuVV, VMaxuVVM, RVV, VArithVV, VArithVVM, "vmaxu.vv", 0b000110,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if a ~> b { a } else { b })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { if a ~> b { a } else { b } } else { old })); })

vector_pair!(VMaxuVX, VMaxuVXM, RVV, VArithVX, VArithVXM, "vmaxu.vx", 0b000110,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| if a ~> extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { if a ~> extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } } else { old })); })

vector_pair!(VMaxVV, VMaxVVM, RVV, VArithVV, VArithVVM, "vmax.vv", 0b000111,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if a > b { a } else { b })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { if a > b { a } else { b } } else { old })); })

vector_pair!(VMaxVX, VMaxVXM, RVV, VArithVX, VArithVXM, "vmax.vx", 0b000111,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| if a > extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { if a > extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } } else { old })); })

// Bitwise logical operations.

vector_pair!(VAndVV, VAndVVM, RVV, VArithVV, VArithVVM, "vand.vv", 0b001001,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a & b)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a & b } else { old })); })

vector_pair!(VAndVX, VAndVXM, RVV, VArithVX, VArithVXM, "vand.vx", 0b001001,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a & extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a & extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old })); })

vector_pair!(VAndVI, VAndVIM, RVV, VArithVI, VArithVIM, "vand.vi", 0b001001,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a & sext(imm, VCFG::sew))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a & sext(imm, VCFG::sew) } else { old })); })

vector_pair!(VOrVV, VOrVVM, RVV, VArithVV, VArithVVM, "vor.vv", 0b001010,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a | b)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a | b } else { old })); })

vector_pair!(VOrVX, VOrVXM, RVV, VArithVX, VArithVXM, "vor.vx", 0b001010,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a | extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a | extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old })); })

vector_pair!(VOrVI, VOrVIM, RVV, VArithVI, VArithVIM, "vor.vi", 0b001010,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a | sext(imm, VCFG::sew))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a | sext(imm, VCFG::sew) } else { old })); })

vector_pair!(VXorVV, VXorVVM, RVV, VArithVV, VArithVVM, "vxor.vv", 0b001011,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a ^ b)); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a ^ b } else { old })); })

vector_pair!(VXorVX, VXorVXM, RVV, VArithVX, VArithVXM, "vxor.vx", 0b001011,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a ^ extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a ^ extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old })); })

vector_pair!(VXorVI, VXorVIM, RVV, VArithVI, VArithVIM, "vxor.vi", 0b001011,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a ^ sext(imm, VCFG::sew))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { a ^ sext(imm, VCFG::sew) } else { old })); })

// Shifts; the shift amount is the low log2(SEW) bits of the second source.

vector_pair!(VSllVV, VSllVVM, RVV, VArithVV, VArithVVM, "vsll.vv", 0b100101,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a << (b & (VCFG::sew - zext(0b1, self.XLEN))))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a << (b & (VCFG::sew - zext(0b1, self.XLEN))) } else { old })); })

