    param OPNAME: String = "vminu.vx.m";
    param MNEMONIC: String = "vminu.vx";
    param FUNCT6: bits<6> = 0b000100;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { if a ~< extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) { a } else { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } } else { old }));
    }
}

instruction VMinVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vmin.vv";
    param FUNCT6: bits<6> = 0b000101;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if a < b { a } else { b }));
    }
}

