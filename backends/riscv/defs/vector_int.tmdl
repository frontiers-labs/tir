    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| if extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) == zext(0b0, VCFG::sew) { sext(0b1, VCFG::sew) } else { a ~/ extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { if extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) == zext(0b0, VCFG::sew) { sext(0b1, VCFG::sew) } else { a ~/ extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } } else { old })); })

