instruction VRsubVX for [RVV] : VArithVX {
    param MNEMONIC: String = "vrsub.vx";
    param FUNCT6: bits<6> = 0b000011;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) - a));
    }
}

instruction VRsubVXM for [RVV] : VArithVXM {
    param OPNAME: String = "vrsub.vx.m";
    param MNEMONIC: String = "vrsub.vx";
    param FUNCT6: bits<6> = 0b000011;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) - a } else { old }));
    }
}

instruction VRsubVI for [RVV] : VArithVI {
    param MNEMONIC: String = "vrsub.vi";
    param FUNCT6: bits<6> = 0b000011;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| sext(imm, VCFG::sew) - a));
    }
}

instruction VRsubVIM for [RVV] : VArithVIM {
    param OPNAME: String = "vrsub.vi.m";
    param MNEMONIC: String = "vrsub.vi";
    param FUNCT6: bits<6> = 0b000011;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { sext(imm, VCFG::sew) - a } else { old }));
