// Bitwise logical operations.

instruction VAndVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vand.vv";
    param FUNCT6: bits<6> = 0b001001;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| a & b));
    }
}

instruction VAndVVM for [RVV] : VArithVVM {
    param OPNAME: String = "vand.vv.m";
    param MNEMONIC: String = "vand.vv";
    param FUNCT6: bits<6> = 0b001001;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { a & b } else { old }));
    }
}

instruction VAndVX for [RVV] : VArithVX {
    param MNEMONIC: String = "vand.vx";
    param FUNCT6: bits<6> = 0b001001;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| a & extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0)));
    }
}

instruction VAndVXM for [RVV] : VArithVXM {
    param OPNAME: String = "vand.vx.m";
    param MNEMONIC: String = "vand.vx";
    param FUNCT6: bits<6> = 0b001001;

    behavior {
