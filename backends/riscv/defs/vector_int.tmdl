// Add-with-carry and subtract-with-borrow. The carry/borrow-in is the v0 mask
// register (printed without ".t"); vadc/vsbc produce SEW-bit sums, vmadc/vmsbc
// produce 1-bit carry/borrow-out masks and also have unmasked (carry-in zero)
// forms.

instruction VAdcVVM for [RVV] : OpCarryVV {
    param MNEMONIC: String = "vadc.vvm";
    param FUNCT6: bits<6> = 0b010000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |c, a, b| a + b + zext(c, VCFG::sew)));
    }
}

instruction VAdcVXM for [RVV] : OpCarryVX {
    param MNEMONIC: String = "vadc.vxm";
    param FUNCT6: bits<6> = 0b010000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |c, a| a + extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) + zext(c, VCFG::sew)));
    }
}

instruction VAdcVIM for [RVV] : OpCarryVI {
    param MNEMONIC: String = "vadc.vim";
    param FUNCT6: bits<6> = 0b010000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |c, a| a + sext(imm, VCFG::sew) + zext(c, VCFG::sew)));
    }
}

instruction VMadcVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vmadc.vv";
    param FUNCT6: bits<6> = 0b010001;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| extract(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(b, (VCFG::sew + zext(0b1, self.XLEN))), VCFG::sew, VCFG::sew)));
    }
}

instruction VMadcVX for [RVV] : VArithVX {
    param MNEMONIC: String = "vmadc.vx";
    param FUNCT6: bits<6> = 0b010001;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| extract(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew + zext(0b1, self.XLEN))), VCFG::sew, VCFG::sew)));
    }
}

instruction VMadcVI for [RVV] : VArithVI {
    param MNEMONIC: String = "vmadc.vi";
    param FUNCT6: bits<6> = 0b010001;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| extract(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(sext(imm, VCFG::sew), (VCFG::sew + zext(0b1, self.XLEN))), VCFG::sew, VCFG::sew)));
    }
}

instruction VMadcVVM for [RVV] : OpCarryVV {
    param MNEMONIC: String = "vmadc.vvm";
    param FUNCT6: bits<6> = 0b010001;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |c, a, b| extract(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(b, (VCFG::sew + zext(0b1, self.XLEN))) + zext(c, (VCFG::sew + zext(0b1, self.XLEN))), VCFG::sew, VCFG::sew)));
    }
}

instruction VMadcVXM for [RVV] : OpCarryVX {
    param MNEMONIC: String = "vmadc.vxm";
    param FUNCT6: bits<6> = 0b010001;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |c, a| extract(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew + zext(0b1, self.XLEN))) + zext(c, (VCFG::sew + zext(0b1, self.XLEN))), VCFG::sew, VCFG::sew)));
    }
}

instruction VMadcVIM for [RVV] : OpCarryVI {
    param MNEMONIC: String = "vmadc.vim";
    param FUNCT6: bits<6> = 0b010001;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |c, a| extract(zext(a, (VCFG::sew + zext(0b1, self.XLEN))) + zext(sext(imm, VCFG::sew), (VCFG::sew + zext(0b1, self.XLEN))) + zext(c, (VCFG::sew + zext(0b1, self.XLEN))), VCFG::sew, VCFG::sew)));
    }
}

instruction VSbcVVM for [RVV] : OpCarryVV {
    param MNEMONIC: String = "vsbc.vvm";
    param FUNCT6: bits<6> = 0b010010;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |c, a, b| a - b - zext(c, VCFG::sew)));
    }
}

instruction VSbcVXM for [RVV] : OpCarryVX {
    param MNEMONIC: String = "vsbc.vxm";
    param FUNCT6: bits<6> = 0b010010;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |c, a| a - extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) - zext(c, VCFG::sew)));
    }
}

instruction VMsbcVV for [RVV] : VArithVV {
    param MNEMONIC: String = "vmsbc.vv";
    param FUNCT6: bits<6> = 0b010011;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| if zext(b, (VCFG::sew + zext(0b1, self.XLEN))) ~> zext(a, (VCFG::sew + zext(0b1, self.XLEN))) { 0b1 } else { 0b0 }));
    }
}

instruction VMsbcVX for [RVV] : VArithVX {
    param MNEMONIC: String = "vmsbc.vx";
    param FUNCT6: bits<6> = 0b010011;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| if zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew + zext(0b1, self.XLEN))) ~> zext(a, (VCFG::sew + zext(0b1, self.XLEN))) { 0b1 } else { 0b0 }));
    }
}

instruction VMsbcVVM for [RVV] : OpCarryVV {
    param MNEMONIC: String = "vmsbc.vvm";
    param FUNCT6: bits<6> = 0b010011;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |c, a, b| if zext(b, (VCFG::sew + zext(0b1, self.XLEN))) + zext(c, (VCFG::sew + zext(0b1, self.XLEN))) ~> zext(a, (VCFG::sew + zext(0b1, self.XLEN))) { 0b1 } else { 0b0 }));
    }
}

instruction VMsbcVXM for [RVV] : OpCarryVX {
    param MNEMONIC: String = "vmsbc.vxm";
    param FUNCT6: bits<6> = 0b010011;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |c, a| if zext(extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0), (VCFG::sew + zext(0b1, self.XLEN))) + zext(c, (VCFG::sew + zext(0b1, self.XLEN))) ~> zext(a, (VCFG::sew + zext(0b1, self.XLEN))) { 0b1 } else { 0b0 }));
    }
}

// vmerge selects between the two sources under v0; vmv is its unmasked
// alias (vs2 = x0 in the encoding) re-encoded as a plain move.

instruction VMergeVVM for [RVV] : OpMergeVV {
    param MNEMONIC: String = "vmerge.vvm";
    param FUNCT6: bits<6> = 0b010111;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |m, a, b| if m { b } else { a }));
    }
}

instruction VMergeVXM for [RVV] : OpMergeVX {
    param MNEMONIC: String = "vmerge.vxm";
    param FUNCT6: bits<6> = 0b010111;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |m, a| if m { extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { a }));
    }
}

instruction VMergeVIM for [RVV] : OpMergeVI {
    param MNEMONIC: String = "vmerge.vim";
    param FUNCT6: bits<6> = 0b010111;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |m, a| if m { sext(imm, VCFG::sew) } else { a }));
    }
}

instruction VMvV for [RVV] : OpMvV {
    param MNEMONIC: String = "vmv.v.v";
    param FUNCT6: bits<6> = 0b010111;

    behavior {
        vd = concat(split(vs1, VCSR::vl, VCFG::sew));
    }
}

instruction VMvX for [RVV] : OpMvX {
    param MNEMONIC: String = "vmv.v.x";
    param FUNCT6: bits<6> = 0b010111;

    behavior {
        vd = concat(map(iota(VCSR::vl, VCFG::sew), |i| extract(rs1, (VCFG::sew - zext(0b1, self.XLEN)), 0)));
    }
}

instruction VMvI for [RVV] : OpMvI {
    param MNEMONIC: String = "vmv.v.i";
    param FUNCT6: bits<6> = 0b010111;

    behavior {
        vd = concat(map(iota(VCSR::vl, VCFG::sew), |i| sext(imm, VCFG::sew)));
    }
}

