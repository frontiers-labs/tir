macro rounded_variants {
    ($name:ident, $mnemonic:literal, $feature:ident, $tmpl:ident, $body:ident, $assembly:literal) => {
        instruction ${concat($name, RNE)} for [$feature] : $tmpl {
            param OPNAME: String = ${concat($mnemonic, ".rne")};
            param RM: bits<3> = 0b000;
            asm { ${concat($assembly, ", rne")} }
            behavior { $body!(0b000) }
        }
        instruction ${concat($name, RTZ)} for [$feature] : $tmpl {
            param OPNAME: String = ${concat($mnemonic, ".rtz")};
            param RM: bits<3> = 0b001;
            asm { ${concat($assembly, ", rtz")} }
            behavior { $body!(0b001) }
        }
        instruction ${concat($name, RDN)} for [$feature] : $tmpl {
            param OPNAME: String = ${concat($mnemonic, ".rdn")};
            param RM: bits<3> = 0b010;
            asm { ${concat($assembly, ", rdn")} }
            behavior { $body!(0b010) }
        }
        instruction ${concat($name, RUP)} for [$feature] : $tmpl {
            param OPNAME: String = ${concat($mnemonic, ".rup")};
            param RM: bits<3> = 0b011;
            asm { ${concat($assembly, ", rup")} }
            behavior { $body!(0b011) }
        }
        instruction ${concat($name, RMM)} for [$feature] : $tmpl {
            param OPNAME: String = ${concat($mnemonic, ".rmm")};
            param RM: bits<3> = 0b100;
            asm { ${concat($assembly, ", rmm")} }
            behavior { $body!(0b100) }
        }
        instruction $name for [$feature] : $tmpl {
            param OPNAME: String = $mnemonic;
            param RM: bits<3> = 0b111;
            asm { ($assembly, ${concat($assembly, ", dyn")}) }
            behavior { if FRM::frm ~> 0b100 { trap(2); } else { $body!(FRM::frm) } }
        }
    };
}

fn scalar_canonical32(value) {
    if value >= value { value } else { asfloat(zext(0x7fc00000, 32)) }
}

fn scalar_canonical64(value) {
    if value >= value { value } else { asfloat(zext(0x7ff8000000000000, 64)) }
}

