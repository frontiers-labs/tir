//! Vector mask instructions from the RISC-V Vector extension: the mask-logical
//! operations, the set-first family (vmsbf/vmsif/vmsof), population count and
//! first-set (vcpop/vfirst), iota, and the element-index producer vid.
//!
//! The mask-logical operations are plain whole-register bitwise ops; the spec
//! makes their tail agnostic, which a full-register write satisfies. The
//! set-first family uses the classic bit tricks over the whole mask value:
//! below the lowest set bit, `v - 1` has ones and `v` has zeros, so
//! `(v - 1) & ~v` is exactly set-before-first. vfirst is an unsigned-min
//! reduction over the indices of set bits (the all-ones "none" sentinel is
//! also the identity of that reduction). viota's per-lane prefix count sums
//! the bits at or below the lane and subtracts the lane's own bit — formulated
//! with an inclusive split so the reduction never sees an empty iterator.

// Mask-logical operations (MMTYPE): always unmasked, whole-register.
template VMaskMM for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b010;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        0b1,
        vs2,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

instruction VMandMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmand.mm";
    param FUNCT6: bits<6> = 0b011001;

    behavior {
        vd = vs2 & vs1;
    }
}

instruction VMnandMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmnand.mm";
    param FUNCT6: bits<6> = 0b011101;

    behavior {
        vd = ~(vs2 & vs1);
    }
}

instruction VMandnMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmandn.mm";
    param FUNCT6: bits<6> = 0b011000;

    behavior {
        vd = vs2 & ~vs1;
    }
}

instruction VMxorMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmxor.mm";
    param FUNCT6: bits<6> = 0b011011;

    behavior {
        vd = vs2 ^ vs1;
    }
}

instruction VMorMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmor.mm";
    param FUNCT6: bits<6> = 0b011010;

    behavior {
        vd = vs2 | vs1;
    }
}

instruction VMnorMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmnor.mm";
    param FUNCT6: bits<6> = 0b011110;

    behavior {
        vd = ~(vs2 | vs1);
    }
}

instruction VMornMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmorn.mm";
    param FUNCT6: bits<6> = 0b011100;

    behavior {
        vd = vs2 | ~vs1;
    }
}

instruction VMxnorMM for [RVV] : VMaskMM {
    param MNEMONIC: String = "vmxnor.mm";
    param FUNCT6: bits<6> = 0b011111;

    behavior {
        vd = ~(vs2 ^ vs1);
    }
}

// Mask unary ops (VMUNARY0): the vs1 field selects the operation. The masked
// forms (vm = 0) compute over the active bits (source AND v0) and merge the
// result with the old destination under v0.
template VMaskUnary for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010100;
    param VS1: bits<5>;
    param FUNCT3: bits<3> = 0b010;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        VS1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}"
    }

    schedule { units = [WriteIALU]; }
}

template VMaskUnaryM for [RVV] : VMaskUnary {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, v0.t"
    }
}

instruction VMsbfM for [RVV] : VMaskUnary {
    param MNEMONIC: String = "vmsbf.m";
    param VS1: bits<5> = 0b00001;

    behavior {
        vd = (vs2 - zext(0b1, VCFG::sew)) & ~vs2;
    }
}

instruction VMsbfMM for [RVV] : VMaskUnaryM {
    param MNEMONIC: String = "vmsbf.m";
    param OPNAME: String = "vmsbf.m.m";
    param VS1: bits<5> = 0b00001;

    behavior {
        active = vs2 & VR::v0;
        vd = (((active - zext(0b1, VCFG::sew)) & ~active) & VR::v0) | (vd & ~VR::v0);
    }
}

instruction VMsofM for [RVV] : VMaskUnary {
    param MNEMONIC: String = "vmsof.m";
    param VS1: bits<5> = 0b00010;

    behavior {
        vd = vs2 & (zext(0b0, VCFG::sew) - vs2);
    }
}

instruction VMsofMM for [RVV] : VMaskUnaryM {
    param MNEMONIC: String = "vmsof.m";
    param OPNAME: String = "vmsof.m.m";
    param VS1: bits<5> = 0b00010;

    behavior {
        active = vs2 & VR::v0;
        vd = ((active & (zext(0b0, VCFG::sew) - active)) & VR::v0) | (vd & ~VR::v0);
    }
}

instruction VMsifM for [RVV] : VMaskUnary {
    param MNEMONIC: String = "vmsif.m";
    param VS1: bits<5> = 0b00011;

    behavior {
        vd = ((vs2 - zext(0b1, VCFG::sew)) & ~vs2) | (vs2 & (zext(0b0, VCFG::sew) - vs2));
    }
}

instruction VMsifMM for [RVV] : VMaskUnaryM {
    param MNEMONIC: String = "vmsif.m";
    param OPNAME: String = "vmsif.m.m";
    param VS1: bits<5> = 0b00011;

    behavior {
        active = vs2 & VR::v0;
        vd = ((((active - zext(0b1, VCFG::sew)) & ~active) | (active & (zext(0b0, VCFG::sew) - active))) & VR::v0) | (vd & ~VR::v0);
    }
}

// viota: each lane gets the number of active set bits before it. The prefix
// sum includes the lane's own bit in the fold and subtracts it back, so the
// reduce always has at least one lane (an empty reduce has no meaning).
instruction VIotaM for [RVV] : VMaskUnary {
    param MNEMONIC: String = "viota.m";
    param VS1: bits<5> = 0b10000;

    behavior {
        vd = concat(map(iota(VCSR::vl, VCFG::sew), |i| extract(reduce(map(split(vs2, i + zext(0b1, self.XLEN), 1), |x| zext(x, self.XLEN)), |acc, x| acc + x) - zext(extract(vs2, i, i), self.XLEN), (VCFG::sew - zext(0b1, self.XLEN)), 0)));
    }
}

instruction VIotaMM for [RVV] : VMaskUnaryM {
    param MNEMONIC: String = "viota.m";
    param OPNAME: String = "viota.m.m";
    param VS1: bits<5> = 0b10000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), iota(VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, i, old| if m { extract(reduce(map(zip(split(VR::v0, i + zext(0b1, self.XLEN), 1), split(vs2, i + zext(0b1, self.XLEN), 1)), |mm, x| zext(mm & x, self.XLEN)), |acc, x| acc + x) - zext(extract(VR::v0, i, i) & extract(vs2, i, i), self.XLEN), (VCFG::sew - zext(0b1, self.XLEN)), 0) } else { old }));
    }
}

// vid: the element index, per lane.
template Vid for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010100;
    param FUNCT3: bits<3> = 0b010;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
    }

    encoding {
        FUNCT6,
        VM,
        0b00000,
        0b10001,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}"
    }

    schedule { units = [WriteIALU]; }
}

template VidM for [RVV] : Vid {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, v0.t"
    }
}

instruction VidV for [RVV] : Vid {
    param MNEMONIC: String = "vid.v";

    behavior {
        vd = concat(iota(VCSR::vl, VCFG::sew));
    }
}

instruction VidVM for [RVV] : VidM {
    param MNEMONIC: String = "vid.v";
    param OPNAME: String = "vid.v.m";

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), iota(VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, i, old| if m { i } else { old }));
    }
}

// Mask popcount and first-set read the whole mask into a GPR (VWXUNARY0).
template VMaskRead for [RVV] {
    param MNEMONIC: String;
    param FUNCT6: bits<6> = 0b010000;
    param VS1: bits<5>;
    param FUNCT3: bits<3> = 0b010;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        rd: GPR,
        vs2: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        VS1,
        FUNCT3,
        rd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {rd}, {vs2}"
    }

    schedule { units = [WriteIALU]; }
}

template VMaskReadM for [RVV] : VMaskRead {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {rd}, {vs2}, v0.t"
    }
}

instruction VCpopM for [RVV] : VMaskRead {
    param MNEMONIC: String = "vcpop.m";
    param VS1: bits<5> = 0b10000;

    behavior {
        // The lane count is clamped to one so the dead arm of the select never
        // reduces an empty iterator.
        n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
        rd = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b0, self.XLEN) } else { reduce(map(split(vs2, n, 1), |x| zext(x, self.XLEN)), |acc, x| acc + x) };
    }
}

instruction VCpopMM for [RVV] : VMaskReadM {
    param MNEMONIC: String = "vcpop.m";
    param OPNAME: String = "vcpop.m.m";
    param VS1: bits<5> = 0b10000;

    behavior {
        n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
        rd = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b0, self.XLEN) } else { reduce(map(zip(split(VR::v0, n, 1), split(vs2, n, 1)), |m, x| zext(m & x, self.XLEN)), |acc, x| acc + x) };
    }
}

// vfirst: the index of the first active set bit, or all-ones when there is
// none — the all-ones sentinel is the identity of the unsigned-min fold, so
// it falls out of the reduction.
instruction VFirstM for [RVV] : VMaskRead {
    param MNEMONIC: String = "vfirst.m";
    param VS1: bits<5> = 0b10001;

    behavior {
        // The lane count is clamped to one so the dead arm of the select never
        // reduces an empty iterator; the select then reports "none" (-1).
        n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
        rd = if VCSR::vl == zext(0b0, self.XLEN) { sext(0b1, self.XLEN) } else { reduce(map(zip(iota(n, self.XLEN), split(vs2, n, 1)), |i, b| if b { i } else { sext(0b1, self.XLEN) }), |acc, x| if acc ~< x { acc } else { x }) };
    }
}

instruction VFirstMM for [RVV] : VMaskReadM {
    param MNEMONIC: String = "vfirst.m";
    param OPNAME: String = "vfirst.m.m";
    param VS1: bits<5> = 0b10001;

    behavior {
        n = if VCSR::vl == zext(0b0, self.XLEN) { zext(0b1, self.XLEN) } else { VCSR::vl };
        rd = if VCSR::vl == zext(0b0, self.XLEN) { sext(0b1, self.XLEN) } else { reduce(map(zip(split(VR::v0, n, 1), iota(n, self.XLEN), split(vs2, n, 1)), |m, i, b| if m & b { i } else { sext(0b1, self.XLEN) }), |acc, x| if acc ~< x { acc } else { x }) };
    }
}
