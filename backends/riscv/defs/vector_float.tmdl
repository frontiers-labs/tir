    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| asfloat(a) == asfloat(fp_scalar(rs1)))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, 1)), |m, a, old| if m { asfloat(a) == asfloat(fp_scalar(rs1)) } else { old })); })

