// Widening arithmetic: SEW sources are converted (exactly) to the 2*SEW
// format and combined there, so the single rounding the spec requires is the
// wide op's own. The .wv/.wf forms take vs2 already at 2*SEW.

fn fp_wneg(x) {
    x ^ fp_wsign_mask()
}

fn fp_widen(a) {
    fcvt(a, fp_wexp(), fp_wmant())
}

instruction VFWAddVV for [VF] : OpFVV {
    param MNEMONIC: String = "vfwadd.vv";
    param FUNCT6: bits<6> = 0b110000;

    behavior {
        vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| fadd(fp_widen(a), fp_widen(b))));
    }
}

instruction VFWAddVVM for [VF] : OpFVVM {
    param OPNAME: String = "vfwadd.vv.m";
    param MNEMONIC: String = "vfwadd.vv";
