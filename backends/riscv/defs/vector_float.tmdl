    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew * zext(0b10, self.XLEN))), |m, a, b, d| if m { fma(asfloat(fp_widen(b)), asfloat(fp_widen(a)), asfloat(d)) } else { d })); })

