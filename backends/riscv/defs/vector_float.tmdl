instruction VFCvtRtzXFVM for [VF] : OpFUnaryM {
    param OPNAME: String = "vfcvt.rtz.x.f.v.m";
    param MNEMONIC: String = "vfcvt.rtz.x.f.v";
    param FUNCT6: bits<6> = 0b010010;
