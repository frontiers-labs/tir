    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew * zext(0b10, self.XLEN))), |m, a, d| if m { fma(asfloat(fp_widen(fp_neg(fp_scalar(rs1)))), asfloat(fp_widen(a)), asfloat(d)) } else { d })); })

// Reductions: fold the active lanes of vs2 into element 0 of vs1 and write
// the total to element 0 of vd (the remaining lanes read as zero, a legal
// tail-agnostic choice; vl = 0 leaves the destination unchanged). Both sum
// orderings are modeled as the in-order left fold starting from the vs1
// element — the required order for vfredosum and a legal choice for the
// unordered vfredusum. In the masked forms the inactive lanes contribute the
// operation's identity (-0.0 for sums, +inf/-inf for min/max), so they drop
// out of the fold.

vector_pair!(VFRedusumVS, VFRedusumVSM, VF, OpFVV, OpFVVM, "vfredusum.vs", 0b000001,
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) }), |acc, x| fadd(acc, x)) }; },
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { elem_at(vs2, i - zext(0b1, self.XLEN)) } else { fp_sign_mask() }), |acc, x| fadd(acc, x)) }; })

vector_pair!(VFRedosumVS, VFRedosumVSM, VF, OpFVV, OpFVVM, "vfredosum.vs", 0b000011,
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) }), |acc, x| fadd(acc, x)) }; },
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { elem_at(vs2, i - zext(0b1, self.XLEN)) } else { fp_sign_mask() }), |acc, x| fadd(acc, x)) }; })

vector_pair!(VFRedminVS, VFRedminVSM, VF, OpFVV, OpFVVM, "vfredmin.vs", 0b000101,
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) }), |acc, x| fmin(acc, x)) }; },
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { elem_at(vs2, i - zext(0b1, self.XLEN)) } else { fp_inf() }), |acc, x| fmin(acc, x)) }; })

vector_pair!(VFRedmaxVS, VFRedmaxVSM, VF, OpFVV, OpFVVM, "vfredmax.vs", 0b000111,
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) }), |acc, x| fmax(acc, x)) }; },
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { elem_at(vs2, i - zext(0b1, self.XLEN)) } else { fp_neg(fp_inf()) }), |acc, x| fmax(acc, x)) }; })

// Widening reductions: the SEW lanes are widened exactly and folded at
// 2*SEW into element 0 of vs1 (itself a 2*SEW element).

vector_pair!(VFWRedusumVS, VFWRedusumVSM, VF, OpFVV, OpFVVM, "vfwredusum.vs", 0b110001,
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, (VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN), 0) } else { fp_widen(elem_at(vs2, i - zext(0b1, self.XLEN))) }), |acc, x| fadd(acc, x)) }; },
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, (VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { fp_widen(elem_at(vs2, i - zext(0b1, self.XLEN))) } else { fp_wsign_mask() }), |acc, x| fadd(acc, x)) }; })

vector_pair!(VFWRedosumVS, VFWRedosumVSM, VF, OpFVV, OpFVVM, "vfwredosum.vs", 0b110011,
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, (VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN), 0) } else { fp_widen(elem_at(vs2, i - zext(0b1, self.XLEN))) }), |acc, x| fadd(acc, x)) }; },
    { vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, (VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { fp_widen(elem_at(vs2, i - zext(0b1, self.XLEN))) } else { fp_wsign_mask() }), |acc, x| fadd(acc, x)) }; })
