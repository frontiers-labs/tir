// The float class helpers. `fp_class` computes the 10-bit fclass category
// mask of a lane, zero-extended to the lane width.

// The smallest positive normal: any smaller nonzero magnitude is subnormal.
fn fp_min_normal() {
    fp_const(0x0400, 0x00800000, 0x0010000000000000)
}

// The mantissa MSB, set in quiet NaNs.
fn fp_quiet_bit() {
    fp_const(0x0200, 0x00400000, 0x0008000000000000)
}

fn fp_class(a) {
    mag = fp_mag(a);
    neg = (a & fp_sign_mask()) != zext(0b0, VCFG::sew);
    pos = (a & fp_sign_mask()) == zext(0b0, VCFG::sew);
    is_zero = mag == zext(0b0, VCFG::sew);
    is_sub = (mag != zext(0b0, VCFG::sew)) & (mag ~< fp_min_normal());
    is_norm = (mag ~< fp_inf()) & (fp_min_normal() ~<= mag);
    is_inf = mag == fp_inf();
    is_nan = mag ~> fp_inf();
    quiet = (a & fp_quiet_bit()) != zext(0b0, VCFG::sew);
    snan = is_nan & ((a & fp_quiet_bit()) == zext(0b0, VCFG::sew));
    (zext(neg & is_inf, VCFG::sew) << 0)
        | (zext(neg & is_norm, VCFG::sew) << 1)
        | (zext(neg & is_sub, VCFG::sew) << 2)
        | (zext(neg & is_zero, VCFG::sew) << 3)
        | (zext(pos & is_zero, VCFG::sew) << 4)
        | (zext(pos & is_sub, VCFG::sew) << 5)
        | (zext(pos & is_norm, VCFG::sew) << 6)
        | (zext(pos & is_inf, VCFG::sew) << 7)
        | (zext(snan, VCFG::sew) << 8)
        | (zext(is_nan & quiet, VCFG::sew) << 9)
}

instruction VFClassV for [VF] : OpFUnary {
    param MNEMONIC: String = "vfclass.v";
    param FUNCT6: bits<6> = 0b010011;
    param VS1: bits<5> = 0b10000;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fp_class(a)));
    }
}

instruction VFClassVM for [VF] : OpFUnaryM {
    param OPNAME: String = "vfclass.v.m";
    param MNEMONIC: String = "vfclass.v";
    param FUNCT6: bits<6> = 0b010011;
    param VS1: bits<5> = 0b10000;

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fp_class(a) } else { old }));
    }
}

// Compares write one mask bit per lane (IEEE quiet compares: any NaN operand
// makes the ordered predicates false and only vmfne true).

