    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fadd(fp_widen(a), fp_widen(fp_scalar(rs1))))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew * zext(0b10, self.XLEN))), |m, a, old| if m { fadd(fp_widen(a), fp_widen(fp_scalar(rs1))) } else { old })); })

