    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew * zext(0b10, self.XLEN)), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fcvt(a, fp_exp(), fp_mant()) } else { old }));
    }
}

