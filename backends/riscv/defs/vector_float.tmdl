// Sign injection: the vs2 magnitude with a sign taken from vs1 (vfsgnj),
// its negation (vfsgnjn), or the xor of both signs (vfsgnjx).

vector_pair!(VFSgnjVV, VFSgnjVVM, VF, OpFVV, OpFVVM, "vfsgnj.vv", 0b001000,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| fp_mag(a) | (b & fp_sign_mask()))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { fp_mag(a) | (b & fp_sign_mask()) } else { old })); })

vector_pair!(VFSgnjVF, VFSgnjVFM, VF, OpFVF, OpFVFM, "vfsgnj.vf", 0b001000,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fp_mag(a) | (fp_scalar(rs1) & fp_sign_mask()))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fp_mag(a) | (fp_scalar(rs1) & fp_sign_mask()) } else { old })); })

vector_pair!(VFSgnjnVV, VFSgnjnVVM, VF, OpFVV, OpFVVM, "vfsgnjn.vv", 0b001001,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| fp_mag(a) | (fp_neg(b) & fp_sign_mask()))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { fp_mag(a) | (fp_neg(b) & fp_sign_mask()) } else { old })); })

vector_pair!(VFSgnjnVF, VFSgnjnVFM, VF, OpFVF, OpFVFM, "vfsgnjn.vf", 0b001001,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fp_mag(a) | (fp_neg(fp_scalar(rs1)) & fp_sign_mask()))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fp_mag(a) | (fp_neg(fp_scalar(rs1)) & fp_sign_mask()) } else { old })); })

vector_pair!(VFSgnjxVV, VFSgnjxVVM, VF, OpFVV, OpFVVM, "vfsgnjx.vv", 0b001010,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| fp_mag(a) | ((a ^ b) & fp_sign_mask()))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { fp_mag(a) | ((a ^ b) & fp_sign_mask()) } else { old })); })

vector_pair!(VFSgnjxVF, VFSgnjxVFM, VF, OpFVF, OpFVFM, "vfsgnjx.vf", 0b001010,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fp_mag(a) | ((a ^ fp_scalar(rs1)) & fp_sign_mask()))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fp_mag(a) | ((a ^ fp_scalar(rs1)) & fp_sign_mask()) } else { old })); })

// Fused multiply-accumulates: one rounding, all four sign combinations, in
// both the accumulator (vd += vs1*vs2) and multiplier (vd = vd*vs1 + vs2)
// orientations.

vector_pair!(VFMaccVV, VFMaccVVM, VF, OpFMAccVV, OpFMAccVVM, "vfmacc.vv", 0b101100,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |a, b, d| fma(asfloat(b), asfloat(a), asfloat(d)))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, d| if m { fma(asfloat(b), asfloat(a), asfloat(d)) } else { d })); })

vector_pair!(VFMaccVF, VFMaccVFM, VF, OpFMAccVF, OpFMAccVFM, "vfmacc.vf", 0b101100,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |a, d| fma(asfloat(fp_scalar(rs1)), asfloat(a), asfloat(d)))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, d| if m { fma(asfloat(fp_scalar(rs1)), asfloat(a), asfloat(d)) } else { d })); })

vector_pair!(VFNmaccVV, VFNmaccVVM, VF, OpFMAccVV, OpFMAccVVM, "vfnmacc.vv", 0b101101,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |a, b, d| fma(asfloat(fp_neg(b)), asfloat(a), asfloat(fp_neg(d))))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, d| if m { fma(asfloat(fp_neg(b)), asfloat(a), asfloat(fp_neg(d))) } else { d })); })

vector_pair!(VFNmaccVF, VFNmaccVFM, VF, OpFMAccVF, OpFMAccVFM, "vfnmacc.vf", 0b101101,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |a, d| fma(asfloat(fp_neg(fp_scalar(rs1))), asfloat(a), asfloat(fp_neg(d))))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, d| if m { fma(asfloat(fp_neg(fp_scalar(rs1))), asfloat(a), asfloat(fp_neg(d))) } else { d })); })

vector_pair!(VFMsacVV, VFMsacVVM, VF, OpFMAccVV, OpFMAccVVM, "vfmsac.vv", 0b101110,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |a, b, d| fma(asfloat(b), asfloat(a), asfloat(fp_neg(d))))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, d| if m { fma(asfloat(b), asfloat(a), asfloat(fp_neg(d))) } else { d })); })

vector_pair!(VFMsacVF, VFMsacVFM, VF, OpFMAccVF, OpFMAccVFM, "vfmsac.vf", 0b101110,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |a, d| fma(asfloat(fp_scalar(rs1)), asfloat(a), asfloat(fp_neg(d))))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, d| if m { fma(asfloat(fp_scalar(rs1)), asfloat(a), asfloat(fp_neg(d))) } else { d })); })

