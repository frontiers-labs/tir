    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, 1)), |m, a, old| if m { asfloat(fp_scalar(rs1)) <= asfloat(a) } else { old })); })

// Merge and splat: vfmerge.vfm picks the scalar where the mask is set;
// vfmv.v.f is its vm = 1 encoding with vs2 tied to zero, splatting the
// scalar to every active lane.

instruction VFMergeVFM for [VF] : OpFVFM {
    param MNEMONIC: String = "vfmerge.vfm";
    param FUNCT6: bits<6> = 0b010111;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0"
    }

    behavior {
        vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew)), |m, a| if m { fp_scalar(rs1) } else { a }));
    }
}

instruction VFMvVF for [VF] {
    param MNEMONIC: String = "vfmv.v.f";
    param FUNCT6: bits<6> = 0b010111;
    param FUNCT3: bits<3> = 0b101;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        rs1: FPR64,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {rs1}"
    }

    behavior {
        vd = concat(map(iota(VCSR::vl, VCFG::sew), |i| fp_scalar(rs1)));
    }

    schedule { units = [WriteIALU]; }
}

// Float scalar moves. vfmv.f.s reads element 0 of vs2 regardless of vl,
// NaN-boxing it into the f register; vfmv.s.f writes element 0 of vd only
// when vl > 0, leaving the rest to the tail policy (zero here, a legal
// tail-agnostic choice).

instruction VFMvFS for [VF] {
    param MNEMONIC: String = "vfmv.f.s";
    param FUNCT6: bits<6> = 0b010000;
    param FUNCT3: bits<3> = 0b001;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        fd: FPR64,
        vs2: VR,
    }

    encoding {
        FUNCT6,
        0b1,
        vs2,
        0b00000,
        FUNCT3,
        fd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {fd}, {vs2}"
    }

    behavior {
        fd = ((zext(0b0, 64) - zext(0b1, 64)) << zext(VCFG::sew, 64)) | zext(extract(vs2, VCFG::sew - zext(0b1, self.XLEN), 0), 64);
    }

    schedule { units = [WriteIALU]; }
}

instruction VFMvSF for [VF] {
    param MNEMONIC: String = "vfmv.s.f";
    param FUNCT6: bits<6> = 0b010000;
    param FUNCT3: bits<3> = 0b101;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        rs1: FPR64,
    }

    encoding {
        FUNCT6,
        0b1,
        0b00000,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {rs1}"
    }

    behavior {
        vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { fp_scalar(rs1) };
    }

    schedule { units = [WriteIALU]; }
}

// Scalar slides: the float twins of vslide1up/vslide1down.vx, inserting the
// f-register scalar at the vacated lane.

vector_pair!(VFSlide1upVF, VFSlide1upVFM, VF, OpFVF, OpFVFM, "vfslide1up.vf", 0b001110,
    { vd = concat(map(iota(VCSR::vl, self.XLEN), |i| if i == zext(0b0, self.XLEN) { fp_scalar(rs1) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), iota(VCSR::vl, self.XLEN), split(vd, VCSR::vl, VCFG::sew)), |m, i, old| if m { if i == zext(0b0, self.XLEN) { fp_scalar(rs1) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) } } else { old })); })

vector_pair!(VFSlide1downVF, VFSlide1downVFM, VF, OpFVF, OpFVFM, "vfslide1down.vf", 0b001111,
    { vd = concat(map(iota(VCSR::vl, self.XLEN), |i| if (i + zext(0b1, self.XLEN)) ~< VCSR::vl { elem_at(vs2, i + zext(0b1, self.XLEN)) } else { fp_scalar(rs1) })); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), iota(VCSR::vl, self.XLEN), split(vd, VCSR::vl, VCFG::sew)), |m, i, old| if m { if (i + zext(0b1, self.XLEN)) ~< VCSR::vl { elem_at(vs2, i + zext(0b1, self.XLEN)) } else { fp_scalar(rs1) } } else { old })); })

// Conversion helpers. The frm-governed conversions round to nearest-even
// (the modeled frm default) by first rounding the float to an integral value
// with the 2^mant magic-add trick, then truncating exactly; the .rtz forms
// truncate directly. Out-of-range values and NaNs saturate per the scalar
// conversion rules (NaN converts as the largest positive value).

// 2^mant: adding and subtracting it rounds the magnitude to an integer in
// one RNE rounding. Any magnitude at or above it is already integral.
fn fp_magic() {
    fp_const(0x6400, 0x4B000000, 0x4330000000000000)
}

fn fp_rne_int(a) {
    mag = fp_mag(a);
    if mag ~< fp_magic() { (a & fp_sign_mask()) | fsub(fadd(mag, fp_magic()), fp_magic()) } else { a }
}

// Saturate a 64-bit-converted integral value into `w` bits. `t` comes from
// the float-to-int primitive, which already saturates into the 64-bit range
// but folds NaN to zero, so the NaN test rides along explicitly.
fn fp_sat_signed(t, nan, w) {
    maxpos = (zext(0b1, w) << (w - zext(0b1, self.XLEN))) - zext(0b1, w);
    minneg = zext(0b1, w) << (w - zext(0b1, self.XLEN));
    if nan {
        maxpos
    } else if zext(maxpos, 64) < t {
        maxpos
    } else if t < sext(minneg, 64) {
        minneg
    } else {
        extract(t, w - zext(0b1, self.XLEN), 0)
    }
}

fn fp_sat_unsigned(t, nan, w) {
    ones = zext(0b0, w) - zext(0b1, w);
    if nan {
        ones
    } else if zext(ones, 64) ~< t {
        ones
    } else {
        extract(t, w - zext(0b1, self.XLEN), 0)
    }
}

// The widened (2*SEW) element format, keyed off SEW like `fp_const`:
// binary16 patterns at SEW = 8 (the int8 <-> binary16 conversions), binary32
// at SEW = 16, binary64 at SEW = 32. 2*SEW float lanes at SEW = 64 are
// reserved, as in the integer widening file.
fn fp_wconst(h, s, d) {
    k = if VCFG::sew == zext(0x8, self.XLEN) {
        zext(h, 64)
    } else if VCFG::sew == zext(0x10, self.XLEN) {
        zext(s, 64)
    } else {
        zext(d, 64)
    };
    extract(k, (VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN), 0)
}

fn fp_wsign_mask() {
    zext(0b1, VCFG::sew * zext(0b10, self.XLEN)) << ((VCFG::sew * zext(0b10, self.XLEN)) - zext(0b1, self.XLEN))
}

fn fp_wmag(x) {
    x & (fp_wsign_mask() - zext(0b1, VCFG::sew * zext(0b10, self.XLEN)))
}

fn fp_winf() {
    fp_wconst(0x7C00, 0x7F800000, 0x7FF0000000000000)
}

fn fp_wis_nan(x) {
    fp_wmag(x) ~> fp_winf()
}

fn fp_wmagic() {
    fp_wconst(0x6400, 0x4B000000, 0x4330000000000000)
}

fn fp_wrne_int(x) {
    mag = fp_wmag(x);
    if mag ~< fp_wmagic() { (x & fp_wsign_mask()) | fsub(fadd(mag, fp_wmagic()), fp_wmagic()) } else { x }
}

// Exponent and mantissa widths of the SEW and 2*SEW formats, for `fcvt`,
// `sitofp`, and `uitofp`.
fn fp_exp() {
    if VCFG::sew == zext(0x10, self.XLEN) {
        zext(0b101, self.XLEN)
    } else if VCFG::sew == zext(0x20, self.XLEN) {
        zext(0b1000, self.XLEN)
    } else {
        zext(0b1011, self.XLEN)
    }
}

fn fp_mant() {
    VCFG::sew - fp_exp() - zext(0b1, self.XLEN)
}

fn fp_wexp() {
    if VCFG::sew == zext(0x8, self.XLEN) {
        zext(0b101, self.XLEN)
    } else if VCFG::sew == zext(0x10, self.XLEN) {
        zext(0b1000, self.XLEN)
    } else {
        zext(0b1011, self.XLEN)
    }
}

fn fp_wmant() {
    (VCFG::sew * zext(0b10, self.XLEN)) - fp_wexp() - zext(0b1, self.XLEN)
}

// Round a 2*SEW float to the SEW format toward odd: take the truncated
// narrowing (the nearest-even result, stepped back one ulp when it rounded
// away from zero) and force the mantissa LSB on any inexact conversion.
// Round-to-odd never overflows to infinity and never flushes a nonzero
// value to zero.
fn fp_round_odd(x) {
    r = fcvt(x, fp_exp(), fp_mant());
    back = fcvt(r, fp_wexp(), fp_wmant());
    away = fp_wmag(back) ~> fp_wmag(x);
    t = if away { (r & fp_sign_mask()) | (fp_mag(r) - zext(0b1, VCFG::sew)) } else { r };
    if fp_wis_nan(x) {
        fp_canonical_nan()
    } else if back == x {
        r
    } else {
        t | zext(0b1, VCFG::sew)
    }
}

