// Reductions: fold the active lanes of vs2 into element 0 of vs1 and write
// the total to element 0 of vd (the remaining lanes read as zero, a legal
// tail-agnostic choice; vl = 0 leaves the destination unchanged). Both sum
// orderings are modeled as the in-order left fold starting from the vs1
// element — the required order for vfredosum and a legal choice for the
// unordered vfredusum. In the masked forms the inactive lanes contribute the
// operation's identity (-0.0 for sums, +inf/-inf for min/max), so they drop
// out of the fold.

instruction VFRedusumVS for [VF] : OpFVV {
    param MNEMONIC: String = "vfredusum.vs";
    param FUNCT6: bits<6> = 0b000001;

    behavior {
        vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else { elem_at(vs2, i - zext(0b1, self.XLEN)) }), |acc, x| fadd(acc, x)) };
    }
}

instruction VFRedusumVSM for [VF] : OpFVVM {
    param OPNAME: String = "vfredusum.vs.m";
    param MNEMONIC: String = "vfredusum.vs";
    param FUNCT6: bits<6> = 0b000001;

    behavior {
        vd = if VCSR::vl == zext(0b0, self.XLEN) { vd } else { reduce(map(iota(VCSR::vl + zext(0b1, self.XLEN), self.XLEN), |i| if i == zext(0b0, self.XLEN) { extract(vs1, VCFG::sew - zext(0b1, self.XLEN), 0) } else if bit_at(VR::v0, i - zext(0b1, self.XLEN)) { elem_at(vs2, i - zext(0b1, self.XLEN)) } else { fp_sign_mask() }), |acc, x| fadd(acc, x)) };
    }
}

instruction VFRedosumVS for [VF] : OpFVV {
    param MNEMONIC: String = "vfredosum.vs";
    param FUNCT6: bits<6> = 0b000011;

    behavior {
