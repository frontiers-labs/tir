//! Vector floating-point instructions from the RISC-V Vector extension: the
//! OPFVV/OPFVF forms — single-width arithmetic, sign injection,
//! multiply-accumulate, square root, class, compares, merge and moves,
//! scalar slides, conversions, widening arithmetic, and reductions.
//!
//! Lane semantics follow the same functional idiom as the integer file:
//! sources split into `vl` lanes of `sew` bits, combined with `map`/`zip`,
//! and concatenated back, with masked forms keeping the old destination lane
//! (mask-undisturbed) and tails reading as zero (tail-agnostic). The element
//! format is the IEEE binary16/binary32/binary64 interchange format of the
//! configured SEW.
//!
//! Vector arithmetic and frm-governed conversions currently round to
//! nearest-even, while the .rtz conversion forms truncate.
//! The scalar operand of a .vf form is
//! taken from the f register file with the standard scalar-in-wider-register
//! convention: the low SEW bits when NaN-boxed, the canonical NaN otherwise.
//!
//! vfrsqrt7.v and vfrec7.v are not modeled: their significands are defined by
//! 128-entry lookup tables, which the behavior language cannot hold as data
//! (lane values cap at 64 bits) and could only inline as a 128-arm select in
//! every lane of the semantics and the derived selection axioms; the
//! encodings and assembly are specified, the semantics are `todo()`.

// The vector floating-point instructions need both the vector unit and the f
// register file; the standard V extension mandates the D scalar extension.
// Like D64, this internal conjunction is enabled automatically whenever both
// RVV and D are.
/// TIR feature for the modeled vector floating-point operations, requiring both RVV and scalar
/// double-precision support.
///
/// See [RISC-V Unprivileged ISA, V vector operations](https://docs.riscv.org/reference/isa/unpriv/v-st-ext.html).
isa VF requires [RVV, D] {}

// OPFVV (funct3 = 001): both sources from vector registers.
template OpFVV for [VF] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b001;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        vs1: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        vs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpFVVM for [VF] : OpFVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {vs1}, v0.t"
    }
}

// OPFVF (funct3 = 101): the second source is a scalar f register.
template OpFVF for [VF] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param FUNCT3: bits<3> = 0b101;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
        rs1: FPR64,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        rs1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}"
    }

    schedule { units = [WriteIALU]; }
}

template OpFVFM for [VF] : OpFVF {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, {rs1}, v0.t"
    }
}

// Multiply-accumulates print the vs1/scalar source first.
template OpFMAccVV for [VF] : OpFVV {
    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}"
    }
}

template OpFMAccVVM for [VF] : OpFVV {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs1}, {vs2}, v0.t"
    }
}

template OpFMAccVF for [VF] : OpFVF {
    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}"
    }
}

template OpFMAccVFM for [VF] : OpFVF {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {rs1}, {vs2}, v0.t"
    }
}

// Unary forms (VFUNARY0/VFUNARY1): the vs1 field selects the operation.
template OpFUnary for [VF] {
    param MNEMONIC: String;
    param FUNCT6: bits<6>;
    param VS1: bits<5>;
    param FUNCT3: bits<3> = 0b001;
    param VM: bits<1> = 0b1;
    param OPCODE: bits<7> = 0b1010111;

    operands {
        vd: VR,
        vs2: VR,
    }

    encoding {
        FUNCT6,
        VM,
        vs2,
        VS1,
        FUNCT3,
        vd,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC} {vd}, {vs2}"
    }

    schedule { units = [WriteIALU]; }
}

template OpFUnaryM for [VF] : OpFUnary {
    param VM: bits<1> = 0b0;

    asm {
        "{self.MNEMONIC} {vd}, {vs2}, v0.t"
    }
}

// A format constant for the configured element format, given as the binary16,
// binary32, and binary64 bit patterns. Every arm evaluates at any SEW (dead
// `if` arms are evaluated eagerly), so the selected 64-bit value is truncated
// to the lane width only after the choice.
fn fp_const(h, s, d) {
    k = if VCFG::sew == zext(0x10, self.XLEN) {
        zext(h, 64)
    } else if VCFG::sew == zext(0x20, self.XLEN) {
        zext(s, 64)
    } else {
        zext(d, 64)
    };
    extract(k, VCFG::sew - zext(0b1, self.XLEN), 0)
}

// The sign bit of a lane.
fn fp_sign_mask() {
    zext(0b1, VCFG::sew) << (VCFG::sew - zext(0b1, self.XLEN))
}

// The magnitude (all bits below the sign).
fn fp_mag(a) {
    a & (fp_sign_mask() - zext(0b1, VCFG::sew))
}

// Positive infinity: any greater magnitude is a NaN.
fn fp_inf() {
    fp_const(0x7C00, 0x7F800000, 0x7FF0000000000000)
}

fn fp_is_nan(a) {
    fp_mag(a) ~> fp_inf()
}

// The canonical (quiet, positive) NaN every NaN-producing op returns.
fn fp_canonical_nan() {
    fp_const(0x7E00, 0x7FC00000, 0x7FF8000000000000)
}

fn fp_neg(a) {
    a ^ fp_sign_mask()
}

// The scalar source of a .vf form: the low SEW bits of the f register when
// the bits above them are all ones (NaN-boxed), the canonical NaN otherwise.
// At SEW = 64 both shifts saturate to zero and the whole register is taken.
fn fp_scalar(rs1) {
    hi = extract(rs1, 63, 0) >> zext(VCFG::sew, 64);
    ones = (zext(0b0, 64) - zext(0b1, 64)) >> zext(VCFG::sew, 64);
    if hi == ones {
        extract(rs1, VCFG::sew - zext(0b1, self.XLEN), 0)
    } else {
        fp_canonical_nan()
    }
}

// Single-width add, subtract, and reverse subtract.

vector_pair!(VFAddVV, VFAddVVM, VF, OpFVV, OpFVVM, "vfadd.vv", 0b000000,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| fadd(a, b))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { fadd(a, b) } else { old })); })

vector_pair!(VFAddVF, VFAddVFM, VF, OpFVF, OpFVFM, "vfadd.vf", 0b000000,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fadd(a, fp_scalar(rs1)))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fadd(a, fp_scalar(rs1)) } else { old })); })

vector_pair!(VFSubVV, VFSubVVM, VF, OpFVV, OpFVVM, "vfsub.vv", 0b000010,
    { vd = concat(map(zip(split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew)), |a, b| fsub(a, b))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vs1, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, b, old| if m { fsub(a, b) } else { old })); })

vector_pair!(VFSubVF, VFSubVFM, VF, OpFVF, OpFVFM, "vfsub.vf", 0b000010,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fsub(a, fp_scalar(rs1)))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fsub(a, fp_scalar(rs1)) } else { old })); })

vector_pair!(VFRsubVF, VFRsubVFM, VF, OpFVF, OpFVFM, "vfrsub.vf", 0b100111,
    { vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fsub(fp_scalar(rs1), a))); },
    { vd = concat(map(zip(split(VR::v0, VCSR::vl, 1), split(vs2, VCSR::vl, VCFG::sew), split(vd, VCSR::vl, VCFG::sew)), |m, a, old| if m { fsub(fp_scalar(rs1), a) } else { old })); })

