instruction VFCvtXuFV for [VF] : OpFUnary {
    param MNEMONIC: String = "vfcvt.xu.f.v";
    param FUNCT6: bits<6> = 0b010010;
    param VS1: bits<5> = 0b00000;

    behavior {
        vd = concat(map(split(vs2, VCSR::vl, VCFG::sew), |a| fp_sat_unsigned(fptoui(asfloat(fp_rne_int(a)), 64), fp_is_nan(a), VCFG::sew)));
    }
}

