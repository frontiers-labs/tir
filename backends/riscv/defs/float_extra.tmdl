//! Floating-point comparisons, classification, sign injection, and minimum/maximum.

/// The five accrued floating-point exception flags at CSR address `0x001`, also accessible through
/// `fcsr`.
///
/// See [RISC-V Unprivileged ISA, F single-precision floating-point](https://docs.riscv.org/reference/isa/unpriv/f-st-ext.html).
register_class FFLAGS for [F] {
    file = CSR;
    param ENCODING_LEN: Integer = 12;
    param WIDTH: Integer = 5;
    registers { fflags => { index = 1, traits = [fp_flags] }, }
}

/// The three-bit dynamic floating-point rounding mode at CSR address `0x002`, also accessible
/// through `fcsr`.
///
/// See [RISC-V Unprivileged ISA, F single-precision floating-point](https://docs.riscv.org/reference/isa/unpriv/f-st-ext.html).
register_class FRM for [F] {
    file = CSR;
    param ENCODING_LEN: Integer = 12;
    param WIDTH: Integer = 3;
    registers { frm => { index = 2, traits = [fp_rounding] }, }
}

// RISC-V fcsr[12:8] is WPRI: trap enables read zero and ignore writes.
/// TIR internal zero-valued trap-enable state for floating-point semantics. RISC-V F has no
/// floating-point exception trap enables.
///
/// See [RISC-V Unprivileged ISA, F single-precision floating-point](https://docs.riscv.org/reference/isa/unpriv/f-st-ext.html).
register_class FPTRAPS for [F] {
    file = CSR;
    param ENCODING_LEN: Integer = 12;
    param WIDTH: Integer = 5;
    registers { fptraps => { index = 3, traits = [fp_traps, hardwired_zero] }, }
}

fn scalar_snan32(a) {
    ((a & 0x7FFFFFFF) ~> 0x7F800000) & ((a & 0x00400000) == 0x00000000)
}

fn scalar_snan64(a) {
    ((a & 0x7FFFFFFFFFFFFFFF) ~> 0x7FF0000000000000) & ((a & 0x0008000000000000) == 0x0000000000000000)
}

template FPBits32 for [F] {
    schedule { units = [WriteFPAdd]; }
    param MNEMONIC: String;
    param FUNCT7: bits<7>;
    param FUNCT3: bits<3>;
    operands { fd: FPR32, fs1: FPR32, fs2: FPR32, }
    encoding { FUNCT7, fs2, fs1, FUNCT3, fd, 0b1010011, }
    asm { "{self.MNEMONIC} {fd}, {fs1}, {fs2}" }
}

instruction FSignS for [F] : FPBits32 {
    param MNEMONIC: String = "fsgnj.s";
    param OPNAME: String = "fsgnj.s.full";
    param FUNCT7: bits<7> = 0b0010000;
    param FUNCT3: bits<3> = 0b000;
    behavior {
        a = extract(fs1, 31, 0);
        b = extract(fs2, 31, 0);
        fd = bitcast((a & 0x7FFFFFFF) | ((b) & 0x80000000));
    }
}

instruction FSignNS for [F] : FPBits32 {
    param MNEMONIC: String = "fsgnjn.s";
    param FUNCT7: bits<7> = 0b0010000;
    param FUNCT3: bits<3> = 0b001;
    behavior {
        a = extract(fs1, 31, 0);
        b = extract(fs2, 31, 0);
        fd = bitcast((a & 0x7FFFFFFF) | ((b ^ 0x80000000) & 0x80000000));
    }
}

instruction FSignXS for [F] : FPBits32 {
    param MNEMONIC: String = "fsgnjx.s";
    param FUNCT7: bits<7> = 0b0010000;
    param FUNCT3: bits<3> = 0b010;
    behavior {
        a = extract(fs1, 31, 0);
        b = extract(fs2, 31, 0);
        fd = bitcast((a & 0x7FFFFFFF) | ((a ^ b) & 0x80000000));
    }
}

instruction FMinS for [F] : FPBits32 {
    param MNEMONIC: String = "fmin.s";
    param FUNCT7: bits<7> = 0b0010100;
    param FUNCT3: bits<3> = 0b000;
    behavior {
        a = extract(fs1, 31, 0);
        b = extract(fs2, 31, 0);
        amag = a & 0x7FFFFFFF;
        bmag = b & 0x7FFFFFFF;
        anan = amag ~> 0x7F800000;
        bnan = bmag ~> 0x7F800000;
        FFLAGS::fflags = FFLAGS::fflags | if scalar_snan32(a) | scalar_snan32(b) { 0b10000 } else { 0b00000 };
        fd = if anan & bnan {
            bitcast(0x7FC00000)
        } else if anan {
            fs2
        } else if bnan {
            fs1
        } else if (amag == zext(0b0, 32)) & (bmag == zext(0b0, 32)) {
            bitcast(a | b)
        } else if fs1 < fs2 {
            fs1
        } else {
            fs2
        };
    }
}

instruction FMaxS for [F] : FPBits32 {
    param MNEMONIC: String = "fmax.s";
    param FUNCT7: bits<7> = 0b0010100;
    param FUNCT3: bits<3> = 0b001;
    behavior {
        a = extract(fs1, 31, 0);
        b = extract(fs2, 31, 0);
        amag = a & 0x7FFFFFFF;
        bmag = b & 0x7FFFFFFF;
        anan = amag ~> 0x7F800000;
        bnan = bmag ~> 0x7F800000;
        FFLAGS::fflags = FFLAGS::fflags | if scalar_snan32(a) | scalar_snan32(b) { 0b10000 } else { 0b00000 };
        fd = if anan & bnan {
            bitcast(0x7FC00000)
        } else if anan {
            fs2
        } else if bnan {
            fs1
        } else if (amag == zext(0b0, 32)) & (bmag == zext(0b0, 32)) {
            bitcast(a & b)
        } else if fs1 > fs2 {
            fs1
        } else {
            fs2
        };
    }
}

template FPInspect32 for [F] {
    schedule { units = [WriteFPAdd]; }
    param MNEMONIC: String;
    param FUNCT3: bits<3>;
    operands { rd: GPR, fs1: FPR32, }
    encoding { 0b1110000, 0b00000, fs1, FUNCT3, rd, 0b1010011, }
    asm { "{self.MNEMONIC} {rd}, {fs1}" }
}

instruction FClassS for [F] : FPInspect32 {
    param MNEMONIC: String = "fclass.s";
    param FUNCT3: bits<3> = 0b001;
    behavior {
        a = extract(fs1, 31, 0);
        sign = extract(a, 31, 31);
        exponent = extract(a, 30, 23);
        fraction = extract(a, 22, 0);
        rd = zext(if exponent == 0b11111111 {
            if fraction == zext(0b0, 23) {
                if sign == 0b1 { 0x001 } else { 0x080 }
            } else if extract(a, 22, 22) == 0b1 { 0x200 } else { 0x100 }
        } else if exponent == zext(0b0, 8) {
            if fraction == zext(0b0, 23) {
                if sign == 0b1 { 0x008 } else { 0x010 }
            } else {
                if sign == 0b1 { 0x004 } else { 0x020 }
            }
        } else {
            if sign == 0b1 { 0x002 } else { 0x040 }
        }, self.XLEN);
    }
}

template FPBits64 for [D] {
    schedule { units = [WriteFPAdd]; }
    param MNEMONIC: String;
    param FUNCT7: bits<7>;
    param FUNCT3: bits<3>;
    operands { fd: FPR64, fs1: FPR64, fs2: FPR64, }
    encoding { FUNCT7, fs2, fs1, FUNCT3, fd, 0b1010011, }
    asm { "{self.MNEMONIC} {fd}, {fs1}, {fs2}" }
}

instruction FSignD for [D] : FPBits64 {
    param MNEMONIC: String = "fsgnj.d";
    param OPNAME: String = "fsgnj.d.full";
    param FUNCT7: bits<7> = 0b0010001;
    param FUNCT3: bits<3> = 0b000;
    behavior {
        a = extract(fs1, 63, 0);
        b = extract(fs2, 63, 0);
        fd = bitcast((a & 0x7FFFFFFFFFFFFFFF) | ((b) & 0x8000000000000000));
    }
}

instruction FSignND for [D] : FPBits64 {
    param MNEMONIC: String = "fsgnjn.d";
    param FUNCT7: bits<7> = 0b0010001;
    param FUNCT3: bits<3> = 0b001;
    behavior {
        a = extract(fs1, 63, 0);
        b = extract(fs2, 63, 0);
        fd = bitcast((a & 0x7FFFFFFFFFFFFFFF) | ((b ^ 0x8000000000000000) & 0x8000000000000000));
    }
}

instruction FSignXD for [D] : FPBits64 {
    param MNEMONIC: String = "fsgnjx.d";
    param FUNCT7: bits<7> = 0b0010001;
    param FUNCT3: bits<3> = 0b010;
    behavior {
        a = extract(fs1, 63, 0);
        b = extract(fs2, 63, 0);
        fd = bitcast((a & 0x7FFFFFFFFFFFFFFF) | ((a ^ b) & 0x8000000000000000));
    }
}

instruction FMinD for [D] : FPBits64 {
    param MNEMONIC: String = "fmin.d";
    param FUNCT7: bits<7> = 0b0010101;
    param FUNCT3: bits<3> = 0b000;
    behavior {
        a = extract(fs1, 63, 0);
        b = extract(fs2, 63, 0);
        amag = a & 0x7FFFFFFFFFFFFFFF;
        bmag = b & 0x7FFFFFFFFFFFFFFF;
        anan = amag ~> 0x7FF0000000000000;
        bnan = bmag ~> 0x7FF0000000000000;
        FFLAGS::fflags = FFLAGS::fflags | if scalar_snan64(a) | scalar_snan64(b) { 0b10000 } else { 0b00000 };
        fd = if anan & bnan {
            bitcast(0x7FF8000000000000)
        } else if anan {
            fs2
        } else if bnan {
            fs1
        } else if (amag == zext(0b0, 64)) & (bmag == zext(0b0, 64)) {
            bitcast(a | b)
        } else if fs1 < fs2 {
            fs1
        } else {
            fs2
        };
    }
}

instruction FMaxD for [D] : FPBits64 {
    param MNEMONIC: String = "fmax.d";
    param FUNCT7: bits<7> = 0b0010101;
    param FUNCT3: bits<3> = 0b001;
    behavior {
        a = extract(fs1, 63, 0);
        b = extract(fs2, 63, 0);
        amag = a & 0x7FFFFFFFFFFFFFFF;
        bmag = b & 0x7FFFFFFFFFFFFFFF;
        anan = amag ~> 0x7FF0000000000000;
        bnan = bmag ~> 0x7FF0000000000000;
        FFLAGS::fflags = FFLAGS::fflags | if scalar_snan64(a) | scalar_snan64(b) { 0b10000 } else { 0b00000 };
        fd = if anan & bnan {
            bitcast(0x7FF8000000000000)
        } else if anan {
            fs2
        } else if bnan {
            fs1
        } else if (amag == zext(0b0, 64)) & (bmag == zext(0b0, 64)) {
            bitcast(a & b)
        } else if fs1 > fs2 {
            fs1
        } else {
            fs2
        };
    }
}

template FPInspect64 for [D] {
    schedule { units = [WriteFPAdd]; }
    param MNEMONIC: String;
    param FUNCT3: bits<3>;
    operands { rd: GPR, fs1: FPR64, }
    encoding { 0b1110001, 0b00000, fs1, FUNCT3, rd, 0b1010011, }
    asm { "{self.MNEMONIC} {rd}, {fs1}" }
}

instruction FClassD for [D] : FPInspect64 {
    param MNEMONIC: String = "fclass.d";
    param FUNCT3: bits<3> = 0b001;
    behavior {
        a = extract(fs1, 63, 0);
        sign = extract(a, 63, 63);
        exponent = extract(a, 62, 52);
        fraction = extract(a, 51, 0);
        rd = zext(if exponent == 0b11111111111 {
            if fraction == zext(0b0, 52) {
                if sign == 0b1 { 0x001 } else { 0x080 }
            } else if extract(a, 51, 51) == 0b1 { 0x200 } else { 0x100 }
        } else if exponent == zext(0b0, 11) {
            if fraction == zext(0b0, 52) {
                if sign == 0b1 { 0x008 } else { 0x010 }
            } else {
                if sign == 0b1 { 0x004 } else { 0x020 }
            }
        } else {
            if sign == 0b1 { 0x002 } else { 0x040 }
        }, self.XLEN);
    }
}

instruction FMvXW for [F] : FPInspect32 {
    param MNEMONIC: String = "fmv.x.w";
    param FUNCT3: bits<3> = 0b000;
    behavior { rd = sext(extract(bitcast(fs1), 31, 0), self.XLEN); }
}

template FPCompare32 for [F] {
    schedule { units = [WriteFPAdd]; }
    param MNEMONIC: String;
    param FUNCT3: bits<3>;
    operands { rd: GPR, fs1: FPR32, fs2: FPR32, }
    encoding { 0b1010000, fs2, fs1, FUNCT3, rd, 0b1010011, }
    asm { "{self.MNEMONIC} {rd}, {fs1}, {fs2}" }
}

instruction FLtS for [F] : FPCompare32 {
    param MNEMONIC: String = "flt.s";
    param FUNCT3: bits<3> = 0b001;
    behavior {
        FFLAGS::fflags = FFLAGS::fflags | if ((bitcast(fs1) & 0x7FFFFFFF) ~> 0x7F800000) | ((bitcast(fs2) & 0x7FFFFFFF) ~> 0x7F800000) { 0b10000 } else { 0b00000 };
        rd = zext(if fs1 < fs2 { 0b1 } else { 0b0 }, self.XLEN);
    }
}

instruction FLeS for [F] : FPCompare32 {
    param MNEMONIC: String = "fle.s";
    param FUNCT3: bits<3> = 0b000;
    behavior {
        FFLAGS::fflags = FFLAGS::fflags | if ((bitcast(fs1) & 0x7FFFFFFF) ~> 0x7F800000) | ((bitcast(fs2) & 0x7FFFFFFF) ~> 0x7F800000) { 0b10000 } else { 0b00000 };
        rd = zext(if fs2 >= fs1 { 0b1 } else { 0b0 }, self.XLEN);
    }
}

instruction FEqS for [F] : FPCompare32 {
    param MNEMONIC: String = "feq.s";
    param FUNCT3: bits<3> = 0b010;
    behavior {
        FFLAGS::fflags = FFLAGS::fflags | if scalar_snan32(bitcast(fs1)) | scalar_snan32(bitcast(fs2)) { 0b10000 } else { 0b00000 };
        rd = zext(if (fs1 >= fs2) & (fs2 >= fs1) { 0b1 } else { 0b0 }, self.XLEN);
    }
}

instruction ReadFFlags for [F] {
    param MNEMONIC: String = "csrrs";
    param OPNAME: String = "read_fflags";
    operands { rd: GPR, }
    encoding { 0b000000000001, 0b00000, 0b010, rd, 0b1110011 }
    asm { "csrrs {rd}, fflags, x0" }
    behavior { rd = FFLAGS::fflags; }
}

instruction ReadFRound for [F] {
    param MNEMONIC: String = "csrrs";
    param OPNAME: String = "read_fround";
    operands { rd: GPR, }
    encoding { 0b000000000010, 0b00000, 0b010, rd, 0b1110011 }
    asm { "csrrs {rd}, frm, x0" }
    behavior { rd = FRM::frm; }
}

instruction SetFFlags for [F] {
    param MNEMONIC: String = "csrrw";
    param OPNAME: String = "set_fflags";
    operands { rs: GPR, }
    encoding { 0b000000000001, rs, 0b001, 0b00000, 0b1110011 }
    asm { "csrrw x0, fflags, {rs}" }
    behavior { FFLAGS::fflags = extract(rs, 4, 0); }
}

instruction SetFRound for [F] {
    param MNEMONIC: String = "csrrw";
    param OPNAME: String = "set_fround";
    operands { rs: GPR, }
    encoding { 0b000000000010, rs, 0b001, 0b00000, 0b1110011 }
    asm { "csrrw x0, frm, {rs}" }
    behavior { FRM::frm = extract(rs, 2, 0); }
}

instruction ClearFFlags for [F] {
    param MNEMONIC: String = "csrrc";
    param OPNAME: String = "clear_fflags";
    operands { rs: GPR, }
    encoding { 0b000000000001, rs, 0b011, 0b00000, 0b1110011 }
    asm { "csrrc x0, fflags, {rs}" }
    behavior { FFLAGS::fflags = FFLAGS::fflags & (extract(rs, 4, 0) ^ 0b11111); }
}

instruction RaiseFFlags for [F] {
    param MNEMONIC: String = "csrrs";
    param OPNAME: String = "raise_fflags";
    operands { rs: GPR, }
    encoding { 0b000000000001, rs, 0b010, 0b00000, 0b1110011 }
    asm { "csrrs x0, fflags, {rs}" }
    behavior { FFLAGS::fflags = FFLAGS::fflags | extract(rs, 4, 0); }
}

instruction ReadFEnv for [F] {
    param MNEMONIC: String = "csrrs";
    param OPNAME: String = "read_fenv";
    operands { rd: GPR, }
    encoding { 0b000000000011, 0b00000, 0b010, rd, 0b1110011 }
    asm { "csrrs {rd}, fcsr, x0" }
    behavior { rd = zext(FFLAGS::fflags, 13) | (zext(FRM::frm, 13) << 5) | (zext(FPTRAPS::fptraps, 13) << 8); }
}

instruction SetFEnv for [F] {
    param MNEMONIC: String = "csrrw";
    param OPNAME: String = "set_fenv";
    operands { rs: GPR, }
    encoding { 0b000000000011, rs, 0b001, 0b00000, 0b1110011 }
    asm { "csrrw x0, fcsr, {rs}" }
    behavior {
        FFLAGS::fflags = extract(rs, 4, 0);
        FRM::frm = extract(rs, 7, 5);
        FPTRAPS::fptraps = extract(rs, 12, 8);
    }
}
