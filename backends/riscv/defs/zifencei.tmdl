//! Instruction-stream synchronization from the Zifencei extension.

// RISC-V Zifencei standard extension: instruction-stream fence.

/// Instruction-fetch synchronization through `fence.i`, making earlier stores visible to subsequent
/// instruction fetches on the same hart.
///
/// See [RISC-V Unprivileged ISA, Zifencei instruction-fetch fence](https://docs.riscv.org/reference/isa/unpriv/zifencei.html).
isa Zifencei requires [RV32I | RV64I] {}

instruction FenceI for [Zifencei] {
    param MNEMONIC: String = "fence.i";
    param OPCODE: bits<7> = 0b0001111;

    encoding {
        0x000,
        0b00000,
        0b001,
        0b00000,
        OPCODE,
    }

    asm {
        "{self.MNEMONIC}"
    }

    behavior {
        fence_i();
    }
}
