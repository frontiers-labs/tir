use crate::perf::WriteFPDivSingle;
use crate::perf::WriteFPFmaDouble;
use crate::perf::WriteFPFmaSingle;
use crate::perf::WriteFPLoad;
use crate::perf::WriteFPMul;
use crate::perf::WriteIALU;
use crate::perf::WriteIDiv;
use crate::perf::WriteIDivWord;
