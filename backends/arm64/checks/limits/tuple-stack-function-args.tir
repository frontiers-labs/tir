// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  %fn_callee = func.func @callee(%0: !f64, %1: !f64, %2: !f64, %3: !f64, %4: !f64, %5: !f64,
               %6: !tuple<!f64, !f64, !f64, !f64>) -> !f64 {
    %7 = tuple_get %6 {index = 0} : !f64
    %8 = tuple_get %6 {index = 1} : !f64
    %9 = tuple_get %6 {index = 2} : !f64
    %10 = tuple_get %6 {index = 3} : !f64
    %11 = fp.add %7, %8 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %12 = fp.add %9, %10 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %13 = fp.add %11, %12 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %13
  }
  module_end
}

// CHECK: arm64.load_float_double {ft = %{{[0-9]+}}:{{d[0-9]+}}, rn = sp, imm = 0}
// CHECK: arm64.load_float_double {ft = %{{[0-9]+}}:{{d[0-9]+}}, rn = sp, imm = 8}
// CHECK: arm64.load_float_double {ft = %{{[0-9]+}}:{{d[0-9]+}}, rn = sp, imm = 16}
// CHECK: arm64.load_float_double {ft = %{{[0-9]+}}:{{d[0-9]+}}, rn = sp, imm = 24}
// CHECK: asm.vret
