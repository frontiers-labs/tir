// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

// Coverage: f64 arithmetic selects the scalar FP ops and float arguments land in
// the FP registers (regalloc assigns d0/d1). This PASSES today and pins the
// working float path against regressions.

module {
  %fn_f = func.func @f(%0: !f64, %1: !f64) -> !f64 {
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %3 = fp.sub %2, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %4 = fp.mul %3, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %5 = fp.div %4, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %5
  }
  %fn_convert = func.func @convert(%0: !i32) -> !f64 {
    %1 = fp.from_si %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %1
  }
  %fn_convert_unsigned = func.func @convert_unsigned(%0: !i32) -> !f64 {
    %1 = fp.from_ui %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %1
  }
  %fn_convert_to_signed = func.func @convert_to_signed(%0: !f64) -> !i32 {
    %1 = fp.to_si %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    func.return %1
  }
  %fn_convert_to_unsigned = func.func @convert_to_unsigned(%0: !f64) -> !i32 {
    %1 = fp.to_ui %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    func.return %1
  }
  %fn_convert_to_signed_i64 = func.func @convert_to_signed_i64(%0: !f64) -> !i64 {
    %1 = fp.to_si %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i64
    func.return %1
  }
  %fn_convert_to_unsigned_i64 = func.func @convert_to_unsigned_i64(%0: !f64) -> !i64 {
    %1 = fp.to_ui %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i64
    func.return %1
  }
  %fn_convert_to_signed_i64_trunc_store = func.func @convert_to_signed_i64_trunc_store(%0: !ptr.p<!f64>, %1: !ptr.p<!i32>) -> !i32 {
    %2 = ptr.load %0 : !f64
    %3 = fp.to_si %2 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i64
    %4 = trunci %3 : !i32
    ptr.store %4, %1
    %6 = ptr.load %1 : !i32
    func.return %6
  }
  %fn_bits_to_double = func.func @bits_to_double(%0: !i64) -> !f64 {
    %1 = bitcast %0 : !f64
    func.return %1
  }
  %fn_double_to_bits = func.func @double_to_bits(%0: !f64) -> !i64 {
    %1 = bitcast %0 : !i64
    func.return %1
  }
  %fn_less = func.func @less(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "olt", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_less_equal = func.func @less_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "ole", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_greater = func.func @greater(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "ogt", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_greater_equal = func.func @greater_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "oge", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_equal = func.func @equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "oeq", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_not_equal = func.func @not_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "une", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  module_end
}

// CHECK: asm.symbol {name = "f"
// CHECK: arm64.fadd {fd = %[[V2:[0-9]+]]:FPR64, fa = %[[V0:[0-9]+]]:FPR64, fb = %[[V1:[0-9]+]]:FPR64}
// CHECK-NEXT: arm64.fsub
// CHECK-NEXT: arm64.fmul
// CHECK-NEXT: arm64.fdiv
// CHECK-NEXT: asm.vret
// CHECK: asm.symbol {name = "convert", arg_regs = [%{{[0-9]+}}:GPR]
// CHECK: arm64.scvtf_d_w {fd = %{{[0-9]+}}:FPR64, rn = %{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_unsigned", arg_regs = [%{{[0-9]+}}:GPR]
// CHECK: arm64.ucvtf_d_w {fd = %{{[0-9]+}}:FPR64, rn = %{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed"
// CHECK: arm64.fcvtzs_w_d {rd = %{{[0-9]+}}:GPR, fa = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_unsigned"
// CHECK: arm64.fcvtzu_w_d {rd = %{{[0-9]+}}:GPR, fa = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed_i64"
// CHECK: arm64.fcvtzs_x_d {rd = %{{[0-9]+}}:GPR, fa = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_unsigned_i64"
// CHECK: arm64.fcvtzu_x_d {rd = %{{[0-9]+}}:GPR, fa = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed_i64_trunc_store"
// CHECK: arm64.load_float_double
// CHECK: arm64.fcvtzs_x_d
// CHECK: arm64.store_word
// CHECK: arm64.load_word_unsigned
// CHECK: asm.symbol {name = "bits_to_double"
// CHECK: arm64.fmov_d_x {fd = %{{[0-9]+}}:FPR64, rn = %{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "double_to_bits"
// CHECK: arm64.fmov_x_d {rd = %{{[0-9]+}}:GPR, fa = %{{[0-9]+}}:FPR64}
// CHECK: asm.vret
