// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

// Coverage: f64 arithmetic selects the scalar FP ops and float arguments land in
// the FP registers (regalloc assigns d0/d1). This PASSES today and pins the
// working float path against regressions.

module {
  %fn_f = func.func @f(%0: !f64, %1: !f64) -> !f64 {
    %2 = addf %0, %1 : !f64
    %3 = subf %2, %1 : !f64
    %4 = mulf %3, %1 : !f64
    %5 = divf %4, %1 : !f64
    func.return %5
  }
  %fn_convert = func.func @convert(%0: !i32) -> !f64 {
    %1 = sitofp %0 : !f64
    func.return %1
  }
  %fn_convert_unsigned = func.func @convert_unsigned(%0: !i32) -> !f64 {
    %1 = uitofp %0 : !f64
    func.return %1
  }
  %fn_convert_to_signed = func.func @convert_to_signed(%0: !f64) -> !i32 {
    %1 = fptosi %0 : !i32
    func.return %1
  }
  %fn_convert_to_unsigned = func.func @convert_to_unsigned(%0: !f64) -> !i32 {
    %1 = fptoui %0 : !i32
    func.return %1
  }
  %fn_convert_to_signed_i64 = func.func @convert_to_signed_i64(%0: !f64) -> !i64 {
    %1 = fptosi %0 : !i64
    func.return %1
  }
  %fn_convert_to_unsigned_i64 = func.func @convert_to_unsigned_i64(%0: !f64) -> !i64 {
    %1 = fptoui %0 : !i64
    func.return %1
  }
  %fn_convert_to_signed_i64_trunc_store = func.func @convert_to_signed_i64_trunc_store(%0: !ptr.p<!f64>, %1: !ptr.p<!i32>) -> !i32 {
    %2 = ptr.load %0 : !f64
    %3 = fptosi %2 : !i64
    %4 = trunci %3 : !i32
    ptr.store %4, %1
    %6 = ptr.load %1 : !i32
    func.return %6
  }
  %fn_bits_to_double = func.func @bits_to_double(%0: !i64) -> !f64 {
    %1 = bitcast %0 : !f64
    func.return %1
  }
  %fn_double_to_bits = func.func @double_to_bits(%0: !f64) -> !i64 {
    %1 = bitcast %0 : !i64
    func.return %1
  }
  %fn_less = func.func @less(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "olt"} : !i1
    func.return %2
  }
  %fn_less_equal = func.func @less_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "ole"} : !i1
    func.return %2
  }
  %fn_greater = func.func @greater(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "ogt"} : !i1
    func.return %2
  }
  %fn_greater_equal = func.func @greater_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "oge"} : !i1
    func.return %2
  }
  %fn_equal = func.func @equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "oeq"} : !i1
    func.return %2
  }
  %fn_not_equal = func.func @not_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "une"} : !i1
    func.return %2
  }
  module_end
}

// CHECK: asm.symbol {name = "f"
// CHECK: arm64.fadd {fd = %virt2:FPR64, fa = %virt0:FPR64, fb = %virt1:FPR64}
// CHECK-NEXT: arm64.fsub
// CHECK-NEXT: arm64.fmul
// CHECK-NEXT: arm64.fdiv
// CHECK-NEXT: asm.vret
// CHECK: asm.symbol {name = "convert", arg_regs = [%virt{{[0-9]+}}:GPR]}
// CHECK: arm64.scvtf_d_w {fd = %virt{{[0-9]+}}:FPR64, rn = %virt{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_unsigned", arg_regs = [%virt{{[0-9]+}}:GPR]}
// CHECK: arm64.ucvtf_d_w {fd = %virt{{[0-9]+}}:FPR64, rn = %virt{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed"
// CHECK: arm64.fcvtzs_w_d {rd = %virt{{[0-9]+}}:GPR, fa = %virt{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_unsigned"
// CHECK: arm64.fcvtzu_w_d {rd = %virt{{[0-9]+}}:GPR, fa = %virt{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed_i64"
// CHECK: arm64.fcvtzs_x_d {rd = %virt{{[0-9]+}}:GPR, fa = %virt{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_unsigned_i64"
// CHECK: arm64.fcvtzu_x_d {rd = %virt{{[0-9]+}}:GPR, fa = %virt{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "convert_to_signed_i64_trunc_store"
// CHECK: arm64.load_float_double
// CHECK: arm64.fcvtzs_x_d
// CHECK: arm64.store_word
// CHECK: arm64.load_word_unsigned
// CHECK: asm.symbol {name = "bits_to_double"
// CHECK: arm64.fmov_d_x {fd = %virt{{[0-9]+}}:FPR64, rn = %virt{{[0-9]+}}:GPR}
// CHECK: asm.vret
// CHECK: asm.symbol {name = "double_to_bits"
// CHECK: arm64.fmov_x_d {rd = %virt{{[0-9]+}}:GPR, fa = %virt{{[0-9]+}}:FPR64}
// CHECK: asm.vret
// CHECK-LABEL: asm.symbol {name = "less"
// CHECK: arm64.fcmp_d
// CHECK-NEXT: arm64.cset_gt
// CHECK-LABEL: asm.symbol {name = "less_equal"
// CHECK: arm64.fcmp_d
// CHECK-NEXT: arm64.cset_ge
// CHECK-LABEL: asm.symbol {name = "greater"
// CHECK: arm64.fcmp_d
// CHECK-NEXT: arm64.cset_gt
// CHECK-LABEL: asm.symbol {name = "greater_equal"
// CHECK: arm64.fcmp_d
// CHECK-NEXT: arm64.cset_ge
// CHECK-LABEL: asm.symbol {name = "equal"
// CHECK: arm64.fcmp_d
// CHECK-NEXT: arm64.cset_eq
// CHECK-LABEL: asm.symbol {name = "not_equal"
// CHECK: arm64.fcmp_d
// CHECK-NEXT: arm64.cset_ne
