// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  func.declare @make_pair() -> !tuple<!f64, !f64>
  func.func @forward() -> !tuple<!f64, !f64> {
    %0 = func.call @make_pair() -> !tuple<!f64, !f64>
    func.return %0
  }
  module_end
}

// CHECK: asm.vcall {callee = "make_pair"
// CHECK: arm64.fmov_reg64
// CHECK: arm64.fmov_reg64
// CHECK: asm.vret
