// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  %fn_make_pair = func.declare @make_pair() -> !tuple<!f64, !f64>
  %fn_forward = func.func @forward() -> !tuple<!f64, !f64> {
    %0 = func.call %fn_make_pair() -> !tuple<!f64, !f64>
    func.return %0
  }
  module_end
}

// CHECK: asm.vcall | %{{[0-9]+}} {callee = "make_pair"
// CHECK: arm64.fmov_reg64
// CHECK: arm64.fmov_reg64
// CHECK: asm.vret
