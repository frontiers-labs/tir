// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  %fn_repeat_first = func.func @repeat_first(%0: !tuple<!f64, !f64>) -> !f64 {
    %1 = tuple_get %0 {index = 0} : !f64
    %2 = tuple_get %0 {index = 0} : !f64
    %3 = fp.add %1, %2 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %3
  }
  module_end
}

// CHECK: arm64.fadd
// CHECK: asm.vret
