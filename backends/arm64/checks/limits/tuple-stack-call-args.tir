// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  %fn_ext = func.declare @ext(!f64,!f64,!f64,!f64,!f64,!f64,!tuple<!f64, !f64, !f64, !f64>) -> !f64
  %fn_caller = func.func @caller(%0: !f64) -> !f64 {
    %1 = make_tuple %0, %0, %0, %0 : !tuple<!f64, !f64, !f64, !f64>
    %2 = func.call %fn_ext(%0,%0,%0,%0,%0,%0,%1 : !f64,!f64,!f64,!f64,!f64,!f64,!tuple<!f64, !f64, !f64, !f64>) -> !f64
    func.return %2
  }
  module_end
}

// CHECK: arm64.sub_imm {rd = sp, rn = sp, imm = 48}
// CHECK: arm64.store_float_double {ft = d{{[0-9]+}}, rn = sp, imm = 0}
// CHECK: arm64.store_float_double {ft = d{{[0-9]+}}, rn = sp, imm = 8}
// CHECK: arm64.store_float_double {ft = d{{[0-9]+}}, rn = sp, imm = 16}
// CHECK: arm64.store_float_double {ft = d{{[0-9]+}}, rn = sp, imm = 24}
// CHECK: asm.vcall {callee = "ext"
// CHECK: arm64.add_imm {rd = sp, rn = sp, imm = 48}
