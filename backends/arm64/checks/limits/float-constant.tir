// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s
// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s --check-prefix=ISEL

module {
  %fn_f = func.func @f() -> !f64 {
    %0 = constantf {value = 1.5} : !f64
    func.return %0
  }
  module_end
}

// CHECK: arm64.movz
// CHECK: arm64.movk_lsl48
// CHECK: arm64.fmov_d_x
// CHECK-NOT: constantf
// ISEL: arm64.movz
// ISEL: arm64.movk_lsl48
// ISEL: arm64.fmov_d_x
// ISEL-NOT: constantf
