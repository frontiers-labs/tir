// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  %fn_f = func.func @f(%0: !i64, %1: !i64, %2: !i64, %3: !i64, %4: !i64, %5: !i64, %6: !i64, %7: !i64, %8: !i32) -> !i64 {
    %9 = extsi %8 : !i64
    func.return %9
  }
  module_end
}

// CHECK: arm64.load_doubleword {rt = {{x[0-9]+}}, rn = sp, imm = 0}
// CHECK: arm64.sxtw
// CHECK: asm.vret
