// RUN: tir mc --march=armv8 --stage=regalloc %s | filecheck %s

module {
  func.func @chain(%0: !i32, %1: !i32) -> !i32 {
    %2 = addi %0, %1 : !i32
    %3 = subi %2, %1 : !i32
    %4 = andi %3, %0 : !i32
    %5 = ori %4, %1 : !i32
    func.return %5
  }
  module_end
}

// CHECK: arm64.add_w {rd = {{w[0-9]+}}, rn = w0, rm = w1}
// CHECK: arm64.sub_w
// CHECK: arm64.and_w
// CHECK: arm64.orr_w {rd = w0,
// CHECK: asm.vret
