// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

// %a is computed, passed to an external call, then read again after it, so it is
// live across the call and must occupy a callee-saved register (x19). The func.return
// address saved across the call rides the same mechanism in a second callee-saved
// register (x20). Per AAPCS64 both must be preserved for this function's caller:
// the prologue saves them into the frame and the epilogue restores them before
// the func.return. The call clobbers x0..x17 and the caller-saved SIMD/FP registers;
// x18 is reserved as the platform register and never appears. The condition
// flags go too: a callee runs arbitrary code, so the flags a compare left do
// not survive it either.

module {
  %fn_ext = func.declare @ext(!i64) -> !i64
  %fn_f = func.func @f(%0: !i64) -> !i64 {
    %a = addi %0, %0 : !i64
    %1 = func.call %fn_ext(%a : !i64) -> !i64
    %2 = addi %a, %1 : !i64
    func.return %2
  }
  module_end
}

// Prologue: reserve the frame, then save the two callee-saved registers used.
// CHECK: arm64.sub_imm {rd = sp, rn = sp, imm = 16}
// CHECK: arm64.store_doubleword {rt = x19, rn = sp, imm = 0}
// CHECK: arm64.store_doubleword {rt = x20, rn = sp, imm = 8}
// CHECK: asm.vcall {callee = "ext", outgoing_stack_size = 0, clobbers = [GPR[0], GPR[1], GPR[2], GPR[3], GPR[4], GPR[5], GPR[6], GPR[7], GPR[8], GPR[9], GPR[10], GPR[11], GPR[12], GPR[13], GPR[14], GPR[15], GPR[16], GPR[17], PSTATE[0], PSTATE[1], PSTATE[2], PSTATE[3], VPR[0]
// CHECK-SAME: VPR[31]]
// The call reads what the convention placed: x0 holds the argument, and sp
// holds the return address it pushes.
// CHECK-SAME: uses = [GPR[0], GPRsp[31]]}
// Epilogue: restore both and release the frame before the func.return.
// CHECK: arm64.load_doubleword {rt = x19, rn = sp, imm = 0}
// CHECK: arm64.load_doubleword {rt = x20, rn = sp, imm = 8}
// CHECK: arm64.add_imm {rd = sp, rn = sp, imm = 16}
// CHECK: asm.vret
