// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  func.func @make_large(%0: !ptr.p, %1: !i64) result_address {
    ptr.store %1, %0
    func.return
  }
  func.func @caller(%0: !ptr.p, %1: !i64) {
    func.call @make_large(%0, %1 : !ptr.p, !i64) result_address
    func.return
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "make_large"
// CHECK: arm64.store_doubleword {rt = {{x[0-9]+}}, rn = x8, imm = 0}
// CHECK-LABEL: asm.symbol {name = "caller"
// CHECK: arm64.orr {rd = x8, rn = x31, rm = {{x[0-9]+}}}
// CHECK: asm.vcall {callee = "make_large"
