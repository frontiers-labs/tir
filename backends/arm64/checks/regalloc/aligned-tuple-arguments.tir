// RUN: tir mc --march=arm64 --stage=regalloc %s | filecheck %s

module {
  %fn_consume = func.declare @consume(!i64, !tuple<!i64, !i64>) -> !i64
  %fn_consume_defined = func.func @consume_defined(%0: !i64, %1: !tuple<!i64, !i64>) -> !i64 argument_alignments [1, 16] {
    %2 = tuple_get %1 {index = 0} : !i64
    %3 = tuple_get %1 {index = 1} : !i64
    %4 = addi %0, %2 : !i64
    %5 = addi %4, %3 : !i64
    func.return %5
  }
  %fn_forward = func.func @forward(%0: !i64, %1: !i64, %2: !i64) -> !i64 {
    %3 = make_tuple %1, %2 : !tuple<!i64, !i64>
    %4 = func.call %fn_consume(%0, %3 : !i64, !tuple<!i64, !i64>) -> !i64 argument_alignments [1, 16]
    func.return %4
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "consume_defined"
// CHECK: arm64.add {rd = %{{[0-9]+}}:x0, rn = %{{[0-9]+}}:x0, rm = %{{[0-9]+}}:x2}
// CHECK: arm64.add {rd = %{{[0-9]+}}:x0, rn = %{{[0-9]+}}:x0, rm = %{{[0-9]+}}:x3}
// CHECK-LABEL: asm.symbol {name = "forward"
// CHECK: arm64.orr {rd = x2, rn = x31, rm = %{{[0-9]+}}:{{x[0-9]+}}}
// CHECK: arm64.orr {rd = x3, rn = x31, rm = %{{[0-9]+}}:{{x[0-9]+}}}
// CHECK: asm.vcall | %{{[0-9]+}} {callee = "consume"
