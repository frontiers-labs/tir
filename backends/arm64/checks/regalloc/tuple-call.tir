// RUN: tir mc --march=armv8 --stage=regalloc %s | filecheck %s

module {
  %fn_make_pair = func.declare @make_pair() -> !tuple<!i64, !i64>
  %fn_right = func.func @right() -> !i64 {
    %0 = func.call %fn_make_pair() -> !tuple<!i64, !i64>
    %1 = tuple_get %0 {index = 1} : !i64
    func.return %1
  }
  module_end
}

// CHECK: asm.vcall | %{{[0-9]+}} {callee = "make_pair"
// CHECK: arm64.orr {rd = %{{[0-9]+}}:x0, rn = x31, rm = x1}
// CHECK: asm.vret
