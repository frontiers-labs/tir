// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

module {
  %fn_constant = func.func @constant() -> !i64 {
    %value = constant {value = 4} : !i64
    func.return %value
  }

  %fn_negative_i16 = func.func @negative_i16() -> !i16 {
    %value = constant {value = -32640} : !i16
    func.return %value
  }
  module_end
}

// CHECK: asm.symbol {name = "constant"
// CHECK: arm64.movz
// CHECK: asm.symbol {name = "negative_i16"
// CHECK: arm64.movz
// CHECK-NOT: constant
