// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

module {
  %fn_rem32 = func.func @rem32(%0: !i32, %1: !i32) -> !i32 {
    %2 = remsi %0, %1 : !i32
    func.return %2
  }
  %fn_rem64 = func.func @rem64(%0: !i64, %1: !i64) -> !i64 {
    %2 = remsi %0, %1 : !i64
    func.return %2
  }
  %fn_remu32 = func.func @remu32(%0: !i32, %1: !i32) -> !i32 {
    %2 = remui %0, %1 : !i32
    func.return %2
  }
  %fn_remu64 = func.func @remu64(%0: !i64, %1: !i64) -> !i64 {
    %2 = remui %0, %1 : !i64
    func.return %2
  }
  module_end
}

// CHECK: arm64.sdiv_word
// CHECK: arm64.msub_word
// CHECK: arm64.sdiv
// CHECK: arm64.msub
// CHECK: arm64.udiv_word
// CHECK: arm64.msub_word
// CHECK: arm64.udiv
// CHECK: arm64.msub
