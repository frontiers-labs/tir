// RUN: tir mc --march=armv8 --stage=isel %s | filecheck %s

// Reading a gate's and a loop's regions puts their operations in the function's
// own e-graph, so a constant defined outside is the same class inside and folds
// into the region's instruction as an immediate.

module {
  %fn_choose = func.func @choose(%0: !i1, %1: !i64) -> !i64 {
    %c = constant {value = 7} : !i64
    %r = scf.if %0 -> !i64 {
      %a = addi %1, %c : !i64
      scf.yield %a
    } else {
      %b = subi %1, %c : !i64
      scf.yield %b
    }
    func.return %r
  }

  %fn_accumulate = func.func @accumulate(%0: !i1, %1: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %r = scf.while iter_args(%acc = %1) -> !i64 {
      scf.condition %0, %acc
    } do scope(%tok)(%cur) {
      %n = addi %cur, %c : !i64
      scf.yield %n
    }
    func.return %r
  }
  module_end
}

// CHECK: asm.symbol {name = "choose"
// CHECK: arm64.add_imm {rd = %virt{{[0-9]+}}:GPRsp, rn = %virt1:GPRsp, imm = 7}
// CHECK: arm64.sub_imm {rd = %virt{{[0-9]+}}:GPRsp, rn = %virt1:GPRsp, imm = 7}
// CHECK: asm.symbol {name = "accumulate"
// CHECK: arm64.add_imm {rd = %virt{{[0-9]+}}:GPRsp, rn = %virt{{[0-9]+}}:GPRsp, imm = 5}
