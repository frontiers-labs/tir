// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

module {
  func.func @div32(%0: !i32, %1: !i32) -> !i32 {
    %2 = divsi %0, %1 : !i32
    func.return %2
  }
  func.func @div64(%0: !i64, %1: !i64) -> !i64 {
    %2 = divsi %0, %1 : !i64
    func.return %2
  }
  func.func @divu32(%0: !i32, %1: !i32) -> !i32 {
    %2 = divui %0, %1 : !i32
    func.return %2
  }
  func.func @divu64(%0: !i64, %1: !i64) -> !i64 {
    %2 = divui %0, %1 : !i64
    func.return %2
  }
  module_end
}

// CHECK: arm64.sdiv_word
// CHECK: arm64.sdiv
// CHECK: arm64.udiv_word
// CHECK: arm64.udiv
