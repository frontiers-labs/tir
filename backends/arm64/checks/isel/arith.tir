// RUN: tir mc --march=armv8 --stage=isel %s | filecheck %s

module {
  func @chain(%0: !i32, %1: !i32) -> !i32 {
    %2 = addi %0, %1 : !i32
    %3 = subi %2, %1 : !i32
    %4 = andi %3, %0 : !i32
    %5 = ori %4, %1 : !i32
    return %5
  }
  module_end
}

// CHECK: asm.symbol {name = "chain", arg_regs = [%virt0:GPR, %virt1:GPR]}
// CHECK: arm64.add_w {rd = %virt2:GPR32, rn = %virt0:GPR32, rm = %virt1:GPR32}
// CHECK: arm64.sub_w {rd = %virt3:GPR32, rn = %virt2:GPR32, rm = %virt1:GPR32}
// CHECK: arm64.and_w {rd = %virt4:GPR32, rn = %virt0:GPR32, rm = %virt3:GPR32}
// CHECK: arm64.orr_w {rd = %virt5:GPR32, rn = %virt1:GPR32, rm = %virt4:GPR32}
// CHECK: asm.vret
