// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=armv8 --stage=isel %s | filecheck %s

module {
  %fn_chain = func.func @chain(%0: !i32, %1: !i32) -> !i32 {
    %2 = addi %0, %1 : !i32
    %3 = subi %2, %1 : !i32
    %4 = andi %3, %0 : !i32
    %5 = ori %4, %1 : !i32
    func.return %5
  }

  %fn_chain64 = func.func @chain64(%0: !i64, %1: !i64, %2: !i64) -> !i64 {
    %3 = addi %0, %1 : !i64
    %4 = subi %3, %2 : !i64
    %5 = andi %4, %0 : !i64
    %6 = ori %5, %1 : !i64
    func.return %6
  }
  module_end
}

// i32 arithmetic selects the w-register forms.
// CHECK: asm.symbol {name = "chain", arg_regs = [%[[V0:[0-9]+]]:GPR, %[[V1:[0-9]+]]:GPR]
// CHECK: arm64.add_w {rd = %[[V2:[0-9]+]]:GPR32, rn = %[[V0]]:GPR, rm = %[[V1]]:GPR}
// CHECK: arm64.sub_w {rd = %[[V3:[0-9]+]]:GPR32, rn = %[[V2]]:GPR32, rm = %[[V1]]:GPR}
// CHECK: arm64.and_w {rd = %[[V4:[0-9]+]]:GPR32, rn = %[[V0]]:GPR, rm = %[[V3]]:GPR32}
// CHECK: arm64.orr_w {rd = %[[V5:[0-9]+]]:GPR32, rn = %[[V1]]:GPR, rm = %[[V4]]:GPR32}
// CHECK: asm.vret

// i64 arithmetic selects the x-register forms.
// CHECK: asm.symbol {name = "chain64", arg_regs = [%[[V7:[0-9]+]]:GPR, %[[V8:[0-9]+]]:GPR, %[[V9:[0-9]+]]:GPR]
// CHECK: arm64.add {rd = %[[V10:[0-9]+]]:GPR, rn = %[[V7]]:GPR, rm = %[[V8]]:GPR}
// CHECK: arm64.sub {rd = %[[V11:[0-9]+]]:GPR, rn = %[[V10]]:GPR, rm = %[[V9]]:GPR}
// CHECK: arm64.and {rd = %[[V12:[0-9]+]]:GPR, rn = %[[V7]]:GPR, rm = %[[V11]]:GPR}
// CHECK: arm64.orr {rd = %[[V13:[0-9]+]]:GPR, rn = %[[V8]]:GPR, rm = %[[V12]]:GPR}
// CHECK: asm.vret
