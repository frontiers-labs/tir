// RUN: tir mc --march=aarch64 --stage=isel %s | filecheck %s

// A loop destructs into its header and body whatever the target. The body's
// yield rides the edge into a merge block, whose repeated condition chooses
// the back edge or exit.

module {
  %fn_sum = func.func @sum(%n: !i64, %acc: !i64) -> !i64 {
    cfg.br ^bb1(%acc, %n : !i64, !i64)
  ^bb1(%a: !i64, %i: !i64):
    %z = constant {value = 0} : !i64
    %c = cmpi %i, %z {predicate = "sgt"} : !i1
    cfg.cond_br %c, ^bb2, ^bb3
  ^bb2:
    %one = constant {value = 1} : !i64
    %na = addi %a, %i : !i64
    %ni = subi %i, %one : !i64
    cfg.br ^bb1(%na, %ni : !i64, !i64)
  ^bb3:
    func.return %a
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: asm.vbr %{{[0-9]+}}, %{{[0-9]+}} ^[[HDR:bb[0-9]+]]
// CHECK: ^[[HDR]](%[[A:[0-9]+]]: !arm64.GPR, %[[I:[0-9]+]]: !arm64.GPR):
// CHECK-NEXT: arm64.cmp_imm {rn = %[[I]]:GPR, imm = 0}
// CHECK-NEXT: arm64.b.gt {imm = ^[[BODY:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[EXIT:bb[0-9]+]]
// CHECK: ^[[EXIT]]:
// CHECK-NEXT: asm.vret %[[A]]
// CHECK: ^[[BODY]]:
// CHECK-NEXT: arm64.add {rd = %[[NA:[0-9]+]]:GPR, rn = %[[A]]:GPR, rm = %[[I]]:GPR}
// CHECK-NEXT: arm64.sub_imm {rd = %[[NI:[0-9]+]]:GPRsp, rn = %[[I]]:GPR, imm = 1}
// CHECK-NEXT: asm.vbr %[[NA]], %[[NI]] ^[[HDR]]
// CHECK-NOT: scf.
