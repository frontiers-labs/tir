// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

module {
  func.func @distance(%0: !ptr.p<!i32>, %1: !ptr.p<!i32>) -> !i64 {
    %2 = ptr.ptrdiff %1, %0 : !i64
    %3 = constant {value = 4} : !i64
    %4 = divsi %2, %3 : !i64
    func.return %4
  }
  module_end
}

// CHECK: arm64.sub
// CHECK: arm64.movz
// CHECK: arm64.sdiv
