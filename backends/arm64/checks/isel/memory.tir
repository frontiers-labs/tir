// RUN: tir mc --march=armv8 --stage=isel %s | filecheck %s

// Loads and stores select through the MemoryRead/MemoryWrite interfaces: each
// ptr.store becomes a store_word and each ptr.load a load_word_unsigned, with
// the base pointer bound and a zero immediate offset.

module {
  func @sum(%0: !i32, %1: !i32) -> !i32 {
    %2 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %0, %2
    %3 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    ptr.store %1, %3
    %4 = ptr.load %2 : !i32
    %5 = ptr.load %3 : !i32
    %6 = addi %4, %5 : !i32
    return %6
  }

  func @word_reg_offset(%0: !ptr.p<!i32>, %1: !i64, %2: !i32) -> !i32 {
    %3 = ptr.ptradd %0, %1 : !ptr.p<!i32>
    %4 = ptr.load %3 : !i32
    ptr.store %2, %3
    return %4
  }

  func @byte_reg_offset(%0: !ptr.p<!i8>, %1: !i64, %2: !i8) -> !i8 {
    %3 = ptr.ptradd %0, %1 : !ptr.p<!i8>
    %4 = ptr.load %3 : !i8
    ptr.store %2, %3
    return %4
  }

  func @byte_through_loaded_pointer(%0: !ptr.p<!i8>, %1: !i8) {
    %2 = ptr.alloca {size = 8, align = 8} : !ptr.p<!ptr.p<!i8>>
    ptr.store %0, %2
    %3 = ptr.load %2 : !ptr.p<!i8>
    %4 = ptr.load %3 : !i8
    %5 = xori %4, %1 : !i8
    ptr.store %5, %3
    return
  }

  func @signed_i16_load_to_i32(%0: !ptr.p<!i16>) -> !i32 {
    %1 = ptr.load %0 : !i16
    %2 = extsi %1 : !i32
    return %2
  }

  func @signed_i8_arg_to_i32(%0: !i8) -> !i32 {
    %1 = extsi %0 : !i32
    return %1
  }
  module_end
}

// CHECK: asm.symbol {name = "sum", arg_regs = [%virt0:GPR, %virt1:GPR]}
// CHECK: arm64.store_word {rt = %virt0:GPR, rn = %virt2:GPRsp, imm = 0}
// CHECK: arm64.store_word {rt = %virt1:GPR, rn = %virt3:GPRsp, imm = 0}
// CHECK: arm64.load_word_unsigned {rt = %virt4:GPR, rn = %virt2:GPRsp, imm = 0}
// CHECK: arm64.load_word_unsigned {rt = %virt5:GPR, rn = %virt3:GPRsp, imm = 0}
// CHECK: arm64.add_w {rd = %virt6:GPR32, rn = %virt4:GPR32, rm = %virt5:GPR32}
// CHECK: asm.vret

// CHECK: asm.symbol {name = "word_reg_offset"
// CHECK: arm64.load_word_unsigned_reg
// CHECK: arm64.store_word_reg
// CHECK: asm.symbol {name = "byte_reg_offset"
// CHECK: arm64.load_byte_unsigned_reg
// CHECK: arm64.store_byte_reg
// CHECK: asm.symbol {name = "byte_through_loaded_pointer"
// CHECK: arm64.load_doubleword
// CHECK: arm64.ldrb
// CHECK: arm64.strb

// CHECK: asm.symbol {name = "signed_i16_load_to_i32"
// CHECK: arm64.lslv_w
// CHECK: arm64.asr_w {rd = %virt{{[0-9]+}}:GPR32, rn = %virt{{[0-9]+}}:GPR32, imm = 16}
// CHECK: asm.symbol {name = "signed_i8_arg_to_i32"
// CHECK: arm64.lslv_w
// CHECK: arm64.asr_w {rd = %virt{{[0-9]+}}:GPR32, rn = %virt{{[0-9]+}}:GPR32, imm = 24}
