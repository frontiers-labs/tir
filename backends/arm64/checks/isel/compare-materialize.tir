// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

// A comparison used as a value (returned, not folded into a branch) materializes
// through the TMDL-derived definer+reader rules: `cmp` sets PSTATE, `cset.<cc>`
// reads the flags into a register. The condition code is composed and SMT-proved
// from the flag semantics, so it matches the predicate (eq -> cset.eq, not a
// bare flag-less cset).

module {
  %fn_eq_val = func.func @eq_val(%0: !i64, %1: !i64) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "eq"} : !i1
    func.return %2
  }
  // CHECK: asm.symbol {name = "eq_val"
  // CHECK: arm64.cmp {rn = %[[V0:[0-9]+]]:GPR, rm = %[[V1:[0-9]+]]:GPR}
  // CHECK-NEXT: arm64.cset_eq {rd = %[[V2:[0-9]+]]:GPR}
  // CHECK-NEXT: asm.vret

  %fn_ne_val = func.func @ne_val(%0: !i64, %1: !i64) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "ne"} : !i1
    func.return %2
  }
  // CHECK: asm.symbol {name = "ne_val"
  // CHECK: arm64.cmp
  // CHECK-NEXT: arm64.cset_ne {rd = %{{[0-9]+}}:GPR}

  %fn_slt_val = func.func @slt_val(%0: !i64, %1: !i64) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  // CHECK: asm.symbol {name = "slt_val"
  // CHECK: arm64.cmp
  // CHECK-NEXT: arm64.cset_lt {rd = %{{[0-9]+}}:GPR}

  %fn_ult_val = func.func @ult_val(%0: !i64, %1: !i64) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "ult"} : !i1
    func.return %2
  }
  // CHECK: asm.symbol {name = "ult_val"
  // CHECK: arm64.cmp
  // CHECK-NEXT: arm64.cset_lo {rd = %{{[0-9]+}}:GPR}

  %fn_eq_val_i32 = func.func @eq_val_i32(%0: !i32, %1: !i32) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "eq"} : !i1
    func.return %2
  }
  // CHECK: asm.symbol {name = "eq_val_i32"
  // CHECK: arm64.cmp_w
  // CHECK-NEXT: arm64.cset_eq {rd = %{{[0-9]+}}:GPR}

  %fn_ult_val_i32 = func.func @ult_val_i32(%0: !i32, %1: !i32) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "ult"} : !i1
    func.return %2
  }
  // CHECK: asm.symbol {name = "ult_val_i32"
  // CHECK: arm64.cmp_w
  // CHECK-NEXT: arm64.cset_lo {rd = %{{[0-9]+}}:GPR}

  module_end
}
