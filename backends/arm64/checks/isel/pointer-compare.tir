// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

// A pointer comparison declares the same unsigned integer comparison at the
// layout's pointer width that `cmpi` does, so the existing compare-branch rules
// select it with no pointer-specific rule.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_below = func.func @below(%0: !ptr.p, %1: !ptr.p) -> !i64 {
    %2 = ptr.cmp %0, %1 {predicate = "ult"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "below"
  // CHECK: arm64.cmp {rn = %[[V12:[0-9]+]]:GPR, rm = %[[V13:[0-9]+]]:GPR}
  // CHECK-NEXT: arm64.b.lo {imm = ^bb2}

  %fn_is_null = func.func @is_null(%0: !ptr.p) -> !i64 {
    %1 = ptr.null : !ptr.p
    %2 = ptr.cmp %0, %1 {predicate = "eq"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "is_null"
  // CHECK: arm64.cmp_imm {rn = %{{[0-9]+}}:GPR, imm = 0}
  // CHECK-NEXT: arm64.b.eq {imm = ^bb2}

  module_end
}
