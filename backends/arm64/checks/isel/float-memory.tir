// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=armv8 --stage=isel %s | filecheck %s

module {
  %fn_roundtrip = func.func @roundtrip(%0: !f64) -> !f64 {
    %1 = ptr.alloca {size = 8, align = 8} : !ptr.p<!f64>
    ptr.store %0, %1
    %2 = ptr.load %1 : !f64
    func.return %2
  }
  module_end
}

// CHECK: arm64.store_float_double {ft = %[[V0:[0-9]+]]:FPR64, rn = %[[V1:[0-9]+]]:GPRsp, imm = 0}
// CHECK: arm64.load_float_double {ft = %[[V2:[0-9]+]]:FPR64, rn = %[[V1]]:GPRsp, imm = 0}
// CHECK: asm.vret
