// RUN: tir mc --march=arm64 --stage=isel %s | filecheck %s

// A counted loop counts through the type its bounds name. Bounds of a concrete
// integer width make the counter that width, so the wrapping the source language
// defines survives destruction instead of being widened to the index type.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_count = func.func @count(%lb: !i32, %ub: !i32, %st: !i32, %init: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %r = scf.for %lb, %ub, %st iter_args(%acc = %init) -> !i64 {
      %n = addi %acc, %c : !i64
      scf.yield %n
    }
    func.return %r
  }
  module_end
}

// CHECK-NOT: scf.
// The counter is minted as a 32-bit header argument and tested 32 bits wide
// against the bound before every iteration.
// CHECK: ^[[HDR:bb[0-9]+]](%[[IV:[0-9]+]]: !arm64.GPR32, %{{[0-9]+}}: !arm64.GPRsp | %{{[0-9]+}}):
// CHECK: arm64.cmp_w {rn = %[[IV]]:GPR32, rm = %[[UB:[0-9]+]]:GPR}
// CHECK: arm64.b.lt {imm = ^[[BODY:bb[0-9]+]]}
// The body advances the counter 32 bits wide and carries it round the back edge.
// CHECK: ^[[BODY]](| %{{[0-9]+}}):
// CHECK-NEXT: arm64.add_imm {rd = %{{[0-9]+}}:GPRsp, rn = %{{[0-9]+}}:GPRsp, imm = 5}
// CHECK-NEXT: arm64.add_w {rd = %[[NEXT:[0-9]+]]:GPR32, rn = %[[IV]]:GPR32, rm = %{{[0-9]+}}:GPR}
// CHECK-NEXT: asm.vbr %[[NEXT]], %{{[0-9]+}}, %{{[0-9]+}} ^[[HDR]]
// CHECK-NOT: scf.
