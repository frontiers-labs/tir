// RUN: tir mc --march=arm64 --filetype=obj-ascii %s | filecheck %s

module {
  %fn_select = func.func @select(%0: !i1) -> !i32 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %1 = constant {value = 1} : !i32
    func.return %1
  ^bb2:
    %2 = constant {value = 0} : !i32
    func.return %2
  }
  module_end
}

// The false arm follows the conditional branch. Each arm materializes its
// result locally and returns directly; the bytes check the branch fixup.
// CHECK: .section .text
// CHECK-NEXT: select:
// CHECK-NEXT: [0x00, 0x00, 0x40, 0x92]
// CHECK-NEXT: [0x60, 0x00, 0x00, 0xB5]
// CHECK-NEXT: [0x00, 0x00, 0x80, 0xD2]
// CHECK-NEXT: [0xC0, 0x03, 0x5F, 0xD6]
// CHECK-NEXT: [0x20, 0x00, 0x80, 0xD2]
// CHECK-NEXT: [0xC0, 0x03, 0x5F, 0xD6]
