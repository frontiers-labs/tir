macro tmpl_addsub_imm {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIALU]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OP: bits<1>;
            param SETFLAGS: bits<1> = 0b0;
            param SH: bits<1> = 0b0;

            operands {
                rd: $cls,
                rn: $cls,
                imm: bits<12>,
            }

            encoding {
                SF,
                OP,
                SETFLAGS,
                0b100010,
                SH,
                imm,
                rn[4..0],
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}, {imm}"
            }
        }
