tmpl_addsub_imm!(AddSubImmWord, GPR32sp, sf = 0b0)

// Flag-setting add/sub immediate keeps SP as a valid source, but encoding 31
// in the destination names XZR rather than SP.
macro tmpl_addsub_imm_flags {
    ( $name:ident, $rd_cls:ident, $rn_cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIALU]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OP: bits<1>;
            param SETFLAGS: bits<1> = 0b1;
            param SH: bits<1> = 0b0;

            operands {
                rd: $rd_cls,
                rn: $rn_cls,
                imm: bits<12>,
            }

            encoding {
                SF,
                OP,
                SETFLAGS,
                0b100010,
                SH,
                imm,
                rn[4..0],
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}, {imm}"
            }
        }
    };
}

tmpl_addsub_imm_flags!(AddSubImmFlags, GPR, GPRsp, sf = 0b1)
tmpl_addsub_imm_flags!(AddSubImmFlagsWord, GPR32, GPR32sp, sf = 0b0)

// Data Processing -- Register (logical shifted register). N inverts the
// shifted operand (`bic`/`orn`/`eon`).
macro tmpl_logical_reg {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIALU]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OPC: bits<2>;
            param N: bits<1> = 0b0;
            param SHIFT: bits<2> = 0b00;

            operands {
                rd: $cls,
                rn: $cls,
                rm: $cls,
            }

            encoding {
                SF,
                OPC,
                0b01010,
                SHIFT,
                N,
                rm[4..0],
                0b000000,
                rn[4..0],
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}, {rm}"
            }
        }
    };
}

tmpl_logical_reg!(LogicalReg, GPR, sf = 0b1)
tmpl_logical_reg!(LogicalRegWord, GPR32, sf = 0b0)

// Data Processing -- 2 source (register shifts)
macro tmpl_shift_reg {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIALU]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OPCODE: bits<6>;

            operands {
                rd: $cls,
                rn: $cls,
                rm: $cls,
            }

            encoding {
                SF,
                0b00,
                0b11010110,
                rm[4..0],
                OPCODE,
                rn[4..0],
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}, {rm}"
            }
        }
    };
}

tmpl_shift_reg!(ShiftReg, GPR, sf = 0b1)
tmpl_shift_reg!(ShiftRegWord, GPR32, sf = 0b0)

// Loads/Stores -- Unsigned immediate addressing. GPR/GPR32 width variants
// share the same encoding shape; only `rt`'s register class changes. The base
// register `rn` is the stack pointer in stack-relative addressing; the
// transferred register `rt` uses the zero register at slot 31.
macro tmpl_loadstore_imm {
    ( $name:ident, $cls:ident ) => {
        template $name for [ARMv8A64] {
            // Default for the family is a load; the store instructions override to WriteStore.
            schedule { units = [WriteLoad]; }
            param MNEMONIC: String;
            param SIZE: bits<2>;
            param OPC: bits<2>;
            param V: bits<1> = 0b0;

            operands {
                rt: $cls,
                rn: GPRsp,
                imm: bits<12>,
            }

            encoding {
                SIZE,
                0b111,
                V,
                0b01,
                OPC,
                imm,
                rn[4..0],
                rt[4..0],
            }

            asm {
                "{self.MNEMONIC} {rt}, [{rn}, {imm}]"
            }
        }
    };
}

tmpl_loadstore_imm!(LoadStoreImmUnsigned, GPR)
tmpl_loadstore_imm!(LoadStoreImmUnsignedWord, GPR32)

// As LoadStoreImmUnsigned, but the byte-offset operand is stored scaled down
// by the access size: the field holds imm[12:1], the low bits must be zero.
macro tmpl_loadstore_immh {
    ( $name:ident, $cls:ident ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteLoad]; }
            param MNEMONIC: String;
            param SIZE: bits<2>;
            param OPC: bits<2>;
            param V: bits<1> = 0b0;

            operands {
                rt: $cls,
                rn: GPRsp,
                #[align(2)] imm: bits<13>,
            }

            encoding {
                SIZE,
                0b111,
                V,
                0b01,
                OPC,
                imm[12..1],
                rn[4..0],
                rt[4..0],
            }

            asm {
                "{self.MNEMONIC} {rt}, [{rn}, {imm}]"
            }
        }
    };
}

tmpl_loadstore_immh!(LoadStoreImmUnsignedH, GPR)
tmpl_loadstore_immh!(LoadStoreImmUnsignedWordH, GPR32)

// As LoadStoreImmUnsigned, but the byte-offset operand is stored scaled down
// by the access size: the field holds imm[13:2], the low bits must be zero.
macro tmpl_loadstore_scaled_word {
    ( $name:ident, $cls:ident ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteLoad]; }
            param MNEMONIC: String;
            param SIZE: bits<2>;
            param OPC: bits<2>;
            param V: bits<1> = 0b0;

            operands {
                rt: $cls,
                rn: GPRsp,
                #[align(4)] imm: bits<14>,
            }

            encoding {
                SIZE,
                0b111,
                V,
                0b01,
                OPC,
                imm[13..2],
                rn[4..0],
                rt[4..0],
            }

            asm {
                "{self.MNEMONIC} {rt}, [{rn}, {imm}]"
            }
        }
    };
}

tmpl_loadstore_scaled_word!(LoadStoreImmUnsignedW, GPR)
tmpl_loadstore_scaled_word!(LoadStoreImmUnsignedWord32, GPR32)

// As LoadStoreImmUnsigned, but the byte-offset operand is stored scaled down
// by the access size: the field holds imm[14:3], the low bits must be zero.
template LoadStoreImmUnsignedD for [ARMv8A64] {
    schedule { units = [WriteLoad]; }
    param MNEMONIC: String;
    param SIZE: bits<2>;
    param OPC: bits<2>;
    param V: bits<1> = 0b0;

    operands {
        rt: GPR,
        rn: GPRsp,
        #[align(8)] imm: bits<15>,
    }

    encoding {
        SIZE,
        0b111,
        V,
        0b01,
        OPC,
        imm[14..3],
        rn[4..0],
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, [{rn}, {imm}]"
    }
}

macro tmpl_loadstore_float_scaled {
    ( $name:ident, $cls:ident, $imm_width:literal, $lo:literal, $hi:literal, align = $align:literal, size = $size:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteLoad]; }
            param MNEMONIC: String;
            param OPC: bits<2>;

            operands {
                ft: $cls,
                rn: GPRsp,
                #[align($align)] imm: bits<$imm_width>,
            }

            encoding {
                $size,
                0b111,
                0b1,
                0b01,
                OPC,
                imm[$hi..$lo],
                rn[4..0],
                ft[4..0],
            }

            asm {
                "{self.MNEMONIC} {ft}, [{rn}, {imm}]"
            }
        }
    };
}

tmpl_loadstore_float_scaled!(LoadStoreFloatImmUnsignedD, FPR64, 15, 3, 14, align = 8, size = 0b11)
tmpl_loadstore_float_scaled!(LoadStoreFloatImmUnsignedS, FPR32, 14, 2, 13, align = 4, size = 0b10)

template BranchImm for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;

    operands {
        imm: bits<26>,
    }

    encoding {
        0b000101,
        imm,
    }

    asm {
        "{self.MNEMONIC} {imm}"
    }
}

template BranchLinkImm for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;

    operands {
        imm: bits<26>,
    }

    encoding {
        0b100101,
        imm,
    }

    asm {
        "{self.MNEMONIC} {imm}"
    }
}

template BranchReg for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param OPCODE: bits<4>;

    operands {
        rn: GPR,
    }

    encoding {
        0b1101011,
        OPCODE,
        0b11111,
        0b000000,
        rn,
        0b00000,
    }

    asm {
        "{self.MNEMONIC} {rn}"
    }
}

template CondBranchImm for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param COND: bits<4>;

    operands {
        imm: bits<19>,
    }

    encoding {
        0b0101010,
        0b0,
        imm,
        0b0,
        COND,
    }

    asm {
        "{self.MNEMONIC} {imm}"
    }
}

// Data Processing -- 3 source (multiply-add family)
macro tmpl_data_proc_3src {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIMul]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OP31: bits<3> = 0b000;
            param O0: bits<1>;

            operands {
                rd: $cls,
                rn: $cls,
                rm: $cls,
                ra: $cls,
            }

            encoding {
                SF,
                0b00,
                0b11011,
                OP31,
                rm[4..0],
                O0,
                ra[4..0],
                rn[4..0],
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}, {rm}, {ra}"
            }
        }
    };
}

tmpl_data_proc_3src!(DataProc3Src, GPR, sf = 0b1)
tmpl_data_proc_3src!(DataProc3SrcWord, GPR32, sf = 0b0)

// As DataProc3Src, but the addend register is hardwired to xzr (the `mul`,
// `mneg`, `smulh` forms).
macro tmpl_data_proc_3src_zr {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIMul]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OP31: bits<3> = 0b000;
            param O0: bits<1>;

            operands {
                rd: $cls,
                rn: $cls,
                rm: $cls,
            }

            encoding {
                SF,
                0b00,
                0b11011,
                OP31,
                rm[4..0],
                O0,
                0b11111,
                rn[4..0],
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}, {rm}"
            }
        }
    };
}

tmpl_data_proc_3src_zr!(DataProc3SrcZr, GPR, sf = 0b1)
tmpl_data_proc_3src_zr!(DataProc3SrcZrWord, GPR32, sf = 0b0)

// Bitfield instructions with fixed immr/imms (`lsr`/`asr` immediate and the
// sign-extend aliases of SBFM/UBFM). The x-form has N = 1.
template BitfieldFixed for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param SF: bits<1> = 0b1;
    param OPC: bits<2>;
    param IMMR: bits<6> = 0b000000;
    param IMMS: bits<6>;

    operands {
        rd: GPR,
        rn: GPR,
    }

    encoding {
        SF,
        OPC,
        0b100110,
        0b1,
        IMMR,
        IMMS,
        rn,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {rn}"
    }
}

// Sign/zero-extend fixed-immediate forms (SBFM/UBFM with a fixed immr/imms).
// `rn` is always a 32-bit source; only `rd`'s class changes with the
// destination width, and bit 22 (N) always mirrors SF for these forms.
macro tmpl_signext_fixed {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIALU]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OPC: bits<2>;
            param IMMR: bits<6> = 0b000000;
            param IMMS: bits<6>;

            operands {
                rd: $cls,
                rn: GPR32,
            }

            encoding {
                SF,
                OPC,
                0b100110,
                $sf,
                IMMR,
                IMMS,
                rn,
                rd[4..0],
            }

            asm {
                "{self.MNEMONIC} {rd}, {rn}"
            }
        }
    };
}

tmpl_signext_fixed!(SignExtendFixed, GPR, sf = 0b1)
tmpl_signext_fixed!(SignExtendFixedWord, GPR32, sf = 0b0)

// `lsr`/`asr` immediate: SBFM/UBFM with immr = shift, imms = 63. (`lsl`
// immediate is not representable: its immr/imms are both derived from the
// shift amount, which the encoding language cannot express.)
template ShiftRightImmTemplate for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param SF: bits<1> = 0b1;
    param OPC: bits<2>;

    operands {
        rd: GPR,
        rn: GPR,
        imm: bits<6>,
    }

    encoding {
        SF,
        OPC,
        0b100110,
        0b1,
        imm,
        0b111111,
        rn,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {rn}, {imm}"
    }
}

template ShiftRightImmWordTemplate for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param SF: bits<1> = 0b0;
    param OPC: bits<2>;

    operands {
        rd: GPR32,
        rn: GPR32,
        imm: bits<5>,
    }

    encoding {
        SF,
        OPC,
        0b100110,
        0b0,
        0b0,
        imm,
        0b0,
        0b11111,
        rn,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {rn}, {imm}"
    }
}

// PC-relative address computation (`adr`/`adrp`). The operand is the 21-bit
// signed offset (in bytes for adr, in 4KiB pages for adrp), stored split as
// immhi:immlo.
template PCRelAddr for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param OP: bits<1>;

    operands {
        rd: GPR,
        imm: bits<21>,
    }

    encoding {
        OP,
        imm[1..0],
        0b10000,
        imm[20..2],
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {imm}"
    }
}

// Conditional select (`csel`). COND holds the A64 condition code; each
// instruction fixes it and spells the condition in its asm string.
template CondSelect for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param SF: bits<1> = 0b1;
    param COND: bits<4>;

    operands {
        rd: GPR,
        rn: GPR,
        rm: GPR,
    }

    encoding {
        SF,
        0b00,
        0b11010100,
        rm,
        COND,
        0b00,
        rn,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {rn}, {rm}"
    }
}

// Conditional set (`cset`): csinc rd, xzr, xzr, invert(cond). COND holds the
// already-inverted condition code, as encoded in hardware.
template CondSet for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param SF: bits<1> = 0b1;
    param COND: bits<4>;

    operands {
        rd: GPR,
    }

    encoding {
        SF,
        0b00,
        0b11010100,
        0b11111,
        COND,
        0b01,
        0b11111,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}"
    }
}

// Compare-and-branch on zero (`cbz`/`cbnz`). As with the other branches, the
// immediate holds the pc-relative word offset (byte delta >> 2).
macro tmpl_compare_branch {
    ( $name:ident, $cls:ident, sf = $sf:literal ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteIALU]; }
            param MNEMONIC: String;
            param SF: bits<1> = $sf;
            param OP: bits<1>;

            operands {
                rt: $cls,
                imm: bits<19>,
            }

            encoding {
                SF,
                0b011010,
                OP,
                imm,
                rt[4..0],
            }

            asm {
                "{self.MNEMONIC} {rt}, {imm}"
            }
        }
    };
}

tmpl_compare_branch!(CompareBranch, GPR, sf = 0b1)
tmpl_compare_branch!(CompareBranchWord, GPR32, sf = 0b0)

// Test-bit-and-branch (`tbz`/`tbnz`). The 6-bit bit number is stored split as
// b5:b40; the immediate holds the pc-relative word offset.
template TestBitBranch for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param OP: bits<1>;

    operands {
        rt: GPR,
        bit: bits<6>,
        imm: bits<14>,
    }

    encoding {
        bit[5],
        0b011011,
        OP,
        bit[4..0],
        imm,
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, {bit}, {imm}"
    }
}

template TestBitBranchWord for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param OP: bits<1>;

    operands {
        rt: GPR32,
        bit: bits<5>,
        imm: bits<14>,
    }

    encoding {
        0b0,
        0b011011,
        OP,
        bit,
        imm,
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, {bit}, {imm}"
    }
}

// Loads/Stores -- unscaled 9-bit signed byte offset (`ldur`/`stur` family).
macro tmpl_loadstore_unscaled {
    ( $name:ident, $cls:ident ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteLoad]; }
            param MNEMONIC: String;
            param SIZE: bits<2>;
            param OPC: bits<2>;
            param V: bits<1> = 0b0;

            operands {
                rt: $cls,
                rn: GPRsp,
                imm: bits<9>,
            }

            encoding {
                SIZE,
                0b111,
                V,
                0b00,
                OPC,
                0b0,
                imm,
                0b00,
                rn[4..0],
                rt[4..0],
            }

            asm {
                "{self.MNEMONIC} {rt}, [{rn}, {imm}]"
            }
        }
    };
}

tmpl_loadstore_unscaled!(LoadStoreUnscaled, GPR)
tmpl_loadstore_unscaled!(LoadStoreUnscaledWord, GPR32)

// Loads/Stores -- register offset (`ldr`/`str Xt, [Xn, Xm{, lsl #s}]`). OPTION
// is fixed to LSL/UXTX (0b011): the index `rm` is a full 64-bit register used
// as the offset, either unscaled (S = 0) or scaled by log2(access size)
// (S = 1). The effective address is formed in each instruction's behavior, so
// this class covers the array-indexed and pointer-chase addressing that
// compiled loops emit but the immediate-offset forms cannot express.
macro tmpl_loadstore_reg_offset {
    ( $name:ident, $cls:ident ) => {
        template $name for [ARMv8A64] {
            schedule { units = [WriteLoad]; }
            param MNEMONIC: String;
            param SIZE: bits<2>;
            param OPC: bits<2>;
            param OPTION: bits<3> = 0b011;
            param S: bits<1>;
            param V: bits<1> = 0b0;

            operands {
                rt: $cls,
                rn: GPRsp,
                rm: GPR,
            }

            encoding {
                SIZE,
                0b111,
                V,
                0b00,
                OPC,
                0b1,
                rm,
                OPTION,
                S,
                0b10,
                rn[4..0],
                rt[4..0],
            }

            asm {
                "{self.MNEMONIC} {rt}, [{rn}, {rm}]"
            }
        }
    };
}

tmpl_loadstore_reg_offset!(LoadStoreRegOffset, GPR)
tmpl_loadstore_reg_offset!(LoadStoreRegOffsetWord, GPR32)

// Loads/Stores -- register pair, signed 7-bit scaled offset (`ldp`/`stp`,
// 64-bit, no writeback). The operand is the byte offset; the field stores it
// scaled down by 8, so only multiples of 8 in [-512, 504] are representable,
// as in hardware.
template LoadStorePair for [ARMv8A64] {
    schedule { units = [WriteLoad]; }
    param MNEMONIC: String;
    param L: bits<1>;
    param V: bits<1> = 0b0;

    operands {
        rt: GPR,
        rt2: GPR,
        rn: GPRsp,
        #[align(8)] imm: bits<10>,
    }

    encoding {
        0b10,
        0b101,
        V,
        0b010,
        L,
        imm[9..3],
        rt2,
        rn[4..0],
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, {rt2}, [{rn}, {imm}]"
    }
}

// Loads/Stores -- register, unscaled 9-bit signed offset with base writeback.
// Post-indexed ([11:10] = 0b01): access at the original `rn`, then rn += imm.
// The offset is byte-granular (not scaled), as in the ldur/stur family.
template LoadStorePostIndex for [ARMv8A64] {
    schedule { units = [WriteLoad]; }
    param MNEMONIC: String;
    param SIZE: bits<2>;
    param OPC: bits<2>;
    param V: bits<1> = 0b0;

    operands {
        rt: GPR,
        rn: GPRsp,
        imm: bits<9>,
    }

    encoding {
        SIZE,
        0b111,
        V,
        0b00,
        OPC,
        0b0,
        imm,
        0b01,
        rn[4..0],
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, [{rn}], {imm}"
    }
}

// Pre-indexed ([11:10] = 0b11): rn += imm first, then access at the new rn.
template LoadStorePreIndex for [ARMv8A64] {
    schedule { units = [WriteLoad]; }
    param MNEMONIC: String;
    param SIZE: bits<2>;
    param OPC: bits<2>;
    param V: bits<1> = 0b0;

    operands {
        rt: GPR,
        rn: GPRsp,
        imm: bits<9>,
    }

    encoding {
        SIZE,
        0b111,
        V,
        0b00,
        OPC,
        0b0,
        imm,
        0b11,
        rn[4..0],
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, [{rn}, {imm}]!"
    }
}

// Loads/Stores -- register pair, signed scaled offset with base writeback.
// INDEX selects the mode: 0b001 post-indexed, 0b011 pre-indexed (0b010 is the
// no-writeback offset form in `LoadStorePair`). Each instruction spells the
// exact addressing in its behavior; rn is updated by the (unscaled) byte offset.
template LoadStorePairWriteback for [ARMv8A64] {
    schedule { units = [WriteLoad]; }
    param MNEMONIC: String;
    param L: bits<1>;
    param INDEX: bits<3>;
    param V: bits<1> = 0b0;

    operands {
        rt: GPR,
        rt2: GPR,
        rn: GPRsp,
        #[align(8)] imm: bits<10>,
    }

    encoding {
        0b10,
        0b101,
        V,
        INDEX,
        L,
        imm[9..3],
        rt2,
        rn[4..0],
        rt,
    }

    asm {
        "{self.MNEMONIC} {rt}, {rt2}, [{rn}], {imm}"
    }
}

// Data Processing -- Register (logical shifted register) with a non-zero shift
// amount. Same class as `LogicalReg` but the 6-bit shift amount is an operand
// and SHIFT selects the shift type; each instruction applies it in behavior.
template LogicalShiftedReg for [ARMv8A64] {
    schedule { units = [WriteIALU]; }
    param MNEMONIC: String;
    param SF: bits<1> = 0b1;
    param OPC: bits<2>;
    param N: bits<1> = 0b0;
    param SHIFT: bits<2>;

    operands {
        rd: GPR,
        rn: GPR,
        rm: GPR,
        imm: bits<6>,
    }

    encoding {
        SF,
        OPC,
        0b01010,
        SHIFT,
        N,
        rm,
        imm,
        rn,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {rn}, {rm}, {imm}"
    }
}
