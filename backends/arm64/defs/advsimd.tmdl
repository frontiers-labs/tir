//! Advanced SIMD (NEON): the V register file viewed through its arrangement
//! specifiers, and the vector data-processing instructions over them.
//!
//! An AArch64 vector operand names both a register and how its bits are cut
//! into lanes (`v0.4s` is v0 read as four 32-bit lanes). The arrangement is
//! part of the assembly syntax, not of the register, so each arrangement is a
//! register class over the shared `VPR` file whose `suffix` carries the
//! specifier. The 64-bit arrangements are the low half of the same registers;
//! writing one zeroes the upper half, which the class's narrower `WIDTH` over
//! the wider file already expresses.
//!
//! Behaviors follow the lane idiom: sources are `split` into lanes of the
//! arrangement's element size, combined with `map`/`zip`, and `concat`enated
//! back, so no carry, shift or rounding crosses a lane boundary.

register_class VPR8B for [AdvSIMD] {
    file = VPR;
    suffix = ".8b";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR16B for [AdvSIMD] {
    file = VPR;
    suffix = ".16b";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR4H for [AdvSIMD] {
    file = VPR;
    suffix = ".4h";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR8H for [AdvSIMD] {
    file = VPR;
    suffix = ".8h";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR2S for [AdvSIMD] {
    file = VPR;
    suffix = ".2s";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR4S for [AdvSIMD] {
    file = VPR;
    suffix = ".4s";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR1D for [AdvSIMD] {
    file = VPR;
    suffix = ".1d";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR2D for [AdvSIMD] {
    file = VPR;
    suffix = ".2d";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

// Halving add and subtract: the exact sum or difference is formed one bit wider
// than the lane and shifted back into it, so the intermediate never overflows.
// The rounding forms add one before the shift. Truncating to `e` bits is what
// makes the shift's sign irrelevant, so a plain `>>` is correct for both
// signednesses.
fn shadd_lane(a, b, e) { extract((sext(a, e + 1) + sext(b, e + 1)) >> 1, e - 1, 0) }
fn uhadd_lane(a, b, e) { extract((zext(a, e + 1) + zext(b, e + 1)) >> 1, e - 1, 0) }
fn srhadd_lane(a, b, e) { extract((sext(a, e + 1) + sext(b, e + 1) + zext(0b1, e + 1)) >> 1, e - 1, 0) }
fn urhadd_lane(a, b, e) { extract((zext(a, e + 1) + zext(b, e + 1) + zext(0b1, e + 1)) >> 1, e - 1, 0) }
fn shsub_lane(a, b, e) { extract((sext(a, e + 1) - sext(b, e + 1)) >> 1, e - 1, 0) }
fn uhsub_lane(a, b, e) { extract((zext(a, e + 1) - zext(b, e + 1)) >> 1, e - 1, 0) }

// Saturation endpoints for a lane, and the endpoint an overflowing result pins
// to. Which endpoint that is follows the sign the exact result would have had,
// which for every case below is the sign of the first operand.
fn lane_max(e) { (zext(0b1, e) << (e - 1)) - zext(0b1, e) }
fn lane_min(e) { zext(0b0, e) - (zext(0b1, e) << (e - 1)) }
fn lane_ones(e) { sext(0b1, e) }
fn sat_endpoint(a, e) { if extract(a, e - 1, e - 1) == zext(0b0, 1) { lane_max(e) } else { lane_min(e) } }

// Signed saturation of a value already computed in `w` bits down to `e`. Only
// the doubling multiplies need this; everything else below detects its own
// overflow inside the lane, because a lane is as wide as constant folding goes.
fn sat_signed(x, w, e) {
    max = (zext(0b1, w) << (e - 1)) - zext(0b1, w);
    min = zext(0b0, w) - (zext(0b1, w) << (e - 1));
    if x > max { extract(max, e - 1, 0) } else if x < min { extract(min, e - 1, 0) } else { extract(x, e - 1, 0) }
}

// Saturating add and subtract, reading overflow off the signs rather than by
// widening: a signed add overflows only when the operands agree in sign and the
// result does not, a signed subtract only when they differ in sign and the
// result disagrees with the first. An unsigned add overflows exactly when the
// sum wraps below an operand, and an unsigned subtract can only underflow, so
// it clamps to zero rather than to the unsigned maximum.
fn sqadd_lane(a, b, e) {
    r = a + b;
    if extract((a ^ r) & (b ^ r), e - 1, e - 1) == zext(0b1, 1) { sat_endpoint(a, e) } else { r }
}
fn sqsub_lane(a, b, e) {
    r = a - b;
    if extract((a ^ b) & (a ^ r), e - 1, e - 1) == zext(0b1, 1) { sat_endpoint(a, e) } else { r }
}
fn uqadd_lane(a, b, e) { r = a + b; if r ~< a { lane_ones(e) } else { r } }
fn uqsub_lane(a, b, e) { if a ~< b { zext(0b0, e) } else { a - b } }

// Three-same shifts take a signed shift amount from the low byte of the second
// source lane: non-negative shifts left, negative shifts right by the negation.
// The amount is read nine bits wide because negating the most negative byte
// (-128) needs the extra bit. Once an amount is known to be below the lane
// width it is narrowed to the lane so the shift operands agree in width.
fn shift_amount(b) { sext(extract(b, 7, 0), 9) }
fn shift_narrow(m, e) { zext(extract(m, 7, 0), e) }

// The primitive shifts, each by an already-positive amount `m`. Shifting at or
// past the lane width clears the lane, except for a signed right shift, where
// saturating the amount at `e - 1` already leaves the sign replicated.
fn shl_lane(a, m, e) { if m ~>= zext(e, 9) { zext(0b0, e) } else { a << shift_narrow(m, e) } }
fn sshr_lane(a, m, e) { if m ~>= zext(e, 9) { a >>> zext(e - 1, e) } else { a >>> shift_narrow(m, e) } }
fn ushr_lane(a, m, e) { if m ~>= zext(e, 9) { zext(0b0, e) } else { a >> shift_narrow(m, e) } }

// Rounding right shift: the shifted lane plus the last bit shifted out. That
// sum cannot leave the lane, because shifting right by at least one has already
// halved the magnitude. Shifting by the whole lane width keeps only the
// rounding bit, which a signed lane never has set but an unsigned one can.
fn round_bit(a, k, e) { zext(extract(a >> (k - zext(0b1, e)), 0, 0), e) }
fn srshr_lane(a, m, e) {
    if m ~>= zext(e, 9) { zext(0b0, e) }
    else { k = shift_narrow(m, e); (a >>> k) + round_bit(a, k, e) }
}
fn urshr_lane(a, m, e) {
    if m ~> zext(e, 9) { zext(0b0, e) }
    else if m == zext(e, 9) { zext(extract(a, e - 1, e - 1), e) }
    else { k = shift_narrow(m, e); (a >> k) + round_bit(a, k, e) }
}

// Saturating left shift: shift, then undo the shift to see whether it was
// lossless. Anything that does not come back unchanged lost a significant bit
// and pins to the endpoint instead.
fn sqshl_left(a, m, e) {
    if m ~>= zext(e, 9) { if a == zext(0b0, e) { zext(0b0, e) } else { sat_endpoint(a, e) } }
    else { k = shift_narrow(m, e); r = a << k; if (r >>> k) == a { r } else { sat_endpoint(a, e) } }
}
fn uqshl_left(a, m, e) {
    if m ~>= zext(e, 9) { if a == zext(0b0, e) { zext(0b0, e) } else { lane_ones(e) } }
    else { k = shift_narrow(m, e); r = a << k; if (r >> k) == a { r } else { lane_ones(e) } }
}


// The three-same shift lanes: pick the direction from the amount's sign, then
// the flavour of shift from the mnemonic. A right shift never saturates, so
// the saturating mnemonics differ from the plain ones only when shifting left.
fn sshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { shl_lane(a, sh, e) } else { sshr_lane(a, zext(0b0, 9) - sh, e) } }
fn ushl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { shl_lane(a, sh, e) } else { ushr_lane(a, zext(0b0, 9) - sh, e) } }
fn srshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { shl_lane(a, sh, e) } else { srshr_lane(a, zext(0b0, 9) - sh, e) } }
fn urshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { shl_lane(a, sh, e) } else { urshr_lane(a, zext(0b0, 9) - sh, e) } }
fn sqshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { sqshl_left(a, sh, e) } else { sshr_lane(a, zext(0b0, 9) - sh, e) } }
fn uqshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { uqshl_left(a, sh, e) } else { ushr_lane(a, zext(0b0, 9) - sh, e) } }
fn sqrshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { sqshl_left(a, sh, e) } else { srshr_lane(a, zext(0b0, 9) - sh, e) } }
fn uqrshl_lane(a, b, e) { sh = shift_amount(b); if sh >= zext(0b0, 9) { uqshl_left(a, sh, e) } else { urshr_lane(a, zext(0b0, 9) - sh, e) } }


// Absolute difference, accumulated by `saba`/`uaba` and produced alone by
// `sabd`/`uabd`. The difference is taken in the wider of the two orders so it
// is never negative, which is why the lane cannot overflow.
fn sabd_lane(a, b, e) { if a > b { a - b } else { b - a } }
fn uabd_lane(a, b, e) { if a ~> b { a - b } else { b - a } }

// Polynomial multiply over GF(2): the xor of the copies of `a` shifted by each
// set bit of `b`, truncated back to the lane. Only the byte arrangements have
// this operation, so the eight terms are written out rather than folded over a
// nested lambda, which cannot see the lane variables of the map it sits in.
fn pmul_lane(a, b) {
    (if extract(b, 0, 0) { a } else { zext(0b0, 8) })
        ^ (if extract(b, 1, 1) { a << 1 } else { zext(0b0, 8) })
        ^ (if extract(b, 2, 2) { a << 2 } else { zext(0b0, 8) })
        ^ (if extract(b, 3, 3) { a << 3 } else { zext(0b0, 8) })
        ^ (if extract(b, 4, 4) { a << 4 } else { zext(0b0, 8) })
        ^ (if extract(b, 5, 5) { a << 5 } else { zext(0b0, 8) })
        ^ (if extract(b, 6, 6) { a << 6 } else { zext(0b0, 8) })
        ^ (if extract(b, 7, 7) { a << 7 } else { zext(0b0, 8) })
}

// Saturating doubling multiply, keeping the high half. Halving both the product
// and the shift keeps the intermediate inside `w`, twice the lane: `2ab >> e` is
// `ab >> (e - 1)`, and the rounding form's half ulp becomes `2^(e-2)`. The
// narrowing saturates exactly once, when both sources are the most negative
// value the lane holds.
fn sqdmulh_lane(a, b, e, w) { sat_signed((sext(a, w) * sext(b, w)) >>> zext(e - 1, w), w, e) }

fn sqrdmulh_lane(a, b, e, w) {
    sat_signed(((sext(a, w) * sext(b, w)) + (zext(0b1, w) << (e - 2))) >>> zext(e - 1, w), w, e)
}

// Float lane helpers. `e` is the lane width and `m` its significand width, both
// literals fixed by the arrangement (32/23 for the `.2s`/`.4s` forms, 64/52 for
// `.2d`), which is what lets the format constants be built arithmetically
// instead of selected at run time.
fn fp_sign_mask(e) { zext(0b1, e) << (e - 1) }
fn fp_mag(a, e) { a & (fp_sign_mask(e) - zext(0b1, e)) }
fn fp_neg(a, e) { a ^ fp_sign_mask(e) }

// Positive infinity is the all-ones exponent with an empty significand, so any
// greater magnitude is a NaN.
fn fp_inf(e, m) { (zext(0b1, e) << (e - 1)) - (zext(0b1, e) << m) }
fn fp_is_nan(a, e, m) { fp_mag(a, e) ~> fp_inf(e, m) }
fn fp_is_inf(a, e, m) { fp_mag(a, e) == fp_inf(e, m) }
fn fp_is_zero(a, e) { fp_mag(a, e) == zext(0b0, e) }

// Quieting sets the significand's leading bit, which leaves an already-quiet
// NaN alone -- exactly what FPProcessNaNs does to the operand it returns.
fn fp_quiet(a, e, m) { a | (zext(0b1, e) << (m - 1)) }

// 2.0, 3.0 and 1.5: the exponent one above the bias, and the bias itself with
// the significand's leading bit set.
fn fp_two(e) { zext(0b1, e) << (e - 2) }
fn fp_three(e, m) { fp_two(e) | (zext(0b1, e) << (m - 1)) }
fn fp_one_point_five(e, m) { (fp_two(e) - (zext(0b1, e) << m)) | (zext(0b1, e) << (m - 1)) }

// A signalling NaN is one whose significand's leading bit is clear.
fn fp_is_snan(a, e, m) { fp_is_nan(a, e, m) & (extract(a, m - 1, m - 1) == zext(0b0, 1)) }
fn fp_either_nan(a, b, e, m) { fp_is_nan(a, e, m) | fp_is_nan(b, e, m) }

// FPProcessNaNs: signalling NaNs are preferred over quiet ones and the earlier
// operand over the later, and the chosen NaN is returned quieted, keeping its
// sign and payload. Plain IEEE arithmetic would return one canonical NaN
// instead, so every float operation below has to select its result explicitly.
fn fp_nan2(a, b, e, m) {
    if fp_is_snan(a, e, m) { fp_quiet(a, e, m) }
    else if fp_is_snan(b, e, m) { fp_quiet(b, e, m) }
    else if fp_is_nan(a, e, m) { a }
    else { b }
}

fn fp_nan3(d, a, b, e, m) {
    if fp_is_snan(d, e, m) { fp_quiet(d, e, m) }
    else if fp_is_snan(a, e, m) { fp_quiet(a, e, m) }
    else if fp_is_snan(b, e, m) { fp_quiet(b, e, m) }
    else if fp_is_nan(d, e, m) { d }
    else if fp_is_nan(a, e, m) { a }
    else { b }
}

// The plain arithmetic, each guarded so a NaN operand propagates.
fn fadd_lane(a, b, e, m) { if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) } else { fadd(a, b) } }
fn fsub_lane(a, b, e, m) { if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) } else { fsub(a, b) } }
fn fmul_lane(a, b, e, m) { if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) } else { fmul(a, b) } }
fn fdiv_lane(a, b, e, m) { if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) } else { fdiv(a, b) } }

// FABD is the absolute value of the difference, so it clears the sign of
// whatever the subtraction produced, a propagated NaN included.
fn fabd_lane(a, b, e, m) { fp_mag(fsub_lane(a, b, e, m), e) }

// FMAXNM/FMINNM treat a lone quiet NaN as the identity, so the other operand
// wins; a signalling NaN, or two NaNs, still go through FPProcessNaNs.
fn fmaxnm_lane(a, b, e, m) {
    if fp_is_snan(a, e, m) | fp_is_snan(b, e, m) { fp_nan2(a, b, e, m) }
    else if fp_is_nan(a, e, m) & fp_is_nan(b, e, m) { fp_nan2(a, b, e, m) }
    else if fp_is_nan(a, e, m) { b }
    else if fp_is_nan(b, e, m) { a }
    else { fmax(a, b) }
}

fn fminnm_lane(a, b, e, m) {
    if fp_is_snan(a, e, m) | fp_is_snan(b, e, m) { fp_nan2(a, b, e, m) }
    else if fp_is_nan(a, e, m) & fp_is_nan(b, e, m) { fp_nan2(a, b, e, m) }
    else if fp_is_nan(a, e, m) { b }
    else if fp_is_nan(b, e, m) { a }
    else { fmin(a, b) }
}

// FPMulAdd, whose NaN order puts the addend -- the destination lane -- first.
fn fmla_lane(d, a, b, e, m) {
    if fp_is_nan(d, e, m) | fp_either_nan(a, b, e, m) { fp_nan3(d, a, b, e, m) }
    else { fma(asfloat(a), asfloat(b), asfloat(d)) }
}
fn fmls_lane(d, a, b, e, m) { fmla_lane(d, fp_neg(a, e), b, e, m) }

// FMAX/FMIN propagate a NaN operand instead of returning the other one, which
// is the only thing separating them from the FMAXNM/FMINNM pair that IEEE
// maximumNumber/minimumNumber already describes.
fn fmax_lane(a, b, e, m) { if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) } else { fmax(a, b) } }
fn fmin_lane(a, b, e, m) { if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) } else { fmin(a, b) } }

// FPMulX: a zero meeting an infinity gives +/-2.0 rather than a NaN, which is
// what makes it safe in the reciprocal step sequences.
fn fmulx_lane(a, b, e, m) {
    if fp_either_nan(a, b, e, m) { fp_nan2(a, b, e, m) }
    else if (fp_is_zero(a, e) & fp_is_inf(b, e, m)) | (fp_is_inf(a, e, m) & fp_is_zero(b, e)) {
        fp_two(e) | ((a ^ b) & fp_sign_mask(e))
    } else { fmul(a, b) }
}

// FPRecipStepFused / FPRSqrtStepFused: `2 - a*b` and `(3 - a*b)/2`, fused. The
// first source is negated before anything else, so a NaN there is propagated
// with its sign already flipped. Zero times infinity is the one case the fused
// product cannot give, and yields the step's fixed point instead.
fn frecps_lane(a, b, e, m) {
    n = fp_neg(a, e);
    if fp_either_nan(n, b, e, m) { fp_nan2(n, b, e, m) }
    else if (fp_is_inf(n, e, m) & fp_is_zero(b, e)) | (fp_is_zero(n, e) & fp_is_inf(b, e, m)) { fp_two(e) }
    else { fma(asfloat(n), asfloat(b), asfloat(fp_two(e))) }
}

fn frsqrts_lane(a, b, e, m) {
    n = fp_neg(a, e);
    if fp_either_nan(n, b, e, m) { fp_nan2(n, b, e, m) }
    else if (fp_is_inf(n, e, m) & fp_is_zero(b, e)) | (fp_is_zero(n, e) & fp_is_inf(b, e, m)) { fp_one_point_five(e, m) }
    else { fdiv(fma(asfloat(n), asfloat(b), asfloat(fp_three(e, m))), asfloat(fp_two(e))) }
}

// The signed and unsigned lane orderings, shared by the plain min/max
// operations and by their pairwise forms.
fn smax_lane(a, b, e) { if a > b { a } else { b } }
fn smin_lane(a, b, e) { if a < b { a } else { b } }
fn umax_lane(a, b, e) { if a ~> b { a } else { b } }
fn umin_lane(a, b, e) { if a ~< b { a } else { b } }

// The two halves of one adjacent lane pair. A pairwise operation splits its
// source at twice the lane width, so each `p` already holds the pair its result
// lane reduces and the two halves come out by static extraction.
fn pair_lo(p, e) { extract(p, e - 1, 0) }
fn pair_hi(p, e, d) { extract(p, d - 1, e) }

// Advanced SIMD three same: `0 Q U 01110 size 1 Rm opcode 1 Rn Rd`. The
// arrangement fixes both the encoded `Q`/`size` pair and the lane shape the
// behavior splits into, so each (operation, arrangement) is its own
// instruction, as one behavior = one instruction requires.
macro advsimd_three_same {
    ( $( ( $name:ident, $mnemonic:literal, $opname:literal, $cls:ident,
           $lanes:literal, $esize:literal, $q:literal, $size:literal,
           $u:literal, $opcode:literal, $sched:ident, $op:tt ) ),* ) => {
        $( instruction $name for [AdvSIMD] {
            param MNEMONIC: String = $mnemonic;
            param OPNAME: String = $opname;
            param Q: bits<1> = $q;
            param U: bits<1> = $u;
            param SIZE: bits<2> = $size;
            param OPCODE: bits<5> = $opcode;
            schedule { units = [$sched]; }

            operands {
                vd: $cls,
                vn: $cls,
                vm: $cls,
            }

            encoding {
                0..4 => vd,
                5..9 => vn,
                10 => 0b1,
                11..15 => OPCODE,
                16..20 => vm,
                21 => 0b1,
                22..23 => SIZE,
                24..28 => 0b01110,
                29 => U,
                30 => Q,
                31 => 0b0,
            }

            asm {
                "{self.MNEMONIC} {vd}, {vn}, {vm}"
            }

            behavior {
                vd = concat(map(zip(split(vn, $lanes, $esize), split(vm, $lanes, $esize)),
                    |a, b| $op));
            }
        } )*
    };
}

// The integer three-same operations, in encoding order of the arrangement
// table. `add`/`sub`/`mul` wrap within the lane; the `cm*` compares set the
// whole lane to ones or zeros; `smax`/`umin`/... pick a lane by signed or
// unsigned order; `sabd`/`uabd` take the absolute difference. There is no `.1d`
// arrangement in this class -- the 64-bit scalar cases are SISD encodings --
// and `mul`, the min/max pair and the absolute differences have no `.2d` form.
// The bitwise operations are byte arrangements only: they encode the operation
// in the `size` field, so the lane width carries no meaning.
advsimd_three_same!(
    (AddVector8B, "add", "add_v8b", VPR8B, 8, 8, 0b0, 0b00, 0b0, 0b10000, WriteIALU, (a + b)),
    (AddVector16B, "add", "add_v16b", VPR16B, 16, 8, 0b1, 0b00, 0b0, 0b10000, WriteIALU, (a + b)),
    (AddVector4H, "add", "add_v4h", VPR4H, 4, 16, 0b0, 0b01, 0b0, 0b10000, WriteIALU, (a + b)),
    (AddVector8H, "add", "add_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b0, 0b10000, WriteIALU, (a + b)),
