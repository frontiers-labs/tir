//! Advanced SIMD (NEON): the V register file viewed through its arrangement
//! specifiers, and the vector data-processing instructions over them.
//!
//! An AArch64 vector operand names both a register and how its bits are cut
//! into lanes (`v0.4s` is v0 read as four 32-bit lanes). The arrangement is
//! part of the assembly syntax, not of the register, so each arrangement is a
//! register class over the shared `VPR` file whose `suffix` carries the
//! specifier. The 64-bit arrangements are the low half of the same registers;
//! writing one zeroes the upper half, which the class's narrower `WIDTH` over
//! the wider file already expresses.
//!
//! Behaviors follow the lane idiom: sources are `split` into lanes of the
//! arrangement's element size, combined with `map`/`zip`, and `concat`enated
//! back, so no carry, shift or rounding crosses a lane boundary.

register_class VPR8B for [AdvSIMD] {
    file = VPR;
    suffix = ".8b";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR16B for [AdvSIMD] {
    file = VPR;
    suffix = ".16b";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR4H for [AdvSIMD] {
    file = VPR;
    suffix = ".4h";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR8H for [AdvSIMD] {
    file = VPR;
    suffix = ".8h";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR2S for [AdvSIMD] {
    file = VPR;
    suffix = ".2s";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 64;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
}

register_class VPR4S for [AdvSIMD] {
    file = VPR;
    suffix = ".4s";
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        v0..v31 => { traits = [polymorphic] },
    }
