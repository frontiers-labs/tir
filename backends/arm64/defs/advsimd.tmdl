    (SQDMulHVector8H, "sqdmulh", "sqdmulh_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b0, 0b10110, WriteIMul, (sqdmulh_lane(a, b, 16, 32))),
    (SQDMulHVector2S, "sqdmulh", "sqdmulh_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b10110, WriteIMul, (sqdmulh_lane(a, b, 32, 64))),
    (SQDMulHVector4S, "sqdmulh", "sqdmulh_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b10110, WriteIMul, (sqdmulh_lane(a, b, 32, 64))),
    (SQRDMulHVector4H, "sqrdmulh", "sqrdmulh_v4h", VPR4H, 4, 16, 0b0, 0b01, 0b1, 0b10110, WriteIMul, (sqrdmulh_lane(a, b, 16, 32))),
    (SQRDMulHVector8H, "sqrdmulh", "sqrdmulh_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b1, 0b10110, WriteIMul, (sqrdmulh_lane(a, b, 16, 32))),
    (SQRDMulHVector2S, "sqrdmulh", "sqrdmulh_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b1, 0b10110, WriteIMul, (sqrdmulh_lane(a, b, 32, 64))),
    (SQRDMulHVector4S, "sqrdmulh", "sqrdmulh_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b1, 0b10110, WriteIMul, (sqrdmulh_lane(a, b, 32, 64))),
    (OrnVector16B, "orn", "orn_v16b", VPR16B, 16, 8, 0b1, 0b11, 0b0, 0b00011, WriteIALU, (a | ~b)),
// The floating-point three-same operations over the single- and
// double-precision arrangements. `fmaxnm`/`fminnm` are IEEE
// maximumNumber/minimumNumber; the `fmax`/`fmin` pair, which propagates NaNs
// instead, is not modeled here. `fabd` and the absolute compares clear the
// sign bit with the all-but-top-bit mask rather than negating.
    (FMaxVector2S, "fmax", "fmax_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11110, WriteIALU, (fmax_lane(a, b, 32, 23))),
    (FMaxVector4S, "fmax", "fmax_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11110, WriteIALU, (fmax_lane(a, b, 32, 23))),
    (FMaxVector2D, "fmax", "fmax_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11110, WriteIALU, (fmax_lane(a, b, 64, 52))),
    (FMinVector2S, "fmin", "fmin_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b11110, WriteIALU, (fmin_lane(a, b, 32, 23))),
    (FMinVector4S, "fmin", "fmin_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b11110, WriteIALU, (fmin_lane(a, b, 32, 23))),
    (FMinVector2D, "fmin", "fmin_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b0, 0b11110, WriteIALU, (fmin_lane(a, b, 64, 52))),
    (FMulXVector2S, "fmulx", "fmulx_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11011, WriteIALU, (fmulx_lane(a, b, 32, 23))),
    (FMulXVector4S, "fmulx", "fmulx_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11011, WriteIALU, (fmulx_lane(a, b, 32, 23))),
    (FMulXVector2D, "fmulx", "fmulx_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11011, WriteIALU, (fmulx_lane(a, b, 64, 52))),
    (FRecpsVector2S, "frecps", "frecps_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11111, WriteIALU, (frecps_lane(a, b, 32, 23))),
    (FRecpsVector4S, "frecps", "frecps_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11111, WriteIALU, (frecps_lane(a, b, 32, 23))),
    (FRecpsVector2D, "frecps", "frecps_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11111, WriteIALU, (frecps_lane(a, b, 64, 52))),
    (FRSqrtsVector2S, "frsqrts", "frsqrts_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b11111, WriteIALU, (frsqrts_lane(a, b, 32, 23))),
    (FRSqrtsVector4S, "frsqrts", "frsqrts_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b11111, WriteIALU, (frsqrts_lane(a, b, 32, 23))),
    (FRSqrtsVector2D, "frsqrts", "frsqrts_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b0, 0b11111, WriteIALU, (frsqrts_lane(a, b, 64, 52))),
    (FAddVector2S, "fadd", "fadd_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11010, WriteIALU, (fadd_lane(a, b, 32, 23))),
    (FAddVector4S, "fadd", "fadd_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11010, WriteIALU, (fadd_lane(a, b, 32, 23))),
    (FAddVector2D, "fadd", "fadd_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11010, WriteIALU, (fadd_lane(a, b, 64, 52))),
    (FSubVector2S, "fsub", "fsub_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b11010, WriteIALU, (fsub_lane(a, b, 32, 23))),
    (FSubVector4S, "fsub", "fsub_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b11010, WriteIALU, (fsub_lane(a, b, 32, 23))),
    (FSubVector2D, "fsub", "fsub_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b0, 0b11010, WriteIALU, (fsub_lane(a, b, 64, 52))),
    (FMulVector2S, "fmul", "fmul_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b1, 0b11011, WriteIALU, (fmul_lane(a, b, 32, 23))),
    (FMulVector4S, "fmul", "fmul_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b1, 0b11011, WriteIALU, (fmul_lane(a, b, 32, 23))),
    (FMulVector2D, "fmul", "fmul_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b1, 0b11011, WriteIALU, (fmul_lane(a, b, 64, 52))),
    (FDivVector2S, "fdiv", "fdiv_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b1, 0b11111, WriteIALU, (fdiv_lane(a, b, 32, 23))),
    (FDivVector4S, "fdiv", "fdiv_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b1, 0b11111, WriteIALU, (fdiv_lane(a, b, 32, 23))),
    (FDivVector2D, "fdiv", "fdiv_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b1, 0b11111, WriteIALU, (fdiv_lane(a, b, 64, 52))),
    (FMaxNmVector2S, "fmaxnm", "fmaxnm_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11000, WriteIALU, (fmaxnm_lane(a, b, 32, 23))),
    (FMaxNmVector4S, "fmaxnm", "fmaxnm_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11000, WriteIALU, (fmaxnm_lane(a, b, 32, 23))),
    (FMaxNmVector2D, "fmaxnm", "fmaxnm_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11000, WriteIALU, (fmaxnm_lane(a, b, 64, 52))),
    (FMinNmVector2S, "fminnm", "fminnm_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b11000, WriteIALU, (fminnm_lane(a, b, 32, 23))),
    (FMinNmVector4S, "fminnm", "fminnm_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b11000, WriteIALU, (fminnm_lane(a, b, 32, 23))),
    (FMinNmVector2D, "fminnm", "fminnm_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b0, 0b11000, WriteIALU, (fminnm_lane(a, b, 64, 52))),
    (FAbdVector2S, "fabd", "fabd_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b1, 0b11010, WriteIALU, (fabd_lane(a, b, 32, 23))),
    (FAbdVector4S, "fabd", "fabd_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b1, 0b11010, WriteIALU, (fabd_lane(a, b, 32, 23))),
    (FAbdVector2D, "fabd", "fabd_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b1, 0b11010, WriteIALU, (fabd_lane(a, b, 64, 52))),
    (FCmEqVector2S, "fcmeq", "fcmeq_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11100, WriteIALU, (if asfloat(a) == asfloat(b) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FCmEqVector4S, "fcmeq", "fcmeq_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11100, WriteIALU, (if asfloat(a) == asfloat(b) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FCmEqVector2D, "fcmeq", "fcmeq_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11100, WriteIALU, (if asfloat(a) == asfloat(b) { zext(0b0, 64) - zext(0b1, 64) } else { zext(0b0, 64) })),
    (FCmGeVector2S, "fcmge", "fcmge_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b1, 0b11100, WriteIALU, (if asfloat(a) >= asfloat(b) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FCmGeVector4S, "fcmge", "fcmge_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b1, 0b11100, WriteIALU, (if asfloat(a) >= asfloat(b) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FCmGeVector2D, "fcmge", "fcmge_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b1, 0b11100, WriteIALU, (if asfloat(a) >= asfloat(b) { zext(0b0, 64) - zext(0b1, 64) } else { zext(0b0, 64) })),
    (FCmGtVector2S, "fcmgt", "fcmgt_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b1, 0b11100, WriteIALU, (if asfloat(a) > asfloat(b) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FCmGtVector4S, "fcmgt", "fcmgt_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b1, 0b11100, WriteIALU, (if asfloat(a) > asfloat(b) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FCmGtVector2D, "fcmgt", "fcmgt_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b1, 0b11100, WriteIALU, (if asfloat(a) > asfloat(b) { zext(0b0, 64) - zext(0b1, 64) } else { zext(0b0, 64) })),
    (FAcGeVector2S, "facge", "facge_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b1, 0b11101, WriteIALU, (if asfloat(a & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) >= asfloat(b & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FAcGeVector4S, "facge", "facge_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b1, 0b11101, WriteIALU, (if asfloat(a & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) >= asfloat(b & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FAcGeVector2D, "facge", "facge_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b1, 0b11101, WriteIALU, (if asfloat(a & ((zext(0b0, 64) - zext(0b1, 64)) >> 1)) >= asfloat(b & ((zext(0b0, 64) - zext(0b1, 64)) >> 1)) { zext(0b0, 64) - zext(0b1, 64) } else { zext(0b0, 64) })),
    (FAcGtVector2S, "facgt", "facgt_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b1, 0b11101, WriteIALU, (if asfloat(a & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) > asfloat(b & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FAcGtVector4S, "facgt", "facgt_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b1, 0b11101, WriteIALU, (if asfloat(a & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) > asfloat(b & ((zext(0b0, 32) - zext(0b1, 32)) >> 1)) { zext(0b0, 32) - zext(0b1, 32) } else { zext(0b0, 32) })),
    (FAcGtVector2D, "facgt", "facgt_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b1, 0b11101, WriteIALU, (if asfloat(a & ((zext(0b0, 64) - zext(0b1, 64)) >> 1)) > asfloat(b & ((zext(0b0, 64) - zext(0b1, 64)) >> 1)) { zext(0b0, 64) - zext(0b1, 64) } else { zext(0b0, 64) }))
)

// The three-same operations that accumulate into the destination. They share
// the encoding of `advsimd_three_same`; only the behavior differs, because the
// destination lane is a source too and so has to be zipped in alongside the two
// register sources.
macro advsimd_three_same_acc {
    ( $( ( $name:ident, $mnemonic:literal, $opname:literal, $cls:ident,
           $lanes:literal, $esize:literal, $q:literal, $size:literal,
           $u:literal, $opcode:literal, $sched:ident, $op:tt ) ),* ) => {
        $( instruction $name for [AdvSIMD] {
            param MNEMONIC: String = $mnemonic;
            param OPNAME: String = $opname;
            param Q: bits<1> = $q;
            param U: bits<1> = $u;
            param SIZE: bits<2> = $size;
            param OPCODE: bits<5> = $opcode;
            schedule { units = [$sched]; }

            operands {
                vd: $cls,
                vn: $cls,
                vm: $cls,
            }

            encoding {
                0..4 => vd,
                5..9 => vn,
                10 => 0b1,
                11..15 => OPCODE,
                16..20 => vm,
                21 => 0b1,
                22..23 => SIZE,
                24..28 => 0b01110,
                29 => U,
                30 => Q,
                31 => 0b0,
            }

            asm {
                "{self.MNEMONIC} {vd}, {vn}, {vm}"
            }

            behavior {
                vd = concat(map(zip(split(vd, $lanes, $esize), split(vn, $lanes, $esize), split(vm, $lanes, $esize)),
                    |d, a, b| $op));
            }
        } )*
    };
}


// Multiply-accumulate and absolute-difference-accumulate, which read the
// destination as their addend.
advsimd_three_same_acc!(
    (MLAVector8B, "mla", "mla_v8b", VPR8B, 8, 8, 0b0, 0b00, 0b0, 0b10010, WriteIMul, (d + a * b)),
    (MLAVector16B, "mla", "mla_v16b", VPR16B, 16, 8, 0b1, 0b00, 0b0, 0b10010, WriteIMul, (d + a * b)),
    (MLAVector4H, "mla", "mla_v4h", VPR4H, 4, 16, 0b0, 0b01, 0b0, 0b10010, WriteIMul, (d + a * b)),
    (MLAVector8H, "mla", "mla_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b0, 0b10010, WriteIMul, (d + a * b)),
    (MLAVector2S, "mla", "mla_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b10010, WriteIMul, (d + a * b)),
    (MLAVector4S, "mla", "mla_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b10010, WriteIMul, (d + a * b)),
    (MLSVector8B, "mls", "mls_v8b", VPR8B, 8, 8, 0b0, 0b00, 0b1, 0b10010, WriteIMul, (d - a * b)),
    (MLSVector16B, "mls", "mls_v16b", VPR16B, 16, 8, 0b1, 0b00, 0b1, 0b10010, WriteIMul, (d - a * b)),
    (MLSVector4H, "mls", "mls_v4h", VPR4H, 4, 16, 0b0, 0b01, 0b1, 0b10010, WriteIMul, (d - a * b)),
    (MLSVector8H, "mls", "mls_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b1, 0b10010, WriteIMul, (d - a * b)),
    (MLSVector2S, "mls", "mls_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b1, 0b10010, WriteIMul, (d - a * b)),
    (MLSVector4S, "mls", "mls_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b1, 0b10010, WriteIMul, (d - a * b)),
    (SAbaVector8B, "saba", "saba_v8b", VPR8B, 8, 8, 0b0, 0b00, 0b0, 0b01111, WriteIALU, (d + sabd_lane(a, b, 8))),
    (SAbaVector16B, "saba", "saba_v16b", VPR16B, 16, 8, 0b1, 0b00, 0b0, 0b01111, WriteIALU, (d + sabd_lane(a, b, 8))),
    (SAbaVector4H, "saba", "saba_v4h", VPR4H, 4, 16, 0b0, 0b01, 0b0, 0b01111, WriteIALU, (d + sabd_lane(a, b, 16))),
    (SAbaVector8H, "saba", "saba_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b0, 0b01111, WriteIALU, (d + sabd_lane(a, b, 16))),
    (SAbaVector2S, "saba", "saba_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b01111, WriteIALU, (d + sabd_lane(a, b, 32))),
    (SAbaVector4S, "saba", "saba_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b01111, WriteIALU, (d + sabd_lane(a, b, 32))),
    (UAbaVector8B, "uaba", "uaba_v8b", VPR8B, 8, 8, 0b0, 0b00, 0b1, 0b01111, WriteIALU, (d + uabd_lane(a, b, 8))),
    (UAbaVector16B, "uaba", "uaba_v16b", VPR16B, 16, 8, 0b1, 0b00, 0b1, 0b01111, WriteIALU, (d + uabd_lane(a, b, 8))),
    (UAbaVector4H, "uaba", "uaba_v4h", VPR4H, 4, 16, 0b0, 0b01, 0b1, 0b01111, WriteIALU, (d + uabd_lane(a, b, 16))),
    (UAbaVector8H, "uaba", "uaba_v8h", VPR8H, 8, 16, 0b1, 0b01, 0b1, 0b01111, WriteIALU, (d + uabd_lane(a, b, 16))),
    (UAbaVector2S, "uaba", "uaba_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b1, 0b01111, WriteIALU, (d + uabd_lane(a, b, 32))),
    (UAbaVector4S, "uaba", "uaba_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b1, 0b01111, WriteIALU, (d + uabd_lane(a, b, 32)))
)


// Bitwise select and insert: `bsl` takes its mask from the destination and its
// data from both sources, while `bit`/`bif` keep the destination as data and
// take the mask from the second source, inverted for `bif`.
advsimd_three_same_acc!(
    (BIFVector8B, "bif", "bif_v8b", VPR8B, 8, 8, 0b0, 0b11, 0b1, 0b00011, WriteIALU, (d ^ ((d ^ a) & ~b))),
    (BIFVector16B, "bif", "bif_v16b", VPR16B, 16, 8, 0b1, 0b11, 0b1, 0b00011, WriteIALU, (d ^ ((d ^ a) & ~b))),
    (BITVector8B, "bit", "bit_v8b", VPR8B, 8, 8, 0b0, 0b10, 0b1, 0b00011, WriteIALU, (d ^ ((d ^ a) & b))),
    (BITVector16B, "bit", "bit_v16b", VPR16B, 16, 8, 0b1, 0b10, 0b1, 0b00011, WriteIALU, (d ^ ((d ^ a) & b))),
    (BSLVector8B, "bsl", "bsl_v8b", VPR8B, 8, 8, 0b0, 0b01, 0b1, 0b00011, WriteIALU, (b ^ ((b ^ a) & d))),
    (BSLVector16B, "bsl", "bsl_v16b", VPR16B, 16, 8, 0b1, 0b01, 0b1, 0b00011, WriteIALU, (b ^ ((b ^ a) & d)))
)


// Fused float multiply-accumulate, which reads the destination as its addend.
advsimd_three_same_acc!(
    (FMlaVector2S, "fmla", "fmla_v2s", VPR2S, 2, 32, 0b0, 0b00, 0b0, 0b11001, WriteIALU, (fmla_lane(d, a, b, 32, 23))),
    (FMlaVector4S, "fmla", "fmla_v4s", VPR4S, 4, 32, 0b1, 0b00, 0b0, 0b11001, WriteIALU, (fmla_lane(d, a, b, 32, 23))),
    (FMlaVector2D, "fmla", "fmla_v2d", VPR2D, 2, 64, 0b1, 0b01, 0b0, 0b11001, WriteIALU, (fmla_lane(d, a, b, 64, 52))),
    (FMlsVector2S, "fmls", "fmls_v2s", VPR2S, 2, 32, 0b0, 0b10, 0b0, 0b11001, WriteIALU, (fmls_lane(d, a, b, 32, 23))),
    (FMlsVector4S, "fmls", "fmls_v4s", VPR4S, 4, 32, 0b1, 0b10, 0b0, 0b11001, WriteIALU, (fmls_lane(d, a, b, 32, 23))),
    (FMlsVector2D, "fmls", "fmls_v2d", VPR2D, 2, 64, 0b1, 0b11, 0b0, 0b11001, WriteIALU, (fmls_lane(d, a, b, 64, 52)))
)

// The pairwise three-same operations. They share the encoding of
// `advsimd_three_same`, but a result lane reduces a pair of adjacent source
// lanes rather than one lane from each source: `vn` supplies the low half of
// the result and `vm` the high half. Splitting each source at twice the lane
// width hands the behavior whole pairs, so no index arithmetic is needed and
// every intermediate stays inside one register.
macro advsimd_three_same_pair {
    ( $( ( $name:ident, $mnemonic:literal, $opname:literal, $cls:ident,
           $pairs:literal, $esize:literal, $paired:literal,
           $q:literal, $size:literal, $u:literal, $opcode:literal,
           $sched:ident, $op:tt ) ),* ) => {
        $( instruction $name for [AdvSIMD] {
            param MNEMONIC: String = $mnemonic;
            param OPNAME: String = $opname;
            param Q: bits<1> = $q;
            param U: bits<1> = $u;
            param SIZE: bits<2> = $size;
            param OPCODE: bits<5> = $opcode;
            schedule { units = [$sched]; }

            operands {
                vd: $cls,
                vn: $cls,
                vm: $cls,
            }

            encoding {
                0..4 => vd,
                5..9 => vn,
                10 => 0b1,
                11..15 => OPCODE,
                16..20 => vm,
                21 => 0b1,
                22..23 => SIZE,
                24..28 => 0b01110,
                29 => U,
                30 => Q,
                31 => 0b0,
            }

            asm {
                "{self.MNEMONIC} {vd}, {vn}, {vm}"
            }

            behavior {
                vd = concat(map(split(vn, $pairs, $paired), |p| $op),
                            map(split(vm, $pairs, $paired), |p| $op));
            }
        } )*
    };
}

// The pairwise operations, integer then float.
advsimd_three_same_pair!(
    (AddPVector8B, "addp", "addp_v8b", VPR8B, 4, 8, 16, 0b0, 0b00, 0b0, 0b10111, WriteIALU, (pair_lo(p, 8) + pair_hi(p, 8, 16))),
    (AddPVector16B, "addp", "addp_v16b", VPR16B, 8, 8, 16, 0b1, 0b00, 0b0, 0b10111, WriteIALU, (pair_lo(p, 8) + pair_hi(p, 8, 16))),
    (AddPVector4H, "addp", "addp_v4h", VPR4H, 2, 16, 32, 0b0, 0b01, 0b0, 0b10111, WriteIALU, (pair_lo(p, 16) + pair_hi(p, 16, 32))),
    (AddPVector8H, "addp", "addp_v8h", VPR8H, 4, 16, 32, 0b1, 0b01, 0b0, 0b10111, WriteIALU, (pair_lo(p, 16) + pair_hi(p, 16, 32))),
    (AddPVector2S, "addp", "addp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b0, 0b10111, WriteIALU, (pair_lo(p, 32) + pair_hi(p, 32, 64))),
    (AddPVector4S, "addp", "addp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b0, 0b10111, WriteIALU, (pair_lo(p, 32) + pair_hi(p, 32, 64))),
    (FAddPVector2S, "faddp", "faddp_v2s", VPR2S, 1, 32, 64, 0b0, 0b00, 0b1, 0b11010, WriteIALU, (fadd_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FAddPVector4S, "faddp", "faddp_v4s", VPR4S, 2, 32, 64, 0b1, 0b00, 0b1, 0b11010, WriteIALU, (fadd_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMaxNmPVector2S, "fmaxnmp", "fmaxnmp_v2s", VPR2S, 1, 32, 64, 0b0, 0b00, 0b1, 0b11000, WriteIALU, (fmaxnm_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMaxNmPVector4S, "fmaxnmp", "fmaxnmp_v4s", VPR4S, 2, 32, 64, 0b1, 0b00, 0b1, 0b11000, WriteIALU, (fmaxnm_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMaxPVector2S, "fmaxp", "fmaxp_v2s", VPR2S, 1, 32, 64, 0b0, 0b00, 0b1, 0b11110, WriteIALU, (fmax_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMaxPVector4S, "fmaxp", "fmaxp_v4s", VPR4S, 2, 32, 64, 0b1, 0b00, 0b1, 0b11110, WriteIALU, (fmax_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMinNmPVector2S, "fminnmp", "fminnmp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b1, 0b11000, WriteIALU, (fminnm_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMinNmPVector4S, "fminnmp", "fminnmp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b1, 0b11000, WriteIALU, (fminnm_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMinPVector2S, "fminp", "fminp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b1, 0b11110, WriteIALU, (fmin_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (FMinPVector4S, "fminp", "fminp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b1, 0b11110, WriteIALU, (fmin_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32, 23))),
    (SMaxPVector8B, "smaxp", "smaxp_v8b", VPR8B, 4, 8, 16, 0b0, 0b00, 0b0, 0b10100, WriteIALU, (smax_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (SMaxPVector16B, "smaxp", "smaxp_v16b", VPR16B, 8, 8, 16, 0b1, 0b00, 0b0, 0b10100, WriteIALU, (smax_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (SMaxPVector4H, "smaxp", "smaxp_v4h", VPR4H, 2, 16, 32, 0b0, 0b01, 0b0, 0b10100, WriteIALU, (smax_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (SMaxPVector8H, "smaxp", "smaxp_v8h", VPR8H, 4, 16, 32, 0b1, 0b01, 0b0, 0b10100, WriteIALU, (smax_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (SMaxPVector2S, "smaxp", "smaxp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b0, 0b10100, WriteIALU, (smax_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (SMaxPVector4S, "smaxp", "smaxp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b0, 0b10100, WriteIALU, (smax_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (SMinPVector8B, "sminp", "sminp_v8b", VPR8B, 4, 8, 16, 0b0, 0b00, 0b0, 0b10101, WriteIALU, (smin_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (SMinPVector16B, "sminp", "sminp_v16b", VPR16B, 8, 8, 16, 0b1, 0b00, 0b0, 0b10101, WriteIALU, (smin_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (SMinPVector4H, "sminp", "sminp_v4h", VPR4H, 2, 16, 32, 0b0, 0b01, 0b0, 0b10101, WriteIALU, (smin_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (SMinPVector8H, "sminp", "sminp_v8h", VPR8H, 4, 16, 32, 0b1, 0b01, 0b0, 0b10101, WriteIALU, (smin_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (SMinPVector2S, "sminp", "sminp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b0, 0b10101, WriteIALU, (smin_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (SMinPVector4S, "sminp", "sminp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b0, 0b10101, WriteIALU, (smin_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (UMaxPVector8B, "umaxp", "umaxp_v8b", VPR8B, 4, 8, 16, 0b0, 0b00, 0b1, 0b10100, WriteIALU, (umax_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (UMaxPVector16B, "umaxp", "umaxp_v16b", VPR16B, 8, 8, 16, 0b1, 0b00, 0b1, 0b10100, WriteIALU, (umax_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (UMaxPVector4H, "umaxp", "umaxp_v4h", VPR4H, 2, 16, 32, 0b0, 0b01, 0b1, 0b10100, WriteIALU, (umax_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (UMaxPVector8H, "umaxp", "umaxp_v8h", VPR8H, 4, 16, 32, 0b1, 0b01, 0b1, 0b10100, WriteIALU, (umax_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (UMaxPVector2S, "umaxp", "umaxp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b1, 0b10100, WriteIALU, (umax_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (UMaxPVector4S, "umaxp", "umaxp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b1, 0b10100, WriteIALU, (umax_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (UMinPVector8B, "uminp", "uminp_v8b", VPR8B, 4, 8, 16, 0b0, 0b00, 0b1, 0b10101, WriteIALU, (umin_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (UMinPVector16B, "uminp", "uminp_v16b", VPR16B, 8, 8, 16, 0b1, 0b00, 0b1, 0b10101, WriteIALU, (umin_lane(pair_lo(p, 8), pair_hi(p, 8, 16), 8))),
    (UMinPVector4H, "uminp", "uminp_v4h", VPR4H, 2, 16, 32, 0b0, 0b01, 0b1, 0b10101, WriteIALU, (umin_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (UMinPVector8H, "uminp", "uminp_v8h", VPR8H, 4, 16, 32, 0b1, 0b01, 0b1, 0b10101, WriteIALU, (umin_lane(pair_lo(p, 16), pair_hi(p, 16, 32), 16))),
    (UMinPVector2S, "uminp", "uminp_v2s", VPR2S, 1, 32, 64, 0b0, 0b10, 0b1, 0b10101, WriteIALU, (umin_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32))),
    (UMinPVector4S, "uminp", "uminp_v4s", VPR4S, 2, 32, 64, 0b1, 0b10, 0b1, 0b10101, WriteIALU, (umin_lane(pair_lo(p, 32), pair_hi(p, 32, 64), 32)))
)

// The `.2d` pairwise forms, whose pair spans the whole register: splitting at
// twice the lane would ask for a 128-bit lane, wider than a constant can be, so
// each source is reduced over its two elements and the two results, each put
// back into a one-lane iterator, are concatenated instead.
macro advsimd_three_same_pair_wide {
    ( $( ( $name:ident, $mnemonic:literal, $opname:literal, $q:literal,
           $size:literal, $u:literal, $opcode:literal, $op:tt ) ),* ) => {
        $( instruction $name for [AdvSIMD] {
            param MNEMONIC: String = $mnemonic;
            param OPNAME: String = $opname;
            param Q: bits<1> = $q;
            param U: bits<1> = $u;
            param SIZE: bits<2> = $size;
            param OPCODE: bits<5> = $opcode;
            schedule { units = [WriteIALU]; }

            operands {
                vd: VPR2D,
                vn: VPR2D,
                vm: VPR2D,
            }

            encoding {
                0..4 => vd,
                5..9 => vn,
                10 => 0b1,
                11..15 => OPCODE,
                16..20 => vm,
                21 => 0b1,
                22..23 => SIZE,
                24..28 => 0b01110,
                29 => U,
                30 => Q,
                31 => 0b0,
            }

            asm {
                "{self.MNEMONIC} {vd}, {vn}, {vm}"
            }

            behavior {
                vd = concat(split(reduce(split(vn, 2, 64), |x, y| $op), 1, 64),
                            split(reduce(split(vm, 2, 64), |x, y| $op), 1, 64));
            }
        } )*
    };
}

advsimd_three_same_pair_wide!(
    (AddPVector2D, "addp", "addp_v2d", 0b1, 0b11, 0b0, 0b10111, (x + y)),
    (FAddPVector2D, "faddp", "faddp_v2d", 0b1, 0b01, 0b1, 0b11010, (fadd_lane(x, y, 64, 52))),
    (FMaxPVector2D, "fmaxp", "fmaxp_v2d", 0b1, 0b01, 0b1, 0b11110, (fmax_lane(x, y, 64, 52))),
    (FMinPVector2D, "fminp", "fminp_v2d", 0b1, 0b11, 0b1, 0b11110, (fmin_lane(x, y, 64, 52))),
    (FMaxNmPVector2D, "fmaxnmp", "fmaxnmp_v2d", 0b1, 0b01, 0b1, 0b11000, (fmaxnm_lane(x, y, 64, 52))),
    (FMinNmPVector2D, "fminnmp", "fminnmp_v2d", 0b1, 0b11, 0b1, 0b11000, (fminnm_lane(x, y, 64, 52)))
)

// The 128-bit view of the SIMD&FP file used by whole-register loads and
// stores, which name a register without an arrangement (`ldr q0, [x1]`).
register_class QPR for [AdvSIMD] {
    file = VPR;
    param ENCODING_LEN: Integer = 5;
    param WIDTH: Integer = 128;

    registers {
        q0..q31 => { traits = [polymorphic] },
    }
}

// DUP (general): `0 Q 001110000 imm5 000011 Rn Rd`. The `imm5` field selects
// the element size (00001 = B, 00010 = H, 00100 = S, 01000 = D), which the
// arrangement already fixes. `iota` supplies the lane count; every lane takes
// the same low bits of the source register.
macro advsimd_dup_general {
    ( $( ( $name:ident, $opname:literal, $cls:ident, $gpr:ident,
           $lanes:literal, $esize:literal, $q:literal, $imm5:literal ) ),* ) => {
        $( instruction $name for [AdvSIMD] {
            param MNEMONIC: String = "dup";
            param OPNAME: String = $opname;
            param Q: bits<1> = $q;
            param IMM5: bits<5> = $imm5;
            schedule { units = [WriteIALU]; }

            operands {
                vd: $cls,
                rn: $gpr,
            }

            encoding {
                0..4 => vd,
                5..9 => rn,
                10..15 => 0b000011,
                16..20 => IMM5,
                21..28 => 0b01110000,
                29 => 0b0,
                30 => Q,
                31 => 0b0,
            }

            asm {
                "{self.MNEMONIC} {vd}, {rn}"
            }

            behavior {
                vd = concat(map(iota($lanes, $esize), |i| extract(rn, $esize - 1, 0)));
            }
        } )*
    };
}

advsimd_dup_general!(
    (DupGeneral8B, "dup_v8b", VPR8B, GPR32, 8, 8, 0b0, 0b00001),
    (DupGeneral16B, "dup_v16b", VPR16B, GPR32, 16, 8, 0b1, 0b00001),
    (DupGeneral4H, "dup_v4h", VPR4H, GPR32, 4, 16, 0b0, 0b00010),
    (DupGeneral8H, "dup_v8h", VPR8H, GPR32, 8, 16, 0b1, 0b00010),
    (DupGeneral2S, "dup_v2s", VPR2S, GPR32, 2, 32, 0b0, 0b00100),
    (DupGeneral4S, "dup_v4s", VPR4S, GPR32, 4, 32, 0b1, 0b00100),
    (DupGeneral2D, "dup_v2d", VPR2D, GPR, 2, 64, 0b1, 0b01000)
)

// Modified immediate: `0 Q op 0111100000 abc cmode 01 defgh Rd`, where the
// 8-bit immediate is split as `abc` = imm[7:5] and `defgh` = imm[4:0]. `cmode`
// selects how the byte is expanded into a lane: 1110 replicates it per byte,
// 0000 and 1000 zero-extend it into 32- and 16-bit lanes, and `op` inverts the
// result for `mvni`.
macro advsimd_modified_immediate {
    ( $( ( $name:ident, $mnemonic:literal, $opname:literal, $cls:ident,
           $lanes:literal, $esize:literal, $q:literal, $op:literal,
           $cmode:literal, $expand:tt ) ),* ) => {
        $( instruction $name for [AdvSIMD] {
            param MNEMONIC: String = $mnemonic;
            param OPNAME: String = $opname;
            param Q: bits<1> = $q;
            param OP: bits<1> = $op;
            param CMODE: bits<4> = $cmode;
            schedule { units = [WriteIALU]; }

            operands {
                vd: $cls,
                imm: bits<8>,
            }

            encoding {
                0..4 => vd,
                5..9 => imm[0..4],
                10..11 => 0b01,
                12..15 => CMODE,
                16..18 => imm[5..7],
                19..23 => 0b00000,
                24..28 => 0b01111,
                29 => OP,
                30 => Q,
                31 => 0b0,
            }

            asm {
                "{self.MNEMONIC} {vd}, {imm}"
            }

            behavior {
                vd = concat(map(iota($lanes, $esize), |i| $expand));
            }
        } )*
    };
}

advsimd_modified_immediate!(
    (MoveImmediate8B, "movi", "movi_v8b", VPR8B, 8, 8, 0b0, 0b0, 0b1110, (imm)),
    (MoveImmediate16B, "movi", "movi_v16b", VPR16B, 16, 8, 0b1, 0b0, 0b1110, (imm)),
    (MoveImmediate4H, "movi", "movi_v4h", VPR4H, 4, 16, 0b0, 0b0, 0b1000, (zext(imm, 16))),
    (MoveImmediate8H, "movi", "movi_v8h", VPR8H, 8, 16, 0b1, 0b0, 0b1000, (zext(imm, 16))),
    (MoveImmediate2S, "movi", "movi_v2s", VPR2S, 2, 32, 0b0, 0b0, 0b0000, (zext(imm, 32))),
    (MoveImmediate4S, "movi", "movi_v4s", VPR4S, 4, 32, 0b1, 0b0, 0b0000, (zext(imm, 32))),
    (MoveInverseImmediate4H, "mvni", "mvni_v4h", VPR4H, 4, 16, 0b0, 0b1, 0b1000, (~zext(imm, 16))),
    (MoveInverseImmediate8H, "mvni", "mvni_v8h", VPR8H, 8, 16, 0b1, 0b1, 0b1000, (~zext(imm, 16))),
    (MoveInverseImmediate2S, "mvni", "mvni_v2s", VPR2S, 2, 32, 0b0, 0b1, 0b0000, (~zext(imm, 32))),
    (MoveInverseImmediate4S, "mvni", "mvni_v4s", VPR4S, 4, 32, 0b1, 0b1, 0b0000, (~zext(imm, 32))),
    // FMOV (vector, immediate) is `cmode = 1111`, where the byte is not a lane
    // pattern but VFPExpandImm's `abcdefgh`: `a` is the sign, `b` and its
    // complement build the exponent, and `cdefgh` its leading significand bits.
    (FMoveImmediate2D, "fmov", "fmov_v2d", VPR2D, 2, 64, 0b1, 0b1, 0b1111,
        ((zext(extract(imm, 7, 7), 64) << 63)
            | ((zext(0b1, 64) - zext(extract(imm, 6, 6), 64)) << 62)
            | (((zext(0b0, 64) - zext(extract(imm, 6, 6), 64)) & zext(0b11111111, 64)) << 54)
            | (zext(extract(imm, 5, 4), 64) << 52)
            | (zext(extract(imm, 3, 0), 64) << 48)))
)
