// Convert binary64 to an unsigned 64-bit integer, truncating toward zero.
instruction FCvtzuDouble for [FP] {
    param MNEMONIC: String = "fcvtzu";
    param OPNAME: String = "fcvtzu_x_d";
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR,
        fa: FPR64,
    }

    encoding {
        0b1,
        0b00,
        0b11110,
        0b011,
        0b11,
        0b001,
        0b000000,
        fa,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {fa}"
    }

    behavior {
        rd = fptoui(fa, self.XLEN);
    }
}

instruction FMoveRegisterDouble for [FP] {
    param MNEMONIC: String = "fmov";
    param OPNAME: String = "fmov_reg64";
    schedule { units = [WriteIALU]; }

    operands {
        fd: FPR64,
        fa: FPR64,
    }

    encoding {
        0b000,
        0b11110,
        0b01,
        0b1,
        0b000000,
        0b10000,
        fa,
        fd,
    }

    asm {
        "{self.MNEMONIC} {fd}, {fa}"
    }

    behavior {
        fd = fa;
    }
}

instruction FMoveRegisterSingle for [FP] {
