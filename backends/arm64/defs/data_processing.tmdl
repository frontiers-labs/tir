macro instr_fcmp {
    ( $name:ident, $cls:ident, $opname:literal, ptype = $ptype:literal ) => {
        instruction $name for [FP] {
            param MNEMONIC: String = "fcmp";
            param OPNAME: String = $opname;

            operands {
                fa: $cls,
                fb: $cls,
            }

            encoding {
                0b000,
                0b11110,
                $ptype,
                0b1,
                fb[4..0],
                0b001000,
                fa[4..0],
                0b00000,
            }

            asm {
                "{self.MNEMONIC} {fa}, {fb}"
            }

            behavior {
                PSTATE::n = if fa < fb {
                    zext(0b1, 1)
                } else {
                    zext(0b0, 1)
                };
                PSTATE::z = if fa == fb {
                    zext(0b1, 1)
                } else {
                    zext(0b0, 1)
                };
                PSTATE::c = if (fa != fa) | (fb != fb) {
                    zext(0b1, 1)
                } else if fa < fb {
                    zext(0b0, 1)
                } else {
                    zext(0b1, 1)
                };
                PSTATE::v = if (fa != fa) | (fb != fb) {
                    zext(0b1, 1)
                } else {
                    zext(0b0, 1)
                };
            }
        }
    };
}

instr_fcmp!(FCmpDouble, FPR64, "fcmp_d", ptype = 0b01)
instr_fcmp!(FCmpSingle, FPR32, "fcmp_s", ptype = 0b00)

// Convert the low signed 32-bit integer in a general register to binary64.
instruction SCvtfDoubleWord for [FP] {
    param MNEMONIC: String = "scvtf";
    param OPNAME: String = "scvtf_d_w";
    schedule { units = [WriteIALU]; }

    operands {
        fd: FPR64,
        rn: GPR,
    }

    encoding {
        0b000,
        0b11110,
        0b01,
        0b1,
        0b00,
        0b010,
        0b000000,
        rn,
        fd,
    }

    asm {
        "{self.MNEMONIC} {fd}, {rn}"
    }

    behavior {
        fd = sitofp(sext(extract(rn, 31, 0), self.XLEN), 11, 52);
    }
}

