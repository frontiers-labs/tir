instruction LogicalShiftRightImmHalfword for [ARMv8A64] {
    param MNEMONIC: String = "ubfm";
    param OPNAME: String = "lsr_h";
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR32,
        rn: GPR32,
        imm: bits<4>,
