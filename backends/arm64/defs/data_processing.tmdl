//! Integer and floating-point data-processing instructions.

// ARMv8-A A64 data processing instructions (RV base semantic parity set)

instruction Add for [ARMv8A64] : AddSubReg {
    param MNEMONIC: String = "add";
    param OP: bits<1> = 0b0;

    behavior {
        rd = rn + rm;
    }
}

instruction Sub for [ARMv8A64] : AddSubReg {
    param MNEMONIC: String = "sub";
    param OP: bits<1> = 0b1;

    behavior {
        rd = rn - rm;
    }
}

instruction AddWord for [ARMv8A64] : AddSubRegWord {
    param MNEMONIC: String = "add";
    param OPNAME: String = "add_w";
    param OP: bits<1> = 0b0;

    behavior {
        rd = rn + rm;
    }
}

instruction SubWord for [ARMv8A64] : AddSubRegWord {
    param MNEMONIC: String = "sub";
    param OPNAME: String = "sub_w";
    param OP: bits<1> = 0b1;

    behavior {
        rd = rn - rm;
    }
}

instruction AddImmediate for [ARMv8A64] : AddSubImm {
    param MNEMONIC: String = "add";
    param OPNAME: String = "add_imm";
    param OP: bits<1> = 0b0;

    behavior {
        rd = rn + zext(imm, self.XLEN);
    }
}

instruction SubImmediate for [ARMv8A64] : AddSubImm {
    param MNEMONIC: String = "sub";
    param OPNAME: String = "sub_imm";
    param OP: bits<1> = 0b1;

    behavior {
        rd = rn - zext(imm, self.XLEN);
    }
}

instruction AddImmediateWord for [ARMv8A64] : AddSubImmWord {
    param MNEMONIC: String = "add";
    param OPNAME: String = "add_imm_w";
    param OP: bits<1> = 0b0;

    behavior {
        rd = rn + zext(imm, 32);
    }
}

instruction SubImmediateWord for [ARMv8A64] : AddSubImmWord {
    param MNEMONIC: String = "sub";
    param OPNAME: String = "sub_imm_w";
    param OP: bits<1> = 0b1;

    behavior {
        rd = rn - zext(imm, 32);
    }
}

instruction And for [ARMv8A64] : LogicalReg {
    param MNEMONIC: String = "and";
    param OPC: bits<2> = 0b00;

    behavior {
        rd = rn & rm;
    }
}

instruction Or for [ARMv8A64] : LogicalReg {
    param MNEMONIC: String = "orr";
    param OPC: bits<2> = 0b01;

    behavior {
        rd = rn | rm;
    }
}

instruction Xor for [ARMv8A64] : LogicalReg {
    param MNEMONIC: String = "eor";
    param OPC: bits<2> = 0b10;

    behavior {
        rd = rn ^ rm;
    }
}

instruction AndWord for [ARMv8A64] : LogicalRegWord {
    param MNEMONIC: String = "and";
    param OPNAME: String = "and_w";
    param OPC: bits<2> = 0b00;

    behavior {
        rd = rn & rm;
    }
}

instruction OrWord for [ARMv8A64] : LogicalRegWord {
    param MNEMONIC: String = "orr";
    param OPNAME: String = "orr_w";
    param OPC: bits<2> = 0b01;

    behavior {
        rd = rn | rm;
    }
}

instruction XorWord for [ARMv8A64] : LogicalRegWord {
    param MNEMONIC: String = "eor";
    param OPNAME: String = "eor_w";
    param OPC: bits<2> = 0b10;

    behavior {
        rd = rn ^ rm;
    }
}

instruction LogicalShiftLeftVariable for [ARMv8A64] : ShiftReg {
    param MNEMONIC: String = "lslv";
    param OPCODE: bits<6> = 0b001000;

    behavior {
        rd = rn << extract(rm, log2Ceil(self.XLEN) - 1, 0);
    }
}

instruction LogicalShiftLeftVariableWord for [ARMv8A64] : ShiftRegWord {
    param MNEMONIC: String = "lslv";
    param OPNAME: String = "lslv_w";
    param OPCODE: bits<6> = 0b001000;

    behavior {
        rd = rn << extract(rm, 4, 0);
    }
}

instruction LogicalShiftRightVariable for [ARMv8A64] : ShiftReg {
    param MNEMONIC: String = "lsrv";
    param OPCODE: bits<6> = 0b001001;

    behavior {
        rd = rn >> extract(rm, log2Ceil(self.XLEN) - 1, 0);
    }
}

instruction LogicalShiftRightVariableWord for [ARMv8A64] : ShiftRegWord {
    param MNEMONIC: String = "lsrv";
    param OPNAME: String = "lsrv_w";
    param OPCODE: bits<6> = 0b001001;

    behavior {
        rd = rn >> extract(rm, 4, 0);
    }
}

instruction ArithmeticShiftRightVariable for [ARMv8A64] : ShiftReg {
    param MNEMONIC: String = "asrv";
    param OPCODE: bits<6> = 0b001010;

    behavior {
        rd = rn >>> extract(rm, log2Ceil(self.XLEN) - 1, 0);
    }
}

instruction ArithmeticShiftRightVariableWord for [ARMv8A64] : ShiftRegWord {
    param MNEMONIC: String = "asrv";
    param OPNAME: String = "asrv_w";
    param OPCODE: bits<6> = 0b001010;

    behavior {
        rd = rn >>> extract(rm, 4, 0);
    }
}

instruction Compare for [ARMv8A64] : CmpRegTemplate {
    param MNEMONIC: String = "cmp";

    behavior {
        PSTATE::n = extract(rn - rm, self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if rn == rm {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn ~>= rm {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        // Signed overflow of rn - rm: operands differ in sign and the result's
        // sign differs from rn's.
        PSTATE::v = extract((rn ^ rm) & (rn ^ (rn - rm)), self.XLEN - 1, self.XLEN - 1);
    }
}

instruction CompareWord for [ARMv8A64] : CmpRegTemplateWord {
    param MNEMONIC: String = "cmp";
    param OPNAME: String = "cmp_w";

    behavior {
        PSTATE::n = extract(rn - rm, 31, 31);
        PSTATE::z = if rn == rm {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn ~>= rm {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        // Signed overflow of rn - rm: operands differ in sign and the result's
        // sign differs from rn's.
        PSTATE::v = extract((rn ^ rm) & (rn ^ (rn - rm)), 31, 31);
    }
}

instruction MoveWideZero for [ARMv8A64] {
    param MNEMONIC: String = "movz";
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR,
        imm: bits<16>,
    }

    // MOVZ with hw = 0 (no shift); wider constants need movk support.
    encoding {
        0b1,
        0b10,
        0b100101,
        0b00,
        imm,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {imm}"
    }

    behavior {
        rd = zext(imm, self.XLEN);
    }
}

instruction Bic for [ARMv8A64] : LogicalReg {
    param MNEMONIC: String = "bic";
    param OPC: bits<2> = 0b00;
    param N: bits<1> = 0b1;

    behavior {
        rd = rn & ~rm;
    }
}

instruction Orn for [ARMv8A64] : LogicalReg {
    param MNEMONIC: String = "orn";
    param OPC: bits<2> = 0b01;
    param N: bits<1> = 0b1;

    behavior {
        rd = rn | ~rm;
    }
}

instruction Eon for [ARMv8A64] : LogicalReg {
    param MNEMONIC: String = "eon";
    param OPC: bits<2> = 0b10;
    param N: bits<1> = 0b1;

    behavior {
        rd = rn ^ ~rm;
    }
}

instruction BicWord for [ARMv8A64] : LogicalRegWord {
    param MNEMONIC: String = "bic";
    param OPNAME: String = "bic_w";
    param OPC: bits<2> = 0b00;
    param N: bits<1> = 0b1;

    behavior {
        rd = rn & ~rm;
    }
}

instruction OrnWord for [ARMv8A64] : LogicalRegWord {
    param MNEMONIC: String = "orn";
    param OPNAME: String = "orn_w";
    param OPC: bits<2> = 0b01;
    param N: bits<1> = 0b1;

    behavior {
        rd = rn | ~rm;
    }
}

instruction EonWord for [ARMv8A64] : LogicalRegWord {
    param MNEMONIC: String = "eon";
    param OPNAME: String = "eon_w";
    param OPC: bits<2> = 0b10;
    param N: bits<1> = 0b1;

    behavior {
        rd = rn ^ ~rm;
    }
}

instruction RotateRightVariable for [ARMv8A64] : ShiftReg {
    param MNEMONIC: String = "rorv";
    param OPCODE: bits<6> = 0b001011;

    behavior {
        rd = (rn >> extract(rm, log2Ceil(self.XLEN) - 1, 0))
            | (rn << ((zext(0b0, self.XLEN) - zext(extract(rm, log2Ceil(self.XLEN) - 1, 0), self.XLEN))
                & zext(0b111111, self.XLEN)));
    }
}

// Flag-setting compare-negative: the flags of rn + rm (`adds xzr`).
instruction CompareNegative for [ARMv8A64] : CmpRegTemplate {
    param MNEMONIC: String = "cmn";
    param OP: bits<1> = 0b0;

    behavior {
        PSTATE::n = extract(rn + rm, self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if rn + rm == zext(0b0, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        // Carry out of the addition: the truncated sum wrapped below rn.
        PSTATE::c = if rn + rm ~< rn {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        // Signed overflow of rn + rm: operands share a sign and the result's
        // sign differs from rn's.
        PSTATE::v = extract(~(rn ^ rm) & (rn ^ (rn + rm)), self.XLEN - 1, self.XLEN - 1);
    }
}

instruction CompareNegativeWord for [ARMv8A64] : CmpRegTemplateWord {
    param MNEMONIC: String = "cmn";
    param OPNAME: String = "cmn_w";
    param OP: bits<1> = 0b0;

    behavior {
        PSTATE::n = extract(rn + rm, 31, 31);
        PSTATE::z = if rn + rm == zext(0b0, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn + rm ~< rn {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(~(rn ^ rm) & (rn ^ (rn + rm)), 31, 31);
    }
}

// Flag-setting logical compare: the flags of rn & rm (`ands xzr`); C and V
// are cleared.
instruction Test for [ARMv8A64] : TstRegTemplate {
    param MNEMONIC: String = "tst";

    behavior {
        PSTATE::n = extract(rn & rm, self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if (rn & rm) == zext(0b0, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = zext(0b0, 1);
        PSTATE::v = zext(0b0, 1);
    }
}

instruction TestWord for [ARMv8A64] : TstRegTemplateWord {
    param MNEMONIC: String = "tst";
    param OPNAME: String = "tst_w";

    behavior {
        PSTATE::n = extract(rn & rm, 31, 31);
        PSTATE::z = if (rn & rm) == zext(0b0, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = zext(0b0, 1);
        PSTATE::v = zext(0b0, 1);
    }
}

instruction CompareImmediate for [ARMv8A64] : CmpImmTemplate {
    param MNEMONIC: String = "cmp";
    param OPNAME: String = "cmp_imm";
    param OP: bits<1> = 0b1;

    behavior {
        PSTATE::n = extract(rn - zext(imm, self.XLEN), self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if rn == zext(imm, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn ~>= zext(imm, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            (rn ^ zext(imm, self.XLEN)) & (rn ^ (rn - zext(imm, self.XLEN))),
            self.XLEN - 1, self.XLEN - 1);
    }
}

instruction CompareImmediateWord for [ARMv8A64] : CmpImmTemplateWord {
    param MNEMONIC: String = "cmp";
    param OPNAME: String = "cmp_imm_w";
    param OP: bits<1> = 0b1;

    behavior {
        PSTATE::n = extract(rn - zext(imm, 32), 31, 31);
        PSTATE::z = if rn == zext(imm, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn ~>= zext(imm, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            (rn ^ zext(imm, 32)) & (rn ^ (rn - zext(imm, 32))),
            31, 31);
    }
}

instruction CompareNegImmediate for [ARMv8A64] : CmpImmTemplate {
    param MNEMONIC: String = "cmn";
    param OPNAME: String = "cmn_imm";
    param OP: bits<1> = 0b0;

    behavior {
        PSTATE::n = extract(rn + zext(imm, self.XLEN), self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if rn + zext(imm, self.XLEN) == zext(0b0, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn + zext(imm, self.XLEN) ~< rn {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            ~(rn ^ zext(imm, self.XLEN)) & (rn ^ (rn + zext(imm, self.XLEN))),
            self.XLEN - 1, self.XLEN - 1);
    }
}

instruction CompareNegImmediateWord for [ARMv8A64] : CmpImmTemplateWord {
    param MNEMONIC: String = "cmn";
    param OPNAME: String = "cmn_imm_w";
    param OP: bits<1> = 0b0;

    behavior {
        PSTATE::n = extract(rn + zext(imm, 32), 31, 31);
        PSTATE::z = if rn + zext(imm, 32) == zext(0b0, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn + zext(imm, 32) ~< rn {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            ~(rn ^ zext(imm, 32)) & (rn ^ (rn + zext(imm, 32))),
            31, 31);
    }
}

// Flag-setting subtract immediate (`subs Xd, Xn, #imm`): writes the difference
// AND the NZCV flags of `rn - imm` (the same flag logic as `cmp`, but with a
// real destination). Declared after CompareImmediate so `cmp` (rd = xzr) is
// preferred when decoding a word whose rd field is 31.
instruction SubsImmediate for [ARMv8A64] : AddSubImmFlags {
    param MNEMONIC: String = "subs";
    param OPNAME: String = "subs_imm";
    param OP: bits<1> = 0b1;
    param SETFLAGS: bits<1> = 0b1;

    behavior {
        PSTATE::n = extract(rn - zext(imm, self.XLEN), self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if rn == zext(imm, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn ~>= zext(imm, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            (rn ^ zext(imm, self.XLEN)) & (rn ^ (rn - zext(imm, self.XLEN))),
            self.XLEN - 1, self.XLEN - 1);
        rd = rn - zext(imm, self.XLEN);
    }
}

instruction SubsImmediateWord for [ARMv8A64] : AddSubImmFlagsWord {
    param MNEMONIC: String = "subs";
    param OPNAME: String = "subs_imm_w";
    param OP: bits<1> = 0b1;
    param SETFLAGS: bits<1> = 0b1;

    behavior {
        PSTATE::n = extract(rn - zext(imm, 32), 31, 31);
        PSTATE::z = if rn == zext(imm, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn ~>= zext(imm, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            (rn ^ zext(imm, 32)) & (rn ^ (rn - zext(imm, 32))),
            31, 31);
        rd = rn - zext(imm, 32);
    }
}

// Flag-setting add immediate (`adds Xd, Xn, #imm`): writes the sum AND the NZCV
// flags of `rn + imm` (the same flag logic as `cmn`, but with a real
// destination). Declared after CompareNegImmediate so `cmn` (rd = xzr) is
// preferred when decoding a word whose rd field is 31.
instruction AddsImmediate for [ARMv8A64] : AddSubImmFlags {
    param MNEMONIC: String = "adds";
    param OPNAME: String = "adds_imm";
    param OP: bits<1> = 0b0;
    param SETFLAGS: bits<1> = 0b1;

    behavior {
        PSTATE::n = extract(rn + zext(imm, self.XLEN), self.XLEN - 1, self.XLEN - 1);
        PSTATE::z = if rn + zext(imm, self.XLEN) == zext(0b0, self.XLEN) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn + zext(imm, self.XLEN) ~< rn {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            ~(rn ^ zext(imm, self.XLEN)) & (rn ^ (rn + zext(imm, self.XLEN))),
            self.XLEN - 1, self.XLEN - 1);
        rd = rn + zext(imm, self.XLEN);
    }
}

instruction AddsImmediateWord for [ARMv8A64] : AddSubImmFlagsWord {
    param MNEMONIC: String = "adds";
    param OPNAME: String = "adds_imm_w";
    param OP: bits<1> = 0b0;
    param SETFLAGS: bits<1> = 0b1;

    behavior {
        PSTATE::n = extract(rn + zext(imm, 32), 31, 31);
        PSTATE::z = if rn + zext(imm, 32) == zext(0b0, 32) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::c = if rn + zext(imm, 32) ~< rn {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        PSTATE::v = extract(
            ~(rn ^ zext(imm, 32)) & (rn ^ (rn + zext(imm, 32))),
            31, 31);
        rd = rn + zext(imm, 32);
    }
}

// MOVN with hw = 0 (no shift): rd = NOT(imm16).
instruction MoveWideNot for [ARMv8A64] {
    param MNEMONIC: String = "movn";
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR,
        imm: bits<16>,
    }

    encoding {
        0b1,
        0b00,
        0b100101,
        0b00,
        imm,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {imm}"
    }

    behavior {
        rd = ~zext(imm, self.XLEN);
    }
}

// MOVK with hw = 0 (no shift): insert imm16 into rd[15:0], keeping the rest.
instruction MoveWideKeep for [ARMv8A64] {
    param MNEMONIC: String = "movk";
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR,
        imm: bits<16>,
    }

    encoding {
        0b1,
        0b11,
        0b100101,
        0b00,
        imm,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {imm}"
    }

    behavior {
        rd = (rd & ~zext(0b1111111111111111, self.XLEN)) | zext(imm, self.XLEN);
    }
}

// MOVK with a halfword shift (`movk rd, #imm, lsl #hw*16`): insert imm16 into
// the hw-th 16-bit lane of rd, keeping the other lanes. `hw` is an operand, so
// this one instruction covers lsl #16/#32/#48; declared after the hw = 0
// MoveWideKeep so plain `movk` still decodes to that simpler form.
instruction MoveWideKeepShifted for [ARMv8A64] {
    param MNEMONIC: String = "movk";
    param OPNAME: String = "movk_shifted";
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR,
        imm: bits<16>,
        hw: bits<2>,
    }

    encoding {
        0b1,
        0b11,
        0b100101,
        hw,
        imm,
        rd,
    }

    asm {
        "{self.MNEMONIC} {rd}, {imm}, {hw}"
    }

    behavior {
        rd = (rd & ~(zext(0b1111111111111111, self.XLEN) << (zext(hw, self.XLEN) << 4)))
            | (zext(imm, self.XLEN) << (zext(hw, self.XLEN) << 4));
    }
}

template MoveWideKeepFixed for [ARMv8A64] {
    param MNEMONIC: String = "movk";
    param OPNAME: String;
    param HW: bits<2>;
    schedule { units = [WriteIALU]; }

    operands {
        rd: GPR,
        imm: bits<16>,
    }

    encoding {
        0b1,
        0b11,
        0b100101,
        HW,
        imm,
        rd,
    }

}

instruction MoveWideKeep16 for [ARMv8A64] : MoveWideKeepFixed {
    param OPNAME: String = "movk_lsl16";
    param HW: bits<2> = 0b01;

    asm {
        "{self.MNEMONIC} {rd}, {imm}, 1"
    }

    behavior {
        rd = (rd & ~(zext(0b1111111111111111, self.XLEN)
            * zext(0b10000000000000000, self.XLEN)))
            | (zext(imm, self.XLEN)
                * zext(0b10000000000000000, self.XLEN));
    }
}

instruction MoveWideKeep32 for [ARMv8A64] : MoveWideKeepFixed {
    param OPNAME: String = "movk_lsl32";
    param HW: bits<2> = 0b10;

    asm {
        "{self.MNEMONIC} {rd}, {imm}, 2"
    }

    behavior {
        rd = (rd & ~(zext(0b1111111111111111, self.XLEN)
            * zext(0b100000000000000000000000000000000, self.XLEN)))
            | (zext(imm, self.XLEN)
                * zext(0b100000000000000000000000000000000, self.XLEN));
    }
}

instruction MoveWideKeep48 for [ARMv8A64] : MoveWideKeepFixed {
    param OPNAME: String = "movk_lsl48";
    param HW: bits<2> = 0b11;

    asm {
        "{self.MNEMONIC} {rd}, {imm}, 3"
    }

    behavior {
        rd = (rd & ~(zext(0b1111111111111111, self.XLEN)
            * zext(0b1000000000000000000000000000000000000000000000000,
                self.XLEN)))
            | (zext(imm, self.XLEN)
                * zext(0b1000000000000000000000000000000000000000000000000,
                    self.XLEN));
    }
}

// Logical shifted-register `eor` with a non-zero shift amount (the xorshift RNG
// pattern `eor rd, rn, rm, lsr/lsl #s`). Declared after the plain `Xor` so a
// zero-shift `eor` still decodes to that simpler form.
instruction XorShiftedLsl for [ARMv8A64] : LogicalShiftedReg {
    param MNEMONIC: String = "eor";
    param OPNAME: String = "eor_lsl";
    param OPC: bits<2> = 0b10;
    param SHIFT: bits<2> = 0b00;

    behavior {
        rd = rn ^ (rm << zext(imm, self.XLEN));
    }
}

instruction XorShiftedLsr for [ARMv8A64] : LogicalShiftedReg {
    param MNEMONIC: String = "eor";
    param OPNAME: String = "eor_lsr";
    param OPC: bits<2> = 0b10;
    param SHIFT: bits<2> = 0b01;

    behavior {
        rd = rn ^ (rm >> zext(imm, self.XLEN));
    }
}

instruction MultiplyAdd for [ARMv8A64] : DataProc3Src {
    param MNEMONIC: String = "madd";
    param O0: bits<1> = 0b0;

    behavior {
        rd = ra + extract(rn * rm, self.XLEN - 1, 0);
    }
}

