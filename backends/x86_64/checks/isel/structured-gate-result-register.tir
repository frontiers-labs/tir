// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// What a gate produced is read through a register, not only through `asm.vret`.
// Destruction publishes the result as the join's parameter, so the register the
// tile after the gate names is the one the arms leave their value in.

module {
  %fn_gate_result = func.func @gate_result(%c: !i1, %a: !i64, %b: !i64) -> !i64 {
    cfg.cond_br %c, ^bb1, ^bb2
  ^bb1:
    %x = addi %a, %b : !i64
    cfg.br ^bb3(%x : !i64)
  ^bb2:
    %y = subi %a, %b : !i64
    cfg.br ^bb3(%y : !i64)
  ^bb3(%r: !i64):
    %z = muli %a, %b : !i64
    %w = addi %r, %z : !i64
    func.return %w
  }
  module_end
}

// CHECK: ^{{bb[0-9]+}}(%[[R:[0-9]+]]: !x86_64.GPR):
// CHECK-NEXT: x86_64.imul {dst = %[[PROD:[0-9]+]]:GPR
// CHECK-NEXT: x86_64.add {dst = %{{[0-9]+}}:GPR, dst_tied = %[[R]]:GPR, src = %[[PROD]]:GPR}
