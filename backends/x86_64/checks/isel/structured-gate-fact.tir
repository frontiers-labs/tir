// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An arm is covered under the gate's own assumption, exactly as a block covered
// under its dominating edge is: the then-arm of an equality gate knows its two
// operands name one value, so the subtraction inside it reads that one register
// twice.

module {
  %fn_equal_arm = func.func @equal_arm(%a: !i64, %b: !i64) -> !i64 {
    %c = cmpi %a, %b {predicate = "eq"} : !i1
    cfg.cond_br %c, ^bb1, ^bb2
  ^bb1:
    %s = subi %a, %b : !i64
    cfg.br ^bb3(%s : !i64)
  ^bb2:
    %z = constant {value = 0} : !i64
    cfg.br ^bb3(%z : !i64)
  ^bb3(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK: asm.symbol {name = "equal_arm", arg_regs = [%[[A:[0-9]+]]:GPR, %{{[0-9]+}}:GPR]
// CHECK: x86_64.sub {dst = %{{[0-9]+}}:GPR, dst_tied = %[[A]]:GPR, src = %[[A]]:GPR}
