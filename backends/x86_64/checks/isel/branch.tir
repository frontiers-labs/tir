// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Conditional branches select through the TMDL-derived flag-branch rules: the
// comparison becomes the `cmp` + `jcc` pair composed from EFLAGS semantics
// (cmp defines cf/zf/sf/of, jcc guards on them), and the cmpi op is consumed.

module {
  func.func @slt_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "slt_branch"
  // CHECK: x86_64.cmp {dst = %virt29:GPR, src = %virt30:GPR}
  // CHECK-NEXT: x86_64.jl {imm = ^bb1}
  // CHECK-NEXT: asm.vbr ^bb2

  func.func @sle_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "sle"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // a <= b canonicalizes to b >= a: cmp with swapped operands, then jge.
  // CHECK: asm.symbol {name = "sle_branch"
  // CHECK: x86_64.cmp {dst = %virt33:GPR, src = %virt32:GPR}
  // CHECK-NEXT: x86_64.jge {imm = ^bb1}

  func.func @ult_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "ult"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // Unsigned below reads the carry flag: jb.
  // CHECK: asm.symbol {name = "ult_branch"
  // CHECK: x86_64.cmp
  // CHECK-NEXT: x86_64.jb {imm = ^bb1}

  func.func @eq_branch(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "eq"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "eq_branch"
  // CHECK: x86_64.cmp
  // CHECK-NEXT: x86_64.je {imm = ^bb1}

  func.func @fallback(%0: !i1) -> !i64 {
    cfg.cond_br %0, ^bb1, ^bb2
  ^bb1:
    %1 = constant {value = 1} : !i64
    func.return %1
  ^bb2:
    %2 = constant {value = 0} : !i64
    func.return %2
  }
  // A bare i1 condition has no comparison to fuse, and a width-1 value only
  // defines the low bit of its register, so the branch must read that bit
  // alone: `test c, 1` + `jne`, never a whole-register compare.
  // CHECK: asm.symbol {name = "fallback"
  // CHECK: x86_64.test_imm32 {dst = %virt{{[0-9]+}}:GPR32, imm = 1}
  // CHECK-NEXT: x86_64.jne {imm = ^bb1}
  // CHECK-NEXT: asm.vbr ^bb2

  func.func @constant_operand_branch(%0: !i64) -> !i64 {
    %1 = constant {value = 0} : !i32
    %2 = extsi %1 : !i64
    %3 = cmpi %0, %2 {predicate = "sge"} : !i1
    cfg.cond_br %3, ^bb1, ^bb2
  ^bb1:
    func.return %0
  ^bb2:
    %4 = constant {value = 0} : !i64
    %5 = subi %4, %0 : !i64
    func.return %5
  }
  // The zero is proven constant, so the ops computing it are erased and cannot
  // satisfy a register operand: the branch folds it as an immediate instead of
  // reading a register that nothing in this block defines.
  // CHECK: asm.symbol {name = "constant_operand_branch"
  // CHECK: x86_64.cmp_imm8s {dst = %virt{{[0-9]+}}:GPR, imm = 0}
  // CHECK-NEXT: x86_64.jge {imm = ^bb{{[0-9]+}}}

  module_end
}
