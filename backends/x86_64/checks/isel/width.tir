// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Narrow-width instruction forms are typed at their destination register
// class's width: an i32 add selects `add32` (not the 64-bit `add`), i16 the
// 16-bit form, i8 the byte form. The full-width forms stay width-agnostic, so
// i64 still selects `add`.

module {
  func @width64(%0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    return %2
  }
  func @width32(%0: !i32, %1: !i32) -> !i32 {
    %2 = addi %0, %1 : !i32
    return %2
  }
  func @width16(%0: !i16, %1: !i16) -> !i16 {
    %2 = subi %0, %1 : !i16
    return %2
  }
  func @width8(%0: !i8, %1: !i8) -> !i8 {
    %2 = xori %0, %1 : !i8
    return %2
  }
  func @imm(%0: !i32) -> !i32 {
    %1 = constant {value = 5} : !i32
    %2 = addi %0, %1 : !i32
    return %2
  }
  module_end
}

// CHECK:      x86_64.add {dst = %virt2:GPR, dst_tied = %virt0:GPR, src = %virt1:GPR}
// CHECK:      x86_64.add32 {dst = %virt{{[0-9]+}}:GPR32, dst_tied = %virt{{[0-9]+}}:GPR32, src = %virt{{[0-9]+}}:GPR32}
// CHECK:      x86_64.sub16 {dst = %virt{{[0-9]+}}:GPR16, dst_tied = %virt{{[0-9]+}}:GPR16, src = %virt{{[0-9]+}}:GPR16}
// CHECK:      x86_64.xor8 {dst = %virt{{[0-9]+}}:GPR8, dst_tied = %virt{{[0-9]+}}:GPR8, src = %virt{{[0-9]+}}:GPR8}

// The immediate form is typed the same way: an i32 add with a constant folds
// into `add_imm32`.
// CHECK: asm.symbol {name = "imm"
// CHECK: x86_64.add_imm32 {dst = %virt{{[0-9]+}}:GPR32, dst_tied = %virt{{[0-9]+}}:GPR32, imm = 5}
