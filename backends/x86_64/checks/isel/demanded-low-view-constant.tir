// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A low-bit truncation re-views its source's register, so it owns no register
// of its own. Under the fact the arm restructuring builds `^bb2` into is entered
// with, the returned constant 0 is proven equal to that view's class, but the
// view's source is neither in a register there nor extracted there — so the
// constant must still be
// materialized. Treating a view as unconditionally available left the class
// with no instruction and the func.return reading an undefined value.

module {
  %fn_demanded_low_view_constant = func.func @demanded_low_view_constant(%0: !i64) -> !i32 {
    %1 = constant {value = 32} : !i64
    %2 = shrui %0, %1 : !i64
    %3 = trunci %2 : !i32
    %4 = constant {value = 0} : !i32
    %5 = cmpi %3, %4 {predicate = "ne"} : !i1
    cfg.cond_br %5, ^bb1, ^bb2
  ^bb1:
    %6 = constant {value = 3} : !i32
    func.return %6
  ^bb2:
    %7 = constant {value = 0} : !i32
    func.return %7
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "demanded_low_view_constant"
// CHECK: ^bb2:
// CHECK-NEXT: x86_64.mov_imm32_norex {dst = %virt[[ZERO:[0-9]+]]:GPR32low, imm = 0}
// CHECK-NEXT: asm.vbr %[[ZERO]] ^bb{{[0-9]+}}
