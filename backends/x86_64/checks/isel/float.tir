// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Scalar double-precision arithmetic selects the SSE2 two-address forms:
// addf -> addsd, subf -> subsd, mulf -> mulsd, divf -> divsd. Each ties dst to
// its first source (like the integer ALU ops, recorded in `dst_tied`) and its
// operands live in the XMM register class.

module {
  func @arith(%0: !f64, %1: !f64) -> !f64 {
    %2 = addf %0, %1 : !f64
    %3 = mulf %2, %1 : !f64
    %4 = subf %3, %0 : !f64
    %5 = divf %4, %1 : !f64
    return %5
  }

  func @convert(%0: !i32) -> !f64 {
    %1 = sitofp %0 : !f64
    return %1
  }
  func @convert_unsigned(%0: !i32) -> !f64 {
    %1 = uitofp %0 : !f64
    return %1
  }
  func @convert_to_signed(%0: !f64) -> !i32 {
    %1 = fptosi %0 : !i32
    return %1
  }
  func @convert_to_unsigned(%0: !f64) -> !i32 {
    %1 = fptoui %0 : !i32
    return %1
  }
  func @bits_to_double(%0: !i64) -> !f64 {
    %1 = bitcast %0 : !f64
    return %1
  }
  func @double_to_bits(%0: !f64) -> !i64 {
    %1 = bitcast %0 : !i64
    return %1
  }
  func @shared_zero(%0: !ptr.p<!i64>) -> !i64 {
    %1 = constantf {value = 0.0} : !f64
    ptr.store %1, %0
    %2 = constant {value = 0} : !i64
    %3 = ptr.ptradd %0, %2 : !ptr.p<!i64>
    %4 = ptr.load %3 : !i64
    return %4
  }
  func @less(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "olt"} : !i1
    return %2
  }
  func @less_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "ole"} : !i1
    return %2
  }
  func @greater(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "ogt"} : !i1
    return %2
  }
  func @greater_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "oge"} : !i1
    return %2
  }
  func @equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "oeq"} : !i1
    return %2
  }
  func @not_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = cmpf %0, %1 {predicate = "une"} : !i1
    return %2
  }
  module_end
}

// CHECK:      x86_64.addsd_norex {dst = %virt2:XMMlow, dst_tied = %virt0:XMMlow, src = %virt1:XMMlow}
// CHECK-NEXT: x86_64.mulsd_norex {dst = %virt3:XMMlow, dst_tied = %virt1:XMMlow, src = %virt2:XMMlow}
// CHECK-NEXT: x86_64.subsd_norex {dst = %virt4:XMMlow, dst_tied = %virt3:XMMlow, src = %virt0:XMMlow}
// CHECK-NEXT: x86_64.divsd_norex {dst = %virt5:XMMlow, dst_tied = %virt4:XMMlow, src = %virt1:XMMlow}
// CHECK-NEXT: asm.vret
// CHECK:      x86_64.cvtsi2sd32_norex {dst = %virt7:XMMlow, src = %virt6:GPR32low}
// CHECK:      x86_64.movzxd {dst = %virt[[ZEXT:[0-9]+]]:GPR, src = %virt8:GPR32}
// CHECK-NEXT: x86_64.cvtsi2sd64 {dst = %virt9:XMM, src = %virt[[ZEXT]]:GPR}
// CHECK:      x86_64.cvttsd2si32_norex {dst = %virt11:GPR32low, src = %virt10:XMMlow}
// The i32 result is the low half of the 64-bit conversion: a zero-instruction
// re-view, so no truncating mov follows.
// CHECK:      x86_64.cvttsd2si64 {dst = %virt{{[0-9]+}}:GPR, src = %virt{{[0-9]+}}:XMM}
// CHECK-NEXT: asm.vret
// CHECK:      x86_64.movq_xmm_gpr {dst = %virt{{[0-9]+}}:XMMzx, src = %virt{{[0-9]+}}:GPR}
// CHECK:      x86_64.movq_gpr_xmm {dst = %virt{{[0-9]+}}:GPR, src = %virt{{[0-9]+}}:XMM}
// CHECK-LABEL: asm.symbol {name = "shared_zero"
// CHECK:      x86_64.mov_imm {dst = %virt[[ZERO:[0-9]+]]:GPR, imm = 0}
// CHECK-NEXT: x86_64.movq_xmm_gpr {dst = %virt{{[0-9]+}}:XMMzx, src = %virt[[ZERO]]:GPR}
// CHECK:      x86_64.movsd_store_disp_norex
// CHECK:      x86_64.mov_load
// CHECK:      x86_64.ucomisd_norex {lhs = %virt{{[0-9]+}}:XMMlow, rhs = %virt{{[0-9]+}}:XMMlow}
// CHECK-NEXT: x86_64.seta_norex {dst = %virt{{[0-9]+}}:GPR8low}
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.setae_norex
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.seta_norex
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.setae_norex
// CHECK-LABEL: asm.symbol {name = "equal"
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.set{{a|ae}}_norex
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.set{{a|ae}}_norex
// CHECK:      x86_64.and
// CHECK-LABEL: asm.symbol {name = "not_equal"
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.set{{a|ae}}_norex
// CHECK:      x86_64.ucomisd_norex
// CHECK-NEXT: x86_64.set{{a|ae}}_norex
// CHECK:      x86_64.and
// CHECK-NEXT: x86_64.xor_imm
