// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Scalar double-precision arithmetic selects the SSE2 two-address forms:
// fp.add -> addsd, fp.sub -> subsd, fp.mul -> mulsd, fp.div -> divsd. Each ties dst to
// its first source (like the integer ALU ops, recorded in `dst_tied`) and its
// operands live in the XMM register class.

module {
  %fn_arith = func.func @arith(%0: !f64, %1: !f64) -> !f64 {
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %3 = fp.mul %2, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %4 = fp.sub %3, %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    %5 = fp.div %4, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %5
  }

  %fn_convert = func.func @convert(%0: !i32) -> !f64 {
    %1 = fp.from_si %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %1
  }
  %fn_convert_unsigned = func.func @convert_unsigned(%0: !i32) -> !f64 {
    %1 = fp.from_ui %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f64
    func.return %1
  }
  %fn_convert_to_signed = func.func @convert_to_signed(%0: !f64) -> !i32 {
    %1 = fp.to_si %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    func.return %1
  }
  %fn_convert_to_unsigned = func.func @convert_to_unsigned(%0: !f64) -> !i32 {
    %1 = fp.to_ui %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    func.return %1
  }
  %fn_convert_bound = func.func @convert_bound(%0: !f64) -> !i32 {
    %1 = fp.to_si %0 : !i64
    %2 = trunci %1 : !i32
    %3 = constant {value = 1} : !i32
    %4 = cmpi %2, %3 {predicate = "uge"} : !i1
    %5 = extsi %4 : !i32
    %6 = andi %2, %5 : !i32
    %7 = constant {value = -1} : !i32
    %8 = xori %5, %7 : !i32
    %9 = andi %3, %8 : !i32
    %10 = ori %6, %9 : !i32
    func.return %10
  }
  %fn_bits_to_double = func.func @bits_to_double(%0: !i64) -> !f64 {
    %1 = bitcast %0 : !f64
    func.return %1
  }
  %fn_double_to_bits = func.func @double_to_bits(%0: !f64) -> !i64 {
    %1 = bitcast %0 : !i64
    func.return %1
  }
  %fn_shared_zero = func.func @shared_zero(%0: !ptr.p<!i64>) -> !i64 {
    %1 = fp.constant {bits = 0} : !f64
    ptr.store %1, %0
    %2 = constant {value = 0} : !i64
    %3 = ptr.ptradd %0, %2 : !ptr.p<!i64>
    %4 = ptr.load %3 : !i64
    func.return %4
  }
  %fn_less = func.func @less(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "olt", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_less_equal = func.func @less_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "ole", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_greater = func.func @greater(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "ogt", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_greater_equal = func.func @greater_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "oge", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_equal = func.func @equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "oeq", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_not_equal = func.func @not_equal(%0: !f64, %1: !f64) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "une", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  module_end
}

// CHECK:      x86_64.addsd {dst = %[[ADD:[0-9]+]]:XMM, dst_tied = %[[A:[0-9]+]]:XMM, src = %[[B:[0-9]+]]:XMM}
// CHECK-NEXT: x86_64.mulsd {dst = %[[MUL:[0-9]+]]:XMM, dst_tied = %[[B]]:XMM, src = %[[ADD]]:XMM}
// CHECK-NEXT: x86_64.subsd {dst = %[[SUB:[0-9]+]]:XMM, dst_tied = %[[MUL]]:XMM, src = %[[A]]:XMM}
// CHECK-NEXT: x86_64.divsd {dst = %{{[0-9]+}}:XMM, dst_tied = %[[SUB]]:XMM, src = %[[B]]:XMM}
// CHECK-NEXT: asm.vret
// CHECK:      x86_64.cvtsi2sd32 {dst = %{{[0-9]+}}:XMM, src = %{{[0-9]+}}:GPR}
// CHECK:      x86_64.movzxd {dst = %[[ZEXT:[0-9]+]]:GPR, src = %{{[0-9]+}}:GPR}
// CHECK-NEXT: x86_64.cvtsi2sd64 {dst = %{{[0-9]+}}:XMM, src = %[[ZEXT]]:GPR}
// CHECK:      x86_64.cvttsd2si32 {dst = %{{[0-9]+}}:GPR32, src = %{{[0-9]+}}:XMM}
// The i32 result is the low half of the 64-bit conversion: a zero-instruction
// re-view, so no truncating mov follows.
// CHECK:      x86_64.cvttsd2si64 {dst = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:XMM}
// CHECK-NEXT: asm.vret
// CHECK-LABEL: asm.symbol {name = "convert_bound"
// CHECK:      x86_64.cvttsd2si64 {dst = %[[BOUND:[0-9]+]]:GPR
// CHECK-NEXT: x86_64.cmp_imm32 {dst = %[[BOUND]]:GPR, imm = 1}
// CHECK:      x86_64.movq_xmm_gpr {dst = %{{[0-9]+}}:XMM64, src = %{{[0-9]+}}:GPR}
// CHECK:      x86_64.movq_gpr_xmm {dst = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:XMM}
// CHECK-LABEL: asm.symbol {name = "shared_zero"
// CHECK:      x86_64.mov_imm {dst = %[[ZERO:[0-9]+]]:GPR, imm = 0}
// State-chain setup may sit between the shared literal and its floating view.
// CHECK:      x86_64.movq_xmm_gpr {dst = %{{[0-9]+}}:XMM64, src = %[[ZERO]]:GPR}
// CHECK:      x86_64.movsd_store_disp
// CHECK:      x86_64.mov_load
// CHECK:      x86_64.ucomisd {lhs = %{{[0-9]+}}:XMM, rhs = %{{[0-9]+}}:XMM}
// CHECK-NEXT: x86_64.seta {dst = %{{[0-9]+}}:GPR8}
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.setae
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.seta
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.setae
// CHECK-LABEL: asm.symbol {name = "equal"
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.set{{a|ae}}
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.set{{a|ae}}
// CHECK:      x86_64.and
// CHECK-LABEL: asm.symbol {name = "not_equal"
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.set{{a|ae}}
// CHECK:      x86_64.ucomisd
// CHECK-NEXT: x86_64.set{{a|ae}}
// CHECK:      x86_64.and
// CHECK-NEXT: x86_64.xor_imm
