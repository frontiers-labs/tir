// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A tested loop's body is covered under the condition its test yields. That
// condition is spelled over the ports' per-iteration heads, so it holds on every
// iteration, not only the first: this body runs knowing its two carried values
// are equal and subtracts one register from itself. Without the body's scope the
// two ports stay distinct classes and the subtraction reads both.

module {
  func.func @equal_body(%n: !i64, %acc: !i64) -> !i64 {
    %r = scf.while iter_args(%a = %acc, %i = %n) -> !i64, !i64 {
      %c = cmpi %i, %a {predicate = "eq"} : !i1
      scf.condition %c, %a, %i
    } do scope(%tok)(%ca, %ci) {
      %d = subi %ci, %ca : !i64
      scf.yield %d, %ci
    }
    func.return %r
  }
  module_end
}

// CHECK: x86_64.je
// CHECK: ^bb{{[0-9]+}}(%[[CA:[0-9]+]]: !i64, %{{[0-9]+}}: !i64):
// CHECK-NEXT: x86_64.sub {dst = %virt{{[0-9]+}}:GPR, dst_tied = %virt[[CA]]:GPR, src = %virt[[CA]]:GPR}
