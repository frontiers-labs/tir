// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An arm may not read a sibling arm's value. Both arms are entered with the same
// outer sum, and the converter hoists it out of the edges: the sum is computed
// once in the block before the gate, no edge carries it, and each arm reads the
// register that block wrote — never a value the other arm defined.

module {
  %fn_sibling = func.func @sibling(%c: !i1, %a: !i64, %b: !i64) -> !i64 {
    %s = addi %a, %b : !i64
    cfg.cond_br %c, ^bb1(%s : !i64), ^bb2(%s : !i64)
  ^bb1(%p: !i64):
    %x = muli %p, %a : !i64
    cfg.br ^bb3(%x : !i64)
  ^bb2(%q: !i64):
    %y = subi %q, %b : !i64
    cfg.br ^bb3(%y : !i64)
  ^bb3(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK: x86_64.add {dst = %[[SUM:[0-9]+]]:GPR
// CHECK-NEXT: x86_64.test_imm32
// CHECK-NEXT: x86_64.jne {imm = ^[[THEN:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[ELSE:bb[0-9]+]]
// CHECK: ^[[ELSE]]:
// CHECK-NEXT: x86_64.sub {dst = %{{[0-9]+}}:GPR, dst_tied = %[[SUM]]:GPR, src = %{{[0-9]+}}:GPR}
// CHECK: ^[[THEN]]:
// CHECK-NEXT: x86_64.imul {dst = %{{[0-9]+}}:GPR, dst_tied = %{{[0-9]+}}:GPR, src = %[[SUM]]:GPR}
