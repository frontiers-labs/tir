// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An arm may not read a sibling arm's value. Both arms are entered with the same
// outer sum, but each names it as an argument of its own block, and a block
// argument holds its value only where that block has run. So the sum is computed
// once before the gate, each edge carries it, and each arm reads the argument it
// was entered with — never the one the other arm was.

module {
  func.func @sibling(%c: !i1, %a: !i64, %b: !i64) -> !i64 {
    %s = addi %a, %b : !i64
    %r = scf.if %c args(%s) -> !i64 (%p) {
      %x = muli %p, %a : !i64
      scf.yield %x
    } else (%q) {
      %y = subi %q, %b : !i64
      scf.yield %y
    }
    func.return %r
  }
  module_end
}

// CHECK: x86_64.add {dst = %virt[[SUM:[0-9]+]]:GPR
// CHECK: x86_64.jne {imm = ^[[TRAMPOLINE:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %[[SUM]] ^[[ELSE:bb[0-9]+]]
// CHECK: ^[[THEN:bb[0-9]+]](%[[P:[0-9]+]]: !i64):
// CHECK-NEXT: x86_64.imul {{.*}}src = %virt[[P]]:GPR}
// CHECK: ^[[ELSE]](%[[Q:[0-9]+]]: !i64):
// CHECK-NEXT: x86_64.sub {{.*}}dst_tied = %virt[[Q]]:GPR
// CHECK: ^[[TRAMPOLINE]]:
// CHECK-NEXT: asm.vbr %[[SUM]] ^[[THEN]]
