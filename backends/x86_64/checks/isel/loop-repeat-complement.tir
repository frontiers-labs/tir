// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A loop that repeats while its exit comparison fails carries the negated
// predicate. Selection branches on the inner comparison with the edges
// swapped instead of materializing the boolean.

module {
  %fn_down = func.func @down(%n: !i64) -> !i64 {
    cfg.br ^loop(%n : !i64)
  ^loop(%i: !i64):
    %one = constant {value = 1} : !i64
    %ni = subi %i, %one : !i64
    %z = constant {value = 0} : !i64
    %done = cmpi %ni, %z {predicate = "eq"} : !i1
    cfg.cond_br %done, ^exit(%ni : !i64), ^loop(%ni : !i64)
  ^exit(%r: !i64):
    func.return %r
  }
  module_end
}

// The header compares once and branches directly to the backedge when unequal.
// Neither outcome needs a materialized boolean or another comparison.
// CHECK: ^[[HEAD:bb[0-9]+]](%{{[0-9]+}}: !x86_64.GPR):
// CHECK-NEXT: x86_64.lea_base_disp {dst = %[[NEXT:[0-9]+]]:GPR, base = %{{[0-9]+}}:GPR, imm = -1}
// CHECK-NEXT: x86_64.cmp {dst = %{{[0-9]+}}:GPR, src = %[[NEXT]]:GPR}
// CHECK-NEXT: x86_64.jne {imm = ^[[BACK:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[EXIT:bb[0-9]+]]
// CHECK-NEXT: ^[[BACK]]:
// CHECK-NEXT: asm.vbr %[[NEXT]] ^[[HEAD]]
// CHECK-NEXT: ^[[EXIT]]:
// CHECK-NEXT: asm.vret %[[NEXT]]
