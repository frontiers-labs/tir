// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A comparison against a constant fuses into the `cmp r64, imm` + `jcc` pair
// derived from the immediate flag definer (`cmp_imm`, 0x83 /7) composed with the
// EFLAGS-guarded jumps. The constant binds the immediate operand directly rather
// than materializing into a register.

module {
  %fn_slt_imm = func.func @slt_imm(%0: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %1 = cmpi %0, %c {predicate = "slt"} : !i1
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "slt_imm"
  // CHECK: x86_64.cmp_imm {dst = %[[V36:[0-9]+]]:GPR, imm = 5}
  // CHECK-NEXT: x86_64.jl {imm = ^bb2}
  // CHECK-NEXT: asm.vbr ^bb1

  %fn_eq_imm = func.func @eq_imm(%0: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %1 = cmpi %0, %c {predicate = "eq"} : !i1
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "eq_imm"
  // CHECK: x86_64.cmp_imm {dst = %{{[0-9]+}}:GPR, imm = 5}
  // CHECK-NEXT: x86_64.je {imm = ^bb2}

  %fn_ne_imm = func.func @ne_imm(%0: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %1 = cmpi %0, %c {predicate = "ne"} : !i1
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "ne_imm"
  // CHECK: x86_64.cmp_imm {dst = %{{[0-9]+}}:GPR, imm = 5}
  // CHECK-NEXT: x86_64.jne {imm = ^bb2}

  %fn_ult_imm = func.func @ult_imm(%0: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %1 = cmpi %0, %c {predicate = "ult"} : !i1
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // CHECK: asm.symbol {name = "ult_imm"
  // CHECK: x86_64.cmp_imm {dst = %{{[0-9]+}}:GPR, imm = 5}
  // CHECK-NEXT: x86_64.jb {imm = ^bb2}

  %fn_slt_zero = func.func @slt_zero(%0: !i64) -> !i64 {
    %c = constant {value = 0} : !i64
    %1 = cmpi %0, %c {predicate = "slt"} : !i1
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // A zero constant fuses the same way (x86 has no compare-against-zero branch).
  // CHECK: asm.symbol {name = "slt_zero"
  // CHECK: x86_64.cmp_imm {dst = %{{[0-9]+}}:GPR, imm = 0}
  // CHECK-NEXT: x86_64.jl {imm = ^bb2}

  %fn_eq_zero = func.func @eq_zero(%0: !i64) -> !i64 {
    %c = constant {value = 0} : !i64
    %1 = cmpi %0, %c {predicate = "eq"} : !i1
    cfg.cond_br %1, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  // The derived `test c, c` zero-branch proves `c == 0` just as `cmp x, 0` does,
  // at the same latency but one byte less encoding, so it wins the cost tie.
  // CHECK: asm.symbol {name = "eq_zero"
  // CHECK-NOT: x86_64.cmp_imm
  // CHECK: x86_64.test {dst = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:GPR}
  // CHECK-NEXT: x86_64.je {imm = ^bb2}

  module_end
}
