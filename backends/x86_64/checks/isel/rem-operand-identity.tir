// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// `idiv` leaves `eax - (eax / dst) * dst` in edx, and that rule reads both `eax`
// and `dst` twice. Two occurrences of one operand name one value, so an
// expression subtracting a different dividend than the one it divides is not
// that remainder and selects the arithmetic it spells.

module {
  %fn_f = func.func @f(%0: !i32) -> !i32 {
    %1 = constant {value = 7} : !i32
    %2 = constant {value = 61} : !i32
    %3 = divsi %2, %0 : !i32
    %4 = muli %3, %3 : !i32
    %5 = subi %1, %4 : !i32
    func.return %5
  }
  // The dividend agrees and only the multiplier differs, so the divisor's two
  // readings are what must disagree for this not to be a remainder.
  %fn_g = func.func @g(%0: !i32, %1: !i32) -> !i32 {
    %2 = constant {value = 61} : !i32
    %3 = divsi %2, %0 : !i32
    %4 = muli %3, %1 : !i32
    %5 = subi %2, %4 : !i32
    func.return %5
  }
  module_end
}

// CHECK-LABEL: name = "f"
// CHECK: sign_extend_dividend32
// CHECK-NEXT: signed_divide32
// CHECK-NEXT: imul32
// CHECK-NEXT: sub32

// CHECK-LABEL: name = "g"
// CHECK: signed_divide32
// CHECK-NEXT: imul32
// CHECK-NEXT: sub32
// CHECK-NOT: signed_divide32
