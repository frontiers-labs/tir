// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Where every inner arm computes nothing, PCFR drops that gate. The outer
// condition branches once: false returns and true reaches an empty self-loop.

module {
  %fn_spin = func.func @spin(%c: !i1, %n: !i32) -> !i32 {
    cfg.br ^bb1(%n : !i32)
  ^bb1(%i: !i32):
    cfg.cond_br %c, ^bb2, ^bb6
  ^bb2:
    cfg.cond_br %c, ^bb3, ^bb4
  ^bb3:
    cfg.br ^bb5
  ^bb4:
    cfg.br ^bb5
  ^bb5:
    cfg.br ^bb1(%i : !i32)
  ^bb6:
    func.return %i
  }
  module_end
}

// CHECK: x86_64.test_imm32 {dst = %[[C:[0-9]+]]:GPR, imm = 1}
// CHECK-NEXT: x86_64.jne {imm = ^[[BODY:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[EXIT:bb[0-9]+]]
// CHECK: ^[[EXIT]]:
// CHECK-NEXT: asm.vret
// CHECK: ^[[BODY]]:
// CHECK-NEXT: asm.vbr ^[[BODY]]
// CHECK-NOT: x86_64.test_imm32
