// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Where every arm of a gate computes nothing, sealing sends both of its edges to
// the gate's own join carrying the same values. Nothing is left to decide, so the
// gate is not a branch: the body holds its back edge and no test at all.

module {
  func.func @spin(%c: !i1, %n: !i32) -> !i32 {
    %r = scf.while iter_args(%i = %n) -> !i32 {
      scf.condition %c, %i
    } do scope(%tok)(%v) {
      scf.if %c {
        scf.yield
      } else {
        scf.yield
      }
      scf.yield %v
    }
    func.return %r
  }
  module_end
}

// The loop's own test, and then the body: nothing but the edge leaving it.
// CHECK: x86_64.jne
// CHECK: ^{{bb[0-9]+}}(%{{[0-9]+}}: !i32):
// CHECK-NEXT: asm.vbr ^{{bb[0-9]+}}
