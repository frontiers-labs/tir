// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A counted loop written as a CFG destructs head-tested. The header reads the
// counter and carried value as parameters. The body advances both values into a
// merge, whose repeated condition chooses the back edge or continuation.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_count = func.func @count(%lb: !i64, %ub: !i64, %st: !i64, %init: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    cfg.br ^bb1(%lb, %init : !i64, !i64)
  ^bb1(%i: !i64, %acc: !i64):
    %cond = cmpi %i, %ub {predicate = "slt"} : !i1
    cfg.cond_br %cond, ^bb2, ^bb3
  ^bb2:
    %n = addi %acc, %c : !i64
    %ni = addi %i, %st : !i64
    cfg.br ^bb1(%ni, %n : !i64, !i64)
  ^bb3:
    func.return %acc
  }
  module_end
}

// CHECK-NOT: scf.
// The entry edge carries the lower bound and the initial accumulator.
// CHECK: asm.vbr %[[LB:[0-9]+]], %{{[0-9]+}} ^[[HEAD:bb[0-9]+]]
// CHECK: ^[[HEAD]](%[[IV:[0-9]+]]: !x86_64.GPR, %[[ACC:[0-9]+]]: !x86_64.GPR):
// The counter test fuses into the header's branch.
// CHECK-NEXT: x86_64.cmp {dst = %[[IV]]:GPR, src = %[[UB:[0-9]+]]:GPR}
// CHECK-NEXT: x86_64.jl {imm = ^[[BODY:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[EXIT:bb[0-9]+]]
// PCFR routes the false outcome directly to the return continuation, which is
// laid out before the body.
// CHECK: ^[[EXIT]]:
// CHECK-NEXT: asm.vret %[[ACC]]
// The body advances both ports. The constant folds into the accumulator's
// instruction.
// CHECK: ^[[BODY]]:
// CHECK-NEXT: x86_64.lea_base_disp {dst = %[[NACC:[0-9]+]]:GPR, base = %[[ACC]]:GPR, imm = 5}
// CHECK-NEXT: x86_64.add {dst = %[[NEXT:[0-9]+]]:GPR, dst_tied = %[[IV]]:GPR, src = %[[ST:[0-9]+]]:GPR}
// CHECK-NEXT: asm.vbr %[[NEXT]], %[[NACC]] ^[[HEAD]]
// CHECK-NOT: scf.
