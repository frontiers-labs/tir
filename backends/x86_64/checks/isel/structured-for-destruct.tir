// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A counted loop destructs rotated, off the `CountedLoop` interface alone: its
// zero-trip guard `lb < ub` branches into the body, and the body advances the
// counter and tests it again on its own back edge. The counter is not a value of
// the IR — it is minted as the body's trailing argument, which is why the entry
// edge carries the lower bound and the back edge the advanced counter.

#data_layout = {types = {p = {abi = 64, size = 64}}}

module {data_layout = #data_layout} {
  %fn_count = func.func @count(%lb: !index, %ub: !index, %st: !index, %init: !i64) -> !i64 {
    %c = constant {value = 5} : !i64
    %r = scf.for %lb, %ub, %st iter_args(%acc = %init) -> !i64 {
      %n = addi %acc, %c : !i64
      scf.yield %n
    }
    func.return %r
  }
  module_end
}

// CHECK-NOT: scf.
// The zero-trip guard, before the loop, fused into its branch.
// CHECK: x86_64.cmp {dst = %[[V0:[0-9]+]]:GPR, src = %[[V1:[0-9]+]]:GPR}
// CHECK-NEXT: x86_64.jl {imm = ^[[ENTER:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %{{[0-9]+}} ^[[EXIT:bb[0-9]+]]
// The body carries the accumulator and the counter.
// CHECK: ^[[BODY:bb[0-9]+]](%{{[0-9]+}}: !x86_64.GPR, %[[IV:[0-9]+]]: !x86_64.GPR):
// The counter advances by the step and is tested against the same bound; the
// test fuses into the back edge's branch even though the advance names no value
// of the IR. The advance leads the body: rooted at no operation of its own, it
// takes the head of the order the cover spells.
// CHECK-NEXT: x86_64.add {dst = %[[NEXT:[0-9]+]]:GPR, dst_tied = %[[IV]]:GPR, src = %[[V2:[0-9]+]]:GPR}
// CHECK-NEXT: x86_64.add_imm {dst = %{{[0-9]+}}:GPR, dst_tied = %{{[0-9]+}}:GPR, imm = 5}
// CHECK-NEXT: x86_64.cmp {dst = %[[NEXT]]:GPR, src = %[[V1]]:GPR}
// CHECK-NEXT: x86_64.jl {imm = ^[[LATCH:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %{{[0-9]+}} ^[[EXIT]]
// CHECK: ^[[EXIT]](%{{[0-9]+}}: !x86_64.GPR):
// CHECK-NEXT: asm.vret
// CHECK: ^[[ENTER]]:
// CHECK-NEXT: asm.vbr %{{[0-9]+}}, %{{[0-9]+}} ^[[BODY]]
// CHECK: ^[[LATCH]]:
// CHECK-NEXT: asm.vbr %{{[0-9]+}}, %{{[0-9]+}} ^[[BODY]]
// CHECK-NOT: scf.
