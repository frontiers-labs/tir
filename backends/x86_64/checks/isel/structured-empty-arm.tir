// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An arm that computes nothing is not a block. What such an arm yields rides the
// edge the gate's test already carries, so the only block destruction mints for
// it is the trampoline the taken edge needs to perform its assignment on.

module {
  %fn_pick = func.func @pick(%c: !i1, %a: !i64, %b: !i64) -> !i64 {
    cfg.cond_br %c, ^bb1(%a : !i64), ^bb1(%b : !i64)
  ^bb1(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK: x86_64.test_imm32
// CHECK-NEXT: x86_64.jne {imm = ^[[TAKEN:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %{{[0-9]+}} ^[[JOIN:bb[0-9]+]]
// CHECK-NEXT: asm.symbol_end
// CHECK-NEXT: ^[[TAKEN]]:
// CHECK-NEXT: asm.vbr %{{[0-9]+}} ^[[JOIN]]
// CHECK-NEXT: ^[[JOIN]](%[[R:[0-9]+]]: !x86_64.GPR):
// CHECK-NEXT: asm.vret %[[R]]
