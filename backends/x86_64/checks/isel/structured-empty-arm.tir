// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An arm that computes nothing is not a block. PCFR routes each outcome
// directly to its return, without a join or assignment trampoline.

module {
  %fn_pick = func.func @pick(%c: !i1, %a: !i64, %b: !i64) -> !i64 {
    cfg.cond_br %c, ^bb1(%a : !i64), ^bb1(%b : !i64)
  ^bb1(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK: x86_64.test_imm32
// CHECK-NEXT: x86_64.jne {imm = ^[[TAKEN:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[OTHER:bb[0-9]+]]
// CHECK-NEXT: asm.symbol_end
// CHECK-NEXT: ^[[OTHER]]:
// CHECK-NEXT: asm.vret %7
// CHECK-NEXT: ^[[TAKEN]]:
// CHECK-NEXT: asm.vret %6
