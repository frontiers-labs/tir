// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An edge leaving a loop from inside a gate nested in its body becomes a stop
// flag: the converter carries the exit value and a cleared flag out of the arm
// that leaves, the arm that stays carries the advanced counter and a set flag,
// and the loop's latch tests the flag to choose between the back edge and the
// continuation. Neither arm is folded into its edge, since each holds the
// constant its flag is.

module {
  %fn_find = func.func @find(%n: !i64, %limit: !i64) -> !i64 {
    cfg.br ^bb1(%n : !i64)
  ^bb1(%i: !i64):
    %z = constant {value = 0} : !i64
    %c = cmpi %i, %z {predicate = "sgt"} : !i1
    cfg.cond_br %c, ^bb2, ^bb3(%i : !i64)
  ^bb2:
    %one = constant {value = 1} : !i64
    %ni = subi %i, %one : !i64
    %hit = cmpi %ni, %limit {predicate = "eq"} : !i1
    cfg.cond_br %hit, ^bb3(%ni : !i64), ^bb1(%ni : !i64)
  ^bb3(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK-NOT: scf.
// The body: the nested gate's taken arm leaves, the other stays.
// CHECK: x86_64.lea_base_disp {dst = %[[NI:[0-9]+]]:GPR, base = %{{[0-9]+}}:GPR, imm = -1}
// CHECK-NEXT: x86_64.cmp {dst = %[[NI]]:GPR, src = %{{[0-9]+}}:GPR}
// CHECK-NEXT: x86_64.je {imm = ^[[BREAK:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[STAY:bb[0-9]+]]
// CHECK: ^[[STAY]]:
// CHECK-NEXT: x86_64.mov_imm8 {dst = %[[GO:[0-9]+]]:GPR8, imm = 1}
// CHECK-NEXT: asm.vbr %[[NI]], %{{[0-9]+}}, %[[GO]] ^[[JOIN:bb[0-9]+]]
// CHECK: ^[[BREAK]]:
// CHECK-NEXT: x86_64.mov_imm8 {dst = %[[STOP:[0-9]+]]:GPR8, imm = 0}
// CHECK-NEXT: asm.vbr %{{[0-9]+}}, %[[NI]], %[[STOP]] ^[[JOIN]]
// The gate's join forwards all three to the latch, which reads the flag and
// branches: back to the header or out.
// CHECK: ^[[JOIN]](%{{[0-9]+}}: !x86_64.GPR, %{{[0-9]+}}: !x86_64.GPR, %{{[0-9]+}}: !x86_64.GPR):
// CHECK-NEXT: asm.vbr %{{[0-9]+}}, %{{[0-9]+}}, %{{[0-9]+}} ^[[LATCH:bb[0-9]+]]
// CHECK: ^[[LATCH]](%[[I:[0-9]+]]: !x86_64.GPR, %[[R:[0-9]+]]: !x86_64.GPR, %[[FLAG:[0-9]+]]: !x86_64.GPR):
// CHECK-NEXT: x86_64.test_imm32 {dst = %[[FLAG]]:GPR, imm = 1}
// CHECK-NEXT: x86_64.jne {imm = ^[[BACK:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %[[I]], %[[R]] ^[[EXIT:bb[0-9]+]]
// CHECK: ^[[BACK]]:
// CHECK-NEXT: asm.vbr %[[I]], %[[R]] ^{{bb[0-9]+}}
// CHECK: ^[[EXIT]](%{{[0-9]+}}: !x86_64.GPR, %[[OUT:[0-9]+]]: !x86_64.GPR):
// CHECK-NEXT: asm.vret %[[OUT]]
// CHECK-NOT: scf.
