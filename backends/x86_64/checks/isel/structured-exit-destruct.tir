// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An edge leaving a loop from inside a gate nested in its body becomes a boolean
// carried to the latch. The latch tests it to choose the back edge or exit.

module {
  %fn_find = func.func @find(%n: !i64, %limit: !i64) -> !i64 {
    cfg.br ^bb1(%n : !i64)
  ^bb1(%i: !i64):
    %z = constant {value = 0} : !i64
    %c = cmpi %i, %z {predicate = "sgt"} : !i1
    cfg.cond_br %c, ^bb2, ^bb3(%i : !i64)
  ^bb2:
    %one = constant {value = 1} : !i64
    %ni = subi %i, %one : !i64
    %hit = cmpi %ni, %limit {predicate = "eq"} : !i1
    cfg.cond_br %hit, ^bb3(%ni : !i64), ^bb1(%ni : !i64)
  ^bb3(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK-NOT: scf.
// The body: the nested gate's taken arm leaves, the other stays.
// CHECK: x86_64.lea_base_disp {dst = %[[NI:[0-9]+]]:GPR, base = %{{[0-9]+}}:GPR, imm = -1}
// CHECK-NEXT: x86_64.cmp {dst = %[[NI]]:GPR, src = %{{[0-9]+}}:GPR}
// CHECK-NEXT: x86_64.jne {imm = ^[[BACK:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[BREAK:bb[0-9]+]]
// CHECK-NEXT: ^[[BACK]]:
// CHECK-NEXT: asm.vbr %[[NI]] ^[[HEAD:bb[0-9]+]]
// CHECK-NEXT: ^[[BREAK]]:
// CHECK-NEXT: asm.vret %[[NI]]
// The known nested outcome routes directly; no materialized repeat test or
// latch remains.
// CHECK-NOT: x86_64.test_imm32
// CHECK-NOT: scf.
