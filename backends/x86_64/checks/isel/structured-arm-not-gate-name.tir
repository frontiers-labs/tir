// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// The inner gate's arms both yield zero, so its result is a name adopted from
// the zero class — and the enclosing arm yields zero too, joining the same
// class. That name is published by the gate's own join, which the arms feeding
// it run before: an arm must be spelled the zero it can read, never the join
// parameter the gate publishes, or the edge into the join carries the join's
// own parameter.

module {
  %fn_f = func.func @f(%0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    %z = constant {value = 0} : !i64
    %c = cmpi %z, %2 {predicate = "sgt"} : !i1
    cfg.cond_br %c, ^bb1, ^bb4(%2 : !i64)
  ^bb1:
    %t = cmpi %0, %1 {predicate = "eq"} : !i1
    cfg.cond_br %t, ^bb2, ^bb3
  ^bb2:
    %zi = constant {value = 0} : !i64
    cfg.br ^bb4(%zi : !i64)
  ^bb3:
    cfg.br ^bb4(%z : !i64)
  ^bb4(%r: !i64):
    %p = muli %r, %2 : !i64
    func.return %p
  }
  module_end
}

// Both edges into the inner join carry the zero register the block before the
// gates defined.
// CHECK: x86_64.mov_imm {dst = %[[Z:[0-9]+]]:GPR, imm = 0}
// CHECK: x86_64.je {imm = ^[[ARM:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %[[Z]] ^[[INNER:bb[0-9]+]]
// CHECK-NEXT: ^[[ARM]]:
// CHECK-NEXT: asm.vbr %[[Z]] ^[[INNER]]
// CHECK-NEXT: ^[[INNER]](%{{[0-9]+}}: !x86_64.GPR):
