// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// The inner gate's arms both yield zero, so its result is a name adopted from
// the zero class — and the enclosing arm yields zero too, joining the same
// class. That name is published by the gate's own join, which the arms feeding
// it run before: an arm must be spelled the zero it can read, never the join
// parameter the gate publishes, or the edge into the join carries the join's
// own parameter. The inner gate computes nothing, so its test goes with it.

module {
  %fn_f = func.func @f(%0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    %z = constant {value = 0} : !i64
    %c = cmpi %z, %2 {predicate = "sgt"} : !i1
    cfg.cond_br %c, ^bb1, ^bb4(%2 : !i64)
  ^bb1:
    %t = cmpi %0, %1 {predicate = "eq"} : !i1
    cfg.cond_br %t, ^bb2, ^bb3
  ^bb2:
    %zi = constant {value = 0} : !i64
    cfg.br ^bb4(%zi : !i64)
  ^bb3:
    cfg.br ^bb4(%z : !i64)
  ^bb4(%r: !i64):
    %p = muli %r, %2 : !i64
    func.return %p
  }
  module_end
}

// The enclosing arm carries the zero register directly to the outer
// continuation. It may not name that continuation's parameter on its edge.
// CHECK: x86_64.add {dst = %[[SUM:[0-9]+]]:GPR, dst_tied = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:GPR}
// CHECK-NEXT: x86_64.mov_imm {dst = %[[Z:[0-9]+]]:GPR, imm = 0}
// CHECK: x86_64.jl {imm = ^[[ARM:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %[[SUM]] ^[[OUTER:bb[0-9]+]]
// CHECK: ^[[ARM]]:
// CHECK-NEXT: asm.vbr %[[Z]] ^[[OUTER]]
// CHECK-NOT: x86_64.je
