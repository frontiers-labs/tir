// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Both arms of a `cfg.cond_br` may lead to the same block while forwarding
// different values to its parameters — the shape a folded `if`-expression
// takes. Each edge keeps its own arguments: the taken edge branches through a
// block that forwards %1, the fallthrough returns %2 directly. PCFR routes
// both outcomes to their executable continuation without a synthetic join.

module {
  %fn_pick = func.func @pick(%0: !i1, %1: !i64, %2: !i64) -> !i64 {
    cfg.cond_br %0, ^bb1(%1 : !i64), ^bb1(%2 : !i64)
  ^bb1(%3: !i64):
    func.return %3
  }
  module_end
}

// CHECK: x86_64.jne {imm = ^[[TAKEN:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[OTHER:bb[0-9]+]]
// CHECK: ^[[OTHER]]:
// CHECK-NEXT: asm.vret %7
// CHECK: ^[[TAKEN]]:
// CHECK-NEXT: asm.vret %6
