// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s --check-prefix=ISEL
// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s --check-prefix=REGALLOC

module {
  %fn_div32 = func.func @div32(%0: !i32, %1: !i32) -> !i32 {
    %2 = divsi %0, %1 : !i32
    func.return %2
  }
  %fn_div64 = func.func @div64(%0: !i64, %1: !i64) -> !i64 {
    %2 = divsi %0, %1 : !i64
    func.return %2
  }
  %fn_divu32 = func.func @divu32(%0: !i32, %1: !i32) -> !i32 {
    %2 = divui %0, %1 : !i32
    func.return %2
  }
  %fn_divu64 = func.func @divu64(%0: !i64, %1: !i64) -> !i64 {
    %2 = divui %0, %1 : !i64
    func.return %2
  }
  module_end
}

// The quotient lands in the low dividend register (rax/eax), which is also the
// integer func.return register, so no move follows the division.

// ISEL: sign_extend_dividend32
// ISEL: signed_divide32
// ISEL: sign_extend_dividend
// ISEL: signed_divide
// ISEL: zero_extend_dividend32
// ISEL: unsigned_divide32
// ISEL: zero_extend_dividend
// ISEL: unsigned_divide

// REGALLOC-LABEL: name = "div64"
// REGALLOC: sign_extend_dividend {rax = %[[D:[0-9]+]]:rax, rdx_def = rdx}
// REGALLOC: signed_divide {dst = %{{[0-9]+}}:rsi, rax = %{{[0-9]+}}:rax, rdx = rdx, rax_def = %{{[0-9]+}}:rax, rdx_def = rdx}
// REGALLOC: asm.vret
