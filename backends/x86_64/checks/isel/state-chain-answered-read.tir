// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Two reads of one slot, the second observing what the first left, and the
// second one's state is the loop body's dependency result. The cover answers
// both from the write, so both reads go and the tile keeps the write's chain.
// A region names its results in no use list: the rename that hands an answered
// read's readers the state it observed has to reach the body's result too, or
// the body hands back a state whose definition is gone and nothing is left
// demanding the write.

// A runtime bound keeps the loop and its state edges visible to selection.
module {
  %fn_f = func.func @f(%0: !i32, %limit: !i32) -> !i32 {
    %1 = ptr.alloca {size = 4, align = 4} : !ptr.p<!i32>
    %2 = constant {value = 0} : !i32
    %3 = constant {value = 1} : !i32
    %4 = constant {value = 4} : !i32
    %5 = state.entry_state : !state<memory>
    %6, %7, %8 = scf.for %9 = %2 to %limit step %3 (%10 = %0, %11 = %5) {
      %12 = ptr.store %4, %1 state(%11)
      %13, %14 = ptr.load %1 state(%12) : !i32
      %15, %16 = ptr.load %1 state(%14) : !i32
      -> %10, %16
    }
    -> %7, %8
  }
  module_end
}

// The stored constant is defined ahead of the loop, as the IR has it.
// CHECK: x86_64.mov_imm32 {dst = %[[FOUR:[0-9]+]]:GPR32, imm = 4}
// CHECK: ^bb{{[0-9]+}}(%[[ENTERED:[0-9]+]]: !state<memory>):
// CHECK-NEXT: %[[WRITTEN:[0-9]+]] = x86_64.mov_store32 {{.*}}src = %[[FOUR]]:GPR32} state(%[[ENTERED]])
// CHECK: asm.vbr {{.*}} %[[WRITTEN]] ^bb1
