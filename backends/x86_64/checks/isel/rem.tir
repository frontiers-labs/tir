// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s --check-prefix=ISEL
// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s --check-prefix=REGALLOC

module {
  %fn_rem32 = func.func @rem32(%0: !i32, %1: !i32) -> !i32 {
    %2 = remsi %0, %1 : !i32
    func.return %2
  }
  %fn_rem64 = func.func @rem64(%0: !i64, %1: !i64) -> !i64 {
    %2 = remsi %0, %1 : !i64
    func.return %2
  }
  %fn_remu32 = func.func @remu32(%0: !i32, %1: !i32) -> !i32 {
    %2 = remui %0, %1 : !i32
    func.return %2
  }
  %fn_remu64 = func.func @remu64(%0: !i64, %1: !i64) -> !i64 {
    %2 = remui %0, %1 : !i64
    func.return %2
  }
  %fn_divrem64 = func.func @divrem64(%0: !i64, %1: !i64) -> !i64 {
    %2 = divsi %0, %1 : !i64
    %3 = remsi %0, %1 : !i64
    %4 = addi %2, %3 : !i64
    func.return %4
  }
  module_end
}

// The remainder is read out of the high register (rdx/edx) the division writes,
// so the same idiv/div serves it: no imul/sub recomputation.

// ISEL: sign_extend_dividend32
// ISEL-NEXT: signed_divide32
// ISEL-SAME: edx_def = %[[R32:[0-9]+]]:GPR32, pins = {eax = GPR32[0], edx_def = GPR32[2]}
// ISEL: sign_extend_dividend
// ISEL-NEXT: signed_divide
// ISEL-SAME: rdx_def = %[[R64:[0-9]+]]:GPR, pins = {rax = GPR[0], rdx_def = GPR[2]}
// ISEL: zero_extend_dividend32
// ISEL-NEXT: unsigned_divide32
// ISEL: zero_extend_dividend
// ISEL-NEXT: unsigned_divide

// A quotient and a remainder of the same operands are the two results of one
// division.
// ISEL-LABEL: name = "divrem64"
// ISEL: sign_extend_dividend
// ISEL-NEXT: signed_divide {{.*}}rax_def = %[[Q:[0-9]+]]:GPR, rdx_def = %[[R:[0-9]+]]:GPR
// ISEL-NOT: signed_divide
// ISEL: asm.vret

// The remainder register (rdx) differs from the func.return register (rax), so a
// move copies it into place before the func.return.
// REGALLOC-LABEL: name = "rem64"
// REGALLOC: signed_divide {dst = %{{[0-9]+}}:rsi, rax = %{{[0-9]+}}:rax, rdx = rdx, rax_def = rax, rdx_def = %{{[0-9]+}}:rdx}
// REGALLOC: mov {dst = %{{[0-9]+}}:rax, src = %{{[0-9]+}}:rdx}
// REGALLOC: asm.vret
