// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A join block argument is an anchor: whatever the arms compute, the incoming
// edges carry the value into the join, which reads it as its block argument.
// Selection forms no value rule over the merge.

module {
  %fn_pure = func.func @pure(%c: !i64, %d: !i64, %a: !i64, %b: !i64, %z: !i64) -> !i64 {
    %cond = cmpi %c, %d {predicate = "slt"} : !i1
    cfg.cond_br %cond, ^bb1, ^bb2
  ^bb1:
    cfg.br ^bb3(%a : !i64)
  ^bb2:
    cfg.br ^bb3(%b : !i64)
  ^bb3(%selected: !i64):
    %result = addi %selected, %z : !i64
    func.return %result
  }

  %fn_trapping = func.func @trapping(%c: !i64, %d: !i64, %a: !i64, %b: !i64, %z: !i64) -> !i64 {
    %cond = cmpi %c, %d {predicate = "slt"} : !i1
    cfg.cond_br %cond, ^bb1, ^bb2
  ^bb1:
    cfg.br ^bb3(%a : !i64)
  ^bb2:
    %quotient = divsi %b, %z : !i64
    cfg.br ^bb3(%quotient : !i64)
  ^bb3(%selected: !i64):
    %result = addi %selected, %z : !i64
    func.return %result
  }
  module_end
}

// CHECK:      asm.symbol {name = "pure"
// CHECK-NOT:  x86_64.cmov
// CHECK:      asm.vbr %{{[0-9]+}} ^[[JOIN:bb[0-9]+]]
// CHECK:      ^[[JOIN]](%{{[0-9]+}}: !i64):
// CHECK-NEXT: x86_64.add {dst = %virt{{[0-9]+}}:GPR, dst_tied = %virt{{[0-9]+}}:GPR, src = %virt{{[0-9]+}}:GPR}
// CHECK:      asm.vbr %{{[0-9]+}} ^[[JOIN]]

// CHECK:      asm.symbol {name = "trapping"
// CHECK-NOT:  x86_64.cmov
// CHECK:      x86_64.signed_divide
