// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

module {
  %fn_from_signed = func.func @from_signed(%0: !i32) -> !f32 {
    %1 = fp.from_si %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %1
  }
  %fn_from_signed64 = func.func @from_signed64(%0: !i64) -> !f32 {
    %1 = fp.from_si %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %1
  }
  %fn_from_unsigned = func.func @from_unsigned(%0: !i32) -> !f32 {
    %1 = fp.from_ui %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %1
  }
  %fn_to_signed = func.func @to_signed(%0: !f32) -> !i32 {
    %1 = fp.to_si %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    func.return %1
  }
  %fn_to_signed64 = func.func @to_signed64(%0: !f32) -> !i64 {
    %1 = fp.to_si %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i64
    func.return %1
  }
  %fn_to_unsigned = func.func @to_unsigned(%0: !f32) -> !i32 {
    %1 = fp.to_ui %0 {semantics = {exceptions = "ignore", invalid = "indeterminate", kind = "to_integer", rounding = "toward_zero", subnormals = "gradual"}} : !i32
    func.return %1
  }
  %fn_less = func.func @less(%0: !f32, %1: !f32) -> !i1 {
    %2 = fp.cmp %0, %1 {predicate = "olt", semantics = {behavior = "quiet", exceptions = "ignore", kind = "comparison", subnormals = "gradual"}} : !i1
    func.return %2
  }
  %fn_constant = func.func @constant() -> !f32 {
    %0 = fp.constant {bits = 1069547520} : !f32
    func.return %0
  }
  %fn_bits_to_float = func.func @bits_to_float(%0: !i32) -> !f32 {
    %1 = bitcast %0 : !f32
    func.return %1
  }
  %fn_float_to_bits = func.func @float_to_bits(%0: !f32) -> !i32 {
    %1 = bitcast %0 : !i32
    func.return %1
  }
  module_end
}

// CHECK: x86_64.cvtsi2ss32 {dst = %{{[0-9]+}}:XMM32, src = %{{[0-9]+}}:GPR}
// CHECK: x86_64.cvtsi2ss64 {dst = %{{[0-9]+}}:XMM32, src = %{{[0-9]+}}:GPR}
// CHECK: x86_64.movzxd
// CHECK-NEXT: x86_64.cvtsi2ss64
// CHECK: x86_64.cvttss2si32 {dst = %{{[0-9]+}}:GPR32, src = %{{[0-9]+}}:XMM}
// CHECK: x86_64.cvttss2si64 {dst = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:XMM}
// CHECK: x86_64.cvttss2si64
// CHECK: x86_64.ucomiss {lhs = %{{[0-9]+}}:XMM, rhs = %{{[0-9]+}}:XMM}
// CHECK-NEXT: x86_64.seta
// CHECK: x86_64.mov_imm32
// CHECK-NEXT: x86_64.movd_xmm_gpr32
// CHECK-LABEL: asm.symbol {name = "bits_to_float"
// CHECK: x86_64.movd_xmm_gpr32
// CHECK-LABEL: asm.symbol {name = "float_to_bits"
// CHECK: x86_64.movd_gpr32_xmm
