// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

module {
  %fn_divide_by_four = func.func @divide_by_four(%0: !i64) -> !i64 {
    %1 = constant {value = 4} : !i64
    %2 = divsi %0, %1 : !i64
    func.return %2
  }
  module_end
}

// CHECK: x86_64.mov_imm
// CHECK: x86_64.sign_extend_dividend
// CHECK: x86_64.signed_divide
