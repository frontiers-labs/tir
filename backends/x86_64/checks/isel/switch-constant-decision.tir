// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | tir mc --march=x86_64 --stage=isel | filecheck %s

// A gate's decision is read by the tests its destruction branches on, not by any
// operation of the block. The comparison of two constants below folds to a
// literal, which decides the gate: the arm it takes follows the entry, and
// neither the literal nor a branch on it is emitted.

module {
  %fn_g = func.func @g(%0: !i64) -> !i64 {
    %1 = constant {value = 0} : !i32
    %z = constant {value = 0} : !i32
    %c = cmpi %1, %z {predicate = "eq"} : !i1
    cfg.cond_br %c, ^bb1, ^bb2
  ^bb1:
    %3 = addi %0, %0 : !i64
    cfg.br ^bb3(%3 : !i64)
  ^bb2:
    cfg.br ^bb3(%0 : !i64)
  ^bb3(%r: !i64):
    func.return %r
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "g"
// CHECK-NEXT: x86_64.add {dst = %[[SUM:[0-9]+]]:GPR, dst_tied = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:GPR}
// CHECK-NEXT: asm.vret %[[SUM]]
// CHECK-NOT: x86_64.j
