// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A loop tested before each iteration destructs into its test region followed by
// its body: the test's own terminator becomes the branch, carrying what it
// forwards into the body and the same values out to the continuation, and the
// body's yield is the back edge. The taken edge carries assignments, so it goes
// through a block only that edge reaches.

module {
  %fn_sum = func.func @sum(%n: !i64, %acc: !i64) -> !i64 {
    %r = scf.while iter_args(%a = %acc, %i = %n) -> !i64, !i64 {
      %z = constant {value = 0} : !i64
      %c = cmpi %i, %z {predicate = "sgt"} : !i1
      scf.condition %c, %a, %i
    } do scope(%tok)(%ca, %ci) {
      %one = constant {value = 1} : !i64
      %na = addi %ca, %ci : !i64
      %ni = subi %ci, %one : !i64
      scf.yield %na, %ni
    }
    func.return %r
  }
  module_end
}

// CHECK-NOT: scf.
// CHECK: asm.vbr %1, %0 ^[[TEST:bb[0-9]+]]
// CHECK: ^[[TEST]](%{{[0-9]+}}: !i64, %{{[0-9]+}}: !i64):
// The test fuses into the branch exactly as a guarded terminator's would.
// CHECK-NEXT: x86_64.cmp_imm8s {dst = %virt{{[0-9]+}}:GPR, imm = 0}
// CHECK-NEXT: x86_64.jg {imm = ^[[ENTER:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr %{{[0-9]+}}, %{{[0-9]+}} ^[[EXIT:bb[0-9]+]]
// CHECK: ^[[BODY:bb[0-9]+]](%{{[0-9]+}}: !i64, %{{[0-9]+}}: !i64):
// CHECK: x86_64.add
// CHECK: asm.vbr %{{[0-9]+}}, %{{[0-9]+}} ^[[TEST]]
// CHECK: ^[[EXIT]](%{{[0-9]+}}: !i64, %{{[0-9]+}}: !i64):
// CHECK-NEXT: asm.vret
// CHECK: ^[[ENTER]]:
// CHECK-NEXT: asm.vbr %{{[0-9]+}}, %{{[0-9]+}} ^[[BODY]]
// CHECK-NOT: scf.
