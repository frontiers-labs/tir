// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// An arm-local value does not escape its arm. The product the arm computes and
// the one computed after the gate are the same term, so they share an e-class,
// but an arm's register holds it only where the arm has run. The product is
// computed once where both readers see it, ahead of the gate: the arm and what
// follows the gate read that register.

module {
  %fn_no_escape = func.func @no_escape(%c: !i1, %a: !i64, %b: !i64) -> !i64 {
    cfg.cond_br %c, ^bb1, ^bb2
  ^bb1:
    %x = muli %a, %b : !i64
    %y = addi %x, %a : !i64
    cfg.br ^bb3(%y : !i64)
  ^bb2:
    cfg.br ^bb3(%a : !i64)
  ^bb3(%r: !i64):
    %z = muli %a, %b : !i64
    %w = subi %r, %z : !i64
    func.return %w
  }
  module_end
}

// CHECK: x86_64.imul {dst = %[[PRODUCT:[0-9]+]]:GPR, dst_tied = %{{[0-9]+}}:GPR, src = %{{[0-9]+}}:GPR}
// CHECK-NEXT: x86_64.test_imm32
// CHECK-NEXT: x86_64.jne {imm = ^[[THEN:bb[0-9]+]]}
// CHECK: ^[[CONT:bb[0-9]+]](%{{[0-9]+}}: !x86_64.GPR):
// CHECK-NEXT: x86_64.sub {dst = %{{[0-9]+}}:GPR, dst_tied = %{{[0-9]+}}:GPR, src = %[[PRODUCT]]:GPR}
// CHECK-NEXT: asm.vret
// CHECK: ^[[THEN]]:
// CHECK-NEXT: x86_64.add {dst = %{{[0-9]+}}:GPR, dst_tied = %{{[0-9]+}}:GPR, src = %[[PRODUCT]]:GPR}
// CHECK-NEXT: asm.vbr %{{[0-9]+}} ^[[CONT]]
// CHECK-NOT: x86_64.imul
