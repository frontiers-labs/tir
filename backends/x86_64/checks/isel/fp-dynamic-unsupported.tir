// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: not tir mc --march=x86_64 --stage=isel %s 2>&1 | filecheck %s
// RUN: not tir mc --march=arm64 --stage=isel %s 2>&1 | filecheck %s

module {
  %main = func.func @main(%a: !f64, %b: !f64) -> !f64 {
    %env = state.entry_state : !state<fp.env>
    %value, %next = fp.add %a, %b state(%env) {semantics = {rounding = "dynamic"}} : !f64
    func.return %value state(%next)
  }
  module_end
}

// CHECK: fp.add does not support dynamic rounding
