// RUN: env TIR_VERIFY_AXIOMS=1 tir mc --march=x86_64 --stage=isel %s | filecheck %s

module {
  %fn_constant_address = func.func @constant_address(%0: !ptr.p<!i32>) -> !i32 {
    %zero = constant {value = 0} : !i64
    %three = constant {value = 3} : !i64
    %four = constant {value = 4} : !i64
    %scaled = muli %three, %four : !i64
    %offset = addi %zero, %scaled : !i64
    %address = ptr.ptradd %0, %offset : !ptr.p<!i32>
    %result = ptr.load %address : !i32
    func.return %result
  }

  %fn_neutral = func.func @neutral(%0: !i64) -> !i64 {
    %zero = constant {value = 0} : !i64
    %one = constant {value = 1} : !i64
    %scaled = muli %0, %one : !i64
    %result = addi %zero, %scaled : !i64
    func.return %result
  }

  %fn_nested_constants = func.func @nested_constants(%0: !i64) -> !i64 {
    %three = constant {value = 3} : !i64
    %four = constant {value = 4} : !i64
    %inner = addi %0, %three : !i64
    %result = addi %inner, %four : !i64
    func.return %result
  }
  %fn_zero_mask = func.func @zero_mask(%0: !i64, %1: !i64) -> !i64 {
    %zero = constant {value = 0} : !i64
    %masked = andi %0, %zero : !i64
    %result = ori %1, %masked : !i64
    func.return %result
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "constant_address"
// CHECK-NOT: x86_64.imul
// CHECK-NOT: x86_64.lea
// CHECK: x86_64.mov_load32_disp {dst = %{{[0-9]+}}:GPR32, base = %{{[0-9]+}}:GPR, imm = 12}
// CHECK-LABEL: asm.symbol {name = "neutral", arg_regs = [%[[ARG:[0-9]+]]:GPR]
// CHECK-NOT: x86_64.imul
// CHECK-NOT: x86_64.add
// CHECK-NOT: x86_64.lea
// CHECK: asm.vret %[[ARG]]
// CHECK-LABEL: asm.symbol {name = "nested_constants"
// CHECK-NOT: imm = 3
// CHECK-NOT: imm = 4
// CHECK: x86_64.lea_base_disp {dst = %{{[0-9]+}}:GPR, base = %{{[0-9]+}}:GPR, imm = 7}
// CHECK-LABEL: asm.symbol {name = "zero_mask", arg_regs = [%{{[0-9]+}}:GPR, %[[VALUE:[0-9]+]]:GPR]
// CHECK-NOT: x86_64.and
// CHECK-NOT: x86_64.or
// CHECK: asm.vret %[[VALUE]]
