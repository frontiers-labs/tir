// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A gate with a single arm always runs it: there is no case to test, so nothing
// decides anything and the entry jumps straight into the arm. No CFG spells this
// shape, so the fixture writes the gate itself.

module {
  %fn_only_default = func.func @only_default(%p: !i32) -> !i32 {
    %r = scf.switch %p () {
      %d = addi %p, %p : !i32
      -> %d
    }
    func.return %r
  }
  module_end
}

// CHECK-NOT: scf.
// Nothing tests the decision: the entry jumps straight into the only arm.
// CHECK-NOT: cmp
// CHECK: asm.vbr ^[[ARM:bb[0-9]+]]
// CHECK: ^[[ARM]]:
// CHECK-NEXT: x86_64.add32
// CHECK-NOT: scf.
