// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir opt --pass restructure-nodes,instcombine-nodes %s | tir mc --march=x86_64 --stage=isel | filecheck %s

// Both gates test constants. The compares fold, so each gate is decided and
// only the arm it takes is selected: no constant is materialized, at any
// width, and nothing is compared.

module {
  %fn_clip = func.func @clip(%v: !i32) -> !i32 {
    %a = constant {value = 0} : !i32
    %b = constant {value = 0} : !i32
    %c1 = cmpi %a, %b {predicate = "ne"} : !i1
    cfg.cond_br %c1, ^bb1, ^bb2
  ^bb1:
    %m1 = constant {value = 255} : !i32
    %r1 = andi %v, %m1 : !i32
    cfg.br ^bb3(%r1 : !i32)
  ^bb2:
    %m2 = constant {value = 65535} : !i32
    %r2 = andi %v, %m2 : !i32
    cfg.br ^bb3(%r2 : !i32)
  ^bb3(%r: !i32):
    %d = constant {value = 1} : !i32
    %e = constant {value = 0} : !i32
    %c2 = cmpi %d, %e {predicate = "ne"} : !i1
    cfg.cond_br %c2, ^bb4, ^bb5
  ^bb4:
    %m3 = constant {value = 255} : !i32
    %r3 = andi %r, %m3 : !i32
    cfg.br ^bb6(%r3 : !i32)
  ^bb5:
    %m4 = constant {value = 65535} : !i32
    %r4 = andi %r, %m4 : !i32
    cfg.br ^bb6(%r4 : !i32)
  ^bb6(%rr: !i32):
    func.return %rr
  }
  module_end
}

// CHECK-NOT: x86_64.mov_imm
// CHECK-NOT: x86_64.cmp
// CHECK: x86_64.and_imm32 {dst = %[[LOW:[0-9]+]]:GPR32, dst_tied = %{{[0-9]+}}:GPR, imm = 65535}
// CHECK-NEXT: x86_64.and_imm32 {dst = %[[BYTE:[0-9]+]]:GPR32, dst_tied = %[[LOW]]:GPR32, imm = 255}
// CHECK-NEXT: asm.vret %[[BYTE]]
