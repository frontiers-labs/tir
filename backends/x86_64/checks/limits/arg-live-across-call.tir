// RUN: tir mc --march=x86_64 --stage=regalloc %s

// Incoming argument registers constrain the function boundary, not the entire
// SSA live range. The argument remains allocatable when it is live across a
// call that clobbers its incoming register.

module {
  %fn_g = func.declare @g(!i64) -> !i64
  %fn_f = func.func @f(%0:!i64) -> !i64 {
    %r = func.call %fn_g(%0 : !i64) -> !i64
    %res = muli %0, %r : !i64
    func.return %res
  }
  module_end
}
