// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Signed extension uses the direct instruction. Zero-extension selects the
// mask form: the 0xFFFFFFFF constant is an ordinary materializable class, so
// the cover roots a `movabs` for it and `and`s the source — never a by-`cl`
// shift (a register the behavior reads by path reads that register's value).

module {
  func @se(%0: !i32) -> !i64 {
    %1 = extsi %0 : !i64
    return %1
  }
  func @ze(%0: !i32) -> !i64 {
    %1 = extui %0 : !i64
    return %1
  }
  module_end
}

// CHECK-NOT: rcx = 32
// CHECK: x86_64.movsxd
// CHECK: x86_64.movabs {dst = %virt[[MASK:[0-9]+]]:GPR, imm = 4294967295}
// CHECK: x86_64.and {dst = %virt{{[0-9]+}}:GPR, dst_tied = %virt[[MASK]]:GPR, src = %virt{{[0-9]+}}:GPR}
