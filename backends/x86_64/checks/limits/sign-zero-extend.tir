// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// Signed and unsigned extension use their direct instructions.

module {
  func @se(%0: !i32) -> !i64 {
    %1 = extsi %0 : !i64
    return %1
  }
  func @ze(%0: !i32) -> !i64 {
    %1 = extui %0 : !i64
    return %1
  }
  module_end
}

// CHECK: x86_64.movsxd
// CHECK: x86_64.movzxd {dst = %virt{{[0-9]+}}:GPR, src = %virt{{[0-9]+}}:GPR32}
