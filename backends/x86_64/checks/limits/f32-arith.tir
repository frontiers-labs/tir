// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s --check-prefix=ENC

module {
  %fn_f = func.func @f(%0:!f32, %1:!f32) -> !f32 {
    %2 = fp.add %0, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %3 = fp.mul %2, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %4 = fp.sub %3, %0 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    %5 = fp.div %4, %1 {semantics = {exceptions = "ignore", kind = "arithmetic", nan = "any_quiet", rounding = "nearest_even", subnormals = "gradual", tininess = "after_rounding"}} : !f32
    func.return %5
  }
  module_end
}

// CHECK:      x86_64.addss {dst = %[[V2:[0-9]+]]:XMM32, dst_tied = %[[V0:[0-9]+]]:XMM, src = %[[V1:[0-9]+]]:XMM}
// CHECK-NEXT: x86_64.mulss {dst = %[[V3:[0-9]+]]:XMM32, dst_tied = %[[V2]]:XMM32, src = %[[V1]]:XMM}
// CHECK-NEXT: x86_64.subss {dst = %[[V4:[0-9]+]]:XMM32, dst_tied = %[[V3]]:XMM32, src = %[[V0]]:XMM}
// CHECK-NEXT: x86_64.divss {dst = %[[V5:[0-9]+]]:XMM32, dst_tied = %[[V4]]:XMM32, src = %[[V1]]:XMM}
// CHECK-NEXT: asm.vret

// ENC: .section .text
// ENC-NEXT: f:
// ENC-NEXT: [0xF3, 0x0F, 0x10, 0xD0]
// ENC-NEXT: [0xF3, 0x0F, 0x58, 0xD1]
// %2 dies at the multiply and %3 at the subtract, so both ties coalesce and
// run in place on xmm2.
// ENC-NEXT: [0xF3, 0x0F, 0x59, 0xD1]
// ENC-NEXT: [0xF3, 0x0F, 0x5C, 0xD0]
// ENC-NEXT: [0xF3, 0x0F, 0x10, 0xC2]
// ENC-NEXT: [0xF3, 0x0F, 0x5E, 0xC1]
// ENC-NEXT: [0xC3]
