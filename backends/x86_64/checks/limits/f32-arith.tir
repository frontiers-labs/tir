// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s --check-prefix=ENC

module {
  func @f(%0:!f32, %1:!f32) -> !f32 {
    %2 = addf %0, %1 : !f32
    %3 = mulf %2, %1 : !f32
    %4 = subf %3, %0 : !f32
    %5 = divf %4, %1 : !f32
    return %5
  }
  module_end
}

// CHECK:      x86_64.addss {dst = %virt2:XMM32, dst_tied = %virt0:XMM32, src = %virt1:XMM32}
// CHECK-NEXT: x86_64.mulss {dst = %virt3:XMM32, dst_tied = %virt1:XMM32, src = %virt2:XMM32}
// CHECK-NEXT: x86_64.subss {dst = %virt4:XMM32, dst_tied = %virt3:XMM32, src = %virt0:XMM32}
// CHECK-NEXT: x86_64.divss {dst = %virt5:XMM32, dst_tied = %virt4:XMM32, src = %virt1:XMM32}
// CHECK-NEXT: asm.vret

// ENC: .section .text
// ENC-NEXT: f:
// ENC-NEXT: [0xF3, 0x0F, 0x10, 0xD0]
// ENC-NEXT: [0xF3, 0x0F, 0x58, 0xD1]
// ENC-NEXT: [0xF3, 0x0F, 0x10, 0xD9]
// ENC-NEXT: [0xF3, 0x0F, 0x59, 0xDA]
// ENC-NEXT: [0xF3, 0x0F, 0x10, 0xD3]
// ENC-NEXT: [0xF3, 0x0F, 0x5C, 0xD0]
// ENC-NEXT: [0xF3, 0x0F, 0x10, 0xC2]
// ENC-NEXT: [0xF3, 0x0F, 0x5E, 0xC1]
// ENC-NEXT: [0xC3]
