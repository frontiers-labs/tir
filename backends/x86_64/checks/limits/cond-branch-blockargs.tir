// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// The two edges into the join carry different values: one rides the fallthrough
// branch directly, the other is forwarded through the block the conditional
// branch targets. Register allocation lowers each forwarded value to a copy.

module {
  func.func @f(%0:!i64, %1:!i64, %c:!i1) -> !i64 {
    cfg.cond_br %c, ^bb1(%0 : !i64), ^bb2(%1 : !i64)
  ^bb1(%a: !i64):
    func.return %a
  ^bb2(%b: !i64):
    func.return %b
  }
  module_end
}

// CHECK:      x86_64.mov {dst = rax, src = rsi}
// CHECK-NEXT: x86_64.test
// CHECK-NEXT: x86_64.jne {imm = ^[[TAKEN:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[JOIN:bb[0-9]+]]
// CHECK:      ^[[TAKEN]]:
// CHECK-NEXT: x86_64.mov {dst = rax, src = rdi}
// CHECK-NEXT: asm.vbr ^[[JOIN]]
