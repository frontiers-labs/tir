// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// SysV passes the seventh integer argument at rsp before the call. The stable
// frame reserves its 16-byte outgoing area once; the saved register is pushed
// outside that area and already contributes to call-site alignment.

module {
  %fn_g = func.declare @g(!i64, !i64, !i64, !i64, !i64, !i64, !i64) -> !i64
  %fn_f = func.func @f(%0:!i64) -> !i64 {
    %r = func.call %fn_g(%0, %0, %0, %0, %0, %0, %0 : !i64, !i64, !i64, !i64, !i64, !i64, !i64) -> !i64
    func.return %r
  }
  module_end
}

// CHECK: x86_64.add_imm {dst = rsp, imm = -16}
// CHECK: x86_64.mov_store_disp {base = rsp, imm = 0, src = {{.*}}}
// CHECK: asm.vcall {callee = "g"
// CHECK: x86_64.add_imm {dst = rsp, imm = 16}
