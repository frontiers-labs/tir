// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s

// A cmpi materialized as a value (not fused into a branch) lowers to `cmp` +
// `setcc`: the flag-definer (`cmp`) is composed with the flag-reading value
// materializer (`setl`) into an `slt`-style value rule. Works for i32 and i64
// (the setcc and cmp are both available in X86_64), and
// the boolean is matched regardless of setcc's 8-bit destination width.

module {
  %fn_f = func.func @f(%0:!i64, %1:!i64) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  %fn_eq_i16 = func.func @eq_i16(%0: !i16) -> !i1 {
    %1 = constant {value = 0} : !i16
    %2 = cmpi %0, %1 {predicate = "eq"} : !i1
    func.return %2
  }
  %fn_slt_i16 = func.func @slt_i16(%0: !i16, %1: !i16) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  %fn_slt_i8 = func.func @slt_i8(%0: !i8, %1: !i8) -> !i1 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    func.return %2
  }
  module_end
}

// CHECK: asm.symbol {name = "f"
// CHECK: x86_64.cmp
// CHECK: x86_64.setl
// CHECK: asm.symbol {name = "eq_i16"
// CHECK: x86_64.cmp_imm16
// CHECK: x86_64.sete
// CHECK: asm.symbol {name = "slt_i16"
// CHECK: x86_64.cmp16
// CHECK: x86_64.setl
// CHECK: asm.symbol {name = "slt_i8"
// CHECK: x86_64.cmp8
// CHECK: x86_64.setl
