// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// SysV classifies f64 parameters in the XMM register file, beginning at xmm0.

module {
  %fn_addf = func.func @addf(%0: !f64, %1: !f64) -> !f64 {
    %2 = addf %0, %1 : !f64
    func.return %2
  }
  module_end
}

// CHECK: arg_regs = [%[[V0:[0-9]+]]:XMM, %[[V1:[0-9]+]]:XMM]
// CHECK: x86_64.addsd {dst = %{{[0-9]+}}:xmm0, dst_tied = %{{[0-9]+}}:xmm0, src = %{{[0-9]+}}:xmm1}
