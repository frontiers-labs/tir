// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// The ninth SysV f64 argument is stored to the outgoing stack area from its
// XMM value.

module {
  %fn_consume = func.declare @consume(!f64, !f64, !f64, !f64, !f64, !f64, !f64, !f64, !f64) -> !f64
  %fn_forward = func.func @forward(%0: !f64) -> !f64 {
    %1 = func.call %fn_consume(%0, %0, %0, %0, %0, %0, %0, %0, %0 : !f64, !f64, !f64, !f64, !f64, !f64, !f64, !f64, !f64) -> !f64
    func.return %1
  }
  module_end
}

// CHECK: x86_64.add_imm {dst = rsp, imm = -24}
// CHECK: x86_64.movsd {dst = xmm{{[0-9]+}}, src = xmm0}
// CHECK: x86_64.movsd_store_disp {base = rsp, imm = 0, src = xmm{{[0-9]+}}}
// CHECK: asm.vcall {callee = "consume"
// CHECK: x86_64.add_imm {dst = rsp, imm = 24}
