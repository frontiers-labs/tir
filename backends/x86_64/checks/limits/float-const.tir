// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

module {
  %fn_f = func.func @f() -> !f64 {
    %0 = fp.constant {bits = 4609434218613702656} : !f64
    func.return %0
  }
  module_end
}

// CHECK: x86_64.movabs
// CHECK: x86_64.movq_xmm_gpr
// CHECK-NOT: fp.constant
