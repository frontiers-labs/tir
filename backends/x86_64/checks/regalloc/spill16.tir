// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s --check-prefix=COPY
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s --check-prefix=ENC

// The 16-bit values live across the call outnumber the callee-saved registers
// of GPR16low (bx, bp, si, di), so they travel through the stack frame in
// 16-bit slots.

module {
  func.declare @external() -> !i64
  func.func @pressure16(%0: !i16) -> !i16 {
    %1 = addi %0, %0 : !i16
    %2 = subi %1, %0 : !i16
    %3 = addi %2, %0 : !i16
    %4 = subi %3, %0 : !i16
    %5 = addi %4, %0 : !i16
    %6 = subi %5, %0 : !i16
    %7 = addi %6, %0 : !i16
    %8 = func.call @external() -> !i64
    %9 = addi %1, %2 : !i16
    %10 = addi %3, %4 : !i16
    %11 = addi %5, %6 : !i16
    %12 = addi %9, %10 : !i16
    %13 = addi %11, %7 : !i16
    %14 = addi %12, %13 : !i16
    func.return %14
  }
  module_end
}

// COPY: x86_64.mov_store16_disp
// COPY: x86_64.mov_load16_disp

// The frame base is rsp, so the disp32 forms carry a SIB byte (mod=10, rm=100,
// SIB 0x24) behind the 0x66 prefix and the always-emitted REX byte.
// ENC: [0x66, 0x40, 0x89, 0x84, 0x24
// ENC: [0x66, 0x40, 0x8B, 0x84, 0x24
