// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s --check-prefix=COPY
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s --check-prefix=ENC

// The f32 sibling of float-spill.tir: a scalar single kept live across a call
// spills through the 32-bit movss memory forms (F3 prefix), not movsd.

module {
  %fn_external = func.declare @external() -> !i64
  %fn_pressure = func.func @pressure(%0: !f32) -> !f32 {
    %1 = addf %0, %0 : !f32
    %2 = func.call %fn_external() -> !i64
    %3 = addf %1, %1 : !f32
    func.return %3
  }
  module_end
}

// COPY: x86_64.movss_store_disp
// COPY: x86_64.movss_load_disp

// ENC: [0xF3, 0x40, 0x0F, 0x11, 0x8C, 0x24
// ENC: [0xF3, 0x40, 0x0F, 0x10, 0x8C, 0x24
