// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

module {
  %fn_make_pair = func.declare @make_pair() -> !tuple<!i64, !i64>
  %fn_sum_pair = func.func @sum_pair() -> !i64 {
    %0 = func.call %fn_make_pair() -> !tuple<!i64, !i64>
    %1 = tuple_get %0 {index = 0} : !i64
    %2 = tuple_get %0 {index = 1} : !i64
    %3 = addi %1, %2 : !i64
    func.return %3
  }
  module_end
}

// CHECK:      asm.vcall | %{{[0-9]+}} {callee = "make_pair"
// CHECK:      x86_64.mov {dst = %{{[0-9]+}}:[[LEFT:[a-z0-9]+]], src = rax}
// CHECK-NEXT: x86_64.mov {dst = %{{[0-9]+}}:[[RIGHT:[a-z0-9]+]], src = rdx}
// CHECK:      x86_64.add {dst = %{{[0-9]+}}:rax, dst_tied = %{{[0-9]+}}:rax, src = %{{[0-9]+}}:[[RIGHT]]}
// CHECK:      asm.vret
