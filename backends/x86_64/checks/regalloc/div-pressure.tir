// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// Twelve products, the dividend and the divisor are live across `cdq`, which
// reads the dividend from eax and writes edx: fourteen values and two named
// registers in a file of fifteen. eax and edx pair with nothing at `cdq`, so
// the spiller must count both beside what lives across, and spill one value.

module {
  %fn_f = func.func @f(%x: !i32, %y: !i32) -> !i32 {
    %c0 = constant {value = 3} : !i32
    %a0 = muli %x, %c0 : !i32
    %c1 = constant {value = 4} : !i32
    %a1 = muli %x, %c1 : !i32
    %c2 = constant {value = 5} : !i32
    %a2 = muli %x, %c2 : !i32
    %c3 = constant {value = 6} : !i32
    %a3 = muli %x, %c3 : !i32
    %c4 = constant {value = 7} : !i32
    %a4 = muli %x, %c4 : !i32
    %c5 = constant {value = 8} : !i32
    %a5 = muli %x, %c5 : !i32
    %c6 = constant {value = 9} : !i32
    %a6 = muli %x, %c6 : !i32
    %c7 = constant {value = 10} : !i32
    %a7 = muli %x, %c7 : !i32
    %c8 = constant {value = 11} : !i32
    %a8 = muli %x, %c8 : !i32
    %c9 = constant {value = 12} : !i32
    %a9 = muli %x, %c9 : !i32
    %c10 = constant {value = 13} : !i32
    %a10 = muli %x, %c10 : !i32
    %c11 = constant {value = 14} : !i32
    %a11 = muli %x, %c11 : !i32
    %q = divsi %x, %y : !i32
    %s0 = addi %q, %a0 : !i32
    %s1 = addi %s0, %a1 : !i32
    %s2 = addi %s1, %a2 : !i32
    %s3 = addi %s2, %a3 : !i32
    %s4 = addi %s3, %a4 : !i32
    %s5 = addi %s4, %a5 : !i32
    %s6 = addi %s5, %a6 : !i32
    %s7 = addi %s6, %a7 : !i32
    %s8 = addi %s7, %a8 : !i32
    %s9 = addi %s8, %a9 : !i32
    %s10 = addi %s9, %a10 : !i32
    %s11 = addi %s10, %a11 : !i32
    %r = addi %s11, %y : !i32
    %t = addi %r, %x : !i32
    func.return %t
  }
  module_end
}

// CHECK: x86_64.mov_store32_disp {base = rsp
// CHECK: x86_64.sign_extend_dividend32
// CHECK: x86_64.signed_divide32
// CHECK: x86_64.mov_load32_disp {{.*}}base = rsp
