// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// The copy that lowers a two-address tie is an ordinary coalescable copy: the
// tie asks for one register at both ends, so allocation reads it as an affinity
// and erases the copy wherever it is granted.

module {
  func.func @accumulate(%0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    %3 = addi %2, %1 : !i64
    func.return %3
  }
  func.func @keep(%0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    %3 = addi %2, %0 : !i64
    %4 = muli %2, %3 : !i64
    func.return %4
  }
  module_end
}

// %0 dies at the first add, so that tie coalesces and the add runs in place.
// %1 is live across it, so the second add's tie still copies.
// CHECK-LABEL: accumulate
// CHECK:      x86_64.mov {dst = rax, src = rsi}
// CHECK-NEXT: x86_64.add {dst = rdi, src = rax}
// CHECK-NEXT: x86_64.add {dst = rax, src = rdi}
// CHECK-NEXT: asm.vret

// %0 is read again after the first add, so that tie's ends interfere and its
// copy survives; the ties of the second add and the imul still coalesce.
// CHECK-LABEL: keep
// CHECK:      x86_64.mov {dst = rax, src = rdi}
// CHECK-NEXT: x86_64.add {dst = rax, src = rsi}
// CHECK-NEXT: x86_64.add {dst = rdi, src = rax}
// CHECK-NEXT: x86_64.imul {dst = rax, src = rdi}
// CHECK-NEXT: asm.vret
