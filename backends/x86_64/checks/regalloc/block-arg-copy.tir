// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// The copies destructing block arguments are coalescing candidates like any
// other pre-allocation copy: the forwarded value and the parameter it feeds
// want one register, and the copy must disappear once they get it.

module {
  func.func @fwd(%c: !i1, %0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    cfg.cond_br %c, ^bb1(%1 : !i64), ^bb2
  ^bb2:
    cfg.br ^bb1(%2 : !i64)
  ^bb1(%3: !i64):
    %4 = addi %3, %3 : !i64
    func.return %4
  }
  module_end
}

// The sum is computed straight into the register the join reads its parameter
// from, so the edge carrying it needs no copy at all; the other edge keeps one.
// CHECK:      x86_64.add {dst = [[V:r[a-z0-9]+]], src = rdx}
// CHECK-NEXT: x86_64.test
// CHECK-NEXT: x86_64.jne {imm = ^[[OTHER:bb[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[JOIN:bb[0-9]+]]
// CHECK:      ^[[JOIN]]
// CHECK: x86_64.add {dst = {{r[a-z0-9]+}}, src = [[V]]}
// CHECK:      ^[[OTHER]]:
// CHECK-NEXT: x86_64.mov {dst = [[V]], src = rdx}
