// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s
// RUN: tir mc --march=x86_64 --shuffle-machine-order --filetype=obj -o /dev/null %s

// Both loop shapes let the carried load value use the header register. Neither
// needs a back-edge copy after dead loop arguments are removed.

module {
  %fn_walk = func.func @load_before_condition(%0: !ptr.p, %1: !i64) -> !i64 {
    %c0 = constant {value = 0} : !i64
    cfg.br ^loop(%0 : !ptr.p)
  ^loop(%p: !ptr.p):
    %next = ptr.load %p : !ptr.p
    %more = cmpi %1, %c0 {predicate = "ne"} : !i1
    cfg.cond_br %more, ^loop(%next : !ptr.p), ^exit
  ^exit:
    func.return %1
  }
  %fn_step = func.func @load_on_back_edge(%0: !ptr.p, %1: !i64) -> !i64 {
    %c0 = constant {value = 0} : !i64
    cfg.br ^loop(%0 : !ptr.p)
  ^loop(%p: !ptr.p):
    %more = cmpi %1, %c0 {predicate = "ne"} : !i1
    cfg.cond_br %more, ^step, ^exit
  ^step:
    %next = ptr.load %p : !ptr.p
    cfg.br ^loop(%next : !ptr.p)
  ^exit:
    func.return %1
  }
  module_end
}

// CHECK-LABEL: asm.symbol {name = "load_before_condition"
// CHECK: ^[[HEAD:bb[0-9]+]](%[[P:[0-9]+]]: !x86_64.GPR
// CHECK-NEXT: %{{[0-9]+}} = x86_64.mov_load {dst = %[[P]]:[[BEFORE_REG:[a-z0-9]+]],
// CHECK-SAME: base = %[[P]]:[[BEFORE_REG]]}
// CHECK-NOT: x86_64.mov {dst = %[[P]]:[[BEFORE_REG]]
// CHECK: asm.vbr ^[[HEAD]]

// CHECK-LABEL: asm.symbol {name = "load_on_back_edge"
// CHECK: ^[[HEAD:bb[0-9]+]](%[[P:[0-9]+]]: !x86_64.GPR
// CHECK: %{{[0-9]+}} = x86_64.mov_load {dst = %{{[0-9]+}}:[[REG:[a-z0-9]+]],
// CHECK-SAME: base = %[[P]]:[[REG]]}
// CHECK-NOT: x86_64.mov {dst = %{{[0-9]+}}:[[REG]]
// CHECK: asm.vbr ^[[HEAD]]
