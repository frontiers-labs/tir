// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s
// RUN: tir mc --march=x86_64 --stage=isel --shuffle-machine-order %s -o /dev/null

// Block-parameter destruction leaves machine IR that is not SSA. Regalloc
// coalesces the increment with the header parameter, so the back edge needs no
// copy and re-enters with the incremented register.

module {
  %1 = func.declare @foo(!i32) -> !unit
  %31 = func.func @main() -> !i32 {
    %11 = constant {value = 0} : !i32
    cfg.br ^bb1(%11 : !i32)
  ^bb1(%32: !i32):
    func.call %1(%32 : !i32)
    %25 = constant {value = 1} : !i32
    %27 = addi %32, %25 : !i32
    %29 = constant {value = 1} : !i1
    cfg.cond_br %29, ^bb1(%27 : !i32), ^bb2
  ^bb2:
    func.return %27
  }
  module_end
}

// The parameter is read into the call argument. The increment then overwrites
// the same physical register before the back edge.
// CHECK:      ^[[HEAD:bb[0-9]+]](%[[P:[0-9]+]]: !x86_64.GPR32, %{{[0-9]+}}: !x86_64.GPR, %{{[0-9]+}}: !state<memory>, %{{[0-9]+}}: !state<fp.env>):
// CHECK-NEXT: x86_64.mov {dst = %{{[0-9]+}}:{{r[a-z0-9]+}}, src = %[[P]]:[[REG:[a-z0-9]+]]}
// CHECK:      asm.vcall state(%{{[0-9]+}}, %{{[0-9]+}}) {callee = "foo"
// CHECK:      x86_64.inc32 {dst = %{{[0-9]+}}:[[REG]], dst_tied = %{{[0-9]+}}:[[REG]]}
// CHECK-NEXT: asm.vbr ^[[HEAD]]
