// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// The class a block-argument copy moves through follows the type of the value it
// carries. A `double` that is only ever forwarded from one block parameter to the
// next — the shape a rotated loop's condition block leaves behind — is named by
// no machine operand when its edges are destructed, so nothing but its type says
// which file it lives in. Copying it through a general-purpose register there
// contradicts every float copy of the same register elsewhere and leaves the
// allocator with a register-class conflict.

module {
  %tick = func.declare @tick() -> !unit
  %fn_fwd = func.func @fwd(%0: !i1, %1: !f64, %2: !f64) -> !f64 {
    cfg.cond_br %0, ^bb1(%1 : !f64), ^bb1(%2 : !f64)
  ^bb1(%3: !f64):
    func.call %tick()
    func.return %3
  }
  module_end
}

// The call keeps a shared continuation and forces the forwarded float to
// survive its clobbers. Both incoming copies and the reload use XMM storage.
// CHECK: asm.symbol
// CHECK-NOT: x86_64.mov {
// CHECK: x86_64.jne {imm = ^[[OTHER:bb[0-9]+]]}
// CHECK: x86_64.movsd_store_disp {base = rsp, src = %{{[0-9]+}}:xmm1, imm = [[SLOT:[0-9]+]]}
// CHECK-NEXT: asm.vbr ^[[JOIN:bb[0-9]+]]
// CHECK: ^[[OTHER]]:
// CHECK-NOT: x86_64.mov {
// CHECK: x86_64.movsd_store_disp {base = rsp, src = %{{[0-9]+}}:xmm0, imm = [[SLOT]]}
// CHECK-NEXT: asm.vbr ^[[JOIN]]
// CHECK: ^[[JOIN]](%{{[0-9]+}}: !x86_64.XMM,
// CHECK: asm.vcall
// CHECK: x86_64.movsd_load_disp {dst = %{{[0-9]+}}:xmm0, base = rsp, imm = [[SLOT]]}
