// RUN: tir mc --march=x86_64 --stage=isel %s | filecheck %s --check-prefixes=ISEL
// RUN: tir mc --march=x86_64 --stage=regalloc %s | filecheck %s

// Two-address instructions: every x86 ALU op reads and writes `dst`, so
// selection records the value the read binds to in a `dst_tied` attribute and
// register allocation lowers the tie to a `mov` ahead of the instruction.

module {
  %fn_chain = func.func @chain(%0: !i64, %1: !i64) -> !i64 {
    %2 = addi %0, %1 : !i64
    %3 = subi %0, %2 : !i64
    %4 = muli %3, %1 : !i64
    %5 = ori %4, %0 : !i64
    func.return %5
  }
  module_end
}

// ISEL:      x86_64.add {dst = %[[V2:[0-9]+]]:GPR, dst_tied = %[[V0:[0-9]+]]:GPR, src = %[[V1:[0-9]+]]:GPR}
// ISEL-NEXT: x86_64.sub {dst = %[[V3:[0-9]+]]:GPR, dst_tied = %[[V0]]:GPR, src = %[[V2]]:GPR}
// ISEL-NEXT: x86_64.imul {dst = %[[V4:[0-9]+]]:GPR, dst_tied = %[[V1]]:GPR, src = %[[V3]]:GPR}
// ISEL-NEXT: x86_64.or {dst = %[[V5:[0-9]+]]:GPR, dst_tied = %[[V0]]:GPR, src = %[[V4]]:GPR}
// ISEL-NEXT: asm.vret

// %0 and %1 arrive in rdi and rsi. A tie is a request for one register at both
// ends, so its copy stands only where the two interfere: %0 stays live to the
// last op, so no destination may take its register, while %1 dies at the
// multiply and that tie coalesces onto rsi. The result is pinned to rax by the
// func.return, so %0 moves there once and the last tie coalesces too.
// CHECK:      x86_64.mov {dst = %{{[0-9]+}}:rax, src = %{{[0-9]+}}:rdi}
// CHECK-NEXT: x86_64.mov {dst = %{{[0-9]+}}:[[T1:(?:rbx|rcx|rdx|rsi|rbp|r8|r9|r1[0-5])]], src = %{{[0-9]+}}:rax}
// CHECK-NEXT: x86_64.add {dst = %{{[0-9]+}}:[[T1]], dst_tied = %{{[0-9]+}}:[[T1]], src = %{{[0-9]+}}:rsi}
// CHECK-NEXT: x86_64.mov {dst = %{{[0-9]+}}:[[T2:(?:rbx|rcx|rdx|rsi|rbp|r8|r9|r1[0-5])]], src = %{{[0-9]+}}:rax}
// CHECK-NEXT: x86_64.sub {dst = %{{[0-9]+}}:[[T2]], dst_tied = %{{[0-9]+}}:[[T2]], src = %{{[0-9]+}}:[[T1]]}
// CHECK-NEXT: x86_64.imul {dst = %{{[0-9]+}}:rsi, dst_tied = %{{[0-9]+}}:rsi, src = %{{[0-9]+}}:[[T2]]}
// CHECK-NEXT: x86_64.or {dst = %{{[0-9]+}}:rax, dst_tied = %{{[0-9]+}}:rax, src = %{{[0-9]+}}:rsi}
// CHECK-NEXT: asm.vret
