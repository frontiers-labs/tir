// RUN: tir mc --march=x86_64 --filetype=asm %s | filecheck --check-prefix=ASM %s
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck --check-prefix=OBJ %s

module {
  %f = func.func @choose(%p: !i1) -> !i64 {
    cfg.cond_br %p, ^yes, ^no
  ^yes:
    %a = constant {value = 10} : !i64
    func.return %a
  ^no:
    %b = constant {value = 20} : !i64
    func.return %b
  }
  module_end
}

// ASM-LABEL: choose:
// ASM: jne .L[[YES:[0-9]+]]
// ASM-NEXT: .L{{[0-9]+}}:
// ASM: jmp .L[[EXIT:[0-9]+]]
// ASM-NEXT: .L[[YES]]:
// ASM-NOT: jmp
// ASM: .L[[EXIT]]:
// ASM-NEXT: ret
// OBJ-LABEL: choose:
// OBJ: [0xE9,
// OBJ-NOT: [0xE9,
// OBJ: [0xC3]
