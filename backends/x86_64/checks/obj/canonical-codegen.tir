// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s

// The post-RA `canonicalize_encodings` pass rewrites to the REX-free and imm8
// forms once registers are physical. SysV lands the two i32 args in edi/esi
// (indices 7 and 6, both low), so isel's REX-carrying and32/mov32/and_imm32 are
// downgraded: the register moves lose their 0x40 REX and `and eax, 42` folds to
// the 0x83 imm8 short form. Bytes match GNU as. (`and`, not `add`: an add chain
// with a constant would select as a single lea.)

module {
  func.func @lowregs(%0: !i32, %1: !i32) -> !i32 {
    %2 = andi %0, %1 : !i32
    %3 = constant {value = 42} : !i32
    %4 = andi %2, %3 : !i32
    func.return %4
  }
  module_end
}

// Both `and`s are two-address and both ties coalesce onto rax, so what reaches
// the encoder is the argument's own copy out of its incoming register — a
// whole-value move, hence 64-bit and REX-carrying.
// CHECK: lowregs:
// mov rax, rdi: 48 89 f8
// CHECK-NEXT: [0x48, 0x89, 0xF8]
// and eax, esi (norex): 21 f0
// CHECK-NEXT: [0x21, 0xF0]
// and eax, 42 (imm8 norex): 83 e0 2a
// CHECK-NEXT: [0x83, 0xE0, 0x2A]
// CHECK-NEXT: [0xC3]
