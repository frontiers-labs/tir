// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s

// An indirect call spells the REX byte whatever its target register is: the
// return address it pushes is its own end, so it has one length. Everything
// around it takes the shortest form its operands allow — the frame adjustment
// folds to the imm8 group, `mov eax, 0` needs no REX. GNU as writes `call rdi`
// as `ff d7`, one byte shorter; that byte buys the model a single shape.

module {
  %fn_f = func.func @f(%fp: !ptr.p) -> !i64 {
    %callee = ptr_to_fn %fp : !fn<() -> !i64>
    %r = func.call %callee() -> !i64
    func.return %r
  }
  module_end
}

// CHECK: f:
// add rsp, -8 (imm8): 48 83 c4 f8
// CHECK-NEXT: [0x48, 0x83, 0xC4, 0xF8]
// mov eax, 0 (norex): the B8+rd form, b8 00 00 00 00.
// CHECK-NEXT: [0xB8, 0x00, 0x00, 0x00, 0x00]
// call rdi: the empty REX, then ff d7. The detached callee coalesces away.
// CHECK-NEXT: [0x40, 0xFF, 0xD7]
// CHECK-NEXT: [0x48, 0x83, 0xC4, 0x08]
// CHECK-NEXT: [0xC3]
