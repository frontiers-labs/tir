// IR migration: instruction selection and backend lowering are unavailable.
// XFAIL: *
// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s

module {
  %fn_constant = func.func @constant() -> !f32 {
    %0 = fp.constant {bits = 1069547520} : !f32
    func.return %0
  }
  module_end
}

// CHECK: constant:
// CHECK-NEXT: [0xB8, 0x00, 0x00, 0xC0, 0x3F]
// CHECK-NEXT: [0x66, 0x0F, 0x6E, 0xC0]
// CHECK-NEXT: [0xC3]
