// RUN: tir mc --march=x86_64 --filetype=obj-ascii %s | filecheck %s

// A compared conditional branch encodes as the flag pair: `cmp` sets EFLAGS,
// `jl` consumes it. The rel32 displacements are measured from the end of each
// instruction, and each arm returns its result directly.

module {
  %fn_pick = func.func @pick(%0: !i64, %1: !i64) -> !i64 {
    %2 = cmpi %0, %1 {predicate = "slt"} : !i1
    cfg.cond_br %2, ^bb1, ^bb2
  ^bb1:
    %3 = constant {value = 1} : !i64
    func.return %3
  ^bb2:
    %4 = constant {value = 0} : !i64
    func.return %4
  }
  module_end
}

// The false arm follows the conditional branch. Each arm materializes its
// result locally and returns directly; the bytes check the branch fixup.
// CHECK: .section .text
// CHECK-NEXT: pick:
// CHECK-NEXT: [0x48, 0x39, 0xF7]
// CHECK-NEXT: [0x0F, 0x8C, 0x08, 0x00, 0x00, 0x00]
// CHECK-NEXT: [0x48, 0xC7, 0xC0, 0x00, 0x00, 0x00, 0x00]
// CHECK-NEXT: [0xC3]
// CHECK-NEXT: [0x48, 0xC7, 0xC0, 0x01, 0x00, 0x00, 0x00]
// CHECK-NEXT: [0xC3]
