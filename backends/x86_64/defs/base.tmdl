shift_imm!("One32", "_one32", RegShiftOne32,
    (Shl, "shl", 0b100, {
        let res = dst << zext(0b1, 32);
        let carry = extract(dst, 31, 31);
        EFLAGS::cf = carry;
        EFLAGS::zf = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(res, 31, 31);
        EFLAGS::of = extract(res, 31, 31) ^ carry;
        dst = res;
    }),
    (Shr, "shr", 0b101, {
        let res = dst >> zext(0b1, 32);
        EFLAGS::cf = extract(dst, 0, 0);
        EFLAGS::zf = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(res, 31, 31);
        EFLAGS::of = extract(dst, 31, 31);
        dst = res;
    }),
    (Sar, "sar", 0b111, {
        let res = dst >>> zext(0b1, 32);
        EFLAGS::cf = extract(dst, 0, 0);
        EFLAGS::zf = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(res, 31, 31);
        EFLAGS::of = zext(0b0, 1);
        dst = res;
