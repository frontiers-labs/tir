// The REX-free `mov r32, imm32` (0xB8+rd id): five bytes for eax..edi.
instruction MovImm32Norex for [X86] {
    param MNEMONIC: String = "mov";
    param OPNAME: String = "mov_imm32_norex";

    schedule { units = [WriteIMoveImmediate]; }

    operands {
        dst: GPR32low,
        imm: bits<32>,
    }

    encoding {
        0b10111,
        dst[2..0],
        imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, {imm}"
    }

    behavior {
        dst = sext(imm, 32);
    }
}

