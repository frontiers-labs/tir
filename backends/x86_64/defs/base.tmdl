//! Base scalar integer arithmetic, movement, memory, and control-flow instructions.

// Reg/reg and reg/imm forms share a mnemonic; the assembler tries forms in
// declaration order, so register forms precede the matching immediate forms.

alu_rr!(RegReg, WriteIALU3B,
    (Add, "add", 0x01, { add_flags!({ dst }, { src }, { self.XLEN }, { self.XLEN - 1 }) dst = dst + src; }),
    (Sub, "sub", 0x29, { sub_flags!({ src }, { self.XLEN - 1 }) dst = dst - src; }),
    (And, "and", 0x21, { logic_flags!({ dst & src }, { self.XLEN }, { self.XLEN - 1 }) dst = dst & src; }),
    (Or,  "or",  0x09, { logic_flags!({ dst | src }, { self.XLEN }, { self.XLEN - 1 }) dst = dst | src; }),
    (Xor, "xor", 0x31, { logic_flags!({ dst ^ src }, { self.XLEN }, { self.XLEN - 1 }) dst = dst ^ src; })
)

alu_rr!(RegReg, WriteIMove3B,
    (Mov, "mov", 0x89, { dst = src; })
)

// Compare: subtraction driving EFLAGS only (0x39: cmp r/m64, r64). The ALU
// forms above do not model their flag writes yet — nothing reads flags between
// a compare and its jump, so only the dedicated definers set them.
instruction Cmp for [X86_64] : RegReg {
    param MNEMONIC: String = "cmp";
    param OPCODE: bits<8> = 0x39;

    schedule { units = [WriteIALU3B]; }

    behavior {
        // Signed overflow of dst - src: operands differ in sign and the
        // result's sign differs from dst's.
        sub_flags!({ src }, { self.XLEN - 1 })
    }
}

// Logical compare (0x85: test r/m64, r64): flags from dst & src; cf/of clear.
instruction Test for [X86_64] : RegReg {
    param MNEMONIC: String = "test";
    param OPCODE: bits<8> = 0x85;

    schedule { units = [WriteIALU3B]; }

    behavior {
        test_flags!({ src }, { self.XLEN }, { self.XLEN - 1 })
    }
}

// Two-operand imul (0F AF): unlike the group-1 ALU ops, ModR/M.reg carries the
// destination.

instruction Imul for [X86_64] : RegRegExt {
    param MNEMONIC: String = "imul";
    param OPCODE: bits<8> = 0xAF;

    schedule { units = [WriteIMul]; }

    behavior {
        dst = dst * src;
    }
}

instruction Imul32 for [X86_64] : RegRegExt32 {
    param OPNAME: String = "imul32";
    param MNEMONIC: String = "imul";
    param OPCODE: bits<8> = 0xAF;

    schedule { units = [WriteIMul]; }

    behavior {
        dst = dst * src;
    }
}

instruction Imul32Norex for [X86] : RegRegExt32Norex {
    param OPNAME: String = "imul32_norex";
    param MNEMONIC: String = "imul";
    param OPCODE: bits<8> = 0xAF;
    schedule { units = [WriteIMul]; }
    behavior { dst = dst * src; }
}

// Immediate multiply: `imul dst, src, imm` folds a constant factor. Unlike the
// group-1 immediate ops it is non-destructive (dst = src * imm), so it selects
// `muli` against a constant without first materializing the constant.
instruction ImulImm for [X86_64] : RegRegImm {
    param OPNAME: String = "imul_imm";
    param MNEMONIC: String = "imul";
    param OPCODE: bits<8> = 0x69;

    schedule { units = [WriteIMul]; }

    behavior {
        dst = src * sext(imm, self.XLEN);
    }
}

instruction ImulImm32 for [X86_64] : RegRegImm32 {
    param OPNAME: String = "imul_imm32";
    param MNEMONIC: String = "imul";
    param OPCODE: bits<8> = 0x69;

    schedule { units = [WriteIMul]; }

    behavior {
        dst = src * sext(imm, 32);
    }
}

instruction ImulImm32Norex for [X86] : RegRegImm32Norex {
    param OPNAME: String = "imul_imm32_norex";
    param MNEMONIC: String = "imul";
    schedule { units = [WriteIMul]; }
    behavior { dst = src * sext(imm, 32); }
}

// Group-1 ops share opcode 0x81 and select via the ModR/M EXT (/digit); mov
// uses 0xC7.

alu_ri!(RegImm, WriteIALU,
    (AddImm, "add_imm", "add", 0x81, 0b000, { add_flags!({ dst }, { sext(imm, self.XLEN) }, { self.XLEN }, { self.XLEN - 1 }) dst = dst + sext(imm, self.XLEN); }),
    (OrImm,  "or_imm",  "or",  0x81, 0b001, { logic_flags!({ dst | sext(imm, self.XLEN) }, { self.XLEN }, { self.XLEN - 1 }) dst = dst | sext(imm, self.XLEN); }),
    (AndImm, "and_imm", "and", 0x81, 0b100, { logic_flags!({ dst & sext(imm, self.XLEN) }, { self.XLEN }, { self.XLEN - 1 }) dst = dst & sext(imm, self.XLEN); }),
    (XorImm, "xor_imm", "xor", 0x81, 0b110, { logic_flags!({ dst ^ sext(imm, self.XLEN) }, { self.XLEN }, { self.XLEN - 1 }) dst = dst ^ sext(imm, self.XLEN); })
)

alu_ri!(RegImm, WriteIMoveImmediate,
    (MovImm, "mov_imm", "mov", 0xC7, 0b000, { dst = sext(imm, self.XLEN); })
)

// Shift count masked to 6 bits for a 64-bit operand. The cl-count forms come
// first so the immediate forms don't parse `cl` as a symbol immediate.

shift_cl!(RegShiftCl,
    (ShlCl, "shl_cl", "shl", 0b100, {
        let c = extract(GPR::rcx, 5, 0);
        let res = dst << c;
        let carry = extract(dst << (c - zext(0b1, 6)), self.XLEN - 1, self.XLEN - 1);
        let zero = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 6) { EFLAGS::cf } else { carry };
        EFLAGS::zf = if c == zext(0b0, 6) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 6) { EFLAGS::sf } else { extract(res, self.XLEN - 1, self.XLEN - 1) };
        EFLAGS::of = if c == zext(0b0, 6) { EFLAGS::of } else { extract(res, self.XLEN - 1, self.XLEN - 1) ^ carry };
        dst = res;
    }),
    (ShrCl, "shr_cl", "shr", 0b101, {
        let c = extract(GPR::rcx, 5, 0);
        let res = dst >> c;
        let zero = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 6) { EFLAGS::cf } else { extract(dst >> (c - zext(0b1, 6)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 6) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 6) { EFLAGS::sf } else { extract(res, self.XLEN - 1, self.XLEN - 1) };
        EFLAGS::of = if c == zext(0b0, 6) { EFLAGS::of } else { extract(dst, self.XLEN - 1, self.XLEN - 1) };
        dst = res;
    }),
    (SarCl, "sar_cl", "sar", 0b111, {
        let c = extract(GPR::rcx, 5, 0);
        let res = dst >>> c;
        let zero = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 6) { EFLAGS::cf } else { extract(dst >>> (c - zext(0b1, 6)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 6) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 6) { EFLAGS::sf } else { extract(res, self.XLEN - 1, self.XLEN - 1) };
        EFLAGS::of = if c == zext(0b0, 6) { EFLAGS::of } else { zext(0b0, 1) };
        dst = res;
    })
)

shift_imm!(RegShift,
    (ShlImm, "shl", 0b100, {
        let c = extract(imm, 5, 0);
        let res = dst << c;
        let carry = extract(dst << (c - zext(0b1, 6)), self.XLEN - 1, self.XLEN - 1);
        let zero = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 6) { EFLAGS::cf } else { carry };
        EFLAGS::zf = if c == zext(0b0, 6) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 6) { EFLAGS::sf } else { extract(res, self.XLEN - 1, self.XLEN - 1) };
        EFLAGS::of = if c == zext(0b0, 6) { EFLAGS::of } else { extract(res, self.XLEN - 1, self.XLEN - 1) ^ carry };
        dst = res;
    }),
    (ShrImm, "shr", 0b101, {
        let c = extract(imm, 5, 0);
        let res = dst >> c;
        let zero = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 6) { EFLAGS::cf } else { extract(dst >> (c - zext(0b1, 6)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 6) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 6) { EFLAGS::sf } else { extract(res, self.XLEN - 1, self.XLEN - 1) };
        EFLAGS::of = if c == zext(0b0, 6) { EFLAGS::of } else { extract(dst, self.XLEN - 1, self.XLEN - 1) };
        dst = res;
    }),
    (SarImm, "sar", 0b111, {
        let c = extract(imm, 5, 0);
        let res = dst >>> c;
        let zero = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 6) { EFLAGS::cf } else { extract(dst >>> (c - zext(0b1, 6)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 6) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 6) { EFLAGS::sf } else { extract(res, self.XLEN - 1, self.XLEN - 1) };
        EFLAGS::of = if c == zext(0b0, 6) { EFLAGS::of } else { zext(0b0, 1) };
        dst = res;
    })
)

// The 0xD1 forms shift by exactly one, so their flags are fully defined: no
// count==0 preservation branch, and the count==1 overflow rules apply.
shift_imm!("One", "_one", RegShiftOne,
    (Shl, "shl", 0b100, {
        let res = dst << zext(0b1, self.XLEN);
        let carry = extract(dst, self.XLEN - 1, self.XLEN - 1);
        EFLAGS::cf = carry;
        EFLAGS::zf = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(res, self.XLEN - 1, self.XLEN - 1);
        EFLAGS::of = extract(res, self.XLEN - 1, self.XLEN - 1) ^ carry;
        dst = res;
    }),
    (Shr, "shr", 0b101, {
        let res = dst >> zext(0b1, self.XLEN);
        EFLAGS::cf = extract(dst, 0, 0);
        EFLAGS::zf = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(res, self.XLEN - 1, self.XLEN - 1);
        EFLAGS::of = extract(dst, self.XLEN - 1, self.XLEN - 1);
        dst = res;
    }),
    (Sar, "sar", 0b111, {
        let res = dst >>> zext(0b1, self.XLEN);
        EFLAGS::cf = extract(dst, 0, 0);
        EFLAGS::zf = if res == zext(0b0, self.XLEN) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(res, self.XLEN - 1, self.XLEN - 1);
        EFLAGS::of = zext(0b0, 1);
        dst = res;
    }),
    (Ror, "ror", 0b001, {
        let res = (dst >> zext(0b1, self.XLEN)) | (dst << zext(0b111111, self.XLEN));
        EFLAGS::cf = extract(res, self.XLEN - 1, self.XLEN - 1);
        EFLAGS::of = extract(res, self.XLEN - 1, self.XLEN - 1) ^ extract(res, self.XLEN - 2, self.XLEN - 2);
        dst = res;
    })
)

// Relative control transfers: rel32 is measured from the end of the
// instruction (RIP points past it), and `PC::pc` in behaviors is the
// instruction's own address — hence the explicit instruction-length addends.

instruction Jmp for [X86_64] {
    param MNEMONIC: String = "jmp";

    schedule { units = [WriteJump]; }

    operands {
        imm: bits<32>,
    }

    encoding {
        0xE9,
        imm,
    }

    asm {
        "{self.MNEMONIC} {imm}"
    }

    behavior {
        PC::pc = PC::pc + sext(imm, self.XLEN) + zext(0b101, self.XLEN);
    }
}

instruction JmpLegacy for [X86] {
    param OPNAME: String = "jmp_legacy";
    param MNEMONIC: String = "jmp";
    schedule { units = [WriteJump]; }
    operands { imm: bits<32>, }
    encoding { 0xE9, imm }
    asm { "{self.MNEMONIC} {imm}" }
    behavior {
        PC::pc = PC::pc + sext(imm, self.XLEN) + zext(0b101, self.XLEN);
    }
}

// Conditional jumps: EFLAGS-guarded PC writes. Selection derives cmp/test +
// jcc branch rules from these guards composed with the flag definers above.

jcc_ops!(
    (JumpEq,        "je",  0x84, { EFLAGS::zf == zext(0b1, 1) }),
    (JumpNotEq,     "jne", 0x85, { EFLAGS::zf == zext(0b0, 1) }),
    (JumpLess,      "jl",  0x8C, { EFLAGS::sf != EFLAGS::of }),
    (JumpGreaterEq, "jge", 0x8D, { EFLAGS::sf == EFLAGS::of }),
    (JumpBelow,     "jb",  0x82, { EFLAGS::cf == zext(0b1, 1) }),
    (JumpAboveEq,   "jae", 0x83, { EFLAGS::cf == zext(0b0, 1) })
)

instruction Call for [X86_64] {
    param MNEMONIC: String = "call";

    operands {
        imm: bits<32>,
    }

    encoding {
        0xE8,
        imm,
    }

    asm {
        "{self.MNEMONIC} {imm}"
    }

    behavior {
        GPR::rsp = GPR::rsp - zext(0b1000, self.XLEN);
        store(GPR::rsp, 8, PC::pc + zext(0b101, self.XLEN));
        PC::pc = PC::pc + sext(imm, self.XLEN) + zext(0b101, self.XLEN);
    }
}

instruction CallLegacy for [X86] {
    param OPNAME: String = "call_legacy";
    param MNEMONIC: String = "call";
    operands { imm: bits<32>, }
    encoding { 0xE8, imm }
    asm { "{self.MNEMONIC} {imm}" }
    behavior {
        GPR::rsp = GPR::rsp - zext(0b100, self.XLEN);
        store(GPR::rsp, 4, PC::pc + zext(0b101, self.XLEN));
        PC::pc = PC::pc + sext(imm, self.XLEN) + zext(0b101, self.XLEN);
    }
}

instruction Ret for [X86_64] {
    param MNEMONIC: String = "ret";

    encoding {
        0xC3,
    }

    asm {
        "{self.MNEMONIC}"
    }

    behavior {
        PC::pc = load(GPR::rsp, 8, 0b0);
        GPR::rsp = GPR::rsp + zext(0b1000, self.XLEN);
    }
}

instruction RetLegacy for [X86] {
    param OPNAME: String = "ret_legacy";
    param MNEMONIC: String = "ret";
    encoding { 0xC3 }
    asm { "{self.MNEMONIC}" }
    behavior {
        PC::pc = load(GPR::rsp, 4, 0b0);
        GPR::rsp = GPR::rsp + zext(0b100, self.XLEN);
    }
}

// ModR/M-escape variants of the mov load/store. Declared before the generic
// forms so the assembler tries them first: a `_sib`/`_rbp` candidate parses its
// base only in the narrow class (rsp/r12, rbp/r13), falling through to the
// generic for every other base. Post-RA `canonicalize_encodings` selects them
// for codegen. Behavior-free (canonicalize-only), so they root no isel rules.

instruction MovLoadSib for [X86_64] {
    param OPNAME: String = "mov_load_sib";
    param MNEMONIC: String = "mov";

    operands {
        dst: GPR,
        base: GPRsib,
    }

    encoding {
        rex!({ base[3] }, { dst[3] }, 0b1)
        0x8B,
        0b00,
        dst[2..0],
        0b100,
        0x24,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }

    behavior {
        dst = load(base, 8, 0b0);
    }
}

instruction MovLoadRbp for [X86_64] {
    param OPNAME: String = "mov_load_rbp";
    param MNEMONIC: String = "mov";

    operands {
        dst: GPR,
        base: GPRrbp,
    }

    encoding {
        rex!({ base[3] }, { dst[3] }, 0b1)
        0x8B,
        0b01,
        dst[2..0],
        0b101,
        0x00,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }

    behavior {
        dst = load(base, 8, 0b0);
    }
}

instruction MovStoreSib for [X86_64] {
    param OPNAME: String = "mov_store_sib";
    param MNEMONIC: String = "mov";

    operands {
        base: GPRsib,
        src: GPR,
    }

    encoding {
        rex!({ base[3] }, { src[3] }, 0b1)
        0x89,
        0b00,
        src[2..0],
        0b100,
        0x24,
    }

    asm {
        "{self.MNEMONIC} [{base}], {src}"
    }

    behavior {
        store(base, 8, src);
    }
}

instruction MovStoreRbp for [X86_64] {
    param OPNAME: String = "mov_store_rbp";
    param MNEMONIC: String = "mov";

    operands {
        base: GPRrbp,
        src: GPR,
    }

    encoding {
        rex!({ base[3] }, { src[3] }, 0b1)
        0x89,
        0b01,
        src[2..0],
        0b101,
        0x00,
    }

    asm {
        "{self.MNEMONIC} [{base}], {src}"
    }

    behavior {
        store(base, 8, src);
    }
}

instruction MovLoad for [X86_64] {
    param OPNAME: String = "mov_load";
    param MNEMONIC: String = "mov";

    operands {
        dst: GPR,
        base: GPR,
    }

    encoding {
        rex!({ base[3] }, { dst[3] }, 0b1)
        0x8B,
        0b00,
        dst[2..0],
        base[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }

    behavior {
        dst = load(base, 8, 0b0);
    }
}

instruction MovStore for [X86_64] {
    param OPNAME: String = "mov_store";
    param MNEMONIC: String = "mov";

    operands {
        base: GPR,
        src: GPR,
    }

    encoding {
        rex!({ base[3] }, { src[3] }, 0b1)
        0x89,
        0b00,
        src[2..0],
        base[2..0],
    }

    asm {
        "{self.MNEMONIC} [{base}], {src}"
    }

    behavior {
        store(base, 8, src);
    }
}

instruction JmpIndirect for [X86_64] {
    param OPNAME: String = "jmp_indirect";
    param MNEMONIC: String = "jmp";

    schedule { units = [WriteJump]; }

    operands {
        target: GPR,
    }

    encoding {
        rex!({ target[3] }, { 0b0 }, 0b0)
        0xFF,
        0b11,
        0b100,
        target[2..0],
    }

    asm {
        "{self.MNEMONIC} *{target}"
    }

    behavior {
        PC::pc = target;
    }
}

instruction CallIndirect for [X86_64] {
    param OPNAME: String = "call_indirect";
    param MNEMONIC: String = "call";

    operands {
        target: GPR,
    }

    encoding {
        rex!({ target[3] }, { 0b0 }, 0b0)
        0xFF,
        0b11,
        0b010,
        target[2..0],
    }

    asm {
        "{self.MNEMONIC} *{target}"
    }

    behavior {
        // The pushed return address is the next instruction (3 encoded bytes).
        // Parallel assignment: name `rsp - 8` in the store rather than read
        // `rsp` after its own decrement.
        store(GPR::rsp - zext(0b1000, self.XLEN), 8, PC::pc + zext(0b11, self.XLEN));
        GPR::rsp = GPR::rsp - zext(0b1000, self.XLEN);
        PC::pc = target;
    }
}

// No-REX indirect jmp/call (target in rax..rdi): 0xFF + ModR/M, no REX prefix.
instruction JmpIndirectNorex for [X86] {
    param OPNAME: String = "jmp_indirect_norex";
    param MNEMONIC: String = "jmp";

    operands {
        target: GPRlow,
    }

    encoding {
        0xFF,
        0b11,
        0b100,
        target[2..0],
    }

    asm {
        "{self.MNEMONIC} *{target}"
    }

    behavior {
        PC::pc = target;
    }
}

instruction CallIndirectNorex for [X86] {
    param OPNAME: String = "call_indirect_norex";
    param MNEMONIC: String = "call";

    operands {
        target: GPRlow,
    }

    encoding {
        0xFF,
        0b11,
        0b010,
        target[2..0],
    }

    asm {
        "{self.MNEMONIC} *{target}"
    }

    behavior {
        // Two encoded bytes (0xFF + ModR/M), so the return address is PC + 2.
        // This is the REX-dropping canonicalization target of `CallIndirect`,
        // so the slot is the long-mode 8 bytes — not `CallLegacy`'s 4: the
        // rewrite must preserve semantics.
        store(GPR::rsp - zext(0b1000, self.XLEN), 8, PC::pc + zext(0b10, self.XLEN));
        GPR::rsp = GPR::rsp - zext(0b1000, self.XLEN);
        PC::pc = target;
    }
}

alu_rr!("32", "32", RegReg32, WriteIALU3B,
    (Add, "add", 0x01, { add_flags!({ dst }, { src }, { 32 }, { 31 }) dst = dst + src; }),
    (Sub, "sub", 0x29, { sub_flags!({ src }, { 31 }) dst = dst - src; }),
    (And, "and", 0x21, { logic_flags!({ dst & src }, { 32 }, { 31 }) dst = dst & src; }),
    (Or,  "or",  0x09, { logic_flags!({ dst | src }, { 32 }, { 31 }) dst = dst | src; }),
    (Xor, "xor", 0x31, { logic_flags!({ dst ^ src }, { 32 }, { 31 }) dst = dst ^ src; })
)

alu_rr!("32", "32", RegReg32, WriteIMove3B,
    (Mov, "mov", 0x89, { dst = src; })
)

alu_ri!("32", "32", RegImm32, WriteIALU,
    (AddImm, "add_imm", "add", 0x81, 0b000, { add_flags!({ dst }, { sext(imm, 32) }, { 32 }, { 31 }) dst = dst + sext(imm, 32); }),
    (OrImm,  "or_imm",  "or",  0x81, 0b001, { logic_flags!({ dst | sext(imm, 32) }, { 32 }, { 31 }) dst = dst | sext(imm, 32); }),
    (AndImm, "and_imm", "and", 0x81, 0b100, { logic_flags!({ dst & sext(imm, 32) }, { 32 }, { 31 }) dst = dst & sext(imm, 32); }),
    (XorImm, "xor_imm", "xor", 0x81, 0b110, { logic_flags!({ dst ^ sext(imm, 32) }, { 32 }, { 31 }) dst = dst ^ sext(imm, 32); })
)

// `mov r32, imm32` (0xB8+rd id): the register number rides in the opcode byte,
// so no ModR/M is needed and the form is one byte shorter than the 0xC7 group
// encoding. Assemblers select it universally, so the byte stream a measured
// binary presents to the front end is this one.
instruction MovImm32 for [X86_64] {
    param MNEMONIC: String = "mov";
    param OPNAME: String = "mov_imm32";

    schedule { units = [WriteIMoveImmediate]; }

    operands {
        dst: GPR32,
        imm: bits<32>,
    }

    encoding {
        0b0100,
        0b0,
        0b0,
        0b0,
        dst[3],
        0b10111,
        dst[2..0],
        imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, {imm}"
    }

    behavior {
        dst = sext(imm, 32);
    }
}

shift_cl!("32", "32", RegShiftCl32,
    (ShlCl, "shl_cl", "shl", 0b100, {
        let c = extract(GPR::rcx, 4, 0);
        let res = dst << c;
        let carry = extract(dst << (c - zext(0b1, 5)), 31, 31);
        let zero = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { carry };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 31, 31) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { extract(res, 31, 31) ^ carry };
        dst = res;
    }),
    (ShrCl, "shr_cl", "shr", 0b101, {
        let c = extract(GPR::rcx, 4, 0);
        let res = dst >> c;
        let zero = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { extract(dst >> (c - zext(0b1, 5)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 31, 31) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { extract(dst, 31, 31) };
        dst = res;
    }),
    (SarCl, "sar_cl", "sar", 0b111, {
        let c = extract(GPR::rcx, 4, 0);
        let res = dst >>> c;
        let zero = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { extract(dst >>> (c - zext(0b1, 5)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 31, 31) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { zext(0b0, 1) };
        dst = res;
    })
)

