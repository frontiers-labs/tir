// No-REX shift-by-immediate forms (low subclasses). A masked count of zero
// leaves every flag untouched, so each flag reads its own old value on that
// path; the carry is the last bit shifted out and overflow follows the
// count==1 rule.
shift_imm_norex!("32", RegShift32Norex,
    {
        let c = extract(imm, 4, 0);
        let res = dst << c;
        let carry = extract(dst << (c - zext(0b1, 5)), 31, 31);
        let zero = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { carry };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 31, 31) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { extract(res, 31, 31) ^ carry };
        dst = res;
    },
    (ShlImm, "shl", 0b100))
shift_imm_norex!("32", RegShift32Norex,
    {
        let c = extract(imm, 4, 0);
        let res = dst >> c;
        let zero = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { extract(dst >> (c - zext(0b1, 5)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 31, 31) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { extract(dst, 31, 31) };
        dst = res;
    },
    (ShrImm, "shr", 0b101))
shift_imm_norex!("32", RegShift32Norex,
    {
        let c = extract(imm, 4, 0);
        let res = dst >>> c;
        let zero = if res == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { extract(dst >>> (c - zext(0b1, 5)), 0, 0) };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 31, 31) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { zext(0b0, 1) };
        dst = res;
    },
    (SarImm, "sar", 0b111))

shift_imm_norex!("16", RegShift16Norex,
    {
        let c = extract(imm, 4, 0);
        let res = dst << c;
        let carry = extract(dst << (c - zext(0b1, 5)), 15, 15);
        let zero = if res == zext(0b0, 16) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::cf = if c == zext(0b0, 5) { EFLAGS::cf } else { carry };
        EFLAGS::zf = if c == zext(0b0, 5) { EFLAGS::zf } else { zero };
        EFLAGS::sf = if c == zext(0b0, 5) { EFLAGS::sf } else { extract(res, 15, 15) };
        EFLAGS::of = if c == zext(0b0, 5) { EFLAGS::of } else { extract(res, 15, 15) ^ carry };
        dst = res;
