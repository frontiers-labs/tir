    (Ror, "ror", 0b001, {
        let res = (dst >> zext(0b1, 32)) | (dst << zext(0b11111, 32));
        EFLAGS::cf = extract(res, 31, 31);
        EFLAGS::of = extract(res, 31, 31) ^ extract(res, 30, 30);
        dst = res;
    })
)

