        uop(Res2);
    }
    override SetAbove {
        latency = 1;
        uop(Res2);
    }
    override SetAboveNorex {
        latency = 1;
        uop(Any2_4);
    }
    override SetAboveEq {
        latency = 1;
        uop(Res0);
    }
    override SetAboveEqNorex {
        latency = 1;
        uop(Any2_7);
    }
    override SetBelow {
        latency = 1;
        uop(Res0);
    }
    override SetBelowNorex {
        latency = 1;
        uop(Res0);
    }
    override SetBelowEqNorex {
