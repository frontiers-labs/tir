    }
    override Xor32 {
        latency = 1;
        uop(Any2_7);
        zero_idiom = true;
    }
    override Xor32Norex {
        latency = 1;
        uop(Any2_7);
        zero_idiom = true;
    }
    override XorImm8 {
        latency = 1;
