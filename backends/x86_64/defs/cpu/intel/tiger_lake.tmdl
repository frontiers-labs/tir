    }
    override ShlImm {
        latency = 1;
        uop(Any2_6);
    }
    override ShlImm32 {
        latency = 1;
        uop(Any3_8);
    }
    override ShlImm32Norex {
        latency = 1;
        uop(Any2_7);
    }
    override ShlImm8Norex {
        latency = 1;
        uop(Res2);
    }
    override ShlCl {
        latency = 1;
        uop(Any2_0);
    }
    override ShlCl32Norex {
        latency = 1;
        uop(Res2);
    }
    override ShrImm {
        latency = 1;
        uop(Any2_10);
    }
    override ShrImm32 {
        latency = 1;
