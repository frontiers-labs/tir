machine TigerLake ("tiger-lake") for [X86_64] {
    issue_width = 5;

    frontend {
        fetch {
            bytes_per_cycle = 16;
            window_bytes = 32;
            alignment = 8;
            queue_bytes = 32;
        }
        decode {
            slots = [simple, simple, simple, lcp];
            uops_per_cycle = 4;
            queue_uops = 32;
            decoder simple { max_uops_per_instruction = 1; }
            decoder lcp { max_uops_per_instruction = 1; }
        }
    }

    buffers {
        rob = 20;
    }

    unit Res0 { count = 1; }
    unit Res1 { count = 1; }
    unit Res2 { count = 1; }
    unit Res3 { count = 1; }

    group Any2_0 = Res0 | Res1;
    group Any3_1 = Res0 | Res1 | Res2;
    group Any4_2 = Res0 | Res1 | Res2 | Res3;
    group Any3_3 = Res0 | Res1 | Res3;
    group Any2_4 = Res0 | Res2;
    group Any3_5 = Res0 | Res2 | Res3;
    group Any2_6 = Res0 | Res3;
    group Any2_7 = Res1 | Res2;
    group Any3_8 = Res1 | Res2 | Res3;
    group Any2_9 = Res1 | Res3;
    group Any2_10 = Res2 | Res3;

    bind WriteIALU {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteIShift {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteIMoveWide {
        latency = 1;
        uop(Any3_1);
    }
    bind WriteIMoveByte {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteIMoveImmediate {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteIMoveAbsolute {
        latency = 1;
        uop(Any3_1);
    }
    bind WriteIConditional {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteIExtend {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteIMul {
        latency = 3;
        uop(Res3);
    }
    bind WriteFPAdd {
        latency = 4;
        uop(Any4_2);
    }
    bind WriteFPMul {
        latency = 4;
        uop(Any4_2);
    }
    bind WriteFPDiv {
        latency = 13;
        uop(Any4_2);
    }
    bind WriteFPMove {
        latency = 1;
        uop(Res0);
    }
    bind WriteSIToFP {
        latency = 4;
        uop(Res0);
    }
    bind WriteFPToSI {
        latency = 1;
        uop(Res0);
    }
    bind WriteFPCompare {
        latency = 1;
        uop(Res0);
    }
    bind WriteILeaSimple {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteILeaComplex {
        latency = 1;
        uop(Any4_2);
    }
    bind WriteILeaRip {
        latency = 1;
        uop(Res3);
    }

    // Per-instruction refinements: encoding-observable forms whose
    // measured behavior differs from their class.
    override Add {
        latency = 1;
        uop(Any2_10);
    }
    override Add32 {
        latency = 1;
        uop(Any2_4);
    }
    override Add32Norex {
        latency = 1;
        uop(Any2_10);
    }
    override AddImm {
        latency = 1;
        uop(Any3_3);
    }
    override AddImm32 {
        latency = 1;
        uop(Any2_4);
    }
    override AddImm32Norex {
        latency = 1;
        uop(Any2_7);
    }
    override AddImm8 {
        latency = 1;
        uop(Any2_9);
    }
    override AddImm8Norex {
        latency = 1;
        uop(Any2_0);
    }
    override AddImm8s {
        latency = 1;
        uop(Any3_3);
    }
    override AddImm8s32 {
        latency = 1;
        uop(Any2_4);
    }
    override AddImm8s32Norex {
        latency = 1;
        uop(Any2_0);
    }
    override And {
        latency = 1;
        uop(Any3_1);
    }
    override And32 {
        latency = 1;
        uop(Any2_4);
    }
    override And32Norex {
        latency = 1;
        uop(Res1);
    }
    override And8 {
        latency = 1;
        uop(Any2_10);
    }
    override And8Norex {
        latency = 1;
        uop(Any2_6);
    }
    override AndImm {
        latency = 1;
        uop(Any2_9);
    }
    override AndImm32 {
        latency = 1;
        uop(Any2_6);
    }
    override AndImm32Norex {
        latency = 1;
        uop(Any2_9);
    }
    override AndImm8 {
        latency = 1;
        uop(Any2_7);
    }
    override AndImm8H {
        latency = 3;
        uop(Any4_2);
    }
    override AndImm8s {
        latency = 1;
        uop(Any2_4);
    }
    override AndImm8s32 {
        latency = 1;
        uop(Any2_6);
    }
    override AndImm8s32Norex {
        latency = 1;
        uop(Any2_0);
    }
    override CmovAbove {
        latency = 1;
        uop(Res3);
    }
    override CmovAboveEq {
        latency = 1;
        uop(Res2);
    }
    override CmovBelow {
        latency = 1;
        uop(Res3);
    }
    override CmovEq {
        latency = 1;
        uop(Res2);
    }
    override CmovGreaterEq {
        latency = 1;
        uop(Res1);
    }
    override CmovLess {
        latency = 1;
        uop(Res1);
    }
    override CmovNotEq {
        latency = 1;
        uop(Res0);
    }
    override Cmp {
        latency = 1;
        uop(Any3_1);
    }
    override Cmp16Norex {
        latency = 1;
        uop(Any3_1);
    }
    override Cmp32 {
        latency = 1;
        uop(Any2_7);
    }
    override Cmp32Norex {
        latency = 1;
        uop(Any3_1);
    }
    override CmpImm {
        latency = 1;
        uop(Any3_5);
    }
    override CmpImm32 {
        latency = 1;
        uop(Any3_8);
    }
    override CmpImm32Norex {
        latency = 1;
        uop(Any3_8);
    }
    override CmpImm8 {
        latency = 1;
        uop(Any3_8);
    }
    override CmpImm8Norex {
        latency = 1;
        uop(Any3_1);
    }
    override CmpImm8s32 {
        latency = 1;
        uop(Any3_3);
    }
    override CmpImm8s32Norex {
        latency = 1;
        uop(Any3_1);
    }
    override Imul32 {
        latency = 3;
        uop(Any2_0);
    }
    override ImulImm {
        latency = 3;
        uop(Any2_7);
    }
    override ImulImm32 {
        latency = 3;
        uop(Any2_6);
    }
    override ImulWide {
        latency = 3;
        uop(Res3);
    }
    override LeaBaseIndex2 {
        latency = 1;
        uop(Any2_0);
    }
    override LeaBaseIndex4 {
        latency = 1;
        uop(Any2_10);
    }
    override LeaBaseIndex4Disp8 {
        latency = 1;
        uop(Any2_0);
    }
    override LeaBaseIndex8 {
        latency = 1;
        uop(Any3_5);
    }
    override LeaBaseIndexDisp8 {
        latency = 1;
        uop(Any3_5);
    }
    override LeaIndex4 {
        latency = 1;
        uop(Any3_5);
    }
    override LeaIndex4Disp32 {
        latency = 1;
        uop(Any3_1);
    }
    override Mov16 {
        latency = 1;
        uop(Any4_2);
    }
    override Mov16Norex {
        latency = 1;
        uop(Any4_2);
    }
    override Mov32Norex {
        latency = 1;
        uop(Any3_1);
    }
    override Mov8 {
        latency = 1;
        uop(Any2_0);
    }
    override MovImm {
        latency = 1;
        uop(Any3_1);
    }
    override MovImm16 {
        latency = 1;
        uop(Any4_2);
        decoder = lcp;
        decode_cycles = 3;
    }
    override MovImm16Norex {
        latency = 1;
        uop(Res3);
        decoder = lcp;
        decode_cycles = 3;
    }
    override MovImm8 {
        latency = 1;
        uop(Any3_1);
    }
    override MovImm8Norex {
        latency = 1;
        uop(Any2_7);
    }
    override MovqGprXmm {
        latency = 1;
        uop(Any2_0);
    }
    override Movsd {
        latency = 1;
        uop(Any4_2);
    }
    override Movsxd {
        latency = 1;
        uop(Any3_8);
    }
    override Neg {
        latency = 1;
        uop(Any3_5);
    }
    override Neg32 {
        latency = 1;
        uop(Any2_0);
    }
    override Neg32Norex {
        latency = 1;
        uop(Any2_7);
    }
    override Not {
        latency = 1;
        uop(Any2_4);
    }
    override Not32 {
        latency = 1;
        uop(Any2_0);
    }
    override Not32Norex {
        latency = 1;
        uop(Any2_4);
    }
    override Not8Norex {
        latency = 1;
        uop(Any3_1);
    }
    override Or {
        latency = 1;
        uop(Any2_7);
    }
    override Or32 {
        latency = 1;
