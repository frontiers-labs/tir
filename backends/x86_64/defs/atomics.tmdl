lock_logic_rex_sib_template!(LockAndMem32SibTemplate, GPR32, 0b0, "and")
lock_logic_rex_direct_template!(LockAndMem64Template, GPR, 0b1, "and")
lock_logic_rex_sib_template!(LockAndMem64SibTemplate, GPR, 0b1, "and")
lock_logic_rex_direct_template!(LockOrMem32Template, GPR32, 0b0, "or")
lock_logic_rex_sib_template!(LockOrMem32SibTemplate, GPR32, 0b0, "or")
lock_logic_rex_direct_template!(LockOrMem64Template, GPR, 0b1, "or")
lock_logic_rex_sib_template!(LockOrMem64SibTemplate, GPR, 0b1, "or")

macro lock_logic_norex_template {
    ( $name:ident, $op:literal ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { base: GPRsibLow, imm: bits<32>, reg: GPR32low, }
            encoding {
                0xF0,
                OPCODE,
                0b10,
                reg[2..0],
                0b100,
                0x24,
                imm,
            }
            asm { ${concat("{self.MNEMONIC} ", $op, " [{base} + {imm}], {reg}")} }
            schedule { units = [WriteIALU]; }
        }
    };
}

macro lock_logic_norex_direct_template {
    ( $name:ident, $op:literal ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { base: GPRaddrDispLow, imm: bits<32>, reg: GPR32low, }
            encoding {
                0xF0,
                OPCODE,
                0b10,
                reg[2..0],
                base[2..0],
                imm,
            }
            asm { ${concat("{self.MNEMONIC} ", $op, " [{base} + {imm}], {reg}")} }
            schedule { units = [WriteIALU]; }
        }
    };
}

lock_logic_norex_direct_template!(LockXorMem32NorexTemplate, "xor")
lock_logic_norex_template!(LockXorMem32SibNorexTemplate, "xor")
lock_logic_norex_direct_template!(LockAndMem32NorexTemplate, "and")
lock_logic_norex_template!(LockAndMem32SibNorexTemplate, "and")
lock_logic_norex_direct_template!(LockOrMem32NorexTemplate, "or")
lock_logic_norex_template!(LockOrMem32SibNorexTemplate, "or")

// The result stays in memory, but it still sets the flags, so the loaded word is
// bound and `$res` recomputes the stored value over it.
macro lock_logic_norex {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $op:literal, $opcode:literal, $rmw:ident,
            { $($res:tt)* } ) ),* ) => {
        $( instruction $name for [X86] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               param OPCODE: bits<8> = $opcode;
               behavior {
                   let old = atomic_rmw($rmw, base + sext(imm, self.XLEN), 4, reg, Ordering::acq_rel);
                   logic_flags!({ $($res)* }, { 32 }, { 31 })
               }
           } )*
    };
}

lock_logic_norex!(
    (LockXorMem32Norex, LockXorMem32NorexTemplate, "lock_xor_mem32_norex", "xor", 0x31, xor, { old ^ reg }),
    (LockXorMem32SibNorex, LockXorMem32SibNorexTemplate, "lock_xor_mem32_sib_norex", "xor", 0x31, xor, { old ^ reg }),
    (LockAndMem32Norex, LockAndMem32NorexTemplate, "lock_and_mem32_norex", "and", 0x21, and, { old & reg }),
    (LockAndMem32SibNorex, LockAndMem32SibNorexTemplate, "lock_and_mem32_sib_norex", "and", 0x21, and, { old & reg }),
    (LockOrMem32Norex, LockOrMem32NorexTemplate, "lock_or_mem32_norex", "or", 0x09, or, { old | reg }),
    (LockOrMem32SibNorex, LockOrMem32SibNorexTemplate, "lock_or_mem32_sib_norex", "or", 0x09, or, { old | reg })
)

macro lock_logic {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $op:literal, $opcode:literal,
            $rmw:ident, $bytes:literal, { $($res:tt)* }, { $($w:tt)* }, { $($msb:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               param OPCODE: bits<8> = $opcode;
               behavior {
                   let old = atomic_rmw($rmw, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
                   logic_flags!({ $($res)* }, { $($w)* }, { $($msb)* })
               }
           } )*
    };
}

lock_logic!(
    (LockXorMem32, LockXorMem32Template, "lock_xor_mem32", "xor", 0x31, xor, 4, { old ^ reg }, { 32 }, { 31 }),
    (LockXorMem32Sib, LockXorMem32SibTemplate, "lock_xor_mem32_sib", "xor", 0x31, xor, 4, { old ^ reg }, { 32 }, { 31 }),
    (LockXorMem64, LockXorMem64Template, "lock_xor_mem64", "xor", 0x31, xor, 8, { old ^ reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockXorMem64Sib, LockXorMem64SibTemplate, "lock_xor_mem64_sib", "xor", 0x31, xor, 8, { old ^ reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockAndMem32, LockAndMem32Template, "lock_and_mem32", "and", 0x21, and, 4, { old & reg }, { 32 }, { 31 }),
    (LockAndMem32Sib, LockAndMem32SibTemplate, "lock_and_mem32_sib", "and", 0x21, and, 4, { old & reg }, { 32 }, { 31 }),
    (LockAndMem64, LockAndMem64Template, "lock_and_mem64", "and", 0x21, and, 8, { old & reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockAndMem64Sib, LockAndMem64SibTemplate, "lock_and_mem64_sib", "and", 0x21, and, 8, { old & reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockOrMem32, LockOrMem32Template, "lock_or_mem32", "or", 0x09, or, 4, { old | reg }, { 32 }, { 31 }),
    (LockOrMem32Sib, LockOrMem32SibTemplate, "lock_or_mem32_sib", "or", 0x09, or, 4, { old | reg }, { 32 }, { 31 }),
    (LockOrMem64, LockOrMem64Template, "lock_or_mem64", "or", 0x09, or, 8, { old | reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockOrMem64Sib, LockOrMem64SibTemplate, "lock_or_mem64_sib", "or", 0x09, or, 8, { old | reg }, { self.XLEN }, { self.XLEN - 1 })
)
