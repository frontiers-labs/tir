//! Atomic exchange and fetch-add instructions.

macro xchg_rex_direct_template {
    ( $name:ident, $reg:ident, $w:literal ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            operands { base: GPR, imm: bits<32>, reg: $reg, }
            encoding {
                rex($w, reg, base, 0b0),
                0x87,
                modrm_disp(reg, base, imm),
            }
            asm { "{self.MNEMONIC} [{base} + {imm}], {reg}" }
            schedule { units = [WriteIALU]; }
        }
    };
}

macro xadd_rex_direct_template {
    ( $name:ident, $reg:ident, $w:literal ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            operands { base: GPR, imm: bits<32>, reg: $reg, }
            encoding {
                0xF0,
                rex($w, reg, base, 0b0),
                0x0F,
                0xC1,
                modrm_disp(reg, base, imm),
            }
            asm { "{self.MNEMONIC} xadd [{base} + {imm}], {reg}" }
            schedule { units = [WriteIALU]; }
        }
    };
}

xchg_rex_direct_template!(XchgMem32Template, GPR32, 0b0)
xchg_rex_direct_template!(XchgMem64Template, GPR, 0b1)
xadd_rex_direct_template!(LockXaddMem32Template, GPR32, 0b0)
xadd_rex_direct_template!(LockXaddMem64Template, GPR, 0b1)







macro atomic_xchg {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $bytes:literal ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "xchg";
               behavior {
                   reg = atomic_rmw(swap, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
               }
           } )*
    };
}

atomic_xchg!(
    (XchgMem32, XchgMem32Template, "xchg_mem32", 4),
    (XchgMem64, XchgMem64Template, "xchg_mem64", 8)
)

macro atomic_xadd {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $bytes:literal,
            { $($w:tt)* }, { $($msb:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               behavior {
                   let old = atomic_rmw(add, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
                   add_flags!({ old }, { reg }, { $($w)* }, { $($msb)* })
                   reg = old;
               }
           } )*
    };
}

atomic_xadd!(
    (LockXaddMem32, LockXaddMem32Template, "lock_xadd_mem32", 4, { 32 }, { 31 }),
    (LockXaddMem64, LockXaddMem64Template, "lock_xadd_mem64", 8, { self.XLEN }, { self.XLEN - 1 })
)

macro lock_logic_rex_direct_template {
    ( $name:ident, $reg:ident, $w:literal, $op:literal ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { base: GPR, imm: bits<32>, reg: $reg, }
            encoding {
                0xF0,
                rex($w, reg, base, 0b0),
                OPCODE,
                modrm_disp(reg, base, imm),
            }
            asm { ${concat("{self.MNEMONIC} ", $op, " [{base} + {imm}], {reg}")} }
            schedule { units = [WriteIALU]; }
        }
    };
}


lock_logic_rex_direct_template!(LockXorMem32Template, GPR32, 0b0, "xor")
lock_logic_rex_direct_template!(LockXorMem64Template, GPR, 0b1, "xor")
lock_logic_rex_direct_template!(LockAndMem32Template, GPR32, 0b0, "and")
lock_logic_rex_direct_template!(LockAndMem64Template, GPR, 0b1, "and")
lock_logic_rex_direct_template!(LockOrMem32Template, GPR32, 0b0, "or")
lock_logic_rex_direct_template!(LockOrMem64Template, GPR, 0b1, "or")




macro lock_logic {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $op:literal, $opcode:literal,
            $rmw:ident, $bytes:literal, { $($res:tt)* }, { $($w:tt)* }, { $($msb:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               param OPCODE: bits<8> = $opcode;
               behavior {
                   let old = atomic_rmw($rmw, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
                   logic_flags!({ $($res)* }, { $($w)* }, { $($msb)* })
               }
           } )*
    };
}

lock_logic!(
    (LockXorMem32, LockXorMem32Template, "lock_xor_mem32", "xor", 0x31, xor, 4, { old ^ reg }, { 32 }, { 31 }),
    (LockXorMem64, LockXorMem64Template, "lock_xor_mem64", "xor", 0x31, xor, 8, { old ^ reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockAndMem32, LockAndMem32Template, "lock_and_mem32", "and", 0x21, and, 4, { old & reg }, { 32 }, { 31 }),
    (LockAndMem64, LockAndMem64Template, "lock_and_mem64", "and", 0x21, and, 8, { old & reg }, { self.XLEN }, { self.XLEN - 1 }),
    (LockOrMem32, LockOrMem32Template, "lock_or_mem32", "or", 0x09, or, 4, { old | reg }, { 32 }, { 31 }),
    (LockOrMem64, LockOrMem64Template, "lock_or_mem64", "or", 0x09, or, 8, { old | reg }, { self.XLEN }, { self.XLEN - 1 })
)
