}

xchg_rex_direct_template!(XchgMem32Template, GPR32, 0b0)
xchg_rex_template!(XchgMem32SibTemplate, GPRsib, GPR32, 0b0)
xchg_rex_direct_template!(XchgMem64Template, GPR, 0b1)
xchg_rex_template!(XchgMem64SibTemplate, GPRsib, GPR, 0b1)
xadd_rex_direct_template!(LockXaddMem32Template, GPR32, 0b0)
xadd_rex_template!(LockXaddMem32SibTemplate, GPRsib, GPR32, 0b0)
xadd_rex_direct_template!(LockXaddMem64Template, GPR, 0b1)
xadd_rex_template!(LockXaddMem64SibTemplate, GPRsib, GPR, 0b1)

template XchgMem32NorexTemplate for [X86] {
    param MNEMONIC: String;
    operands { base: GPRaddrDispLow, imm: bits<32>, reg: GPR32low, }
    encoding {
        0x87,
        0b10,
        reg[2..0],
        base[2..0],
        imm,
    }
    asm { "{self.MNEMONIC} [{base} + {imm}], {reg}" }
    schedule { units = [WriteIALU]; }
}

template XchgMem32SibNorexTemplate for [X86] {
    param MNEMONIC: String;
    operands { base: GPRsibLow, imm: bits<32>, reg: GPR32low, }
    encoding {
        0x87,
        0b10,
        reg[2..0],
        0b100,
        0x24,
        imm,
    }
    asm { "{self.MNEMONIC} [{base} + {imm}], {reg}" }
    schedule { units = [WriteIALU]; }
}

template LockXaddMem32NorexTemplate for [X86] {
    param MNEMONIC: String;
    operands { base: GPRaddrDispLow, imm: bits<32>, reg: GPR32low, }
    encoding {
        0xF0,
        0x0F,
        0xC1,
        0b10,
        reg[2..0],
        base[2..0],
        imm,
    }
    asm { "{self.MNEMONIC} xadd [{base} + {imm}], {reg}" }
    schedule { units = [WriteIALU]; }
}

template LockXaddMem32SibNorexTemplate for [X86] {
    param MNEMONIC: String;
    operands { base: GPRsibLow, imm: bits<32>, reg: GPR32low, }
    encoding {
        0xF0,
        0x0F,
        0xC1,
        0b10,
        reg[2..0],
        0b100,
        0x24,
        imm,
    }
    asm { "{self.MNEMONIC} xadd [{base} + {imm}], {reg}" }
    schedule { units = [WriteIALU]; }
}

macro atomic_xchg_norex {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal ) ),* ) => {
        $( instruction $name for [X86] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "xchg";
               behavior {
                   reg = atomic_rmw(swap, base + sext(imm, self.XLEN), 4, reg, Ordering::acq_rel);
               }
           } )*
    };
}

atomic_xchg_norex!(
    (XchgMem32Norex, XchgMem32NorexTemplate, "xchg_mem32_norex"),
    (XchgMem32SibNorex, XchgMem32SibNorexTemplate, "xchg_mem32_sib_norex")
)

// The exchanged value is the memory word read before the addition, so it is
// bound: the flags describe `old + reg`, and the destination write must not
// re-issue the atomic.
macro atomic_xadd_norex {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal ) ),* ) => {
        $( instruction $name for [X86] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               behavior {
                   let old = atomic_rmw(add, base + sext(imm, self.XLEN), 4, reg, Ordering::acq_rel);
                   add_flags!({ old }, { reg }, { 32 }, { 31 })
                   reg = old;
               }
           } )*
    };
}

atomic_xadd_norex!(
    (LockXaddMem32Norex, LockXaddMem32NorexTemplate, "lock_xadd_mem32_norex"),
    (LockXaddMem32SibNorex, LockXaddMem32SibNorexTemplate, "lock_xadd_mem32_sib_norex")
)

macro atomic_xchg {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $bytes:literal ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "xchg";
               behavior {
                   reg = atomic_rmw(swap, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
               }
           } )*
    };
}

atomic_xchg!(
    (XchgMem32, XchgMem32Template, "xchg_mem32", 4),
    (XchgMem32Sib, XchgMem32SibTemplate, "xchg_mem32_sib", 4),
    (XchgMem64, XchgMem64Template, "xchg_mem64", 8),
    (XchgMem64Sib, XchgMem64SibTemplate, "xchg_mem64_sib", 8)
)

macro atomic_xadd {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $bytes:literal,
            { $($w:tt)* }, { $($msb:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               behavior {
                   let old = atomic_rmw(add, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
                   add_flags!({ old }, { reg }, { $($w)* }, { $($msb)* })
                   reg = old;
               }
           } )*
    };
}

atomic_xadd!(
    (LockXaddMem32, LockXaddMem32Template, "lock_xadd_mem32", 4, { 32 }, { 31 }),
    (LockXaddMem32Sib, LockXaddMem32SibTemplate, "lock_xadd_mem32_sib", 4, { 32 }, { 31 }),
    (LockXaddMem64, LockXaddMem64Template, "lock_xadd_mem64", 8, { self.XLEN }, { self.XLEN - 1 }),
    (LockXaddMem64Sib, LockXaddMem64SibTemplate, "lock_xadd_mem64_sib", 8, { self.XLEN }, { self.XLEN - 1 })
)

macro lock_logic_rex_direct_template {
    ( $name:ident, $reg:ident, $w:literal, $op:literal ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { base: GPR, imm: bits<32>, reg: $reg, }
            encoding {
                0xF0,
                0b0100,
                $w,
                reg[3],
                0b0,
                base[3],
                OPCODE,
                0b10,
                reg[2..0],
                base[2..0],
                imm,
            }
            asm { ${concat("{self.MNEMONIC} ", $op, " [{base} + {imm}], {reg}")} }
            schedule { units = [WriteIALU]; }
        }
    };
}

macro lock_logic_rex_sib_template {
    ( $name:ident, $reg:ident, $w:literal, $op:literal ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { base: GPRsib, imm: bits<32>, reg: $reg, }
            encoding {
                0xF0,
                0b0100,
                $w,
                reg[3],
                0b0,
                base[3],
                OPCODE,
                0b10,
                reg[2..0],
                0b100,
                0x24,
                imm,
            }
            asm { ${concat("{self.MNEMONIC} ", $op, " [{base} + {imm}], {reg}")} }
            schedule { units = [WriteIALU]; }
        }
    };
}

lock_logic_rex_direct_template!(LockXorMem32Template, GPR32, 0b0, "xor")
lock_logic_rex_sib_template!(LockXorMem32SibTemplate, GPR32, 0b0, "xor")
lock_logic_rex_direct_template!(LockXorMem64Template, GPR, 0b1, "xor")
lock_logic_rex_sib_template!(LockXorMem64SibTemplate, GPR, 0b1, "xor")
