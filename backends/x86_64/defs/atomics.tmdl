macro lock_logic_norex {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $op:literal, $opcode:literal, $rmw:ident ) ),* ) => {
        $( instruction $name for [X86] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               param OPCODE: bits<8> = $opcode;
               behavior {
                   atomic_rmw($rmw, base + sext(imm, self.XLEN), 4, reg, Ordering::acq_rel);
                   todo_flags!()
               }
           } )*
    };
}

lock_logic_norex!(
    (LockXorMem32Norex, LockXorMem32NorexTemplate, "lock_xor_mem32_norex", "xor", 0x31, xor),
    (LockXorMem32SibNorex, LockXorMem32SibNorexTemplate, "lock_xor_mem32_sib_norex", "xor", 0x31, xor),
    (LockAndMem32Norex, LockAndMem32NorexTemplate, "lock_and_mem32_norex", "and", 0x21, and),
    (LockAndMem32SibNorex, LockAndMem32SibNorexTemplate, "lock_and_mem32_sib_norex", "and", 0x21, and),
    (LockOrMem32Norex, LockOrMem32NorexTemplate, "lock_or_mem32_norex", "or", 0x09, or),
    (LockOrMem32SibNorex, LockOrMem32SibNorexTemplate, "lock_or_mem32_sib_norex", "or", 0x09, or)
)

macro lock_logic {
    ( $( ( $name:ident, $tmpl:ident, $opname:literal, $op:literal, $opcode:literal,
            $rmw:ident, $bytes:literal ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = "lock";
               param OPCODE: bits<8> = $opcode;
               behavior {
                   atomic_rmw($rmw, base + sext(imm, self.XLEN), $bytes, reg, Ordering::acq_rel);
                   todo_flags!()
               }
           } )*
    };
}

lock_logic!(
    (LockXorMem32, LockXorMem32Template, "lock_xor_mem32", "xor", 0x31, xor, 4),
    (LockXorMem32Sib, LockXorMem32SibTemplate, "lock_xor_mem32_sib", "xor", 0x31, xor, 4),
    (LockXorMem64, LockXorMem64Template, "lock_xor_mem64", "xor", 0x31, xor, 8),
    (LockXorMem64Sib, LockXorMem64SibTemplate, "lock_xor_mem64_sib", "xor", 0x31, xor, 8),
    (LockAndMem32, LockAndMem32Template, "lock_and_mem32", "and", 0x21, and, 4),
    (LockAndMem32Sib, LockAndMem32SibTemplate, "lock_and_mem32_sib", "and", 0x21, and, 4),
    (LockAndMem64, LockAndMem64Template, "lock_and_mem64", "and", 0x21, and, 8),
    (LockAndMem64Sib, LockAndMem64SibTemplate, "lock_and_mem64_sib", "and", 0x21, and, 8),
    (LockOrMem32, LockOrMem32Template, "lock_or_mem32", "or", 0x09, or, 4),
    (LockOrMem32Sib, LockOrMem32SibTemplate, "lock_or_mem32_sib", "or", 0x09, or, 4),
    (LockOrMem64, LockOrMem64Template, "lock_or_mem64", "or", 0x09, or, 8),
    (LockOrMem64Sib, LockOrMem64SibTemplate, "lock_or_mem64_sib", "or", 0x09, or, 8)
)
