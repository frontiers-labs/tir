// Convert a signed 32-bit integer to scalar binary64 (`cvtsi2sd xmm, r32`).
instruction Cvtsi2sd32 for [X86_64] {
    param OPNAME: String = "cvtsi2sd32";
    param MNEMONIC: String = "cvtsi2sd";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM,
        src: GPR32,
    }

    encoding {
        0xF2,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x2A,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 11, 52);
    }
}

// Convert a signed 64-bit integer to scalar binary64 (`cvtsi2sd xmm, r64`).
instruction Cvtsi2sd64 for [X86_64] {
    param OPNAME: String = "cvtsi2sd64";
    param MNEMONIC: String = "cvtsi2sd";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM,
        src: GPR,
    }

    encoding {
        0xF2,
        rex(0b1, dst, src, 0b0),
        0x0F,
        0x2A,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 11, 52);
    }
}

// Convert scalar binary64 to a signed 32-bit integer, truncating toward zero.
instruction Cvttsd2si32 for [X86_64] {
    param OPNAME: String = "cvttsd2si32";
    param MNEMONIC: String = "cvttsd2si";

    schedule { units = [WriteFPToSI]; }

    operands {
        dst: GPR32,
        src: XMM,
    }

    encoding {
        0xF2,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x2C,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = fptosi(src, 32);
    }
}

// Convert scalar binary64 to a signed 64-bit integer, truncating toward zero.
instruction Cvttsd2si64 for [X86_64] {
    param OPNAME: String = "cvttsd2si64";
    param MNEMONIC: String = "cvttsd2si";

    schedule { units = [WriteFPToSI]; }

    operands {
        dst: GPR,
        src: XMM,
    }

    encoding {
        0xF2,
        rex(0b1, dst, src, 0b0),
        0x0F,
        0x2C,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = fptosi(src, 64);
    }
}

instruction Movups for [SSE] {
    param MNEMONIC: String = "movups";
    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMM128,
        src: XMM128,
    }

    encoding {
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x10,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = src;
    }
}

instruction MovupsLoadDisp for [SSE] {
    param OPNAME: String = "movups_load_disp";
    param MNEMONIC: String = "movups";

    operands {
        dst: XMM128,
        base: GPR,
        imm: bits<32>,
    }

    encoding {
        rex(0b0, dst, base, 0b0),
        0x0F,
        0x10,
        modrm_disp(dst, base, imm),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior {
        dst = load(base + sext(imm, self.XLEN), 16, 0b0);
    }
}

instruction MovupsStoreDisp for [SSE] {
    param OPNAME: String = "movups_store_disp";
    param MNEMONIC: String = "movups";

    operands {
        base: GPR,
        imm: bits<32>,
        src: XMM128,
    }

    encoding {
        rex(0b0, src, base, 0b0),
        0x0F,
        0x11,
        modrm_disp(src, base, imm),
    }

    asm {
        "{self.MNEMONIC} [{base} + {imm}], {src}"
    }

    behavior {
        store(base + sext(imm, self.XLEN), 16, src);
    }
}

instruction Movaps for [SSE] {
    param MNEMONIC: String = "movaps";
    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMM128,
        src: XMM128,
    }

    encoding {
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x28,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = src;
    }
}

template PackedMove for [SSE2] {
    param MNEMONIC: String;
    param PREFIX: bits<8>;
    param OPCODE: bits<8>;

    schedule { units = [WriteFPMove]; }
    operands { dst: XMM128, src: XMM128, }
    encoding {
        PREFIX,
        rex(0b0, dst, src, 0b0),
        0x0F,
        OPCODE,
        modrm_reg(dst, src),
    }
    asm { "{self.MNEMONIC} {dst}, {src}" }
}

instruction Movapd for [SSE2] : PackedMove {
    param MNEMONIC: String = "movapd";
    param PREFIX: bits<8> = 0x66;
    param OPCODE: bits<8> = 0x28;
    behavior { dst = src; }
}

instruction Movupd for [SSE2] : PackedMove {
    param MNEMONIC: String = "movupd";
    param PREFIX: bits<8> = 0x66;
    param OPCODE: bits<8> = 0x10;
    behavior { dst = src; }
}

instruction Movdqu for [SSE2] : PackedMove {
    param MNEMONIC: String = "movdqu";
    param PREFIX: bits<8> = 0xF3;
    param OPCODE: bits<8> = 0x6F;
    behavior { dst = src; }
}

template PackedLoadDisp for [SSE] {
    param MNEMONIC: String;
    param PREFIX: bits<8>;
    param OPCODE: bits<8>;

    operands { dst: XMM128, base: GPR, imm: bits<32>, }
    encoding {
        if PREFIX != 0x00 { PREFIX } else { () },
        rex(0b0, dst, base, 0b0),
        0x0F,
        OPCODE,
        modrm_disp(dst, base, imm),
    }
    asm { "{self.MNEMONIC} {dst}, [{base} + {imm}]" }
}

template PackedStoreDisp for [SSE] {
    param MNEMONIC: String;
    param PREFIX: bits<8>;
    param OPCODE: bits<8>;

    operands { base: GPR, imm: bits<32>, src: XMM128, }
    encoding {
        if PREFIX != 0x00 { PREFIX } else { () },
        rex(0b0, src, base, 0b0),
        0x0F,
        OPCODE,
        modrm_disp(src, base, imm),
    }
    asm { "{self.MNEMONIC} [{base} + {imm}], {src}" }
}

instruction MovupdLoadDisp for [SSE2] : PackedLoadDisp {
    param OPNAME: String = "movupd_load_disp";
    param MNEMONIC: String = "movupd";
    param PREFIX: bits<8> = 0x66;
    param OPCODE: bits<8> = 0x10;
    behavior { dst = load(base + sext(imm, self.XLEN), 16, 0b0); }
}

instruction MovdquLoadDisp for [SSE2] : PackedLoadDisp {
    param OPNAME: String = "movdqu_load_disp";
    param MNEMONIC: String = "movdqu";
    param PREFIX: bits<8> = 0xF3;
    param OPCODE: bits<8> = 0x6F;
    behavior { dst = load(base + sext(imm, self.XLEN), 16, 0b0); }
}

instruction MovupdStoreDisp for [SSE2] : PackedStoreDisp {
    param OPNAME: String = "movupd_store_disp";
    param MNEMONIC: String = "movupd";
    param PREFIX: bits<8> = 0x66;
    param OPCODE: bits<8> = 0x11;
    behavior { store(base + sext(imm, self.XLEN), 16, src); }
}

instruction MovdquStoreDisp for [SSE2] : PackedStoreDisp {
    param OPNAME: String = "movdqu_store_disp";
    param MNEMONIC: String = "movdqu";
    param PREFIX: bits<8> = 0xF3;
    param OPCODE: bits<8> = 0x7F;
    behavior { store(base + sext(imm, self.XLEN), 16, src); }
}

instruction MovlpsLoadDisp for [SSE] : PackedLoadDisp {
    param OPNAME: String = "movlps_load_disp";
    param MNEMONIC: String = "movlps";
    param PREFIX: bits<8> = 0x00;
    param OPCODE: bits<8> = 0x12;
    behavior {
        let value = load(base + sext(imm, self.XLEN), 8, 0b0);
        dst = concat(map(zip(split(dst, 2, 64), iota(2, 64)),
            |lane, index| if index == 0 { value } else { lane }));
    }
}

instruction MovlpdLoadDisp for [SSE2] : PackedLoadDisp {
    param OPNAME: String = "movlpd_load_disp";
    param MNEMONIC: String = "movlpd";
