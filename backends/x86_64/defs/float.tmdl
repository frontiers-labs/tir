        dst = concat(map(zip(split(dst, 2, 64), iota(2, 64)),
            |lane, index| if index == 1 { value } else { lane }));
    }
}

instruction MovhpdLoadDisp for [SSE2] : PackedLoadDisp {
    param OPNAME: String = "movhpd_load_disp";
    param MNEMONIC: String = "movhpd";
    param PREFIX: bits<8> = 0x66;
    param OPCODE: bits<8> = 0x16;
    behavior {
