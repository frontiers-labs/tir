}

// Convert a signed 32-bit integer to scalar binary64 (`cvtsi2sd xmm, r32`).
instruction Cvtsi2sd32 for [X86_64] {
    param OPNAME: String = "cvtsi2sd32";
    param MNEMONIC: String = "cvtsi2sd";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM,
        src: GPR32,
    }

    encoding {
        0xF2,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x2A,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 11, 52);
    }
}

// Convert a signed 64-bit integer to scalar binary64 (`cvtsi2sd xmm, r64`).
instruction Cvtsi2sd64 for [X86_64] {
    param OPNAME: String = "cvtsi2sd64";
    param MNEMONIC: String = "cvtsi2sd";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM,
        src: GPR,
    }

    encoding {
        0xF2,
        rex(0b1, dst, src, 0b0),
        0x0F,
        0x2A,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 11, 52);
    }
}

// Convert scalar binary64 to a signed 32-bit integer, truncating toward zero.
instruction Cvttsd2si32 for [X86_64] {
    param OPNAME: String = "cvttsd2si32";
    param MNEMONIC: String = "cvttsd2si";

    schedule { units = [WriteFPToSI]; }

    operands {
        dst: GPR32,
        src: XMM,
    }

    encoding {
        0xF2,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x2C,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = fptosi(src, 32);
    }
}

// Convert scalar binary64 to a signed 64-bit integer, truncating toward zero.
instruction Cvttsd2si64 for [X86_64] {
    param OPNAME: String = "cvttsd2si64";
    param MNEMONIC: String = "cvttsd2si";

    schedule { units = [WriteFPToSI]; }

    operands {
        dst: GPR,
        src: XMM,
    }

    encoding {
        0xF2,
        rex(0b1, dst, src, 0b0),
        0x0F,
        0x2C,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = fptosi(src, 64);
    }
}

instruction MovssLoadDisp for [X86_64] {
    param OPNAME: String = "movss_load_disp";
    param MNEMONIC: String = "movss";

    operands {
        dst: XMM32,
        base: GPR,
        imm: bits<32>,
    }

    encoding {
        0xF3,
        rex(0b0, dst, base, 0b0),
        0x0F,
        0x10,
        modrm_disp(dst, base, imm),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior {
        dst = load(base + sext(imm, self.XLEN), 4, 0b0);
    }
}

instruction MovssStoreDisp for [X86_64] {
    param OPNAME: String = "movss_store_disp";
    param MNEMONIC: String = "movss";

    operands {
        base: GPR,
        imm: bits<32>,
        src: XMM32,
    }

    encoding {
        0xF3,
        rex(0b0, src, base, 0b0),
        0x0F,
        0x11,
        modrm_disp(src, base, imm),
    }

    asm {
        "{self.MNEMONIC} [{base} + {imm}], {src}"
    }

    behavior {
        store(base + sext(imm, self.XLEN), 4, src);
    }
}

instruction MovsdLoadDisp for [X86_64] {
    param OPNAME: String = "movsd_load_disp";
