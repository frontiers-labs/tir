instruction UcomissNorex for [SSE] : UcomissNorexTemplate {
    param OPNAME: String = "ucomiss_norex";
    param MNEMONIC: String = "ucomiss";

    schedule { units = [WriteFPCompare]; }

    behavior {
        EFLAGS::cf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs < rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::pf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs == rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = zext(0b0, 1);
        EFLAGS::of = zext(0b0, 1);
    }
}

