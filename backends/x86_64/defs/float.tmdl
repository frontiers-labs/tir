}

instruction Ucomiss for [X86_64] {
    param MNEMONIC: String = "ucomiss";

    schedule { units = [WriteFPCompare]; }

    operands {
        lhs: XMM32,
        rhs: XMM32,
    }

    encoding {
        0b0100,
        0b0,
        lhs[3],
        0b0,
        rhs[3],
        0x0F,
        0x2E,
        0b11,
        lhs[2..0],
        rhs[2..0],
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }

    behavior {
        EFLAGS::cf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs < rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::pf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs == rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = zext(0b0, 1);
        EFLAGS::of = zext(0b0, 1);
    }
}

instruction Ucomisd for [X86_64] {
    param MNEMONIC: String = "ucomisd";

    schedule { units = [WriteFPCompare]; }

    operands {
        lhs: XMM,
        rhs: XMM,
    }

    encoding {
        0x66,
        0b0100,
        0b0,
        lhs[3],
        0b0,
        rhs[3],
        0x0F,
        0x2E,
        0b11,
        lhs[2..0],
        rhs[2..0],
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }

    behavior {
        EFLAGS::cf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs < rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::pf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs == rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = zext(0b0, 1);
        EFLAGS::of = zext(0b0, 1);
    }
}

// `movsd xmm_dst, xmm_src` (F2 0F 10 /r): register-to-register scalar-double
// move. Emitted by register allocation to copy a value before a two-address FP
// op overwrites it; the reg/rm layout matches `FpArith`.
instruction Movsd for [X86_64] {
    param MNEMONIC: String = "movsd";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMM,
        src: XMM,
    }

    encoding {
        0xF2,
        0b0100,
        0b0,
        dst[3],
        0b0,
        src[3],
        0x0F,
        0x10,
        0b11,
        dst[2..0],
        src[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = src;
    }
}

// `movq xmm, r64` copies an integer bit pattern into the low binary64 lane.
instruction MovqXmmGpr for [X86_64] {
    param OPNAME: String = "movq_xmm_gpr";
    param MNEMONIC: String = "movq";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMMzx,
        src: GPR,
    }

    encoding {
        0x66,
        0b0100,
        0b1,
        dst[3],
        0b0,
        src[3],
        0x0F,
        0x6E,
        0b11,
        dst[2..0],
        src[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

// `movq r64, xmm` copies the low binary64 lane into an integer register.
instruction MovqGprXmm for [X86_64] {
    param OPNAME: String = "movq_gpr_xmm";
    param MNEMONIC: String = "movq";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: GPR,
        src: XMM,
    }

    encoding {
        0x66,
        0b0100,
        0b1,
        src[3],
        0b0,
        dst[3],
        0x0F,
        0x7E,
        0b11,
        src[2..0],
        dst[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

instruction MovdXmmGpr32 for [X86_64] {
