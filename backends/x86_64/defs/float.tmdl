macro fp_mem_norex {
    ( $feature:ident, $xmm:ident, $prefix:literal, $bytes:literal,
      $load:ident, $load_op:literal, $store:ident, $store_op:literal,
      $load_sib:ident, $load_sib_op:literal,
      $store_sib:ident, $store_sib_op:literal,
      $mnemonic:literal ) => {
        instruction $load for [$feature] {
            param OPNAME: String = $load_op;
            param MNEMONIC: String = $mnemonic;
            schedule { units = [WriteFPMove]; }
            operands { dst: $xmm, base: GPRaddrDispLow, imm: bits<32>, }
            encoding {
                $prefix,
                0x0F,
                0x10,
                0b10,
                dst[2..0],
                base[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, [{base} + {imm}]" }
            behavior { dst = load(base + sext(imm, self.XLEN), $bytes, 0b0); }
        }

        instruction $store for [$feature] {
            param OPNAME: String = $store_op;
            param MNEMONIC: String = $mnemonic;
            schedule { units = [WriteFPMove]; }
            operands { base: GPRaddrDispLow, imm: bits<32>, src: $xmm, }
            encoding {
                $prefix,
                0x0F,
                0x11,
                0b10,
                src[2..0],
                base[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} [{base} + {imm}], {src}" }
            behavior { store(base + sext(imm, self.XLEN), $bytes, src); }
        }

        instruction $load_sib for [$feature] {
            param OPNAME: String = $load_sib_op;
            param MNEMONIC: String = $mnemonic;
            schedule { units = [WriteFPMove]; }
            operands { dst: $xmm, base: GPRsibLow, imm: bits<32>, }
            encoding {
                $prefix,
                0x0F,
                0x10,
                0b10,
                dst[2..0],
                0b100,
                0x24,
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, [{base} + {imm}]" }
            behavior { dst = load(base + sext(imm, self.XLEN), $bytes, 0b0); }
        }

        instruction $store_sib for [$feature] {
            param OPNAME: String = $store_sib_op;
            param MNEMONIC: String = $mnemonic;
            schedule { units = [WriteFPMove]; }
            operands { base: GPRsibLow, imm: bits<32>, src: $xmm, }
            encoding {
                $prefix,
                0x0F,
                0x11,
                0b10,
                src[2..0],
                0b100,
                0x24,
                imm,
            }
            asm { "{self.MNEMONIC} [{base} + {imm}], {src}" }
            behavior { store(base + sext(imm, self.XLEN), $bytes, src); }
        }
    };
}

fp_mem_norex!(SSE, XMM32low, 0xF3, 4,
    MovssLoadDispNorex, "movss_load_disp_norex",
    MovssStoreDispNorex, "movss_store_disp_norex",
    MovssLoadDispSibNorex, "movss_load_disp_sib_norex",
    MovssStoreDispSibNorex, "movss_store_disp_sib_norex",
    "movss"
)

fp_mem_norex!(SSE2, XMMlow, 0xF2, 8,
    MovsdLoadDispNorex, "movsd_load_disp_norex",
    MovsdStoreDispNorex, "movsd_store_disp_norex",
    MovsdLoadDispSibNorex, "movsd_load_disp_sib_norex",
    MovsdStoreDispSibNorex, "movsd_store_disp_sib_norex",
    "movsd"
)

instruction MovssLoadDisp for [X86_64] {
    param OPNAME: String = "movss_load_disp";
    param MNEMONIC: String = "movss";

    operands {
        dst: XMM32,
        base: GPR,
        imm: bits<32>,
    }

    encoding {
        0xF3,
        0b0100,
        0b0,
        dst[3],
        0b0,
        base[3],
        0x0F,
        0x10,
        0b10,
        dst[2..0],
        base[2..0],
        imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior {
        dst = load(base + sext(imm, self.XLEN), 4, 0b0);
    }
}

