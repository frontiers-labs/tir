instruction Cvtsi2ss32Norex for [SSE] : Cvtsi2ss32NorexTemplate {
    param OPNAME: String = "cvtsi2ss32_norex";
    param MNEMONIC: String = "cvtsi2ss";
    param PREFIX: bits<8> = 0xF3;
    param OPCODE: bits<8> = 0x2A;
    schedule { units = [WriteSIToFP]; }
    behavior { dst = sitofp(src, 8, 23); }
}

instruction Cvttss2si32Norex for [SSE] : Cvttss2si32NorexTemplate {
