//! SSE and SSE2 scalar floating-point instructions.

// SSE2 scalar double-precision floating point. The sixteen XMM registers form
// a 128-bit file; scalar instructions operate through the 64-bit `XMM` view
// (the semantic engine reads a float-typed register's bits as a binary64
// APFloat, so `fadd`/`fmul` on XMM operands compute real double results), as
// with the AArch64 `FPR64` view of its 128-bit `VPR` file. The file class
// itself roots no operands and carries no traits.

register_class XMM128 for [SSE] {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 128;

    registers {
        xmm0..xmm15 => { },
    }
}

register_class XMM32 for [SSE] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 32;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

register_class XMM32zx for [SSE2] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 32;

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// Scalar writes through this view merge into the untouched upper lane, so a
// physical destination is also a read — `cvtsi2sd xmm0, rax` chains on xmm0
// (measured: 4.01 cyc/iteration for that block against a ~0.3 throughput
// floor). Two-address scalar arithmetic reads its destination anyway; the
// merge matters for the one-source writers (cvtsi2sd, reg-reg movsd).

register_class XMM for [SSE2] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// `movq xmm, r64` zero-extends through bit 127: same width, no merge, so its
// destination write breaks dependencies instead of chaining on them.

register_class XMMzx for [SSE2] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}



template FpArith32 for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMM32,
        src: XMM32,
    }

    encoding {
        0xF3,
        rex(0b0, dst, src, 0b0),
        0x0F,
        OPCODE,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

// `op xmm_dst, xmm_src`: the F2 mandatory prefix, REX (W=0; R/B carry the 4th
// register-number bits), the 0x0F escape, the opcode, then ModR/M(mod=11,
// reg=dst, rm=src). The op is two-address — dst is also the first source — so
// selection ties it to the destination, matching the `addf`/`subf` shape.
template FpArith for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMM,
        src: XMM,
    }

    encoding {
        0xF2,
        rex(0b0, dst, src, 0b0),
        0x0F,
        OPCODE,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

instruction Addss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "addss";
    param OPCODE: bits<8> = 0x58;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fadd(dst, src);
    }
}

instruction Subss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "subss";
    param OPCODE: bits<8> = 0x5C;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fsub(dst, src);
    }
}

instruction Mulss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "mulss";
    param OPCODE: bits<8> = 0x59;

    schedule { units = [WriteFPMul]; }

    behavior {
        dst = fmul(dst, src);
    }
}

instruction Divss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "divss";
    param OPCODE: bits<8> = 0x5E;

    schedule { units = [WriteFPDiv]; }

    behavior {
        dst = fdiv(dst, src);
    }
}

instruction Movss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "movss";
    param OPCODE: bits<8> = 0x10;

    schedule { units = [WriteFPMove]; }

    behavior {
        dst = src;
    }
}

instruction Addsd for [X86_64] : FpArith {
    param MNEMONIC: String = "addsd";
    param OPCODE: bits<8> = 0x58;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fadd(dst, src);
    }
}

instruction Subsd for [X86_64] : FpArith {
    param MNEMONIC: String = "subsd";
    param OPCODE: bits<8> = 0x5C;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fsub(dst, src);
    }
}

instruction Mulsd for [X86_64] : FpArith {
    param MNEMONIC: String = "mulsd";
    param OPCODE: bits<8> = 0x59;

    schedule { units = [WriteFPMul]; }

    behavior {
        dst = fmul(dst, src);
    }
}

instruction Divsd for [X86_64] : FpArith {
    param MNEMONIC: String = "divsd";
    param OPCODE: bits<8> = 0x5E;

    schedule { units = [WriteFPDiv]; }

    behavior {
        dst = fdiv(dst, src);
    }
}

instruction Ucomiss for [X86_64] {
    param MNEMONIC: String = "ucomiss";

    schedule { units = [WriteFPCompare]; }

    operands {
        lhs: XMM32,
        rhs: XMM32,
    }

    encoding {
        rex(0b0, lhs, rhs, 0b0),
        0x0F,
        0x2E,
        modrm_reg(lhs, rhs),
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }

    behavior {
        EFLAGS::cf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs < rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::pf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs == rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = zext(0b0, 1);
        EFLAGS::of = zext(0b0, 1);
    }
}

instruction Ucomisd for [X86_64] {
    param MNEMONIC: String = "ucomisd";

    schedule { units = [WriteFPCompare]; }

    operands {
        lhs: XMM,
        rhs: XMM,
    }

    encoding {
        0x66,
        rex(0b0, lhs, rhs, 0b0),
        0x0F,
        0x2E,
        modrm_reg(lhs, rhs),
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }

    behavior {
        EFLAGS::cf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs < rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::pf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs == rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = zext(0b0, 1);
        EFLAGS::of = zext(0b0, 1);
    }
}

// `movsd xmm_dst, xmm_src` (F2 0F 10 /r): register-to-register scalar-double
// move. Emitted by register allocation to copy a value before a two-address FP
// op overwrites it; the reg/rm layout matches `FpArith`.
instruction Movsd for [X86_64] {
    param MNEMONIC: String = "movsd";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMM,
        src: XMM,
    }

    encoding {
        0xF2,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x10,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = src;
    }
}

// `movq xmm, r64` copies an integer bit pattern into the low binary64 lane.
instruction MovqXmmGpr for [X86_64] {
    param OPNAME: String = "movq_xmm_gpr";
    param MNEMONIC: String = "movq";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMMzx,
        src: GPR,
    }

    encoding {
        0x66,
        rex(0b1, dst, src, 0b0),
        0x0F,
        0x6E,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

// `movq r64, xmm` copies the low binary64 lane into an integer register.
instruction MovqGprXmm for [X86_64] {
    param OPNAME: String = "movq_gpr_xmm";
    param MNEMONIC: String = "movq";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: GPR,
        src: XMM,
    }

    encoding {
        0x66,
        rex(0b1, src, dst, 0b0),
        0x0F,
        0x7E,
        modrm_reg(src, dst),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

instruction MovdXmmGpr32 for [X86_64] {
    param OPNAME: String = "movd_xmm_gpr32";
    param MNEMONIC: String = "movd";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMM32zx,
        src: GPR32,
    }

    encoding {
        0x66,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x6E,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

instruction MovdGpr32Xmm for [X86_64] {
    param OPNAME: String = "movd_gpr32_xmm";
    param MNEMONIC: String = "movd";
    schedule { units = [WriteFPMove]; }
    operands { dst: GPR32, src: XMM32, }
    encoding {
        0x66,
        rex(0b0, src, dst, 0b0),
        0x0F,
        0x7E,
        modrm_reg(src, dst),
    }
    asm { "{self.MNEMONIC} {dst}, {src}" }
    behavior { dst = bitcast(src); }
}

instruction Cvtsi2ss32 for [X86_64] {
    param OPNAME: String = "cvtsi2ss32";
    param MNEMONIC: String = "cvtsi2ss";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM32,
        src: GPR32,
    }

    encoding {
        0xF3,
        rex(0b0, dst, src, 0b0),
        0x0F,
        0x2A,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 8, 23);
    }
}

instruction Cvtsi2ss64 for [X86_64] {
    param OPNAME: String = "cvtsi2ss64";
    param MNEMONIC: String = "cvtsi2ss";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM32,
        src: GPR,
    }

    encoding {
        0xF3,
        rex(0b1, dst, src, 0b0),
        0x0F,
        0x2A,
        modrm_reg(dst, src),
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 8, 23);
    }
}

instruction Cvttss2si32 for [X86_64] {
    param OPNAME: String = "cvttss2si32";
    param MNEMONIC: String = "cvttss2si";

    schedule { units = [WriteFPToSI]; }

    operands {
