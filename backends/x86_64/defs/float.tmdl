//! SSE and SSE2 scalar floating-point instructions.

// SSE2 scalar double-precision floating point. The sixteen XMM registers form
// a 128-bit file; scalar instructions operate through the 64-bit `XMM` view
// (the semantic engine reads a float-typed register's bits as a binary64
// APFloat, so `fadd`/`fmul` on XMM operands compute real double results), as
// with the AArch64 `FPR64` view of its 128-bit `VPR` file. The file class
// itself roots no operands and carries no traits.

register_class XMM128 for [SSE] {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 128;

    registers {
        xmm0..xmm15 => { },
    }
}

register_class XMM32 for [SSE] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 32;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

register_class XMM32zx for [SSE2] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 32;

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// Scalar writes through this view merge into the untouched upper lane, so a
// physical destination is also a read — `cvtsi2sd xmm0, rax` chains on xmm0
// (measured: 4.01 cyc/iteration for that block against a ~0.3 throughput
// floor). Two-address scalar arithmetic reads its destination anyway; the
// merge matters for the one-source writers (cvtsi2sd, reg-reg movsd).

register_class XMM for [SSE2] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// `movq xmm, r64` zero-extends through bit 127: same width, no merge, so its
// destination write breaks dependencies instead of chaining on them.

register_class XMMzx for [SSE2] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// Low-XMM subclass (xmm0..xmm7): the REX-free SSE encodings GNU as emits when
// no register-number 4th bit is needed. Same float views of the XMM file as
// XMM/XMM32, restricted to the low indices.
register_class XMMlow for [SSE2] {
    file = XMM128;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0 => { index = 0, traits = [float] },
        xmm1 => { index = 1, traits = [float] },
        xmm2 => { index = 2, traits = [float] },
        xmm3 => { index = 3, traits = [float] },
        xmm4 => { index = 4, traits = [float] },
        xmm5 => { index = 5, traits = [float] },
        xmm6 => { index = 6, traits = [float] },
        xmm7 => { index = 7, traits = [float] },
    }
}

register_class XMM32low for [SSE] {
    file = XMM128;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 32;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0 => { index = 0, traits = [float] },
        xmm1 => { index = 1, traits = [float] },
        xmm2 => { index = 2, traits = [float] },
        xmm3 => { index = 3, traits = [float] },
        xmm4 => { index = 4, traits = [float] },
        xmm5 => { index = 5, traits = [float] },
        xmm6 => { index = 6, traits = [float] },
        xmm7 => { index = 7, traits = [float] },
    }
}

template FpArith32 for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMM32,
        src: XMM32,
    }

    encoding {
        0xF3,
        0b0100,
        0b0,
        dst[3],
        0b0,
        src[3],
        0x0F,
        OPCODE,
        0b11,
        dst[2..0],
        src[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

template FpArith32Norex for [SSE] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMM32low,
        src: XMM32low,
    }

    encoding {
        0xF3,
        0x0F,
        OPCODE,
        0b11,
        dst[2..0],
        src[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

// `op xmm_dst, xmm_src`: the F2 mandatory prefix, REX (W=0; R/B carry the 4th
// register-number bits), the 0x0F escape, the opcode, then ModR/M(mod=11,
// reg=dst, rm=src). The op is two-address — dst is also the first source — so
// selection ties it to the destination, matching the `addf`/`subf` shape.
template FpArith for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMM,
        src: XMM,
    }

    encoding {
        0xF2,
        0b0100,
        0b0,
        dst[3],
        0b0,
        src[3],
        0x0F,
        OPCODE,
        0b11,
        dst[2..0],
        src[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

// No-REX scalar-double form (xmm0..xmm7): F2 prefix, 0x0F escape, opcode, then
// ModR/M(mod=11, reg=dst, rm=src). Dropping the REX byte shifts the tail up 8
// bits, exactly as the 16-bit 0x66 forms do.
template FpArithNorex for [SSE2] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMMlow,
        src: XMMlow,
    }

    encoding {
        0xF2,
        0x0F,
        OPCODE,
        0b11,
        dst[2..0],
        src[2..0],
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

template UcomissNorexTemplate for [SSE] {
    param MNEMONIC: String;

    operands {
        lhs: XMM32low,
        rhs: XMM32low,
    }

    encoding {
        0x0F,
        0x2E,
        0b11,
        lhs[2..0],
        rhs[2..0],
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }
}

template UcomisdNorexTemplate for [SSE2] {
    param MNEMONIC: String;

    operands {
        lhs: XMMlow,
        rhs: XMMlow,
    }

    encoding {
        0x66,
        0x0F,
        0x2E,
        0b11,
        lhs[2..0],
        rhs[2..0],
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }
}

macro fp_convert_norex_template {
    ( $name:ident, $feature:ident, $dst:ident, $src:ident ) => {
        template $name for [$feature] {
            param MNEMONIC: String;
            param PREFIX: bits<8>;
            param OPCODE: bits<8>;

            operands {
                dst: $dst,
                src: $src,
            }

            encoding {
                PREFIX,
                0x0F,
                OPCODE,
                0b11,
                dst[2..0],
                src[2..0],
            }

            asm {
                "{self.MNEMONIC} {dst}, {src}"
            }
        }
    };
}

fp_convert_norex_template!(Cvtsi2ss32NorexTemplate, SSE, XMM32low, GPR32low)
fp_convert_norex_template!(Cvttss2si32NorexTemplate, SSE, GPR32low, XMM32low)
fp_convert_norex_template!(Cvtsi2sd32NorexTemplate, SSE2, XMMlow, GPR32low)
fp_convert_norex_template!(Cvttsd2si32NorexTemplate, SSE2, GPR32low, XMMlow)
fp_convert_norex_template!(MovdXmmGpr32NorexTemplate, SSE2, XMM32low, GPR32low)

// No-REX SSE forms: canonicalize target for the low-xmm ALU and movsd copies,
// and the assembler's preferred candidate for xmm0..xmm7. The destination's
// direction is part of the operand declaration, not of the modeled value: the
// arithmetic forms are two-address (dst is read and written), movsd only
// writes. Dropping that made every low-xmm chain look dependency-free to the
// scheduler.
macro fp_norex {
    ( $feature:ident, $tmpl:ident, $class:ident, $b:tt, $( ( $name:ident, $op:literal, $mn:literal, $opc:literal ) ),* ) => {
        $( instruction $name for [$feature] : $tmpl {
               param OPNAME: String = $op;
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [$class]; }
               behavior $b
           } )*
    };
}

fp_norex!(SSE, FpArith32Norex, WriteFPAdd, { dst = fadd(dst, src); },
    (AddssNorex, "addss_norex", "addss", 0x58)
)

fp_norex!(SSE, FpArith32Norex, WriteFPAdd, { dst = fsub(dst, src); },
    (SubssNorex, "subss_norex", "subss", 0x5C)
)

fp_norex!(SSE, FpArith32Norex, WriteFPMul, { dst = fmul(dst, src); },
    (MulssNorex, "mulss_norex", "mulss", 0x59)
)

fp_norex!(SSE, FpArith32Norex, WriteFPDiv, { dst = fdiv(dst, src); },
    (DivssNorex, "divss_norex", "divss", 0x5E)
)

fp_norex!(SSE, FpArith32Norex, WriteFPMove, { dst = src; },
    (MovssNorex, "movss_norex", "movss", 0x10)
)

fp_norex!(SSE2, FpArithNorex, WriteFPAdd, { dst = fadd(dst, src); },
    (AddsdNorex, "addsd_norex", "addsd", 0x58)
)

fp_norex!(SSE2, FpArithNorex, WriteFPAdd, { dst = fsub(dst, src); },
    (SubsdNorex, "subsd_norex", "subsd", 0x5C)
)

fp_norex!(SSE2, FpArithNorex, WriteFPMul, { dst = fmul(dst, src); },
    (MulsdNorex, "mulsd_norex", "mulsd", 0x59)
)

fp_norex!(SSE2, FpArithNorex, WriteFPDiv, { dst = fdiv(dst, src); },
    (DivsdNorex, "divsd_norex", "divsd", 0x5E)
)

fp_norex!(SSE2, FpArithNorex, WriteFPMove, { dst = src; },
    (MovsdNorex, "movsd_norex", "movsd", 0x10)
)

instruction Addss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "addss";
    param OPCODE: bits<8> = 0x58;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fadd(dst, src);
    }
}

instruction Subss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "subss";
    param OPCODE: bits<8> = 0x5C;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fsub(dst, src);
    }
}

instruction Mulss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "mulss";
    param OPCODE: bits<8> = 0x59;

    schedule { units = [WriteFPMul]; }

    behavior {
        dst = fmul(dst, src);
    }
}

instruction Divss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "divss";
    param OPCODE: bits<8> = 0x5E;

    schedule { units = [WriteFPDiv]; }

    behavior {
        dst = fdiv(dst, src);
    }
}

instruction Movss for [X86_64] : FpArith32 {
    param MNEMONIC: String = "movss";
    param OPCODE: bits<8> = 0x10;

    schedule { units = [WriteFPMove]; }

    behavior {
        dst = src;
    }
}

