//! SSE2 scalar double-precision floating-point instructions.

// SSE2 scalar double-precision floating point. The sixteen XMM registers form
// a 128-bit file; scalar instructions operate through the 64-bit `XMM` view
// (the semantic engine reads a float-typed register's bits as a binary64
// APFloat, so `fadd`/`fmul` on XMM operands compute real double results), as
// with the AArch64 `FPR64` view of its 128-bit `VPR` file. The file class
// itself roots no operands and carries no traits.

register_class XMM128 for [X86_64] {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 128;

    registers {
        xmm0..xmm15 => { },
    }
}

// Scalar writes through this view merge into the untouched upper lane, so a
// physical destination is also a read — `cvtsi2sd xmm0, rax` chains on xmm0
// (measured: 4.01 cyc/iteration for that block against a ~0.3 throughput
// floor). Two-address scalar arithmetic reads its destination anyway; the
// merge matters for the one-source writers (cvtsi2sd, reg-reg movsd).

register_class XMM for [X86_64] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// `movq xmm, r64` zero-extends through bit 127: same width, no merge, so its
// destination write breaks dependencies instead of chaining on them.

register_class XMMzx for [X86_64] : XMM128 {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;

    registers {
        xmm0..xmm15 => { traits = [float] },
    }
}

// Low-XMM subclass (xmm0..xmm7) selected post-RA for the REX-free SSE encodings
// GNU as emits when no register-number 4th bit is needed. Shares the XMM file,
// carries no traits, and is never an allocation class (its ops leave their
// values unmodeled, so they root no isel rule).
register_class XMMlow for [X86_64] {
    file = XMM128;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 64;
    param WRITE_POLICY: String = "merge";

    registers {
        xmm0 => { index = 0 },
        xmm1 => { index = 1 },
        xmm2 => { index = 2 },
        xmm3 => { index = 3 },
        xmm4 => { index = 4 },
        xmm5 => { index = 5 },
        xmm6 => { index = 6 },
        xmm7 => { index = 7 },
    }
}

// `op xmm_dst, xmm_src`: the F2 mandatory prefix, REX (W=0; R/B carry the 4th
// register-number bits), the 0x0F escape, the opcode, then ModR/M(mod=11,
// reg=dst, rm=src). The op is two-address — dst is also the first source — so
// selection ties it to the destination, matching the `addf`/`subf` shape.
template FpArith for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMM,
        src: XMM,
    }

    encoding {
        0..7 => 0xF2,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => OPCODE,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

// No-REX scalar-double form (xmm0..xmm7): F2 prefix, 0x0F escape, opcode, then
// ModR/M(mod=11, reg=dst, rm=src). Dropping the REX byte shifts the tail up 8
// bits, exactly as the 16-bit 0x66 forms do.
template FpArithNorex for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: XMMlow,
        src: XMMlow,
    }

    encoding {
        0..7 => 0xF2,
        8..15 => 0x0F,
        16..23 => OPCODE,
        24..26 => src[0..2],
        27..29 => dst[0..2],
        30..31 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }
}

// No-REX SSE forms: canonicalize target for the low-xmm ALU and movsd copies,
// and the assembler's preferred candidate for xmm0..xmm7. The value semantics
// stay unmodeled (`todo()`) so these root no selection rule, but the
// destination's direction is part of the operand declaration, not of the
// modeled value: the arithmetic forms are two-address (dst is read and
// written), movsd only writes. Dropping that made every low-xmm chain look
// dependency-free to the scheduler.
macro fp_norex {
    ( $class:ident, $b:tt, $( ( $name:ident, $op:literal, $mn:literal, $opc:literal ) ),* ) => {
        $( instruction $name for [X86_64] : FpArithNorex {
               param OPNAME: String = $op;
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [$class]; }
               behavior $b
           } )*
    };
}

fp_norex!(WriteFPAdd, { dst = todo(dst); },
    (AddsdNorex, "addsd_norex", "addsd", 0x58),
    (SubsdNorex, "subsd_norex", "subsd", 0x5C)
)

fp_norex!(WriteFPMul, { dst = todo(dst); },
    (MulsdNorex, "mulsd_norex", "mulsd", 0x59)
)

fp_norex!(WriteFPDiv, { dst = todo(dst); },
    (DivsdNorex, "divsd_norex", "divsd", 0x5E)
)

fp_norex!(WriteFPMove, { dst = todo(); },
    (MovsdNorex, "movsd_norex", "movsd", 0x10)
)

instruction Addsd for [X86_64] : FpArith {
    param MNEMONIC: String = "addsd";
    param OPCODE: bits<8> = 0x58;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fadd(dst, src);
    }
}

instruction Subsd for [X86_64] : FpArith {
    param MNEMONIC: String = "subsd";
    param OPCODE: bits<8> = 0x5C;

    schedule { units = [WriteFPAdd]; }

    behavior {
        dst = fsub(dst, src);
    }
}

instruction Mulsd for [X86_64] : FpArith {
    param MNEMONIC: String = "mulsd";
    param OPCODE: bits<8> = 0x59;

    schedule { units = [WriteFPMul]; }

    behavior {
        dst = fmul(dst, src);
    }
}

instruction Divsd for [X86_64] : FpArith {
    param MNEMONIC: String = "divsd";
    param OPCODE: bits<8> = 0x5E;

    schedule { units = [WriteFPDiv]; }

    behavior {
        dst = fdiv(dst, src);
    }
}

instruction Ucomisd for [X86_64] {
    param MNEMONIC: String = "ucomisd";

    schedule { units = [WriteFPCompare]; }

    operands {
        lhs: XMM,
        rhs: XMM,
    }

    encoding {
        0..7 => 0x66,
        8 => rhs[3],
        9 => 0b0,
        10 => lhs[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x2E,
        32..34 => rhs[0..2],
        35..37 => lhs[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {lhs}, {rhs}"
    }

    behavior {
        EFLAGS::cf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs < rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::pf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if (lhs != lhs) | (rhs != rhs) {
            zext(0b1, 1)
        } else if lhs == rhs {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = zext(0b0, 1);
        EFLAGS::of = zext(0b0, 1);
    }
}

// `movsd xmm_dst, xmm_src` (F2 0F 10 /r): register-to-register scalar-double
// move. Emitted by register allocation to copy a value before a two-address FP
// op overwrites it; the reg/rm layout matches `FpArith`.
instruction Movsd for [X86_64] {
    param MNEMONIC: String = "movsd";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMM,
        src: XMM,
    }

    encoding {
        0..7 => 0xF2,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x10,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = src;
    }
}

// `movq xmm, r64` copies an integer bit pattern into the low binary64 lane.
instruction MovqXmmGpr for [X86_64] {
    param OPNAME: String = "movq_xmm_gpr";
    param MNEMONIC: String = "movq";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: XMMzx,
        src: GPR,
    }

    encoding {
        0..7 => 0x66,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b1,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x6E,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

// `movq r64, xmm` copies the low binary64 lane into an integer register.
instruction MovqGprXmm for [X86_64] {
    param OPNAME: String = "movq_gpr_xmm";
    param MNEMONIC: String = "movq";

    schedule { units = [WriteFPMove]; }

    operands {
        dst: GPR,
        src: XMM,
    }

    encoding {
        0..7 => 0x66,
        8 => dst[3],
        9 => 0b0,
        10 => src[3],
        11 => 0b1,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x7E,
        32..34 => dst[0..2],
        35..37 => src[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = bitcast(src);
    }
}

// Convert a signed 32-bit integer to scalar binary64 (`cvtsi2sd xmm, r32`).
instruction Cvtsi2sd32 for [X86_64] {
    param OPNAME: String = "cvtsi2sd32";
    param MNEMONIC: String = "cvtsi2sd";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM,
        src: GPR32,
    }

    encoding {
        0..7 => 0xF2,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x2A,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 11, 52);
    }
}

// Convert a signed 64-bit integer to scalar binary64 (`cvtsi2sd xmm, r64`).
instruction Cvtsi2sd64 for [X86_64] {
    param OPNAME: String = "cvtsi2sd64";
    param MNEMONIC: String = "cvtsi2sd";

    schedule { units = [WriteSIToFP]; }

    operands {
        dst: XMM,
        src: GPR,
    }

    encoding {
        0..7 => 0xF2,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b1,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x2A,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = sitofp(src, 11, 52);
    }
}

// Convert scalar binary64 to a signed 32-bit integer, truncating toward zero.
instruction Cvttsd2si32 for [X86_64] {
    param OPNAME: String = "cvttsd2si32";
    param MNEMONIC: String = "cvttsd2si";

    schedule { units = [WriteFPToSI]; }

    operands {
        dst: GPR32,
        src: XMM,
    }

    encoding {
        0..7 => 0xF2,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x2C,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = fptosi(src, 32);
    }
}

// Convert scalar binary64 to a signed 64-bit integer, truncating toward zero.
instruction Cvttsd2si64 for [X86_64] {
    param OPNAME: String = "cvttsd2si64";
    param MNEMONIC: String = "cvttsd2si";

    schedule { units = [WriteFPToSI]; }

    operands {
        dst: GPR,
        src: XMM,
    }

    encoding {
        0..7 => 0xF2,
        8 => src[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b1,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x2C,
        32..34 => src[0..2],
        35..37 => dst[0..2],
        38..39 => 0b11,
    }

    asm {
        "{self.MNEMONIC} {dst}, {src}"
    }

    behavior {
        dst = fptosi(src, 64);
    }
}

instruction MovsdLoadDisp for [X86_64] {
    param OPNAME: String = "movsd_load_disp";
    param MNEMONIC: String = "movsd";

    operands {
        dst: XMM,
        base: GPR,
        imm: bits<32>,
    }

    encoding {
        0..7 => 0xF2,
        8 => base[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x10,
        32..34 => base[0..2],
        35..37 => dst[0..2],
        38..39 => 0b10,
        40..71 => imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior {
        dst = load(base + sext(imm, self.XLEN), 8, 0b0);
    }
}

instruction MovsdStoreDisp for [X86_64] {
    param OPNAME: String = "movsd_store_disp";
    param MNEMONIC: String = "movsd";

    operands {
        base: GPR,
        imm: bits<32>,
        src: XMM,
    }

    encoding {
        0..7 => 0xF2,
        8 => base[3],
        9 => 0b0,
        10 => src[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x11,
        32..34 => base[0..2],
        35..37 => src[0..2],
        38..39 => 0b10,
        40..71 => imm,
    }

    asm {
        "{self.MNEMONIC} [{base} + {imm}], {src}"
    }

    behavior {
        store(base + sext(imm, self.XLEN), 8, src);
    }
}

instruction MovsdLoadDispSib for [X86_64] {
    param OPNAME: String = "movsd_load_disp_sib";
    param MNEMONIC: String = "movsd";

    operands {
        dst: XMM,
        base: GPRsib,
        imm: bits<32>,
    }

    encoding {
        0..7 => 0xF2,
        8 => base[3],
        9 => 0b0,
        10 => dst[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x10,
        32..34 => 0b100,
        35..37 => dst[0..2],
        38..39 => 0b10,
        40..47 => 0x24,
        48..79 => imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior { dst = todo(); }
}

instruction MovsdStoreDispSib for [X86_64] {
    param OPNAME: String = "movsd_store_disp_sib";
    param MNEMONIC: String = "movsd";

    operands {
        base: GPRsib,
        imm: bits<32>,
        src: XMM,
    }

    encoding {
        0..7 => 0xF2,
        8 => base[3],
        9 => 0b0,
        10 => src[3],
        11 => 0b0,
        12..15 => 0b0100,
        16..23 => 0x0F,
        24..31 => 0x11,
        32..34 => 0b100,
        35..37 => src[0..2],
        38..39 => 0b10,
        40..47 => 0x24,
        48..79 => imm,
    }

    asm {
        "{self.MNEMONIC} [{base} + {imm}], {src}"
    }

    behavior { }
}
