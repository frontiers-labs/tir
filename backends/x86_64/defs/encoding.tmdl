// The pieces every x86 encoding is built from, written once here instead of
// once per width and once per register range.
//
// An `if` over the operands is a shape: the encoder picks the bit map whose
// guard holds. That is how one instruction spells both the REX and the REX-free
// form of the same operation, which the model used to carry as twin
// instructions plus a post-register-allocation pass that swapped one for the
// other.

// The 0100 WRXB prefix. Present when the operation needs the wide bit (`w`), or
// a register needs its fourth bit (`reg[3]`/`rm[3]`), or the caller says it is
// needed anyway (`needed`) — which is how an 8-bit form reaches spl/bpl/sil/dil,
// whose names exist only behind a REX byte.
fn rex(w, reg, rm, needed) {
    if w | reg[3] | rm[3] | needed {
        (0b0100, w, reg[3], 0b0, rm[3])
    } else {
        ()
    }
}

// The same prefix where the ModR/M reg field holds an opcode extension rather
// than a register, so only the r/m register can need its fourth bit.
fn rex_rm(w, rm, needed) {
    if w | rm[3] | needed {
        (0b0100, w, 0b0, 0b0, rm[3])
    } else {
        ()
    }
}

// ModR/M with both operands in registers: mod=11, then the two low register
// numbers. `reg` is the /r field, `rm` the r/m field.
fn modrm_reg(reg, rm) {
    (0b11, reg[2..0], rm[2..0])
}

// ModR/M where the reg field is an opcode extension (the /digit of a group
// opcode) rather than a register number.
fn modrm_ext(ext, rm) {
    (0b11, ext, rm[2..0])
}

// Whether an immediate is the sign-extension of its own low `n` bits, i.e.
// whether the short form of the instruction spells the same value.
fn signed_fits(x, n) {
    sext(x as bits<n>, width(x)) == x
}

// A base register whose low three bits are 100 (rsp, r12) means "a SIB byte
// follows" in the r/m field, so the address is spelled with one; the SIB that
// names no index and the same base is 0x24.
fn is_sib(base) {
    base[2..0] == 0b100
}

fn rm_field(base) {
    if is_sib(base) { 0b100 } else { base[2..0] }
}

// scale=00, index=100 (none), base. The base field repeats the register the
// r/m field could not name, so the word still says which register it was.
fn sib_byte(base) {
    if is_sib(base) { (0b00, 0b100, base[2..0]) } else { () }
}

// A base whose low three bits are 101 (rbp, r13) means "rip-relative" with
// mod=00, so an address through it always carries a displacement.
fn forced_disp8(base) {
    base[2..0] == 0b101
}

// `[base]`: mod=00, except through rbp and r13, which spell a zero byte.
fn modrm_base(reg, base) {
    (
        if forced_disp8(base) {
            (0b01, reg[2..0], rm_field(base))
        } else {
            (0b00, reg[2..0], rm_field(base))
        },
        sib_byte(base),
        if forced_disp8(base) { 0x00 } else { () },
    )
}

// Whether the displacement is spelled in one byte: it has to fit, and it has to
// be there at all, which a zero displacement only is through rbp or r13.
fn needs_disp8(base, disp) {
    signed_fits(disp, 8) & ((disp != 0b0) | forced_disp8(base))
}

// `[base + disp]`: the displacement decides mod, and so how many bytes of it
// the instruction carries.
fn modrm_disp(reg, base, disp) {
    (
        if ~signed_fits(disp, 8) {
            (0b10, reg[2..0], rm_field(base))
        } else if needs_disp8(base, disp) {
            (0b01, reg[2..0], rm_field(base))
        } else {
            (0b00, reg[2..0], rm_field(base))
        },
        sib_byte(base),
        if ~signed_fits(disp, 8) {
            disp
        } else if needs_disp8(base, disp) {
            disp as bits<8>
        } else {
            ()
        },
    )
}

// The prefix for an address with an index register, which has its own fourth
// bit in REX.X.
fn rex_sib(w, reg, index, base) {
    if w | reg[3] | index[3] | base[3] {
        (0b0100, w, reg[3], index[3], base[3])
    } else {
        ()
    }
}

// `[base + index * scale]`: the r/m field is the SIB escape, and the SIB byte
// names the scale, the index and the base. rbp and r13 need the zero byte here
// too, for the same reason.
fn modrm_sib(reg, base, index, scale) {
    (
        if forced_disp8(base) {
            (0b01, reg[2..0], 0b100)
        } else {
            (0b00, reg[2..0], 0b100)
        },
        (scale, index[2..0], base[2..0]),
        if forced_disp8(base) { 0x00 } else { () },
    )
}

// Whether an 8-bit operand names a register only a REX byte can reach: spl,
// bpl, sil and dil are numbers 4..7, which without REX name ah, ch, dh and bh.
fn needs_rex8(a, b) {
    (a ~>= 0b0100) | (b ~>= 0b0100)
}

fn needs_rex8_one(a) {
    a ~>= 0b0100
}
