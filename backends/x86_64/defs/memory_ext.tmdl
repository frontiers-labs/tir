    behavior {
        dst = load(base + sext(imm, self.XLEN), 4, 0b0);
    }
}

instruction Mov32StoreDisp for [X86_64] {
    param OPNAME: String = "mov_store32_disp";
    param MNEMONIC: String = "mov";

    operands {
        base: GPR,
