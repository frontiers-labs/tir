instruction Add16MemoryIndex2Rmw for [X86_64] {
    param OPNAME: String = "add16_mem_index2_rmw";
    param MNEMONIC: String = "add";
    operands { base: GPR, index: GPRaddrIndex, src: GPR16, }
    encoding {
        0x66,
        rex_sib(0b0, src, index, base, 0b0),
        0x01,
        modrm_sib(src, base, index, 0b01),
    }
    asm { "{self.MNEMONIC} word ptr [{base} + 2*{index}], {src}" }
    behavior {
        let lhs = load(base + (index << zext(0b1, 64)), 2, 0b0);
        add_flags!({ lhs }, { src }, { 16 }, { 15 })
        store(base + (index << zext(0b1, 64)), 2, lhs + src);
    }
}

instruction Sub16MemoryIndex2Rmw for [X86_64] {
    param OPNAME: String = "sub16_mem_index2_rmw";
    param MNEMONIC: String = "sub";
    operands { base: GPR, index: GPRaddrIndex, src: GPR16, }
    encoding {
        0x66,
        rex_sib(0b0, src, index, base, 0b0),
        0x29,
        modrm_sib(src, base, index, 0b01),
    }
    asm { "{self.MNEMONIC} word ptr [{base} + 2*{index}], {src}" }
    behavior {
        let lhs = load(base + (index << zext(0b1, 64)), 2, 0b0);
        memory_sub_flags!({ lhs }, { src }, { 15 })
        store(base + (index << zext(0b1, 64)), 2, lhs - src);
    }
}

instruction Xor16MemoryIndex2Source for [X86_64] {
    param OPNAME: String = "xor16_mem_index2";
    param MNEMONIC: String = "xor";
    operands { dst: GPR16, base: GPR, index: GPRaddrIndex, }
    encoding {
        0x66,
        rex_sib(0b0, dst, index, base, 0b0),
        0x33,
        modrm_sib(dst, base, index, 0b01),
    }
    asm { "{self.MNEMONIC} {dst}, word ptr [{base} + 2*{index}]" }
    behavior {
        let rhs = load(base + (index << zext(0b1, 64)), 2, 0b0);
        logic_flags!({ dst ^ rhs }, { 16 }, { 15 })
        dst = dst ^ rhs;
    }
}

instruction Inc32MemoryIndex4Disp for [X86_64] {
    param OPNAME: String = "inc32_mem_index4_disp";
    param MNEMONIC: String = "inc";
    operands { base: GPR, index: GPRaddrIndex, imm: bits<32>, }
    encoding {
        rex_sib_ext(0b0, index, base),
        0xFF,
        modrm_sib_disp_ext(0b000, base, index, 0b10, imm),
    }
    asm { "{self.MNEMONIC} dword ptr [{base} + 4*{index} + {imm}]" }
    behavior {
        let address = base + (index << zext(0b10, 64)) + sext(imm, 64);
        let old = load(address, 4, 0b0);
        let result = old + zext(0b1, 32);
        EFLAGS::zf = if result == zext(0b0, 32) { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(result, 31, 31);
        EFLAGS::of = extract(~old & result, 31, 31);
        store(address, 4, result);
    }
}

// `lea r64, [base + index]` using a SIB byte with scale 1 and no displacement.
template LeaBaseIndexTemplate for [X86_64] {
    param SCALE_BITS: bits<2>;
    operands {
        dst: GPR,
        base: GPR,
        index: GPRaddrIndex,
    }
    encoding {
        rex_sib(0b1, dst, index, base, 0b0),
        0x8D,
        modrm_sib(dst, base, index, SCALE_BITS),
    }
}

instruction LeaBaseIndex for [X86_64] : LeaBaseIndexTemplate {
    param OPNAME: String = "lea_base_index";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b00;
    schedule { units = [WriteILeaSimple]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {index}]"
    }

    behavior {
        dst = base + index;
    }
}

instruction LeaBaseIndex2 for [X86_64] : LeaBaseIndexTemplate {
    param OPNAME: String = "lea_base_index2";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b01;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 2*{index}]"
    }

    behavior {
        dst = base + (index << zext(0b1, 64));
    }
}

