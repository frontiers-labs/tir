// `lea r64, [base + index]` using a SIB byte with scale 1 and no displacement.
template LeaBaseIndexTemplate for [X86_64] {
    param SCALE_BITS: bits<2>;
    operands {
        dst: GPR,
        base: GPR,
        index: GPRaddrIndex,
    }
    encoding {
        rex_sib(0b1, dst, index, base),
        0x8D,
        modrm_sib(dst, base, index, SCALE_BITS),
    }
}

instruction LeaBaseIndex for [X86_64] : LeaBaseIndexTemplate {
    param OPNAME: String = "lea_base_index";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b00;
    schedule { units = [WriteILeaSimple]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {index}]"
    }

    behavior {
        dst = base + index;
    }
}

instruction LeaBaseIndex2 for [X86_64] : LeaBaseIndexTemplate {
    param OPNAME: String = "lea_base_index2";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b01;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 2*{index}]"
    }

    behavior {
        dst = base + (index << 1);
    }
}

// The scale-four SIB form observed in compiler-generated address arithmetic.
instruction LeaBaseIndex4 for [X86_64] : LeaBaseIndexTemplate {
    param OPNAME: String = "lea_base_index4";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b10;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 4*{index}]"
    }

    behavior {
        dst = base + (index << 2);
    }
}

instruction LeaBaseIndex8 for [X86_64] : LeaBaseIndexTemplate {
    param OPNAME: String = "lea_base_index8";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b11;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 8*{index}]"
    }

    behavior {
        dst = base + (index << 3);
    }
}






template LeaScaledIndex for [X86_64] {
    param SCALE_BITS: bits<2>;

    schedule { units = [WriteILeaComplex]; }

    operands {
        dst: GPR,
        index: GPRaddrIndex,
    }

    encoding {
        0b0100,
        0b1,
        dst[3],
        index[3],
        0b0,
        0x8D,
        0b00,
        dst[2..0],
        0b100,
        SCALE_BITS,
        index[2..0],
        0b101,
        0x00000000,
    }
}

instruction LeaIndex4 for [X86_64] : LeaScaledIndex {
    param OPNAME: String = "lea_index4";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b10;

    asm {
        "{self.MNEMONIC} {dst}, [4*{index}]"
    }

    behavior {
        dst = index << 2;
    }
}

instruction LeaIndex8 for [X86_64] : LeaScaledIndex {
    param OPNAME: String = "lea_index8";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b11;

    asm {
        "{self.MNEMONIC} {dst}, [8*{index}]"
    }

    behavior {
        dst = index << 3;
    }
}

template LeaBaseIndexDisp8Template for [X86_64] {
    param SCALE_BITS: bits<2>;

    operands {
        dst: GPR,
        base: GPR,
        index: GPRaddrIndex,
        imm: bits<8>,
    }

    encoding {
        0b0100,
        0b1,
        dst[3],
        index[3],
        base[3],
        0x8D,
        0b01,
        dst[2..0],
        0b100,
        SCALE_BITS,
        index[2..0],
        base[2..0],
        imm,
    }
}

instruction LeaBaseIndexDisp8 for [X86_64] : LeaBaseIndexDisp8Template {
    param OPNAME: String = "lea_base_index_disp8";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b00;
    schedule { units = [WriteILeaSimple]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {index} + {imm}]"
    }

    behavior {
        dst = base + index + sext(imm, self.XLEN);
    }
}

instruction LeaBaseIndex2Disp8 for [X86_64] : LeaBaseIndexDisp8Template {
    param OPNAME: String = "lea_base_index2_disp8";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b01;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 2*{index} + {imm}]"
    }

    behavior {
        dst = base + (index << 1) + sext(imm, self.XLEN);
    }
}

instruction LeaBaseIndex4Disp8 for [X86_64] : LeaBaseIndexDisp8Template {
    param OPNAME: String = "lea_base_index4_disp8";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b10;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 4*{index} + {imm}]"
    }

    behavior {
        dst = base + (index << 2) + sext(imm, self.XLEN);
    }
}

instruction LeaBaseIndex8Disp8 for [X86_64] : LeaBaseIndexDisp8Template {
    param OPNAME: String = "lea_base_index8_disp8";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b11;
    schedule { units = [WriteILeaComplex]; }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + 8*{index} + {imm}]"
    }

    behavior {
        dst = base + (index << 3) + sext(imm, self.XLEN);
    }
}

template LeaIndexDisp32 for [X86_64] {
    param SCALE_BITS: bits<2>;

    schedule { units = [WriteILeaComplex]; }

    operands {
        dst: GPR,
        index: GPRaddrIndex,
        imm: bits<32>,
    }

    encoding {
        0b0100,
        0b1,
        dst[3],
        index[3],
        0b0,
        0x8D,
        0b00,
        dst[2..0],
        0b100,
        SCALE_BITS,
        index[2..0],
        0b101,
        imm,
    }
}

instruction LeaIndex4Disp32 for [X86_64] : LeaIndexDisp32 {
    param OPNAME: String = "lea_index4_disp32";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b10;

    asm {
        "{self.MNEMONIC} {dst}, [4*{index} + {imm}]"
    }

    behavior {
        dst = (index << 2) + sext(imm, self.XLEN);
    }
}

instruction LeaIndex8Disp32 for [X86_64] : LeaIndexDisp32 {
    param OPNAME: String = "lea_index8_disp32";
    param MNEMONIC: String = "lea";
    param SCALE_BITS: bits<2> = 0b11;

    asm {
        "{self.MNEMONIC} {dst}, [8*{index} + {imm}]"
    }

    behavior {
        dst = (index << 3) + sext(imm, self.XLEN);
    }
}



instruction LeaBaseDisp for [X86_64] {
    param OPNAME: String = "lea_base_disp";
    param MNEMONIC: String = "lea";

    schedule { units = [WriteILeaSimple]; }

    operands {
        dst: GPR,
        base: GPR,
        imm: bits<32>,
    }

    encoding {
        rex(0b1, dst, base, 0b0),
        0x8D,
        modrm_disp(dst, base, imm),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior {
        dst = base + sext(imm, self.XLEN);
    }
}


// `lea r64, [rip + disp32]` (REX.W + 0x8D + ModR/M mod=00 reg=dst rm=101): loads
// the pc-relative address of a symbol. Emitted by `lower_addr_of`; the disp32 is
// left as a fixup and relocated (R_X86_64_PC32) against the target symbol at link
// time. The disp is measured from the end of the 7-byte instruction.
instruction LeaRip for [X86_64] {
    param OPNAME: String = "lea";
    param MNEMONIC: String = "lea";

    schedule { units = [WriteILeaRip]; }

    operands {
        dst: GPR,
        imm: bits<32>,
    }

    encoding {
        rex!({ 0b0 }, { dst[3] }, 0b1)
        0x8D,
        0b00,
        dst[2..0],
        0b101,
        imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, [rip + {imm}]"
    }

    behavior {
        dst = PC::pc + sext(imm, self.XLEN) + zext(0b111, self.XLEN);
    }
}

// `push r64` / `pop r64` (0x50+rd / 0x58+rd): the register number's low bits
// live in the opcode byte; a plain REX carries the 4th bit.
template PushPop for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<5>;

    operands {
        reg: GPR,
    }

    encoding {
        rex_rm(0b0, reg, 0b0),
        OPCODE,
        reg[2..0],
    }

    asm {
        "{self.MNEMONIC} {reg}"
    }
}

instruction Push for [X86_64] : PushPop {
    param MNEMONIC: String = "push";
    param OPCODE: bits<5> = 0b01010;

    behavior {
        GPR::rsp = GPR::rsp - zext(0b1000, self.XLEN);
        store(GPR::rsp, 8, reg);
    }
}

instruction Pop for [X86_64] : PushPop {
    param MNEMONIC: String = "pop";
    param OPCODE: bits<5> = 0b01011;

    behavior {
        reg = load(GPR::rsp, 8, 0b0);
        GPR::rsp = GPR::rsp + zext(0b1000, self.XLEN);
    }
}

