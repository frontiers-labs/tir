macro indexed_loads {
    ( $stem:ident, $opstem:literal, $tmpl:ident, $mnemonic:literal,
      $memory_prefix:literal, $opcode:literal, $escape:literal,
      $bytes:literal, $dst_width:literal, $extend:ident ) => {
        instruction ${concat($stem, "Index")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b00;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + {index}]")} }
            behavior { dst = $extend(load(base + index, $bytes, 0b0), $dst_width); }
        }
        instruction ${concat($stem, "Index2")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index2")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b01;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + 2*{index}]")} }
            behavior { dst = $extend(load(base + (index << zext(0b1, 64)), $bytes, 0b0), $dst_width); }
        }
        instruction ${concat($stem, "Index4")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index4")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b10;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + 4*{index}]")} }
            behavior { dst = $extend(load(base + (index << zext(0b10, 64)), $bytes, 0b0), $dst_width); }
        }
        instruction ${concat($stem, "Index8")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index8")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b11;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + 8*{index}]")} }
            behavior { dst = $extend(load(base + (index << zext(0b11, 64)), $bytes, 0b0), $dst_width); }
        }
    };
}

macro indexed_stores {
    ( $stem:ident, $opstem:literal, $tmpl:ident, $bytes:literal ) => {
        instruction ${concat($stem, "Index")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b00;
            asm { "{self.MNEMONIC} [{base} + {index}], {src}" }
            behavior { store(base + index, $bytes, src); }
        }
        instruction ${concat($stem, "Index2")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index2")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b01;
            asm { "{self.MNEMONIC} [{base} + 2*{index}], {src}" }
            behavior { store(base + (index << zext(0b1, 64)), $bytes, src); }
        }
        instruction ${concat($stem, "Index4")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index4")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b10;
            asm { "{self.MNEMONIC} [{base} + 4*{index}], {src}" }
            behavior { store(base + (index << zext(0b10, 64)), $bytes, src); }
        }
        instruction ${concat($stem, "Index8")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index8")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b11;
            asm { "{self.MNEMONIC} [{base} + 8*{index}], {src}" }
            behavior { store(base + (index << zext(0b11, 64)), $bytes, src); }
        }
    };
}

macro indexed_loads_disp {
    ( $stem:ident, $opstem:literal, $tmpl:ident, $mnemonic:literal,
      $memory_prefix:literal, $opcode:literal, $escape:literal,
      $bytes:literal, $dst_width:literal, $extend:ident ) => {
        instruction ${concat($stem, "IndexDisp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index_disp")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b00;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + {index} + {imm}]")} }
            behavior { dst = $extend(load(base + index + sext(imm, 64), $bytes, 0b0), $dst_width); }
        }
        instruction ${concat($stem, "Index2Disp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index2_disp")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b01;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + 2*{index} + {imm}]")} }
            behavior { dst = $extend(load(base + (index << zext(0b1, 64)) + sext(imm, 64), $bytes, 0b0), $dst_width); }
        }
        instruction ${concat($stem, "Index4Disp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index4_disp")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b10;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + 4*{index} + {imm}]")} }
            behavior { dst = $extend(load(base + (index << zext(0b10, 64)) + sext(imm, 64), $bytes, 0b0), $dst_width); }
        }
        instruction ${concat($stem, "Index8Disp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index8_disp")};
            param MNEMONIC: String = $mnemonic;
            param OPCODE: bits<8> = $opcode;
            param ESCAPE: bits<1> = $escape;
            param SCALE_BITS: bits<2> = 0b11;
            asm { ${concat("{self.MNEMONIC} {dst}, ", $memory_prefix, "[{base} + 8*{index} + {imm}]")} }
            behavior { dst = $extend(load(base + (index << zext(0b11, 64)) + sext(imm, 64), $bytes, 0b0), $dst_width); }
        }
    };
}

macro indexed_stores_disp {
    ( $stem:ident, $opstem:literal, $tmpl:ident, $bytes:literal ) => {
        instruction ${concat($stem, "IndexDisp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index_disp")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b00;
            asm { "{self.MNEMONIC} [{base} + {index} + {imm}], {src}" }
            behavior { store(base + index + sext(imm, 64), $bytes, src); }
        }
        instruction ${concat($stem, "Index2Disp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index2_disp")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b01;
            asm { "{self.MNEMONIC} [{base} + 2*{index} + {imm}], {src}" }
            behavior { store(base + (index << zext(0b1, 64)) + sext(imm, 64), $bytes, src); }
        }
        instruction ${concat($stem, "Index4Disp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index4_disp")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b10;
            asm { "{self.MNEMONIC} [{base} + 4*{index} + {imm}], {src}" }
            behavior { store(base + (index << zext(0b10, 64)) + sext(imm, 64), $bytes, src); }
        }
        instruction ${concat($stem, "Index8Disp")} for [X86_64] : $tmpl {
            param OPNAME: String = ${concat($opstem, "_index8_disp")};
            param MNEMONIC: String = "mov";
            param SCALE_BITS: bits<2> = 0b11;
            asm { "{self.MNEMONIC} [{base} + 8*{index} + {imm}], {src}" }
            behavior { store(base + (index << zext(0b11, 64)) + sext(imm, 64), $bytes, src); }
        }
    };
}

