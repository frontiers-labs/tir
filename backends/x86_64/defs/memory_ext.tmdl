//! Narrow and displacement-based memory operations plus stack push/pop instructions.

// Memory-access extensions: sub-64-bit loads/stores (lb/lh/lw parity through
// movzx/movsx and narrow mov), a disp32 addressing form for the 64-bit mov,
// and the stack push/pop pair. Addressing is register-direct; the rsp/rbp (and
// r12/r13) ModR/M escapes get their own encodings below.

template ExtendLoad for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: GPR,
        base: GPR,
    }

    encoding {
        rex(0b1, dst, base, 0b0),
        0x0F,
        OPCODE,
        modrm_base(dst, base),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }
}

// The same load with a 32-bit destination: the write zero-extends to 64 bits,
// so the model is the 32-bit view.
template ExtendLoad32 for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: GPR32,
        base: GPR,
    }

    encoding {
        rex(0b0, dst, base, 0b0),
        0x0F,
        OPCODE,
        modrm_base(dst, base),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }
}

macro extend_load32 {
    ( $( ( $name:ident, $opname:literal, $mnemonic:literal, $size:literal, $opcode:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : ExtendLoad32 {
               param OPNAME: String = $opname;
               param MNEMONIC: String = $mnemonic;
               param OPCODE: bits<8> = $opcode;
               asm { ${concat("{self.MNEMONIC} {dst}, ", $size, " ptr [{base}]")} }
               behavior { $($b)* }
           } )*
    };
}

extend_load32!(
    (Movzx8Load32, "movzx8_load32", "movzx", "byte", 0xB6,
     { dst = zext(load(base, 1, 0b0), 32); }),
    (Movzx16Load32, "movzx16_load32", "movzx", "word", 0xB7,
     { dst = zext(load(base, 2, 0b0), 32); }),
    (Movsx8Load32, "movsx8_load32", "movsx", "byte", 0xBE,
     { dst = sext(load(base, 1, 0b1), 32); }),
    (Movsx16Load32, "movsx16_load32", "movsx", "word", 0xBF,
     { dst = sext(load(base, 2, 0b1), 32); })
)

instruction Movzx8Load for [X86_64] : ExtendLoad {
    param OPNAME: String = "movzx8_load";
    param MNEMONIC: String = "movzx";
    param OPCODE: bits<8> = 0xB6;

    asm {
        "{self.MNEMONIC} {dst}, byte ptr [{base}]"
    }

    behavior {
        dst = zext(load(base, 1, 0b0), self.XLEN);
    }
}

instruction Movzx16Load for [X86_64] : ExtendLoad {
    param OPNAME: String = "movzx16_load";
    param MNEMONIC: String = "movzx";
    param OPCODE: bits<8> = 0xB7;

    asm {
        "{self.MNEMONIC} {dst}, word ptr [{base}]"
    }

    behavior {
        dst = zext(load(base, 2, 0b0), self.XLEN);
    }
}

instruction Movsx8Load for [X86_64] : ExtendLoad {
    param OPNAME: String = "movsx8_load";
    param MNEMONIC: String = "movsx";
    param OPCODE: bits<8> = 0xBE;

    asm {
        "{self.MNEMONIC} {dst}, byte ptr [{base}]"
    }

    behavior {
        dst = sext(load(base, 1, 0b1), self.XLEN);
    }
}

instruction Movsx16Load for [X86_64] : ExtendLoad {
    param OPNAME: String = "movsx16_load";
    param MNEMONIC: String = "movsx";
    param OPCODE: bits<8> = 0xBF;

    asm {
        "{self.MNEMONIC} {dst}, word ptr [{base}]"
    }

    behavior {
        dst = sext(load(base, 2, 0b1), self.XLEN);
    }
}

// `movsxd r64, dword ptr [base]` (REX.W + 0x63): the lw-parity signed load.
instruction MovsxdLoad for [X86_64] {
    param OPNAME: String = "movsxd_load";
    param MNEMONIC: String = "movsxd";

    operands {
        dst: GPR,
        base: GPR,
    }

    encoding {
        rex(0b1, dst, base, 0b0),
        0x63,
        modrm_base(dst, base),
    }

    asm {
        "{self.MNEMONIC} {dst}, dword ptr [{base}]"
    }

    behavior {
        dst = sext(load(base, 4, 0b1), self.XLEN);
    }
}

// Narrow mov loads/stores: the 32-bit access zero-extends architecturally, so
// its destination is the GPR32 view; byte/word stores take the narrow source
// register directly.

instruction Mov32Load for [X86_64] {
    param OPNAME: String = "mov_load32";
    param MNEMONIC: String = "mov";

    operands {
        dst: GPR32,
        base: GPR,
    }

    encoding {
        rex(0b0, dst, base, 0b0),
        0x8B,
        modrm_base(dst, base),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }

    behavior {
        dst = load(base, 4, 0b0);
    }
}

instruction Mov32Store for [X86_64] {
    param OPNAME: String = "mov_store32";
    param MNEMONIC: String = "mov";

    operands {
        base: GPR,
        src: GPR32,
    }

    encoding {
        rex(0b0, src, base, 0b0),
        0x89,
        modrm_base(src, base),
    }

    asm {
        "{self.MNEMONIC} [{base}], {src}"
    }

    behavior {
        store(base, 4, src);
    }
}

instruction Mov16Store for [X86_64] {
    param OPNAME: String = "mov_store16";
    param MNEMONIC: String = "mov";

    operands {
        base: GPR,
        src: GPR16,
    }

    encoding {
        0x66,
        rex(0b0, src, base, 0b0),
        0x89,
        modrm_base(src, base),
    }

    asm {
        "{self.MNEMONIC} [{base}], {src}"
    }

    behavior {
        store(base, 2, src);
    }
}

instruction Mov8Store for [X86_64] {
    param OPNAME: String = "mov_store8";
    param MNEMONIC: String = "mov";

    operands {
        base: GPR,
        src: GPR8,
    }

    encoding {
        rex(0b0, src, base, needs_rex8_one(src)),
        0x88,
        modrm_base(src, base),
    }

    asm {
        "{self.MNEMONIC} [{base}], {src}"
    }

    behavior {
        store(base, 1, src);
    }
}

// disp32 addressing (mod=10) for the 64-bit mov pair.

instruction MovLoadDisp for [X86_64] {
    param OPNAME: String = "mov_load_disp";
    param MNEMONIC: String = "mov";

    operands {
        dst: GPR,
        base: GPR,
        imm: bits<32>,
    }

    encoding {
        rex(0b1, dst, base, 0b0),
        0x8B,
        modrm_disp(dst, base, imm),
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base} + {imm}]"
    }

    behavior {
        dst = load(base + sext(imm, self.XLEN), 8, 0b0);
    }
}

instruction MovStoreDisp for [X86_64] {
    param OPNAME: String = "mov_store_disp";
    param MNEMONIC: String = "mov";

    operands {
        base: GPR,
        imm: bits<32>,
        src: GPR,
    }

    encoding {
        rex(0b1, src, base, 0b0),
        0x89,
        modrm_disp(src, base, imm),
    }

    asm {
        "{self.MNEMONIC} [{base} + {imm}], {src}"
    }

    behavior {
        store(base + sext(imm, self.XLEN), 8, src);
    }
}

instruction Mov32LoadDisp for [X86_64] {
    param OPNAME: String = "mov_load32_disp";
    param MNEMONIC: String = "mov";

    operands {
        dst: GPR32,
