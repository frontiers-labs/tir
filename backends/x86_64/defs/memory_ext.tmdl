// `lea r64, [rip + disp32]` (REX.W + 0x8D + ModR/M mod=00 reg=dst rm=101): loads
// the pc-relative address of a symbol. Emitted by `lower_addr_of`; the disp32 is
// left as a fixup and relocated (R_X86_64_PC32) against the target symbol at link
// time. The disp is measured from the end of the 7-byte instruction.
instruction LeaRip for [X86_64] {
    param OPNAME: String = "lea";
    param MNEMONIC: String = "lea";

    schedule { units = [WriteILeaRip]; }

    operands {
        dst: GPR,
        imm: bits<32>,
    }

    encoding {
        rex!({ 0b0 }, { dst[3] }, 0b1)
        0x8D,
        0b00,
        dst[2..0],
        0b101,
        imm,
    }

    asm {
        "{self.MNEMONIC} {dst}, [rip + {imm}]"
    }

    behavior {
        dst = PC::pc + sext(imm, self.XLEN) + zext(0b111, self.XLEN);
    }
}

// `leave`: rsp = rbp, then pop rbp.
instruction Leave for [X86_64] {
    param MNEMONIC: String = "leave";
    encoding { 0xC9 }
    asm { "{self.MNEMONIC}" }
    behavior {
        GPR::rsp = GPR::rbp;
        GPR::rbp = load(GPR::rsp, 8, 0b0);
        GPR::rsp = GPR::rsp + zext(0b1000, self.XLEN);
    }
}

// One-element string ops. `df` (std/cld) picks the step direction; the
// sense is `df` = 1 descending, so the step is the two's complement of the
// element size. movs reads [rsi] and writes [rdi] after stepping both;
// stos stores the accumulator (al/ax/eax/rax) through [rdi]; cmps compares
// [rsi] with [rdi] driving EFLAGS like a subtraction.

instruction Movsb for [X86_64] {
    param MNEMONIC: String = "movsb";
    schedule { units = [WriteILeaSimple]; }
    encoding { 0xA4 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(1, self.XLEN)
        } else {
            zext(1, self.XLEN)
        };
        store(GPR::rdi, 1, load(GPR::rsi, 1, 0b0));
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

instruction Movsw for [X86_64] {
    param MNEMONIC: String = "movsw";
    schedule { units = [WriteILeaSimple]; }
    encoding { 0x66, 0xA5 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(2, self.XLEN)
        } else {
            zext(2, self.XLEN)
        };
        store(GPR::rdi, 2, load(GPR::rsi, 2, 0b0));
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

// The mnemonic `movsd` is shared with the SSE scalar move; assembler forms
// pull the no-operand spelling here and the register forms there.
instruction MovsdString for [X86_64] {
    param OPNAME: String = "movsd_string";
    param MNEMONIC: String = "movsd";
    schedule { units = [WriteILeaSimple]; }
    encoding { 0xA5 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(4, self.XLEN)
        } else {
            zext(4, self.XLEN)
        };
        store(GPR::rdi, 4, load(GPR::rsi, 4, 0b0));
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

