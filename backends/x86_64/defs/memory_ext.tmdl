template LeaScaledIndex for [X86_64] {
    param SCALE_BITS: bits<2>;

    schedule { units = [WriteILeaComplex]; }

    operands {
        dst: GPR,
        index: GPRaddrIndex,
    }

    encoding {
        0b0100,
        0b1,
        dst[3],
        index[3],
        0b0,
        0x8D,
        0b00,
        dst[2..0],
        0b100,
        SCALE_BITS,
        index[2..0],
        0b101,
        0x00000000,
    }
}

