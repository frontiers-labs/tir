//! Narrow and displacement-based memory operations plus stack push/pop instructions.

macro mov32_memory_norex {
    ( $name:ident, $opname:literal, load ) => {
        instruction $name for [X86] {
            param OPNAME: String = $opname;
            param MNEMONIC: String = "mov";
            operands { dst: GPR32low, base: GPRaddrDirectLow, }
            encoding {
                0x8B,
                0b00,
                dst[2..0],
                base[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, [{base}]" }
            behavior { dst = load(base, 4, 0b0); }
        }
    };
    ( $name:ident, $opname:literal, store ) => {
        instruction $name for [X86] {
            param OPNAME: String = $opname;
            param MNEMONIC: String = "mov";
            operands { base: GPRaddrDirectLow, src: GPR32low, }
            encoding {
                0x89,
                0b00,
                src[2..0],
                base[2..0],
            }
            asm { "{self.MNEMONIC} [{base}], {src}" }
            behavior { store(base, 4, src); }
        }
    };
}

mov32_memory_norex!(Mov32LoadNorex, "mov_load32_norex", load)
mov32_memory_norex!(Mov32StoreNorex, "mov_store32_norex", store)

instruction Mov16StoreNorex for [X86] {
    param OPNAME: String = "mov_store16_norex";
    param MNEMONIC: String = "mov";
    operands { base: GPRaddrDirectLow, src: GPR16low, }
    encoding {
        0x66,
        0x89,
        0b00,
        src[2..0],
        base[2..0],
    }
    asm { "{self.MNEMONIC} [{base}], {src}" }
    behavior { store(base, 2, src); }
}

instruction Mov8StoreNorex for [X86] {
    param OPNAME: String = "mov_store8_norex";
    param MNEMONIC: String = "mov";
    operands { base: GPRaddrDirectLow, src: GPR8low, }
    encoding {
        0x88,
        0b00,
        src[2..0],
        base[2..0],
    }
    asm { "{self.MNEMONIC} [{base}], {src}" }
    behavior { store(base, 1, src); }
}

macro extend_load32_norex {
    ( $( ( $name:ident, $opname:literal, $mnemonic:literal, $size:literal, $opcode:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86] {
               param OPNAME: String = $opname;
               param MNEMONIC: String = $mnemonic;
               operands { dst: GPR32low, base: GPRaddrDirectLow, }
               encoding {
                   0x0F,
                   $opcode,
                   0b00,
                   dst[2..0],
                   base[2..0],
               }
               asm { ${concat("{self.MNEMONIC} {dst}, ", $size, " ptr [{base}]")} }
               behavior { $($b)* }
           } )*
    };
}

extend_load32_norex!(
    (Movzx8Load32Norex, "movzx8_load32_norex", "movzx", "byte", 0xB6,
     { dst = zext(load(base, 1, 0b0), 32); }),
    (Movzx16Load32Norex, "movzx16_load32_norex", "movzx", "word", 0xB7,
     { dst = zext(load(base, 2, 0b0), 32); }),
    (Movsx8Load32Norex, "movsx8_load32_norex", "movsx", "byte", 0xBE,
     { dst = sext(load(base, 1, 0b1), 32); }),
    (Movsx16Load32Norex, "movsx16_load32_norex", "movsx", "word", 0xBF,
     { dst = sext(load(base, 2, 0b1), 32); })
)

// Memory-access extensions: sub-64-bit loads/stores (lb/lh/lw parity through
// movzx/movsx and narrow mov), a disp32 addressing form for the 64-bit mov,
// and the stack push/pop pair. Addressing is register-direct; the rsp/rbp (and
// r12/r13) ModR/M escapes get their own encodings below.

// ModR/M-escape variants. Declared before the generic memory forms so the
// assembler tries the narrow-base `_sib`/`_rbp` candidates first (they parse a
// base only in the rsp/r12 or rbp/r13 class and fall through otherwise).
// Post-RA `canonicalize_encodings` selects them for codegen; the access itself
// is identical to the register-direct form. `_sib` adds the escape SIB byte
// 0x24 (scale=00, index=none, base=100); `_rbp` uses mod=01 with a zero disp8.

template ExtendLoadSib for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: GPR,
        base: GPRsib,
    }

    encoding {
        rex!({ base[3] }, { dst[3] }, 0b1)
        0x0F,
        OPCODE,
        0b00,
        dst[2..0],
        0b100,
        0x24,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }
}

template ExtendLoadRbp for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;

    operands {
        dst: GPR,
        base: GPRrbp,
    }

    encoding {
        rex!({ base[3] }, { dst[3] }, 0b1)
        0x0F,
        OPCODE,
        0b01,
        dst[2..0],
        0b101,
        0x00,
    }

    asm {
        "{self.MNEMONIC} {dst}, [{base}]"
    }
}

instruction Movzx8LoadSib for [X86_64] : ExtendLoadSib {
    param OPNAME: String = "movzx8_load_sib";
    param MNEMONIC: String = "movzx";
    param OPCODE: bits<8> = 0xB6;

    asm {
        "{self.MNEMONIC} {dst}, byte ptr [{base}]"
    }

    behavior {
        dst = zext(load(base, 1, 0b0), self.XLEN);
    }
}

instruction Movzx8LoadRbp for [X86_64] : ExtendLoadRbp {
    param OPNAME: String = "movzx8_load_rbp";
    param MNEMONIC: String = "movzx";
    param OPCODE: bits<8> = 0xB6;

    asm {
        "{self.MNEMONIC} {dst}, byte ptr [{base}]"
    }

    behavior {
        dst = zext(load(base, 1, 0b0), self.XLEN);
    }
}

