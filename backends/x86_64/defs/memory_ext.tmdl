instruction Cmpsb for [X86_64] {
    param MNEMONIC: String = "cmpsb";
    schedule { units = [WriteIALU]; }
    encoding { 0xA6 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(1, self.XLEN)
        } else {
            zext(1, self.XLEN)
        };
        let lhs = load(GPR::rsi, 1, 0b0);
        let rhs = load(GPR::rdi, 1, 0b0);
        EFLAGS::cf = if lhs ~< rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::zf = if lhs == rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(lhs - rhs, 7, 7);
        EFLAGS::of = extract((lhs ^ rhs) & (lhs ^ (lhs - rhs)), 7, 7);
        EFLAGS::af = extract(lhs ^ rhs ^ (lhs - rhs), 4, 4);
        EFLAGS::pf = parity_flag(lhs - rhs);
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

instruction Cmpsw for [X86_64] {
    param MNEMONIC: String = "cmpsw";
    schedule { units = [WriteIALU]; }
    encoding { 0x66, 0xA7 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(2, self.XLEN)
        } else {
            zext(2, self.XLEN)
        };
        let lhs = load(GPR::rsi, 2, 0b0);
        let rhs = load(GPR::rdi, 2, 0b0);
        EFLAGS::cf = if lhs ~< rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::zf = if lhs == rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(lhs - rhs, 15, 15);
        EFLAGS::of = extract((lhs ^ rhs) & (lhs ^ (lhs - rhs)), 15, 15);
        EFLAGS::af = extract(lhs ^ rhs ^ (lhs - rhs), 4, 4);
        EFLAGS::pf = parity_flag(lhs - rhs);
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

instruction CmpsdString for [X86_64] {
    param OPNAME: String = "cmpsd_string";
    param MNEMONIC: String = "cmpsd";
    schedule { units = [WriteIALU]; }
    encoding { 0xA7 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(4, self.XLEN)
        } else {
            zext(4, self.XLEN)
        };
        let lhs = load(GPR::rsi, 4, 0b0);
        let rhs = load(GPR::rdi, 4, 0b0);
        EFLAGS::cf = if lhs ~< rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::zf = if lhs == rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(lhs - rhs, 31, 31);
        EFLAGS::of = extract((lhs ^ rhs) & (lhs ^ (lhs - rhs)), 31, 31);
        EFLAGS::af = extract(lhs ^ rhs ^ (lhs - rhs), 4, 4);
        EFLAGS::pf = parity_flag(lhs - rhs);
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

instruction Cmpsq for [X86_64] {
    param MNEMONIC: String = "cmpsq";
    schedule { units = [WriteIALU]; }
    encoding { 0x48, 0xA7 }
    asm { "{self.MNEMONIC}" }
    behavior {
        let step = if EFLAGS::df == zext(0b1, 1) {
            zext(0b0, self.XLEN) - zext(8, self.XLEN)
        } else {
            zext(8, self.XLEN)
        };
        let lhs = load(GPR::rsi, 8, 0b0);
        let rhs = load(GPR::rdi, 8, 0b0);
        EFLAGS::cf = if lhs ~< rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::zf = if lhs == rhs { zext(0b1, 1) } else { zext(0b0, 1) };
        EFLAGS::sf = extract(lhs - rhs, 63, 63);
        EFLAGS::of = extract((lhs ^ rhs) & (lhs ^ (lhs - rhs)), 63, 63);
        EFLAGS::af = extract(lhs ^ rhs ^ (lhs - rhs), 4, 4);
        EFLAGS::pf = parity_flag(lhs - rhs);
        GPR::rsi = GPR::rsi + step;
        GPR::rdi = GPR::rdi + step;
    }
}

// `push r64` / `pop r64` (0x50+rd / 0x58+rd): the register number's low bits
// live in the opcode byte; a plain REX carries the 4th bit.
template PushPop for [X86_64] {
    param MNEMONIC: String;
    param OPCODE: bits<5>;

    operands {
        reg: GPR,
    }

    encoding {
        rex_rm(0b0, reg, 0b0),
        OPCODE,
        reg[2..0],
    }

    asm {
        "{self.MNEMONIC} {reg}"
    }
}

instruction Push for [X86_64] : PushPop {
    param MNEMONIC: String = "push";
    param OPCODE: bits<5> = 0b01010;

    behavior {
        GPR::rsp = GPR::rsp - zext(0b1000, self.XLEN);
        store(GPR::rsp, 8, reg);
    }
}

instruction Pop for [X86_64] : PushPop {
    param MNEMONIC: String = "pop";
    param OPCODE: bits<5> = 0b01011;

    behavior {
        reg = load(GPR::rsp, 8, 0b0);
        GPR::rsp = GPR::rsp + zext(0b1000, self.XLEN);
    }
}
