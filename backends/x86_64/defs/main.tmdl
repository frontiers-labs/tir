//! x86-64 architectural registers and System V calling convention, using Intel syntax.

// x86-64 prototype, Intel syntax. Scope: the sixteen 64-bit GPRs with a fixed
// REX.W prefix. r8..r15 carry the 4th register-number bit in the REX prefix
// (REX.R for the ModR/M reg field, REX.B for the rm field); the low three bits
// stay in ModR/M. Register operands are spliced across both fields via slices,
// e.g. `dst[2..0]` and `dst[3]`.

isa X86 {
    param XLEN: Integer = 32;
    param ENCODING_UNIT: Integer = 8;
}

isa SSE requires X86 {}

isa SSE2 requires SSE {}

isa X86_64 requires [X86, SSE2] {
    param XLEN: Integer = 64;
    param ENCODING_UNIT: Integer = 8;
}

register_class PC for [X86_64] {
    param ENCODING_LEN: Integer = 0;
    param WIDTH: Integer = self.XLEN;

    registers {
        pc => { traits = [program_counter] },
    }
}

// Status flags written by compare-style instructions and read by conditional
// jumps. The registers carry no encoding slots, so the class is never allocated.
register_class EFLAGS for [X86] {
    param ENCODING_LEN: Integer = 0;
    param WIDTH: Integer = 1;

    registers {
        cf => { traits = [status_flag] },
        pf => { traits = [status_flag] },
        zf => { traits = [status_flag] },
        sf => { traits = [status_flag] },
        of => { traits = [status_flag] },
    }
}

// Names carry no trailing digit, so each declares its register number.
register_class GPR for [X86_64] {
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 },
        rcx => { index = 1 },
        rdx => { index = 2 },
        rbx => { index = 3 },
        rsp => { index = 4 },
        rbp => { index = 5 },
        rsi => { index = 6 },
        rdi => { index = 7 },
        r8 => { index = 8 },
        r9 => { index = 9 },
        r10 => { index = 10 },
        r11 => { index = 11 },
        r12 => { index = 12 },
        r13 => { index = 13 },
        r14 => { index = 14 },
        r15 => { index = 15 },
    }
}

abi SysV("sysv") for [X86_64] {
    stack {
        align = 16;
        grows = down;
        red_zone = 128;
        slot_size = 8;
        save_style = push_pop;
    }
    sp = GPR::rsp;
    fp = GPR::rbp;
    args int -> [GPR::rdi, GPR::rsi, GPR::rdx, GPR::rcx, GPR::r8, GPR::r9],
        then stack;
    args float -> [XMM::xmm0..XMM::xmm7], then stack;
    args vector -> [XMM::xmm0..XMM::xmm7], then stack;
    rets int -> [GPR::rax, GPR::rdx];
    rets float -> [XMM::xmm0, XMM::xmm1];
    rets vector -> [XMM::xmm0, XMM::xmm1];
    callee_saved = [GPR::rbx, GPR::rbp, GPR::r12..GPR::r15];
    reserved = [];
    classifier = sysv;
}

register_class GPR32 for [X86_64] : GPR {
    param WIDTH: Integer = 32;

    registers {
        eax => { index = 0 },
        ecx => { index = 1 },
        edx => { index = 2 },
        ebx => { index = 3 },
        esp => { index = 4 },
        ebp => { index = 5 },
        esi => { index = 6 },
        edi => { index = 7 },
        r8d => { index = 8 },
        r9d => { index = 9 },
        r10d => { index = 10 },
        r11d => { index = 11 },
        r12d => { index = 12 },
        r13d => { index = 13 },
        r14d => { index = 14 },
        r15d => { index = 15 },
    }
}

register_class GPR16 for [X86_64] : GPR {
    param WIDTH: Integer = 16;
    param WRITE_POLICY: String = "merge";

    registers {
        ax => { index = 0 },
        cx => { index = 1 },
        dx => { index = 2 },
        bx => { index = 3 },
        sp => { index = 4 },
        bp => { index = 5 },
        si => { index = 6 },
        di => { index = 7 },
        r8w => { index = 8 },
        r9w => { index = 9 },
        r10w => { index = 10 },
        r11w => { index = 11 },
        r12w => { index = 12 },
        r13w => { index = 13 },
        r14w => { index = 14 },
        r15w => { index = 15 },
    }
}

// spl/bpl/sil/dil and r8b..r15b are encodable only with a REX prefix, which the
// templates always emit.
register_class GPR8 for [X86_64] : GPR {
    param WIDTH: Integer = 8;
    param WRITE_POLICY: String = "merge";

    registers {
        al => { index = 0 },
        cl => { index = 1 },
        dl => { index = 2 },
        bl => { index = 3 },
        spl => { index = 4 },
        bpl => { index = 5 },
        sil => { index = 6 },
        dil => { index = 7 },
        r8b => { index = 8 },
        r9b => { index = 9 },
        r10b => { index = 10 },
        r11b => { index = 11 },
        r12b => { index = 12 },
        r13b => { index = 13 },
        r14b => { index = 14 },
        r15b => { index = 15 },
    }
}

// ah/ch/dh/bh overlap bits 8..15 of rax..rbx, so they alias the GPR file at
// indices 0..3 (`file = GPR` shares the file without importing its registers).
// Their ModR/M numbers 4..7 are encodable only without a REX prefix.
register_class GPR8H for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 8;
    param WRITE_POLICY: String = "merge";
    param BIT_OFFSET: Integer = 8;

    registers {
        ah => { index = 0 },
        ch => { index = 1 },
        dh => { index = 2 },
        bh => { index = 3 },
    }
}

// Low-register subclasses selected post-RA by `canonicalize_encodings` for the
// REX-free encodings GNU as emits when no register-number 4th bit and no
// REX.W/8-bit-spl are needed. Like the memory views below they share the GPR
// file, carry no `argument` traits (so `default_integer_class` is unaffected),
// and are never allocation classes: every instruction over them leaves its value
// unmodeled, so they root no isel rule and are reachable only through
// canonicalization.
//   GPR32low/GPR16low: eax..edi / ax..di (indices 0-7) — a REX-free 32/16-bit op.
//   GPR8low: al/cl/dl/bl (indices 0-3) — the only 8-bit registers with no REX;
//   spl/bpl/sil/dil (4-7) still require an empty REX and stay on the GPR8 form.
register_class GPRlow for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 },
        rcx => { index = 1 },
        rdx => { index = 2 },
        rbx => { index = 3 },
        rsp => { index = 4 },
        rbp => { index = 5 },
        rsi => { index = 6 },
        rdi => { index = 7 },
    }
}

register_class GPRaddrDispLow for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 },
        rcx => { index = 1 },
        rdx => { index = 2 },
        rbx => { index = 3 },
        rbp => { index = 5 },
        rsi => { index = 6 },
        rdi => { index = 7 },
    }
}

register_class GPRaddrDirectLow for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 },
        rcx => { index = 1 },
        rdx => { index = 2 },
        rbx => { index = 3 },
        rsi => { index = 6 },
        rdi => { index = 7 },
    }
}

register_class GPRsibLow for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rsp => { index = 4 },
    }
}

register_class GPR32low for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 32;

    registers {
        eax => { index = 0 },
        ecx => { index = 1 },
        edx => { index = 2 },
        ebx => { index = 3 },
        esp => { index = 4 },
        ebp => { index = 5 },
        esi => { index = 6 },
        edi => { index = 7 },
    }
}

register_class GPR16low for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 16;
    param WRITE_POLICY: String = "merge";

    registers {
        ax => { index = 0 },
        cx => { index = 1 },
        dx => { index = 2 },
        bx => { index = 3 },
        sp => { index = 4 },
        bp => { index = 5 },
        si => { index = 6 },
        di => { index = 7 },
    }
}

register_class GPR8low for [X86] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = 8;
    param WRITE_POLICY: String = "merge";

    registers {
        al => { index = 0 },
        cl => { index = 1 },
        dl => { index = 2 },
        bl => { index = 3 },
    }
}

// Memory-base operand views over the GPR file, selected post-RA when a base
// register lands on a ModR/M escape. Neither carries `argument` traits, so
// `default_integer_class` still resolves to GPR; they share the file
// (`file = GPR`) and alias index-for-index, and are never allocation classes.

// rsp (4) and r12 (12) share ModR/M low bits 100, which as a memory operand's rm
// field means "a SIB byte follows". A base here selects a `_sib` variant.
register_class GPRsib for [X86_64] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rsp => { index = 4 },
        r12 => { index = 12 },
    }
}

// rbp (5) and r13 (13) share ModR/M low bits 101, which with mod=00 means
// RIP-relative disp32. A base here selects a `_rbp` variant (mod=01, disp8=0).
register_class GPRrbp for [X86_64] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rbp => { index = 5 },
        r13 => { index = 13 },
    }
}

// SIB address components for forms without a displacement. rbp/r13 cannot be
// encoded as a mod=00 base, and rsp cannot occupy the SIB index field.
register_class GPRaddrBase for [X86_64] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 }, rcx => { index = 1 }, rdx => { index = 2 },
        rbx => { index = 3 }, rsp => { index = 4 }, rsi => { index = 6 },
        rdi => { index = 7 }, r8 => { index = 8 }, r9 => { index = 9 },
        r10 => { index = 10 }, r11 => { index = 11 }, r12 => { index = 12 },
        r14 => { index = 14 }, r15 => { index = 15 },
    }
}

register_class GPRaddrIndex for [X86_64] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 }, rcx => { index = 1 }, rdx => { index = 2 },
        rbx => { index = 3 }, rbp => { index = 5 }, rsi => { index = 6 },
        rdi => { index = 7 }, r8 => { index = 8 }, r9 => { index = 9 },
        r10 => { index = 10 }, r11 => { index = 11 }, r12 => { index = 12 },
        r13 => { index = 13 },
        r14 => { index = 14 }, r15 => { index = 15 },
    }
}

// Bases whose low encoding bits can be used directly in a ModR/M r/m field.
register_class GPRaddrModRmBase for [X86_64] {
    file = GPR;
    param ENCODING_LEN: Integer = 4;
    param WIDTH: Integer = self.XLEN;

    registers {
        rax => { index = 0 }, rcx => { index = 1 }, rdx => { index = 2 },
        rbx => { index = 3 }, rbp => { index = 5 }, rsi => { index = 6 },
        rdi => { index = 7 }, r8 => { index = 8 }, r9 => { index = 9 },
        r10 => { index = 10 }, r11 => { index = 11 }, r13 => { index = 13 },
        r14 => { index = 14 }, r15 => { index = 15 },
    }
}

// `op dst, src`: REX.W + opcode + ModR/M(mod=11, reg=src, rm=dst). The REX byte
// is 0100 WRXB: REX.B carries dst's 4th bit, REX.R carries src's.
tmpl_rr!(RegReg, X86_64, GPR, rexw = 0b1, p66 = 0b0, byte = 0b0)

// `op dst, imm32`: REX.W + opcode + ModR/M(mod=11, reg=EXT, rm=dst) + imm32. The
// reg field holds the /digit extension, so only REX.B (dst's 4th bit) varies.
tmpl_ri!(RegImm, X86_64, GPR, imm = 32, rexw = 0b1, p66 = 0b0)

// Three-operand `imul r64, r/m64, imm32` (0x69 /r id): the non-destructive
// immediate multiply. ModR/M.reg carries dst (REX.R), rm carries src (REX.B) —
// the `RegRegExt` layout, but with a single-byte opcode and a trailing imm32.
tmpl_rrimm!(RegRegImm, X86_64, GPR, rexw = 0b1)

// `op dst, imm8`: REX.W + 0xC1 + ModR/M(mod=11, reg=EXT, rm=dst) + imm8.
tmpl_rs!(RegShift, X86_64, GPR, rexw = 0b1, opcode = 0xC1)

// `op dst, cl`: REX.W + 0xD3 + ModR/M(mod=11, reg=EXT, rm=dst). The count is
// the low bits of rcx, masked to the operand width as in hardware. The cl
// forms must be declared before the matching immediate forms: an immediate
// operand also accepts a bare identifier (as a symbol reference), so the
// immediate form would otherwise swallow the literal `cl`.
tmpl_rscl!(RegShiftCl, X86_64, GPR, rexw = 0b1)

tmpl_rscl!(RegShiftCl32, X86_64, GPR32, rexw = 0b0)

// No-REX by-cl shift templates over the low subclasses (0xD3 / 0x66+0xD3 /
// 0xD2). The cl operand is fixed; only the dst register gates the REX drop.
tmpl_rscl!(RegShiftCl32Norex, GPR32low, norex)

template RegShiftOne for [X86_64] {
    param MNEMONIC: String;
    param EXT: bits<3>;
    operands { dst: GPR, }
    encoding {
        0b0100,
        0b1,
        0b0,
        0b0,
        dst[3],
        0xD1,
        0b11,
        EXT,
        dst[2..0],
    }
    asm { "{self.MNEMONIC} {dst}" }
}

template RegShiftOne32 for [X86_64] {
    param MNEMONIC: String;
    param EXT: bits<3>;
    operands { dst: GPR32, }
    encoding {
        0b0100,
        0b0,
        0b0,
        0b0,
        dst[3],
        0xD1,
        0b11,
        EXT,
        dst[2..0],
    }
    asm { "{self.MNEMONIC} {dst}" }
}

template RegShiftOne32Norex for [X86] {
    param MNEMONIC: String;
    param EXT: bits<3>;
    operands { dst: GPR32low, }
    encoding {
        0xD1,
        0b11,
        EXT,
        dst[2..0],
    }
    asm { "{self.MNEMONIC} {dst}" }
}

tmpl_rscl!(RegShiftCl16Norex, GPR16low, prefix66norex)

tmpl_rscl!(RegShiftCl8Norex, GPR8low, bytenorex)

// `op dst, src` behind the 0x0F opcode escape, with the ModR/M fields swapped
// relative to `RegReg`: reg carries dst (REX.R), rm carries src (REX.B) — the
// `imul r64, r/m64` layout.
tmpl_rrext!(RegRegExt, X86_64, GPR, rexw = 0b1)

tmpl_rrext!(RegRegExt32, X86_64, GPR32, rexw = 0b0)

template RegRegExt32Norex for [X86] {
    param MNEMONIC: String;
    param OPCODE: bits<8>;
    operands { dst: GPR32low, src: GPR32low, }
    encoding {
        0x0F,
        OPCODE,
        0b11,
        dst[2..0],
        src[2..0],
    }
    asm { "{self.MNEMONIC} {dst}, {src}" }
}

tmpl_rr!(RegReg32, X86_64, GPR32, rexw = 0b0, p66 = 0b0, byte = 0b0)

tmpl_ri!(RegImm32, X86_64, GPR32, imm = 32, rexw = 0b0, p66 = 0b0)

// 32-bit `imul r32, r/m32, imm32` (0x69 /r id, no REX.W).
tmpl_rrimm!(RegRegImm32, X86_64, GPR32, rexw = 0b0)

template RegRegImm32Norex for [X86] {
    param MNEMONIC: String;
    operands { dst: GPR32low, src: GPR32low, imm: bits<32>, }
    encoding {
        0x69,
        0b11,
        dst[2..0],
        src[2..0],
        imm,
    }
    asm { "{self.MNEMONIC} {dst}, {src}, {imm}" }
}

tmpl_rs!(RegShift32, X86_64, GPR32, rexw = 0b0, opcode = 0xC1)

// 16-bit forms prepend the 0x66 operand-size prefix to the 32-bit encoding.
tmpl_rr!(RegReg16, X86_64, GPR16, rexw = 0b0, p66 = 0b1, byte = 0b0)

tmpl_ri!(RegImm16, X86_64, GPR16, imm = 16, rexw = 0b0, p66 = 0b1)

tmpl_rs!(RegShift16, GPR16, prefix66)

// 8-bit forms reuse the 32-bit layout with the byte-sized opcode.
tmpl_rr!(RegReg8, X86_64, GPR8, rexw = 0b0, p66 = 0b0, byte = 0b1)

tmpl_ri!(RegImm8, X86_64, GPR8, byte)

tmpl_rs!(RegShift8, X86_64, GPR8, rexw = 0b0, opcode = 0xC0)

// No-REX shift-by-immediate templates over the low subclasses.
tmpl_rs!(RegShift32Norex, GPR32low, norex)

tmpl_rs!(RegShift16Norex, GPR16low, prefix66norex)

tmpl_rs!(RegShift8Norex, GPR8low, bytenorex)

// No REX prefix: just opcode + ModR/M. The field's high bit turns the register
// index (0..3) into its ModR/M number (4..7).
tmpl_rr!(RegReg8H, GPR8H, high8)

tmpl_ri!(RegImm8H, GPR8H, high8)

tmpl_rs!(RegShift8H, GPR8H, high8)

// `jcc rel32`: the 0x0F opcode escape, 0x80|cc, then a 32-bit displacement
// measured from the end of the 6-byte instruction (RIP already points past the
// branch when the displacement applies — hence the `+ 6` in the behaviors).
template JccRel32 for [X86_64] {
    param MNEMONIC: String;
    param CC: bits<8>;

    operands {
        imm: bits<32>,
    }

    encoding {
        0x0F,
        CC,
        imm,
    }

    asm {
        "{self.MNEMONIC} {imm}"
    }
}

template JccRel32Legacy for [X86] {
    param MNEMONIC: String;
    param CC: bits<8>;
    operands { imm: bits<32>, }
    encoding {
        0x0F,
        CC,
        imm,
    }
    asm { "{self.MNEMONIC} {imm}" }
}

// Width-family macros for the group-1 ALU / immediate / shift instructions.
// Each family has a width-suffixed arm (for [X86_64], carries an OPNAME derived by
// ${concat}) and a 64-bit arm (for [X86_64], no width suffix). One invocation
// per width group keeps generated items in their original declaration order.
// Opcodes differ per width (e.g. Add 0x01 vs Add8 0x00), so they stay per row.

macro alu_rr {
    ( $feature:ident, $nsuf:literal, $osuf:literal, $tmpl:ident, $class:ident, $( ( $name:ident, $mn:literal, $opc:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [$feature] : $tmpl {
               param OPNAME: String = ${concat($mn, $osuf)};
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [$class]; }
               behavior { $($b)* }
           } )*
    };
    ( $nsuf:literal, $osuf:literal, $tmpl:ident, $class:ident, $( ( $name:ident, $mn:literal, $opc:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [X86_64] : $tmpl {
               param OPNAME: String = ${concat($mn, $osuf)};
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [$class]; }
               behavior { $($b)* }
           } )*
    };
    ( $tmpl:ident, $class:ident, $( ( $name:ident, $mn:literal, $opc:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [$class]; }
               behavior { $($b)* }
           } )*
    };
}

macro alu_ri {
    ( $feature:ident, $nsuf:literal, $osuf:literal, $tmpl:ident, $class:ident, $( ( $name:ident, $ostem:literal, $mn:literal, $opc:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [$feature] : $tmpl {
               param OPNAME: String = ${concat($ostem, $osuf)};
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               param EXT: bits<3> = $ext;
               schedule { units = [$class]; }
               behavior { $($b)* }
           } )*
    };
    ( $nsuf:literal, $osuf:literal, $tmpl:ident, $class:ident, $( ( $name:ident, $ostem:literal, $mn:literal, $opc:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [X86_64] : $tmpl {
               param OPNAME: String = ${concat($ostem, $osuf)};
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               param EXT: bits<3> = $ext;
               schedule { units = [$class]; }
               behavior { $($b)* }
           } )*
    };
    ( $tmpl:ident, $class:ident, $( ( $name:ident, $opname:literal, $mn:literal, $opc:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               param EXT: bits<3> = $ext;
               schedule { units = [$class]; }
               behavior { $($b)* }
           } )*
    };
}

macro shift_cl {
    ( $nsuf:literal, $osuf:literal, $tmpl:ident, $( ( $name:ident, $ostem:literal, $mn:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [X86_64] : $tmpl {
               param OPNAME: String = ${concat($ostem, $osuf)};
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [WriteIShift]; }
               behavior { $($b)* }
           } )*
    };
    ( $tmpl:ident, $( ( $name:ident, $opname:literal, $mn:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [WriteIShift]; }
               behavior { $($b)* }
           } )*
    };
}

macro shift_imm {
    ( $feature:ident, $nsuf:literal, $osuf:literal, $tmpl:ident, $( ( $name:ident, $mn:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [$feature] : $tmpl {
               param OPNAME: String = ${concat($mn, $osuf)};
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [WriteIShift]; }
               behavior { $($b)* }
           } )*
    };
    ( $nsuf:literal, $osuf:literal, $tmpl:ident, $( ( $name:ident, $mn:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction ${concat($name, $nsuf)} for [X86_64] : $tmpl {
               param OPNAME: String = ${concat($mn, $osuf)};
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [WriteIShift]; }
               behavior { $($b)* }
           } )*
    };
    ( $tmpl:ident, $( ( $name:ident, $mn:literal, $ext:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [WriteIShift]; }
               behavior { $($b)* }
           } )*
    };
}

// No-REX single-dst /digit forms (group-3 unary neg/not, by-cl shifts) over the
// low subclasses. The opcode is fixed by the template; only EXT and mnemonic
// vary. All are two-address; the value is unmodeled, so they root no isel rule
// (canonicalize/assembler only). The behavior block still declares the
// registers the form touches — the destination it reads back, the by-cl count
// in rcx, and the flags it writes.
macro reg_ext_norex {
    ( $tmpl:ident, $class:ident, $b:tt, $( ( $name:ident, $op:literal, $mn:literal, $ext:literal ) ),* ) => {
        $( instruction $name for [X86] : $tmpl {
               param OPNAME: String = $op;
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [$class]; }
               behavior $b
           } )*
    };
}

// No-REX shift/rotate-by-immediate forms (low subclasses). Two-address, value
// unmodeled; the shifts and the rotates differ in which flags they write.
macro shift_imm_norex {
    ( $suf:literal, $tmpl:ident, $b:tt, $( ( $name:ident, $mn:literal, $ext:literal ) ),* ) => {
        $( instruction ${concat($name, $suf, "Norex")} for [X86] : $tmpl {
               param OPNAME: String = ${concat($mn, $suf, "_norex")};
               param MNEMONIC: String = $mn;
               param EXT: bits<3> = $ext;
               schedule { units = [WriteIShift]; }
               behavior $b
           } )*
    };
}

// Template-family macros. x86 width variants share a ModR/M scaffold and differ
// in three answers the template takes as parameters: REX.W, the 0x66
// operand-size prefix, and whether an 8-bit operand can name a register only a
// REX byte reaches. Whether the REX byte is written at all is not a parameter
// but a shape (`fn rex` in encoding.tmdl), so one arm covers every width whose
// registers are numbered the ordinary way. The high-byte forms keep an arm of
// their own: ah..bh number 0..3 in the register file and 4..7 in ModR/M, so
// their register fields are not the generic ones.

macro tmpl_rr {
    ( $name:ident, $dia:ident, $cls:ident, rexw = $rexw:literal, p66 = $p66:literal,
      byte = $byte:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { dst: $cls, src: $cls, }
            encoding {
                if $p66 { 0x66 } else { () },
                rex($rexw, src, dst, $byte & needs_rex8(dst, src)),
                OPCODE,
                modrm_reg(src, dst),
            }
            asm { "{self.MNEMONIC} {dst}, {src}" }
        }
    };
    ( $name:ident, $cls:ident, high8 ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { dst: $cls, src: $cls, }
            encoding {
                OPCODE,
                0b11,
                0b1,
                src[1..0],
                0b1,
                dst[1..0],
            }
            asm { "{self.MNEMONIC} {dst}, {src}" }
        }
    };
}

// `op r/m, imm`: the wide-immediate group-1 form and, for the operations that
// have one, the 0x83 short form that spells the same value in one byte. Which
// of the two the encoder writes is a shape, so a 32-bit immediate operand
// carries both.
macro tmpl_ri {
    ( $name:ident, $dia:ident, $cls:ident, imm = $immw:literal, rexw = $rexw:literal,
      p66 = $p66:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<$immw>, }
            encoding {
                if $p66 { 0x66 } else { () },
                rex_rm($rexw, dst, 0b0),
                if (OPCODE == 0x81) & signed_fits(imm, 8) { 0x83 } else { OPCODE },
                modrm_ext(EXT, dst),
                if (OPCODE == 0x81) & signed_fits(imm, 8) { imm as bits<8> } else { imm },
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    // The 8-bit forms: the immediate is already one byte, so there is no short
    // form, and the registers 4..7 name spl/bpl/sil/dil only behind a REX byte.
    ( $name:ident, $dia:ident, $cls:ident, byte ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                rex_rm(0b0, dst, needs_rex8_one(dst)),
                OPCODE,
                modrm_ext(EXT, dst),
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    ( $name:ident, $cls:ident, high8 ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                OPCODE,
                0b11,
                EXT,
                0b1,
                dst[1..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
}

macro tmpl_rs {
    ( $name:ident, $dia:ident, $cls:ident, rexw = $rexw:literal, opcode = $opc:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                0b0100,
                $rexw,
                0b0,
                0b0,
                dst[3],
                $opc,
                0b11,
                EXT,
                dst[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    ( $name:ident, $cls:ident, prefix66 ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                0x66,
                0b0100,
                0b0,
                0b0,
                0b0,
                dst[3],
                0xC1,
                0b11,
                EXT,
                dst[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    ( $name:ident, $cls:ident, high8 ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                0xC0,
                0b11,
                EXT,
                0b1,
                dst[1..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    // No REX: 0xC1 + ModR/M + imm8 (32-bit low registers).
    ( $name:ident, $cls:ident, norex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                0xC1,
                0b11,
                EXT,
                dst[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    // 0x66 prefix, no REX (16-bit low registers).
    ( $name:ident, $cls:ident, prefix66norex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                0x66,
                0xC1,
                0b11,
                EXT,
                dst[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
    // No REX: 0xC0 + ModR/M + imm8 (8-bit low registers al/cl/dl/bl).
    ( $name:ident, $cls:ident, bytenorex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, imm: bits<8>, }
            encoding {
                0xC0,
                0b11,
                EXT,
                dst[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {imm}" }
        }
    };
}

// Single-shape families (only 64-bit and 32-bit variants, both no-prefix).
macro tmpl_rscl {
    ( $name:ident, $dia:ident, $cls:ident, rexw = $rexw:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0b0100,
                $rexw,
                0b0,
                0b0,
                dst[3],
                0xD3,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, cl" }
        }
    };
    // No REX: 0xD3 + ModR/M (32-bit low registers).
    ( $name:ident, $cls:ident, norex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0xD3,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, cl" }
        }
    };
    // 0x66 prefix, no REX (16-bit low registers).
    ( $name:ident, $cls:ident, prefix66norex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0x66,
                0xD3,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, cl" }
        }
    };
    // No REX: 0xD2 + ModR/M (8-bit low registers al/cl/dl/bl).
    ( $name:ident, $cls:ident, bytenorex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0xD2,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, cl" }
        }
    };
}

macro tmpl_rrext {
    ( $name:ident, $dia:ident, $cls:ident, rexw = $rexw:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { dst: $cls, src: $cls, }
            encoding {
                0b0100,
                $rexw,
                dst[3],
                0b0,
                src[3],
                0x0F,
                OPCODE,
                0b11,
                dst[2..0],
                src[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, {src}" }
        }
    };
}

macro tmpl_rrimm {
    ( $name:ident, $dia:ident, $cls:ident, rexw = $rexw:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { dst: $cls, src: $cls, imm: bits<32>, }
            encoding {
                0b0100,
                $rexw,
                dst[3],
                0b0,
                src[3],
                OPCODE,
                0b11,
                dst[2..0],
                src[2..0],
                imm,
            }
            asm { "{self.MNEMONIC} {dst}, {src}, {imm}" }
        }
    };
}

// Condition-code families. Each row carries its guard expression verbatim as a
// `{ ... }` token fragment, so original parenthesization is preserved. jcc
// writes PC, setcc writes an 8-bit 0/1, cmovcc selects src/dst.

macro jcc_ops {
    ( $( ( $name:ident, $mn:literal, $cc:literal, { $($cond:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : JccRel32 {
               param MNEMONIC: String = $mn;
               param CC: bits<8> = $cc;
               schedule { units = [WriteJcc]; }
               behavior {
                   if $($cond)* {
                       PC::pc = PC::pc + sext(imm, self.XLEN) + zext(0b110, self.XLEN);
                   }
               }
           }
           instruction ${concat($name, "Legacy")} for [X86] : JccRel32Legacy {
               param OPNAME: String = ${concat($mn, "_legacy")};
               param MNEMONIC: String = $mn;
               param CC: bits<8> = $cc;
               schedule { units = [WriteJcc]; }
               behavior {
                   if $($cond)* {
                       PC::pc = PC::pc + sext(imm, self.XLEN) + zext(0b110, self.XLEN);
                   }
               }
           } )*
    };
}

macro setcc_ops {
    ( $( ( $name:ident, $mn:literal, $cc:literal, { $($cond:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : SetccReg {
               param MNEMONIC: String = $mn;
               param CC: bits<8> = $cc;
               schedule { units = [WriteIConditional]; }
               behavior {
                   dst = if $($cond)* {
                       zext(0b1, 8)
                   } else {
                       zext(0b0, 8)
                   };
               }
           } )*
    };
}

// No-REX setcc forms (al/cl/dl/bl): same semantics as the REX-capable forms.
macro setcc_norex {
    ( $( ( $name:ident, $op:literal, $mn:literal, $cc:literal, { $($cond:tt)* } ) ),* ) => {
        $( instruction $name for [X86] : SetccRegNorex {
               param OPNAME: String = $op;
               param MNEMONIC: String = $mn;
               param CC: bits<8> = $cc;
               schedule { units = [WriteIConditional]; }
               behavior {
                   dst = if $($cond)* {
                       zext(0b1, 8)
                   } else {
                       zext(0b0, 8)
                   };
               }
           } )*
    };
}

macro cmovcc_ops {
    ( $( ( $name:ident, $mn:literal, $opc:literal, { $($cond:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : RegRegExt {
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [WriteIConditional]; }
               behavior {
                   dst = if $($cond)* {
                       src
                   } else {
                       dst
                   };
               }
           } )*
    };
}

// Flag-computation statement macros for compare/test. `$rhs` is the second
// operand (a register or a sign-extended immediate); `$w`/`$msb` are the operand
// width and its most-significant bit index. Guards are passed as `{ ... }`
// fragments so parenthesization round-trips exactly.

macro sub_flags {
    ( { $($rhs:tt)* }, { $($msb:tt)* } ) => {
        EFLAGS::cf = if dst ~< $($rhs)* {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if dst == $($rhs)* {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = extract(dst - $($rhs)*, $($msb)*, $($msb)*);
        EFLAGS::of = extract((dst ^ $($rhs)*) & (dst ^ (dst - $($rhs)*)), $($msb)*, $($msb)*);
    };
}

// Addition: cf is the unsigned carry out, of the signed overflow (operands
// agree in sign, result differs).
macro add_flags {
    ( { $($lhs:tt)* }, { $($rhs:tt)* }, { $($w:tt)* }, { $($msb:tt)* } ) => {
        EFLAGS::cf = if ($($lhs)* + $($rhs)*) ~< $($lhs)* {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::zf = if ($($lhs)* + $($rhs)*) == zext(0b0, $($w)*) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = extract($($lhs)* + $($rhs)*, $($msb)*, $($msb)*);
        EFLAGS::of = extract(~($($lhs)* ^ $($rhs)*) & ($($lhs)* ^ ($($lhs)* + $($rhs)*)), $($msb)*, $($msb)*);
    };
}

// Logical ops clear carry and overflow and set zf/sf from the result.
macro logic_flags {
    ( { $($res:tt)* }, { $($w:tt)* }, { $($msb:tt)* } ) => {
        EFLAGS::cf = zext(0b0, 1);
        EFLAGS::zf = if ($($res)*) == zext(0b0, $($w)*) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = extract($($res)*, $($msb)*, $($msb)*);
        EFLAGS::of = zext(0b0, 1);
    };
}

macro test_flags {
    ( { $($rhs:tt)* }, { $($w:tt)* }, { $($msb:tt)* } ) => {
        EFLAGS::cf = zext(0b0, 1);
        EFLAGS::zf = if (dst & $($rhs)*) == zext(0b0, $($w)*) {
            zext(0b1, 1)
        } else {
            zext(0b0, 1)
        };
        EFLAGS::sf = extract(dst & $($rhs)*, $($msb)*, $($msb)*);
        EFLAGS::of = zext(0b0, 1);
    };
}

// Group-3 unary `op r/m` (0xF7 /digit) and the movzx/movsx register extensions
// (0x0F escape, narrow source in rm). Both come in 64/32 and 8/16-source pairs.
macro tmpl_runary {
    ( $name:ident, $dia:ident, $cls:ident, rexw = $rexw:literal ) => {
        template $name for [$dia] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0b0100,
                $rexw,
                0b0,
                0b0,
                dst[3],
                0xF7,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}" }
        }
    };
    // No REX: 0xF7 + ModR/M (32-bit low registers).
    ( $name:ident, $cls:ident, norex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0xF7,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}" }
        }
    };
    // 0x66 prefix, no REX (16-bit low registers).
    ( $name:ident, $cls:ident, prefix66norex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0x66,
                0xF7,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}" }
        }
    };
    // No REX: 0xF6 + ModR/M (8-bit low registers al/cl/dl/bl).
    ( $name:ident, $cls:ident, bytenorex ) => {
        template $name for [X86] {
            param MNEMONIC: String;
            param EXT: bits<3>;
            operands { dst: $cls, }
            encoding {
                0xF6,
                0b11,
                EXT,
                dst[2..0],
            }
            asm { "{self.MNEMONIC} {dst}" }
        }
    };
}

macro tmpl_extend {
    ( $name:ident, $cls:ident ) => {
        template $name for [X86_64] {
            param MNEMONIC: String;
            param OPCODE: bits<8>;
            operands { dst: GPR, src: $cls, }
            encoding {
                0b0100,
                0b1,
                dst[3],
                0b0,
                src[3],
                0x0F,
                OPCODE,
                0b11,
                dst[2..0],
                src[2..0],
            }
            asm { "{self.MNEMONIC} {dst}, {src}" }
        }
    };
}

// REX-prefix scaffold: the 0100 WRXB byte laid out little-endian. `$b0` is the
// rm/base 4th-bit source, `$b2` the reg 4th-bit source (each a slice like
// `base[3]` or a literal `0b0`), `$w` the REX.W bit. Expands to the five encoding
// arms (with a trailing comma) so the remaining arms follow directly.
macro rex {
    ( { $($b0:tt)* }, { $($b2:tt)* }, $w:literal ) => {
        0b0100, $w, $($b2)*, 0b0, $($b0)*,
    };
}

// movzx/movsx register extensions. Source width picks the template, so it is a
// per-row parameter rather than a width group.
macro extend_ops {
    ( $( ( $name:ident, $opname:literal, $mn:literal, $tmpl:ident, $opc:literal, { $($b:tt)* } ) ),* ) => {
        $( instruction $name for [X86_64] : $tmpl {
               param OPNAME: String = $opname;
               param MNEMONIC: String = $mn;
               param OPCODE: bits<8> = $opc;
               schedule { units = [WriteIExtend]; }
               behavior { $($b)* }
           } )*
    };
}
